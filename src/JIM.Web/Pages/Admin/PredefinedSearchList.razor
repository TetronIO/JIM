@page "/admin/predefined-searches"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Search.DTOs
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Predefined Searches</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.SavedSearch" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />Predefined Searches</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Predefined Searches make it easy to find objects and control what attributes are returned.</MudText>

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the density toggle, the search box
   and the toolbar count) lives in the shared grid; this page loads the whole list once (it is a small
   configuration list) and windows it in memory. The page header already names the list, so there is no toolbar
   title and the count carries the nouns. *@
<VirtualisedDataGrid T="PredefinedSearchHeader"
                     ContainerId="predefined-search-list"
                     DefaultSortBy="created"
                     DefaultSortDescending="true"
                     LoadWindow="LoadWindowAsync"
                     SingularName="Predefined Search"
                     PluralName="Predefined Searches"
                     SearchPlaceholder="Search by name or URI"
                     RowClicked="HandleRowClicked"
                     RowClassFunc="@((search, _) => search.IsEnabled ? null : "jim-readonly-row")">
    <Columns>
        <TemplateColumn Title="Name" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Name" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                <MudLink Href="@("/admin/predefined-searches/" + context.Item.Uri)">@context.Item.Name</MudLink>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="URI" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="URI" Name="uri" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.Uri
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Object Type" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Object Type" Name="objecttype" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.MetaverseObjectTypeName
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Default?" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Default?" Name="default" />
            </HeaderTemplate>
            <CellTemplate>
                @(context.Item.IsDefaultForMetaverseObjectType ? "Yes" : "No")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Built-in?" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Built-in?" Name="builtin" />
            </HeaderTemplate>
            <CellTemplate>
                @(context.Item.BuiltIn ? "Yes" : "No")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Enabled" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Enabled" Name="enabled" />
            </HeaderTemplate>
            <CellTemplate>
                @* Stop the click reaching the row, which would navigate to the detail page mid-toggle. *@
                <div @onclick:stopPropagation="true">
                    <MudSwitch T="bool" Value="context.Item.IsEnabled" Color="Color.Success"
                               ValueChanged="async (bool val) => await ToggleEnabledAsync(context.Item, val)" />
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Attributes" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Attributes" Name="attributes" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.MetaverseAttributeCount
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Created" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Created" Name="created" />
            </HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                    @context.Item.Created.ToLocalTime().ToRelativeTime()
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No Predefined Searches match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SavedSearch"
                             PrimaryText="No Predefined Searches yet"
                             SecondaryText="Built-in Predefined Searches are created when the service initialises." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IList<PredefinedSearchHeader>? _predefinedSearchHeaders;
    private readonly List<BreadcrumbItem> _breadcrumbs = new List<BreadcrumbItem>
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Administration", href: "/admin"),
        new("Predefined Searches", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _predefinedSearchHeaders = await jim.Search.GetPredefinedSearchHeadersAsync();
    }

    /// <summary>
    /// Windows the in-memory list for the grid: Predefined Searches are a small configuration list, loaded whole
    /// once, so search and sort are applied here rather than each becoming a database range read.
    /// </summary>
    private Task<VirtualisedWindow<PredefinedSearchHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        var headers = _predefinedSearchHeaders ?? new List<PredefinedSearchHeader>();

        var filtered = headers.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            filtered = filtered.Where(x =>
                x.Name.Contains(request.SearchText, StringComparison.OrdinalIgnoreCase) ||
                x.Uri.Contains(request.SearchText, StringComparison.OrdinalIgnoreCase));
        }

        Func<PredefinedSearchHeader, object> sortKey = request.SortBy switch
        {
            "uri" => x => x.Uri,
            "objecttype" => x => x.MetaverseObjectTypeName,
            "default" => x => x.IsDefaultForMetaverseObjectType,
            "builtin" => x => x.BuiltIn,
            "enabled" => x => x.IsEnabled,
            "attributes" => x => x.MetaverseAttributeCount,
            "created" => x => x.Created,
            _ => x => x.Name
        };

        var sorted = request.SortDescending
            ? filtered.OrderByDescending(sortKey)
            : filtered.OrderBy(sortKey);

        return Task.FromResult(sorted.ToWindow(request));
    }

    private void HandleRowClicked(PredefinedSearchHeader header)
    {
        NavManager.NavigateTo($"/admin/predefined-searches/{header.Uri}");
    }

    private async Task ToggleEnabledAsync(PredefinedSearchHeader header, bool isEnabled)
    {
        // offer an optional reason for the configuration change history; cancelling aborts the save
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
        if (cancelled)
            return;

        try
        {
            using var jim = JimFactory.Create();
            var core = await jim.Search.GetPredefinedSearchCoreAsync(header.Id);
            if (core == null)
            {
                Snackbar.Add("Predefined search no longer exists.", Severity.Error);
                return;
            }

            core.IsEnabled = isEnabled;
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Search.UpdatePredefinedSearchAsync(core, user, changeReason);
            header.IsEnabled = isEnabled;
            Snackbar.Add($"Predefined search '{header.Name}' {(isEnabled ? "enabled" : "disabled")}.", Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add($"Failed to update predefined search: {ex.Message}", Severity.Error);
        }
    }
}
