@* The Password Synchronisation queue (#1119, requirements 21 and 22). Delivery already worked before this page;
   what it lacked was somewhere to look. A change that parked because a directory refused it was visible only by
   hunting through Activities, which is no way to run the one thing that must never diverge quietly. *@

<PageTitle>Password Synchronisation</PageTitle>
<MudText Typo="Typo.h3">Password Synchronisation</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    Password changes waiting to reach a Connected System. A change leaves this queue once it is delivered;
    anything listed here is still owed, or has stopped being attempted.
</MudText>

@* Four cards, not five. "Due now" is a subset of waiting rather than a sibling of it, so it reads as a second
   line inside that card: as its own card a reader adding the row up would count the same changes twice. *@
<MudGrid Class="mt-5">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Waiting</MudText>
            <MudText Typo="Typo.h4">@_summary.WaitingCount.ToString("N0")</MudText>
            <MudTooltip Arrow="true" Placement="Placement.Top">
                <TooltipContent>
                    <TooltipText Text="How many of the waiting changes a delivery pass would attempt right now. The rest are waiting out a retry backoff. A large waiting count with nothing due is a queue working through its backoffs; a large due count is a queue that is not being drained." />
                </TooltipContent>
                <ChildContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@_summary.DueCount.ToString("N0") due now</MudText>
                </ChildContent>
            </MudTooltip>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true" Style="border-left: 3px solid var(--mud-palette-warning);">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Parked</MudText>
            <MudTooltip Arrow="true" Placement="Placement.Top">
                <TooltipContent>
                    <TooltipText Text="The target refused these, or they ran out of attempts. JIM has stopped trying, so they wait on a person. Deal with the reason, then retry them." />
                </TooltipContent>
                <ChildContent>
                    <MudText Typo="Typo.h4" Color="@(_summary.ParkedCount > 0 ? Color.Warning : Color.Default)">@_summary.ParkedCount.ToString("N0")</MudText>
                </ChildContent>
            </MudTooltip>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true" Style="border-left: 3px solid var(--mud-palette-error);">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Expired</MudText>
            <MudTooltip Arrow="true" Placement="Placement.Top">
                <TooltipContent>
                    <TooltipText Text="These outlived their Connected System's time to live. The password each carried is gone, so nothing can deliver them now. They need a password set by other means." />
                </TooltipContent>
                <ChildContent>
                    <MudText Typo="Typo.h4" Color="@(_summary.ExpiredCount > 0 ? Color.Error : Color.Default)">@_summary.ExpiredCount.ToString("N0")</MudText>
                </ChildContent>
            </MudTooltip>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Cancelled</MudText>
            <MudTooltip Arrow="true" Placement="Placement.Top">
                <TooltipContent>
                    <TooltipText Text="An administrator stopped these being delivered. Counted rather than hidden, because the identity's password is still divergent on that system and this count is the only thing that says so." />
                </TooltipContent>
                <ChildContent>
                    <MudText Typo="Typo.h4">@_summary.CancelledCount.ToString("N0")</MudText>
                </ChildContent>
            </MudTooltip>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudGrid Class="mt-5">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Label="Connected System" Value="_connectedSystemId" ValueChanged="OnConnectedSystemFilterChangedAsync"
                   Variant="Variant.Outlined" Clearable="true" Dense="true">
            @foreach (var system in _connectedSystems)
            {
                <MudSelectItem T="int?" Value="@system.Id">@system.Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudSelect T="PendingPasswordChangeStatus?" Label="Status" Value="_status" ValueChanged="OnStatusFilterChangedAsync"
                   Variant="Variant.Outlined" Clearable="true" Dense="true">
            <MudSelectItem T="PendingPasswordChangeStatus?" Value="@PendingPasswordChangeStatus.Pending">Waiting</MudSelectItem>
            <MudSelectItem T="PendingPasswordChangeStatus?" Value="@PendingPasswordChangeStatus.Parked">Parked</MudSelectItem>
            <MudSelectItem T="PendingPasswordChangeStatus?" Value="@PendingPasswordChangeStatus.Expired">Expired</MudSelectItem>
            <MudSelectItem T="PendingPasswordChangeStatus?" Value="@PendingPasswordChangeStatus.Cancelled">Cancelled</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudSelect T="PasswordSetFailureReason?" Label="Failure reason" Value="_failureReason" ValueChanged="OnFailureReasonFilterChangedAsync"
                   Variant="Variant.Outlined" Clearable="true" Dense="true">
            @foreach (var reason in FilterableFailureReasons)
            {
                <MudSelectItem T="PasswordSetFailureReason?" Value="@reason">@DescribeReason(reason)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>

<VirtualisedDataGrid @ref="_grid" T="PendingPasswordChangeHeader"
                     ContainerId="password-synchronisation-queue"
                     DefaultSortBy="queued"
                     LoadWindow="LoadWindowAsync"
                     RowClicked="HandleRowClickedAsync"
                     SingularName="queued password change"
                     PluralName="queued password changes"
                     SearchPlaceholder="Search identities and systems...">
    <ToolBarExtras>
        @* Act on the filter the reader is looking at, not on a selection of rows. "Retry everything shown" is
           the action this page exists for, and expressing it as the filter means it covers the whole match set
           rather than the window that happens to be on screen. *@
        <MudButton StartIcon="@Icons.Material.Filled.Replay" Size="Size.Small" Disabled="@(_busy || _grid?.TotalItems is null or 0)"
                   OnClick="RetryShownAsync">
            Retry shown
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.CancelScheduleSend" Size="Size.Small" Disabled="@(_busy || _grid?.TotalItems is null or 0)"
                   OnClick="CancelShownAsync">
            Cancel shown
        </MudButton>
    </ToolBarExtras>
    <Columns>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <MudTooltip Arrow="true" Placement="Placement.Top">
                    <TooltipContent>
                        <TooltipText Text="The queue holds one row per person per Connected System. The person is what you scan for; the row opens their Metaverse Object, where the same change is visible against every one of their accounts." />
                    </TooltipContent>
                    <ChildContent><VirtualisedSortHeader Title="Identity" Name="identity" /></ChildContent>
                </MudTooltip>
            </HeaderTemplate>
            <CellTemplate>
                @* The row navigates on click and so does this link; stopping the click here keeps a link click to
                   one history entry, while the link keeps middle-click and open-in-new-tab. *@
                <span @onclick:stopPropagation="true" class="jim-one-line">
                    <MudLink Href="@IdentityHref(context.Item)">
                        @(context.Item.MetaverseObjectDisplayName ?? context.Item.MetaverseObjectId.ToString())
                    </MudLink>
                </span>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Connected System" Name="system" />
            </HeaderTemplate>
            <CellTemplate>
                <OneLineText Text="@context.Item.ConnectedSystemName" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Status" Name="status" />
            </HeaderTemplate>
            <CellTemplate>
                @* The reason reads inline after the status, because "Parked" alone tells an administrator to do
                   something without saying what: the remedy is nearly always outside JIM, in a policy, a
                   permission or a Connector limitation, and the target's own words are what point at it. *@
                <OneLineText Text="@DescribeStatus(context.Item)" Secondary="@DescribeDetail(context.Item)" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Attempts" Name="attempts" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.AttemptCount.ToString("N0")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <MudTooltip Arrow="true" Placement="Placement.Top">
                    <TooltipContent>
                        <TooltipText Text="When the next delivery attempt falls due. Read it alongside the attempt count: two attempts with a retry booked is a system having a bad morning, and six with none is a system that has given up." />
                    </TooltipContent>
                    <ChildContent><VirtualisedSortHeader Title="Next attempt" Name="nextattempt" /></ChildContent>
                </MudTooltip>
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.NextRetryAt.HasValue)
                {
                    @context.Item.NextRetryAt.Value.ToFriendlyDate()
                }
                else if (context.Item.Status == PendingPasswordChangeStatus.Pending)
                {
                    <span class="mud-text-secondary">Due now</span>
                }
                else
                {
                    <EmptyValue />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Queued" Name="queued" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.CreatedAt.ToFriendlyDate()
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Actions</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @* The row navigates on click; these do not. *@
                <span @onclick:stopPropagation="true" class="jim-one-line-list">
                    @if (context.Item.Status != PendingPasswordChangeStatus.Expired)
                    {
                        <MudTooltip Arrow="true" Placement="Placement.Top">
                            <TooltipContent>
                                <TooltipText Text="@RetryTooltip(context.Item)" />
                            </TooltipContent>
                            <ChildContent>
                                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" Disabled="@_busy"
                                               aria-label="Retry this password change"
                                               OnClick="@(() => RetryOneAsync(context.Item))" />
                            </ChildContent>
                        </MudTooltip>
                    }
                    @if (context.Item.Status is PendingPasswordChangeStatus.Pending or PendingPasswordChangeStatus.Parked)
                    {
                        <MudTooltip Arrow="true" Placement="Placement.Top">
                            <TooltipContent>
                                <TooltipText Text="Stop delivering this change. The row stays, marked Cancelled, because the person's password is still divergent on that system." />
                            </TooltipContent>
                            <ChildContent>
                                <MudIconButton Icon="@Icons.Material.Filled.CancelScheduleSend" Size="Size.Small" Disabled="@_busy"
                                               aria-label="Cancel this password change"
                                               OnClick="@(() => CancelOneAsync(context.Item))" />
                            </ChildContent>
                        </MudTooltip>
                    }
                </span>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No queued password changes match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else if (HasFilter)
        {
            <TableEmptyState Icon="@Icons.Material.Filled.FilterAlt"
                             PrimaryText="No queued password changes match these filters"
                             SecondaryText="Clear the filters to see the whole queue."
                             ActionText="Clear Filters"
                             OnAction="ClearFiltersAsync" />
        }
        else
        {
            @* Empty is the healthy state here, and the message says so rather than reading as a fault. *@
            <TableEmptyState Icon="@Icons.Material.Filled.CheckCircleOutline"
                             PrimaryText="Nothing is waiting to be delivered"
                             SecondaryText="Password changes appear here while they are on their way to a Connected System, and leave once they arrive." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private VirtualisedDataGrid<PendingPasswordChangeHeader>? _grid;
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private List<ConnectedSystemHeader> _connectedSystems = new();
    private PasswordQueueSummary _summary = new();

    private int? _connectedSystemId;
    private PendingPasswordChangeStatus? _status;
    private PasswordSetFailureReason? _failureReason;

    /// <summary>
    /// Guards the actions while one is in flight. A retry and a cancel over the same filter racing each other
    /// would leave an administrator unable to say which of the two outcomes a row ended up with.
    /// </summary>
    private bool _busy;

    /// <summary>
    /// The reasons a delivery attempt can fail. <see cref="PasswordSetFailureReason.None"/> is excluded: it is
    /// what a change that has never failed carries, so offering it as a filter would promise a set of rows that
    /// the failure-reason column is blank for anyway.
    /// </summary>
    private static readonly PasswordSetFailureReason[] FilterableFailureReasons =
    [
        PasswordSetFailureReason.Transient,
        PasswordSetFailureReason.ConfigurationFault,
        PasswordSetFailureReason.PolicyRejection,
        PasswordSetFailureReason.TargetObjectNotFound,
        PasswordSetFailureReason.UnsupportedOperation
    ];

    private bool HasFilter => _connectedSystemId.HasValue || _status.HasValue || _failureReason.HasValue;

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbs =
        [
            new BreadcrumbItem("Home", href: "/", icon: Icons.Material.Filled.Home),
            new BreadcrumbItem("Administration", href: "/admin"),
            new BreadcrumbItem("Password Synchronisation", href: null, disabled: true)
        ];

        using var jim = JimFactory.Create();
        _connectedSystems = await jim.ConnectedSystems.GetConnectedSystemHeadersAsync();
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        using var jim = JimFactory.Create();
        _summary = await jim.PasswordSynchronisation.GetQueueSummaryAsync();
    }

    /// <summary>
    /// The filter the grid is currently showing, which is also what the bulk actions act on. Built in one place
    /// so "retry everything shown" cannot drift from what the list is showing.
    /// </summary>
    private PendingPasswordChangeFilter CurrentFilter(string? searchText) => new()
    {
        ConnectedSystemId = _connectedSystemId,
        Status = _status,
        FailureReason = _failureReason,
        SearchText = searchText
    };

    private async Task<VirtualisedWindow<PendingPasswordChangeHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        using var jim = JimFactory.Create();
        var result = await jim.PasswordSynchronisation.GetPendingPasswordChangesAsync(
            CurrentFilter(request.SearchText),
            request.StartIndex,
            request.Count,
            request.SortBy,
            request.SortDescending,
            request.IncludeTotalCount);

        return new VirtualisedWindow<PendingPasswordChangeHeader>(result.Results, result.TotalResults);
    }

    private async Task OnConnectedSystemFilterChangedAsync(int? value)
    {
        _connectedSystemId = value;
        await RefreshAsync();
    }

    private async Task OnStatusFilterChangedAsync(PendingPasswordChangeStatus? value)
    {
        _status = value;
        await RefreshAsync();
    }

    private async Task OnFailureReasonFilterChangedAsync(PasswordSetFailureReason? value)
    {
        _failureReason = value;
        await RefreshAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _connectedSystemId = null;
        _status = null;
        _failureReason = null;
        await RefreshAsync();
    }

    /// <summary>
    /// Re-reads the summary and the list. The filters change which rows match, so the totals have to be counted
    /// again and the reader's scroll position describes a match set that no longer exists.
    /// </summary>
    private async Task RefreshAsync()
    {
        await LoadSummaryAsync();

        if (_grid != null)
        {
            await _grid.ResetScrollAsync();
            await _grid.RefreshAsync(invalidateTotals: true);
        }
    }

    private async Task RetryOneAsync(PendingPasswordChangeHeader change)
    {
        // Named by identifier and nothing else: acting on the row the administrator clicked, even if the filters
        // have moved on since the window was read.
        await RunActionAsync(
            retry: true,
            filter: new PendingPasswordChangeFilter { Ids = [change.Id] },
            confirmation: null);
    }

    private async Task CancelOneAsync(PendingPasswordChangeHeader change)
    {
        var who = change.MetaverseObjectDisplayName ?? "this identity";
        await RunActionAsync(
            retry: false,
            filter: new PendingPasswordChangeFilter { Ids = [change.Id] },
            confirmation: $"Stop delivering {who}'s password change to {change.ConnectedSystemName}? " +
                          "Their password stays as it was on that system until a new change is synchronised.");
    }

    private async Task RetryShownAsync()
    {
        var count = _grid?.TotalItems ?? 0;
        await RunActionAsync(
            retry: true,
            filter: CurrentFilter(_grid?.SearchText),
            confirmation: $"Attempt delivery again for the {Describe(count)} shown?");
    }

    private async Task CancelShownAsync()
    {
        var count = _grid?.TotalItems ?? 0;
        await RunActionAsync(
            retry: false,
            filter: CurrentFilter(_grid?.SearchText),
            confirmation: $"Stop delivering the {Describe(count)} shown? " +
                          "Each of those people keeps their old password on the target system until a new change is synchronised.");
    }

    /// <summary>
    /// Runs a retry or a cancel and reports what it covered. Shared so the row actions and the bulk actions
    /// cannot report differently, and so the confirmation is the only thing that varies between them.
    /// </summary>
    private async Task RunActionAsync(bool retry, PendingPasswordChangeFilter filter, string? confirmation)
    {
        if (confirmation != null)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                retry ? "Retry password changes" : "Cancel password changes",
                confirmation,
                yesText: retry ? "Retry" : "Cancel delivery",
                cancelText: "Close");

            if (confirmed != true)
                return;
        }

        _busy = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateProvider.GetAuthenticationStateAsync());

            var affected = retry
                ? await jim.PasswordSynchronisation.RetryAsync(filter, user, null)
                : await jim.PasswordSynchronisation.CancelAsync(filter, user, null);

            // Zero is reported rather than passed over in silence. An administrator who acted and changed nothing
            // needs to know that happened; a page that says nothing leaves them believing it worked.
            Snackbar.Add(
                affected == 0
                    ? (retry
                        ? "Nothing was retried; no queued password change matched."
                        : "Nothing was cancelled; no queued password change matched.")
                    : (retry
                        ? $"{Describe(affected)} will be attempted again."
                        : $"{Describe(affected)} will not be delivered."),
                affected == 0 ? Severity.Info : Severity.Success);
        }
        finally
        {
            _busy = false;
        }

        await RefreshAsync();
    }

    private void HandleRowClickedAsync(PendingPasswordChangeHeader change)
    {
        NavManager.NavigateTo(IdentityHref(change));
    }

    /// <summary>
    /// Where a row leads: the identity's own page, where the same change is visible against every one of their
    /// accounts. Falls back to the Metaverse search where the Object Type name did not come back, which is a
    /// broken row rather than a broken link.
    /// </summary>
    private static string IdentityHref(PendingPasswordChangeHeader change) =>
        string.IsNullOrWhiteSpace(change.MetaverseObjectTypePluralName)
            ? "/search"
            : Utilities.GetMetaverseObjectHref(change.MetaverseObjectId, change.MetaverseObjectTypePluralName);

    private static string Describe(int count) =>
        count == 1 ? "1 password change" : $"{count:N0} password changes";

    /// <summary>
    /// What the row's state is called on screen. Pending is shown as "Waiting", which is what it is from the
    /// administrator's side; "Pending" is the storage name and says nothing about whether anything is happening.
    /// </summary>
    private static string DescribeStatus(PendingPasswordChangeHeader change) => change.Status switch
    {
        PendingPasswordChangeStatus.Pending => "Waiting",
        PendingPasswordChangeStatus.Parked => "Parked",
        PendingPasswordChangeStatus.Expired => "Expired",
        PendingPasswordChangeStatus.Cancelled => "Cancelled",
        _ => change.Status.ToString()
    };

    /// <summary>
    /// The sentence that sits beneath the status: why it is where it is. The target's own message is preferred
    /// where there is one, because the remedy is nearly always outside JIM and those are the words that name it.
    /// </summary>
    private static string? DescribeDetail(PendingPasswordChangeHeader change)
    {
        if (change.Status == PendingPasswordChangeStatus.Cancelled)
        {
            return change.CancelledByName == null
                ? "Cancelled by an administrator"
                : $"Cancelled by {change.CancelledByName}";
        }

        if (change.FailureReason is null or PasswordSetFailureReason.None)
            return null;

        var reason = DescribeReason(change.FailureReason.Value);
        return string.IsNullOrWhiteSpace(change.TargetMessage) ? reason : $"{reason}: {change.TargetMessage}";
    }

    private static string DescribeReason(PasswordSetFailureReason reason) => reason switch
    {
        PasswordSetFailureReason.Transient => "Target unavailable",
        PasswordSetFailureReason.ConfigurationFault => "Configuration fault",
        PasswordSetFailureReason.PolicyRejection => "Policy rejection",
        PasswordSetFailureReason.TargetObjectNotFound => "Account not found",
        PasswordSetFailureReason.UnsupportedOperation => "Unsupported operation",
        _ => reason.ToString()
    };

    /// <summary>
    /// Says what retrying this particular row will do. A waiting change is only pulled forward; a parked one is
    /// picked back up, which is worth saying plainly because the cause is usually still outside JIM.
    /// </summary>
    private static string RetryTooltip(PendingPasswordChangeHeader change) => change.Status switch
    {
        PendingPasswordChangeStatus.Pending =>
            "Attempt delivery now rather than waiting for the next scheduled attempt.",
        PendingPasswordChangeStatus.Cancelled =>
            "Put this change back on the queue and attempt delivery. It is delivered only if it has not expired in the meantime.",
        _ =>
            "Attempt delivery again. Deal with the reason the target refused it first, or it will simply park again."
    };
}
