@if (_preferencesLoaded)
{
    <MudTable @ref="_table" T="ScheduleHeader" ServerData="ServerReload"
              RowsPerPage="@_rowsPerPage" RowsPerPageChanged="OnRowsPerPageChanged"
              Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
              Outlined="true" Elevation="0" OnRowClick="HandleRowClick" RowClass="cursor-pointer schedules-row"
              Loading="@_loading" LoadingProgressColor="Color.Primary">
        <ToolBarContent>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="HandleCreateScheduleAsync">
                New Schedule
            </MudButton>
            <MudSpacer />
            <SearchField ValueChanged="@(s => OnSearch(s))" Class="mt-0" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Style="width: 48px;"></MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="name" T="ScheduleHeader">
                    <MudText Typo="Typo.button">Name</MudText>
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudText Typo="Typo.button">Steps</MudText>
            </MudTh>
            <MudTh>
                <MudText Typo="Typo.button">Trigger</MudText>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="nextruntime" T="ScheduleHeader">
                    <MudText Typo="Typo.button">Next Run</MudText>
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudTableSortLabel SortLabel="lastruntime" T="ScheduleHeader">
                    <MudText Typo="Typo.button">Last Run</MudText>
                </MudTableSortLabel>
            </MudTh>
            <MudTh>
                <MudText Typo="Typo.button">Status</MudText>
            </MudTh>
            <MudTh Style="text-align: right;">
                <MudText Typo="Typo.button">Actions</MudText>
            </MudTh>
        </HeaderContent>
        <RowTemplate Context="context">
            @* The expander is its own leading cell so that a row click keeps opening the Schedule editor; the cell
               stops propagation exactly as the Actions cell below does. *@
            <MudTd Style="width: 48px;" @onclick:stopPropagation="true">
                <MudTooltip Text="@(_expandedScheduleIds.Contains(context.Id) ? "Hide recent Schedule Executions" : "Show recent Schedule Executions")" Arrow="true" Placement="Placement.Top">
                    <MudIconButton Size="Size.Small"
                                   Icon="@(_expandedScheduleIds.Contains(context.Id) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                   OnClick="@(() => ToggleScheduleExpandedAsync(context.Id))" />
                </MudTooltip>
            </MudTd>
            <MudTd DataLabel="Name">
                <MudText Typo="Typo.body1">@context.Name</MudText>
                @if (!string.IsNullOrEmpty(context.Description))
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">@context.Description</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Steps">
                <MudChip T="string" Variant="Variant.Text" Color="Color.Default">
                    @context.StepCount step@(context.StepCount != 1 ? "s" : "")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Trigger">
                @if (context.TriggerType == ScheduleTriggerType.Cron)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Info"
                             Icon="@Icons.Material.Filled.Schedule">
                        @GetScheduleDescription(context)
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Default"
                             Icon="@Icons.Material.Filled.TouchApp">
                        Manual
                    </MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Next Run">
                @if (context.NextRunTime.HasValue && context.IsEnabled && context.TriggerType == ScheduleTriggerType.Cron)
                {
                    var nextRunTime = context.NextRunTime.Value;
                    <MudTooltip Text="@nextRunTime.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                        <MudText Typo="Typo.body1">@nextRunTime.ToLocalTime().ToRelativeTime()</MudText>
                    </MudTooltip>
                }
                else
                {
                    <EmptyValue />
                }
            </MudTd>
            <MudTd DataLabel="Last Run">
                @if (context.LastRunTime.HasValue)
                {
                    var lastRunTime = context.LastRunTime.Value;
                    <MudTooltip Text="@lastRunTime.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                        <MudText Typo="Typo.body1">@lastRunTime.ToLocalTime().ToRelativeTime()</MudText>
                    </MudTooltip>
                }
                else
                {
                    <MudText Typo="Typo.body1" Class="mud-text-disabled">Never</MudText>
                }
                @* When it last ran is only half the story: a Schedule failing every night looks identical to a
                   healthy one without its outcome. A failed run also says which step it stopped on. *@
                @if (context.LastExecutionStatus.HasValue)
                {
                    var lastExecutionStatus = context.LastExecutionStatus.Value;
                    <div>
                        <MudChip T="string" Variant="Variant.Text" Class="ml-0"
                                 Color="Helpers.GetScheduleExecutionMudBlazorColorForStatus(lastExecutionStatus)">
                            @GetLastOutcomeLabel(context)
                        </MudChip>
                    </div>
                }
            </MudTd>
            <MudTd DataLabel="Status">
                @if (context.IsEnabled)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Success">
                        Enabled
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Default">
                        Disabled
                    </MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right;" @onclick:stopPropagation="true">
                <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                    @if (context.IsEnabled)
                    {
                        <MudTooltip Text="Disable" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Pause" Size="Size.Small"
                                           OnClick="@(() => HandleToggleEnabledAsync(context))" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="Enable" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                                           OnClick="@(() => HandleToggleEnabledAsync(context))" />
                        </MudTooltip>
                    }
                    <MudTooltip Text="Run Now" Arrow="true" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => HandleRunNowAsync(context))"
                                       Disabled="@(context.StepCount == 0)" />
                    </MudTooltip>
                    @if (context.BuiltIn)
                    {
                        <MudTooltip Text="Built-in schedule; cannot be deleted" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Disabled="true" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="Delete" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => HandleDeleteAsync(context))" />
                        </MudTooltip>
                    }
                </MudStack>
            </MudTd>
        </RowTemplate>
        <ChildRowContent Context="context">
            @if (_expandedScheduleIds.Contains(context.Id))
            {
                <MudTr>
                    @* The executions belong to the Schedule above them, so they are inset rather than laid out
                       full-bleed: the left padding clears the parent table's expander column. The listing itself
                       is an ordinary bordered table, exactly as every other listing in JIM; the border is what
                       stops its header row reading as more rows of the Schedules table. *@
                    <td colspan="8" class="pa-0">
                        <div class="pl-12 pr-4 py-3">
                            @* Nested container treatment: a bordered table inside an outlined MudPaper. site.css
                               styles this automatically off the .mud-paper descendant selectors (recessed
                               --jim-inner-surface header, paper-surface data rows, inner border colour), so the
                               nesting is expressed by the structure rather than by a hand-picked tint. Canonical
                               example: ThemePreview.razor > Nested Table. *@
                            <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                                @* Deliberately no TableDensityToggle: this is a short child listing inside another
                                   table's row, and a second density toggle on the same page would be confusing. *@
                                <MudTable Items="@GetRecentExecutions(context.Id)" T="ScheduleExecution"
                                          Hover="true" Dense="true" Breakpoint="Breakpoint.Sm"
                                          Outlined="true" Elevation="0"
                                          Loading="@_loadingScheduleIds.Contains(context.Id)" LoadingProgressColor="Color.Primary">
                                <ToolBarContent>
                                    @* The Schedule is named on the parent row directly above, so repeating it here is noise. *@
                                    <MudText Typo="Typo.subtitle2">Recent Schedule Executions</MudText>
                                </ToolBarContent>
                                <HeaderContent>
                                    <MudTh><MudText Typo="Typo.button">Started</MudText></MudTh>
                                    <MudTh><MudText Typo="Typo.button">Outcome</MudText></MudTh>
                                    <MudTh><MudText Typo="Typo.button">Duration</MudText></MudTh>
                                    <MudTh><MudText Typo="Typo.button">Steps</MudText></MudTh>
                                    <MudTh><MudText Typo="Typo.button">Initiated By</MudText></MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                @* MudTable keys each row on its item internally, so the loop's own @key moves with the rows. *@
                                <RowTemplate Context="execution">
                                    <MudTd DataLabel="Started">
                                        @if (execution.StartedAt.HasValue)
                                        {
                                            var startedAt = execution.StartedAt.Value;
                                            <MudTooltip Text="@startedAt.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                                                <span>@startedAt.ToLocalTime().ToRelativeTime()</span>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <EmptyValue />
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Outcome">
                                        <MudChip T="string" Variant="Variant.Text" Class="ml-0"
                                                 Color="Helpers.GetScheduleExecutionMudBlazorColorForStatus(execution.Status)">
                                            @execution.Status.ToString().SplitOnCapitalLetters()
                                        </MudChip>
                                    </MudTd>
                                    <MudTd DataLabel="Duration">
                                        @{ var duration = GetExecutionDuration(execution); }
                                        @if (duration.HasValue)
                                        {
                                            var durationValue = duration.Value;
                                            <span>@durationValue.ToAbbreviatedString()</span>
                                        }
                                        else
                                        {
                                            <EmptyValue />
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Steps">
                                        @if (execution.TotalSteps > 0)
                                        {
                                            <span>@(Math.Min(execution.CurrentStepIndex + 1, execution.TotalSteps)) of @execution.TotalSteps</span>
                                        }
                                        else
                                        {
                                            <EmptyValue />
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="Initiated By">
                                        <AuditPrincipalLink PrincipalType="execution.InitiatedByType"
                                                            PrincipalId="execution.InitiatedById"
                                                            PrincipalName="@execution.InitiatedByName" />
                                    </MudTd>
                                    <MudTd>
                                        <MudLink Href="@($"/admin/operations/schedule-executions/{execution.Id}")">View Schedule Execution</MudLink>
                                    </MudTd>
                                </RowTemplate>
                                <NoRecordsContent>
                                    <MudText Typo="Typo.body1" Class="mud-text-secondary">This Schedule has not run yet.</MudText>
                                </NoRecordsContent>
                                </MudTable>
                            </MudPaper>
                        </div>
                    </td>
                </MudTr>
            }
        </ChildRowContent>
        <NoRecordsContent>
            <MudStack AlignItems="AlignItems.Center" Class="pa-8">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Large" Class="mud-text-disabled" />
                <MudText Typo="Typo.body1" Class="mud-text-secondary">No schedules have been created yet.</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                           StartIcon="@Icons.Material.Filled.Add" OnClick="HandleCreateScheduleAsync" Class="mt-2">
                    Create Your First Schedule
                </MudButton>
            </MudStack>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>

    @* The table is dense, which tightens vertical cell padding; restore top/bottom breathing room so it
       balances the horizontal padding. MudBlazor's dense rule (.mud-table-dense * .mud-table-row
       .mud-table-cell) is three classes, so this selector adds the row+cell element names to outrank it. *@
    <style>
        tr.schedules-row.mud-table-row td.mud-table-cell {
            padding-top: 12px;
            padding-bottom: 12px;
        }
    </style>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// How many recent Schedule Executions an expanded row lists. Enough to see a pattern (a run that has failed
    /// every night) without turning the row into a history page; the Schedule Execution detail page is one click away.
    /// </summary>
    private const int RecentExecutionCount = 5;

    private MudTable<ScheduleHeader>? _table;
    private string _searchString = "";
    private bool _loading;
    private int _rowsPerPage = 10;
    private bool _preferencesLoaded;

    // Rows whose recent-executions panel is open, and the executions loaded for them. Both are keyed on the Schedule
    // id and are cleared whenever the table reloads, because ServerData replaces the whole item set on paging,
    // searching and sorting; a stale id would otherwise leave a panel open over a different Schedule.
    private readonly HashSet<Guid> _expandedScheduleIds = new();
    private readonly HashSet<Guid> _loadingScheduleIds = new();
    private readonly Dictionary<Guid, List<ScheduleExecution>> _recentExecutions = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_preferencesLoaded)
        {
            try
            {
                var preferredSize = await PreferenceService.GetRowsPerPageAsync();
                _rowsPerPage = preferredSize;
                _preferencesLoaded = true;
                StateHasChanged();
            }
            catch
            {
                // JS interop not yet available, will retry on next render
            }
        }
    }

    private async Task OnRowsPerPageChanged(int newSize)
    {
        _rowsPerPage = newSize;
        await PreferenceService.SetRowsPerPageAsync(newSize);
    }

    private async Task<TableData<ScheduleHeader>> ServerReload(TableState state, CancellationToken token)
    {
        _loading = true;
        StateHasChanged();

        // The item set is about to be replaced, so any expansion state describing the previous set is meaningless.
        _expandedScheduleIds.Clear();
        _loadingScheduleIds.Clear();
        _recentExecutions.Clear();

        try
        {
            using var jim = JimFactory.Create();
            var page = state.Page + 1;
            var sortDescending = state.SortDirection == SortDirection.Descending;

            var result = await jim.Scheduler.GetScheduleHeadersAsync(
                page,
                state.PageSize,
                string.IsNullOrWhiteSpace(_searchString) ? null : _searchString,
                state.SortLabel,
                sortDescending);

            return new TableData<ScheduleHeader>
            {
                TotalItems = result.TotalResults,
                Items = result.Results
            };
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void OnSearch(string text)
    {
        _searchString = text;
        _table?.ReloadServerData();
    }

    /// <summary>
    /// Opens or closes a Schedule's recent-executions panel, loading its executions the first time it is opened.
    /// </summary>
    private async Task ToggleScheduleExpandedAsync(Guid scheduleId)
    {
        if (_expandedScheduleIds.Remove(scheduleId))
            return;

        _expandedScheduleIds.Add(scheduleId);

        // Already loaded for this item set; re-opening the panel costs nothing.
        if (_recentExecutions.ContainsKey(scheduleId))
            return;

        _loadingScheduleIds.Add(scheduleId);
        try
        {
            using var jim = JimFactory.Create();
            var result = await jim.Scheduler.GetScheduleExecutionsAsync(scheduleId, 1, RecentExecutionCount, "queuedAt", true);
            _recentExecutions[scheduleId] = result.Results;
        }
        finally
        {
            _loadingScheduleIds.Remove(scheduleId);
        }
    }

    private IReadOnlyList<ScheduleExecution> GetRecentExecutions(Guid scheduleId) =>
        _recentExecutions.TryGetValue(scheduleId, out var executions) ? executions : [];

    /// <summary>
    /// How long an execution took: the elapsed time so far while it is still running, and the total once it has
    /// finished. Null until it has started.
    /// </summary>
    private static TimeSpan? GetExecutionDuration(ScheduleExecution execution)
    {
        if (!execution.StartedAt.HasValue)
            return null;

        var startedAt = execution.StartedAt.Value;
        return execution.CompletedAt.HasValue ? execution.CompletedAt.Value - startedAt : DateTime.UtcNow - startedAt;
    }

    /// <summary>
    /// The label for the last execution's outcome chip. A failed run names the step it stopped on, which saves the
    /// administrator a click through to the Schedule Execution; the stored step index is 0-based and is shown
    /// 1-based, clamped to the total in case the execution failed after advancing past its last step.
    /// </summary>
    private static string GetLastOutcomeLabel(ScheduleHeader header)
    {
        if (!header.LastExecutionStatus.HasValue)
            return string.Empty;

        var status = header.LastExecutionStatus.Value;
        if (status != ScheduleExecutionStatus.Failed)
            return status.ToString().SplitOnCapitalLetters();

        if (!header.LastExecutionCurrentStepIndex.HasValue || !header.LastExecutionTotalSteps.HasValue)
            return "Failed";

        var totalSteps = header.LastExecutionTotalSteps.Value;
        if (totalSteps < 1)
            return "Failed";

        var stepNumber = Math.Min(header.LastExecutionCurrentStepIndex.Value + 1, totalSteps);
        return $"Failed on step {stepNumber}";
    }

    private async Task HandleRowClick(TableRowClickEventArgs<ScheduleHeader> args)
    {
        if (_loading || args.Item == null)
            return;

        await OpenScheduleEditorAsync(args.Item.Id);
    }

    private async Task HandleCreateScheduleAsync()
    {
        await OpenScheduleEditorAsync(null);
    }

    private async Task OpenScheduleEditorAsync(Guid? scheduleId)
    {
        var parameters = new DialogParameters<ScheduleEditorDialog>
        {
            { x => x.ScheduleId, scheduleId }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            NoHeader = false
        };

        var dialog = await DialogService.ShowAsync<ScheduleEditorDialog>(
            scheduleId.HasValue ? "Edit Schedule" : "New Schedule",
            parameters,
            options);

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            _table?.ReloadServerData();
        }
    }

    private async Task HandleToggleEnabledAsync(ScheduleHeader header)
    {
        using var jim = JimFactory.Create();

        // The table holds lightweight projections, so the Schedule itself is re-loaded before it is mutated and
        // handed to the update path; a DTO is not something the repository can persist.
        var schedule = await jim.Scheduler.GetScheduleAsync(header.Id);
        if (schedule == null)
        {
            Snackbar.Add($"Schedule '{header.Name}' no longer exists.", Severity.Warning);
            _table?.ReloadServerData();
            return;
        }

        schedule.IsEnabled = !schedule.IsEnabled;

        // Update audit info
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        schedule.LastUpdated = DateTime.UtcNow;
        schedule.LastUpdatedByType = ActivityInitiatorType.User;
        schedule.LastUpdatedById = user.Id;
        schedule.LastUpdatedByName = user.DisplayName;

        await jim.Scheduler.UpdateScheduleAsync(schedule, ActivityInitiatorType.User, user.Id, user.DisplayName);

        var action = schedule.IsEnabled ? "enabled" : "disabled";
        Snackbar.Add($"Schedule '{schedule.Name}' has been {action}.", Severity.Success);

        _table?.ReloadServerData();
    }

    private async Task HandleRunNowAsync(ScheduleHeader header)
    {
        if (header.StepCount == 0)
        {
            Snackbar.Add("Cannot run a schedule with no steps.", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Run Schedule Now",
            $"Are you sure you want to run '{header.Name}' now? This will queue all steps for execution.",
            yesText: "Run Now",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        // Load schedule with steps for execution
        var scheduleWithSteps = await jim.Scheduler.GetScheduleWithStepsAsync(header.Id);
        if (scheduleWithSteps == null)
        {
            Snackbar.Add("Schedule not found.", Severity.Error);
            return;
        }

        var execution = await jim.Scheduler.StartScheduleExecutionAsync(
            scheduleWithSteps,
            ActivityInitiatorType.User,
            user.Id,
            user.DisplayName);

        if (execution != null)
        {
            Snackbar.Add($"Schedule '{header.Name}' has been queued for execution.", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Failed to start schedule '{header.Name}'. It may have no steps.", Severity.Warning);
        }

        _table?.ReloadServerData();
    }

    private async Task HandleDeleteAsync(ScheduleHeader header)
    {
        // Built-in schedules cannot be deleted (the delete affordance is already locked for them; this is the
        // defence-in-depth guard so the application layer never throws into the circuit).
        if (header.BuiltIn)
        {
            Snackbar.Add($"The built-in schedule '{header.Name}' cannot be deleted.", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Schedule",
            $"Are you sure you want to delete '{header.Name}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        // offer an optional reason for the configuration change history; cancelling aborts the delete
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Delete");
        if (cancelled)
            return;

        using var jim = JimFactory.Create();

        // As with the enable/disable handler above, the delete path needs the Schedule entity, not the projection.
        var schedule = await jim.Scheduler.GetScheduleAsync(header.Id);
        if (schedule == null)
        {
            Snackbar.Add($"Schedule '{header.Name}' no longer exists.", Severity.Warning);
            _table?.ReloadServerData();
            return;
        }

        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.Scheduler.DeleteScheduleAsync(schedule, ActivityInitiatorType.User, user.Id, user.DisplayName, changeReason);
        Snackbar.Add($"Schedule '{schedule.Name}' has been deleted.", Severity.Success);
        _table?.ReloadServerData();
    }

    /// <summary>
    /// Gets a concise human-readable description of a schedule using its pattern metadata.
    /// </summary>
    private static string GetScheduleDescription(ScheduleHeader schedule)
    {
        if (schedule.TriggerType != ScheduleTriggerType.Cron)
            return "Manual";

        // Use pattern metadata for concise descriptions
        var dayDesc = GetDayDescriptionFromSchedule(schedule.DaysOfWeek);

        switch (schedule.PatternType)
        {
            case SchedulePatternType.Interval:
                var unit = schedule.IntervalUnit == ScheduleIntervalUnit.Hours ? "hr" : "min";
                var intervalDesc = $"Every {schedule.IntervalValue ?? 1} {unit}";

                if (!string.IsNullOrEmpty(schedule.IntervalWindowStart) &&
                    !string.IsNullOrEmpty(schedule.IntervalWindowEnd))
                {
                    var start = FormatTimeString(schedule.IntervalWindowStart);
                    var end = FormatTimeString(schedule.IntervalWindowEnd);
                    return $"{dayDesc}, {intervalDesc} ({start}-{end})";
                }
                return $"{dayDesc}, {intervalDesc}";

            case SchedulePatternType.SpecificTimes:
                if (!string.IsNullOrEmpty(schedule.RunTimes))
                {
                    var times = schedule.RunTimes.Split(',', StringSplitOptions.RemoveEmptyEntries);
                    if (times.Length == 1)
                    {
                        return $"{dayDesc} at {FormatTimeString(times[0].Trim())}";
                    }
                    if (times.Length <= 3)
                    {
                        var timeList = string.Join(", ", times.Select(t => FormatTimeString(t.Trim())));
                        return $"{dayDesc} at {timeList}";
                    }
                    // Many times - summarise
                    return $"{dayDesc}, {times.Length} times/day";
                }
                break;

            case SchedulePatternType.Custom:
                // Fall back to cron parsing for custom expressions
                return GetCronDescription(schedule.CronExpression);
        }

        // Fallback to cron parsing if pattern metadata isn't available
        return GetCronDescription(schedule.CronExpression);
    }

    /// <summary>
    /// Gets day description from DaysOfWeek string (e.g., "1,2,3,4,5").
    /// </summary>
    private static string GetDayDescriptionFromSchedule(string? daysOfWeek)
    {
        if (string.IsNullOrEmpty(daysOfWeek))
            return "Daily";

        var days = daysOfWeek.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Where(d => int.TryParse(d.Trim(), out _))
            .Select(d => int.Parse(d.Trim()))
            .OrderBy(d => d)
            .ToList();

        if (days.Count == 0 || days.Count == 7)
            return "Daily";
        if (days.SequenceEqual(new[] { 1, 2, 3, 4, 5 }))
            return "Weekdays";
        if (days.SequenceEqual(new[] { 0, 6 }))
            return "Weekends";

        // For 6 days, show which day is excluded
        if (days.Count == 6)
        {
            var missing = Enumerable.Range(0, 7).Except(days).First();
            var missingName = missing switch
            {
                0 => "Sun", 1 => "Mon", 2 => "Tue", 3 => "Wed",
                4 => "Thu", 5 => "Fri", 6 => "Sat", _ => "?"
            };
            return $"Daily exc. {missingName}";
        }

        // Short list of days
        var dayNames = days.Select(d => d switch
        {
            0 => "Sun", 1 => "Mon", 2 => "Tue", 3 => "Wed",
            4 => "Thu", 5 => "Fri", 6 => "Sat", _ => "?"
        });
        return string.Join(", ", dayNames);
    }

    /// <summary>
    /// Formats a time string (HH:mm) to AM/PM format.
    /// </summary>
    private static string FormatTimeString(string timeStr)
    {
        if (TimeSpan.TryParse(timeStr.Trim(), out var time))
        {
            var hour = time.Hours;
            var minute = time.Minutes;
            var period = hour >= 12 ? "pm" : "am";
            var displayHour = hour > 12 ? hour - 12 : (hour == 0 ? 12 : hour);
            return minute == 0 ? $"{displayHour}{period}" : $"{displayHour}:{minute:D2}{period}";
        }
        return timeStr;
    }

    /// <summary>
    /// Converts a cron expression to a human-readable description.
    /// </summary>
    private static string GetCronDescription(string? cronExpression)
    {
        if (string.IsNullOrWhiteSpace(cronExpression))
            return "Not configured";

        // Parse common patterns for display
        var parts = cronExpression.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 5)
            return cronExpression;

        var minute = parts[0];
        var hour = parts[1];
        var dayOfMonth = parts[2];
        var month = parts[3];
        var dayOfWeek = parts[4];

        // Get day description
        var dayDesc = GetDayDescription(dayOfWeek);

        // Handle multiple specific hours (e.g., "0 9,12,15,18 * * 1-5")
        if (dayOfMonth == "*" && month == "*" && hour.Contains(',') && !hour.Contains('/'))
        {
            var hours = hour.Split(',')
                .Where(h => int.TryParse(h.Trim(), out _))
                .Select(h => int.Parse(h.Trim()))
                .ToList();

            if (hours.Count > 0)
            {
                var timeList = string.Join(", ", hours.Select(h => FormatHour(h, int.TryParse(minute, out var m) ? m : 0)));
                return $"{dayDesc} at {timeList}";
            }
        }

        // Daily at specific time
        if (dayOfMonth == "*" && month == "*" && dayOfWeek == "*")
        {
            if (hour.StartsWith("*/"))
            {
                var interval = hour[2..];
                return $"Every {interval} hours";
            }
            return $"Daily at {FormatTime(hour, minute)}";
        }

        // Single time schedules with day restrictions
        if (dayOfMonth == "*" && month == "*" && int.TryParse(hour, out _))
        {
            return $"{dayDesc} at {FormatTime(hour, minute)}";
        }

        // Hourly
        if (hour == "*" && dayOfMonth == "*" && month == "*")
        {
            var hourlyDesc = minute == "0" ? "Hourly" : $"Hourly at :{minute.PadLeft(2, '0')}";
            if (dayOfWeek != "*")
                return $"{dayDesc}, {hourlyDesc.ToLower()}";
            return hourlyDesc;
        }

        // Every N minutes
        if (minute.StartsWith("*/") && hour == "*")
        {
            var interval = minute[2..];
            var minDesc = $"Every {interval} minutes";
            if (dayOfWeek != "*")
                return $"{dayDesc}, every {interval} min";
            return minDesc;
        }

        // Every N hours
        if (hour.StartsWith("*/") && minute == "0")
        {
            var interval = hour[2..];
            var hourDesc = $"Every {interval} hours";
            if (dayOfWeek != "*")
                return $"{dayDesc}, every {interval} hrs";
            return hourDesc;
        }

        // Default: show abbreviated cron
        return cronExpression;
    }

    private static string GetDayDescription(string dayOfWeek)
    {
        if (dayOfWeek == "*")
            return "Daily";
        if (dayOfWeek == "1-5" || dayOfWeek == "MON-FRI")
            return "Weekdays";
        if (dayOfWeek == "0,6" || dayOfWeek == "SAT,SUN")
            return "Weekends";

        // Try to parse as comma-separated days
        var dayNumbers = dayOfWeek.Split(',')
            .Where(d => int.TryParse(d.Trim(), out _))
            .Select(d => int.Parse(d.Trim()))
            .ToList();

        if (dayNumbers.Count > 0)
        {
            if (dayNumbers.Count == 7)
                return "Daily";
            if (dayNumbers.OrderBy(d => d).SequenceEqual(new[] { 1, 2, 3, 4, 5 }))
                return "Weekdays";
            if (dayNumbers.OrderBy(d => d).SequenceEqual(new[] { 0, 6 }))
                return "Weekends";

            var dayNames = dayNumbers.Select(d => d switch
            {
                0 => "Sun",
                1 => "Mon",
                2 => "Tue",
                3 => "Wed",
                4 => "Thu",
                5 => "Fri",
                6 => "Sat",
                _ => "?"
            });
            return string.Join(", ", dayNames);
        }

        return dayOfWeek;
    }

    private static string FormatTime(string hour, string minute)
    {
        if (!int.TryParse(hour, out var h) || !int.TryParse(minute, out var m))
            return $"{hour}:{minute}";

        return FormatHour(h, m);
    }

    private static string FormatHour(int hour, int minute)
    {
        var period = hour >= 12 ? "PM" : "AM";
        var displayHour = hour > 12 ? hour - 12 : (hour == 0 ? 12 : hour);
        return $"{displayHour}:{minute:D2} {period}";
    }
}
