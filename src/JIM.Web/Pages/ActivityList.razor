@page "/activity"
@page "/activity/mine"
@attribute [Authorize(Roles = "User")]
@implements IDisposable
@using JIM.Models.Activities
@using JIM.Models.Enums
@using JIM.Models.Staging
@using JIM.Utilities
@using JIM.Web.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@_pageTitle</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />@_pageTitle</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

<MudText Typo="Typo.subtitle1" Class="mud-text-secondary mt-2 mb-0">
    @_pageDescription
</MudText>

@* ─── Category quick-filter ─── *@
<MudStack Row="true" Spacing="2" Class="mt-4 flex-wrap" AlignItems="AlignItems.Center">
    <MudText Typo="Typo.button" Class="mud-text-secondary">Category:</MudText>
    <MudChip T="string" OnClick="() => OnCategorySelectedAsync(null)"
             Variant="@(IsAllCategorySelected ? Variant.Filled : Variant.Outlined)"
             Color="@(IsAllCategorySelected ? Color.Primary : Color.Default)">All</MudChip>
    @foreach (var chipCategory in Enum.GetValues<ActivityTargetCategory>())
    {
        <MudChip T="string" OnClick="() => OnCategorySelectedAsync(chipCategory)"
                 Variant="@(_selectedCategory == chipCategory ? Variant.Filled : Variant.Outlined)"
                 Color="@(_selectedCategory == chipCategory ? Color.Primary : Color.Default)">@GetCategoryLabel(chipCategory)</MudChip>
    }
</MudStack>

<MudStack Row="true" Spacing="3" Class="mt-3 flex-wrap" AlignItems="AlignItems.End">
    <MudItem Class="flex-grow-1">
        <MudSelect T="ActivityTargetOperationType" Label="Operation" Variant="Variant.Outlined"
                   Dense="true" Clearable="true" MultiSelection="true"
                   SelectedValues="_filterOperations"
                   SelectedValuesChanged="OnOperationFilterChangedAsync"
                   MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectText))">
            <MudSelectItem T="ActivityTargetOperationType" Value="ActivityTargetOperationType.Create">Create</MudSelectItem>
            <MudSelectItem T="ActivityTargetOperationType" Value="ActivityTargetOperationType.Read">Read</MudSelectItem>
            <MudSelectItem T="ActivityTargetOperationType" Value="ActivityTargetOperationType.Update">Update</MudSelectItem>
            <MudSelectItem T="ActivityTargetOperationType" Value="ActivityTargetOperationType.Delete">Delete</MudSelectItem>
            <MudSelectItem T="ActivityTargetOperationType" Value="ActivityTargetOperationType.Clear">Clear</MudSelectItem>
            <MudSelectItem T="ActivityTargetOperationType" Value="ActivityTargetOperationType.Execute">Execute</MudSelectItem>
            <MudSelectItem T="ActivityTargetOperationType" Value="ActivityTargetOperationType.ImportHierarchy">Import Hierarchy</MudSelectItem>
            <MudSelectItem T="ActivityTargetOperationType" Value="ActivityTargetOperationType.ImportSchema">Import Schema</MudSelectItem>
            <MudSelectItem T="ActivityTargetOperationType" Value="ActivityTargetOperationType.Revert">Revert</MudSelectItem>
            <MudSelectItem T="ActivityTargetOperationType" Value="ActivityTargetOperationType.Authenticate">Authenticate</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1">
        <MudSelect T="ActivityOutcomeType" Label="Outcomes" Variant="Variant.Outlined"
                   Dense="true" Clearable="true" MultiSelection="true"
                   SelectedValues="_filterOutcomes"
                   SelectedValuesChanged="OnOutcomeFilterChangedAsync"
                   MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectText))">
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.Added">Added</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.Updated">Updated</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.Deleted">Deleted</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.Projected">Projected</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.Joined">Joined</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.AttributeFlows">Attribute Flows</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.Disconnected">Disconnected</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.DriftCorrections">Drift Corrections</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.Provisioned">Provisioned</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.Exported">Exported</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.Deprovisioned">Deprovisioned</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.Created">Created</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.PendingExports">Pending Exports</MudSelectItem>
            <MudSelectItem T="ActivityOutcomeType" Value="ActivityOutcomeType.Errors">Errors</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1">
        <MudSelect T="ActivityTargetType" Label="Type" Variant="Variant.Outlined"
                   Dense="true" Clearable="true" MultiSelection="true"
                   SelectedValues="_filterTypes"
                   SelectedValuesChanged="OnTypeFilterChangedAsync"
                   MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectText))">
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.ConnectedSystem">Connected System</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.ConnectedSystemRunProfile">Connected System Run Profile</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.SynchronisationRule">Synchronisation Rule</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.MetaverseObject">Metaverse Object</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.ConnectedSystemObject">Connected System Object</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.MetaverseAttribute">Metaverse Attribute</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.ExampleDataTemplate">Example Data Template</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.DataGeneration">Data Generation</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.TrustedCertificate">Trusted Certificate</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.ObjectMatchingRule">Object Matching Rule</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.ServiceSetting">Service Setting</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.HistoryRetentionCleanup">History Retention Cleanup</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.MetaverseObjectHousekeeping">Metaverse Object Housekeeping</MudSelectItem>
            <MudSelectItem T="ActivityTargetType" Value="ActivityTargetType.Authentication">Authentication</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1">
        <MudSelect T="ActivityStatus" Label="Status" Variant="Variant.Outlined"
                   Dense="true" Clearable="true" MultiSelection="true"
                   SelectedValues="_filterStatuses"
                   SelectedValuesChanged="OnStatusFilterChangedAsync"
                   MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectText))">
            <MudSelectItem T="ActivityStatus" Value="ActivityStatus.InProgress">In Progress</MudSelectItem>
            <MudSelectItem T="ActivityStatus" Value="ActivityStatus.Complete">Complete</MudSelectItem>
            <MudSelectItem T="ActivityStatus" Value="ActivityStatus.CompleteWithWarning">Complete With Warning</MudSelectItem>
            <MudSelectItem T="ActivityStatus" Value="ActivityStatus.CompleteWithError">Complete With Error</MudSelectItem>
            <MudSelectItem T="ActivityStatus" Value="ActivityStatus.FailedWithError">Failed With Error</MudSelectItem>
            <MudSelectItem T="ActivityStatus" Value="ActivityStatus.Cancelled">Cancelled</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1">
        <MudSelect T="ActivityInitiatorType" Label="Initiator" Variant="Variant.Outlined"
                   Dense="true" Clearable="true" MultiSelection="true"
                   SelectedValues="_filterInitiatorTypes"
                   SelectedValuesChanged="OnInitiatorTypeFilterChangedAsync"
                   MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectText))">
            <MudSelectItem T="ActivityInitiatorType" Value="ActivityInitiatorType.User">User</MudSelectItem>
            <MudSelectItem T="ActivityInitiatorType" Value="ActivityInitiatorType.ApiKey">API Key</MudSelectItem>
            <MudSelectItem T="ActivityInitiatorType" Value="ActivityInitiatorType.System">System</MudSelectItem>
            <MudSelectItem T="ActivityInitiatorType" Value="ActivityInitiatorType.Anonymous">Anonymous</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1" Style="max-width: 280px;">
        @* No dense margin: matches the height of the neighbouring filter selects.
           Max-width caps MudDateRangePicker's much wider default (~2x a select),
           which otherwise starves the trailing checkbox and pause button of row
           space and pushes them onto their own line. *@
        <MudDateRangePicker Label="Created between" Variant="Variant.Outlined"
                            DateRange="_filterDateRange" DateRangeChanged="OnDateRangeChangedAsync"
                            Clearable="true" AutoClose="true" />
    </MudItem>
    <MudItem Class="d-flex align-end">
        <MudCheckBox T="bool" Value="_filterHasChildren" ValueChanged="OnHasChildrenFilterChangedAsync"
                     Label="Has child activities" Dense="true" Class="mb-1 mud-typography-nowrap" />
    </MudItem>
    <MudItem Class="d-flex align-end mb-2">
        <MudTooltip Text="@(_pollingPaused ? "Resume auto-refresh" : "Pause auto-refresh")" Placement="Placement.Top">
            <MudIconButton Icon="@(_pollingPaused ? Icons.Material.Filled.PlayArrow : Icons.Material.Filled.Pause)"
                           Size="Size.Small"
                           OnClick="@(() => _pollingPaused = !_pollingPaused)"
                           Color="@(_pollingPaused ? Color.Warning : Color.Default)" />
        </MudTooltip>
    </MudItem>
</MudStack>

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the search box and the toolbar
   count) lives in the shared grid; this page supplies the columns, the window loader, the page-owned filters
   above and the empty states. *@
<VirtualisedDataGrid @ref="_grid" T="Activity"
                     ContainerId="activity-list"
                     StateKey="@(_isMyActivity ? "/activity/mine" : "/activity")"
                     DefaultSortBy="created"
                     DefaultSortDescending="true"
                     Height="calc(100vh - 570px)"
                     LoadWindow="LoadWindowAsync"
                     RowClicked="HandleRowClicked"
                     SingularName="Activity"
                     PluralName="Activities"
                     SearchPlaceholder="Search target or initiator">
    <Columns>
        <TemplateColumn T="Activity" Title="Operation" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Operation" Name="operation" />
            </HeaderTemplate>
            <CellTemplate>
                <MudChip T="string" Variant="Variant.Text"
                         Color="Helpers.GetActivityMudBlazorColorForOperation(context.Item.TargetOperationType)">
                    @context.Item.TargetOperationType.ToString().SplitOnCapitalLetters()
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="Activity" Title="Target" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Target" Name="target" />
            </HeaderTemplate>
            <CellTemplate>
                @if (!string.IsNullOrEmpty(context.Item.TargetContext) && !string.IsNullOrEmpty(context.Item.TargetName))
                {
                    <span><strong>@context.Item.TargetContext</strong> → @context.Item.TargetName</span>
                }
                else if (!string.IsNullOrEmpty(context.Item.TargetContext))
                {
                    <span><strong>@context.Item.TargetContext</strong></span>
                }
                else if (!string.IsNullOrEmpty(context.Item.TargetName))
                {
                    @context.Item.TargetName
                }
                else
                {
                    <EmptyValue />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="Activity" Title="Outcomes" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Outcomes</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @{
                    var activity = context.Item;
                }
                @if (activity.TargetType == ActivityTargetType.ConnectedSystemRunProfile
                     && activity.TargetOperationType == ActivityTargetOperationType.Execute
                     && activity.Status != ActivityStatus.InProgress)
                {
                    @* Run Profile execution stats - run-type-aware display *@
                    @if (HasAnyStats(activity))
                    {
                        var effectiveRunType = GetEffectiveRunType(activity.ConnectedSystemRunType, activity.TargetName);
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            @if (effectiveRunType == "Import")
                            {
                                @if (activity.TotalAdded > 0)
                                {
                                    <MudTooltip Text="CSOs Added" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Success" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.Added)" Class="jim-stat-chip">
                                            @activity.TotalAdded.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalUpdated > 0)
                                {
                                    <MudTooltip Text="CSOs Updated" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Info" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.Updated)" Class="jim-stat-chip">
                                            @activity.TotalUpdated.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalDeleted > 0)
                                {
                                    <MudTooltip Text="CSO Deletions Detected" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Error" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.Deleted)" Class="jim-stat-chip">
                                            @activity.TotalDeleted.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                            }
                            else if (effectiveRunType == "Sync")
                            {
                                @if (activity.TotalProjected > 0)
                                {
                                    <MudTooltip Text="MVOs Projected" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.Projected)" Class="jim-stat-chip">
                                            @activity.TotalProjected.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalJoined > 0)
                                {
                                    <MudTooltip Text="CSOs Joined" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.Joined)" Class="jim-stat-chip">
                                            @activity.TotalJoined.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalAttributeFlows > 0)
                                {
                                    <MudTooltip Text="MVOs with Attribute Flow" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Info" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.AttributeFlow)" Class="jim-stat-chip">
                                            @activity.TotalAttributeFlows.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalDisconnected > 0)
                                {
                                    <MudTooltip Text="CSOs Disconnected" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.Disconnected)" Class="jim-stat-chip">
                                            @activity.TotalDisconnected.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalDisconnectedOutOfScope > 0)
                                {
                                    <MudTooltip Text="CSOs Disconnected (Out of Scope)" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.DisconnectedOutOfScope)" Class="jim-stat-chip">
                                            @activity.TotalDisconnectedOutOfScope.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalOutOfScopeRetainJoin > 0)
                                {
                                    <MudTooltip Text="CSOs Out of Scope (Join Retained)" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Info" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.OutOfScopeRetainJoin)" Class="jim-stat-chip">
                                            @activity.TotalOutOfScopeRetainJoin.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalDeleted > 0)
                                {
                                    <MudTooltip Text="CSOs Deleted" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Error" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.Deleted)" Class="jim-stat-chip">
                                            @activity.TotalDeleted.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalDriftCorrections > 0)
                                {
                                    <MudTooltip Text="CSOs Drift Corrected" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.DriftCorrection)" Class="jim-stat-chip">
                                            @activity.TotalDriftCorrections.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalProvisioned > 0)
                                {
                                    <MudTooltip Text="CSOs Provisioned" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOutcomeTypeIcon(ActivityRunProfileExecutionItemSyncOutcomeType.Provisioned)" Class="jim-stat-chip">
                                            @activity.TotalProvisioned.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalPendingExports > 0)
                                {
                                    <MudTooltip Text="CSO Pending Exports" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Info" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.PendingExport)" Class="jim-stat-chip">
                                            @activity.TotalPendingExports.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                            }
                            else if (effectiveRunType == "Export")
                            {
                                @if (activity.TotalExported > 0)
                                {
                                    <MudTooltip Text="CSOs Exported" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Info" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.Exported)" Class="jim-stat-chip">
                                            @activity.TotalExported.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (activity.TotalDeprovisioned > 0)
                                {
                                    <MudTooltip Text="CSOs Deprovisioned" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Color="Color.Error" Variant="Variant.Text"
                                                 Icon="@Helpers.GetOperationIcon(ObjectChangeType.Deprovisioned)" Class="jim-stat-chip">
                                            @activity.TotalDeprovisioned.ToString("N0")
                                        </MudChip>
                                    </MudTooltip>
                                }
                            }
                            @* Errors shown for all run types *@
                            @if (activity.TotalErrors > 0)
                            {
                                <MudTooltip Text="Errors" Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Color="Color.Error" Variant="Variant.Filled"
                                             Icon="@Icons.Material.Filled.Error" Class="jim-stat-chip">
                                        @activity.TotalErrors.ToString("N0")
                                    </MudChip>
                                </MudTooltip>
                            }
                        </MudStack>
                    }
                    else
                    {
                        @* Run Profile execution completed with no changes *@
                        <MudTooltip Text="No changes" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Color="Color.Default" Variant="Variant.Text"
                                     Icon="@Icons.Material.Outlined.CheckCircle" Class="jim-stat-chip">
                                0
                            </MudChip>
                        </MudTooltip>
                    }
                }
                else if (activity.TargetType == ActivityTargetType.DataGeneration
                         && activity.TargetOperationType == ActivityTargetOperationType.Execute
                         && activity.Status != ActivityStatus.InProgress)
                {
                    @* Data generation stats - only shows creates *@
                    <MudTooltip Text="Objects Generated" Arrow="true" Placement="Placement.Top">
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.Add" Class="jim-stat-chip">
                            @activity.TotalCreated.ToString("N0")
                        </MudChip>
                    </MudTooltip>
                }
                else if (activity.TargetType == ActivityTargetType.HistoryRetentionCleanup
                         && activity.Status != ActivityStatus.InProgress)
                {
                    @* History retention cleanup stats *@
                    var totalDeleted = (activity.DeletedCsoChangeCount ?? 0) + (activity.DeletedMvoChangeCount ?? 0) + (activity.DeletedActivityCount ?? 0);
                    @if (totalDeleted > 0)
                    {
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            @if (activity.DeletedCsoChangeCount > 0)
                            {
                                var deletedCsoChangeCount = activity.DeletedCsoChangeCount!.Value;
                                <MudTooltip Text="CSO Changes Deleted" Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Text"
                                             Icon="@Icons.Material.Filled.DeleteSweep" Class="jim-stat-chip">
                                        @deletedCsoChangeCount.ToString("N0")
                                    </MudChip>
                                </MudTooltip>
                            }
                            @if (activity.DeletedMvoChangeCount > 0)
                            {
                                var deletedMvoChangeCount = activity.DeletedMvoChangeCount!.Value;
                                <MudTooltip Text="MVO Changes Deleted" Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Text"
                                             Icon="@Icons.Material.Filled.DeleteSweep" Class="jim-stat-chip">
                                        @deletedMvoChangeCount.ToString("N0")
                                    </MudChip>
                                </MudTooltip>
                            }
                            @if (activity.DeletedActivityCount > 0)
                            {
                                var deletedActivityCount = activity.DeletedActivityCount!.Value;
                                <MudTooltip Text="Activities Deleted" Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Text"
                                             Icon="@Icons.Material.Filled.CleaningServices" Class="jim-stat-chip">
                                        @deletedActivityCount.ToString("N0")
                                    </MudChip>
                                </MudTooltip>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudTooltip Text="No records to clean up" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Color="Color.Default" Variant="Variant.Text"
                                     Icon="@Icons.Material.Outlined.CheckCircle" Class="jim-stat-chip">
                                0
                            </MudChip>
                        </MudTooltip>
                    }
                }
                else if (activity.TargetType == ActivityTargetType.Authentication)
                {
                    @* Aggregated failure events carry an attempt count; sign-in success events do not aggregate *@
                    @if (activity.AttemptCount is > 0)
                    {
                        var attemptCount = activity.AttemptCount.Value;
                        <MudTooltip Text="Failed Attempts" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Color="Color.Error" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.Report" Class="jim-stat-chip">
                                @attemptCount.ToString("N0")
                            </MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <EmptyValue />
                    }
                }
                else
                {
                    @* Stats not applicable for this activity type *@
                    <EmptyValue />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="Activity" Title="Type" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Type" Name="type" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.TargetType.ToString().SplitOnCapitalLetters()
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="Activity" Title="Initiated By" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Initiated By" Name="initiatedby" />
            </HeaderTemplate>
            <CellTemplate>
                @{
                    var activity = context.Item;
                    if (activity.InitiatedByType == ActivityInitiatorType.User)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-1" Style="vertical-align: middle;" />
                        <span>@activity.InitiatedByName</span>
                    }
                    else if (activity.InitiatedByType == ActivityInitiatorType.ApiKey)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Key" Class="mr-1" Style="vertical-align: middle;" />
                        <span>@activity.InitiatedByName</span>
                    }
                    else if (activity.InitiatedByType == ActivityInitiatorType.System)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mr-1" Style="vertical-align: middle;" />
                        <span>@(activity.InitiatedByName ?? "System")</span>
                    }
                    else if (activity.InitiatedByType == ActivityInitiatorType.Anonymous)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.QuestionMark" Class="mr-1" Style="vertical-align: middle;" />
                        <span>Anonymous</span>
                    }
                    else if (!string.IsNullOrEmpty(activity.InitiatedByName))
                    {
                        <span>@activity.InitiatedByName</span>
                    }
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="Activity" Title="Status" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Status" Name="status" />
            </HeaderTemplate>
            <CellTemplate>
                <MudChip T="string" Variant="Variant.Text"
                         Color="Helpers.GetActivityMudBlazorColorForStatus(context.Item.Status)">
                    @context.Item.Status.ToString().SplitOnCapitalLetters()
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="Activity" Title="Created" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Created" Name="created" />
            </HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                    @context.Item.Created.ToLocalTime().ToRelativeTime()
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="Activity" Sortable="false">
            <HeaderTemplate></HeaderTemplate>
            <CellTemplate>
                @if (_childActivityCounts.TryGetValue(context.Item.Id, out var childCount) && childCount > 0)
                {
                    <MudTooltip Text="@($"{childCount} child {(childCount == 1 ? "activity" : "activities")}")" Arrow="true" Placement="Placement.Top">
                        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Icon="@Icons.Material.Filled.AccountTree" Class="jim-stat-chip">@childCount</MudChip>
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @* An empty list means one of four different things, and the message says which: a search that matched
           nothing (with the way out as the action), filters nothing satisfies (likewise), or no Activities at
           all yet, phrased for whichever of the two views is showing. *@
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No Activities match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else if (HasActiveFilters)
        {
            <TableEmptyState Icon="@Icons.Material.Filled.FilterAlt"
                             PrimaryText="No Activities match the current filters"
                             SecondaryText="Adjust or clear the filters above to see more Activities."
                             ActionText="Clear Filters"
                             OnAction="ClearFiltersAsync" />
        }
        else if (_isMyActivity)
        {
            <TableEmptyState Icon="@Icons.Material.Filled.ReceiptLong"
                             PrimaryText="No Activities yet"
                             SecondaryText="Activities appear here as you initiate operations in JIM, such as synchronisations and configuration changes." />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.ReceiptLong"
                             PrimaryText="No Activities yet"
                             SecondaryText="Activities appear here as operations run in JIM, whether initiated by users, automated processes, or the API." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private VirtualisedDataGrid<Activity>? _grid;
    private bool _isMyActivity;
    private Dictionary<Guid, int> _childActivityCounts = new();
    private Guid? _currentUserId;
    private string _pageTitle = "Activity";
    private string _pageDescription = "Monitor all activity across the system. View operations initiated by users or automated processes, including synchronisations, configuration changes, and system events.";
    private List<BreadcrumbItem> _breadcrumbs = new();
    private readonly CancellationTokenSource _pollingCancellationTokenSource = new();
    private bool _pollingPaused;

    // How many of the newest Activities each polling tick fingerprints for change detection: a screen's worth,
    // matching what a reader parked at the top of the list can actually see change.
    private const int FingerprintWindowSize = 20;

    // Snapshot of the newest Activities for change detection during polling. Written by top-of-list window loads
    // and by the polling loop itself when it triggers a refresh, so an unchanged list never reloads.
    private string? _lastDataFingerprint;

    // Filter state. The default Type selection shows everything except NotSet and Run Profile executions (which
    // have their own Operations page); this default writes no URL state.
    private static readonly IReadOnlyCollection<ActivityTargetType> DefaultTypeFilter = Enum.GetValues<ActivityTargetType>()
        .Where(t => t != ActivityTargetType.NotSet && t != ActivityTargetType.ConnectedSystemRunProfile)
        .ToList();
    private IReadOnlyCollection<ActivityTargetOperationType> _filterOperations = [];
    private IReadOnlyCollection<ActivityOutcomeType> _filterOutcomes = [];
    private IReadOnlyCollection<ActivityTargetType> _filterTypes = DefaultTypeFilter;
    private IReadOnlyCollection<ActivityStatus> _filterStatuses = [];
    private IReadOnlyCollection<ActivityInitiatorType> _filterInitiatorTypes = [];
    private DateRange? _filterDateRange;
    private ActivityTargetCategory? _selectedCategory;
    private bool _filterHasChildren;

    private bool IsAllCategorySelected => _selectedCategory == null && _filterTypes.Count == DefaultTypeFilter.Count &&
                                          !_filterTypes.Except(DefaultTypeFilter).Any();

    // Whether any filter has been narrowed from its default. The grid's search box is judged separately, so the
    // empty state can offer the more specific "Clear Search" way out when a search term is what matched nothing.
    private bool HasActiveFilters => !IsAllCategorySelected
        || _filterOperations.Any() || _filterOutcomes.Any() || _filterStatuses.Any()
        || _filterInitiatorTypes.Any() || _filterDateRange != null || _filterHasChildren;

    protected override void OnInitialized()
    {
        ApplyFiltersFromUrl();
        StartPolling();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Runs on first load and again on every SPA navigation between /activity and /activity/mine (and after
        // this page's own replace navigations, where both calls are cheap no-ops).
        await UpdatePageStateAsync();
    }

    /// <summary>
    /// Polls for new or changed Activities every five seconds, fingerprinting the newest window under the current
    /// filters and reloading the grid only when something actually changed. The reload re-fetches the windows in
    /// view in place, so it never moves the reader's scroll position, and it invalidates the totals so the
    /// toolbar count stays honest as Activities arrive.
    /// </summary>
    private void StartPolling()
    {
        var token = _pollingCancellationTokenSource.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(TimeSpan.FromSeconds(5), token);

                    if (_grid == null || _pollingPaused)
                        continue;

                    var (createdFrom, createdTo) = GetCreatedRangeUtc();
                    using var pollJim = JimFactory.Create();
                    var result = await pollJim.Activities.GetActivitiesRangeAsync(
                        0, FingerprintWindowSize,
                        string.IsNullOrWhiteSpace(_grid.SearchText) ? null : _grid.SearchText,
                        "created", true,
                        _currentUserId,
                        _filterOperations.Any() ? _filterOperations : null,
                        _filterOutcomes.Any() ? _filterOutcomes : null,
                        _filterTypes.Any() ? _filterTypes : null,
                        _filterStatuses.Any() ? _filterStatuses : null,
                        _filterHasChildren ? true : null,
                        _filterInitiatorTypes.Any() ? _filterInitiatorTypes : null,
                        createdFrom,
                        createdTo,
                        includeTotalCount: false);

                    var fingerprint = BuildFingerprint(result.Results);
                    if (fingerprint != _lastDataFingerprint)
                    {
                        // Advance the baseline before refreshing: a reader scrolled deep in the list never
                        // re-fetches the top window, so without this the same change would trigger a reload on
                        // every subsequent tick.
                        _lastDataFingerprint = fingerprint;
                        await InvokeAsync(async () =>
                        {
                            if (_grid != null)
                                await _grid.RefreshAsync(invalidateTotals: true);
                        });
                    }
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // Transient failures (a database hiccup, a disposing circuit racing the tick) must not kill
                    // the polling loop; the next tick retries.
                }
            }
        }, token);
    }

    private async Task UpdatePageStateAsync()
    {
        // Judge the path, not the whole URI: the grid's and this page's own URL writes append query strings to
        // both routes, and a suffix test against the full URI would misread /activity/mine?desc=1 as /activity.
        _isMyActivity = NavManager.ToAbsoluteUri(NavManager.Uri).AbsolutePath
            .EndsWith("/activity/mine", StringComparison.OrdinalIgnoreCase);

        if (_isMyActivity)
        {
            _pageTitle = "My Activity";
            _pageDescription = "View operations you have initiated, including synchronisations, configuration changes, and other actions.";

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            _currentUserId = IdentityUtilities.GetUserId(authState.User);
        }
        else
        {
            _pageTitle = "Activity";
            _pageDescription = "Monitor all activity across the system. View operations initiated by users or automated processes, including synchronisations, configuration changes, and system events.";
            _currentUserId = null;
        }

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("Home", href: "/", icon: Icons.Material.Filled.Home),
            new(_pageTitle, href: null, disabled: true),
        };
    }

    public void Dispose()
    {
        _pollingCancellationTokenSource.Cancel();
        _pollingCancellationTokenSource.Dispose();
    }

    /// <summary>
    /// Loads one window of Activities for the grid, honouring the request's skip-the-count contract, and fetches
    /// the child-activity counts for the window's rows.
    /// </summary>
    private async Task<VirtualisedWindow<Activity>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken cancellationToken)
    {
        var (createdFrom, createdTo) = GetCreatedRangeUtc();

        using var jim = JimFactory.Create();
        var result = await jim.Activities.GetActivitiesRangeAsync(
            request.StartIndex,
            request.Count,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            _currentUserId,
            _filterOperations.Any() ? _filterOperations : null,
            _filterOutcomes.Any() ? _filterOutcomes : null,
            _filterTypes.Any() ? _filterTypes : null,
            _filterStatuses.Any() ? _filterStatuses : null,
            _filterHasChildren ? true : null,
            _filterInitiatorTypes.Any() ? _filterInitiatorTypes : null,
            createdFrom,
            createdTo,
            includeTotalCount: request.IncludeTotalCount);

        // Child-count chips for this window's rows, merged rather than replaced: several windows are on screen
        // at once in a virtualised list, and rows from earlier windows must keep their chips.
        var childCounts = await jim.Activities.GetChildActivityCountsAsync(result.Results.Select(a => a.Id));
        foreach (var (activityId, childCount) in childCounts)
            _childActivityCounts[activityId] = childCount;

        // A newest-first read of the top of the list is exactly what the polling loop fingerprints, so refresh
        // its baseline here and the poll only fires for changes the reader has not already been shown.
        if (request.StartIndex == 0 && request.SortBy == "created" && request.SortDescending)
            _lastDataFingerprint = BuildFingerprint(result.Results.Take(FingerprintWindowSize));

        return new VirtualisedWindow<Activity>(result.Results, result.TotalResults);
    }

    private void HandleRowClicked(Activity item)
    {
        // Navigate using absolute path to ensure no query params are carried over
        var uri = NavManager.ToAbsoluteUri($"/activity/{item.Id}");
        NavManager.NavigateTo(uri.AbsolutePath);
    }

    /// <summary>
    /// Applies a page-owned filter change: writes the filters into the URL (so a filtered view stays shareable
    /// and bookmarkable), then re-counts and reloads the grid from the top. The old total describes a match set
    /// that no longer exists, and so does the reader's scroll position.
    /// </summary>
    private async Task ApplyFilterChangeAsync()
    {
        WriteFiltersToUrl();
        if (_grid != null)
        {
            await _grid.ResetScrollAsync();
            await _grid.RefreshAsync(invalidateTotals: true);
        }
    }

    /// <summary>
    /// Writes every non-default filter into the URL query string, replacing the current history entry. Defaults
    /// write nothing, keeping the URL clean, and parameters this page does not own (the grid's q/sort/desc/row)
    /// are preserved untouched. A replace navigation rather than a JS rewrite, because the grid builds its own
    /// URL writes from NavigationManager's view of the query string, which only a navigation updates.
    /// </summary>
    private void WriteFiltersToUrl()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        SetOrRemove(query, "cat", _selectedCategory?.ToString());
        SetOrRemove(query, "type", _selectedCategory == null && !IsAllCategorySelected && _filterTypes.Any()
            ? string.Join(',', _filterTypes) : null);
        SetOrRemove(query, "op", _filterOperations.Any() ? string.Join(',', _filterOperations) : null);
        SetOrRemove(query, "outcome", _filterOutcomes.Any() ? string.Join(',', _filterOutcomes) : null);
        SetOrRemove(query, "status", _filterStatuses.Any() ? string.Join(',', _filterStatuses) : null);
        SetOrRemove(query, "init", _filterInitiatorTypes.Any() ? string.Join(',', _filterInitiatorTypes) : null);
        SetOrRemove(query, "from", _filterDateRange?.Start?.ToString("yyyy-MM-dd"));
        SetOrRemove(query, "to", _filterDateRange?.End?.ToString("yyyy-MM-dd"));
        SetOrRemove(query, "kids", _filterHasChildren ? "1" : null);

        var newQuery = query.ToString();
        var newUrl = string.IsNullOrEmpty(newQuery) ? uri.AbsolutePath : $"{uri.AbsolutePath}?{newQuery}";
        NavManager.NavigateTo(newUrl, replace: true);
    }

    /// <summary>
    /// Sets a query parameter, or removes it when the value is null, so a filter returned to its default
    /// disappears from the URL rather than lingering as an explicit restatement of the default.
    /// </summary>
    private static void SetOrRemove(System.Collections.Specialized.NameValueCollection query, string name, string? value)
    {
        if (value == null)
            query.Remove(name);
        else
            query[name] = value;
    }

    /// <summary>
    /// Seeds the filter state from the URL query string on first load, so a shared or bookmarked filtered view
    /// reproduces exactly. An explicit type list takes precedence over a category. The grid reads its own
    /// q/sort/desc/row parameters itself.
    /// </summary>
    private void ApplyFiltersFromUrl()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        var types = ParseEnumList<ActivityTargetType>(query["type"]);
        if (types.Count > 0)
        {
            _filterTypes = types;
        }
        else if (Enum.TryParse<ActivityTargetCategory>(query["cat"], ignoreCase: true, out var category))
        {
            _selectedCategory = category;
            _filterTypes = ActivityTargetTypeCategories.GetTargetTypes(category);
        }

        var operations = ParseEnumList<ActivityTargetOperationType>(query["op"]);
        if (operations.Count > 0)
            _filterOperations = operations;

        var outcomes = ParseEnumList<ActivityOutcomeType>(query["outcome"]);
        if (outcomes.Count > 0)
            _filterOutcomes = outcomes;

        var statuses = ParseEnumList<ActivityStatus>(query["status"]);
        if (statuses.Count > 0)
            _filterStatuses = statuses;

        var initiatorTypes = ParseEnumList<ActivityInitiatorType>(query["init"]);
        if (initiatorTypes.Count > 0)
            _filterInitiatorTypes = initiatorTypes;

        DateTime? from = DateTime.TryParse(query["from"], out var fromDate) ? fromDate : null;
        DateTime? to = DateTime.TryParse(query["to"], out var toDate) ? toDate : null;
        if (from != null || to != null)
            _filterDateRange = new DateRange(from, to);

        if (query["kids"] == "1")
            _filterHasChildren = true;
    }

    private static List<T> ParseEnumList<T>(string? value) where T : struct, Enum
    {
        if (string.IsNullOrWhiteSpace(value))
            return [];
        return value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Select(part => Enum.TryParse<T>(part, ignoreCase: true, out var parsed) ? parsed : (T?)null)
            .Where(parsed => parsed.HasValue)
            .Select(parsed => parsed!.Value)
            .ToList();
    }

    /// <summary>
    /// Converts the picked local date range into an inclusive UTC window: the whole of the start day through the
    /// whole of the end day.
    /// </summary>
    private (DateTime? createdFrom, DateTime? createdTo) GetCreatedRangeUtc()
    {
        DateTime? from = _filterDateRange?.Start?.Date.ToUniversalTime();
        DateTime? to = _filterDateRange?.End?.Date.AddDays(1).AddTicks(-1).ToUniversalTime();
        return (from, to);
    }

    /// <summary>
    /// Checks whether an activity has any granular stats to display.
    /// </summary>
    private static bool HasAnyStats(Activity activity)
    {
        return activity.TotalAdded > 0
            || activity.TotalUpdated > 0
            || activity.TotalDeleted > 0
            || activity.TotalProjected > 0
            || activity.TotalJoined > 0
            || activity.TotalAttributeFlows > 0
            || activity.TotalDisconnected > 0
            || activity.TotalDisconnectedOutOfScope > 0
            || activity.TotalOutOfScopeRetainJoin > 0
            || activity.TotalDriftCorrections > 0
            || activity.TotalProvisioned > 0
            || activity.TotalExported > 0
            || activity.TotalDeprovisioned > 0
            || activity.TotalCreated > 0
            || activity.TotalPendingExports > 0
            || activity.TotalErrors > 0;
    }

    private async Task OnOperationFilterChangedAsync(IReadOnlyCollection<ActivityTargetOperationType> values)
    {
        _filterOperations = values;
        await ApplyFilterChangeAsync();
    }

    private async Task OnOutcomeFilterChangedAsync(IReadOnlyCollection<ActivityOutcomeType> values)
    {
        _filterOutcomes = values;
        await ApplyFilterChangeAsync();
    }

    private async Task OnTypeFilterChangedAsync(IReadOnlyCollection<ActivityTargetType> values)
    {
        // A manual type selection overrides any category quick-filter choice.
        _selectedCategory = null;
        _filterTypes = values;
        await ApplyFilterChangeAsync();
    }

    private async Task OnCategorySelectedAsync(ActivityTargetCategory? category)
    {
        _selectedCategory = category;
        _filterTypes = category == null ? DefaultTypeFilter : ActivityTargetTypeCategories.GetTargetTypes(category.Value);
        await ApplyFilterChangeAsync();
    }

    private async Task OnInitiatorTypeFilterChangedAsync(IReadOnlyCollection<ActivityInitiatorType> values)
    {
        _filterInitiatorTypes = values;
        await ApplyFilterChangeAsync();
    }

    private async Task OnDateRangeChangedAsync(DateRange? range)
    {
        // Treat a cleared or empty range as no date filter.
        _filterDateRange = range == null || (range.Start == null && range.End == null) ? null : range;
        await ApplyFilterChangeAsync();
    }

    private static string GetCategoryLabel(ActivityTargetCategory category) => category switch
    {
        ActivityTargetCategory.Configuration => "Configuration",
        ActivityTargetCategory.IdentityData => "Identity",
        ActivityTargetCategory.SyncRuns => "Synchronisation",
        ActivityTargetCategory.System => "System",
        ActivityTargetCategory.Security => "Security",
        _ => category.ToString()
    };

    private async Task OnStatusFilterChangedAsync(IReadOnlyCollection<ActivityStatus> values)
    {
        _filterStatuses = values;
        await ApplyFilterChangeAsync();
    }

    private async Task OnHasChildrenFilterChangedAsync(bool value)
    {
        _filterHasChildren = value;
        await ApplyFilterChangeAsync();
    }

    /// <summary>
    /// Resets every filter to its default, offered as the way out by the empty state when the current filters
    /// matched nothing. The URL is rewritten too, so the cleared state is what a bookmark now captures.
    /// </summary>
    private async Task ClearFiltersAsync()
    {
        _selectedCategory = null;
        _filterOperations = [];
        _filterOutcomes = [];
        _filterTypes = DefaultTypeFilter;
        _filterStatuses = [];
        _filterInitiatorTypes = [];
        _filterDateRange = null;
        _filterHasChildren = false;
        await ApplyFilterChangeAsync();
    }

    private static string GetMultiSelectText(IReadOnlyList<string> selectedValues)
    {
        return selectedValues.Count switch
        {
            0 => string.Empty,
            1 => selectedValues[0],
            _ => $"{selectedValues.Count} selected"
        };
    }

    /// <summary>
    /// Builds a lightweight fingerprint of a result set for change detection.
    /// Captures identity, status, and a representative subset of granular stats so polling
    /// only triggers a reload when data actually changed.
    /// </summary>
    private static string BuildFingerprint(IEnumerable<Activity> activities)
    {
        return string.Join("|", activities.Select(a =>
            $"{a.Id}:{a.Status}:{a.TotalAdded},{a.TotalUpdated},{a.TotalDeleted},{a.TotalProjected},{a.TotalJoined},{a.TotalAttributeFlows},{a.TotalDisconnected},{a.TotalDisconnectedOutOfScope},{a.TotalOutOfScopeRetainJoin},{a.TotalDriftCorrections},{a.TotalProvisioned},{a.TotalExported},{a.TotalDeprovisioned},{a.TotalPendingExports},{a.TotalErrors},{a.TotalCreated}"));
    }

    /// <summary>
    /// Determines the effective run type category from the enum or target name fallback.
    /// </summary>
    private static string GetEffectiveRunType(ConnectedSystemRunType? runType, string? targetName)
    {
        // Check enum first
        if (runType is ConnectedSystemRunType.FullImport or ConnectedSystemRunType.DeltaImport)
            return "Import";
        if (runType is ConnectedSystemRunType.FullSynchronisation or ConnectedSystemRunType.DeltaSynchronisation)
            return "Sync";
        if (runType is ConnectedSystemRunType.Export)
            return "Export";

        // Fallback to target name if run type is NotSet or null
        if (!string.IsNullOrEmpty(targetName))
        {
            if (targetName.Contains("Import", StringComparison.OrdinalIgnoreCase))
                return "Import";
            if (targetName.Contains("Sync", StringComparison.OrdinalIgnoreCase))
                return "Sync";
            if (targetName.Contains("Export", StringComparison.OrdinalIgnoreCase))
                return "Export";
        }

        return "Unknown";
    }
}
