    private (string Label, Color Color, string Icon) GetDeletionRuleDisplay(MetaverseObjectDeletionRule rule)
    {
        return rule switch
        {
            MetaverseObjectDeletionRule.Manual => (AdminText.SchemaDeletionRuleManual, Color.Default, Icons.Material.Filled.Block),
            MetaverseObjectDeletionRule.WhenLastConnectorDisconnected => (AdminText.SchemaDeletionRuleAuto, Color.Warning, Icons.Material.Filled.LinkOff),
            MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected => (AdminText.SchemaDeletionRuleAuthoritativeSource, Color.Error, Icons.Material.Filled.Star),
            _ => (CommonText.Unknown, Color.Default, Icons.Material.Filled.Help)
        };
    }

    private static string FormatGracePeriodPart(int count, string one, string other) =>
        string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(count, one, other), count);

    private static string FormatGracePeriod(TimeSpan period)
    {
        var parts = new List<string>();
        if (period.Days > 0) parts.Add(FormatGracePeriodPart(period.Days, AdminText.SchemaGracePeriodDayOne, AdminText.SchemaGracePeriodDayOther));
        if (period.Hours > 0) parts.Add(FormatGracePeriodPart(period.Hours, AdminText.SchemaGracePeriodHourOne, AdminText.SchemaGracePeriodHourOther));
        if (period.Minutes > 0) parts.Add(FormatGracePeriodPart(period.Minutes, AdminText.SchemaGracePeriodMinuteOne, AdminText.SchemaGracePeriodMinuteOther));
        return parts.Count > 0 ? string.Join(AdminText.SchemaGracePeriodSeparator, parts) : "0";
    }

    private string GetDeletionRuleTooltip(MetaverseObjectTypeHeader header)
    {
        var gracePeriod = header.DeletionGracePeriod.HasValue && header.DeletionGracePeriod.Value > TimeSpan.Zero
            ? string.Format(CultureInfo.CurrentCulture, AdminText.SchemaGracePeriodWithDelay, FormatGracePeriod(header.DeletionGracePeriod.Value))
            : AdminText.SchemaGracePeriodImmediate;

        return header.DeletionRule switch
        {
            MetaverseObjectDeletionRule.Manual => AdminText.SchemaTooltipManualDeletion,
            MetaverseObjectDeletionRule.WhenLastConnectorDisconnected => string.Format(CultureInfo.CurrentCulture, AdminText.SchemaTooltipDeleteWhenAllDisconnect, gracePeriod),
            // Include the trigger mode (#119) so the list reads the same as the detail page's radio options
            MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected =>
                header.DeletionTriggerMode == AuthoritativeSourceTriggerMode.AllSourcesDisconnect
                    ? string.Format(CultureInfo.CurrentCulture, AdminText.SchemaTooltipAllSourcesDisconnect, gracePeriod)
                    : string.Format(CultureInfo.CurrentCulture, AdminText.SchemaTooltipSpecificSourceDisconnect, gracePeriod),
            _ => AdminText.SchemaTooltipUnknownRule
        };
    }
