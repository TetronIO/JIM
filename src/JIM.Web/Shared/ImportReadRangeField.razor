@*
    An import's watermarks, as one field of its Activity's Summary. What was recorded is the Connector's persisted data,
    which commonly holds far more than a watermark (an LDAP Connector's is mostly its detected view of the directory),
    so the field says in words what the Connector describes, and keeps the recorded values behind a toggle for support.
    Renders a MudItem, so it sits in the Summary's MudGrid like the fields around it.
*@

@if (WatermarkFrom != null || WatermarkTo != null || HasPartitionWatermarks)
{
    <MudItem xs="12" Class="jim-import-read-range">
        @if (_reading != null)
        {
            <MudText Typo="Typo.button" Class="mud-text-secondary">@_reading.Label:</MudText>
            @foreach (var line in _reading.Lines)
            {
                <MudText Class="@(_reading.Scoped ? "jim-import-read-range-point" : null)">@line</MudText>
            }
            @if (_reading.Note != null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@_reading.Note</MudText>
            }
        }

        <MudButton Variant="Variant.Text"
                   Size="Size.Small"
                   Color="Color.Inherit"
                   DropShadow="false"
                   Class="jim-import-read-range-toggle"
                   StartIcon="@(_stateShown ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                   OnClick="@(() => _stateShown = !_stateShown)">
            @(_stateShown ? "Hide Connector state" : "Show Connector state")
        </MudButton>

        @if (_stateShown && HasPartitionWatermarks)
        {
            @* A Connector that keeps a watermark per partition (#2715): one row each, every value in full. What it keeps for
               the Connected System as a whole holds no position, so the partitions are the state worth reading. *@
            <MudText Typo="Typo.button" Class="mud-text-secondary d-block mt-2">Watermark recorded for each partition:</MudText>
            <div class="jim-import-partition-watermarks">
                <MudSimpleTable Dense="true" Outlined="true" Elevation="0">
                    <colgroup>
                        <col class="jim-import-partition-watermarks-name-col" />
                        <col />
                        <col />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col">Partition</th>
                            <th scope="col">Before this run</th>
                            <th scope="col">After this run</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _partitionRows)
                        {
                            <tr @key="row.PartitionId" class="jim-import-partition-watermark-row">
                                <th scope="row" class="jim-import-partition-watermark-name">@row.PartitionName</th>
                                <td class="jim-import-partition-watermark-before" data-watermark-state="@StateName(row.BeforeState)">
                                    @PartitionWatermarkCell(row.BeforeState, row.Before)
                                </td>
                                <td class="jim-import-partition-watermark-after" data-watermark-state="@StateName(row.AfterState)">
                                    @PartitionWatermarkCell(row.AfterState, row.After)
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>
        }
        else if (_stateShown)
        {
            @if (WatermarkFrom != null)
            {
                <MudText Typo="Typo.button" Class="mud-text-secondary d-block mt-2">Before this run:</MudText>
                <div class="jim-json-syntax jim-import-read-range-state">@((MarkupString)Helpers.HighlightJson(Helpers.FormatJson(WatermarkFrom)))</div>
            }
            @if (WatermarkTo != null)
            {
                <MudText Typo="Typo.button" Class="mud-text-secondary d-block mt-2">After this run:</MudText>
                <div class="jim-json-syntax jim-import-read-range-state">@((MarkupString)Helpers.HighlightJson(Helpers.FormatJson(WatermarkTo)))</div>
            }
        }
    </MudItem>
}

@code {
    /// <summary>
    /// The import's run type. A Delta Import reads the changes after a watermark; a Full Import reads everything, so
    /// what it is shown for is the point the next Delta Import starts from.
    /// </summary>
    [Parameter]
    public ConnectedSystemRunType? RunType { get; set; }

    /// <summary>
    /// The persisted connector data the import started from, as recorded on the Activity.
    /// </summary>
    [Parameter]
    public string? WatermarkFrom { get; set; }

    /// <summary>
    /// The persisted connector data the import recorded once it had staged everything it read.
    /// </summary>
    [Parameter]
    public string? WatermarkTo { get; set; }

    /// <summary>
    /// The Connector's description of both, or null where it gives none (the Connector does not describe its
    /// watermarks, or the Connected System has since been deleted); only the recorded values are offered then.
    /// </summary>
    [Parameter]
    public ImportReadRange? ReadRange { get; set; }

    /// <summary>
    /// For a Connector that keeps a watermark per Partition (#2715), each Partition's watermark the import started from,
    /// as recorded on the Activity; null for every other Connector.
    /// </summary>
    [Parameter]
    public List<ImportPartitionWatermark>? PartitionWatermarksFrom { get; set; }

    /// <summary>
    /// For a Connector that keeps a watermark per Partition, each Partition's watermark the import recorded; null where
    /// it recorded none, and for every other Connector.
    /// </summary>
    [Parameter]
    public List<ImportPartitionWatermark>? PartitionWatermarksTo { get; set; }

    private Reading? _reading;
    private bool _stateShown;
    private IReadOnlyList<ImportPartitionWatermarkRow> _partitionRows = [];

    private sealed record Reading(string Label, IReadOnlyList<string> Lines, bool Scoped, string? Note);

    private bool HasPartitionWatermarks => PartitionWatermarksFrom != null || PartitionWatermarksTo != null;

    protected override void OnParametersSet()
    {
        _reading = RunType == ConnectedSystemRunType.DeltaImport ? ReadDelta() : ReadFull();
        _partitionRows = HasPartitionWatermarks ? ImportPartitionWatermarkRows.Compare(PartitionWatermarksFrom, PartitionWatermarksTo) : [];
    }

    /// <summary>
    /// A Partition watermark cell: the value in full where one is shown, otherwise what became of it, low-lighted.
    /// </summary>
    private static RenderFragment PartitionWatermarkCell(ImportPartitionWatermarkState state, string? value) => __builder =>
    {
        if (state == ImportPartitionWatermarkState.Recorded && value != null)
        {
            <div class="jim-json-syntax jim-import-partition-watermark-value">@((MarkupString)Helpers.HighlightJson(value))</div>
        }
        else
        {
            <span class="mud-text-secondary">@StateText(state)</span>
        }
    };

    private static string StateText(ImportPartitionWatermarkState state) => state switch
    {
        ImportPartitionWatermarkState.None => "No watermark",
        ImportPartitionWatermarkState.Unchanged => "Unchanged",
        ImportPartitionWatermarkState.Cleared => "Cleared",
        _ => "Nothing recorded"
    };

    /// <summary>
    /// The state's name as the cell carries it, for styling and for tests that read what a cell says without its wording.
    /// </summary>
    private static string StateName(ImportPartitionWatermarkState state) => state switch
    {
        ImportPartitionWatermarkState.Recorded => "recorded",
        ImportPartitionWatermarkState.None => "none",
        ImportPartitionWatermarkState.Unchanged => "unchanged",
        ImportPartitionWatermarkState.Cleared => "cleared",
        _ => "not-recorded"
    };

    /// <summary>
    /// Where the next Delta Import starts: the point this run reached or, where it recorded none, the one it started
    /// from, which is left in place.
    /// </summary>
    private Reading? ReadFull()
    {
        var watermark = ReadRange?.To ?? ReadRange?.From;
        if (watermark == null || watermark.Points.Count == 0)
            return null;

        var scoped = IsScoped(watermark);
        var lines = watermark.Points.Select(p => WithScope(scoped ? p.Scope : null, $"{Value(p)} ({watermark.Kind})")).ToList();
        return new Reading("Next Delta Import Reads Changes After", lines, scoped, null);
    }

    private Reading? ReadDelta()
    {
        var from = ReadRange?.From;
        var to = ReadRange?.To;
        if ((from?.Points.Count ?? 0) == 0 && (to?.Points.Count ?? 0) == 0)
            return null;

        var scoped = (from != null && IsScoped(from)) || (to != null && IsScoped(to));
        var scopes = (to?.Points ?? []).Concat(from?.Points ?? [])
            .Select(p => scoped ? p.Scope : null)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        var lines = scopes.Select(scope => WithScope(scope, DeltaSentence(
            Find(from, scope, scoped), from?.Kind,
            Find(to, scope, scoped), to?.Kind))).ToList();

        var note = from != null && to == null
            ? "No new watermark was recorded, so the next Delta Import reads from the same point."
            : null;
        return new Reading("Read Changes", lines, scoped, note);
    }

    private static string DeltaSentence(ImportWatermarkPoint? from, string? fromKind, ImportWatermarkPoint? to, string? toKind)
    {
        if (from != null && to != null)
        {
            var sameKind = fromKind == toKind;
            if (sameKind && Value(from) == Value(to))
                return $"No changes after {Value(from)} ({fromKind})";

            return sameKind
                ? $"After {Value(from)}, up to {Value(to)} ({toKind})"
                : $"After {Value(from)} ({fromKind}), up to {Value(to)} ({toKind})";
        }

        return to != null
            ? $"From the start, up to {Value(to)} ({toKind})"
            : $"After {Value(from!)} ({fromKind})";
    }

    private static bool IsScoped(ImportWatermarkDescription watermark) => watermark.Points.Any(p => p.Scope != null);

    private static ImportWatermarkPoint? Find(ImportWatermarkDescription? watermark, string? scope, bool scoped) =>
        watermark?.Points.FirstOrDefault(p => !scoped || string.Equals(p.Scope, scope, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Prefixes a scoped line with what it belongs to, lower-casing the sentence's first letter to run on after it.
    /// </summary>
    private static string WithScope(string? scope, string sentence) =>
        scope == null ? sentence : $"{scope}: {char.ToLowerInvariant(sentence[0])}{sentence[1..]}";

    private static string Value(ImportWatermarkPoint point) => ImportWatermarkText.Value(point);
}
