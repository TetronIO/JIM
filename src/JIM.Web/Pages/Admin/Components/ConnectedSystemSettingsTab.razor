<MudText Class="mud-text-secondary">
    Each connector requires specific settings to connect to your environment.
    Complete the required fields below, then save your changes before importing the schema.
</MudText>

<MudForm @ref="_settingsForm" @bind-IsValid="@IsSettingsFormValid" @bind-Errors="@SettingsFormErrors">
    <PrefilledFormValidator />
    <MudExpansionPanels MultiExpansion="true" Elevation="0" Class="mt-5 jim-expansion-panel">
        @if (SettingCategories != null)
        {
            @for (var i = 0; i < SettingCategories.Count; i++)
            {
                var settingCategory = SettingCategories[i];
                var categoryKey = settingCategory.ToString();
                <MudExpansionPanel Expanded="@GetCategoryExpanded(categoryKey)"
                                   ExpandedChanged="@(expanded => OnCategoryExpandedChanged(categoryKey, expanded))">
                    <TitleContent>
                        <MudText Typo="Typo.h5">@categoryKey</MudText>
                    </TitleContent>
                    <ChildContent>
                        @{
                            // settings whose RequiredWhen condition is not met are irrelevant; hide them entirely
                            var categorySettings = ConnectedSystem.SettingValues
                                .Where(sv => sv.Setting.Category == settingCategory)
                                .Where(sv => ConnectorSettingValidator.IsConditionMet(ConnectedSystem.SettingValues, sv.Setting))
                                .OrderBy(sv => sv.Setting.Id)
                                .ToList();
                            var headingCount = categorySettings.Count(sv => sv.Setting.Type == ConnectedSystemSettingType.Heading);
                            var headingsRendered = 0;
                            var j = 0;
                        }
                        @while (j < categorySettings.Count)
                        {
                            var settingValue = categorySettings[j];
                            var requiredGroup = settingValue.Setting.RequiredGroup;

                            if (!string.IsNullOrEmpty(requiredGroup))
                            {
                                // consecutive settings sharing a RequiredGroup render together: at least one of them must be supplied.
                                // categorySettings has already dropped the members whose condition is unmet, so a group with no
                                // applicable members contributes nothing here and its container is never drawn.
                                var groupMembers = new List<ConnectedSystemSettingValue>();
                                while (j < categorySettings.Count && categorySettings[j].Setting.RequiredGroup == requiredGroup)
                                {
                                    groupMembers.Add(categorySettings[j]);
                                    j++;
                                }
                                var groupSpacingClass = j >= categorySettings.Count ? "pa-4" : "pa-4 mb-5";
                                var groupSatisfied = ConnectorSettingValidator.IsGroupSatisfied(ConnectedSystem.SettingValues, requiredGroup);

                                // read the cardinality from the group's applicable members rather than the run rendered here, so the
                                // caption states the same rule the save gate and the validation message enforce
                                var groupCardinality = ConnectorSettingValidator.GetGroupCardinality(
                                    ConnectorSettingValidator.GetApplicableGroupMembers(ConnectedSystem.SettingValues, requiredGroup));
                                var groupCaption = groupCardinality == ConnectorSettingRequiredGroupCardinality.ExactlyOne
                                    ? "Provide a value for exactly one of the following settings:"
                                    : "Provide a value for at least one of the following settings:";
                                <MudPaper Outlined="true" Class="@groupSpacingClass">
                                    <MudText Typo="Typo.h6">@requiredGroup</MudText>
                                    @if (groupSatisfied)
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">@groupCaption</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body2" Color="Color.Error" Class="mb-4">@groupCaption</MudText>
                                    }
                                    @for (var k = 0; k < groupMembers.Count; k++)
                                    {
                                        <ConnectedSystemSettingField @key="groupMembers[k].Setting.Id"
                                                                     SettingValue="@groupMembers[k]"
                                                                     CssClass="@(k == groupMembers.Count - 1 ? "" : "mb-5")"
                                                                     Immediate="true"
                                                                     IsExportOnlyMode="@ConnectedSystem.IsExportOnlyMode()"
                                                                     ValueChanged="OnSettingValueChanged"
                                                                     FileSelected="OnFileSelectedAsync"
                                                                     ShowDirectoryServerDiscovery="@ShowDirectoryServerDiscoveryFor(groupMembers[k])"
                                                                     DirectoryServerDiscoveryEnabled="@CanDiscoverDirectoryServers()"
                                                                     DirectoryServerDiscoveryDraftSettings="DiscoveryDraftSettingValues"
                                                                     ConnectedSystemId="@ConnectedSystem.Id" />
                                    }
                                </MudPaper>
                            }
                            else
                            {
                                if (settingValue.Setting.Type == ConnectedSystemSettingType.Heading)
                                {
                                    // separate second-level setting headings from each other when a category has more than one
                                    if (headingsRendered > 0 && headingCount > 1)
                                    {
                                        <MudDivider Class="my-4" />
                                    }
                                    headingsRendered++;
                                }

                                <ConnectedSystemSettingField @key="settingValue.Setting.Id"
                                                             SettingValue="@settingValue"
                                                             CssClass="@(j == categorySettings.Count - 1 ? "" : "mb-5")"
                                                             IsRequired="@ConnectorSettingValidator.IsSettingRequired(ConnectedSystem.SettingValues, settingValue.Setting)"
                                                             Immediate="true"
                                                             IsExportOnlyMode="@ConnectedSystem.IsExportOnlyMode()"
                                                             ValueChanged="OnSettingValueChanged"
                                                             FileSelected="OnFileSelectedAsync"
                                                             ShowDirectoryServerDiscovery="@ShowDirectoryServerDiscoveryFor(settingValue)"
                                                             DirectoryServerDiscoveryEnabled="@CanDiscoverDirectoryServers()"
                                                             DirectoryServerDiscoveryDraftSettings="DiscoveryDraftSettingValues"
                                                             ConnectedSystemId="@ConnectedSystem.Id" />
                                j++;
                            }
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        }

        @* Only show the Import Behaviour panel if the connector supports full or delta import *@
        @if (ConnectedSystem.ConnectorDefinition is { } connectorDefinition && (connectorDefinition.SupportsFullImport || connectorDefinition.SupportsDeltaImport))
        {
            <MudExpansionPanel Expanded="@GetCategoryExpanded("Import Behaviour")"
                               ExpandedChanged="@(expanded => OnCategoryExpandedChanged("Import Behaviour", expanded))">
                <TitleContent>
                    <MudText Typo="Typo.h5">Import Behaviour</MudText>
                </TitleContent>
                <ChildContent>
                    <MudText Class="mud-text-secondary mb-5">
                        These settings control how JIM processes imports, independently of connector-specific settings above.
                    </MudText>
                    <MudSelect T="UnresolvedReferenceHandling"
                               Label="Unresolved Reference Handling"
                               @bind-Value="ConnectedSystem.UnresolvedReferenceHandling"
                               HelperText="Controls what happens when an imported reference value (for example a group member) cannot be resolved to a Connected System Object, commonly because the referenced object is outside the configured Container Scope."
                               Variant="Variant.Outlined">
                        <MudSelectItem T="UnresolvedReferenceHandling" Value="UnresolvedReferenceHandling.Error">Error (default): record an error on each affected object</MudSelectItem>
                        <MudSelectItem T="UnresolvedReferenceHandling" Value="UnresolvedReferenceHandling.Warn">Warn: complete with a warning summary</MudSelectItem>
                        <MudSelectItem T="UnresolvedReferenceHandling" Value="UnresolvedReferenceHandling.Ignore">Ignore: log only</MudSelectItem>
                    </MudSelect>
                </ChildContent>
            </MudExpansionPanel>
        }

        @if (ConnectedSystem.ConnectorDefinition is { SupportsExport: true, SupportsParallelExport: true })
        {
            <MudExpansionPanel Expanded="@GetCategoryExpanded("Export Performance")"
                               ExpandedChanged="@(expanded => OnCategoryExpandedChanged("Export Performance", expanded))">
                <TitleContent>
                    <MudText Typo="Typo.h5">Export Performance</MudText>
                </TitleContent>
                <ChildContent>
                    <MudText Class="mud-text-secondary mb-5">
                        These settings control how JIM processes exports, independently of connector-specific settings above.
                    </MudText>
                    <MudTextField T="int?"
                                  Label="Max Export Parallelism"
                                  @bind-Value="ConnectedSystem.MaxExportParallelism"
                                  HelperText="Number of export batches to process concurrently (1 = sequential). Each parallel batch uses its own database connection and connector instance."
                                  InputType="InputType.Number"
                                  Variant="Variant.Outlined" />
                </ChildContent>
            </MudExpansionPanel>
        }
    </MudExpansionPanels>

    @if (SettingsFormCustomErrors.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-5">
            <MudText>There are issues with the settings:</MudText>
            <ul class="mt-5">
                @foreach (var error in SettingsFormCustomErrors)
                {
                    <li>@error.Key: @error.Value</li>
                }
            </ul>
        </MudAlert>

        @* When the directory refused the connection because of its certificate, show the certificate itself: which
           one was presented, and what to do about it, is the whole answer here. *@
        @if (_serverCertificate != null)
        {
            @* The settings that produced this failure are the ones on screen, and they are not saved: JIM does not
               save settings that fail validation, and a certificate it does not trust is a validation failure. They
               are handed to the action so the certificate trusted belongs to the endpoint the administrator is
               configuring, rather than to whatever was saved last. *@
            <ServerCertificateCard Diagnostic="_serverCertificate" Compact="true"
                                   ConnectedSystemId="@(ConnectedSystem.Id > 0 ? ConnectedSystem.Id : null)"
                                   ConnectedSystemName="@ConnectedSystem.Name"
                                   DraftSettingValues="@DraftSettingValues()"
                                   OnTrusted="HandleValidSettingsSubmitAsync" />
        }
    }

    @* The same capability from the other direction (#1139): the certificate can be looked at before anything has
       failed, so configuring a new system is not a cycle of save, fail, come back. Fetching only reads and shows;
       nothing is stored until the trust action on the card below is confirmed. *@
    @if (_fetchedCertificate != null)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-5">
            @if (_fetchedCertificate.FailureReason == ServerCertificateFailureReason.None)
            {
                <text>JIM already trusts this certificate. Nothing needs adding.</text>
            }
            else
            {
                <text>JIM does not yet trust this certificate. Nothing has been saved; trusting it is a separate step.</text>
            }
        </MudAlert>

        <ServerCertificateCard Diagnostic="_fetchedCertificate" Compact="true"
                               ConnectedSystemId="@(ConnectedSystem.Id > 0 ? ConnectedSystem.Id : null)"
                               ConnectedSystemName="@ConnectedSystem.Name"
                               DraftSettingValues="@DraftSettingValues()"
                               OnTrusted="FetchServerCertificateAsync" />
    }
</MudForm>
<MudButton Variant="Variant.Filled" Color="@(IsSettingsFormValid || !_settingsBeingSaved ? Color.Primary : Color.Default)" Disabled="@(!IsSettingsFormValid || !AreSettingGroupsSatisfied() || _settingsBeingSaved)" Class="mt-5" DropShadow="false" OnClick="HandleValidSettingsSubmitAsync">
    @if (_settingsBeingSaved)
    {
        <MudProgressCircular Class="ms-n1" Indeterminate="true" />
        <span class="ms-2">Processing</span>
    }
    else
    {
        <text>Save Settings</text>
    }
</MudButton>

@if (_supportsCertificateFetch)
{
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-5 ml-2" DropShadow="false"
               StartIcon="@Icons.Material.Filled.Search" Disabled="_fetchingCertificate"
               OnClick="FetchServerCertificateAsync" data-testid="jim-fetch-server-certificate">
        @if (_fetchingCertificate)
        {
            <MudProgressCircular Class="ms-n1" Indeterminate="true" />
            <span class="ms-2">Fetching</span>
        }
        else
        {
            <text>Fetch certificate</text>
        }
    </MudButton>
}

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [Parameter, EditorRequired]
    public List<ConnectedSystemSettingCategory> SettingCategories { get; set; } = null!;

    [Parameter]
    public EventCallback OnConnectedSystemChanged { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool IsSettingsFormValid { get; set; }
    private string[] SettingsFormErrors { get; set; } = [];
    private Dictionary<string, string> SettingsFormCustomErrors { get; } = new();

    /// <summary>
    /// The certificate a directory server presented when it refused the connection, when that is why validation failed.
    /// </summary>
    private ServerCertificateDiagnostic? _serverCertificate;

    /// <summary>
    /// The certificate an administrator asked to see before anything failed, via Fetch certificate.
    /// </summary>
    private ServerCertificateDiagnostic? _fetchedCertificate;

    /// <summary>
    /// Whether this system's connector makes encrypted connections at all, and so whether Fetch certificate means
    /// anything for it. A property of the connector, so it is asked once.
    /// </summary>
    private bool _supportsCertificateFetch;

    private bool _fetchingCertificate;
    private bool _settingsBeingSaved;
    private MudForm? _settingsForm;

    /// <summary>
    /// Whether this Connected System's Connector supports Discover Domain Controllers (issue #1167), asked once
    /// per the same reasoning as <see cref="_supportsCertificateFetch"/>: a property of the Connector, stable
    /// for the life of the Connected System.
    /// </summary>
    private bool _supportsDirectoryServerDiscovery;

    protected override async Task OnParametersSetAsync()
    {
        if (ConnectedSystem.Id <= 0)
        {
            _supportsCertificateFetch = false;
            _supportsDirectoryServerDiscovery = false;
            return;
        }

        using var jim = JimFactory.Create();
        _supportsCertificateFetch = await jim.Certificates.SupportsServerCertificateReadAsync(ConnectedSystem.Id);
        _supportsDirectoryServerDiscovery = await jim.ConnectedSystems.SupportsDirectoryServerDiscoveryAsync(ConnectedSystem.Id);
    }

    /// <summary>
    /// Whether <paramref name="settingValue"/> is the field the Discover Domain Controllers action targets:
    /// identified by the connector-agnostic <see cref="ConnectorSettingNames.LdapPreferredDomainController"/>
    /// name rather than by display text, so the field's label can change without silently breaking this match.
    /// </summary>
    private bool ShowDirectoryServerDiscoveryFor(ConnectedSystemSettingValue settingValue) =>
        _supportsDirectoryServerDiscovery && settingValue.Setting.Name == ConnectorSettingNames.LdapPreferredDomainController;

    /// <summary>
    /// Gates the Discover... action on the Connected System's required Connectivity settings currently having a
    /// value on screen (not necessarily saved), so an administrator cannot open the dialog before there is
    /// anything to connect with.
    /// </summary>
    private bool CanDiscoverDirectoryServers()
    {
        if (!_supportsDirectoryServerDiscovery)
            return false;

        return ConnectedSystem.SettingValues
            .Where(sv => sv.Setting.Category == ConnectedSystemSettingCategory.Connectivity)
            .Where(sv => sv.Setting.Type is not (ConnectedSystemSettingType.Heading or ConnectedSystemSettingType.Label or ConnectedSystemSettingType.Divider or ConnectedSystemSettingType.CheckBox))
            .Where(sv => ConnectorSettingValidator.IsSettingRequired(ConnectedSystem.SettingValues, sv.Setting))
            .All(sv => sv.HasUserSuppliedValue());
    }

    /// <summary>
    /// Per-category (and Import Behaviour / Export Performance) expanded state for the settings accordion.
    /// Not persisted; defaults to expanded so settings remain visible without extra clicks.
    /// </summary>
    private readonly Dictionary<string, bool> _categoryExpandedStates = new();

    private bool GetCategoryExpanded(string categoryKey) => _categoryExpandedStates.GetValueOrDefault(categoryKey, true);

    private void OnCategoryExpandedChanged(string categoryKey, bool expanded) => _categoryExpandedStates[categoryKey] = expanded;

    private async Task HandleValidSettingsSubmitAsync()
    {
        using var jim = JimFactory.Create();
        _settingsBeingSaved = true;
        SettingsFormCustomErrors.Clear();
        _serverCertificate = null;

        StateHasChanged();
        await Task.Delay(1);

        var results = jim.ConnectedSystems.ValidateConnectedSystemSettings(ConnectedSystem);
        for (var i = 0; i < results.Count; i++)
        {
            var result = results[i];
            if (result.IsValid)
                continue;

            // a refused certificate is worth more than a sentence, so keep the detail for the card below
            _serverCertificate ??= FindServerCertificateDiagnostic(result.Exception);

            // indexer assignment (not .Add) so two results targeting the same setting cannot throw a duplicate-key exception
            switch (result.SettingValue)
            {
                case { Setting.Name: not null } when !string.IsNullOrEmpty(result.ErrorMessage):
                    SettingsFormCustomErrors[result.SettingValue.Setting.Name] = result.ErrorMessage;
                    break;
                case null when !string.IsNullOrEmpty(result.ErrorMessage):
                    SettingsFormCustomErrors[$"General issue {i + 1}"] = result.ErrorMessage;
                    break;
            }
        }

        if (SettingsFormCustomErrors.Any())
        {
            _settingsBeingSaved = false;
            return;
        }

        // ask the administrator to acknowledge anything sync-affecting they are about to save, before asking why they
        // are saving it. Connector settings are the connector's instructions (where it reads from, what it filters),
        // so a change here is always sync-affecting; cancelling aborts the save.
        var preflight = await jim.ConfigurationChangePreflight.EvaluateConnectedSystemAsync(ConnectedSystem);
        if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                "Connected System", ConnectedSystem.Name))
        {
            _settingsBeingSaved = false;
            return;
        }

        // offer an optional reason for the configuration change history once validation has passed;
        // cancelling aborts the save
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
        if (cancelled)
        {
            _settingsBeingSaved = false;
            return;
        }

        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.ConnectedSystems.UpdateConnectedSystemAsync(ConnectedSystem, user, changeReason);
        Snackbar.Add("Your setting changes have been saved.", Severity.Success);
        _settingsBeingSaved = false;

        await OnConnectedSystemChanged.InvokeAsync();
    }

    /// <summary>
    /// Reads the certificate the configured endpoint is presenting, before anything has been saved or has failed,
    /// so an administrator setting a system up can see and trust it rather than saving, failing, and coming back.
    /// </summary>
    private async Task FetchServerCertificateAsync()
    {
        if (_fetchingCertificate || ConnectedSystem.Id <= 0)
            return;

        _fetchingCertificate = true;
        _fetchedCertificate = null;

        try
        {
            using var jim = JimFactory.Create();
            var result = await jim.Certificates.ReadServerCertificateAsync(ConnectedSystem.Id, DraftSettingValues());

            if (result.Outcome == ServerCertificateReadOutcome.Read)
                _fetchedCertificate = result.Diagnostic;
            else
                Snackbar.Add(result.Message ?? "JIM could not read a certificate from this endpoint.", Severity.Warning);
        }
        finally
        {
            _fetchingCertificate = false;
        }
    }

    /// <summary>
    /// The connectivity settings as they stand on screen, handed to the trust action so it looks at the endpoint the
    /// administrator is configuring. They are not saved, and cannot be: JIM does not save settings that fail
    /// validation, and a certificate it does not trust is a validation failure.
    /// </summary>
    /// <remarks>
    /// Encrypted settings are left out; nothing needed to work out where a system connects is a secret, and there is
    /// no reason to hand a credential to a certificate lookup.
    /// </remarks>
    private List<ConnectedSystemSettingValueDraft> DraftSettingValues()
    {
        return ConnectedSystem.SettingValues
            .Where(sv => sv.Setting is { Type: not ConnectedSystemSettingType.StringEncrypted })
            .Select(sv => new ConnectedSystemSettingValueDraft
            {
                SettingId = sv.Setting.Id,
                StringValue = sv.StringValue,
                IntValue = sv.IntValue,
                CheckboxValue = sv.CheckboxValue
            })
            .ToList();
    }

    /// <summary>
    /// The connectivity settings as they stand on screen for the Discover Domain Controllers action, credential
    /// included: unlike the certificate trust action above, discovery must bind to the directory, and on a
    /// Connected System whose settings have never been saved the typed credential is the only one there is.
    /// The credential travels via the draft's explicit encrypted channel and is never persisted by discovery.
    /// </summary>
    private List<ConnectedSystemSettingValueDraft> DiscoveryDraftSettingValues()
    {
        return ConnectedSystem.SettingValues
            .Select(sv => new ConnectedSystemSettingValueDraft
            {
                SettingId = sv.Setting.Id,
                StringValue = sv.Setting.Type == ConnectedSystemSettingType.StringEncrypted ? null : sv.StringValue,
                StringEncryptedValue = sv.Setting.Type == ConnectedSystemSettingType.StringEncrypted ? sv.StringEncryptedValue : null,
                IntValue = sv.IntValue,
                CheckboxValue = sv.CheckboxValue
            })
            .ToList();
    }

    /// <summary>
    /// Determines whether every RequiredGroup across the Connected System's settings is satisfied: at least one value
    /// supplied for AtLeastOne groups, exactly one for ExactlyOne groups. A group whose members do not currently apply
    /// asks for nothing, so it never blocks the save.
    /// Gates the save button alongside MudForm validity, as group constraints span multiple fields.
    /// </summary>
    private bool AreSettingGroupsSatisfied()
    {
        return ConnectedSystem.SettingValues
            .Select(sv => sv.Setting.RequiredGroup)
            .Where(g => !string.IsNullOrEmpty(g))
            .Distinct()
            .All(g => ConnectorSettingValidator.IsGroupSatisfied(ConnectedSystem.SettingValues, g!));
    }

    private void OnSettingValueChanged()
    {
        // no action needed; handling the child component's callback re-renders this component,
        // refreshing required-group feedback and the save button's enabled state
    }

    private async Task OnFileSelectedAsync()
    {
        if (_settingsForm != null)
        {
            await _settingsForm.ValidateAsync();
        }
    }

    /// <summary>
    /// Walks a validation failure's exception chain for a refused certificate, so the detail survives being wrapped.
    /// </summary>
    private static ServerCertificateDiagnostic? FindServerCertificateDiagnostic(Exception? exception)
    {
        while (exception != null)
        {
            if (exception is ServerCertificateRejectedException certificateRejection)
                return certificateRejection.Diagnostic;

            exception = exception.InnerException;
        }

        return null;
    }
}
