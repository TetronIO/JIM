@page "/admin/connected-systems"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Activities.DTOs
@using JIM.Models.Staging
@using JIM.Models.Staging.DTOs
@using JIM.Models.Transactional.DTOs
@using JIM.Utilities
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Connected Systems</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />Connected Systems</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    JIM imports from and exports data to Connected Systems using Connectors.
    @if (_connectedSystemHeaders == null || _connectedSystemHeaders.Count == 0)
    {
        <span>Configure at least one Connected System to get going.</span>
    }
</MudText>

<div class="d-flex align-center mt-3">
    <MudButtonGroup OverrideStyles="false">
        <MudButton Variant="Variant.Filled" Color="Color.Primary">Connected Systems</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/admin/connected-systems/connectors">Connectors</MudButton>
    </MudButtonGroup>
    <MudSpacer />
    <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Href="/admin/connected-systems/new" Color="Color.Primary" DropShadow="false">Create Connected System</MudButton>
</div>

@* Tracking off is a global condition, so it is stated once here rather than repeated on every row. *@
@if (_drift != null && _drift.Values.Any(d => d.TrackingDisabled))
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-5">
        Configuration change tracking is switched off, so JIM cannot tell which Connected Systems have configuration
        changes waiting for a Full Synchronisation.
    </MudAlert>
}

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count, the search box)
   lives in the shared grid; this page loads the small configuration list once and windows it in memory. *@
<VirtualisedDataGrid @ref="_grid" T="ConnectedSystemHeader"
                     ContainerId="connected-system-list"
                     DefaultSortBy="name"
                     LoadWindow="LoadWindowAsync"
                     SingularName="Connected System"
                     PluralName="Connected Systems">
    <ToolBarExtras>
        @* Beside the table rather than in a filter row of its own: it is the only page-owned filter here, and a
           full row of chrome above the grid for one control would cost more than it explains. *@
        <MudSelect T="PasswordSynchronisationFilter" Label="Password Synchronisation" Value="_passwordSyncFilter"
                   ValueChanged="OnPasswordSynchronisationFilterChangedAsync" Variant="Variant.Text" Dense="true"
                   Margin="Margin.Dense" Class="mt-0" Style="max-width: 260px;">
            <MudSelectItem T="PasswordSynchronisationFilter" Value="@PasswordSynchronisationFilter.Any">Any</MudSelectItem>
            <MudSelectItem T="PasswordSynchronisationFilter" Value="@PasswordSynchronisationFilter.NeedsAttention">Needs attention</MudSelectItem>
            <MudSelectItem T="PasswordSynchronisationFilter" Value="@PasswordSynchronisationFilter.Enabled">Enabled</MudSelectItem>
            <MudSelectItem T="PasswordSynchronisationFilter" Value="@PasswordSynchronisationFilter.Disabled">Switched off</MudSelectItem>
            <MudSelectItem T="PasswordSynchronisationFilter" Value="@PasswordSynchronisationFilter.NotConfigured">Not configured</MudSelectItem>
            <MudSelectItem T="PasswordSynchronisationFilter" Value="@PasswordSynchronisationFilter.NotSupported">Not supported</MudSelectItem>
        </MudSelect>
    </ToolBarExtras>
    <Columns>
        <TemplateColumn Title="Name" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Name" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                <MudLink Href="@(Utilities.GetConnectedSystemHref(context.Item))">@context.Item.Name</MudLink>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Description" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Description" Name="description" />
            </HeaderTemplate>
            <CellTemplate>
                @* A row in a virtualised grid is one line, so a long description is clipped rather than wrapped;
                   it is available in full on hover, and on the Connected System's own page. *@
                <OneLineText Text="@context.Item.Description" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Stats" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Stats</MudText>
            </HeaderTemplate>
            <CellTemplate>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <MudTooltip Text="Objects" Arrow="true" Placement="Placement.Top">
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Text"
                                 Icon="@Icons.Material.Filled.Storage" Class="jim-stat-chip">
                            @context.Item.ObjectCount.ToString("N0")
                        </MudChip>
                    </MudTooltip>
                    @if (context.Item.ConnectorsCount > 0)
                    {
                        <MudTooltip Text="@($"Connected Objects ({GetPercentage(context.Item.ObjectCount, context.Item.ConnectorsCount)}%)")" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.Link" Class="jim-stat-chip">
                                @context.Item.ConnectorsCount.ToString("N0")
                            </MudChip>
                        </MudTooltip>
                    }
                    @if (context.Item.PendingExportObjectsCount > 0)
                    {
                        <MudTooltip Text="@($"Pending Exports ({GetPercentage(context.Item.ObjectCount, context.Item.PendingExportObjectsCount)}%)")" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Text"
                                     Icon="@Icons.Material.Filled.Upload" Class="jim-stat-chip">
                                @context.Item.PendingExportObjectsCount.ToString("N0")
                            </MudChip>
                        </MudTooltip>
                    }
                    <ConfigurationDriftIndicator Status="@GetDrift(context.Item.Id)" ConnectedSystemName="@context.Item.Name" />
                    <InitialPasswordAttentionIndicator Attention="@GetInitialPasswordAttention(context.Item.Id)"
                                                       SubjectName="@context.Item.Name" IsConnectedSystem="true" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        @* Its own column rather than another chip in Stats, because unlike the counts beside it this one has a
           state as well as a size, and the column is what the sort header can hang off (requirement 26). *@
        <TemplateColumn Title="Password Sync" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Password Sync" Name="passwordsync" />
            </HeaderTemplate>
            <CellTemplate>
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                    <PasswordSynchronisationIndicator State="@GetPasswordSynchronisationState(context.Item.Id)"
                                                      Attention="@GetPasswordQueueAttention(context.Item.Id)"
                                                      ConnectedSystemName="@context.Item.Name" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Connector" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Connector" Name="connector" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.ConnectorName
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Created" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Created" Name="created" />
            </HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                    @context.Item.Created.ToLocalTime().ToRelativeTime()
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Action" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Action</MudText>
            </HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="View Objects" Arrow="true" Placement="Placement.Top">
                    <MudIconButton Href="@Utilities.GetConnectedSystemObjectsHref(context.Item)"
                                   Icon="@Icons.Material.Filled.List"
                                   Variant="Variant.Filled" />
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No Connected Systems match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.Cable"
                             PrimaryText="No Connected Systems yet"
                             SecondaryText="Use the Create Connected System button to get going." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private VirtualisedDataGrid<ConnectedSystemHeader>? _grid;
    private IList<ConnectedSystemHeader>? _connectedSystemHeaders;
    private Dictionary<int, ConfigurationDriftStatus>? _drift;
    private Dictionary<int, InitialPasswordAttention>? _initialPasswordAttention;
    private Dictionary<int, PasswordSynchronisationState>? _passwordSynchronisationStates;
    private Dictionary<int, PasswordQueueAttention>? _passwordQueueAttention;
    private PasswordSynchronisationFilter _passwordSyncFilter = PasswordSynchronisationFilter.Any;

    /// <summary>
    /// What the Password Synchronisation filter can narrow the list to (#1119, requirement 26).
    /// <para>
    /// Not simply <see cref="PasswordSynchronisationState"/>, because the most useful thing to ask of this list
    /// is not a state at all: "which systems have password work stuck?" cuts across Enabled and Disabled alike,
    /// and is the question an administrator arrives with.
    /// </para>
    /// </summary>
    private enum PasswordSynchronisationFilter
    {
        Any,
        NeedsAttention,
        Enabled,
        Disabled,
        NotConfigured,
        NotSupported
    }

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Administration", href: "/admin"),
        new("Connected Systems", href: null, disabled: true),
    };

    protected override async Task OnInitializedAsync()
    {
        await EnsureLoadedAsync();
    }

    /// <summary>
    /// Loads the Connected System list and its per-row indicator data once. The grid's window loader also calls
    /// this because the grid can request its first window before this page's initialisation has completed.
    /// </summary>
    private async Task EnsureLoadedAsync()
    {
        if (_connectedSystemHeaders != null)
            return;

        using var jim = JimFactory.Create();
        _connectedSystemHeaders = await jim.ConnectedSystems.GetConnectedSystemHeadersAsync();

        // One batched call for the whole page; the drift service issues a fixed number of queries regardless of how
        // many systems are listed, so this does not become an N+1.
        if (_connectedSystemHeaders.Count > 0)
        {
            var ids = _connectedSystemHeaders.Select(cs => cs.Id).ToList();
            _drift = await jim.ConfigurationDrift.GetConnectedSystemDriftAsync(ids);

            // One grouped count for the whole page, for the same reason: a per-row query here would be an N+1.
            _initialPasswordAttention = await jim.InitialPasswords.GetAttentionByConnectedSystemAsync(ids);

            // Two more batched reads for the Password Synchronisation column: where each system stands, and how
            // much of its queued work is waiting on a person.
            _passwordSynchronisationStates = await jim.ConnectedSystems.GetPasswordSynchronisationStatesAsync(ids);
            _passwordQueueAttention = await jim.PasswordSynchronisation.GetAttentionByConnectedSystemAsync(ids);
        }
    }

    /// <summary>
    /// Windows the in-memory list for the grid: a small configuration list is loaded whole, then searched, sorted
    /// and sliced here rather than growing a database range read.
    /// </summary>
    private async Task<VirtualisedWindow<ConnectedSystemHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        await EnsureLoadedAsync();

        IEnumerable<ConnectedSystemHeader> filtered = _connectedSystemHeaders!;
        if (!string.IsNullOrWhiteSpace(request.SearchText))
            filtered = filtered.Where(cs => cs.Name.Contains(request.SearchText, StringComparison.OrdinalIgnoreCase));

        if (_passwordSyncFilter != PasswordSynchronisationFilter.Any)
            filtered = filtered.Where(MatchesPasswordSynchronisationFilter);

        filtered = request.SortBy switch
        {
            // Descending is "most involved, most stuck first": Enabled before Disabled before never-configured,
            // and within that the systems with the largest backlog at the top. The two counts still break the tie
            // separately rather than being summed, which is the same reason they are two chips and not one.
            "passwordsync" => request.SortDescending
                ? filtered.OrderByDescending(cs => (int)(GetPasswordSynchronisationState(cs.Id) ?? PasswordSynchronisationState.NotSupported))
                    .ThenByDescending(cs => GetPasswordQueueAttention(cs.Id)?.ParkedCount ?? 0)
                    .ThenByDescending(cs => GetPasswordQueueAttention(cs.Id)?.ExpiredCount ?? 0)
                    .ThenBy(cs => cs.Name)
                : filtered.OrderBy(cs => (int)(GetPasswordSynchronisationState(cs.Id) ?? PasswordSynchronisationState.NotSupported))
                    .ThenBy(cs => GetPasswordQueueAttention(cs.Id)?.ParkedCount ?? 0)
                    .ThenBy(cs => GetPasswordQueueAttention(cs.Id)?.ExpiredCount ?? 0)
                    .ThenBy(cs => cs.Name),
            "description" => request.SortDescending
                ? filtered.OrderByDescending(cs => cs.Description ?? string.Empty)
                : filtered.OrderBy(cs => cs.Description ?? string.Empty),
            "connector" => request.SortDescending
                ? filtered.OrderByDescending(cs => cs.ConnectorName)
                : filtered.OrderBy(cs => cs.ConnectorName),
            "created" => request.SortDescending
                ? filtered.OrderByDescending(cs => cs.Created)
                : filtered.OrderBy(cs => cs.Created),
            _ => request.SortDescending
                ? filtered.OrderByDescending(cs => cs.Name)
                : filtered.OrderBy(cs => cs.Name)
        };

        return filtered.ToWindow(request);
    }

    private ConfigurationDriftStatus? GetDrift(int connectedSystemId) =>
        _drift != null && _drift.TryGetValue(connectedSystemId, out var status) ? status : null;

    private InitialPasswordAttention? GetInitialPasswordAttention(int connectedSystemId) =>
        _initialPasswordAttention != null && _initialPasswordAttention.TryGetValue(connectedSystemId, out var attention) ? attention : null;

    private PasswordSynchronisationState? GetPasswordSynchronisationState(int connectedSystemId) =>
        _passwordSynchronisationStates != null && _passwordSynchronisationStates.TryGetValue(connectedSystemId, out var state) ? state : null;

    private PasswordQueueAttention? GetPasswordQueueAttention(int connectedSystemId) =>
        _passwordQueueAttention != null && _passwordQueueAttention.TryGetValue(connectedSystemId, out var attention) ? attention : null;

    /// <summary>
    /// Whether a row survives the Password Synchronisation filter. A system whose state has not loaded matches
    /// nothing but <see cref="PasswordSynchronisationFilter.Any"/>, rather than being assumed into a state.
    /// </summary>
    private bool MatchesPasswordSynchronisationFilter(ConnectedSystemHeader header)
    {
        if (_passwordSyncFilter == PasswordSynchronisationFilter.NeedsAttention)
        {
            var attention = GetPasswordQueueAttention(header.Id);
            return attention is { ParkedCount: > 0 } or { ExpiredCount: > 0 };
        }

        var state = GetPasswordSynchronisationState(header.Id);

        return _passwordSyncFilter switch
        {
            PasswordSynchronisationFilter.Enabled => state == PasswordSynchronisationState.Enabled,
            PasswordSynchronisationFilter.Disabled => state == PasswordSynchronisationState.Disabled,
            PasswordSynchronisationFilter.NotConfigured => state == PasswordSynchronisationState.NotConfigured,
            PasswordSynchronisationFilter.NotSupported => state == PasswordSynchronisationState.NotSupported,
            _ => true
        };
    }

    private async Task OnPasswordSynchronisationFilterChangedAsync(PasswordSynchronisationFilter value)
    {
        _passwordSyncFilter = value;

        // The filter changes which systems match, so the total has to be counted again and the reader's scroll
        // position describes a match set that no longer exists.
        if (_grid != null)
        {
            await _grid.ResetScrollAsync();
            await _grid.RefreshAsync(invalidateTotals: true);
        }
    }

    private static int GetPercentage(int total, int part)
    {
        if (total == 0 || part == 0)
            return 0;

        return (int)Math.Round((double)part / total * 100);
    }
}
