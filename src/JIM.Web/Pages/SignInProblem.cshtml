@page "/sign-in-problem"
@model JIM.Web.Pages.SignInProblemModel
@{
    Layout = "_ErrorPageLayout";
    ViewData["Title"] = "A setting stopped sign-in";
    var problem = Model.Problem;
}

@section Styles {
    <link href="~/css/sign-in-problem.css" rel="stylesheet" asp-append-version="true" />
}

@section Illustration {
    <svg viewBox="0 0 400 220" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="JIM and the identity provider, with a value between them that does not match">
        <circle class="jim-err-float-shape jim-err-shape-1" cx="45" cy="40" r="7" fill="var(--jim-error-shape-tertiary)" opacity="0.6"/>
        <circle class="jim-err-float-shape jim-err-shape-2" cx="355" cy="55" r="10" fill="var(--jim-error-shape-secondary)" opacity="0.5"/>
        <circle class="jim-err-float-shape jim-err-shape-3" cx="70" cy="190" r="6" fill="var(--jim-error-shape-primary)" opacity="0.4"/>
        <rect class="jim-err-float-shape jim-err-shape-5" x="340" y="170" width="12" height="12" rx="2" fill="var(--jim-error-shape-primary)" opacity="0.5" transform="rotate(30 346 176)"/>

        <line x1="146" y1="110" x2="254" y2="110" stroke="var(--jim-error-shape-secondary)" stroke-width="4" stroke-dasharray="8 8" stroke-linecap="round"/>

        <g>
            <rect x="58" y="82" width="88" height="56" rx="14" fill="var(--mud-palette-primary, #764ce8)"/>
            <text x="102" y="118" text-anchor="middle" font-family="'Space Grotesk', 'IBM Plex Sans', sans-serif" font-size="22" font-weight="600" fill="#ffffff">JIM</text>
        </g>
        <g>
            <rect x="254" y="82" width="88" height="56" rx="14" fill="var(--jim-error-shape-tertiary)"/>
            <text x="298" y="118" text-anchor="middle" font-family="'Space Grotesk', 'IBM Plex Sans', sans-serif" font-size="22" font-weight="600" fill="var(--jim-error-badge-text-dark)">IdP</text>
        </g>

        @* What JIM expected and what it received: two values that are not equal. *@
        <g class="jim-err-stop">
            <circle cx="200" cy="110" r="22" fill="var(--jim-error-stop-color)" stroke="var(--mud-palette-background, #ffffff)" stroke-width="5" paint-order="stroke"/>
            <path d="M190 104 h20 M190 116 h20 M204 96 l-8 28" fill="none" stroke="#ffffff" stroke-width="4" stroke-linecap="round"/>
        </g>
    </svg>
}

<h1 class="jim-error-title">A setting stopped sign-in</h1>

@if (problem != null)
{
    <p class="jim-error-subtitle" id="sign-in-problem-description">@problem.Description</p>

    <dl class="jim-sign-in-problem" id="sign-in-problem">
        <dt>Setting</dt>
        <dd><code id="sign-in-problem-setting">@problem.Setting</code></dd>
        <dt>Expected</dt>
        <dd><code id="sign-in-problem-expected">@problem.Expected</code></dd>
        <dt>Received</dt>
        <dd><code id="sign-in-problem-received">@problem.Received</code></dd>
    </dl>

    <p class="jim-error-detail" id="sign-in-problem-fix">@problem.Fix</p>
    <p class="jim-error-detail">If you do not look after this JIM deployment, pass these details to whoever does.</p>
}
else
{
    <p class="jim-error-subtitle">A setting stopped the sign-in, but JIM no longer holds the details, perhaps because it has restarted since.</p>
    <p class="jim-error-detail">
        Try again to see them. An administrator can also list recent sign-in problems with
        <code>Get-JIMSignInDiagnostic</code>, or find them in JIM's log.
    </p>
}

<ul class="jim-error-links">
    <li><a href="@JIM.Web.Pages.SignInProblemModel.DocsUrl" target="_blank" rel="noopener noreferrer">Troubleshooting sign-in</a></li>
</ul>

<div class="jim-error-actions">
    <a href="/" class="jim-error-button jim-error-button-filled">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.65 6.35A7.958 7.958 0 0 0 12 4a8 8 0 1 0 7.74 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
        Try Again
    </a>
</div>
