@* What an export run did about generated values its target rejected as already in use (Unique Value Generation, #242,
   release 4, Phase 9), from the run's two statistics: a sentence in the causality band's idiom and a pill per count.
   The per-object story is on each execution item's own causality band. Renders nothing for a run that met no such
   rejection. *@

@if (Corrected + NeedingDecision > 0)
{
    <MudPaper Outlined="true" Class="@($"pa-4 {Class}")" data-testid="generated-value-export-summary">
        <MudText Typo="Typo.body1">
            <ObjectChip Kind="ObjectChipKind.ConnectedSystem" Name="@ConnectedSystemName"
                        Href="@(ConnectedSystemId.HasValue ? $"/admin/connected-systems/{ConnectedSystemId}" : null)" Class="ma-0" />
            @RejectedSentence
        </MudText>
        <MudStack Row="true" Spacing="2" Class="mt-2">
            @if (Corrected > 0)
            {
                <MudChip T="string" Variant="Variant.Text" Color="Color.Warning" Class="ma-0" data-testid="generated-value-export-corrected">@CorrectedChipText</MudChip>
            }
            @if (NeedingDecision > 0)
            {
                <MudChip T="string" Variant="Variant.Text" Color="Color.Error" Class="ma-0" data-testid="generated-value-export-needs-decision">
                    @NeedsDecisionChipText
                </MudChip>
            }
        </MudStack>
    </MudPaper>
}

@code {
    /// <summary>Values Collision Remediation corrected in the run.</summary>
    [Parameter]
    public int Corrected { get; set; }

    /// <summary>Values the run held for an administrator's decision.</summary>
    [Parameter]
    public int NeedingDecision { get; set; }

    /// <summary>The Connected System the run exported to.</summary>
    [Parameter]
    public int? ConnectedSystemId { get; set; }

    [Parameter]
    public string? ConnectedSystemName { get; set; }

    /// <summary>The panel's geometry, the call site's to set.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The sentence after the Connected System chip: the values rejected, and what the run did about them. Each clause is
    /// a whole sentence fragment chosen by its own count, so each language reads naturally on its own.
    /// </summary>
    private string RejectedSentence => string.Format(CultureInfo.CurrentCulture, GeneratedValueText.ExportRejected,
        Values(Corrected + NeedingDecision), Clauses);

    private string CorrectedChipText => string.Format(CultureInfo.CurrentCulture,
        PluralRules.Choose(Corrected, GeneratedValueText.ExportChipCorrectedOne, GeneratedValueText.ExportChipCorrectedOther),
        Corrected.ToString("N0", CultureInfo.CurrentCulture));

    private string NeedsDecisionChipText => string.Format(CultureInfo.CurrentCulture,
        PluralRules.Choose(NeedingDecision, GeneratedValueText.ExportChipNeedsOne, GeneratedValueText.ExportChipNeedsOther),
        NeedingDecision.ToString("N0", CultureInfo.CurrentCulture));

    private static string Values(int count) => string.Format(CultureInfo.CurrentCulture,
        PluralRules.Choose(count, GeneratedValueText.ExportValuesOne, GeneratedValueText.ExportValuesOther),
        count.ToString("N0", CultureInfo.CurrentCulture));

    private string Clauses
    {
        get
        {
            var corrected = Corrected switch
            {
                0 => string.Empty,
                _ when NeedingDecision == 0 => PluralRules.Choose(Corrected,
                    GeneratedValueText.ExportCorrectedOnlyOne, GeneratedValueText.ExportCorrectedOnlyOther),
                _ => string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(Corrected,
                        GeneratedValueText.ExportCorrectedWithHeldOne, GeneratedValueText.ExportCorrectedWithHeldOther),
                    Corrected.ToString("N0", CultureInfo.CurrentCulture))
            };
            var held = NeedingDecision switch
            {
                0 => string.Empty,
                _ when Corrected == 0 => PluralRules.Choose(NeedingDecision,
                    GeneratedValueText.ExportHeldOnlyOne, GeneratedValueText.ExportHeldOnlyOther),
                _ => string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(NeedingDecision,
                        GeneratedValueText.ExportHeldAfterOne, GeneratedValueText.ExportHeldAfterOther),
                    NeedingDecision.ToString("N0", CultureInfo.CurrentCulture))
            };
            return corrected + held;
        }
    }
}
