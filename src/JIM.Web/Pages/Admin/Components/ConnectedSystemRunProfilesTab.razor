@using JIM.Models.Staging
@using JIM.Utilities
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<MudAlert Severity="Severity.Info">@ConnectedSystemText.RunProfilesIntro</MudAlert>

    @* A Connected System's Run Profiles are a short configuration list held on the system already loaded by the
       page, so the grid's windows are sliced from it in memory rather than from a database range read. *@
    <VirtualisedDataGrid @ref="_grid" T="ConnectedSystemRunProfile"
                         ContainerId="connected-system-run-profile-list"
                         UrlParameterPrefix="rp-"
                         DefaultSortBy="name"
                         LoadWindow="LoadRunProfileWindowAsync"
                         SingularName="@ConnectedSystemText.RunProfileNounSingular"
                         PluralName="@ConnectedSystemText.RunProfileNounPlural"
                         SearchPlaceholder="@ConnectedSystemText.RunProfileSearchPlaceholder">
        <ToolBarExtras>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="HandleShowNewRunProfileDialogAsync"
                       data-testid="jim-run-profile-create">
                @ConnectedSystemText.RunProfileCreateButton
            </MudButton>
        </ToolBarExtras>
        <Columns>
            <TemplateColumn Title="@CommonText.ColumnName" Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@CommonText.ColumnName" Name="name" />
                </HeaderTemplate>
                <CellTemplate>
                    @context.Item.Name
                    @if (!context.Item.Enabled)
                    {
                        <MudTooltip Arrow="true" Placement="Placement.Top">
                            <TooltipContent><TooltipText Text="@DisabledChipExplanation(context.Item)" /></TooltipContent>
                            <ChildContent>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ms-2"
                                         data-testid="jim-run-profile-disabled">@CommonText.Disabled</MudChip>
                            </ChildContent>
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@ConnectedSystemText.RunType" Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@ConnectedSystemText.RunType" Name="runtype" />
                </HeaderTemplate>
                <CellTemplate>
                    @context.Item.RunType.ToString().SplitOnCapitalLetters()
                    @if (context.Item.VerifyImportContentHashes)
                    {
                        <MudTooltip Text="@ConnectedSystemText.RunProfileVerificationModeTooltip" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ms-2">@ConnectedSystemText.VerificationMode</MudChip>
                        </MudTooltip>
                    }
                    @if (context.Item.AllowObjectTypeChanges)
                    {
                        <MudTooltip Arrow="true" Placement="Placement.Top">
                            <TooltipContent><TooltipText Text="@AllowObjectTypeChangesChipExplanation" /></TooltipContent>
                            <ChildContent>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ms-2"
                                         data-testid="jim-run-profile-allows-object-type-changes">@ConnectedSystemText.RunProfileObjectTypeChangesAllowedChip</MudChip>
                            </ChildContent>
                        </MudTooltip>
                    }
                    @if (context.Item.MaxCreates.HasValue)
                    {
                        <MudTooltip Text="@ConnectedSystemText.RunProfileMaxCreatesTooltip" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ms-2">@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.RunProfileMaxCreatesChip, context.Item.MaxCreates)</MudChip>
                        </MudTooltip>
                    }
                    @if (context.Item.MaxUpdates.HasValue)
                    {
                        <MudTooltip Text="@ConnectedSystemText.RunProfileMaxUpdatesTooltip" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ms-2">@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.RunProfileMaxUpdatesChip, context.Item.MaxUpdates)</MudChip>
                        </MudTooltip>
                    }
                    @if (context.Item.MaxDeletes.HasValue)
                    {
                        <MudTooltip Text="@ConnectedSystemText.RunProfileMaxDeletesTooltip" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ms-2">@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.RunProfileMaxDeletesChip, context.Item.MaxDeletes)</MudChip>
                        </MudTooltip>
                    }
                    @if (context.Item.MaxDetectedDeletions.HasValue)
                    {
                        <MudTooltip Text="@DeletionLimitTooltip(context.Item.RunType)" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ms-2">@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.RunProfileMaxDetectedDeletionsChip, context.Item.MaxDetectedDeletions)</MudChip>
                        </MudTooltip>
                    }
                    @if (context.Item.MaxDetectedDeletionsPercent.HasValue)
                    {
                        <MudTooltip Text="@DeletionLimitTooltip(context.Item.RunType)" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ms-2">@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.RunProfileMaxDetectedDeletionsPercentChip, context.Item.MaxDetectedDeletionsPercent)</MudChip>
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
            @if (ConnectedSystem.ConnectorDefinition.SupportsPartitions)
            {
                <TemplateColumn Title="@ConnectedSystemText.PartitionLabel" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@ConnectedSystemText.PartitionLabel" Name="partition" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.Partition is { } partition)
                        {
                            <span class="jim-code-inline">@partition.Name</span>
                            @if (context.Item.TargetsADeselectedPartition())
                            {
                                <MudTooltip Text="@ConnectedSystemText.RunProfilePartitionDeselectedTooltip"
                                            Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ms-2">@ConnectedSystemText.RunProfilePartitionNotSelectedChip</MudChip>
                                </MudTooltip>
                            }
                        }
                        else if (context.Item.NeedsScopeToEnable())
                        {
                            @* Its partition was removed and cleared (#2740): "All selected" would say what it reads once
                               enabled with nothing chosen, which is exactly what enabling it refuses to do. *@
                            <span class="jim-code-inline mud-text-secondary">@context.Item.DisabledPartitionName</span>
                            <MudTooltip Text="@ConnectedSystemText.RunProfilePartitionRemovedTooltip"
                                        Arrow="true" Placement="Placement.Top">
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ms-2">@ConnectedSystemText.RunProfilePartitionRemovedChip</MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            <span>@ConnectedSystemText.AllSelectedPartitionsShort</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
            }
            @if (ConnectedSystem.ConnectorDefinition.SupportsPaging)
            {
                <TemplateColumn Title="@ConnectedSystemText.PageSizeLabel" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@ConnectedSystemText.PageSizeLabel" Name="pagesize" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.PageSize
                    </CellTemplate>
                </TemplateColumn>
            }
            @if (ConnectedSystem.ConnectorDefinition.SupportsFilePaths)
            {
                <TemplateColumn Title="@ConnectedSystemText.FilePathLabel" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@ConnectedSystemText.FilePathLabel" Name="filepath" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.FilePath))
                        {
                            <span class="jim-code-inline">@context.Item.FilePath</span>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
            }
            <TemplateColumn Title="@CommonText.ColumnActions" Sortable="false">
                <HeaderTemplate>
                    <MudText Typo="Typo.button">@CommonText.ColumnActions</MudText>
                </HeaderTemplate>
                <CellTemplate>
                    <div class="d-flex justify-end">
                        @* Full Synchronisation only (#1530): the preview walks the whole population as that run does,
                           so it says nothing true about an import, an export or a Delta Synchronisation. *@
                        @if (context.Item.RunType == ConnectedSystemRunType.FullSynchronisation && OnPreviewRequested.HasDelegate)
                        {
                            var runProfile = context.Item;
                            <MudTooltip Text="@ConnectedSystemText.RunProfilePreviewTooltip" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Secondary" Variant="Variant.Filled"
                                               Size="Size.Small" OnClick="_ => OnPreviewRequested.InvokeAsync(runProfile)" Class="me-2"
                                               aria-label="@ConnectedSystemText.RunProfilePreviewAriaLabel" data-testid="jim-run-profile-preview" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="@CommonText.Edit" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Variant="Variant.Filled"
                                           Size="Size.Small" OnClick="_ => HandleShowEditRunProfileDialogAsync(context.Item)" Class="me-2"
                                           data-testid="jim-run-profile-edit" />
                        </MudTooltip>
                        <MudTooltip Text="@CommonText.Delete" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="Variant.Filled"
                                           Size="Size.Small" OnClick="_ => HandleRunProfileDeleteAsync(context.Item)" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <EmptyContent Context="grid">
            @if (!string.IsNullOrWhiteSpace(grid.SearchText))
            {
                <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                 PrimaryText="@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.RunProfileNoSearchMatch, grid.SearchText)"
                                 SecondaryText="@ConnectedSystemText.RunProfileNoSearchMatchHint"
                                 ActionText="@CommonText.ClearSearch"
                                 OnAction="@(() => grid.ClearSearchAsync())" />
            }
            else
            {
                <TableEmptyState Icon="@Icons.Material.Filled.PlayCircleOutline"
                                 PrimaryText="@ConnectedSystemText.RunProfileNoneYet"
                                 SecondaryText="@ConnectedSystemText.RunProfileNoneYetHint" />
            }
        </EmptyContent>
    </VirtualisedDataGrid>

    @* New Run Profile Dialog *@
    <MudDialog @bind-Visible="_newRunProfileDialogVisible" Options="_newRunProfileDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="me-3" /> @ConnectedSystemText.RunProfileCreateTitle
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudForm @bind-IsValid="@IsNewRunProfileFormValid">
                <MudTextField T="string" @bind-Value="_newRunProfile.Name" Label="@CommonText.FieldName" Variant="Variant.Outlined"
                              Class="mt-3" Required="true" RequiredError="@ConnectedSystemText.RunProfileNameRequired" Immediate="true" />

                <MudSelect T="ConnectedSystemRunType" @bind-Value="_newRunProfile.RunType" Label="@ConnectedSystemText.RunType"
                           Variant="Variant.Outlined" AnchorOrigin="Origin.BottomLeft" Class="mt-5" Required="true"
                           RequiredError="@ConnectedSystemText.RunProfileTypeRequired"
                           Validation="@(new Func<ConnectedSystemRunType, string?>(ValidateRunType))" Immediate="true">
                    <MudSelectItem Value="ConnectedSystemRunType.NotSet" Disabled="true">@ConnectedSystemText.RunProfileSelectRunType</MudSelectItem>
                    @foreach (ConnectedSystemRunType runType in Enum.GetValues(typeof(ConnectedSystemRunType)))
                    {
                        if (runType == ConnectedSystemRunType.NotSet)
                            continue;

                        var runTypeSupported = true;
                        switch (runType)
                        {
                            case ConnectedSystemRunType.Export when !ConnectedSystem.ConnectorDefinition.SupportsExport:
                            case ConnectedSystemRunType.DeltaImport when !ConnectedSystem.ConnectorDefinition.SupportsDeltaImport:
                            case ConnectedSystemRunType.FullImport when !ConnectedSystem.ConnectorDefinition.SupportsFullImport:
                                runTypeSupported = false;
                                break;
                            case ConnectedSystemRunType.FullSynchronisation:
                            case ConnectedSystemRunType.DeltaSynchronisation:
                                break;
                        }

                        <MudSelectItem Value="@runType" Disabled="@(!runTypeSupported)">
                            @runType.ToString().SplitOnCapitalLetters()
                            @if (!runTypeSupported)
                            {
                                <span> @ConnectedSystemText.RunProfileTypeNotSupported</span>
                            }
                        </MudSelectItem>
                    }
                </MudSelect>

                @if (ConnectedSystem.ConnectorDefinition.SupportsFilePaths &&
                     IsImportRunType(_newRunProfile.RunType))
                {
                    <MudTextField T="string" @bind-Value="_newRunProfile.FilePath" Label="@ConnectedSystemText.FilePathLabel" Variant="Variant.Outlined"
                                  Class="mt-3"
                                  HelperText="@ConnectedSystemText.FilePathHelp" />
                }

                @if (IsImportRunType(_newRunProfile.RunType) && ConnectedSystem.ConnectorDefinition.SupportsPartitions && ConnectedSystem.Partitions != null)
                {
                    <MudSelect T="ConnectedSystemPartition" @bind-Value="_newRunProfile.Partition" Label="@ConnectedSystemText.PartitionLabel"
                               Variant="Variant.Outlined" Class="mt-5" AnchorOrigin="Origin.BottomLeft" Clearable="true"
                               HelperText="@ConnectedSystemText.PartitionOptionalHelp">
                        @foreach (var partition in ConnectedSystem.Partitions.Where(p => p.Selected))
                        {
                            <MudSelectItem Value="@partition" />
                        }
                    </MudSelect>
                }

                @if (IsImportRunType(_newRunProfile.RunType) && ConnectedSystem.ConnectorDefinition.SupportsPaging)
                {
                    <MudNumericField @bind-Value="_newRunProfile.PageSize" Label="@ConnectedSystemText.PageSizeLabel" Variant="Variant.Outlined"
                                     Class="mt-3" Min="0" Step="100" Required="true" Immediate="true"
                                     RequiredError="@ConnectedSystemText.PageSizeRequired" />
                }

                @if (_newRunProfile.RunType == ConnectedSystemRunType.FullImport)
                {
                    <div class="d-flex align-center mt-3">
                        <MudCheckBox T="bool" @bind-Value="_newRunProfile.VerifyImportContentHashes" Label="@ConnectedSystemText.VerificationMode" />
                        <MudTooltip Text="@ConnectedSystemText.RunProfileVerificationModeHelp"
                                    Arrow="true" Placement="Placement.Top">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="ms-1 mud-text-secondary" />
                        </MudTooltip>
                    </div>

                    @if (OffersAllowObjectTypeChanges(_newRunProfile.RunType, alreadyAllowed: false))
                    {
                        <div class="d-flex align-center">
                            <MudCheckBox T="bool" @bind-Value="_newRunProfile.AllowObjectTypeChanges" Label="@ConnectedSystemText.AllowObjectTypeChangesLabel"
                                         data-testid="jim-allow-object-type-changes" />
                            <MudTooltip Arrow="true" Placement="Placement.Top">
                                <TooltipContent><TooltipText Text="@AllowObjectTypeChangesExplanation" /></TooltipContent>
                                <ChildContent>
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="ms-1 mud-text-secondary" />
                                </ChildContent>
                            </MudTooltip>
                        </div>
                    }
                }

                @if (IsImportRunType(_newRunProfile.RunType))
                {
                    <MudPaper Outlined="true" Class="pa-4 mt-5">
                        <MudText Typo="Typo.subtitle2">@ConnectedSystemText.SafeguardsTitle</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@DeletionLimitsSummary(_newRunProfile.RunType)</MudText>
                        <MudGrid Spacing="3">
                            <MudItem xs="6">
                                <MudNumericField T="int?" @bind-Value="_newRunProfile.MaxDetectedDeletions" Label="@ConnectedSystemText.MaxDetectedDeletionsLabel"
                                                 Variant="Variant.Outlined" Min="0" Clearable="true" Placeholder="@ConnectedSystemText.RunProfileNoLimit" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField T="int?" @bind-Value="_newRunProfile.MaxDetectedDeletionsPercent" Label="@ConnectedSystemText.MaxDetectedDeletionsPercentLabel"
                                                 Variant="Variant.Outlined" Min="0" Max="100" Clearable="true" Placeholder="@ConnectedSystemText.RunProfileNoLimit" />
                            </MudItem>
                        </MudGrid>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@DeletionLimitsCaption(_newRunProfile.RunType)</MudText>
                    </MudPaper>
                }

                @if (_newRunProfile.RunType == ConnectedSystemRunType.Export)
                {
                    <MudPaper Outlined="true" Class="pa-4 mt-5">
                        <MudText Typo="Typo.subtitle2">@ConnectedSystemText.SafeguardsTitle</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@ConnectedSystemText.RunProfileExportLimitsIntro</MudText>
                        <MudGrid Spacing="3">
                            <MudItem xs="4">
                                <MudNumericField T="int?" @bind-Value="_newRunProfile.MaxCreates" Label="@ConnectedSystemText.RunProfileMaxCreates"
                                                 Variant="Variant.Outlined" Min="0" Clearable="true" Placeholder="@ConnectedSystemText.RunProfileNoLimit" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudNumericField T="int?" @bind-Value="_newRunProfile.MaxUpdates" Label="@ConnectedSystemText.RunProfileMaxUpdates"
                                                 Variant="Variant.Outlined" Min="0" Clearable="true" Placeholder="@ConnectedSystemText.RunProfileNoLimit" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudNumericField T="int?" @bind-Value="_newRunProfile.MaxDeletes" Label="@ConnectedSystemText.RunProfileMaxDeletes"
                                                 Variant="Variant.Outlined" Min="0" Clearable="true" Placeholder="@ConnectedSystemText.RunProfileNoLimit" />
                            </MudItem>
                        </MudGrid>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                            @ConnectedSystemText.RunProfileExportLimitsCaption
                        </MudText>
                    </MudPaper>
                }
            </MudForm>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _newRunProfileDialogVisible = false)" DropShadow="false">@CommonText.Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
                       OnClick="HandleNewRunProfileFormSubmitAsync"
                       Disabled="@(!IsNewRunProfileFormValid || _newRunProfile.RunType == ConnectedSystemRunType.NotSet)"
                       data-testid="jim-run-profile-create-submit">
                @ConnectedSystemText.RunProfileCreateButton
            </MudButton>
        </DialogActions>
    </MudDialog>

    @* Edit Run Profile Dialog *@
    <MudDialog @bind-Visible="_editRunProfileDialogVisible" Options="_newRunProfileDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Class="me-3" /> @ConnectedSystemText.RunProfileEditTitle
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudForm @ref="_editForm" @bind-IsValid="@_isEditRunProfileFormValid">
                <PrefilledFormValidator />
                @if (_editRunProfileOriginal is { Enabled: false } disabledRunProfile)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3" data-testid="jim-run-profile-disabled-reason">
                        @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.RunProfileDisabledExplanation, disabledRunProfile.DescribeWhyDisabled())
                    </MudAlert>
                }
                <MudTextField T="string" @bind-Value="_editRunProfile.Name" Label="@CommonText.FieldName" Variant="Variant.Outlined"
                              Class="mt-3" Required="true" RequiredError="@ConnectedSystemText.RunProfileNameRequired" Immediate="true" />

                <MudSwitch T="bool" @bind-Value="_editRunProfile.Enabled" @bind-Value:after="RevalidateEditFormAsync"
                           Label="@CommonText.Enabled" Color="Color.Primary" Class="mt-3" data-testid="jim-run-profile-enabled" />

                <MudTextField T="string" Value="@_editRunProfile.RunType.ToString().SplitOnCapitalLetters()" Label="@ConnectedSystemText.RunType"
                              Variant="Variant.Outlined" Class="mt-5" Disabled="true"
                              HelperText="@ConnectedSystemText.RunTypeLockedHelp" />

                @if (ConnectedSystem.ConnectorDefinition.SupportsFilePaths &&
                     IsImportRunType(_editRunProfile.RunType))
                {
                    <MudTextField T="string" @bind-Value="_editRunProfile.FilePath" Label="@ConnectedSystemText.FilePathLabel" Variant="Variant.Outlined"
                                  Class="mt-3"
                                  HelperText="@ConnectedSystemText.FilePathHelp" />
                }

                @if (EditNeedsScopeChoice)
                {
                    @* Enabling a Run Profile that a hierarchy refresh disabled, by removing its partition (#2740). Its
                       partition was cleared, so leaving the box empty would quietly have it read every selected
                       partition. A required choice, gated by the form, makes "all selected partitions" a decision. *@
                    <MudSelect T="string" @bind-Value="_editScopeChoice" Label="@ConnectedSystemText.PartitionLabel" Variant="Variant.Outlined"
                               Class="mt-5" AnchorOrigin="Origin.BottomLeft" Required="true"
                               RequiredError="@ConnectedSystemText.RunProfilePartitionChoiceRequired"
                               HelperText="@ConnectedSystemText.RunProfilePartitionRemovedRequiredHelp"
                               data-testid="jim-run-profile-scope-choice">
                        <MudSelectItem Value="@AllSelectedPartitionsChoice">@ConnectedSystemText.AllSelectedPartitions</MudSelectItem>
                        @foreach (var partition in (ConnectedSystem.Partitions ?? []).Where(p => p.Selected))
                        {
                            <MudSelectItem Value="@partition.Id.ToString(System.Globalization.CultureInfo.InvariantCulture)">@partition.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
                else if (IsImportRunType(_editRunProfile.RunType) && ConnectedSystem.ConnectorDefinition.SupportsPartitions && ConnectedSystem.Partitions != null)
                {
                    <MudSelect T="ConnectedSystemPartition" @bind-Value="_editRunProfile.Partition" Label="@ConnectedSystemText.PartitionLabel"
                               Variant="Variant.Outlined" Class="mt-5" AnchorOrigin="Origin.BottomLeft" Clearable="true"
                               HelperText="@ConnectedSystemText.PartitionOptionalHelp">
                        @foreach (var partition in ConnectedSystem.Partitions.Where(p => p.Selected))
                        {
                            <MudSelectItem Value="@partition" />
                        }
                    </MudSelect>
                }

                @if (IsImportRunType(_editRunProfile.RunType) && ConnectedSystem.ConnectorDefinition.SupportsPaging)
                {
                    <MudNumericField @bind-Value="_editRunProfile.PageSize" Label="@ConnectedSystemText.PageSizeLabel" Variant="Variant.Outlined"
                                     Class="mt-3" Min="0" Step="100" Required="true" Immediate="true"
                                     RequiredError="@ConnectedSystemText.PageSizeRequired" />
                }

                @if (_editRunProfile.RunType == ConnectedSystemRunType.FullImport)
                {
                    <div class="d-flex align-center mt-3">
                        <MudCheckBox T="bool" @bind-Value="_editRunProfile.VerifyImportContentHashes" Label="@ConnectedSystemText.VerificationMode" />
                        <MudTooltip Text="@ConnectedSystemText.RunProfileVerificationModeHelp"
                                    Arrow="true" Placement="Placement.Top">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="ms-1 mud-text-secondary" />
                        </MudTooltip>
                    </div>

                    @* Visibility follows the saved value rather than the box being edited, so unticking it does not make it vanish. *@
                    @if (OffersAllowObjectTypeChanges(_editRunProfile.RunType, alreadyAllowed: _editRunProfileOriginal?.AllowObjectTypeChanges == true))
                    {
                        <div class="d-flex align-center">
                            <MudCheckBox T="bool" @bind-Value="_editRunProfile.AllowObjectTypeChanges" Label="@ConnectedSystemText.AllowObjectTypeChangesLabel"
                                         data-testid="jim-allow-object-type-changes" />
                            <MudTooltip Arrow="true" Placement="Placement.Top">
                                <TooltipContent><TooltipText Text="@AllowObjectTypeChangesExplanation" /></TooltipContent>
                                <ChildContent>
                                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="ms-1 mud-text-secondary" />
                                </ChildContent>
                            </MudTooltip>
                        </div>
                        @if (!ConnectedSystem.ConnectorDefinition.ExternalIdsUniqueAcrossObjectTypes)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block" data-testid="jim-allow-object-type-changes-no-effect">
                                @ConnectedSystemText.RunProfileConnectorNoObjectTypeDetection
                            </MudText>
                        }
                    }
                }

                @if (IsImportRunType(_editRunProfile.RunType))
                {
                    <MudPaper Outlined="true" Class="pa-4 mt-5">
                        <MudText Typo="Typo.subtitle2">@ConnectedSystemText.SafeguardsTitle</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@DeletionLimitsSummary(_editRunProfile.RunType)</MudText>
                        <MudGrid Spacing="3">
                            <MudItem xs="6">
                                <MudNumericField T="int?" @bind-Value="_editRunProfile.MaxDetectedDeletions" Label="@ConnectedSystemText.MaxDetectedDeletionsLabel"
                                                 Variant="Variant.Outlined" Min="0" Clearable="true" Placeholder="@ConnectedSystemText.RunProfileNoLimit" />
                            </MudItem>
                            <MudItem xs="6">
                                <MudNumericField T="int?" @bind-Value="_editRunProfile.MaxDetectedDeletionsPercent" Label="@ConnectedSystemText.MaxDetectedDeletionsPercentLabel"
                                                 Variant="Variant.Outlined" Min="0" Max="100" Clearable="true" Placeholder="@ConnectedSystemText.RunProfileNoLimit" />
                            </MudItem>
                        </MudGrid>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@DeletionLimitsCaption(_editRunProfile.RunType)</MudText>
                    </MudPaper>
                }

                @if (_editRunProfile.RunType == ConnectedSystemRunType.Export)
                {
                    <MudPaper Outlined="true" Class="pa-4 mt-5">
                        <MudText Typo="Typo.subtitle2">@ConnectedSystemText.SafeguardsTitle</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@ConnectedSystemText.RunProfileExportLimitsIntro</MudText>
                        <MudGrid Spacing="3">
                            <MudItem xs="4">
                                <MudNumericField T="int?" @bind-Value="_editRunProfile.MaxCreates" Label="@ConnectedSystemText.RunProfileMaxCreates"
                                                 Variant="Variant.Outlined" Min="0" Clearable="true" Placeholder="@ConnectedSystemText.RunProfileNoLimit" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudNumericField T="int?" @bind-Value="_editRunProfile.MaxUpdates" Label="@ConnectedSystemText.RunProfileMaxUpdates"
                                                 Variant="Variant.Outlined" Min="0" Clearable="true" Placeholder="@ConnectedSystemText.RunProfileNoLimit" />
                            </MudItem>
                            <MudItem xs="4">
                                <MudNumericField T="int?" @bind-Value="_editRunProfile.MaxDeletes" Label="@ConnectedSystemText.RunProfileMaxDeletes"
                                                 Variant="Variant.Outlined" Min="0" Clearable="true" Placeholder="@ConnectedSystemText.RunProfileNoLimit" />
                            </MudItem>
                        </MudGrid>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                            @ConnectedSystemText.RunProfileExportLimitsCaption
                        </MudText>
                    </MudPaper>
                }
            </MudForm>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _editRunProfileDialogVisible = false)" DropShadow="false">@CommonText.Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
                       OnClick="HandleEditRunProfileFormSubmitAsync"
                       Disabled="@(!_isEditRunProfileFormValid)"
                       data-testid="jim-run-profile-edit-submit">
                @CommonText.SaveChanges
            </MudButton>
        </DialogActions>
    </MudDialog>

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    /// <summary>
    /// Raised when the administrator asks to preview a Full Synchronisation Run Profile (#1530). The page shows the
    /// preview on the Details tab; unset, the action is not offered.
    /// </summary>
    [Parameter]
    public EventCallback<ConnectedSystemRunProfile> OnPreviewRequested { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private VirtualisedDataGrid<ConnectedSystemRunProfile>? _grid;

    private bool IsNewRunProfileFormValid { get; set; }
    private ConnectedSystemRunProfile _newRunProfile = new() { RunType = ConnectedSystemRunType.NotSet };
    private readonly DialogOptions _newRunProfileDialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };
    private bool _newRunProfileDialogVisible;

    private bool _isEditRunProfileFormValid;
    private MudForm? _editForm;
    private ConnectedSystemRunProfile _editRunProfile = new();
    private ConnectedSystemRunProfile? _editRunProfileOriginal;
    private bool _editRunProfileDialogVisible;

    /// <summary>
    /// The scope chosen when enabling a Run Profile that a removed partition disabled: a partition's id, or
    /// <see cref="AllSelectedPartitionsChoice"/>. Null until one is chosen.
    /// </summary>
    private string? _editScopeChoice;

    private const string AllSelectedPartitionsChoice = "all";

    /// <summary>
    /// Whether the edit enables a Run Profile that a hierarchy refresh disabled by removing its partition (#2740), and so
    /// has to say what it reads.
    /// </summary>
    private bool EditNeedsScopeChoice => _editRunProfile.Enabled && _editRunProfileOriginal?.NeedsScopeToEnable() == true;

    /// <summary>
    /// The Disabled chip's tooltip: that the Run Profile cannot run, and why.
    /// </summary>
    private static string DisabledChipExplanation(ConnectedSystemRunProfile runProfile) =>
        string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.RunProfileDisabledChipTooltip, runProfile.DescribeWhyDisabled());

    /// <summary>
    /// Re-checks the edit form when the Enabled switch moves, since that shows or hides the required scope choice and a
    /// field that disappears does not re-evaluate the form by itself.
    /// </summary>
    private async Task RevalidateEditFormAsync()
    {
        if (_editForm == null)
            return;

        await Task.Yield();
        await _editForm.ValidateAsync();
    }

    /// <summary>
    /// Slices one window of Run Profiles from the collection held on the Connected System the page already loaded,
    /// applying the grid's search (name, run type and file path) and sort. A Connected System has a handful of Run
    /// Profiles, so this stays in memory rather than growing a database range read.
    /// </summary>
    private Task<VirtualisedWindow<ConnectedSystemRunProfile>> LoadRunProfileWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        IEnumerable<ConnectedSystemRunProfile> runProfiles = ConnectedSystem.RunProfiles ?? new List<ConnectedSystemRunProfile>();

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            runProfiles = runProfiles.Where(rp =>
                rp.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                rp.RunType.ToString().SplitOnCapitalLetters().Contains(search, StringComparison.OrdinalIgnoreCase) ||
                (rp.FilePath != null && rp.FilePath.Contains(search, StringComparison.OrdinalIgnoreCase)));
        }

        IOrderedEnumerable<ConnectedSystemRunProfile> Order<TKey>(Func<ConnectedSystemRunProfile, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? runProfiles.OrderByDescending(key, comparer) : runProfiles.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "runtype" => Order(rp => rp.RunType),
            "partition" => Order(rp => rp.Partition?.Name ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            "pagesize" => Order(rp => rp.PageSize),
            "filepath" => Order(rp => rp.FilePath ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            _ => Order(rp => rp.Name, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    /// <summary>
    /// Refreshes the grid over the Run Profile collection after it has been added to, edited or removed from. The
    /// totals are invalidated because the change may have altered how many Run Profiles exist or match the search.
    /// </summary>
    private async Task RefreshGridAsync()
    {
        if (_grid != null)
            await _grid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// The "Allow Object Type Changes" explanation, shared by the create and edit dialogs (#2049).
    /// </summary>
    private static string AllowObjectTypeChangesExplanation => ConnectedSystemText.RunProfileAllowObjectTypeChangesExplanation;

    /// <summary>
    /// The grid chip's explanation for a Run Profile that allows Object Type changes (#2049).
    /// </summary>
    private static string AllowObjectTypeChangesChipExplanation => ConnectedSystemText.RunProfileAllowObjectTypeChangesChipExplanation;

    /// <summary>
    /// Whether "Allow Object Type Changes" is offered (#2049): on a Full Import only, and only where the Connector vouches
    /// that an External ID names one object across every Object Type, the one case in which an import can tell an
    /// Object Type change from two objects that share a value. Anywhere else the setting does nothing, so it is not
    /// offered. A Run Profile that already allows the change (set through the REST API or PowerShell, say) always shows
    /// it, so a value that changes what a run does is never hidden from the person editing it.
    /// </summary>
    private bool OffersAllowObjectTypeChanges(ConnectedSystemRunType runType, bool alreadyAllowed) =>
        runType == ConnectedSystemRunType.FullImport &&
        (ConnectedSystem.ConnectorDefinition.ExternalIdsUniqueAcrossObjectTypes || alreadyAllowed);

    private static bool IsImportRunType(ConnectedSystemRunType runType) =>
        runType is ConnectedSystemRunType.FullImport or ConnectedSystemRunType.DeltaImport;

    /// <summary>
    /// What the deletion limits do on this kind of import (#2089): a Full Import's limits guard the objects it no longer
    /// finds, a Delta Import's the deletes its Connector reports.
    /// </summary>
    private static string DeletionLimitsSummary(ConnectedSystemRunType runType) => runType == ConnectedSystemRunType.DeltaImport
        ? ConnectedSystemText.RunProfileDeltaLimitsSummary
        : ConnectedSystemText.RunProfileFullLimitsSummary;

    private static string DeletionLimitsCaption(ConnectedSystemRunType runType) => runType == ConnectedSystemRunType.DeltaImport
        ? ConnectedSystemText.RunProfileDeltaLimitsCaption
        : ConnectedSystemText.RunProfileFullLimitsCaption;

    private static string DeletionLimitTooltip(ConnectedSystemRunType runType) => runType == ConnectedSystemRunType.DeltaImport
        ? ConnectedSystemText.RunProfileDeltaLimitTooltip
        : ConnectedSystemText.RunProfileFullLimitTooltip;

    private string? ValidateRunType(ConnectedSystemRunType runType)
    {
        if (runType == ConnectedSystemRunType.NotSet)
            return ConnectedSystemText.RunProfileSelectRunTypeRequired;

        return null;
    }

    private Task HandleShowNewRunProfileDialogAsync()
    {
        _newRunProfile = new ConnectedSystemRunProfile { RunType = ConnectedSystemRunType.NotSet };
        _newRunProfileDialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task HandleNewRunProfileFormSubmitAsync()
    {
        if (ConnectedSystem.RunProfiles == null)
            return;

        // Keep a reference to the partition for UI display after save
        // (the repository nulls the navigation property to avoid EF identity conflicts)
        var selectedPartition = _newRunProfile.Partition;

        var runProfile = new ConnectedSystemRunProfile
        {
            ConnectedSystemId = ConnectedSystem.Id,
            Name = _newRunProfile.Name,
            RunType = _newRunProfile.RunType,
            Partition = selectedPartition,
            PageSize = _newRunProfile.PageSize,
            FilePath = IsImportRunType(_newRunProfile.RunType) ? _newRunProfile.FilePath : null,
            VerifyImportContentHashes = _newRunProfile.RunType == ConnectedSystemRunType.FullImport && _newRunProfile.VerifyImportContentHashes,
            AllowObjectTypeChanges = _newRunProfile.RunType == ConnectedSystemRunType.FullImport && _newRunProfile.AllowObjectTypeChanges,
            MaxCreates = _newRunProfile.RunType == ConnectedSystemRunType.Export ? _newRunProfile.MaxCreates : null,
            MaxUpdates = _newRunProfile.RunType == ConnectedSystemRunType.Export ? _newRunProfile.MaxUpdates : null,
            MaxDeletes = _newRunProfile.RunType == ConnectedSystemRunType.Export ? _newRunProfile.MaxDeletes : null,
            MaxDetectedDeletions = IsImportRunType(_newRunProfile.RunType) ? _newRunProfile.MaxDetectedDeletions : null,
            MaxDetectedDeletionsPercent = IsImportRunType(_newRunProfile.RunType) ? _newRunProfile.MaxDetectedDeletionsPercent : null
        };

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.ConnectedSystems.CreateConnectedSystemRunProfileAsync(runProfile, user);

            // Restore partition reference for UI display, then add to local collection
            runProfile.Partition = selectedPartition;
            ConnectedSystem.RunProfiles.Add(runProfile);

            Snackbar.Add(ConnectedSystemText.RunProfileAddedSnackbar, Severity.Success);
            _newRunProfileDialogVisible = false;
            _newRunProfile = new ConnectedSystemRunProfile { RunType = ConnectedSystemRunType.NotSet };
            await RefreshGridAsync();
        }
        catch
        {
            Snackbar.Add(ConnectedSystemText.RunProfileCreateFailed, Severity.Error);
        }
    }

    private Task HandleShowEditRunProfileDialogAsync(ConnectedSystemRunProfile runProfile)
    {
        _editRunProfileOriginal = runProfile;
        _editRunProfile = new ConnectedSystemRunProfile
        {
            Id = runProfile.Id,
            ConnectedSystemId = runProfile.ConnectedSystemId,
            Name = runProfile.Name,
            RunType = runProfile.RunType,
            PageSize = runProfile.PageSize,
            FilePath = runProfile.FilePath,
            Partition = runProfile.Partition,
            Enabled = runProfile.Enabled,
            VerifyImportContentHashes = runProfile.VerifyImportContentHashes,
            AllowObjectTypeChanges = runProfile.AllowObjectTypeChanges,
            MaxCreates = runProfile.MaxCreates,
            MaxUpdates = runProfile.MaxUpdates,
            MaxDeletes = runProfile.MaxDeletes,
            MaxDetectedDeletions = runProfile.MaxDetectedDeletions,
            MaxDetectedDeletionsPercent = runProfile.MaxDetectedDeletionsPercent
        };
        _editScopeChoice = null;
        _editRunProfileDialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task HandleEditRunProfileFormSubmitAsync()
    {
        if (_editRunProfileOriginal == null)
            return;

        // Enabling a Run Profile a removed partition disabled says what it reads (#2740): a partition, or all selected
        // partitions, stated to the server so it does not refuse the enable as a silent widening.
        var allSelectedPartitions = false;
        var selectedPartition = _editRunProfile.Partition;
        if (EditNeedsScopeChoice)
        {
            if (_editScopeChoice == AllSelectedPartitionsChoice)
            {
                allSelectedPartitions = true;
                selectedPartition = null;
            }
            else
            {
                selectedPartition = ConnectedSystem.Partitions?.SingleOrDefault(p =>
                    p.Id.ToString(System.Globalization.CultureInfo.InvariantCulture) == _editScopeChoice);
            }
        }

        _editRunProfileOriginal.Name = _editRunProfile.Name;
        _editRunProfileOriginal.Enabled = _editRunProfile.Enabled;
        _editRunProfileOriginal.PageSize = _editRunProfile.PageSize;
        _editRunProfileOriginal.FilePath = IsImportRunType(_editRunProfileOriginal.RunType) ? _editRunProfile.FilePath : null;
        _editRunProfileOriginal.Partition = selectedPartition;
        _editRunProfileOriginal.VerifyImportContentHashes = _editRunProfileOriginal.RunType == ConnectedSystemRunType.FullImport && _editRunProfile.VerifyImportContentHashes;
        _editRunProfileOriginal.AllowObjectTypeChanges = _editRunProfileOriginal.RunType == ConnectedSystemRunType.FullImport && _editRunProfile.AllowObjectTypeChanges;

        if (_editRunProfileOriginal.RunType == ConnectedSystemRunType.Export)
        {
            _editRunProfileOriginal.MaxCreates = _editRunProfile.MaxCreates;
            _editRunProfileOriginal.MaxUpdates = _editRunProfile.MaxUpdates;
            _editRunProfileOriginal.MaxDeletes = _editRunProfile.MaxDeletes;
        }

        if (IsImportRunType(_editRunProfileOriginal.RunType))
        {
            _editRunProfileOriginal.MaxDetectedDeletions = _editRunProfile.MaxDetectedDeletions;
            _editRunProfileOriginal.MaxDetectedDeletionsPercent = _editRunProfile.MaxDetectedDeletionsPercent;
        }

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.ConnectedSystems.UpdateConnectedSystemRunProfileAsync(_editRunProfileOriginal, user, allSelectedPartitions);

            _editRunProfileOriginal.Partition = selectedPartition;

            Snackbar.Add(ConnectedSystemText.RunProfileUpdatedSnackbar, Severity.Success);
            _editRunProfileDialogVisible = false;
            await RefreshGridAsync();
        }
        catch (ArgumentException ex)
        {
            // A refusal the server explains, such as enabling a Run Profile without the scope it needs.
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch
        {
            Snackbar.Add(ConnectedSystemText.RunProfileUpdateFailed, Severity.Error);
        }
    }

    private async Task HandleRunProfileDeleteAsync(ConnectedSystemRunProfile connectedSystemRunProfile)
    {
        if (ConnectedSystem.RunProfiles == null)
            return;

        var confirmationResult = await DialogService.ShowMessageBoxAsync(
            ConnectedSystemText.RunProfileDeleteTitle,
            string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.RunProfileDeleteConfirm, connectedSystemRunProfile.Name),
            yesText: CommonText.Delete,
            cancelText: CommonText.Cancel);

        if (confirmationResult != true)
            return;

        ConnectedSystem.RunProfiles.Remove(connectedSystemRunProfile);

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.ConnectedSystems.DeleteConnectedSystemRunProfileAsync(connectedSystemRunProfile, user);

        Snackbar.Add(ConnectedSystemText.RunProfileRemovedSnackbar, Severity.Success);
        await RefreshGridAsync();
    }
}
