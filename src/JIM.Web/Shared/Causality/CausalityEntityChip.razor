@* A causality entity chip: a glyph circle identifying the entity kind (CSO, MVO, CS, SR, PE, DR, RP),
   an optional demoted sub-label and the entity name with ellipsis overflow. A Connected System Object
   and a Metaverse Object wear three-letter glyphs, so that on the Lineage view the two sides of a
   column pair are told apart at a glance and neither is mistaken for the two-letter CS glyph the
   Timeline's Connected System chips carry. Where a SubLabel is set, the visible text reads as
   ObjectDescription's "type: name" label form (#1669 follow-up), not the running-text mention with
   "in {system}": a chip is a tag, not a sentence, and the Connected System already follows on its own
   linked sub-line beneath the row that carries this chip. It is split into two spans purely for the
   type prefix's dimmed colour; the chip's title and accessible text (AccessibleText, below) are the
   same "type: name" string as one piece, so the two can never disagree on what the label actually
   says. The glyph's own title attribute spells out the abbreviation ("Connected System Object",
   "Synchronisation Rule", ...), since nothing else on the chip explains it. Renders as a link when
   Href is provided, otherwise as a plain chip. *@

@if (!string.IsNullOrEmpty(Href))
{
    <a class="chip @(ShowGlyph ? null : "plain")" href="@Href" title="@AccessibleText">@ChipContent</a>
}
else
{
    <span class="chip @(ShowGlyph ? null : "plain")" title="@AccessibleText">@ChipContent</span>
}

@code {
    /// <summary>
    /// The entity's display name.
    /// </summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = string.Empty;

    /// <summary>
    /// Destination href; when null the chip renders unlinked.
    /// </summary>
    [Parameter]
    public string? Href { get; set; }

    /// <summary>
    /// The kind of entity, selecting the glyph circle's text and colour.
    /// </summary>
    [Parameter]
    public CausalityEntityKind Kind { get; set; }

    /// <summary>
    /// Whether the glyph renders at all. False where something beside the chip already says what kind
    /// of object it names: a card in a Lineage column, whose head carries the CSO or MVO glyph for
    /// every chip beneath it. The chip then renders name-only, with the "plain" class so its padding
    /// suits a chip with no leading circle.
    /// </summary>
    [Parameter]
    public bool ShowGlyph { get; set; } = true;

    /// <summary>
    /// Optional demoted sub-label rendered before the name (e.g. the Connected System Object's own
    /// type). Visible text is dimmed, display-only; <see cref="AccessibleText"/> is the single source
    /// of what the combined "type: name" label actually says.
    /// </summary>
    [Parameter]
    public string? SubLabel { get; set; }

    private RenderFragment ChipContent => __builder =>
    {
        @if (ShowGlyph)
        {
            <span class="glyph @GetGlyphClass()" aria-hidden="true" title="@GetGlyphFullName()">@GetGlyphText()</span>
        }
        @if (!string.IsNullOrEmpty(SubLabel))
        {
            @* Dimmed display-only prefix (#1669 follow-up): the visible reading matches
               AccessibleText's "type: name" exactly, just split so the type can be demoted in colour.
               The colon and trailing space are baked into this span's own text rather than left as
               markup whitespace: Razor trims a literal space immediately before a closing tag, so
               without it the two spans would render with nothing separating them. *@
            <span class="sub">@($"{SubLabel}: ")</span>
        }
        <span class="name-ellip">@Label</span>
    };

    /// <summary>
    /// The chip's title and accessible text: the name alone, or the shared "type: name" label
    /// (<see cref="ObjectDescription.ForConnectedSystemObjectLabel"/>, #1669 follow-up) when a
    /// SubLabel is set. This is the single source of what the label says; the visible two-span
    /// rendering above is a display-only split of the identical text for the type prefix's dimmed
    /// colour, and must always read the same as this.
    /// </summary>
    private string AccessibleText => string.IsNullOrEmpty(SubLabel)
        ? Label
        : ObjectDescription.ForConnectedSystemObjectLabel(SubLabel, Label);

    /// <summary>
    /// The glyph circle's text.
    /// </summary>
    private string GetGlyphText()
    {
        return Kind switch
        {
            CausalityEntityKind.ConnectedSystem => "CS",
            CausalityEntityKind.Record => "CSO",
            CausalityEntityKind.Identity => "MVO",
            CausalityEntityKind.SynchronisationRule => "SR",
            CausalityEntityKind.PendingExport => "PE",
            CausalityEntityKind.DeletionRecord => "DR",
            _ => "RP"
        };
    }

    /// <summary>
    /// The glyph's full name, for the abbreviation's own title attribute.
    /// </summary>
    private string GetGlyphFullName()
    {
        return Kind switch
        {
            CausalityEntityKind.ConnectedSystem => "Connected System",
            CausalityEntityKind.Record => "Connected System Object",
            CausalityEntityKind.Identity => "Metaverse Object",
            CausalityEntityKind.SynchronisationRule => "Synchronisation Rule",
            CausalityEntityKind.PendingExport => "Pending Export",
            CausalityEntityKind.DeletionRecord => "Deletion record",
            _ => "Run Profile"
        };
    }

    private string GetGlyphClass()
    {
        return Kind switch
        {
            CausalityEntityKind.ConnectedSystem => "sys",
            CausalityEntityKind.Record => "cso",
            CausalityEntityKind.Identity => "mvo",
            CausalityEntityKind.SynchronisationRule => "rule",
            _ => "other"
        };
    }
}
