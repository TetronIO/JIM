<PageTitle>@AdminText.LogsPageTitle</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Custom.FileFormats.FileDocument" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />@AdminText.LogsPageTitle
    <PageInfo Title="@AdminText.LogsPageTitle" DocsPage="administration/logs.md">
        @AdminText.LogsPageInfo
    </PageInfo>
</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

<MudPaper Elevation="0" Class="pa-4 mt-2" Outlined="true">
    <MudGrid>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string" @bind-Value="_selectedService" Label="@AdminText.LogsService" Variant="Variant.Outlined"
                Dense="true" Clearable="true" Placeholder="@AdminText.LogsAllServices">
                @* i18n: exempt - service name, a product name that is not translated (engineering/LOCALISATION.md) *@
                <MudSelectItem T="string" Value="@("web")">Web</MudSelectItem>
                <MudSelectItem T="string" Value="@("worker")">Worker</MudSelectItem>
                @* i18n: exempt - service name, a product name that is not translated (engineering/LOCALISATION.md) *@
                <MudSelectItem T="string" Value="@("scheduler")">Scheduler</MudSelectItem>
                <MudSelectItem T="string" Value="@("database")">Database</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudDatePicker @bind-Date="_selectedDate" Label="@AdminText.LogsDate" Variant="Variant.Outlined"
                MaxDate="DateTime.Today" Clearable="true" Placeholder="@AdminText.LogsToday" />
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="string" @bind-SelectedValues="_selectedLevels" Label="@AdminText.LogsLevels" Variant="Variant.Outlined"
                Dense="true" Clearable="true" Placeholder="@AdminText.LogsAllLevels" MultiSelection="true"
                MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetSelectedLevelsText))">
                <MudSelectItem T="string" Value="@("Verbose")">@AdminText.LogsLevelVerbose</MudSelectItem>
                <MudSelectItem T="string" Value="@("Debug")">@AdminText.LogsLevelDebug</MudSelectItem>
                <MudSelectItem T="string" Value="@("Information")">@AdminText.LogsLevelInformation</MudSelectItem>
                <MudSelectItem T="string" Value="@("Warning")">@AdminText.LogsLevelWarning</MudSelectItem>
                <MudSelectItem T="string" Value="@("Error")">@AdminText.LogsLevelError</MudSelectItem>
                <MudSelectItem T="string" Value="@("Fatal")">@AdminText.LogsLevelFatal</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
    <div class="d-flex align-center gap-3 mt-4">
        <MudButton OnClick="RefreshAsync" StartIcon="@Icons.Material.Filled.Refresh" Variant="Variant.Filled"
            Color="Color.Primary" DropShadow="false">
            @CommonText.Refresh
        </MudButton>
        <MudSwitch T="bool" Value="_autoRefresh" ValueChanged="OnAutoRefreshChanged" Color="Color.Primary" Label="@AdminText.LogsAutoRefresh" />
    </div>
</MudPaper>

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count, the live search
   box) lives in the shared grid; this page supplies the columns, the window loader honouring the applied filter
   snapshot above, and the empty states. Free-text search is the grid's own box, filtering as the reader types;
   the service, date and level filters stay form-owned and apply on Refresh. *@
<VirtualisedDataGrid @ref="_grid" T="LogEntry"
                     ContainerId="log-entry-list"
                     DefaultSortBy="Timestamp"
                     LoadWindow="LoadWindowAsync"
                     RowClicked="HandleRowClicked"
                     SingularName="@AdminText.LogsNounSingular"
                     PluralName="@AdminText.LogsNounPlural"
                     SearchPlaceholder="@AdminText.LogsSearchPlaceholder">
    <Columns>
        <TemplateColumn T="LogEntry" Title="@AdminText.LogsColumnTime" Sortable="false" HeaderStyle="width: 100px;" CellStyleFunc="@GetRowStyle">
            <CellTemplate>
                <MudTooltip Text="@context.Item.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")" Arrow="true" Placement="Placement.Top">
                    <span class="jim-text-code">@context.Item.Timestamp.ToLocalTime().ToString("HH:mm:ss.fff")</span>
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="LogEntry" Title="@AdminText.LogsColumnLevel" Sortable="false" HeaderStyle="width: 70px;" CellStyleFunc="@GetRowStyle">
            <CellTemplate>
                <MudChip T="string" Variant="Variant.Text" Color="@GetLevelColor(context.Item.Level)"
                    Class="ma-0" Style="min-width: 50px; justify-content: center;">
                    @context.Item.LevelShort
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="LogEntry" Title="@AdminText.LogsService" Sortable="false" HeaderStyle="width: 80px;" CellStyleFunc="@GetRowStyle">
            <CellTemplate>
                <span class="jim-text-code">@context.Item.Service</span>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="LogEntry" Title="@AdminText.LogsColumnMessage" Sortable="false" CellStyleFunc="@GetRowStyle">
            <CellTemplate>
                @* A row in a virtualised grid is one line, so the message is clipped rather than wrapped, and the
                   exception and property markers beside it never give way to a long one. A log line is what the
                   reader is here to read, so the loss is covered twice over rather than accepted: the whole
                   message is on the cell's title, and the row already opens the entry in full, selectable and
                   copyable, in the detail panel below. *@
                <div class="jim-one-line-list">
                    <span class="jim-one-line-list-value" title="@MessageTooltip(context.Item.Message)">@FlattenMessage(context.Item.Message)</span>
                    @if (!string.IsNullOrEmpty(context.Item.Exception))
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error"
                            Title="@AdminText.LogsHasException" />
                    }
                    @if (context.Item.Properties != null && context.Item.Properties.Count > 0)
                    {
                        <MudChip T="string" Variant="Variant.Text" Color="Color.Default"
                            Class="ma-0" Style="font-size: 0.7rem;">
                            @FormatCount(context.Item.Properties.Count, AdminText.LogsPropertyCountOne, AdminText.LogsPropertyCountOther)
                        </MudChip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @* An empty list means one of three things, and the message says which: the grid's live search matched
           nothing, the form filters applied by the last Refresh matched nothing, or there are simply no log
           entries to show. The filter state is the applied snapshot, because the form only applies on Refresh. *@
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@string.Format(CultureInfo.CurrentCulture, AdminText.LogsEmptySearch, grid.SearchText)"
                             SecondaryText="@CommonText.TrySearchAgain"
                             ActionText="@CommonText.ClearSearch"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else if (AppliedFiltersActive)
        {
            <TableEmptyState Icon="@Icons.Material.Filled.FilterAlt"
                             PrimaryText="@AdminText.LogsEmptyFilters"
                             SecondaryText="@AdminText.LogsEmptyFiltersHint"
                             ActionText="@AdminText.SchemaClearFilters"
                             OnAction="ClearFiltersAsync" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Custom.FileFormats.FileDocument"
                             PrimaryText="@AdminText.LogsEmptyNone"
                             SecondaryText="@AdminText.LogsEmptyNoneHint" />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@* Log Entry Detail Panel with Overlay *@
<MudOverlay @bind-Visible="_drawerOpen" DarkBackground="true" AutoClose="true" ZIndex="1250" />
<div class="jim-log-panel @(_drawerOpen ? "jim-log-panel-open" : "")">
    @if (_selectedEntry != null)
    {
        <div class="d-flex flex-column gap-4 pa-4" style="height: 100%; overflow-y: auto;">
            @* Header with close button *@
            <div class="d-flex justify-space-between align-center">
                <MudText Typo="Typo.h6">@AdminText.LogsDetailsTitle</MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@(() => _drawerOpen = false)" />
            </div>

            @* Timestamp and Level *@
            <div class="d-flex gap-4 align-center flex-wrap">
                <MudChip T="string" Size="Size.Medium" Variant="Variant.Filled" Color="@GetLevelColor(_selectedEntry.Level)">
                    @DescribeLevel(_selectedEntry.Level)
                </MudChip>
                <MudText Typo="Typo.body1" Class="jim-text-code">
                    @_selectedEntry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff")
                </MudText>
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Default">
                    @_selectedEntry.Service
                </MudChip>
            </div>

            @* Message *@
            <MudPaper Elevation="0" Class="pa-3" Outlined="true">
                <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">@AdminText.LogsColumnMessage</MudText>
                <MudText Typo="Typo.body1" Style="word-break: break-word; white-space: pre-wrap;">@_selectedEntry.Message</MudText>
            </MudPaper>

            @* Properties *@
            @if (_selectedEntry.Properties != null && _selectedEntry.Properties.Count > 0)
            {
                <MudExpansionPanels Elevation="0">
                    <MudExpansionPanel Text="@string.Format(CultureInfo.CurrentCulture, AdminText.LogsPropertiesHeading, _selectedEntry.Properties.Count)" Expanded="true">
                        <MudSimpleTable Dense="true" Hover="true" Bordered="true" Style="overflow-x: auto;">
                            <thead>
                                <tr>
                                    <th style="width: 30%;">@AdminText.LogsPropertyKey</th>
                                    <th>@AdminText.SettingsColumnValue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prop in _selectedEntry.Properties)
                                {
                                    <tr>
                                        <td class="jim-text-code">@prop.Key</td>
                                        <td style="word-break: break-word;">@FormatPropertyValue(prop.Value)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }

            @* Exception *@
            @if (!string.IsNullOrEmpty(_selectedEntry.Exception))
            {
                <MudExpansionPanels Elevation="0">
                    <MudExpansionPanel Expanded="true">
                        <TitleContent>
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" />
                                <MudText Color="Color.Error">@AdminText.LogsException</MudText>
                            </div>
                        </TitleContent>
                        <ChildContent>
                            <div class="d-flex justify-end mb-2">
                                <MudButton StartIcon="@Icons.Material.Filled.ContentCopy"
                                    Variant="Variant.Text" OnClick="@CopyExceptionAsync">
                                    @CommonText.Copy
                                </MudButton>
                            </div>
                            <pre class="jim-text-code" style="white-space: pre-wrap; word-break: break-word; font-size: 0.8rem; margin: 0; padding: 12px; background: var(--mud-palette-background); border-radius: 4px; overflow-x: auto;">@_selectedEntry.Exception</pre>
                        </ChildContent>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }

            @* Raw JSON *@
            <MudExpansionPanels Elevation="0">
                <MudExpansionPanel Text="@AdminText.LogsRawJson">
                    <div class="d-flex justify-end mb-2">
                        <MudButton StartIcon="@Icons.Material.Filled.ContentCopy"
                            Variant="Variant.Text" OnClick="@CopyRawJsonAsync">
                            @CommonText.Copy
                        </MudButton>
                    </div>
                    <div class="jim-json-syntax">@((MarkupString)GetHighlightedJson(_selectedEntry))</div>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </div>
    }
</div>

@code {
    private VirtualisedDataGrid<LogEntry>? _grid;

    // The filter form's live values, which only take effect when Refresh applies them into the snapshot below.
    private string? _selectedService;
    private DateTime? _selectedDate;
    private IReadOnlyCollection<string> _selectedLevels = [];

    // The applied filter snapshot the window loader reads. Held separately from the form fields so a filter the
    // user has changed but not yet applied via Refresh cannot leak into windows loaded mid-scroll, which would
    // mix two different match sets in one list.
    private string? _appliedService;
    private DateTime? _appliedDate;
    private List<string> _appliedLevels = [];

    private bool _autoRefresh;
    private System.Threading.Timer? _refreshTimer;
    private bool _drawerOpen;
    private LogEntry? _selectedEntry;

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        WriteIndented = true,
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
        new(LayoutText.NavAdministration, href: "/admin"),
        new(AdminText.LogsPageTitle, href: null, disabled: true)
    ];

    private bool AppliedFiltersActive =>
        !string.IsNullOrEmpty(_appliedService) ||
        _appliedDate.HasValue ||
        _appliedLevels.Count > 0;

    private async Task<VirtualisedWindow<LogEntry>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        try
        {
            var result = await LogReader.GetLogEntriesRangeAsync(
                service: _appliedService,
                date: _appliedDate,
                levels: _appliedLevels,
                search: request.SearchText,
                startIndex: request.StartIndex,
                count: request.Count,
                includeTotalCount: request.IncludeTotalCount);

            return new VirtualisedWindow<LogEntry>(result.Results, result.TotalResults);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or System.Security.SecurityException)
        {
            // The log directory became unreadable (permissions, storage failure); surface it rather than leaving
            // the grid spinning, and report an empty window. Zero is only claimed when a count was asked for.
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.LogsLoadFailed, ex.Message), Severity.Error);
            return new VirtualisedWindow<LogEntry>([], request.IncludeTotalCount ? 0 : null);
        }
    }

    /// <summary>
    /// Applies the filter form into the snapshot the window loader reads, then reloads the list from the top with
    /// a fresh total: the match set may have changed, so the old count and scroll position no longer describe it.
    /// </summary>
    private async Task RefreshAsync()
    {
        _appliedService = _selectedService;
        _appliedDate = _selectedDate;
        _appliedLevels = _selectedLevels.ToList();

        if (_grid != null)
        {
            await _grid.ResetScrollAsync();
            await _grid.RefreshAsync(invalidateTotals: true);
        }
    }

    private async Task ClearFiltersAsync()
    {
        _selectedService = null;
        _selectedDate = null;
        _selectedLevels = [];
        await RefreshAsync();
    }

    private void OnAutoRefreshChanged(bool value)
    {
        _autoRefresh = value;
        UpdateAutoRefreshTimer();
    }

    private void UpdateAutoRefreshTimer()
    {
        _refreshTimer?.Dispose();
        _refreshTimer = null;

        if (_autoRefresh)
        {
            _refreshTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    // Re-run the current query (applied filters and search unchanged) so new entries appear. The
                    // scroll position is deliberately kept: yanking the reader to the top every five seconds would
                    // make the list unreadable while following an investigation.
                    if (_grid != null)
                        await _grid.RefreshAsync(invalidateTotals: true);
                    StateHasChanged();
                });
            }, null, TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
        }
    }

    private void HandleRowClicked(LogEntry item)
    {
        _selectedEntry = item;
        _drawerOpen = true;
    }

    private static string FormatCount(int count, string one, string other) =>
        string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(count, one, other), count);

    /// <summary>
    /// The log level's name for a reader. A level the portal does not recognise is shown as it was written.
    /// </summary>
    private static string DescribeLevel(string level) => level switch
    {
        "Verbose" => AdminText.LogsLevelVerbose,
        "Debug" => AdminText.LogsLevelDebug,
        "Information" => AdminText.LogsLevelInformation,
        "Warning" => AdminText.LogsLevelWarning,
        "Error" => AdminText.LogsLevelError,
        "Fatal" => AdminText.LogsLevelFatal,
        _ => level
    };

    private static Color GetLevelColor(string level)
    {
        return level switch
        {
            "Verbose" => Color.Default,
            "Debug" => Color.Default,
            "Information" => Color.Info,
            "Warning" => Color.Warning,
            "Error" => Color.Error,
            "Fatal" => Color.Error,
            _ => Color.Default
        };
    }

    private static string GetSelectedLevelsText(IReadOnlyList<string> selectedLevels)
    {
        if (selectedLevels == null || selectedLevels.Count == 0)
            return string.Empty;

        if (selectedLevels.Count == 1)
            return selectedLevels[0];

        if (selectedLevels.Count == 6)
            return AdminText.LogsAllLevels;

        return FormatCount(selectedLevels.Count, AdminText.LogsLevelCountOne, AdminText.LogsLevelCountOther);
    }

    private static string GetRowStyle(LogEntry entry)
    {
        // Use only a coloured left border as indicator - keeps text readable in both light/dark modes
        return entry.Level switch
        {
            "Error" or "Fatal" => "border-left: 4px solid var(--mud-palette-error);",
            "Warning" => "border-left: 4px solid var(--mud-palette-warning);",
            "Information" => "border-left: 4px solid var(--mud-palette-info);",
            _ => "border-left: 4px solid transparent;"
        };
    }

    private static string TruncateValue(string value, int maxLength)
    {
        if (string.IsNullOrEmpty(value) || value.Length <= maxLength)
            return value;
        return value[..maxLength] + "...";
    }

    /// <summary>
    /// The message as one line: a multi-line message would otherwise be as tall as it liked in a grid whose
    /// virtualiser positions every row from one fixed height. The width is left to the cell, which clips with an
    /// ellipsis; truncating here as well would print a second ellipsis inside the first.
    /// </summary>
    private static string FlattenMessage(string message)
    {
        if (string.IsNullOrEmpty(message))
            return message;

        return message.Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ");
    }

    /// <summary>
    /// What hovering the message reveals. Capped, because a hover is for reading the rest of a line rather than
    /// a stack of them, and the row already opens the whole entry (message, exception, properties, raw JSON) in
    /// the detail panel, where it can be selected and copied.
    /// </summary>
    private static string MessageTooltip(string message) => TruncateValue(FlattenMessage(message), 500);

    private static string FormatPropertyValue(object? value)
    {
        if (value == null)
            return "null";

        // If it's a complex object (already parsed as JsonElement), format it nicely
        if (value is JsonElement jsonElement)
        {
            return jsonElement.ValueKind switch
            {
                JsonValueKind.String => jsonElement.GetString() ?? "null",
                JsonValueKind.Number => jsonElement.ToString(),
                JsonValueKind.True => "true",
                JsonValueKind.False => "false",
                JsonValueKind.Null => "null",
                _ => jsonElement.ToString()
            };
        }

        return value.ToString() ?? "null";
    }

    private static string GetRawJson(LogEntry entry)
    {
        var jsonObject = new Dictionary<string, object?>
        {
            ["@t"] = entry.Timestamp.ToString("O"),
            ["@l"] = entry.Level,
            ["@m"] = entry.Message
        };

        if (!string.IsNullOrEmpty(entry.Exception))
            jsonObject["@x"] = entry.Exception;

        if (entry.Properties != null)
        {
            foreach (var prop in entry.Properties)
            {
                jsonObject[prop.Key] = prop.Value;
            }
        }

        return JsonSerializer.Serialize(jsonObject, JsonOptions);
    }

    private static string GetHighlightedJson(LogEntry entry)
    {
        var json = GetRawJson(entry);
        return Helpers.HighlightJson(json);
    }

    private async Task CopyRawJsonAsync()
    {
        if (_selectedEntry == null)
            return;

        var json = GetRawJson(_selectedEntry);
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", json);
        Snackbar.Add(AdminText.LogsCopiedToClipboard, Severity.Success);
    }

    private async Task CopyExceptionAsync()
    {
        if (_selectedEntry?.Exception == null)
            return;

        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _selectedEntry.Exception);
        Snackbar.Add(AdminText.LogsCopiedToClipboard, Severity.Success);
    }

    public ValueTask DisposeAsync()
    {
        _refreshTimer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
