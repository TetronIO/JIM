@* The shared event card (this run's events on the Lineage): a tone-accented card with an icon tile,
   the plain-language title with the technical label demoted alongside (swapped when the
   technical-names toggle is on), an optional contextual detail message, entity chips, an attention
   badge, and a footer carrying the attribute count plus up to two action links. Each entity is
   named exactly once (as a chip or a footer link); a lineage column's head already names the owning
   system, so its cards suppress the system chip via HideSystemChip. Cards with attribute detail are
   clickable and keyboard operable (role button, tabbable, Enter/Space) to open the shared attribute
   drawer. Where a caller passes Operation (the Lineage view only, #1495 follow-up), the card leads
   with the same tone-tinted operation chip a chain card carries, in the same first-child position;
   the Timeline does not pass it, so its own row markup is unaffected. *@

<div class="evt-card @(IsClickable ? "clickable" : null) @(Selected ? "selected" : null)"
     style="--tone: @CausalityToneCss.CssVar(Event.Tone)"
     role="@(IsClickable ? "button" : null)" tabindex="@(IsClickable ? "0" : null)"
     aria-label="@(IsClickable ? $"{Title}: show attribute detail" : null)"
     @onclick="HandleActivationAsync" @onkeydown="HandleKeyDownAsync">
    @if (Operation is { } operation)
    {
        @* The chip's own tone can differ from the card's (an Info-toned Attribute Flow update inside
           an otherwise Primary-toned card, for instance), so it carries its own --tone/--tone-text
           rather than relying on the card root's, which stays the event's own tone for the icon tile
           and badge above. *@
        <span class="ln-op" style="--tone: @CausalityToneCss.CssVar(operation.Tone); --tone-text: @CausalityToneCss.TextCssVar(operation.Tone)">
            <MudIcon Icon="@operation.Icon" />
            @(TechnicalNames ? operation.TechnicalLabel : operation.PlainLabel)
        </span>
    }
    <div class="evt-head">
        <span class="evt-icon" aria-hidden="true">
            <MudIcon Icon="@Event.Icon" />
        </span>
        <span class="evt-title">@Title</span>
        @if (Event.Badge != null)
        {
            <span class="evt-badge">@Event.Badge</span>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Event.DetailMessage))
    {
        <div class="evt-sub">@Event.DetailMessage</div>
    }
    @{
        var chipLinks = Event.Links
            .Where(l => ChipKinds.Contains(l.Kind))
            .Where(l => !(HideSystemChip && l.Kind == CausalityEntityKind.ConnectedSystem))
            .ToList();
        var actionLinks = Event.Links
            .Where(l => !ChipKinds.Contains(l.Kind) && !string.IsNullOrEmpty(l.Href))
            .Take(2)
            .ToList();
    }
    @if (chipLinks.Count > 0)
    {
        <div class="evt-entities">
            @foreach (var link in chipLinks)
            {
                <CausalityEntityChip Label="@link.Label" Href="@link.Href" Kind="link.Kind" />
            }
        </div>
    }
    @if (Event.AttributeRows.Count > 0 || actionLinks.Count > 0)
    {
        <div class="evt-foot">
            @if (Event.AttributeRows.Count > 0)
            {
                @* A queued deprovision's rows identify the target rather than change it, so it says what
                   they are instead of counting them; see CausalityEvent.AttributeRowsCaption. *@
                <span class="attr-count">
                    <MudIcon Icon="@Icons.Material.Filled.TableChart" aria-hidden="true" />
                    @(Event.AttributeRowsCaption
                      ?? $"{Event.AttributeRows.Count} attribute{(Event.AttributeRows.Count == 1 ? "" : "s")}")
                </span>
            }
            <span class="spacer"></span>
            @foreach (var link in actionLinks)
            {
                <a href="@link.Href">@link.Label</a>
            }
        </div>
    }
</div>

@code {
    /// <summary>
    /// The kinds rendered as entity chips; the remaining linked kinds render in the footer's action
    /// links (mirroring the Timeline view's split).
    /// </summary>
    private static readonly CausalityEntityKind[] ChipKinds =
    [
        CausalityEntityKind.ConnectedSystem,
        CausalityEntityKind.Record,
        CausalityEntityKind.Identity,
        CausalityEntityKind.SynchronisationRule
    ];

    /// <summary>
    /// The causality event to render.
    /// </summary>
    [Parameter, EditorRequired]
    public CausalityEvent Event { get; set; } = null!;

    /// <summary>
    /// When true, technical labels (MVO/CSO vocabulary) are emphasised and plain language demoted.
    /// </summary>
    [Parameter]
    public bool TechnicalNames { get; set; }

    /// <summary>
    /// Whether this card is the currently selected one.
    /// </summary>
    [Parameter]
    public bool Selected { get; set; }

    /// <summary>
    /// When true, the owning Connected System's chip is suppressed (a lineage column's head already
    /// names the system, so repeating it on every card in the column is redundant).
    /// </summary>
    [Parameter]
    public bool HideSystemChip { get; set; }

    /// <summary>
    /// The operation chip to lead the card with (#1495 follow-up), or null to render no chip at all.
    /// Deliberately a separate parameter rather than the card reading <see cref="CausalityEvent.Operation"/>
    /// off <see cref="Event"/> itself: the Lineage view is the only caller that passes it, so the
    /// Timeline (which never sets this parameter) renders identically to before this feature existed,
    /// even though its events carry the same populated <c>Operation</c> on the shared model.
    /// </summary>
    [Parameter]
    public OutcomeDisplay? Operation { get; set; }

    /// <summary>
    /// Raised when a clickable card is activated (click, Enter or Space).
    /// </summary>
    [Parameter]
    public EventCallback<CausalityEvent> OnSelect { get; set; }

    /// <summary>
    /// The event's name in the vocabulary the reader has asked for, and only that one. The card used to
    /// render both labels always and merely swap which was emphasised, so "CSO Joined" and "MVO Attribute
    /// Flow" sat on every card with the technical-names toggle off: a control that governs a vocabulary
    /// has to be able to remove it, or its label is not true. The summary band and the attribute drawer
    /// already showed one or the other, so the cards were the anomaly rather than the design.
    /// </summary>
    private string Title => TechnicalNames ? Event.TechnicalLabel : Event.PlainLabel;

    private bool IsClickable => Event.AttributeRows.Count > 0 && OnSelect.HasDelegate;

    private Task HandleActivationAsync()
    {
        return IsClickable ? OnSelect.InvokeAsync(Event) : Task.CompletedTask;
    }

    private Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        return args.Key is "Enter" or " " or "Spacebar"
            ? HandleActivationAsync()
            : Task.CompletedTask;
    }
}
