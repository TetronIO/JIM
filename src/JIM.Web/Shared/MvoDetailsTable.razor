@* The Inspect view (#399, formerly "Table"): attributes with their source and history, one line per row.  *@
@* Presentational: the provenance for the object and for an opened attribute are loaded by the host        *@
@* (Pages/Types/View.razor) and handed down, so this renders from parameters alone and is bUnit-testable    *@
@* without the application layer. *@

@if (MetaverseObject != null)
{
    @if (ProvenanceLoading && Provenance == null)
    {
        <div class="d-flex justify-center pa-4">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else if (Provenance != null)
    {
        <MvoContributionBar Provenance="Provenance" ObjectTypeName="@ObjectTypeName"
                             ActiveFilterKey="@ContributionFilterKey" OnFilterChanged="OnContributionFilterChanged" />
    }

    <div class="jim-inspect-layout">
        <div class="jim-inspect-main">
            <MudPaper Class="pa-0" Outlined="true">
                <div class="d-flex align-center flex-wrap pa-2 jim-attribute-table-toolbar" style="gap: 8px;">
                    <TableDensityToggle @bind-Dense="_dense" />
                    <MudText Class="mx-2 mud-text-disabled">|</MudText>
                    <span class="jim-inspect-toolbar-label">Group by</span>
                    <SegmentedControl TValue="string" AriaLabel="Group by" Value="@GroupBy" Options="@GroupByOptions"
                                      ValueChanged="ChangeGroupByAsync" />
                </div>
                @* While the inspector is open the table lays out at fixed proportions, so a long value or origin
                   clips with an ellipsis inside its column rather than pushing the table past its panel. *@
                <MudSimpleTable Hover="true" Dense="@_dense" Elevation="0"
                                Class="@(ShowInspector ? "jim-attribute-table jim-inspect-table-narrow" : "jim-attribute-table")">
                    <thead>
                        <tr>
                            <th class="jim-attr-header-name">Attribute</th>
                            <th class="jim-attr-header-value">Value</th>
                            @if (GroupBy != "source")
                            {
                                <th class="jim-attr-header-source">Source</th>
                            }
                            @* Type and Plurality give way while the inspector is open: its header states both for
                               the selected attribute, and the Value column needs the width more. *@
                            @if (!ShowInspector)
                            {
                                <th class="jim-attr-header-type">Type</th>
                                <th class="jim-attr-header-plurality">Plurality</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rows = GetVisibleRows(); }
                        @if (rows.Count == 0)
                        {
                            <tr>
                                <td colspan="@ColumnCount" class="text-center pa-4">
                                    <MudText Typo="Typo.body1" Class="mud-text-secondary">No attributes to display</MudText>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in rows)
                            {
                                @if (row.IsHeader)
                                {
                                    <tr class="jim-inspect-group-header">
                                        <td colspan="@ColumnCount">
                                            @if (row.HeaderIcon != null)
                                            {
                                                <MudIcon Icon="@row.HeaderIcon" Size="Size.Small" Class="me-2" />
                                            }
                                            @if (row.HeaderLabel != null)
                                            {
                                                <span>@row.HeaderLabel</span>
                                            }
                                            else
                                            {
                                                @* Group by Source: the header names the source exactly as the Source
                                                   column it replaces does (the bar's swatch and legend label), with
                                                   the rule beside it; the inspector, which any row beneath it
                                                   opens, carries the links. *@
                                                <SourceDot Group="@(row.HeaderSource!)" ShowRule="true" />
                                            }
                                            <span class="jim-inspect-group-count">@row.HeaderCount attribute@(row.HeaderCount == 1 ? "" : "s")</span>
                                        </td>
                                    </tr>
                                }
                                else if (row.Group != null)
                                {
                                    var group = row.Group;
                                    var isSelected = SelectedAttributeId == group.AttributeId;
                                    @* The row's @onclick is a mouse convenience only; the real, keyboard-accessible
                                       affordance is the attribute-name button below (a <tr> containing links
                                       cannot itself be a button, and nested interactive content inside role="button"
                                       is invalid). The Value cell can carry its own link (an email address, a
                                       reference value), so its content stops the click reaching this row's
                                       convenience handler. The Source cell is linkless (its compact chip leaves
                                       the links to the inspector), so a click there opens the inspector too. *@
                                    <tr @key="group.AttributeName"
                                        class="jim-inspect-row @(group.Values.Count > 1 ? "jim-attr-row-mva" : "") @(isSelected ? "jim-inspect-row-selected" : "")"
                                        @onclick="@(() => SelectAttributeAsync(group.AttributeId))">
                                        <td class="jim-attr-name">
                                            <button type="button" class="jim-attr-name-button mud-text-secondary"
                                                    aria-expanded="@(isSelected ? "true" : "false")"
                                                    @onclick="@(() => SelectAttributeAsync(group.AttributeId))"
                                                    @onclick:stopPropagation="true">@group.AttributeName</button>
                                        </td>
                                        <td class="jim-attr-value">
                                            <div class="@(group.Values.Count == 1 ? "jim-inspect-value" : null)" title="@ValueTitle(group)"
                                                 @onclick:stopPropagation="true">@RenderValueCell(group)</div>
                                        </td>
                                        @if (GroupBy != "source")
                                        {
                                            <td>
                                                <div class="jim-inspect-source-cell">@RenderSourceCell(group.AttributeId)</div>
                                            </td>
                                        }
                                        @if (!ShowInspector)
                                        {
                                            <td class="jim-attr-type">
                                                <MudText Typo="Typo.body1" Class="mud-text-secondary">@group.Values[0].Attribute.Type</MudText>
                                            </td>
                                            <td class="jim-attr-plurality">
                                                <MudText Typo="Typo.body1" Class="mud-text-secondary">@(group.IsMultiValued ? "Multi" : "Single")</MudText>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        </div>

        @if (ShowInspector)
        {
            <div class="jim-inspect-side">
                @if (AttributeInspectorLoading && SelectedAttributeProvenance == null)
                {
                    <MudPaper Outlined="true" Class="pa-4 d-flex justify-center">
                        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
                    </MudPaper>
                }
                else if (SelectedAttributeProvenance != null)
                {
                    <MvoAttributeInspector Provenance="SelectedAttributeProvenance" OnClose="OnCloseInspector" OnOpenInTimeline="OnOpenInTimeline" />
                }
            </div>
        }
    </div>
}

@code {
    // ─── Render Fragments ───
    // RenderValue lives here (a @code method), not in a markup @{ } block: it is called both from markup
    // (RenderValueCell) and, indirectly, needs to be reachable from that method, and a local function declared
    // inside the component's BuildRenderTree (a markup @{ } block) is not visible to an ordinary @code method.

    private RenderFragment RenderValue(MetaverseObjectAttributeValue attributeValue) => __builder =>
    {
        if (attributeValue.Attribute.Type == AttributeDataType.Text)
        {
            if (attributeValue.Attribute.Name == Constants.BuiltInAttributes.Email && !string.IsNullOrEmpty(attributeValue.StringValue))
            {
                <MudLink Href="@($"mailto:{attributeValue.StringValue}")" Class="jim-text-code">@attributeValue.StringValue</MudLink>
            }
            else
            {
                <TextValueDisplay Value="@attributeValue.StringValue" Class="jim-text-code" />
            }
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Number)
        {
            <span class="jim-text-code">@attributeValue.IntValue</span>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.LongNumber)
        {
            <span class="jim-text-code">@attributeValue.LongValue</span>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Decimal)
        {
            <span class="jim-text-code">@attributeValue.DecimalValue?.ToString(CultureInfo.InvariantCulture)</span>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.DateTime && attributeValue.DateTimeValue.HasValue)
        {
            var dateTimeValue = attributeValue.DateTimeValue.Value;
            <MudTooltip Text="@dateTimeValue.ToString("O")" Arrow="true" Placement="Placement.Top">
                <ChildContent>
                    @dateTimeValue.ToFriendlyDate()
                </ChildContent>
            </MudTooltip>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Guid)
        {
            <span class="jim-text-code">@attributeValue.GuidValue?.ToString()</span>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Boolean && attributeValue.BoolValue.HasValue)
        {
            @* Local capture: CodeQL does not read the HasValue guard above as establishing null-state
               for a dereference in markup (JIM.Web/CLAUDE.md, "Nullable dereference in Razor"). *@
            var boolValue = attributeValue.BoolValue.Value;
            <BooleanValue Value="@boolValue" />
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Binary && attributeValue.ByteValue != null)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@attributeValue.ByteValue.Length bytes</MudChip>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Reference && attributeValue.ReferenceValue != null)
        {
            <MudChip T="string" Color="Color.Default">@attributeValue.ReferenceValue.Type?.Name</MudChip>
            <MudLink Href="@Utilities.GetMetaverseObjectHref(attributeValue.ReferenceValue)">
                @(attributeValue.ReferenceValue.NameOrId ?? attributeValue.ReferenceValue.Id.ToString())
            </MudLink>
        }
        else
        {
            <EmptyValue />
        }
    };

    /// <summary>The Metaverse Object whose attributes to display.</summary>
    [Parameter, EditorRequired]
    public MetaverseObject MetaverseObject { get; set; } = null!;

    /// <summary>The Metaverse Object Type's name, passed through to the contribution bar's heading.</summary>
    [Parameter]
    public string ObjectTypeName { get; set; } = "object";

    /// <summary>Per-attribute total value counts from the capped load.</summary>
    [Parameter]
    public Dictionary<string, int> AttributeValueTotalCounts { get; set; } = new();

    /// <summary>The object's attribute origins (#399), loaded by the host when this view is shown. Null while loading.</summary>
    [Parameter]
    public MetaverseObjectProvenance? Provenance { get; set; }

    /// <summary>
    /// Generated-value assignments for this Metaverse Object (Unique Value Generation, #242, Phase 3, Work
    /// Package D2), keyed by attribute name. Loaded by the host with the provenance, like everything else this
    /// component shows, so it stays a presentational renderer of its parameters.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<string, GeneratedValueAssignmentHeader> GeneratedValueAssignments { get; set; } =
        new Dictionary<string, GeneratedValueAssignmentHeader>();

    /// <summary>Whether the host is loading <see cref="Provenance"/>.</summary>
    [Parameter]
    public bool ProvenanceLoading { get; set; }

    /// <summary>"none", "source" or "category".</summary>
    [Parameter]
    public string GroupBy { get; set; } = "none";

    [Parameter]
    public EventCallback<string> OnGroupByChanged { get; set; }

    /// <summary>The active source filter's group key (from the contribution bar's legend), or null.</summary>
    [Parameter]
    public string? ContributionFilterKey { get; set; }

    [Parameter]
    public EventCallback<string?> OnContributionFilterChanged { get; set; }

    /// <summary>The attribute id whose inspector is open, or null.</summary>
    [Parameter]
    public int? SelectedAttributeId { get; set; }

    [Parameter]
    public EventCallback<int> OnAttributeSelected { get; set; }

    /// <summary>The opened attribute's full provenance (#399), loaded by the host. Null while loading or when none is open.</summary>
    [Parameter]
    public MetaverseAttributeProvenance? SelectedAttributeProvenance { get; set; }

    [Parameter]
    public bool AttributeInspectorLoading { get; set; }

    [Parameter]
    public EventCallback OnCloseInspector { get; set; }

    [Parameter]
    public EventCallback OnOpenInTimeline { get; set; }

    /// <summary>Maximum number of multi-valued attribute values to show inline before falling back to <see cref="MvoMvaTable"/>.</summary>
    private const int MvaInlineThreshold = 10;

    private bool _dense;
    private bool _preferencesLoaded;

    private bool ShowInspector => SelectedAttributeId.HasValue;

    /// <summary>
    /// How many columns the header renders (Attribute and Value, plus Source unless grouped by it, plus Type and
    /// Plurality unless the inspector is open). Full-width rows span exactly this many: a wider colspan makes the
    /// browser invent empty columns, which render as a dead band down the right of the table.
    /// </summary>
    private int ColumnCount => 2 + (GroupBy != "source" ? 1 : 0) + (ShowInspector ? 0 : 2);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_preferencesLoaded)
        {
            try
            {
                _dense = await PreferenceService.GetTableDenseAsync() == true;
                _preferencesLoaded = true;
                StateHasChanged();
            }
            catch (InvalidOperationException)
            {
                // JS interop not yet available, will retry on next render
            }
        }
    }

    private static readonly IReadOnlyList<SegmentedOption<string>> GroupByOptions =
    [
        new("none", "None"),
        new("source", "Source"),
        new("category", "Category")
    ];

    /// <summary>
    /// The full text of a single value, for the title of its one-line cell (which clips a long value with an
    /// ellipsis). Null for multi-valued attributes and for types that render their own affordance (a date's
    /// tooltip, a reference's link, a Boolean's label), where there is nothing clipped to reveal.
    /// </summary>
    private static string? ValueTitle(MvoAttributeTableGroup group)
    {
        if (group.Values.Count != 1)
            return null;

        var value = group.Values[0];
        return value.Attribute.Type switch
        {
            AttributeDataType.Text => string.IsNullOrWhiteSpace(value.StringValue) ? null : value.StringValue,
            AttributeDataType.Guid => value.GuidValue?.ToString(),
            _ => null
        };
    }

    private async Task ChangeGroupByAsync(string groupBy)
    {
        if (groupBy == GroupBy)
            return;
        await OnGroupByChanged.InvokeAsync(groupBy);
    }

    private async Task SelectAttributeAsync(int attributeId)
    {
        await OnAttributeSelected.InvokeAsync(attributeId);
    }

    private record MvoAttributeTableGroup(
        int AttributeId,
        string AttributeName,
        List<MetaverseObjectAttributeValue> Values,
        bool IsMultiValued,
        int TotalCount,
        bool IsReference);

    /// <summary>
    /// One row the table renders: either an attribute row (<see cref="Group"/> set) or a group header (Source or
    /// Category grouping). A category header carries <see cref="HeaderLabel"/>/<see cref="HeaderIcon"/>; a source
    /// header instead carries the contribution bar's own group for the source (<see cref="HeaderSource"/>), so it
    /// is labelled and coloured exactly as the bar's key labels and colours it.
    /// </summary>
    private sealed record TableRow(
        MvoAttributeTableGroup? Group,
        string? HeaderLabel = null,
        string? HeaderIcon = null,
        int HeaderCount = 0,
        ValueOriginGrouping.Group? HeaderSource = null)
    {
        public bool IsHeader => Group == null;
    }

    private List<MvoAttributeTableGroup> GetGroupedAttributes()
    {
        if (MetaverseObject?.AttributeValues == null)
            return [];

        return MetaverseObject.AttributeValues
            .GroupBy(v => v.Attribute.Name)
            .OrderBy(g => g.Key)
            .Select(g =>
            {
                var values = g.ToList();
                var totalCount = AttributeValueTotalCounts.GetValueOrDefault(g.Key, values.Count);
                var isReference = values.Any(v => v.ReferenceValue != null);
                return new MvoAttributeTableGroup(
                    g.First().Attribute.Id,
                    g.Key,
                    values,
                    g.First().Attribute.AttributePlurality == AttributePlurality.MultiValued,
                    totalCount,
                    isReference);
            })
            .ToList();
    }

    /// <summary>The origin summary for one attribute, or null when none was recorded for it (provenance not loaded, or not returned).</summary>
    private MetaverseAttributeOriginSummary? OriginFor(int attributeId) =>
        Provenance?.Attributes.FirstOrDefault(a => a.AttributeId == attributeId);

    private MetaverseObjectProvenance? _sourceGroupsProvenance;
    private Dictionary<string, ValueOriginGrouping.Group> _sourceGroupsByKey = new();

    /// <summary>
    /// The source group an attribute belongs to, exactly as the contribution bar groups and labels it, so a row's
    /// dot and label always match the bar's legend. Groups are built once per provenance load.
    /// </summary>
    private ValueOriginGrouping.Group SourceGroupFor(int attributeId)
    {
        if (!ReferenceEquals(_sourceGroupsProvenance, Provenance))
        {
            _sourceGroupsProvenance = Provenance;
            _sourceGroupsByKey = Provenance == null
                ? new Dictionary<string, ValueOriginGrouping.Group>()
                : ValueOriginGrouping.BuildGroups(Provenance.Attributes).ToDictionary(g => g.Group.Key, g => g.Group);
        }

        var summary = OriginFor(attributeId) ?? new MetaverseAttributeOriginSummary
        {
            AttributeId = attributeId,
            AttributeName = string.Empty,
            Origins = [ValueOrigin.NotRecorded]
        };
        return _sourceGroupsByKey.TryGetValue(ValueOriginGrouping.KeyFor(summary), out var group)
            ? group
            : ValueOriginGrouping.BuildGroups([summary])[0].Group;
    }

    /// <summary>
    /// The rows to render for the current Group by mode and source filter: a flat, ordered list under "None", a
    /// header row per category under "Category", or a header row per source under "Source" (which also drops
    /// the Source column, since the header already states it).
    /// </summary>
    private List<TableRow> GetVisibleRows()
    {
        var groups = GetGroupedAttributes();

        if (ContributionFilterKey != null && Provenance != null)
        {
            groups = groups
                .Where(g => OriginFor(g.AttributeId) is { } origin && ValueOriginGrouping.KeyFor(origin) == ContributionFilterKey)
                .ToList();
        }

        if (GroupBy == "category")
        {
            var byCategory = groups.ToLookup(g => AttributeCategories.GetCategory(g.AttributeName));
            var rows = new List<TableRow>();
            foreach (var category in AttributeCategories.CategoryOrder.Where(c => byCategory[c].Any()))
            {
                var inCategory = byCategory[category].ToList();
                rows.Add(new TableRow(null, category, AttributeCategories.GetIcon(category), inCategory.Count));
                rows.AddRange(inCategory.Select(g => new TableRow(g)));
            }
            return rows;
        }

        if (GroupBy == "source" && Provenance != null)
        {
            // Pair each attribute group with its origin summary (falling back to "not recorded" when the
            // provenance load returned nothing for it), so both the grouping key and the header's chip come
            // from the same source data rather than being reconstructed from a label string.
            var withOrigin = groups
                .Select(g => (Group: g, Origin: OriginFor(g.AttributeId) ?? new MetaverseAttributeOriginSummary
                {
                    AttributeId = g.AttributeId,
                    AttributeName = g.AttributeName,
                    Origins = [ValueOrigin.NotRecorded]
                }))
                .ToList();

            var orderedGroups = ValueOriginGrouping.BuildGroups(withOrigin.Select(x => x.Origin).ToList());
            var byKey = withOrigin.ToLookup(x => ValueOriginGrouping.KeyFor(x.Origin));

            var rows = new List<TableRow>();
            foreach (var (sourceGroup, count) in orderedGroups)
            {
                // Every group BuildGroups returns above came from this same withOrigin list, so its key always
                // has at least one member here; no empty-group guard is needed.
                var members = byKey[sourceGroup.Key].ToList();
                rows.Add(new TableRow(null, HeaderCount: count, HeaderSource: sourceGroup));
                rows.AddRange(members.OrderBy(m => m.Group.AttributeName).Select(m => new TableRow(m.Group)));
            }
            return rows;
        }

        return groups.Select(g => new TableRow(g)).ToList();
    }

    private RenderFragment RenderValueCell(MvoAttributeTableGroup group) => __builder =>
    {
        if (group.Values.Count == 0)
        {
            <EmptyValue />
        }
        else if (group.Values.Count == 1)
        {
            @RenderValue(group.Values[0])
            @* Unique Value Generation (#242, Phase 3, Work Package D2): a generated value only ever targets a
               single-valued attribute, so the provenance chip only ever needs to consider this branch. *@
            @if (GeneratedValueAssignments.TryGetValue(group.AttributeName, out var assignment))
            {
                <GeneratedValueProvenanceChip Assignment="assignment" Class="ml-2" />
            }
        }
        else if (group.TotalCount <= MvaInlineThreshold)
        {
            <div class="jim-attr-expanded">
                @foreach (var val in group.Values)
                {
                    <div class="jim-attr-expanded-item">
                        @RenderValue(val)
                    </div>
                }
            </div>
        }
        else
        {
            <MvoMvaTable @key="group.AttributeName"
                         AttributeName="@group.AttributeName"
                         MetaverseObjectId="@MetaverseObject.Id"
                         IsReferenceAttribute="@group.IsReference"
                         Dense="@_dense" />
        }
    };

    private RenderFragment RenderSourceCell(int attributeId) => __builder =>
    {
        if (ProvenanceLoading && Provenance == null)
        {
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        }
        else
        {
            @* A dot in the source's bar colour and its legend label: many rows name sources at once, so a column
               of pills would compete with the values. The rule reads beside it only while there is room. *@
            <SourceDot Group="@SourceGroupFor(attributeId)" ShowRule="@(!ShowInspector)" />
        }
    };
}
