@* mt-5 rather than a tab-panel padding: the Operations page hands its tabs no top padding of their own, because
   the Schedules tab opens straight onto a grid that already supplies this same gap. *@
<MudText Typo="Typo.h6" Class="mt-5 mb-1">Execute a Run Profile</MudText>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-4">Add a Synchronisation Run to the queue. If it's empty, it'll run immediately, if not, it'll run when all other queued tasks are complete.</MudText>

@if (_connectedSystemHeaders is { Count: > 0 })
{
    <MudForm>
        <MudGrid>
            <MudItem xs="12" sm="5">
                <MudSelect T="ConnectedSystemHeader" ValueChanged="HandleConnectedSystemHeaderChangedAsync" Label="Connected System" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomLeft" Required="true" RequiredError="Please select a Connected System">
                    @foreach (var connectedSystem in _connectedSystemHeaders)
                    {
                        <MudSelectItem Value="@connectedSystem" />
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudSelect T="ConnectedSystemRunProfile" @bind-Value="_selectedConnectedSystemRunProfile" Label="Run Profile" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomLeft" Required="true" RequiredError="A Run Profile is required" Disabled="@(_connectedSystemRunProfiles == null)">
                    @if (_connectedSystemRunProfiles != null)
                    {
                        @foreach (var runProfile in _connectedSystemRunProfiles)
                        {
                            <MudSelectItem Value="@runProfile" />
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-end pb-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleExecuteRunProfileSubmitAsync" DropShadow="false" FullWidth="true" Style="height: 50px;"
                           Disabled="@(_selectedConnectedSystemHeader == null || _selectedConnectedSystemRunProfile == null)">Execute</MudButton>
            </MudItem>
        </MudGrid>
    </MudForm>
}
else
{
    <MudAlert Class="my-5" Severity="Severity.Warning" Variant="Variant.Outlined">Please create a <MudLink Href="/admin/connected-systems/">Connected System</MudLink> first.</MudAlert>
}

@* Worker status bar: always present so the queue region's top block keeps a stable height as tasks move through it, rather than appearing and disappearing with the processing state *@
<div class="jim-worker-activity-bar mt-5 @(_hasProcessingTasks ? "" : "jim-worker-activity-bar--idle")">
    @if (_hasProcessingTasks)
    {
        <div class="jim-worker-activity-shimmer"></div>
    }
    <div class="jim-worker-activity-text">
        <MudIcon Icon="@Icons.Material.Filled.Memory" Size="Size.Small" />
        <span>@(_hasProcessingTasks ? "Worker processing (from top to bottom)" : "Worker idle")</span>
    </div>
</div>

@if (_workerTaskHeaders.Count == 0)
{
    <MudPaper Outlined="true" Class="pa-6 d-flex justify-center jim-queue-empty-connected">
        <MudText Class="mud-text-secondary">There are no tasks queued.</MudText>
    </MudPaper>
}
else
{
    @* One grid per Schedule Execution, plus one for everything running outside a Schedule. MudBlazor's grouping
       and its virtualisation are mutually exclusive branches of the same component, so the queue cannot be a
       single virtualised grid that also groups; a grid per group keeps both, and each grid windows only its own
       rows. They are Embedded (several to a page: no density toggle repeated per Schedule, no URL state for
       siblings to collide over), carry no search box (a box over one Schedule's handful of steps is a control
       asking to be used for no benefit) and take an explicit height ceiling, so a Schedule with twenty steps
       cannot push every other block off the page. *@
    @for (var i = 0; i < _queueGroups.Count; i++)
    {
        var group = _queueGroups[i];
        var groupKey = group.Key;
        var collapsed = _collapsedGroups.Contains(groupKey);

        @* The worker status bar above is drawn as the top of whichever block leads the queue, so the first one
           squares off its top corners and joins it. *@
        var joinsWorkerBar = i == 0;

        <div @key="groupKey" class="@(joinsWorkerBar ? "" : "mt-6")">
            @if (group.ScheduleExecutionId.HasValue)
            {
                var executionId = group.ScheduleExecutionId.Value;
                var scheduleName = group.ScheduleName ?? "Schedule";
                var processing = group.Tasks.Count(t => t.Status == WorkerTaskStatus.Processing);
                var queued = group.Tasks.Count(t => t.Status == WorkerTaskStatus.Queued);
                var waiting = group.Tasks.Count(t => t.Status == WorkerTaskStatus.WaitingForPreviousStep);
                var scheduleProgress = _scheduleProgress.GetValueOrDefault(executionId);

                <div class="jim-queue-group-header @(joinsWorkerBar ? "jim-queue-group-header--joined" : "") @(collapsed ? "jim-queue-group-header--collapsed" : "")">
                    <div class="jim-queue-group-toggle d-flex align-center gap-3" @onclick="() => ToggleGroupCollapse(groupKey)">
                        <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                        <div>
                            <MudText Typo="Typo.body1"><b>@scheduleName</b></MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                @SchedulePosition(scheduleProgress, group.Tasks.Count)@if (processing > 0)
                                {<span>, @processing processing</span>}@if (queued > 0)
                                {<span>, @queued queued</span>}@if (waiting > 0)
                                {<span>, @waiting waiting</span>}
                            </MudText>
                        </div>
                    </div>
                    <ScheduleStepRail Progress="@scheduleProgress" />

                    @* Pushed right so they land over the Actions column, in line with the per-task cancel
                       buttons in the rows below rather than adrift in the middle of the header. *@
                    <div class="jim-queue-group-actions d-flex align-center gap-2">
                        <MudTooltip Text="Open this Schedule Execution: per-step durations, errors and the Activity each step produced" Arrow="true" Placement="Placement.Top">
                            <MudButton Variant="Variant.Text" Size="Size.Small" DropShadow="false"
                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                       Href="@($"/admin/operations/schedule-executions/{executionId}")">
                                View execution
                            </MudButton>
                        </MudTooltip>
                        <MudTooltip Text="Cancel Schedule" Arrow="true" Placement="Placement.Left">
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel" Variant="Variant.Filled" Color="Color.Error"
                                           OnClick="() => HandleCancelScheduleExecutionAsync(executionId)" Size="Size.Small" />
                        </MudTooltip>
                    </div>
                </div>
            }

            @if (!collapsed)
            {
                <VirtualisedDataGrid T="WorkerTaskHeader" @ref="_grids[groupKey]"
                                     ContainerId="@($"operations-queue-{groupKey}")"
                                     Embedded="true"
                                     ShowSearch="false"
                                     MaxHeight="400px"
                                     GridClass="@GroupGridClass(joinsWorkerBar || group.ScheduleExecutionId.HasValue)"
                                     DefaultSortBy="step"
                                     LoadWindow="@((request, _) => LoadGroupWindowAsync(groupKey, request))"
                                     SingularName="Worker Task"
                                     PluralName="Worker Tasks">
                    <Columns>
                        @* A task outside a Schedule has no step, so its grid does not carry a column of blanks. *@
                        @if (group.ScheduleExecutionId.HasValue)
                        {
                            <TemplateColumn T="WorkerTaskHeader" Title="Step" Sortable="false" HeaderStyle="width: 70px;">
                                <HeaderTemplate>
                                    <MudText Typo="Typo.button">Step</MudText>
                                </HeaderTemplate>
                                <CellTemplate>
                                    @{ var task = context.Item; }
                                    @if (task.ScheduleExecutionId.HasValue)
                                    {
                                        var stepDisplay = (task.ScheduleStepIndex ?? 0) + 1;
                                        @if (IsParallelStep(task))
                                        {
                                            <MudTooltip Text="Parallel step: runs concurrently with other tasks in this step" Arrow="true" Placement="Placement.Right">
                                                <div class="d-flex align-center gap-1">
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@stepDisplay</MudText>
                                                    <MudIcon Icon="@Icons.Material.Filled.CallSplit" Size="Size.Small" Class="mud-text-secondary" Style="font-size: 0.875rem;" />
                                                </div>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@stepDisplay</MudText>
                                        }
                                    }
                                </CellTemplate>
                            </TemplateColumn>
                        }
                        <TemplateColumn T="WorkerTaskHeader" Title="Name" Sortable="false">
                            <HeaderTemplate>
                                <MudText Typo="Typo.button">Name</MudText>
                            </HeaderTemplate>
                            <CellTemplate>
                                @{ var task = context.Item; }
                                @if (task.ActivityId.HasValue)
                                {
                                    var activityId = task.ActivityId.Value;
                                    <MudLink Href="@($"/activity/{activityId}?from=operations")">@task.Name</MudLink>
                                }
                                else
                                {
                                    @task.Name
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="WorkerTaskHeader" Title="Status" Sortable="false">
                            <HeaderTemplate>
                                <MudText Typo="Typo.button">Status</MudText>
                            </HeaderTemplate>
                            <CellTemplate>
                                <MudChip T="string" Variant="Variant.Text" Color="GetTaskStatusColor(context.Item.Status)" Class="ml-0">@GetTaskStatusDisplay(context.Item)</MudChip>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="WorkerTaskHeader" Title="Progress" Sortable="false" HeaderStyle="min-width: 200px;">
                            <HeaderTemplate>
                                <MudText Typo="Typo.button">Progress</MudText>
                            </HeaderTemplate>
                            <CellTemplate>
                                @{ var task = context.Item; }
                                <WorkerTaskProgress Status="@task.Status" ObjectsToProcess="@task.ObjectsToProcess" ObjectsProcessed="@task.ObjectsProcessed" ProgressMessage="@task.ProgressMessage" Steps="@task.Steps" />
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="WorkerTaskHeader" Title="Initiated By" Sortable="false">
                            <HeaderTemplate>
                                <MudText Typo="Typo.button">Initiated By</MudText>
                            </HeaderTemplate>
                            <CellTemplate>
                                @{ var task = context.Item; }
                                @if (task.InitiatedByType == ActivityInitiatorType.User)
                                {
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-1" />
                                        <AuditPrincipalLink PrincipalType="task.InitiatedByType" PrincipalId="task.InitiatedById" PrincipalName="@task.InitiatedByName" />
                                    </div>
                                }
                                else if (task.InitiatedByType == ActivityInitiatorType.ApiKey)
                                {
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Key" Class="mr-1" />
                                        <AuditPrincipalLink PrincipalType="task.InitiatedByType" PrincipalId="task.InitiatedById" PrincipalName="@task.InitiatedByName" />
                                    </div>
                                }
                                else if (task.InitiatedByType == ActivityInitiatorType.System)
                                {
                                    <div class="d-flex align-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mr-1" />
                                        <span>@(task.InitiatedByName ?? "Scheduler")</span>
                                    </div>
                                }
                                else if (!string.IsNullOrEmpty(task.InitiatedByName))
                                {
                                    <span>@task.InitiatedByName</span>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn T="WorkerTaskHeader" Title="Actions" Sortable="false"
                                        HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                            <HeaderTemplate>
                                <MudText Typo="Typo.button">Actions</MudText>
                            </HeaderTemplate>
                            <CellTemplate>
                                @{ var task = context.Item; }
                                @if (task.Status != WorkerTaskStatus.WaitingForPreviousStep)
                                {
                                    <MudTooltip Text="Cancel Task" Arrow="true" Placement="Placement.Left">
                                        <MudIconButton Icon="@Icons.Material.Filled.Cancel" Variant="Variant.Filled" Color="Color.Error" OnClick="() => HandleCancelTaskAsync(task)" Size="Size.Small" />
                                    </MudTooltip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                </VirtualisedDataGrid>
            }
        </div>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<ConnectedSystemHeader>? _connectedSystemHeaders;
    private List<ConnectedSystemRunProfile>? _connectedSystemRunProfiles;
    private ConnectedSystemHeader? _selectedConnectedSystemHeader;
    private ConnectedSystemRunProfile? _selectedConnectedSystemRunProfile;
    private List<WorkerTaskHeader> _workerTaskHeaders = new();
    private readonly CancellationTokenSource _pollingCancellationTokenSource = new();
    private readonly SemaphoreSlim _refreshLock = new(1, 1);
    private bool _hasProcessingTasks;
    private readonly HashSet<string> _collapsedGroups = new();

    /// <summary>
    /// Each Schedule Execution in the queue, reduced to the shape its group header draws (#1162).
    /// Kept beside the task headers rather than derived in markup: it needs the steps whose tasks have
    /// already been deleted, which only their Activities still record.
    /// </summary>
    private Dictionary<Guid, ScheduleExecutionProgress?> _scheduleProgress = new();

    /// <summary>
    /// The queue divided into the blocks it is drawn as: one per Schedule Execution, one for everything else.
    /// Derived from <see cref="_workerTaskHeaders"/> whenever that changes rather than in markup, because the
    /// grids' window loaders read it and must see the same grouping the render did.
    /// </summary>
    private List<WorkerTaskQueueGroup> _queueGroups = [];

    /// <summary>
    /// Each group's grid, by group key, so a queue change can tell the affected grids to re-read. A virtualised
    /// grid caches the rows it has fetched, so re-rendering the tab around one leaves its rows as they were.
    /// </summary>
    private readonly Dictionary<string, VirtualisedDataGrid<WorkerTaskHeader>> _grids = new();

    private void ToggleGroupCollapse(string groupKey)
    {
        if (!_collapsedGroups.Remove(groupKey))
            _collapsedGroups.Add(groupKey);
    }

    private bool IsParallelStep(WorkerTaskHeader task)
    {
        if (!task.ScheduleExecutionId.HasValue) return false;
        return _workerTaskHeaders.Count(t =>
            t.ScheduleExecutionId == task.ScheduleExecutionId &&
            t.ScheduleStepIndex == task.ScheduleStepIndex) > 1;
    }

    /// <summary>
    /// The queue is a live snapshot the tab already holds, so a group's window is a slice of its own tasks rather
    /// than a second read. The group is looked up by key rather than captured, so a window loaded after a refresh
    /// cannot serve the rows of a group that has since been rebuilt.
    /// </summary>
    private Task<VirtualisedWindow<WorkerTaskHeader>> LoadGroupWindowAsync(string groupKey, VirtualisedWindowRequest request)
    {
        var group = _queueGroups.FirstOrDefault(g => g.Key == groupKey);
        IEnumerable<WorkerTaskHeader> tasks = group?.Tasks ?? [];
        return Task.FromResult(tasks.ToWindow(request));
    }

    /// <summary>
    /// A grid sitting directly beneath the block above it (its Schedule Execution's header, or the worker status
    /// bar) squares off its top corners so the two read as one box; a block of its own keeps its corners.
    /// </summary>
    private static string GroupGridClass(bool joined) =>
        joined ? "jim-queue-grid jim-queue-grid--joined" : "jim-queue-grid";

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _connectedSystemHeaders = await jim.ConnectedSystems.GetConnectedSystemHeadersAsync();

        // In development, ?d=true query string activates demo mode with mock data
        if (Environment.IsDevelopment())
        {
            var uri = new Uri(NavigationManager.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            if (string.Equals(query["d"], "true", StringComparison.OrdinalIgnoreCase))
            {
                var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
                _workerTaskHeaders = GenerateDemoData(user.Id, user.NameOrId);
                _scheduleProgress = GenerateDemoScheduleProgress(_workerTaskHeaders);
                _hasProcessingTasks = _workerTaskHeaders.Any(t => t.Status == WorkerTaskStatus.Processing);
                _queueGroups = WorkerTaskQueueGroup.Build(_workerTaskHeaders);
                return;
            }
        }

        // Get initial data for worker task table rendering
        _workerTaskHeaders = await jim.Tasking.GetWorkerTaskHeadersAsync();
        _hasProcessingTasks = _workerTaskHeaders.Any(t => t.Status == WorkerTaskStatus.Processing);
        _queueGroups = WorkerTaskQueueGroup.Build(_workerTaskHeaders);
        await RefreshScheduleProgressAsync(jim);

        // Event-driven refresh (issue #307): database notifications trigger an immediate refresh, so the
        // queue reacts in real time rather than waiting for the next polling cycle.
        UiNotifications.WorkerTaskChanged += OnWorkerTaskChanged;
        UiNotifications.ActivityProgressChanged += OnActivityProgressChanged;
        UiNotifications.RealTimeAvailabilityChanged += OnRealTimeAvailabilityChanged;

        // Polling fallback: fast (1 second) while real-time notifications are unavailable, slow
        // (30 seconds, a reconciliation safety net for missed notifications) while they are flowing.
        // The interval is re-read every iteration, so availability changes take effect without
        // restarting the loop.
        var token = _pollingCancellationTokenSource.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    var delay = UiNotifications.IsRealTimeAvailable ? TimeSpan.FromSeconds(30) : TimeSpan.FromSeconds(1);
                    await Task.Delay(delay, token);
                    await RefreshWorkerTaskHeadersAsync();
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // Ignore errors during polling, will retry on next interval
                }
            }
        }, token);
    }

    /// <summary>
    /// Fetches the latest Worker Task headers and applies additions, updates and removals to the
    /// displayed list, re-rendering only when something actually changed. Serves both the polling loop
    /// and event-driven refreshes; overlapping invocations are skipped via a non-blocking semaphore.
    /// </summary>
    private async Task RefreshWorkerTaskHeadersAsync()
    {
        if (!await _refreshLock.WaitAsync(0))
            return;

        try
        {
            var stateHasChanged = false;
            using var refreshJim = JimFactory.Create();
            var newWorkerTaskHeaders = await refreshJim.Tasking.GetWorkerTaskHeadersAsync();

            // Look for additions or updates
            foreach (var newWorkerTaskHeader in newWorkerTaskHeaders)
            {
                var workerTaskHeader = _workerTaskHeaders.SingleOrDefault(q => q.Id == newWorkerTaskHeader.Id);
                if (workerTaskHeader == null)
                {
                    _workerTaskHeaders.Add(newWorkerTaskHeader);
                    stateHasChanged = true;
                }
                else if (HasWorkerTaskHeaderChanged(workerTaskHeader, newWorkerTaskHeader))
                {
                    var position = _workerTaskHeaders.IndexOf(workerTaskHeader);
                    _workerTaskHeaders.Remove(workerTaskHeader);
                    _workerTaskHeaders.Insert(position, newWorkerTaskHeader);
                    stateHasChanged = true;
                }
            }

            // Look for removals
            var workerTaskHeadersToRemove = _workerTaskHeaders.Where(sth => newWorkerTaskHeaders.All(sth2 => sth2.Id != sth.Id)).ToList();
            foreach (var workerTaskHeaderToRemove in workerTaskHeadersToRemove)
            {
                _workerTaskHeaders.Remove(workerTaskHeaderToRemove);
                stateHasChanged = true;
            }

            if (stateHasChanged)
            {
                _hasProcessingTasks = _workerTaskHeaders.Any(t => t.Status == WorkerTaskStatus.Processing);
                _queueGroups = WorkerTaskQueueGroup.Build(_workerTaskHeaders);
                await RefreshScheduleProgressAsync(refreshJim);

                // Repaint first, so a Schedule that has just joined the queue has a grid to be reloaded; then tell
                // the grids to re-read, because the rows a virtualiser holds are cached and a repaint alone leaves
                // a running step frozen at the figures it had.
                await InvokeAsync(async () =>
                {
                    StateHasChanged();
                    await RefreshQueueGridsAsync();
                });
            }
        }
        finally
        {
            _refreshLock.Release();
        }
    }

    /// <summary>
    /// Re-reads the grid of every group still on screen, invalidating its total: a group's contents changing
    /// changes how many rows it has, so the count in its toolbar and the size of its scroll area are both stale.
    /// A collapsed group has no grid to reload, and one whose Schedule has left the queue no longer has a
    /// component behind its reference, so both are skipped and the departed ones are forgotten.
    /// </summary>
    private async Task RefreshQueueGridsAsync()
    {
        foreach (var group in _queueGroups.Where(g => !_collapsedGroups.Contains(g.Key) && _grids.ContainsKey(g.Key)))
            await _grids[group.Key].RefreshAsync(invalidateTotals: true);

        var liveGroupKeys = _queueGroups.Select(g => g.Key).ToHashSet();
        foreach (var departedGroupKey in _grids.Keys.Where(key => !liveGroupKeys.Contains(key)).ToList())
            _grids.Remove(departedGroupKey);
    }

    private void OnWorkerTaskChanged(WorkerTaskChangeNotification notification) => TriggerNotificationRefresh();

    private void OnActivityProgressChanged(Guid activityId) => TriggerNotificationRefresh();

    // On reconnection, refresh immediately to reconcile anything missed while real-time was unavailable.
    private void OnRealTimeAvailabilityChanged(bool available) => TriggerNotificationRefresh();

    /// <summary>
    /// Runs a refresh in response to a notification. Event handlers run off the sync context and must
    /// never throw into the notification relay, so failures are swallowed; the polling fallback retries.
    /// </summary>
    private void TriggerNotificationRefresh()
    {
        _ = Task.Run(async () =>
        {
            try
            {
                await RefreshWorkerTaskHeadersAsync();
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // Transient refresh failures are recoverable; the polling fallback covers the gap
            }
        });
    }

    void IDisposable.Dispose()
    {
        UiNotifications.WorkerTaskChanged -= OnWorkerTaskChanged;
        UiNotifications.ActivityProgressChanged -= OnActivityProgressChanged;
        UiNotifications.RealTimeAvailabilityChanged -= OnRealTimeAvailabilityChanged;
        _pollingCancellationTokenSource.Cancel();
    }

    private async Task HandleConnectedSystemHeaderChangedAsync(ConnectedSystemHeader connectedSystemHeader)
    {
        _selectedConnectedSystemHeader = connectedSystemHeader;
        using var jim = JimFactory.Create();
        _connectedSystemRunProfiles = await jim.ConnectedSystems.GetConnectedSystemRunProfilesAsync(connectedSystemHeader.Id);
    }

    private async Task HandleExecuteRunProfileSubmitAsync()
    {
        if (_selectedConnectedSystemHeader == null || _selectedConnectedSystemRunProfile == null)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        var task = SynchronisationWorkerTask.ForUser(_selectedConnectedSystemHeader.Id, _selectedConnectedSystemRunProfile.Id, user.Id, user.NameOrId);
        var result = await jim.Tasking.CreateWorkerTaskAsync(task);

        if (!result.Success)
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to create task.", Severity.Error);
            return;
        }

        foreach (var warning in result.Warnings)
        {
            Snackbar.Add(warning, Severity.Warning);
        }

        Snackbar.Add("Synchronisation task added.", Severity.Success);
    }

    private async Task HandleCancelTaskAsync(WorkerTaskHeader workerTaskHeader)
    {
        if (workerTaskHeader == null)
            return;

        var result = await DialogService.ShowMessageBoxAsync(
            "Cancel Task",
            $"Are you sure you want to cancel the task '{workerTaskHeader.Name}'?",
            yesText: "Cancel Task",
            cancelText: "Keep Running");

        if (result != true)
            return;

        using var jim = JimFactory.Create();
        await jim.Tasking.RequestWorkerTaskCancellationAsync(workerTaskHeader.Id);
        Snackbar.Add("Worker task cancellation requested.", Severity.Success);
    }

    private async Task HandleCancelScheduleExecutionAsync(Guid scheduleExecutionId)
    {
        var scheduleName = _workerTaskHeaders
            .Where(t => t.ScheduleExecutionId == scheduleExecutionId)
            .Select(t => t.ScheduleExecutionName)
            .FirstOrDefault() ?? "this schedule execution";

        var result = await DialogService.ShowMessageBoxAsync(
            "Cancel Schedule Execution",
            $"Are you sure you want to cancel '{scheduleName}'? All tasks will be cancelled immediately, including any that are currently processing.",
            yesText: "Cancel Execution",
            cancelText: "Keep Running");

        if (result != true)
            return;

        using var jim = JimFactory.Create();
        var cancelled = await jim.Scheduler.CancelScheduleExecutionAsync(scheduleExecutionId);
        if (cancelled)
        {
            Snackbar.Add("Schedule execution cancelled.", Severity.Success);
        }
        else
        {
            Snackbar.Add("Could not cancel execution; it may have already completed.", Severity.Warning);
        }
    }

    /// <summary>
    /// The clause a group header opens with: where the Schedule has got to, or, where nothing is
    /// running, how much of it there is.
    /// </summary>
    private static string SchedulePosition(ScheduleExecutionProgress? progress, int taskCount)
    {
        if (progress == null)
            return $"{taskCount} tasks";

        return progress.CurrentStepNumber.HasValue
            ? $"Step {progress.CurrentStepNumber} of {progress.TotalSteps}"
            : $"{taskCount} tasks across {progress.TotalSteps} steps";
    }

    /// <summary>
    /// Rebuilds each Schedule Execution's shape from the queue's own tasks plus what its finished
    /// tasks left behind. One query for the whole queue, run only when the queue has actually changed.
    /// </summary>
    private async Task RefreshScheduleProgressAsync(JimApplication jim)
    {
        var executionIds = _workerTaskHeaders
            .Where(t => t.ScheduleExecutionId.HasValue)
            .Select(t => t.ScheduleExecutionId!.Value)
            .Distinct()
            .ToList();

        if (executionIds.Count == 0)
        {
            _scheduleProgress = new Dictionary<Guid, ScheduleExecutionProgress?>();
            return;
        }

        var outcomes = await jim.Activities.GetScheduleStepOutcomesAsync(executionIds);

        _scheduleProgress = executionIds.ToDictionary(
            executionId => executionId,
            executionId => ScheduleStepReading.FromQueue(
                _workerTaskHeaders.Where(t => t.ScheduleExecutionId == executionId).ToList(),
                outcomes.GetValueOrDefault(executionId, [])));
    }

    private static string GetTaskStatusDisplay(WorkerTaskHeader task)
    {
        return task.Status switch
        {
            WorkerTaskStatus.WaitingForPreviousStep => "Waiting",
            _ => task.Status.ToString().SplitOnCapitalLetters()
        };
    }

    private static Color GetTaskStatusColor(WorkerTaskStatus status) => status switch
    {
        WorkerTaskStatus.Processing => Color.Success,
        WorkerTaskStatus.CancellationRequested => Color.Warning,
        WorkerTaskStatus.Queued => Color.Info,
        _ => Color.Default
    };

