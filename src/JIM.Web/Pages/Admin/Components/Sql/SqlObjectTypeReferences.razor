@* An Object Type's references to other Object Types: one row per configured column, the foreign keys the database
   suggests as references, and an action to add a row. Shared by the card and the Add Object Type dialog. *@
@if (ObjectType.Columns != null)
{
    @foreach (var column in ObjectType.Columns)
    {
        <div class="d-flex align-center gap-2 mb-2" @key="column" data-testid="jim-sql-reference-row">
            <SqlCatalogueNameField Label="Column" Value="@column.Name" Options="@ColumnOptions"
                                   ValueChanged="@(v => SetAsync(() => column.Name = v))" Class="flex-grow-1" />
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Class="mud-text-secondary" />
            <MudSelect T="string" Label="Object Type" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1"
                       Value="@(column.ReferencesObjectType ?? string.Empty)"
                       ValueChanged="@(v => SetAsync(() => column.ReferencesObjectType = string.IsNullOrEmpty(v) ? null : v))">
                @foreach (var name in ObjectTypeNames)
                {
                    <MudSelectItem T="string" Value="@name">@name</MudSelectItem>
                }
            </MudSelect>
            <MudTooltip Text="Remove this reference" Arrow="true" Placement="Placement.Top">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" aria-label="Remove this reference"
                               OnClick="@(() => RemoveAsync(column))" />
            </MudTooltip>
        </div>
    }
}
@foreach (var suggestion in Suggestions)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="jim-sql-inline-alert mb-2" data-testid="jim-sql-reference-suggestion">
        <div class="jim-sql-inline-alert-body">
            @if (suggestion.Kind == SqlObjectTypeSuggestionKind.Reference)
            {
                <span class="jim-sql-inline-alert-text">
                    <code class="jim-code-inline">@suggestion.ColumnName</code> has a foreign key to
                    @suggestion.ReferencedObjectTypeName's anchor, so it looks like a reference to @suggestion.ReferencedObjectTypeName.
                </span>
                <span class="jim-sql-inline-alert-actions">
                    <AlertButton Severity="Severity.Info" Size="Size.Small" OnClick="@(() => OnAccept.InvokeAsync(suggestion))"
                                 data-testid="jim-sql-reference-suggestion-accept">Add reference</AlertButton>
                    <AlertButton Severity="Severity.Info" Secondary="true" Size="Size.Small" OnClick="@(() => OnDismiss.InvokeAsync(suggestion))">Dismiss</AlertButton>
                </span>
            }
            else
            {
                <span class="jim-sql-inline-alert-text">
                    <code class="jim-code-inline">@suggestion.ColumnName</code> has a foreign key to
                    <code class="jim-code-inline">@SqlObjectTypesEditorModel.Qualified(suggestion.ReferencedSchemaName, suggestion.ReferencedObjectName)</code>, which no Object Type reads from yet.
                </span>
                <span class="jim-sql-inline-alert-actions">
                    <AlertButton Severity="Severity.Info" Size="Size.Small" OnClick="@(() => OnAddObjectType.InvokeAsync(suggestion))"
                                 data-testid="jim-sql-add-object-type-suggestion-accept">Add an Object Type for it</AlertButton>
                    <AlertButton Severity="Severity.Info" Secondary="true" Size="Size.Small" OnClick="@(() => OnDismiss.InvokeAsync(suggestion))">Dismiss</AlertButton>
                </span>
            }
        </div>
    </MudAlert>
}
<MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">Add reference</MudButton>

@code {
    [Parameter, EditorRequired]
    public SqlObjectTypeDocument ObjectType { get; set; } = null!;

    /// <summary>The Object Types a column may reference.</summary>
    [Parameter]
    public IEnumerable<string> ObjectTypeNames { get; set; } = [];

    /// <summary>The source's columns, or empty where they could not be read.</summary>
    [Parameter]
    public IEnumerable<string> ColumnOptions { get; set; } = [];

    [Parameter]
    public IReadOnlyList<SqlObjectTypeSuggestion> Suggestions { get; set; } = [];

    [Parameter]
    public EventCallback<SqlObjectTypeSuggestion> OnAccept { get; set; }

    [Parameter]
    public EventCallback<SqlObjectTypeSuggestion> OnDismiss { get; set; }

    [Parameter]
    public EventCallback<SqlObjectTypeSuggestion> OnAddObjectType { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private async Task SetAsync(Action change)
    {
        change();
        await OnChanged.InvokeAsync();
    }

    private async Task AddAsync()
    {
        (ObjectType.Columns ??= []).Add(new SqlColumnDocument());
        await OnChanged.InvokeAsync();
    }

    private async Task RemoveAsync(SqlColumnDocument column)
    {
        ObjectType.Columns?.Remove(column);
        if (ObjectType.Columns is { Count: 0 })
            ObjectType.Columns = null;

        await OnChanged.InvokeAsync();
    }
}
