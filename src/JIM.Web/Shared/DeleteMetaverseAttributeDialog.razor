@using System.Globalization
@using JIM.Models.Core
@using JIM.Models.Core.DTOs
@using JIM.Utilities
@using JIM.Web.Models
@using JIM.Web.Services
@inject IJimApplicationFactory JimFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

@* Thin surface over the shared ConsequenceConfirmationDialog: this component owns evaluating the *@
@* deletion impact and performing the delete; the shared dialog owns presenting it and the consent *@
@* rules. See engineering/plans/done/CONFIGURATION_CHANGE_PREVIEW.md (Phase 2). *@

<ConsequenceConfirmationDialog Loading="@(_impact == null)"
                               LoadingText="@AdminText.DeleteEvaluatingImpact"
                               Blockers="@BuildBlockers()"
                               SafeMessage="@AdminText.DeleteAttributeSafe"
                               Consequences="@BuildConsequences()"
                               ConfirmationPhrase="@BuildConfirmationPhrase()"
                               ConfirmButtonText="@BuildConfirmButtonText()"
                               BusyText="@AdminText.DeleteBusy"
                               OnConfirmAsync="DeleteAsync" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// The attribute to delete.
    /// </summary>
    [Parameter]
    public MetaverseAttribute Attribute { get; set; } = null!;

    private AttributeDeletionImpact? _impact;

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _impact = await jim.Metaverse.EvaluateAttributeDeletionAsync(Attribute);
    }

    private IReadOnlyList<ConsequenceBlocker> BuildBlockers()
    {
        if (_impact == null)
            return [];

        var blockers = new List<ConsequenceBlocker>();

        if (_impact.BuiltIn)
        {
            blockers.Add(new ConsequenceBlocker
            {
                Headline = AdminText.DeleteAttributeBuiltInHeadline,
                Body = AdminText.DeleteAttributeBuiltInBody
            });
        }

        if (_impact.BlockedByValues)
        {
            blockers.Add(new ConsequenceBlocker
            {
                Headline = string.Format(CultureInfo.CurrentCulture, AdminText.DeleteAttributeValuesHeadline, _impact.TotalObjectsWithValues.ToString("N0", CultureInfo.CurrentCulture)),
                Items = _impact.ObjectTypeValueCounts.Select(count => new ConsequenceItem
                {
                    Text = string.Format(CultureInfo.CurrentCulture, AdminText.DeleteAttributeValueCount, count.MetaverseObjectTypeName, count.ObjectCount.ToString("N0", CultureInfo.CurrentCulture)),
                    Icon = Icons.Material.Filled.Person,
                    Href = Utilities.GetMetaverseObjectHasAttributeSearchHref(count.MetaverseObjectTypePluralName, _impact.AttributeName)
                }).ToList(),
                Body = AdminText.DeleteAttributeValuesBody
            });
        }

        if (_impact.BlockedByReaders)
        {
            blockers.Add(new ConsequenceBlocker
            {
                Headline = string.Format(CultureInfo.CurrentCulture, AdminText.DeleteAttributeReadersHeadline, _impact.Readers.Count.ToString("N0", CultureInfo.CurrentCulture)),
                Items = _impact.Readers.Select(reader => new ConsequenceItem
                {
                    Text = reader.ShowDescription(),
                    Icon = Icons.Material.Filled.Link,
                    Href = Helpers.AttributeReaderHref(reader)
                }).ToList(),
                Body = AdminText.DeleteAttributeReadersBody
            });
        }

        return blockers;
    }

    private ConsequenceGroup? BuildConsequences()
    {
        if (_impact == null || _impact.References.Count == 0)
            return null;

        return new ConsequenceGroup
        {
            Headline = string.Format(CultureInfo.CurrentCulture, AdminText.DeleteReferencesHeadline, _impact.References.Count),
            Items = _impact.References.Select(reference => new ConsequenceItem
            {
                Text = reference.Description,
                Icon = Icons.Material.Filled.Link
            }).ToList()
        };
    }

    // References present require the typed confirmation; unreferenced deletes do not.
    private string? BuildConfirmationPhrase() =>
        _impact is { RequiresConfirmation: true } ? _impact.AttributeName : null;

    private string BuildConfirmButtonText()
    {
        // A refused delete removes nothing, so its button promises nothing.
        if (_impact == null || _impact.BlockedByValues || _impact.BlockedByReaders)
            return CommonText.Delete;

        return _impact.References.Count > 0
            ? string.Format(CultureInfo.CurrentCulture, AdminText.DeleteWithReferences, _impact.References.Count)
            : CommonText.Delete;
    }

    private async Task<bool> DeleteAsync()
    {
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, CommonText.Delete);
        if (cancelled)
            return false;

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var impact = await jim.Metaverse.DeleteMetaverseAttributeWithCascadeAsync(Attribute, user, changeReason);
            if (!impact.Deleted)
            {
                Snackbar.Add(AdminText.DeleteAttributeFailedRefresh, Severity.Warning);
                return false;
            }

            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.DeleteAttributeSuccess, impact.AttributeName), Severity.Success);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.DeleteAttributeFailed, ex.ToDisplayText()), Severity.Error);
            return false;
        }

        return true;
    }

    /// <summary>
    /// Opens the delete dialog for a Metaverse Attribute. Returns true when the attribute was deleted.
    /// </summary>
    public static async Task<bool> ShowAsync(IDialogService dialogService, MetaverseAttribute attribute)
    {
        var parameters = new DialogParameters<DeleteMetaverseAttributeDialog>
        {
            { x => x.Attribute, attribute }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await dialogService.ShowAsync<DeleteMetaverseAttributeDialog>(string.Format(CultureInfo.CurrentCulture, AdminText.DeleteAttributeTitle, attribute.Name), parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: true };
    }
}
