<PageTitle>@string.Format(CultureInfo.CurrentCulture, ExampleDataText.DataGenerationTemplateTitle, _template?.Name)</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>@ExampleDataText.DataGenerationTemplateLabel</span> <span class="mud-primary-text">@_template?.Name</span>
    <PageInfo Title="@ExampleDataText.ExampleDataTemplate" DocsPage="configuration/example-data.md#templates">
        @ExampleDataText.TemplateDetailInfo
    </PageInfo>
</MudText>
<div class="d-flex justify-space-between align-center">
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
    @if (_template != null)
    {
        <AuditInfo Entity="@_template" />
    }
</div>

@if (_template != null)
{
    <NavigableMudTabs Class="mt-2" TabPanelsClass="pa-0">

        <MudTabPanel Text="@ExampleDataText.Details">
    @if (_template.BuiltIn)
    {
        <MudAlert Severity="Severity.Info" Class="mt-5">
            @ExampleDataText.BuiltInTemplateNotice
            <AlertButton Severity="Severity.Info" Class="ml-3" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="DuplicateAsync">@ExampleDataText.Duplicate</AlertButton>
        </MudAlert>
    }
    else
    {
        @* ─── Template actions ─── *@
        <div class="d-flex flex-wrap gap-2 mt-5">
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.Edit" OnClick="RenameAsync">@ExampleDataText.Rename</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Outlined.ContentCopy" OnClick="DuplicateAsync">@ExampleDataText.Duplicate</MudButton>
            <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="AddObjectTypeAsync">@ExampleDataText.AddObjectType</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Delete" OnClick="DeleteAsync">@CommonText.Delete</MudButton>
        </div>
    }

    @* One virtualised grid per Metaverse Object Type in the template. The object type's name is the heading above
       its grid rather than a toolbar title, because the grid's toolbar belongs to the density toggle, the count and
       the search box. Each grid's URL parameters are prefixed with its own object type id, so several grids on this
       page cannot overwrite each other's search, sort and scroll state. The attributes are already loaded with the
       template, so the window is sliced from memory. *@
    @foreach (var objectType in _template.ObjectTypes)
    {
        <div class="d-flex align-center gap-2 mt-5">
            <MudText Typo="Typo.h6">@objectType.MetaverseObjectType.Name</MudText>
            <MudChip T="string" Variant="Variant.Text" Color="Color.Default">@string.Format(CultureInfo.CurrentCulture, ExampleDataText.ObjectsToCreateChip, objectType.ObjectsToCreate.ToString("N0"))</MudChip>
            @if (!_template.BuiltIn)
            {
                <MudTooltip Text="@ExampleDataText.ChangeHowManyToCreate" Arrow="true" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" aria-label="@string.Format(CultureInfo.CurrentCulture, ExampleDataText.ChangeHowManyNamedToCreate, objectType.MetaverseObjectType.PluralName)"
                                   OnClick="@(() => EditObjectTypeAsync(objectType))" />
                </MudTooltip>
                <MudTooltip Text="@(_template.ObjectTypes.Count == 1 ? ExampleDataText.NeedsAtLeastOneType : ExampleDataText.RemoveFromTemplate)" Arrow="true" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Color="Color.Error" Disabled="@(_template.ObjectTypes.Count == 1)"
                                   aria-label="@string.Format(CultureInfo.CurrentCulture, ExampleDataText.RemoveNamedFromTemplate, objectType.MetaverseObjectType.Name)"
                                   OnClick="@(() => RemoveObjectTypeAsync(objectType))" />
                </MudTooltip>
            }
        </div>
        <VirtualisedDataGrid @key="objectType.Id" T="ExampleDataTemplateAttribute"
                             ContainerId="@($"template-attributes-{objectType.Id}")"
                             UrlParameterPrefix="@($"ot{objectType.Id}-")"
                             DefaultSortBy="attribute"
                             LoadWindow="@((request, token) => LoadTemplateAttributeWindowAsync(objectType, request, token))"
                             SingularName="@ExampleDataText.TemplateAttribute"
                             PluralName="@ExampleDataText.TemplateAttributes"
                             SearchPlaceholder="@ExampleDataText.SearchAttributes">
            <ToolBarExtras>
                @if (!_template.BuiltIn)
                {
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => EditAttributeAsync(objectType, null))">@ExampleDataText.AddAttribute</MudButton>
                }
            </ToolBarExtras>
            <Columns>
                <TemplateColumn Title="@ExampleDataText.Attribute" Sortable="false" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@ExampleDataText.Attribute" Name="attribute" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.MetaverseAttribute?.Name
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@CommonText.ColumnType" Sortable="false" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@CommonText.ColumnType" Name="type" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.MetaverseAttribute?.Type
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@ExampleDataText.PopulationPercentage" Sortable="false" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@ExampleDataText.PopulationPercentage" Name="population" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.PopulatedValuesPercentage
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@ExampleDataText.Rules" Sortable="false" HeaderClass="jim-fill-column" CellClass="jim-fill-column">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">@ExampleDataText.Rules</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @* A row in a virtualised grid is one line, and an attribute can carry half a dozen
                           generation rules, so the first is shown and the rest open in a dialog. Which rules an
                           attribute has is decided in GetGenerationRules rather than here, so the cell and the
                           dialog cannot draw two different sets. *@
                        <OverflowList TItem="KeyValuePair<string, string>" Items="@GetGenerationRules(context.Item)" Title="@ExampleDataText.Rules">
                            <ItemTemplate Context="rule">
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Text"><b>@string.Format(CultureInfo.CurrentCulture, ExampleDataText.RuleLabelFormat, rule.Key)</b>&nbsp;@rule.Value</MudChip>
                            </ItemTemplate>
                        </OverflowList>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@CommonText.ColumnActions" Sortable="false" Hidden="@_template.BuiltIn" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">@CommonText.ColumnActions</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        <div class="d-flex justify-end gap-2">
                            <MudTooltip Text="@CommonText.Edit" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit" Variant="Variant.Filled" Size="Size.Small"
                                               aria-label="@string.Format(CultureInfo.CurrentCulture, ExampleDataText.EditNamed, context.Item.MetaverseAttribute?.Name)"
                                               OnClick="@(() => EditAttributeAsync(objectType, context.Item))" />
                            </MudTooltip>
                            <MudTooltip Text="@CommonText.Remove" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.Delete" Variant="Variant.Filled" Size="Size.Small" Color="Color.Error"
                                               aria-label="@string.Format(CultureInfo.CurrentCulture, ExampleDataText.RemoveNamed, context.Item.MetaverseAttribute?.Name)"
                                               OnClick="@(() => RemoveAttributeAsync(objectType, context.Item))" />
                            </MudTooltip>
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@string.Format(CultureInfo.CurrentCulture, ExampleDataText.NoTemplateAttributesMatch, grid.SearchText)"
                                     SecondaryText="@CommonText.TrySearchAgain"
                                     ActionText="@CommonText.ClearSearch"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else
                {
                    @if (_template.BuiltIn)
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.Science"
                                         PrimaryText="@ExampleDataText.NoTemplateAttributesForType"
                                         SecondaryText="@ExampleDataText.NoAttributesBuiltInHint" />
                    }
                    else
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.Science"
                                         PrimaryText="@ExampleDataText.NoTemplateAttributesForType"
                                         SecondaryText="@ExampleDataText.NoAttributesHint"
                                         ActionText="@ExampleDataText.AddAttribute"
                                         OnAction="@(() => EditAttributeAsync(objectType, null))" />
                    }
                }
            </EmptyContent>
        </VirtualisedDataGrid>
    }

    <MudAlert Severity="Severity.Warning" Class="mt-6">
    <MudText Typo="Typo.h6">@ExampleDataText.Warning</MudText>
    <MudText>
        @ExampleDataText.TemplateWarning
    </MudText>
    <AlertButton Severity="Severity.Warning"
                 Class="mt-5"
                 StartIcon="@Icons.Material.Filled.BuildCircle"
                 Disabled="@(_status != null || _isExecuting)"
                 OnClick="ExecuteTemplateAsync">
        @if (_status is WorkerTaskStatus.Processing)
        {
            <text>@ExampleDataText.ProcessingEllipsis</text>
        }
        else if (_status is WorkerTaskStatus.Queued)
        {
            <text>@ExampleDataText.QueuedEllipsis</text>
        }
        else
        {
            <text>@ExampleDataText.ExecuteTemplate</text>
        }
    </AlertButton>
    </MudAlert>

    @if (_workerTask != null)
    {
        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" Class="mb-2">@ExampleDataText.DataGenerationProgress</MudText>
            <WorkerTaskProgress Status="@_workerTask.Status" ObjectsToProcess="@_workerTask.ObjectsToProcess" ObjectsProcessed="@_workerTask.ObjectsProcessed" ProgressMessage="@_workerTask.ProgressMessage" />
        </MudPaper>
    }
    else if (_completedActivity != null)
    {
        var completed = _completedActivity;
        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" Class="mb-2">@ExampleDataText.DataGenerationProgress</MudText>
            @if (completed.Status is ActivityStatus.Complete or ActivityStatus.CompleteWithWarning)
            {
                <MudProgressLinear Value="100" Color="Color.Success" Rounded="true" />
                <div class="d-flex align-center mt-3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mr-2" />
                    <MudText Typo="Typo.body2">@string.Format(CultureInfo.CurrentCulture, ExampleDataText.GenerationComplete, completed.TotalCreated.ToString("N0"))</MudText>
                </div>
                @if (completed.Status == ActivityStatus.CompleteWithWarning && !string.IsNullOrEmpty(completed.Message))
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">@completed.Message</MudText>
                }
            }
            else if (completed.Status == ActivityStatus.Cancelled)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-1">@ExampleDataText.GenerationCancelled <MudLink Href="@($"/activity/{completed.Id}")">@ExampleDataText.ViewDetails</MudLink></MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Class="mt-1">@(string.IsNullOrEmpty(completed.Message) ? ExampleDataText.GenerationFailed : string.Format(CultureInfo.CurrentCulture, ExampleDataText.GenerationFailedWithMessage, completed.Message)) <MudLink Href="@($"/activity/{completed.Id}")">@ExampleDataText.ViewDetails</MudLink></MudAlert>
            }
        </MudPaper>
    }
        </MudTabPanel>

        <MudTabPanel Text="@ExampleDataText.Changes" BadgeData="@(_changeCount > 0 ? _changeCount.ToString("N0") : null)" BadgeColor="Color.Primary">
            <ConfigurationChangesTab @key="_changeCount" TargetType="ActivityTargetType.ExampleDataTemplate" ObjectId="@_template.Id" ObjectTypeLabel="@ExampleDataText.ExampleDataTemplate" />
        </MudTabPanel>

    </NavigableMudTabs>
}

@code {
    /// <summary>
    /// The generation rules configured on one Template Attribute, as label/value pairs, in the order they read
    /// in: which rules apply depends on the Metaverse Attribute's data type, and only those actually set are
    /// returned. Built here rather than in the markup so the cell and the dialog behind its "+n more" affordance
    /// cannot draw two different sets.
    /// </summary>
    private static List<KeyValuePair<string, string>> GetGenerationRules(ExampleDataTemplateAttribute attribute)
    {
        var rules = new List<KeyValuePair<string, string>>();

        void Add(string label, string value) => rules.Add(new KeyValuePair<string, string>(label, value));

        // The condition comes first: it decides whether any of the rules below apply at all.
        if (attribute.AttributeDependency is { } dependency)
        {
            Add(ExampleDataText.RuleOnlyWhen, CriterionOperatorOptions.DescribeCondition(dependency.MetaverseAttribute.Name, dependency.ComparisonType,
                dependency.MetaverseAttribute.Type, dependency.StringValue));
        }

        switch (attribute.MetaverseAttribute?.Type)
        {
            case AttributeDataType.Text:
                if (!string.IsNullOrEmpty(attribute.Pattern))
                    Add(ExampleDataText.Pattern, attribute.Pattern);

                if (!string.IsNullOrEmpty(attribute.Expression))
                    Add(ExampleDataText.Expression, attribute.Expression);

                if (attribute.ExampleDataSetInstances is { Count: > 0 })
                    Add(ExampleDataText.RuleDataSets, string.Join(", ", attribute.ExampleDataSetInstances.Select(set => set.ExampleDataSet.Name)));

                if (attribute.MinNumber.HasValue)
                    Add(ExampleDataText.RuleMin, attribute.MinNumber.Value.ToString("N0"));

                if (attribute.MaxNumber.HasValue)
                    Add(ExampleDataText.RuleMax, attribute.MaxNumber.Value.ToString("N0"));

                if (attribute.WeightedStringValues is { Count: > 0 })
                    Add(ExampleDataText.RuleWeightedValues, string.Join(", ", attribute.WeightedStringValues.Select(wsv =>
                        string.Format(CultureInfo.CurrentCulture, ExampleDataText.WeightedValueEntry, wsv.Value, wsv.Weight))));

                break;

            case AttributeDataType.Number:
            case AttributeDataType.LongNumber:
            case AttributeDataType.Decimal:
                if (attribute.MinNumber.HasValue)
                    Add(ExampleDataText.RuleMin, attribute.MinNumber.Value.ToString("N0"));

                if (attribute.MaxNumber.HasValue)
                    Add(ExampleDataText.RuleMax, attribute.MaxNumber.Value.ToString("N0"));

                if (attribute.SequentialNumbers.HasValue)
                    Add(ExampleDataText.RuleSequential, attribute.SequentialNumbers.Value.ToString());

                if (attribute.RandomNumbers.HasValue)
                    Add(ExampleDataText.RuleRandomNumbers, attribute.RandomNumbers.Value.ToString());

                break;

            case AttributeDataType.Boolean:
                // Without a distribution the values are random, which is what an attribute with no rules already
                // reads as.
                if (attribute.BoolTrueDistribution.HasValue)
                    Add(ExampleDataText.RuleGivenTrue, string.Format(CultureInfo.CurrentCulture, ExampleDataText.Percentage, attribute.BoolTrueDistribution.Value));

                break;

            case AttributeDataType.DateTime:
                if (attribute.MinDate.HasValue)
                    Add(ExampleDataText.RuleMin, attribute.MinDate.Value.ToShortDateString());

                if (attribute.MaxDate.HasValue)
                    Add(ExampleDataText.RuleMax, attribute.MaxDate.Value.ToShortDateString());

                break;

            case AttributeDataType.Reference:
                if (attribute.MvaRefMinAssignments.HasValue)
                    Add(ExampleDataText.RuleMvaMin, attribute.MvaRefMinAssignments.Value.ToString("N0"));

                if (attribute.MvaRefMaxAssignments.HasValue)
                    Add(ExampleDataText.RuleMvaMax, attribute.MvaRefMaxAssignments.Value.ToString("N0"));

                if (attribute.ReferenceMetaverseObjectTypes is { Count: > 0 })
                    Add(ExampleDataText.RuleReferenceTypes, string.Join(", ", attribute.ReferenceMetaverseObjectTypes.Select(refType => refType.Name)));

                if (attribute.ManagerDepthPercentage.HasValue)
                    Add(ExampleDataText.RuleManagerDepth, string.Format(CultureInfo.CurrentCulture, ExampleDataText.Percentage, attribute.ManagerDepthPercentage.Value));

                break;
        }

        return rules;
    }

    [Parameter]
    public int Id { get; set; }
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private ExampleDataTemplate? _template;
    private ExampleDataTemplateWorkerTask? _task;
    private WorkerTaskHeader? _workerTask;
    private WorkerTaskStatus? _status;
    // The Activity id of the task while it is running, captured so its outcome can be shown once it completes.
    private Guid? _activeActivityId;
    // The completed Activity, left in place after the task finishes so the progress panel shows the result
    // rather than disappearing. Only set for a run observed to complete during this page session.
    private Activity? _completedActivity;
    private bool _isExecuting;
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private int _changeCount;
    private Timer? _statusPollTimer;
    private readonly SemaphoreSlim _refreshLock = new(1, 1);

    /// <summary>
    /// Slices one window of a Metaverse Object Type's Template Attributes, applying the grid's search (attribute
    /// name) and sort. The template is loaded whole with its attributes, so there is no database range read; an
    /// attribute with no Metaverse Attribute reads as an empty name for both search and sort rather than being
    /// dropped, so a malformed row stays visible to whoever has to fix it.
    /// </summary>
    private Task<VirtualisedWindow<ExampleDataTemplateAttribute>> LoadTemplateAttributeWindowAsync(
        ExampleDataObjectType objectType, VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<ExampleDataTemplateAttribute> attributes = objectType.TemplateAttributes;

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            attributes = attributes.Where(a =>
                a.MetaverseAttribute?.Name.Contains(search, StringComparison.OrdinalIgnoreCase) == true);
        }

        IOrderedEnumerable<ExampleDataTemplateAttribute> Order<TKey>(Func<ExampleDataTemplateAttribute, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? attributes.OrderByDescending(key, comparer) : attributes.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "type" => Order(a => a.MetaverseAttribute?.Type ?? AttributeDataType.NotSet),
            "population" => Order(a => a.PopulatedValuesPercentage ?? 0),
            _ => Order(a => a.MetaverseAttribute?.Name ?? string.Empty, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _template = await jim.ExampleData.GetTemplateAsync(Id);
        if (_template == null)
        {
            // template not found, redirect to index page
            NavManager.NavigateTo("../");
            return;
        }

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
            new(LayoutText.NavAdministration, href: "/admin"),
            new(ExampleDataText.ExampleData, href: "/admin/example-data/"),
            new(_template.Name, href: null, disabled: true)
        };

        _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.ExampleDataTemplate, _template.Id, 1, 1)).TotalResults;

        // Has this template already been scheduled, or is it already being processed on the service queue?
        // Event-driven refresh (issue #307): a Worker Task change notification triggers an immediate
        // status refresh, and an Activity progress notification refreshes the live progress bar as objects
        // are generated and persisted; the timer is the polling fallback, re-armed each cycle at 2 seconds
        // while real-time notifications are unavailable or 30 seconds (a reconciliation safety net) while
        // they are flowing.
        UiNotifications.WorkerTaskChanged += OnWorkerTaskChanged;
        UiNotifications.ActivityProgressChanged += OnActivityProgressChanged;
        UiNotifications.RealTimeAvailabilityChanged += OnRealTimeAvailabilityChanged;
        await RefreshWorkerTaskStatusAsync();
        _statusPollTimer = new Timer(async _ => await OnStatusPollTimerElapsedAsync(), null, GetPollingInterval(), Timeout.InfiniteTimeSpan);
    }

    /// <summary>Reloads the template after an edit: every save replaces its rows, so the page's copy is stale.</summary>
    private async Task ReloadTemplateAsync()
    {
        using var jim = JimFactory.Create();
        var template = await jim.ExampleData.GetTemplateAsync(Id);
        if (template == null)
        {
            NavManager.NavigateTo("/admin/example-data");
            return;
        }

        _template = template;
        _breadcrumbs[^1] = new BreadcrumbItem(_template.Name, href: null, disabled: true);
        _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.ExampleDataTemplate, _template.Id, 1, 1)).TotalResults;
        StateHasChanged();
    }

    private async Task RenameAsync()
    {
        if (await RenameExampleDataTemplateDialog.ShowAsync(DialogService, _template!.Id, _template.Name))
            await ReloadTemplateAsync();
    }

    private async Task DuplicateAsync()
    {
        var header = new JIM.Models.ExampleData.DTOs.ExampleDataTemplateHeader { Id = _template!.Id, Name = _template.Name, BuiltIn = _template.BuiltIn };
        var newId = await NewExampleDataTemplateDialog.ShowAsync(DialogService, copyOf: header);
        if (newId.HasValue)
            NavManager.NavigateTo($"/admin/example-data/templates/{newId.Value}");
    }

    private async Task DeleteAsync()
    {
        var name = _template!.Name;
        var confirmed = await DialogService.ShowMessageBoxAsync(
            ExampleDataText.DeleteDataGenerationTemplateTitle,
            string.Format(CultureInfo.CurrentCulture, ExampleDataText.DeleteDataGenerationTemplateMessage, name),
            yesText: CommonText.Delete,
            cancelText: CommonText.Cancel);
        if (confirmed != true)
            return;

        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, CommonText.Delete);
        if (cancelled)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        try
        {
            await jim.ExampleData.DeleteTemplateAsync(_template.Id, ActivityInitiatorType.User, user.Id, user.NameOrId, changeReason);
        }
        catch (ExampleDataTemplateException ex)
        {
            // a built-in template, which the server refuses; the delete action is hidden for those, so this is a stale page.
            Snackbar.Add(ex.Message, Severity.Error);
            return;
        }

        Snackbar.Add(string.Format(CultureInfo.CurrentCulture, ExampleDataText.TemplateDeleted, name), Severity.Success);
        NavManager.NavigateTo("/admin/example-data");
    }

    private async Task AddObjectTypeAsync()
    {
        if (await ExampleDataTemplateObjectTypeDialog.ShowAsync(DialogService, _template!, null))
            await ReloadTemplateAsync();
    }

    private async Task EditObjectTypeAsync(ExampleDataObjectType objectType)
    {
        if (await ExampleDataTemplateObjectTypeDialog.ShowAsync(DialogService, _template!, objectType))
            await ReloadTemplateAsync();
    }

    private async Task RemoveObjectTypeAsync(ExampleDataObjectType objectType)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            string.Format(CultureInfo.CurrentCulture, ExampleDataText.RemoveNamedTitle, objectType.MetaverseObjectType.Name),
            string.Format(CultureInfo.CurrentCulture, ExampleDataText.RemoveObjectTypeMessage, objectType.MetaverseObjectType.PluralName,
                objectType.TemplateAttributes.Count.ToString("N0")),
            yesText: CommonText.Remove,
            cancelText: CommonText.Cancel);
        if (confirmed != true)
            return;

        await SaveEditAsync(template => ExampleDataTemplateGraphEdits.RemoveObjectType(template, objectType.Id), CommonText.Remove);
    }

    private async Task EditAttributeAsync(ExampleDataObjectType objectType, ExampleDataTemplateAttribute? attribute)
    {
        if (await ExampleDataTemplateAttributeDialog.ShowAsync(DialogService, _template!.Id, objectType, attribute))
            await ReloadTemplateAsync();
    }

    private async Task RemoveAttributeAsync(ExampleDataObjectType objectType, ExampleDataTemplateAttribute templateAttribute)
    {
        var attributeName = templateAttribute.MetaverseAttribute?.Name ?? ExampleDataText.ThisAttribute;
        var message = string.Format(CultureInfo.CurrentCulture, ExampleDataText.RemoveAttributeMessage, attributeName, objectType.MetaverseObjectType.PluralName);
        var readers = templateAttribute.MetaverseAttribute == null
            ? []
            : ExampleDataTemplateGraphEdits.AttributesReading(objectType, templateAttribute.MetaverseAttribute);
        if (readers.Count > 0)
        {
            var readersSentence = PluralRules.Choose(readers.Count, ExampleDataText.AttributeReadersOne, ExampleDataText.AttributeReadersOther);
            message += " " + string.Format(CultureInfo.CurrentCulture, readersSentence, string.Join(", ", readers));
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            string.Format(CultureInfo.CurrentCulture, ExampleDataText.RemoveNamedTitle, attributeName), message,
            yesText: CommonText.Remove, cancelText: CommonText.Cancel);
        if (confirmed != true)
            return;

        await SaveEditAsync(template => ExampleDataTemplateGraphEdits.RemoveAttribute(template, objectType.Id, templateAttribute.Id), CommonText.Remove);
    }

    /// <summary>Saves an edit made straight from the page (a removal), reporting a refusal as an error.</summary>
    private async Task SaveEditAsync(Action<ExampleDataTemplate> edit, string actionText)
    {
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, actionText);
        if (cancelled)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        var result = await ExampleDataTemplateEditorSave.ApplyAsync(jim, Id, edit, user, changeReason);
        if (!result.Succeeded)
            Snackbar.Add(result.Error!, Severity.Error);

        foreach (var warning in result.Warnings)
            Snackbar.Add(warning, Severity.Warning);

        await ReloadTemplateAsync();
    }

    public void Dispose()
    {
        UiNotifications.WorkerTaskChanged -= OnWorkerTaskChanged;
        UiNotifications.ActivityProgressChanged -= OnActivityProgressChanged;
        UiNotifications.RealTimeAvailabilityChanged -= OnRealTimeAvailabilityChanged;
        _statusPollTimer?.Dispose();
        _statusPollTimer = null;
    }

    private TimeSpan GetPollingInterval()
    {
        return UiNotifications.IsRealTimeAvailable ? TimeSpan.FromSeconds(30) : TimeSpan.FromSeconds(2);
    }

    private async Task OnStatusPollTimerElapsedAsync()
    {
        try
        {
            await RefreshWorkerTaskStatusAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Transient refresh failures are recoverable; the next timer cycle retries
        }
        finally
        {
            // Re-arm the one-shot timer with the interval for the current real-time availability
            try
            {
                _statusPollTimer?.Change(GetPollingInterval(), Timeout.InfiniteTimeSpan);
            }
            catch (ObjectDisposedException)
            {
                // The component was disposed while this callback was running; nothing to re-arm
            }
        }
    }

    private void OnWorkerTaskChanged(WorkerTaskChangeNotification notification) => TriggerNotificationRefresh();

    // An Activity progress update (objects generated/persisted, message changed) moves the live progress bar.
    private void OnActivityProgressChanged(Guid activityId) => TriggerNotificationRefresh();

    // On reconnection, refresh immediately to reconcile anything missed while real-time was unavailable.
    private void OnRealTimeAvailabilityChanged(bool available) => TriggerNotificationRefresh();

    /// <summary>
    /// Runs a status refresh in response to a notification. Event handlers run off the sync context and
    /// must never throw into the notification relay, so failures are swallowed; the timer fallback retries.
    /// </summary>
    private void TriggerNotificationRefresh()
    {
        _ = Task.Run(async () =>
        {
            try
            {
                await RefreshWorkerTaskStatusAsync();
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // Transient refresh failures are recoverable; the timer fallback covers the gap
            }
        });
    }

    /// <summary>
    /// Fetches the current Worker Task header (status plus live progress) for this template and re-renders
    /// only when the status or any progress field changed. Serves both the timer fallback and event-driven
    /// refreshes; overlapping invocations are skipped via a non-blocking semaphore.
    /// </summary>
    private async Task RefreshWorkerTaskStatusAsync()
    {
        if (_template == null)
            return;

        if (!await _refreshLock.WaitAsync(0))
            return;

        try
        {
            using var refreshJim = JimFactory.Create();
            var newWorkerTask = await refreshJim.Tasking.GetFirstExampleDataTemplateWorkerTaskHeaderAsync(_template.Id);
            var stateHasChanged = HasWorkerTaskChanged(_workerTask, newWorkerTask);

            // Capture the Activity id while the task is processing, so we can show its outcome once it completes.
            if (newWorkerTask?.ActivityId != null)
                _activeActivityId = newWorkerTask.ActivityId;

            // Task just finished (was active, now gone): fetch its completed Activity and leave the result in the
            // panel rather than letting it vanish. Only do this for a task we observed running (ActivityId captured).
            if (newWorkerTask == null && _workerTask != null && _activeActivityId != null)
            {
                _completedActivity = await refreshJim.Activities.GetActivityAsync(_activeActivityId.Value);
                _activeActivityId = null;
                stateHasChanged = true;
            }

            _workerTask = newWorkerTask;
            _status = newWorkerTask?.Status;

            // Reset the executing flag when the task completes (no active task remains)
            if (newWorkerTask == null && _isExecuting)
            {
                _isExecuting = false;
                stateHasChanged = true;
            }

            if (stateHasChanged)
                await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _refreshLock.Release();
        }
    }

    private static bool HasWorkerTaskChanged(WorkerTaskHeader? existing, WorkerTaskHeader? updated)
    {
        if (existing == null && updated == null)
            return false;
        if (existing == null || updated == null)
            return true;

        return existing.Status != updated.Status ||
               existing.ObjectsProcessed != updated.ObjectsProcessed ||
               existing.ObjectsToProcess != updated.ObjectsToProcess ||
               existing.ProgressMessage != updated.ProgressMessage;
    }

    private async Task ExecuteTemplateAsync()
    {
        if (_template == null || _isExecuting)
            return;

        // Immediately disable the button to prevent double-clicks
        _isExecuting = true;

        // Clear any previous run's result so the panel shows this run's progress, not the last outcome.
        _completedActivity = null;
        _activeActivityId = null;

        // attribute the execution to the user
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        _task = ExampleDataTemplateWorkerTask.ForUser(_template.Id, user.Id, user.NameOrId);
        var result = await jim.Tasking.CreateWorkerTaskAsync(_task);

        if (!result.Success)
        {
            _isExecuting = false;
            // Error would be shown elsewhere, but this task type shouldn't have validation errors
            return;
        }

        // Reflect the queued state immediately so the button and the progress panel update without waiting for
        // the first refresh; the next refresh replaces this with the real header carrying Activity progress.
        _status = WorkerTaskStatus.Queued;
        _workerTask = new WorkerTaskHeader { Status = WorkerTaskStatus.Queued, Name = _template.Name, Type = ExampleDataText.ExampleDataTemplate };
    }
}