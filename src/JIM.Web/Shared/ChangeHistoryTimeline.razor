    private sealed record TimelineEntry(DateTime Time, ChangeGroup? Change, RetiredGeneratedValueHeader? Retirement);

    /// <summary>
    /// The filtered change groups and retirements interleaved, newest first. A retirement answers the search by
    /// attribute name or value, and is hidden by a change type filter, which names kinds of attribute change it is
    /// not.
    /// </summary>
    private IEnumerable<TimelineEntry> GetTimelineEntries()
    {
        var changes = GetFilteredChangeGroups().Select(c => new TimelineEntry(c.ChangeTime, c, null));

        IEnumerable<RetiredGeneratedValueHeader> retirements = string.IsNullOrEmpty(_filterChangeType) ? Retirements : [];
        if (!HistoryComplete && Changes.Count > 0)
        {
            var oldestLoaded = Changes.Min(c => c.ChangeTime);
            retirements = retirements.Where(r => r.RetiredAt >= oldestLoaded);
        }
        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            retirements = retirements.Where(r =>
                r.AttributeName.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                r.Value.Contains(_searchText, StringComparison.OrdinalIgnoreCase));
