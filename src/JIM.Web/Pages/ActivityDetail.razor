@page "/activity/{Id:guid}"
@attribute [Authorize(Roles = "User")]
@using JIM.Models.Activities;
@using JIM.Models.Activities.DTOs;
@using JIM.Models.Connectors;
@using JIM.Models.Core.DTOs;
@using JIM.Models.Enums;
@using JIM.Models.Staging
@using JIM.Models.Staging.DTOs
@using JIM.Models.Utility;
@using JIM.Utilities;
@using JIM.Web.Models
@using JIM.Web.Services
@implements IDisposable
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject IUiNotificationService UiNotifications
@inject IActivityEtaTracker EtaTracker

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Activity: @_activity?.TargetOperationType.ToString().SplitOnCapitalLetters() @_activity?.TargetType.ToString().SplitOnCapitalLetters()@(ShowTargetInTitle() ? $": {GetTargetDisplayText()}" : "")</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span class="jim-title-segment">Activity:</span> <span class="jim-title-segment mud-primary-text">@_activity?.TargetOperationType.ToString().SplitOnCapitalLetters() @_activity?.TargetType.ToString().SplitOnCapitalLetters()</span>@if (ShowTargetInTitle()) {<span class="jim-title-segment">: <span class="jim-title-accent">@GetTargetDisplayText()</span></span>}</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

@if (_activity != null)
{
    <MudPaper Class="pa-4 mt-2" Outlined="true">
        <MudText Typo="Typo.h5" Class="mb-4">Summary</MudText>
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.button" Class="mud-text-secondary">ID:</MudText>
                <MudText Class="jim-text-code">@_activity.Id</MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Target:</MudText>
                <MudText>
                    @switch (_activity.TargetType)
                    {
                        case ActivityTargetType.ExampleDataTemplate:
                        case ActivityTargetType.DataGeneration:
                            @* Both template config-changes and data-generation runs carry ExampleDataTemplateId; deep-link to the template. *@
                            <MudLink Href="@($"/admin/example-data/templates/{_activity.ExampleDataTemplateId}")">@_activity.TargetName</MudLink>
                            break;
                        case ActivityTargetType.ConnectedSystem when Helpers.GetConnectedSystemActivityHref(_activity.ConnectedSystemId, _activity.TargetOperationType) is { } connectedSystemHref:
                            @* Schema and hierarchy imports deep-link to the tab that shows their subject. *@
                            <MudLink Href="@connectedSystemHref">@_activity.TargetName</MudLink>
                            break;
                        case ActivityTargetType.ConnectedSystemObject when Helpers.GetConnectedSystemObjectActivityHref(_activity.ConnectedSystemId, _activity.ConnectedSystemObjectId) is { } csoHref:
                            @* An operation performed on the account itself (a password set); link to the object in the connector space. *@
                            <MudLink Href="@csoHref">@_activity.TargetName</MudLink>
                            break;
                        case ActivityTargetType.ConnectedSystemRunProfile when _connectedSystemHeader != null:
                            <MudLink Href="@($"/admin/connected-systems/{_activity.ConnectedSystemId}/?t=run-profiles")">@_connectedSystemHeader.Name / @_activity.TargetName</MudLink>
                            break;
                        case ActivityTargetType.MetaverseObject when _metaverseObjectHeader != null:
                            <MudLink Href="@Utilities.GetMetaverseObjectHref(_metaverseObjectHeader)">@Utilities.GetMetaverseObjectHrefText(_metaverseObjectHeader)</MudLink>
                            break;
                        case ActivityTargetType.SynchronisationRule when Helpers.GetSyncRuleActivityHref(_activity.SyncRuleId, _activity.TargetName) is { } syncRuleHref:
                            @* Attribute Flow mapping activities deep-link to the rule's Attribute Flow tab. *@
                            <MudLink Href="@syncRuleHref">@_activity.TargetName</MudLink>
                            break;
                        case ActivityTargetType.TrustedCertificate:
                            <MudLink Href="/admin/certificates">@_activity.TargetName</MudLink>
                            break;
                        case ActivityTargetType.MetaverseAttribute:
                            <MudLink Href="/admin/schema?t=attributes">@_activity.TargetName</MudLink>
                            break;
                        case ActivityTargetType.MetaverseObjectType:
                            <MudLink Href="/admin/schema">@_activity.TargetName</MudLink>
                            break;
                        case ActivityTargetType.ServiceSetting when Helpers.GetServiceSettingActivityHref(_activity.TargetName) is { } serviceSettingHref:
                            @* Service Settings have no page of their own; deep-link with the name pre-filled into the search box. *@
                            <MudLink Href="@serviceSettingHref">@_activity.TargetName</MudLink>
                            break;
                        case ActivityTargetType.Schedule:
                            <MudLink Href="/admin/operations?t=schedules">@_activity.TargetName</MudLink>
                            break;
                        case ActivityTargetType.HistoryRetentionCleanup:
                            <MudIcon Icon="@Icons.Material.Filled.CleaningServices" Class="mr-1" Style="vertical-align: middle;" />
                            @(_activity.TargetName ?? "History Retention Cleanup")
                            break;
                        case ActivityTargetType.Authentication:
                            <MudIcon Icon="@Icons.Material.Filled.Shield" Class="mr-1" Style="vertical-align: middle;" />
                            @(_activity.TargetName ?? "Authentication")
                            break;
                        case ActivityTargetType.ObjectMatchingRule when Helpers.GetObjectMatchingRuleHref(_activity.SyncRuleId, _activity.ConnectedSystemId) is { } matchingRuleHref:
                            @* A rule has no page of its own; link to the owning object's Matching tab. *@
                            <MudLink Href="@matchingRuleHref">@_activity.TargetName</MudLink>
                            break;
                        case ActivityTargetType.ObjectMatchingRule:
                        case ActivityTargetType.NotSet:
                        default:
                            @(_activity.TargetName ?? "-")
                            break;
                    }
                </MudText>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.button" Class="mud-text-secondary">When:</MudText>
                <MudText title="@_activity.Created.ToLocalTime().ToFriendlyDate()">@_activity.Created.ToLocalTime().ToRelativeTime()</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Initiated By:</MudText>
                @{
                    if (_activity.InitiatedByType == ActivityInitiatorType.User)
                    {
                        <MudText>
                            <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-1" Style="vertical-align: middle;" />
                            @if (_activity.InitiatedById.HasValue && _initiatorMetaverseObjectHeader != null)
                            {
                                <MudLink Href="@Utilities.GetMetaverseObjectHref(_initiatorMetaverseObjectHeader)">@_activity.InitiatedByName</MudLink>
                            }
                            else
                            {
                                <span>@_activity.InitiatedByName</span>
                            }
                        </MudText>
                    }
                    else if (_activity.InitiatedByType == ActivityInitiatorType.ApiKey)
                    {
                        <MudText>
                            <MudIcon Icon="@Icons.Material.Filled.Key" Class="mr-1" Style="vertical-align: middle;" />
                            @if (_activity.InitiatedById.HasValue)
                            {
                                <MudLink Href="@Utilities.GetApiKeyHref(_activity.InitiatedById.Value)">@_activity.InitiatedByName</MudLink>
                            }
                            else
                            {
                                <span>@_activity.InitiatedByName</span>
                            }
                        </MudText>
                    }
                    else if (_activity.InitiatedByType == ActivityInitiatorType.System)
                    {
                        <MudText>
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mr-1" Style="vertical-align: middle;" />
                            <span>@(_activity.InitiatedByName ?? "System")</span>
                        </MudText>
                    }
                    else if (_activity.InitiatedByType == ActivityInitiatorType.Anonymous)
                    {
                        @* An unidentified, unauthenticated caller (a failed sign-in attempt): plain text, never a link. *@
                        <MudText>
                            <MudIcon Icon="@Icons.Material.Filled.QuestionMark" Class="mr-1" Style="vertical-align: middle;" />
                            <span>Anonymous</span>
                        </MudText>
                    }
                    else if (!string.IsNullOrEmpty(_activity.InitiatedByName))
                    {
                        <MudText>@_activity.InitiatedByName</MudText>
                    }
                }
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Status:</MudText><br />
                <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetActivityMudBlazorColorForStatus(_activity.Status)" Class="ml-0">@_activity.Status.ToString().SplitOnCapitalLetters()</MudChip>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Execution Time:</MudText>
                <MudText>@(_activity.ExecutionTime?.ToAbbreviatedString() ?? "-")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Total Activity Time:</MudText>
                <MudText>@(_activity.TotalActivityTime?.ToAbbreviatedString() ?? "-")</MudText>
            </MudItem>

            @if (_activity.ParentActivityId.HasValue)
            {
                var parentActivityId = _activity.ParentActivityId.Value;
                var parentActivityHref = $"/activity/{parentActivityId}{(_fromOperations ? "?from=operations" : "")}";
                <MudItem xs="12" sm="6" md="4">
                    <MudText Typo="Typo.button" Class="mud-text-secondary">Parent Activity:</MudText>
                    <MudText>
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-1" Style="vertical-align: middle;" />
                        @if (_parentActivity != null)
                        {
                            var parentTargetName = !string.IsNullOrEmpty(_parentActivity.TargetName) ? _parentActivity.TargetName : "(no name)";
                            <MudChip T="string" Variant="Variant.Text" Class="mr-2">@_parentActivity.TargetType.ToString().SplitOnCapitalLetters()</MudChip>
                            <MudLink Href="@parentActivityHref">@parentTargetName</MudLink>
                        }
                        else
                        {
                            <MudLink Href="@parentActivityHref">View parent activity</MudLink>
                        }
                    </MudText>
                </MudItem>
            }

            @* While a run is in flight the message is live progress narration, and it belongs with
               the step it describes rather than repeated in the summary. *@
            @if (!string.IsNullOrEmpty(_activity.Message) && _activity.Status != ActivityStatus.InProgress)
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.button" Class="mud-text-secondary">Message:</MudText>
                    <MudText Style="white-space: pre-line;">@_activity.Message</MudText>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    @* Renders nothing unless a Schedule produced this Activity. Sits under the Summary panel: it is context
       about where this Activity came from, not a notice that interrupts the page. *@
    <ActivityScheduleContext ScheduleExecutionId="_activity.ScheduleExecutionId"
                             ScheduleStepIndex="_activity.ScheduleStepIndex"
                             Class="mt-6" />

    @* Where the run has got to: the steps (#454), and how far through the running step it is. One
       panel, because they answer the same question at two resolutions. The steps outlive the run;
       the counters below them only exist while it is in flight. *@
    @if (_phases.Count > 0 || _activity.Status == ActivityStatus.InProgress)
    {
        <MudPaper Class="pa-4 mt-6" Outlined="true">
            <MudText Typo="Typo.h5" Class="mb-4">Progress</MudText>

            @if (_phases.Count > 0)
            {
                <RunPhaseStepper Phases="_phases" StepProgress="@StepProgressFraction" />
            }

            @if (_activity.Status == ActivityStatus.InProgress)
            {
                @* The gap above the figures travels with them, so that a run with no steps to
                   separate them from does not get one. *@
                <MudStack Spacing="2">
                    @* Counts, rate and time remaining (issue #202), each stated once, under the
                       step they measure and the Activity's own narration of what it is doing
                       within it. *@
                    <RunProgressMetrics ObjectsProcessed="@_activity.ObjectsProcessed"
                                        ObjectsToProcess="@_activity.ObjectsToProcess"
                                        ObjectsPerSecond="@_etaEstimate.ObjectsPerSecond"
                                        EstimatedSecondsRemaining="@_etaEstimate.EstimatedSecondsRemaining"
                                        Phases="_phases"
                                        Message="@_activity.Message" />
                </MudStack>
            }
        </MudPaper>
    }

    @if (!string.IsNullOrEmpty(_activity.WarningMessage))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
            <MudText Typo="Typo.body1" Style="font-weight: 500;">@_activity.WarningMessage</MudText>
        </MudAlert>
    }

    @if (!string.IsNullOrEmpty(_activity.ErrorMessage) || !string.IsNullOrEmpty(_activity.ErrorStackTrace))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4 jim-alert-error jim-exception-text">
            @if (!string.IsNullOrEmpty(_activity.ErrorMessage))
            {
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@_activity.ErrorMessage</MudText>
            }

            <CollapsibleStackTrace StackTrace="@_activity.ErrorStackTrace" />
        </MudAlert>

        @* Some failures carry facts worth showing, not just a sentence. A rejected directory certificate is one:
           what was presented, and by whom, is what tells an administrator whether to trust it, renew it, or reach
           the directory by a different name. *@
        @if (_serverCertificate != null)
        {
            @* The action is offered from a historical Activity too. It is safe to do so because the certificate is
               read from the server again at the moment of the decision: a week-old Activity whose server has since
               changed certificate stops the action rather than trusting the newer one unseen. *@
            <ServerCertificateCard Diagnostic="_serverCertificate"
                                   ConnectedSystemId="@_activity.ConnectedSystemId"
                                   ConnectedSystemName="@_connectedSystemHeader?.Name"
                                   OnTrusted="ReloadAfterTrustingCertificateAsync" />
        }
    }

    @if (_configChangeDetail != null)
    {
        <MudText Typo="Typo.h5" Class="mt-5">Configuration Change</MudText>
        @if (!string.IsNullOrWhiteSpace(_activity.ChangeReason))
        {
            <MudText Typo="Typo.body1" Class="mt-2" Style="font-style: italic;">&ldquo;@_activity.ChangeReason&rdquo;</MudText>
        }
        <MudPaper Class="pa-4 mt-3" Outlined="true">
            <ConfigurationChangeFieldHistory Diff="_configChangeDetail.Diff" />
        </MudPaper>
    }
    else if (ShowNoSnapshotNotice)
    {
        @* A configuration-target activity without a captured snapshot would otherwise render header-only, which reads
           as a broken page. Say explicitly that no snapshot exists and why that can happen. *@
        <MudText Typo="Typo.h5" Class="mt-5">Configuration Change</MudText>
        @if (!string.IsNullOrWhiteSpace(_activity.ChangeReason))
        {
            <MudText Typo="Typo.body1" Class="mt-2" Style="font-style: italic;">&ldquo;@_activity.ChangeReason&rdquo;</MudText>
        }
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
            No configuration snapshot was captured for this change, so what changed cannot be shown. This happens when
            the change was made before configuration change tracking was introduced, while it was disabled, or when the
            saved configuration was identical to the previous version.
        </MudAlert>
    }

    @if (_activity.TargetType == ActivityTargetType.HistoryRetentionCleanup)
    {
        var csoCount = _activity.DeletedCsoChangeCount ?? 0;
        var mvoCount = _activity.DeletedMvoChangeCount ?? 0;
        var activityCount = _activity.DeletedActivityCount ?? 0;
        var totalDeleted = csoCount + mvoCount + activityCount;

        <MudText Typo="Typo.h5" Class="mt-5">Cleanup Summary</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2 mb-4">
            Automated retention cleanup removed expired change history and activity records.
            Retention periods can be configured in <MudLink Href="/admin/settings">Settings</MudLink>.
        </MudText>

        <MudStack Row="true" Class="mt-2 mb-5 flex-wrap" Spacing="3">
            @* Total card *@
            <MudPaper Class="pa-4" Outlined="true" Style="min-width: 120px;">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Total Deleted</MudText>
                <MudText Typo="Typo.h4">@totalDeleted.ToString("N0")</MudText>
            </MudPaper>

            @* CSO Changes *@
            <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Orange.Default}; min-width: 120px;")">
                <MudText Typo="Typo.button" Class="mud-text-secondary">CSO Changes</MudText>
                <MudText Typo="Typo.h4" Color="Color.Warning">@csoCount.ToString("N0")</MudText>
            </MudPaper>

            @* MVO Changes *@
            <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Orange.Default}; min-width: 120px;")">
                <MudText Typo="Typo.button" Class="mud-text-secondary">MVO Changes</MudText>
                <MudText Typo="Typo.h4" Color="Color.Warning">@mvoCount.ToString("N0")</MudText>
            </MudPaper>

            @* Activities *@
            <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Orange.Default}; min-width: 120px;")">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Activities</MudText>
                <MudText Typo="Typo.h4" Color="Color.Warning">@activityCount.ToString("N0")</MudText>
            </MudPaper>

            @* Date range card *@
            @if (_activity.DeletedRecordsFromDate.HasValue && _activity.DeletedRecordsToDate.HasValue)
            {
                <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Gray.Default}; min-width: 200px;")">
                    <MudText Typo="Typo.button" Class="mud-text-secondary">Oldest Record Deleted</MudText>
                    <MudText Typo="Typo.h6" title="@_activity.DeletedRecordsFromDate.Value.ToLocalTime().ToFriendlyDate()">
                        @_activity.DeletedRecordsFromDate.Value.ToLocalTime().ToRelativeTime()
                    </MudText>
                    <MudText Typo="Typo.button" Class="mud-text-secondary mt-3">Newest Record Deleted</MudText>
                    <MudText Typo="Typo.h6" title="@_activity.DeletedRecordsToDate.Value.ToLocalTime().ToFriendlyDate()">
                        @_activity.DeletedRecordsToDate.Value.ToLocalTime().ToRelativeTime()
                    </MudText>
                </MudPaper>
            }
        </MudStack>
    }

    @if (_activity.TargetType == ActivityTargetType.Authentication)
    {
        var isAggregatedFailure = _activity.AggregationWindowStart.HasValue;

        <MudText Typo="Typo.h5" Class="mt-5">Security Event Details</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2 mb-4">
            @(isAggregatedFailure
                ? "Failed authentication attempts matching the same API key prefix, client IP and reason within a 15-minute window are aggregated onto this Activity, with the attempt count updated in place."
                : "A successful interactive sign-in, recorded once per session establishment.")
        </MudText>

        <MudPaper Class="pa-4 mt-2 mb-5" Outlined="true">
            <MudGrid Spacing="4">
                @if (!string.IsNullOrEmpty(_activity.SecurityEventReason))
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Reason:</MudText>
                        <MudText>@_activity.SecurityEventReason</MudText>
                    </MudItem>
                }
                @if (!string.IsNullOrEmpty(_activity.ApiKeyPrefix))
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">API Key Prefix:</MudText>
                        <MudText Class="jim-text-code">@_activity.ApiKeyPrefix</MudText>
                    </MudItem>
                }
                @if (!string.IsNullOrEmpty(_activity.ClientIpAddress))
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Client IP Address:</MudText>
                        <MudText Class="jim-text-code">@_activity.ClientIpAddress</MudText>
                    </MudItem>
                }
                @if (_activity.AttemptCount.HasValue)
                {
                    var attemptCount = _activity.AttemptCount.Value;
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Attempt Count:</MudText>
                        <MudText>@attemptCount.ToString("N0")</MudText>
                    </MudItem>
                }
                @if (_activity.AggregationWindowStart.HasValue)
                {
                    var windowStart = _activity.AggregationWindowStart.Value;
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Window Start:</MudText>
                        <MudText title="@windowStart.ToLocalTime().ToFriendlyDate()">@windowStart.ToLocalTime().ToRelativeTime()</MudText>
                    </MudItem>
                }
                @if (_activity.FirstSeen.HasValue)
                {
                    var firstSeen = _activity.FirstSeen.Value;
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">First Seen:</MudText>
                        <MudText title="@firstSeen.ToLocalTime().ToFriendlyDate()">@firstSeen.ToLocalTime().ToRelativeTime()</MudText>
                    </MudItem>
                }
                @if (_activity.LastSeen.HasValue)
                {
                    var lastSeen = _activity.LastSeen.Value;
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Last Seen:</MudText>
                        <MudText title="@lastSeen.ToLocalTime().ToFriendlyDate()">@lastSeen.ToLocalTime().ToRelativeTime()</MudText>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>
    }

    @if (_activity.TargetType == ActivityTargetType.ConnectedSystem && _activity.TargetOperationType == ActivityTargetOperationType.Clear)
    {
        var pendingExportCount = _activity.ClearedPendingExportCount ?? 0;
        var csoCount = _activity.ClearedConnectedSystemObjectCount ?? 0;
        var totalRemoved = pendingExportCount + csoCount;

        <MudText Typo="Typo.h5" Class="mt-5">Clear Summary</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2 mb-4">
            All connector space objects and Pending Exports were removed from this Connected System.
        </MudText>

        <MudStack Row="true" Class="mt-2 mb-5 flex-wrap" Spacing="3">
            @* Total card *@
            <MudPaper Class="pa-4" Outlined="true" Style="min-width: 120px;">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Total Removed</MudText>
                <MudText Typo="Typo.h4">@totalRemoved.ToString("N0")</MudText>
            </MudPaper>

            @* CSOs Removed *@
            <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Red.Default}; min-width: 120px;")">
                <MudText Typo="Typo.button" Class="mud-text-secondary">CSOs Removed</MudText>
                <MudText Typo="Typo.h4" Color="Color.Error">@csoCount.ToString("N0")</MudText>
            </MudPaper>

            @* Pending Exports Removed *@
            <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Red.Default}; min-width: 120px;")">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Pending Exports Removed</MudText>
                <MudText Typo="Typo.h4" Color="Color.Error">@pendingExportCount.ToString("N0")</MudText>
            </MudPaper>

            @* Tracked for Reconciliation: not a removal, so it deliberately does not add into Total Removed
               and carries no destructive (red) styling. *@
            @if (_activity.ClearedJoinRecordCount is > 0)
            {
                var joinRecordCount = _activity.ClearedJoinRecordCount!.Value;
                <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Blue.Default}; min-width: 120px;")">
                    <MudTooltip Text="Objects joined at the moment of the clear, so the next Full Synchronisation can tell who returned." Arrow="true" Placement="Placement.Top">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Tracked for Reconciliation</MudText>
                    </MudTooltip>
                    <MudText Typo="Typo.h4" Color="Color.Info">@joinRecordCount.ToString("N0")</MudText>
                </MudPaper>
            }
        </MudStack>
    }

    @* Run Profile Safeguards (#1618): only shown once something was actually withheld, so a normal,
       uncapped Export run shows nothing extra here. *@
    @if ((_activity.ExportCreatesWithheld ?? 0) > 0 || (_activity.ExportUpdatesWithheld ?? 0) > 0 || (_activity.ExportDeletesWithheld ?? 0) > 0)
    {
        var createsWithheld = _activity.ExportCreatesWithheld ?? 0;
        var updatesWithheld = _activity.ExportUpdatesWithheld ?? 0;
        var deletesWithheld = _activity.ExportDeletesWithheld ?? 0;

        <MudText Typo="Typo.h5" Class="mt-5">Safeguards</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2 mb-4">
            Withheld exports stay Pending and are attempted on the next export run.
        </MudText>

        <MudStack Row="true" Class="mt-2 mb-5 flex-wrap" Spacing="3">
            <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {(createsWithheld > 0 ? Colors.Orange.Default : Colors.Gray.Default)}; min-width: 120px;")">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Creates Withheld</MudText>
                <MudText Typo="Typo.h4" Color="@(createsWithheld > 0 ? Color.Warning : Color.Default)">@createsWithheld.ToString("N0")</MudText>
            </MudPaper>
            <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {(updatesWithheld > 0 ? Colors.Orange.Default : Colors.Gray.Default)}; min-width: 120px;")">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Updates Withheld</MudText>
                <MudText Typo="Typo.h4" Color="@(updatesWithheld > 0 ? Color.Warning : Color.Default)">@updatesWithheld.ToString("N0")</MudText>
            </MudPaper>
            <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {(deletesWithheld > 0 ? Colors.Orange.Default : Colors.Gray.Default)}; min-width: 120px;")">
                <MudText Typo="Typo.button" Class="mud-text-secondary">Deletes Withheld</MudText>
                <MudText Typo="Typo.h4" Color="@(deletesWithheld > 0 ? Color.Warning : Color.Default)">@deletesWithheld.ToString("N0")</MudText>
            </MudPaper>
        </MudStack>
    }

    @* A Configuration Change Preview's results. The Activity *is* the preview, so this page is where an
       administrator lands from the Activity list, from a link they kept, or from the change the preview informed;
       without this they would find a completed Activity with nothing to say what it found. Progress is left to the
       block above, which already renders it with throughput and an ETA. *@
    @if (_activity.TargetOperationType == ActivityTargetOperationType.Preview)
    {
        <ConfigurationChangePreviewPanel ActivityId="@_activity.Id" Title="Preview results" ShowProgress="false" Class="mt-6" />
    }

    @if (ShowsExecutionItems && _initialisationComplete)
    {
        @if (_activityRunProfileExecutionStats != null)
        {
            @* Summary Section *@
            <MudText Typo="Typo.h5" Class="mt-5">Stats</MudText>
            <MudStack Row="true" Class="mt-4 mb-5 flex-wrap" Spacing="3">
                @* Housekeeping-specific cards - Metaverse Object deletion batches *@
                @if (IsHousekeepingActivity)
                {
                    <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Red.Default}; min-width: 120px;")">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Metaverse Objects Deleted</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Error">@_activityRunProfileExecutionStats.TotalMvoDeleted.ToString("N0")</MudText>
                    </MudPaper>
                    @if (_activityRunProfileExecutionStats.TotalPendingExports > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Teal.Default}; min-width: 120px;")">
                            <MudText Typo="Typo.button" Class="mud-text-secondary">Recall Pending Exports</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Info">@_activityRunProfileExecutionStats.TotalPendingExports.ToString("N0")</MudText>
                        </MudPaper>
                    }
                }

                @* Import-specific cards *@
                @if (IsImportRun())
                {
                    <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Green.Default}; min-width: 120px;")">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">CSOs Added</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Success">@_activityRunProfileExecutionStats.TotalCsoAdds.ToString("N0")</MudText>
                    </MudPaper>
                    <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Teal.Default}; min-width: 120px;")">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">CSOs Updated</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Info">@_activityRunProfileExecutionStats.TotalCsoUpdates.ToString("N0")</MudText>
                    </MudPaper>
                    <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Red.Default}; min-width: 120px;")">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">CSO Deletions Detected</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Error">@_activityRunProfileExecutionStats.TotalCsoDeletes.ToString("N0")</MudText>
                    </MudPaper>

                    @* Pending Export confirmation stats - shown during confirming import *@
                    @if (_activityRunProfileExecutionStats.TotalPendingExportsConfirmed > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Green.Default}; min-width: 120px;")">
                            <MudText Typo="Typo.button" Class="mud-text-secondary">CSO Exports Confirmed</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Success">@_activityRunProfileExecutionStats.TotalPendingExportsConfirmed.ToString("N0")</MudText>
                        </MudPaper>
                    }
                    @if (_activityRunProfileExecutionStats.TotalPendingExportsRetrying > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Orange.Default}; min-width: 120px;")">
                            <MudText Typo="Typo.button" Class="mud-text-secondary">Exports Retrying</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Warning">@_activityRunProfileExecutionStats.TotalPendingExportsRetrying.ToString("N0")</MudText>
                        </MudPaper>
                    }
                    @if (_activityRunProfileExecutionStats.TotalPendingExportsFailed > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Style="@($"background-color: {Colors.Red.Default}; color: {Colors.Shades.White}; border-left: 4px solid {Colors.Red.Darken3}; min-width: 120px;")">
                            <MudText Typo="Typo.button" Style="@($"color: {Colors.Shades.White};")">CSO Exports Failed</MudText>
                            <MudText Typo="Typo.h4" Style="@($"color: {Colors.Shades.White};")">@_activityRunProfileExecutionStats.TotalPendingExportsFailed.ToString("N0")</MudText>
                        </MudPaper>
                    }
                }

                @* Sync-specific cards *@
                @if (IsSyncRun())
                {
                    <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid var(--mud-palette-secondary); min-width: 120px;")">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">CSOs Joined</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Secondary">@_activityRunProfileExecutionStats.TotalJoins.ToString("N0")</MudText>
                    </MudPaper>
                    <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid var(--mud-palette-primary); min-width: 120px;")">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">MVOs Projected</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Primary">@_activityRunProfileExecutionStats.TotalProjections.ToString("N0")</MudText>
                    </MudPaper>
                    <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid var(--mud-palette-tertiary); min-width: 120px;")">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">MVOs with Attribute Flow</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Tertiary">@_activityRunProfileExecutionStats.TotalAttributeFlows.ToString("N0")</MudText>
                    </MudPaper>

                    @* CSOs Provisioned - new CSOs created in target systems via export evaluation *@
                    @if (_activityRunProfileExecutionStats.TotalProvisioned > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid var(--mud-palette-primary); min-width: 120px;")">
                            <MudText Typo="Typo.button" Class="mud-text-secondary">CSOs Provisioned</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Primary">@_activityRunProfileExecutionStats.TotalProvisioned.ToString("N0")</MudText>
                        </MudPaper>
                    }

                    @* Pending Exports - surfaced during sync to show what's awaiting confirmation *@
                    @if (_activityRunProfileExecutionStats.TotalPendingExports > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Teal.Default}; min-width: 120px;")">
                            <MudText Typo="Typo.button" Class="mud-text-secondary">CSO Pending Exports</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Info">@_activityRunProfileExecutionStats.TotalPendingExports.ToString("N0")</MudText>
                        </MudPaper>
                    }

                    <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid var(--mud-palette-warning); min-width: 120px;")">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">CSOs Disconnected</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Warning">@_activityRunProfileExecutionStats.TotalDisconnections.ToString("N0")</MudText>
                    </MudPaper>

                    @* CSOs Deleted - CSOs finalised as deleted during sync *@
                    @if (_activityRunProfileExecutionStats.TotalCsoDeletes > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Red.Default}; min-width: 120px;")">
                            <MudText Typo="Typo.button" Class="mud-text-secondary">CSOs Deleted</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Error">@_activityRunProfileExecutionStats.TotalCsoDeletes.ToString("N0")</MudText>
                        </MudPaper>
                    }

                    @* Drift Corrections - shown when drift was detected and corrective exports staged *@
                    @if (_activityRunProfileExecutionStats.TotalDriftCorrections > 0)
                    {
                        <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Orange.Default}; min-width: 120px;")">
                            <MudText Typo="Typo.button" Class="mud-text-secondary">CSOs Drift Corrected</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Warning">@_activityRunProfileExecutionStats.TotalDriftCorrections.ToString("N0")</MudText>
                        </MudPaper>
                    }
                }

                @* Export-specific cards *@
                @if (IsExportRun())
                {
                    <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Teal.Default}; min-width: 120px;")">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">CSOs Exported</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Info">@_activityRunProfileExecutionStats.TotalExported.ToString("N0")</MudText>
                    </MudPaper>
                    <MudPaper Class="pa-4" Outlined="true" Style="@($"border-left: 4px solid {Colors.Red.Default}; min-width: 120px;")">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">CSOs Deprovisioned</MudText>
                        <MudText Typo="Typo.h4" Color="Color.Error">@_activityRunProfileExecutionStats.TotalDeprovisioned.ToString("N0")</MudText>
                    </MudPaper>
                }

                @* Unchanged card - always show for Run Profile executions (housekeeping deletes MVOs, not CSOs) *@
                @if (!IsHousekeepingActivity)
                {
                    <MudPaper Class="pa-4" Outlined="true" Style="border-left: 4px solid var(--mud-palette-grey-light); min-width: 120px;">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">CSOs Unchanged</MudText>
                        <MudText Typo="Typo.h4" Class="mud-text-secondary">@_activityRunProfileExecutionStats.TotalUnchanged.ToString("N0")</MudText>
                    </MudPaper>
                }

                @* Object Types card *@
                <MudPaper Class="pa-4" Outlined="true" Style="min-width: 120px;">
                    <MudText Typo="Typo.button" Class="mud-text-secondary">Object Types</MudText>
                    <MudText Typo="Typo.h4">@_activityRunProfileExecutionStats.TotalObjectTypes.ToString("N0")</MudText>
                </MudPaper>

                @* Errors card - green border when 0, red background when > 0 *@
                <MudPaper Class="pa-4" Outlined="true"
                          Style="@(_activityRunProfileExecutionStats.TotalObjectErrors > 0
                                 ? $"background-color: {Colors.Red.Default}; color: {Colors.Shades.White}; border-left: 4px solid {Colors.Red.Darken3}; min-width: 120px;"
                                 : $"border-left: 4px solid {Colors.Green.Default}; min-width: 120px;")">
                    <MudText Typo="Typo.button" Class="mud-text-secondary" Style="@(_activityRunProfileExecutionStats.TotalObjectErrors > 0 ? $"color: {Colors.Shades.White};" : "")">Errors</MudText>
                    <MudText Typo="Typo.h4" Style="@(_activityRunProfileExecutionStats.TotalObjectErrors > 0 ? $"color: {Colors.Shades.White};" : "")">@_activityRunProfileExecutionStats.TotalObjectErrors.ToString("N0")</MudText>
                </MudPaper>
            </MudStack>
        }

        @* ─── Container Scope exclusions (#1255) ─── *@
        @if (DiscardedEntriesThroughAnExclusion)
        {
            var exclusionStats = _activityRunProfileExecutionStats!;
            <MudPaper Class="pa-4 mt-6" Outlined="true">
                <MudText Typo="Typo.h5">Entries Discarded by Container Scope</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                    A Connected System cannot be asked for a branch minus part of itself in one search, so JIM reads
                    the entries an excluded Container covers and discards them. These entries were transferred and
                    never imported. Where the number is large, moving the excluded branch outside the selected one
                    removes the cost entirely.
                </MudText>
                <MudSimpleTable Dense="true" Hover="true" Class="mt-4">
                    <thead>
                        <tr>
                            <th>Excluded Container</th>
                            <th style="text-align: right;">Entries Discarded</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (containerId, discarded) in exclusionStats.EntriesDiscardedByExcludedContainer.OrderByDescending(entry => entry.Value))
                        {
                            <tr>
                                <td>
                                    @if (_excludedContainers.TryGetValue(containerId, out var container))
                                    {
                                        <MudTooltip Arrow="true" Placement="Placement.Top" Text="@container.ExternalId">
                                            <span>@container.Name</span>
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        @* The Container has been removed from the hierarchy since this run. Saying
                                           so beats inventing a name for it. *@
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Container no longer in the hierarchy</MudText>
                                    }
                                </td>
                                <td style="text-align: right;">@discarded.ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td><strong>Total</strong></td>
                            <td style="text-align: right;"><strong>@exclusionStats.TotalEntriesDiscardedByExclusion.ToString("N0")</strong></td>
                        </tr>
                    </tfoot>
                </MudSimpleTable>
            </MudPaper>
        }

        @* Results Section with Filter and Table *@
        <MudText Typo="Typo.h5">@(IsHousekeepingActivity ? "Deletion Results" : Helpers.GetRunTypeResultsTitle(_activity.ConnectedSystemRunType))</MudText>

        @* Filter Chips Section *@
        @if (GetAvailableOutcomeTypes().Any() || GetAvailableObjectTypes().Any() || GetAvailableErrorTypes().Any())
        {
            <MudStack Row="true" Spacing="6" Class="mt-3 mb-3 flex-wrap" AlignItems="AlignItems.Start">
                @* Outcome Type Filter *@
                @if (GetAvailableOutcomeTypes().Any())
                {
                    <div>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Filter by Outcome Type:</MudText>
                        @* One wrapping flex row for the filter chips and the informational Unchanged chip: the chip
                           set is d-contents so its chips are items of this row, letting Unchanged sit beside them
                           rather than forcing a line of its own and pushing the table down. *@
                        <div class="d-flex flex-wrap align-center">
                            <MudChipSet T="ActivityRunProfileExecutionItemSyncOutcomeType"
                                        SelectionMode="SelectionMode.MultiSelection"
                                        SelectedValues="_selectedOutcomeTypes"
                                        SelectedValuesChanged="OnOutcomeTypeFilterChanged"
                                        Class="d-contents">
                                @foreach (var (outcomeType, count) in GetAvailableOutcomeTypes())
                                {
                                    <MudChip Value="@outcomeType"
                                             Color="@(IsOutcomeTypeSelected(outcomeType) ? Color.Default : Helpers.GetOutcomeTypeMudBlazorColor(outcomeType))"
                                             Variant="@(IsOutcomeTypeSelected(outcomeType) ? Variant.Filled : Variant.Outlined)"
                                             SelectedColor="@Helpers.GetOutcomeTypeMudBlazorColor(outcomeType)">
                                        @Helpers.GetOutcomeTypeDisplayName(outcomeType)
                                        <MudText Typo="Typo.caption" Class="ml-1">(@count.ToString("N0"))</MudText>
                                    </MudChip>
                                }
                            </MudChipSet>
                            @* Unchanged chip: informational, not a filter *@
                            @if (GetUnchangedCount() > 0)
                            {
                                <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Disabled="true">
                                    Unchanged
                                    <MudText Typo="Typo.caption" Class="ml-1">(@GetUnchangedCount().ToString("N0"))</MudText>
                                </MudChip>
                            }
                        </div>
                    </div>
                }

                @* External Object Type Filter *@
                @if (GetAvailableObjectTypes().Any())
                {
                    <div>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Filter by External Object Type:</MudText>
                        <MudChipSet T="string"
                                    SelectionMode="SelectionMode.MultiSelection"
                                    SelectedValues="_selectedObjectTypes"
                                    SelectedValuesChanged="OnObjectTypeFilterChanged">
                            @foreach (var objectType in GetAvailableObjectTypes())
                            {
                                <MudChip Value="@objectType.Key"
                                         Color="Color.Default"
                                         Variant="@(IsObjectTypeSelected(objectType.Key) ? Variant.Filled : Variant.Outlined)"
                                         SelectedColor="Color.Default">
                                    @objectType.Key
                                    <MudText Typo="Typo.caption" Class="ml-1">(@objectType.Value.ToString("N0"))</MudText>
                                </MudChip>
                            }
                        </MudChipSet>
                    </div>
                }

                @* Error Type Filter *@
                @if (GetAvailableErrorTypes().Any())
                {
                    <div>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Filter by Error Type:</MudText>
                        <MudChipSet T="ActivityRunProfileExecutionItemErrorType"
                                    SelectionMode="SelectionMode.MultiSelection"
                                    SelectedValues="_selectedErrorTypes"
                                    SelectedValuesChanged="OnErrorTypeFilterChanged">
                            @foreach (var errorType in GetAvailableErrorTypes())
                            {
                                <MudChip Value="@errorType.Key"
                                         Color="@(IsErrorTypeSelected(errorType.Key) ? Color.Default : Color.Error)"
                                         Variant="@(IsErrorTypeSelected(errorType.Key) ? Variant.Filled : Variant.Outlined)"
                                         SelectedColor="Color.Error">
                                    @errorType.Key.ToString().SplitOnCapitalLetters()
                                    <MudText Typo="Typo.caption" Class="ml-1">(@errorType.Value.ToString("N0"))</MudText>
                                </MudChip>
                            }
                        </MudChipSet>
                    </div>
                }
            </MudStack>
        }

        @* The infinite-scroll machinery (URL state, scroll restore, window loading, the search box and the
           toolbar count) lives in the shared grid; this page supplies the columns, the window loader, the chip
           filters above and the empty states. Its URL parameters carry the rpei- prefix so the two grids on
           this page can share the address bar without colliding. *@
        <VirtualisedDataGrid @ref="_executionItemsGrid" T="ActivityRunProfileExecutionItemHeader"
                             ContainerId="activity-execution-items"
                             UrlParameterPrefix="rpei-"
                             StateKey="@Id.ToString()"
                             DefaultSortBy="@DefaultExecutionItemSort"
                             LoadWindow="LoadExecutionItemWindowAsync"
                             SingularName="Run Profile Execution Item"
                             PluralName="Run Profile Execution Items"
                             SearchPlaceholder="Search name or external ID">
            <Columns>
                <TemplateColumn T="ActivityRunProfileExecutionItemHeader" Sortable="false">
                    <HeaderTemplate></HeaderTemplate>
                    <CellTemplate>
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Href="@($"/activity/item/{context.Item.Id}{(_fromOperations ? "?from=operations" : "")}")">View</MudButton>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ActivityRunProfileExecutionItemHeader" Title="External Id" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="External Id" Name="externalid" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <span class="jim-text-code mud-text-secondary">@(!string.IsNullOrEmpty(context.Item.ExternalIdValue) ? context.Item.ExternalIdValue : "-")</span>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ActivityRunProfileExecutionItemHeader" Title="Display Name" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Display Name" Name="displayname" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.DisplayName))
                        {
                            @context.Item.DisplayName
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ActivityRunProfileExecutionItemHeader" Title="External Object Type" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="External Object Type" Name="objecttype" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.ConnectedSystemObjectType))
                        {
                            <MudChip T="string" Text="@context.Item.ConnectedSystemObjectType" Variant="Variant.Text" Color="@_typeChipColors.GetColor(context.Item.ConnectedSystemObjectType)" />
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ActivityRunProfileExecutionItemHeader" Title="Outcomes" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Outcomes</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @{
                            var outcomes = Helpers.ParseOutcomeSummary(context.Item.OutcomeSummary);
                            var itemErrorType = context.Item.ErrorType;
                            var hasError = itemErrorType is not null and not ActivityRunProfileExecutionItemErrorType.NotSet;
                        }
                        @if (outcomes.Count > 0)
                        {
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                @foreach (var (outcomeType, count) in outcomes)
                                {
                                    <MudTooltip Text="@Helpers.GetOutcomeTypeDisplayName(outcomeType)" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Variant="Variant.Text"
                                                 Color="Helpers.GetOutcomeTypeMudBlazorColor(outcomeType)"
                                                 Class="jim-stat-chip">
                                            @Helpers.GetOutcomeTypeDisplayName(outcomeType)@(count > 1 ? $" ×{count}" : "")
                                        </MudChip>
                                    </MudTooltip>
                                }
                                @if (hasError)
                                {
                                    var errorType = itemErrorType!.Value;
                                    <MudChip T="string" Variant="Variant.Text" Color="Color.Error" Class="jim-stat-chip">
                                        @errorType.ToString().SplitOnCapitalLetters()
                                    </MudChip>
                                }
                            </MudStack>
                        }
                        else if (hasError)
                        {
                            var errorType = itemErrorType!.Value;
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Error" Class="jim-stat-chip">
                                @errorType.ToString().SplitOnCapitalLetters()
                            </MudChip>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @* An empty table means one of three different things, and the message says which: a search that
                   matched nothing, chip filters nothing satisfies, or an Activity that recorded no items at all.
                   The first two carry their own way out. *@
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@($"No Run Profile Execution Items match \"{grid.SearchText}\"")"
                                     SecondaryText="Try a different search term, or clear the search."
                                     ActionText="Clear Search"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else if (HasActiveExecutionItemFilters)
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.FilterAlt"
                                     PrimaryText="No Run Profile Execution Items match the current filters"
                                     SecondaryText="Adjust or clear the filters above to see more items."
                                     ActionText="Clear Filters"
                                     OnAction="ClearExecutionItemFiltersAsync" />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.ReceiptLong"
                                     PrimaryText="This Activity recorded no Run Profile Execution Items"
                                     SecondaryText="Items appear here for every object the run added, updated, joined, projected, exported or failed on." />
                }
            </EmptyContent>
        </VirtualisedDataGrid>
    }

    @if (_childActivityCount > 0)
    {
        <MudText Typo="Typo.h5" Class="mt-5">Child Activities</MudText>
        @* The second grid on this page, so its URL parameters carry their own ca- prefix. Child Activities are
           read oldest first and the range read offers no sort of its own, so no column claims a sort key. *@
        <VirtualisedDataGrid @ref="_childActivitiesGrid" T="Activity"
                             ContainerId="activity-child-activities"
                             UrlParameterPrefix="ca-"
                             StateKey="@Id.ToString()"
                             DefaultSortBy="@ChildActivitySort"
                             LoadWindow="LoadChildActivityWindowAsync"
                             SingularName="Child Activity"
                             PluralName="Child Activities"
                             SearchPlaceholder="Search target, message or status">
            <Columns>
                <TemplateColumn T="Activity" Sortable="false">
                    <HeaderTemplate></HeaderTemplate>
                    <CellTemplate>
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Href="@($"/activity/{context.Item.Id}{(_fromOperations ? "?from=operations" : "")}")">View</MudButton>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="Activity" Title="Type" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Type</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.TargetType.ToString().SplitOnCapitalLetters()
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="Activity" Title="Target" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Target</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.TargetContext) && !string.IsNullOrEmpty(context.Item.TargetName))
                        {
                            <span><strong>@context.Item.TargetContext</strong> → @context.Item.TargetName</span>
                        }
                        else if (!string.IsNullOrEmpty(context.Item.TargetContext))
                        {
                            <span><strong>@context.Item.TargetContext</strong></span>
                        }
                        else if (!string.IsNullOrEmpty(context.Item.TargetName))
                        {
                            <span>@context.Item.TargetName</span>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="Activity" Title="Message" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Message</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.Message))
                        {
                            <span>@context.Item.Message</span>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="Activity" Title="Status" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Status</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetActivityMudBlazorColorForStatus(context.Item.Status)" Class="ml-0">@context.Item.Status.ToString().SplitOnCapitalLetters()</MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="Activity" Title="Started" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Started</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.Executed != default)
                        {
                            var executedLocal = context.Item.Executed.ToLocalTime();
                            <span title="@executedLocal.ToFriendlyDate()">@executedLocal.ToRelativeTime()</span>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="Activity" Title="Duration" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Duration</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @(context.Item.ExecutionTime?.ToAbbreviatedString() ?? "-")
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@($"No Child Activities match \"{grid.SearchText}\"")"
                                     SecondaryText="Try a different search term, or clear the search."
                                     ActionText="Clear Search"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.AccountTree"
                                     PrimaryText="This Activity has no Child Activities"
                                     SecondaryText="Child Activities appear here when an operation spawns work of its own." />
                }
            </EmptyContent>
        </VirtualisedDataGrid>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Guid _loadedId;
    private VirtualisedDataGrid<ActivityRunProfileExecutionItemHeader>? _executionItemsGrid;
    private Activity? _activity;

    /// <summary>
    /// Structured detail for a failure caused by a directory server's certificate, when the Activity carries it.
    /// </summary>
    private ServerCertificateDiagnostic? _serverCertificate;
    private Activity? _parentActivity;
    private ConfigurationChangeDetail? _configChangeDetail;
    private bool _isAdministrator;
    private VirtualisedDataGrid<Activity>? _childActivitiesGrid;
    private int _childActivityCount;
    private ConnectedSystemHeader? _connectedSystemHeader;
    private MetaverseObjectHeader? _metaverseObjectHeader;
    private MetaverseObjectHeader? _initiatorMetaverseObjectHeader;
    private ActivityRunProfileExecutionStats? _activityRunProfileExecutionStats;

    /// <summary>
    /// The excluded Containers this run discarded entries through, named. Loaded only when there are any, which
    /// is every run except those on a Connected System carrying exclusions that covered something it read.
    /// </summary>
    private Dictionary<int, ConnectedSystemContainerSummary> _excludedContainers = new();

    /// <summary>
    /// The steps of this Run Profile execution (#454), refreshed alongside the Activity so the
    /// stepper tracks the run live and still reads correctly on a page opened after it finished.
    /// </summary>
    private IReadOnlyList<ActivityPhase> _phases = [];

    /// <summary>
    /// How far through its own work the running step is, 0 to 1, or null when it counts nothing it
    /// can report. Fills the stepper's connector so the rail reads as one progress bar across the
    /// whole run.
    /// </summary>
    private double? StepProgressFraction => _activity is { Status: ActivityStatus.InProgress, ObjectsToProcess: > 0 }
        ? Math.Clamp((double)_activity.ObjectsProcessed / _activity.ObjectsToProcess, 0d, 1d)
        : null;
    private CancellationTokenSource? _pollCts;
    private readonly SemaphoreSlim _refreshLock = new(1, 1);
    private ActivityEtaEstimate _etaEstimate;
    private DateTime _lastRefreshUtc = DateTime.MinValue;
    private bool _initialisationComplete;
    private readonly TypeChipColorAssigner _typeChipColors = new();

    /// <summary>
    /// The sort key standing for the order the data layer returns Run Profile Execution Items in when no column
    /// has been clicked (their own id, which is insertion order). No header claims it, so the grid shows no sort
    /// arrow over an order the reader did not choose.
    /// </summary>
    private const string DefaultExecutionItemSort = "id";

    /// <summary>
    /// The sort key for the Child Activities grid. The range read that backs it returns children oldest first and
    /// takes no sort parameter, so this names that order rather than offering a choice; no column claims it.
    /// </summary>
    private const string ChildActivitySort = "created";

    /// <summary>
    /// How many Child Activities a search scan reads per round trip. It matches the largest window the data layer
    /// will serve (larger requests are clamped there), so a short chunk reliably means the end of the children
    /// rather than a silently truncated request.
    /// </summary>

    // Object type filter - when chips are selected, the table reloads with the filter applied
    private IReadOnlyCollection<string> _selectedObjectTypes = new List<string>();

    // Error type filter - when chips are selected, the table reloads with the filter applied
    private IReadOnlyCollection<ActivityRunProfileExecutionItemErrorType> _selectedErrorTypes = new List<ActivityRunProfileExecutionItemErrorType>();

    // Outcome type filter - filters RPEIs by outcome types present in their OutcomeSummary
    private IReadOnlyCollection<ActivityRunProfileExecutionItemSyncOutcomeType> _selectedOutcomeTypes = new List<ActivityRunProfileExecutionItemSyncOutcomeType>();

    private bool _fromOperations;

    private List<BreadcrumbItem> _breadcrumbs = new List<BreadcrumbItem>
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Activity", href: "/activity"),
        new("Activity Detail", href: null, disabled: true)
    };

    /// <summary>
    /// Whether this activity records per-object Run Profile Execution Items and so renders the
    /// results section (stats cards, filter chips, items table). True for Run Profile executions
    /// and for Metaverse Object Housekeeping batches (#1020), which reuse the same item model.
    /// </summary>
    private bool ShowsExecutionItems =>
        _activity != null
        && _activity.TargetOperationType == ActivityTargetOperationType.Execute
        && _activity.TargetType is ActivityTargetType.ConnectedSystemRunProfile or ActivityTargetType.MetaverseObjectHousekeeping;

    private bool IsHousekeepingActivity => _activity?.TargetType == ActivityTargetType.MetaverseObjectHousekeeping;

    /// <summary>
    /// Whether this run read entries from the Connected System and threw them away because a Container Scope
    /// exclusion carved them out (#1255).
    /// </summary>
    private bool DiscardedEntriesThroughAnExclusion =>
        _activityRunProfileExecutionStats?.TotalEntriesDiscardedByExclusion > 0;

    /// <summary>
    /// Names the excluded Containers this run discarded entries through, so the panel can show what an
    /// administrator recognises rather than a row of ids.
    /// </summary>
    /// <remarks>
    /// The counts are keyed by Container id because they are a historical record and a Container can be renamed
    /// or moved afterwards. The lookup is skipped entirely when nothing was discarded, which is almost every run,
    /// and it reads a projection rather than loading the Containers themselves.
    /// </remarks>
    private async Task LoadExcludedContainerNamesAsync(JimApplication jim)
    {
        if (!DiscardedEntriesThroughAnExclusion)
        {
            _excludedContainers = new Dictionary<int, ConnectedSystemContainerSummary>();
            return;
        }

        var summaries = await jim.ConnectedSystems.GetConnectedSystemContainerSummariesAsync(
            _activityRunProfileExecutionStats!.EntriesDiscardedByExcludedContainer.Keys.ToList());
        _excludedContainers = summaries.ToDictionary(summary => summary.Id);
    }

    protected override void OnInitialized()
    {
        // Event-driven refresh (issue #202): Activity progress notifications trigger an immediate
        // refresh, so the page reacts in real time rather than waiting for the next polling cycle.
        UiNotifications.ActivityProgressChanged += OnActivityProgressChanged;
        UiNotifications.RealTimeAvailabilityChanged += OnRealTimeAvailabilityChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedId == Id)
            return;

        // Reset state when navigating to a different activity (e.g. parent -> child)
        _initialisationComplete = false;
        _connectedSystemHeader = null;
        _metaverseObjectHeader = null;
        _initiatorMetaverseObjectHeader = null;
        _parentActivity = null;
        _activityRunProfileExecutionStats = null;
        _configChangeDetail = null;
        _childActivityCount = 0;
        _selectedObjectTypes = new List<string>();
        _selectedErrorTypes = new List<ActivityRunProfileExecutionItemErrorType>();
        _selectedOutcomeTypes = new List<ActivityRunProfileExecutionItemSyncOutcomeType>();

        using var jim = JimFactory.Create();
        _activity = await jim.Activities.GetActivityAsync(Id);
        if (_activity == null)
        {
            NavManager.NavigateTo("../");
            return;
        }

        _serverCertificate = ActivityErrorDetail.TryReadServerCertificate(_activity.ErrorDetail);

        // Seed the ETA sample window so the estimate appears as soon as a second sample lands.
        UpdateEtaEstimate(_activity);

        // Determine navigation context from query parameter
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _fromOperations = string.Equals(query["from"], "operations", StringComparison.OrdinalIgnoreCase);

        _breadcrumbs = _fromOperations
            ? new List<BreadcrumbItem>
            {
                new("Home", href: "/", icon: Icons.Material.Filled.Home),
                new("Operations", href: "/admin/operations?t=history"),
                new("Activity Detail", href: null, disabled: true)
            }
            : new List<BreadcrumbItem>
            {
                new("Home", href: "/", icon: Icons.Material.Filled.Home),
                new("Activity", href: "/activity"),
                new("Activity Detail", href: null, disabled: true)
            };

        // Note: These queries run sequentially because EF Core's DbContext is not thread-safe.
        // The main performance win comes from the optimised GROUP BY query in GetActivityRunProfileExecutionStatsAsync.
        if (_activity.ConnectedSystemId.HasValue)
            _connectedSystemHeader = await jim.ConnectedSystems.GetConnectedSystemHeaderAsync(_activity.ConnectedSystemId.Value);

        if (_activity.TargetType is ActivityTargetType.MetaverseObject or ActivityTargetType.ConnectedSystemRunProfile && _activity.MetaverseObjectId != null)
            _metaverseObjectHeader = await jim.Metaverse.GetMetaverseObjectHeaderAsync(_activity.MetaverseObjectId.Value);

        if (_activity.InitiatedByType == ActivityInitiatorType.User && _activity.InitiatedById.HasValue)
            _initiatorMetaverseObjectHeader = await jim.Metaverse.GetMetaverseObjectHeaderAsync(_activity.InitiatedById.Value);

        // Load the parent activity (if any) so the Summary can render its type and target name rather than a bare link.
        if (_activity.ParentActivityId.HasValue)
            _parentActivity = await jim.Activities.GetActivityAsync(_activity.ParentActivityId.Value);

        if (ShowsExecutionItems)
        {
            _activityRunProfileExecutionStats = await jim.Activities.GetActivityRunProfileExecutionStatsAsync(_activity.Id);
            _phases = await jim.Activities.GetActivityPhasesAsync(_activity.Id);
            await LoadExcludedContainerNamesAsync(jim);
        }

        // Only the count is loaded here; the Child Activities table pages its rows from the data layer on demand.
        _childActivityCount = (await jim.Activities.GetChildActivityCountsAsync([_activity.Id])).GetValueOrDefault(_activity.Id);

        // Configuration-change activities carry a versioned snapshot; for administrators, load the diff against the
        // previous version so it renders inline with the shared renderer. Gated to Administrators to match the
        // admin-only Changes tab on the object's own page; the diff is redaction-aware but is still configuration detail.
        if (AuthenticationStateTask != null)
            _isAdministrator = (await AuthenticationStateTask).User.IsInRole("Administrator");

        // The diff is loaded by whichever configuration-object FK the capture linked, not by the activity's own
        // TargetType: granular endpoints record activities typed for the child (an Object Matching Rule, a Run
        // Profile) whose versioned snapshot belongs to the owning Synchronisation Rule or Connected System. The
        // Synchronisation Rule FK is checked first: a rule-scoped capture may sit on an activity that also carries a
        // Connected System id for context, but its version was assigned against the rule. The remaining branches
        // cover every other captured configuration type; their order does not matter since no two of them are ever
        // set on the same activity.
        if (_isAdministrator && _activity.ConfigurationChangeVersion.HasValue)
        {
            var configurationChangeVersion = _activity.ConfigurationChangeVersion.Value;

            if (_activity.SyncRuleId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.SynchronisationRule, _activity.SyncRuleId.Value, configurationChangeVersion);
            else if (_activity.ConnectedSystemId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.ConnectedSystem, _activity.ConnectedSystemId.Value, configurationChangeVersion);
            else if (_activity.ScheduleId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.Schedule, _activity.ScheduleId.Value, configurationChangeVersion);
            else if (_activity.TrustedCertificateId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.TrustedCertificate, _activity.TrustedCertificateId.Value, configurationChangeVersion);
            else if (_activity.ApiKeyId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.ApiKey, _activity.ApiKeyId.Value, configurationChangeVersion);
            else if (_activity.MetaverseObjectTypeId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.MetaverseObjectType, _activity.MetaverseObjectTypeId.Value, configurationChangeVersion);
            else if (_activity.MetaverseAttributeId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.MetaverseAttribute, _activity.MetaverseAttributeId.Value, configurationChangeVersion);
            else if (_activity.RoleId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.Role, _activity.RoleId.Value, configurationChangeVersion);
            else if (_activity.PredefinedSearchId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.PredefinedSearch, _activity.PredefinedSearchId.Value, configurationChangeVersion);
            else if (_activity.ConnectorDefinitionId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.ConnectorDefinition, _activity.ConnectorDefinitionId.Value, configurationChangeVersion);
            else if (_activity.ExampleDataTemplateId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.ExampleDataTemplate, _activity.ExampleDataTemplateId.Value, configurationChangeVersion);
            else if (_activity.ExampleDataSetId.HasValue)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.ExampleDataSet, _activity.ExampleDataSetId.Value, configurationChangeVersion);
            else if (_activity.ServiceSettingKey != null)
                _configChangeDetail = await jim.ChangeHistory.GetConfigurationChangeAsync(ActivityTargetType.ServiceSetting, _activity.ServiceSettingKey, configurationChangeVersion);
        }
        else if (_isAdministrator && !string.IsNullOrEmpty(_activity.ConfigurationChangeSnapshot))
        {
            // A deletion tombstone: the delete recorded an unversioned snapshot on this Activity itself (there is no
            // surviving object or version to look up), so render the deleted object's final captured state directly
            // from it as a whole-object removal.
            _configChangeDetail = jim.ChangeHistory.BuildConfigurationChangeDetailFromDeletionSnapshot(_activity.ConfigurationChangeSnapshot);
        }

        _loadedId = Id;
        _initialisationComplete = true;

        // Start polling while the activity is in progress
        StartPollingIfInProgress();
    }

    // Whether to show the "no configuration snapshot was captured" notice: an administrator is viewing a completed,
    // configuration-changing activity (create, update, import or delete of a Connected System, Synchronisation Rule,
    // Schedule, Service Setting, Metaverse Object Type, Metaverse Attribute, Trusted Certificate, API Key or Role, or
    // one of their granular sub-entities) that carries no snapshot. This branch is only reached when the diff above did
    // not render, so a captured delete shows its tombstone as a whole-object removal above and never falls through to
    // here; the notice covers a delete (or any change) made while tracking was disabled or before it was introduced.
    // An in-progress activity is excluded (it may simply not have captured yet). Predefined Search, Connector
    // Definition and Example Data Template/Set are deliberately excluded: many of their activities predate capture and
    // legitimately lack a snapshot, so the notice would misfire on that legacy data rather than flag a genuine gap.
    private bool ShowNoSnapshotNotice =>
        _isAdministrator
        && _activity != null
        && !_activity.ConfigurationChangeVersion.HasValue
        && _activity.TargetType is ActivityTargetType.ConnectedSystem or ActivityTargetType.SynchronisationRule or ActivityTargetType.Schedule
            or ActivityTargetType.ObjectMatchingRule or ActivityTargetType.ConnectedSystemRunProfile or ActivityTargetType.ServiceSetting
            or ActivityTargetType.MetaverseObjectType or ActivityTargetType.MetaverseAttribute or ActivityTargetType.TrustedCertificate
            or ActivityTargetType.ApiKey or ActivityTargetType.Role
        && _activity.TargetOperationType is ActivityTargetOperationType.Create or ActivityTargetOperationType.Update
            or ActivityTargetOperationType.ImportSchema or ActivityTargetOperationType.ImportHierarchy
            or ActivityTargetOperationType.Delete
        && _activity.Status is ActivityStatus.Complete or ActivityStatus.CompleteWithWarning;

    /// <summary>
    /// Loads one window of this Activity's Run Profile Execution Items, honouring the request's skip-the-count
    /// contract. An Activity can hold millions of items, so the window is read at an absolute offset from the
    /// data layer rather than sliced out of anything held here.
    /// </summary>
    private async Task<VirtualisedWindow<ActivityRunProfileExecutionItemHeader>> LoadExecutionItemWindowAsync(
        VirtualisedWindowRequest request, CancellationToken cancellationToken)
    {
        // Each chip filter is null when nothing is selected, which the data layer reads as "show all".
        IEnumerable<string>? objectTypeFilter = _selectedObjectTypes.Count > 0 ? _selectedObjectTypes : null;
        IEnumerable<ActivityRunProfileExecutionItemErrorType>? errorTypeFilter = _selectedErrorTypes.Count > 0 ? _selectedErrorTypes : null;
        IEnumerable<ActivityRunProfileExecutionItemSyncOutcomeType>? outcomeTypeFilter = _selectedOutcomeTypes.Count > 0 ? _selectedOutcomeTypes : null;

        using var jim = JimFactory.Create();
        var result = await jim.Activities.GetActivityRunProfileExecutionItemHeadersRangeAsync(
            Id,
            request.StartIndex,
            request.Count,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            objectTypeFilter,
            errorTypeFilter,
            outcomeTypeFilter,
            includeTotalCount: request.IncludeTotalCount);

        // A null total means the count was not asked for, never that nothing matched; it is passed through as
        // null so the grid keeps the total it already holds.
        return new VirtualisedWindow<ActivityRunProfileExecutionItemHeader>(result.Results, result.TotalResults);
    }

    /// <summary>
    /// Loads one window of this Activity's direct Child Activities, search included: the read searches the whole
    /// set in the database, so a term matches children this window has never fetched.
    /// </summary>
    private async Task<VirtualisedWindow<Activity>> LoadChildActivityWindowAsync(
        VirtualisedWindowRequest request, CancellationToken cancellationToken)
    {
        using var jim = JimFactory.Create();
        var result = await jim.Activities.GetChildActivitiesRangeAsync(
            Id, request.StartIndex, request.Count, request.SearchText, request.IncludeTotalCount);

        // A null total means the count was not asked for, never that nothing matched; it is passed through as
        // null so the grid keeps the total it already holds.
        return new VirtualisedWindow<Activity>(result.Results, result.TotalResults);
    }

    /// <summary>
    /// Whether any Run Profile Execution Item chip filter has been narrowed from its default, so the empty state
    /// can offer clearing them. The grid's search box is judged separately, because a search that matched nothing
    /// has a more specific way out.
    /// </summary>
    private bool HasActiveExecutionItemFilters =>
        _selectedObjectTypes.Count > 0 || _selectedErrorTypes.Count > 0 || _selectedOutcomeTypes.Count > 0;

    private async Task OnObjectTypeFilterChanged(IReadOnlyCollection<string> selectedTypes)
    {
        _selectedObjectTypes = selectedTypes;
        await ApplyExecutionItemFilterChangeAsync();
    }

    private async Task OnErrorTypeFilterChanged(IReadOnlyCollection<ActivityRunProfileExecutionItemErrorType> selectedTypes)
    {
        _selectedErrorTypes = selectedTypes;
        await ApplyExecutionItemFilterChangeAsync();
    }

    private async Task OnOutcomeTypeFilterChanged(IReadOnlyCollection<ActivityRunProfileExecutionItemSyncOutcomeType> selectedTypes)
    {
        _selectedOutcomeTypes = selectedTypes;
        await ApplyExecutionItemFilterChangeAsync();
    }

    /// <summary>
    /// Clears every chip filter, offered as the way out by the empty state when the current filters matched
    /// nothing.
    /// </summary>
    private async Task ClearExecutionItemFiltersAsync()
    {
        _selectedObjectTypes = new List<string>();
        _selectedErrorTypes = new List<ActivityRunProfileExecutionItemErrorType>();
        _selectedOutcomeTypes = new List<ActivityRunProfileExecutionItemSyncOutcomeType>();
        await ApplyExecutionItemFilterChangeAsync();
    }

    /// <summary>
    /// Applies a chip filter change: the match set is different, so the total the toolbar count and the scroll
    /// area are sized from must be re-counted, and the reader's position describes a list that no longer exists.
    /// </summary>
    private async Task ApplyExecutionItemFilterChangeAsync()
    {
        if (_executionItemsGrid == null)
            return;

        await _executionItemsGrid.ResetScrollAsync();
        await _executionItemsGrid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Returns the object types that have at least one RPEI in this activity, ordered by name.
    /// </summary>
    private IEnumerable<KeyValuePair<string, int>> GetAvailableObjectTypes()
    {
        if (_activityRunProfileExecutionStats == null)
            return Enumerable.Empty<KeyValuePair<string, int>>();

        return _activityRunProfileExecutionStats.ObjectTypeCounts
            .OrderBy(x => x.Key);
    }

    /// <summary>
    /// Checks if an object type is currently selected in the filter.
    /// </summary>
    private bool IsObjectTypeSelected(string objectType)
    {
        return _selectedObjectTypes.Contains(objectType);
    }

    /// <summary>
    /// Returns the error types that have at least one RPEI in this activity, ordered by count descending.
    /// </summary>
    private IEnumerable<KeyValuePair<ActivityRunProfileExecutionItemErrorType, int>> GetAvailableErrorTypes()
    {
        if (_activityRunProfileExecutionStats == null)
            return Enumerable.Empty<KeyValuePair<ActivityRunProfileExecutionItemErrorType, int>>();

        return _activityRunProfileExecutionStats.ErrorTypeCounts
            .OrderByDescending(x => x.Value);
    }

    /// <summary>
    /// Checks if an error type is currently selected in the filter.
    /// </summary>
    private bool IsErrorTypeSelected(ActivityRunProfileExecutionItemErrorType errorType)
    {
        return _selectedErrorTypes.Contains(errorType);
    }

    /// <summary>
    /// Returns the outcome types that have at least one occurrence in this activity, with their counts.
    /// Derived from the stats model. Ordered logically: Import → Sync → Export.
    /// </summary>
    private IEnumerable<(ActivityRunProfileExecutionItemSyncOutcomeType Type, int Count)> GetAvailableOutcomeTypes()
    {
        if (_activityRunProfileExecutionStats == null)
            yield break;

        var s = _activityRunProfileExecutionStats;

        // Import outcomes
        if (s.TotalCsoAdds > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.CsoAdded, s.TotalCsoAdds);
        if (s.TotalCsoUpdates > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.CsoUpdated, s.TotalCsoUpdates);
        // Import-phase: DeletionDetected. Sync-phase: CsoDeleted. Show the appropriate type per run type.
        if (s.TotalCsoDeletes > 0 && IsImportRun()) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.DeletionDetected, s.TotalCsoDeletes);
        if (s.TotalCsoDeletes > 0 && IsSyncRun()) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.CsoDeleted, s.TotalCsoDeletes);

        // Metaverse Object deletions (housekeeping batches)
        if (s.TotalMvoDeleted > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.MvoDeleted, s.TotalMvoDeleted);

        // Sync outcomes
        if (s.TotalProjections > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.Projected, s.TotalProjections);
        if (s.TotalJoins > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.Joined, s.TotalJoins);
        if (s.TotalAttributeFlows > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.AttributeFlow, s.TotalAttributeFlows);
        if (s.TotalDisconnections > 0 || s.TotalDisconnectedOutOfScope > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.Disconnected, s.TotalDisconnections + s.TotalDisconnectedOutOfScope);
        if (s.TotalDriftCorrections > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.DriftCorrection, s.TotalDriftCorrections);

        // Outbound sync outcomes
        if (s.TotalProvisioned > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.Provisioned, s.TotalProvisioned);
        if (s.TotalPendingExports > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.PendingExportCreated, s.TotalPendingExports);

        // Export outcomes
        if (s.TotalExported > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.Exported, s.TotalExported);
        if (s.TotalDeprovisioned > 0) yield return (ActivityRunProfileExecutionItemSyncOutcomeType.Deprovisioned, s.TotalDeprovisioned);
    }

    /// <summary>
    /// Checks if an outcome type is currently selected in the filter.
    /// </summary>
    private bool IsOutcomeTypeSelected(ActivityRunProfileExecutionItemSyncOutcomeType outcomeType)
    {
        return _selectedOutcomeTypes.Contains(outcomeType);
    }

    /// <summary>
    /// Checks if this is an Import run (Full or Delta).
    /// Falls back to checking if import stats are populated when run type is NotSet.
    /// </summary>
    private bool IsImportRun()
    {
        // Housekeeping batches have no run type; the heuristics below must not classify them.
        if (IsHousekeepingActivity)
            return false;

        var runType = _activity?.ConnectedSystemRunType;
        if (runType is ConnectedSystemRunType.FullImport or ConnectedSystemRunType.DeltaImport)
            return true;

        // Fallback: check if this looks like an import based on stats or target name
        if (runType is null or ConnectedSystemRunType.NotSet)
        {
            // Check if the target name contains "Import" or if import stats exist
            if (_activity?.TargetName?.Contains("Import", StringComparison.OrdinalIgnoreCase) == true)
                return true;
            // If there are CSO adds/updates/deletes but no sync or export stats, it's likely import
            if (_activityRunProfileExecutionStats != null &&
                (_activityRunProfileExecutionStats.TotalCsoAdds > 0 ||
                 _activityRunProfileExecutionStats.TotalCsoUpdates > 0 ||
                 _activityRunProfileExecutionStats.TotalCsoDeletes > 0) &&
                _activityRunProfileExecutionStats.TotalProjections == 0)
                return true;
        }

        return false;
    }

    /// <summary>
    /// Checks if this is a Sync run (Full or Delta).
    /// </summary>
    private bool IsSyncRun()
    {
        if (IsHousekeepingActivity)
            return false;

        var runType = _activity?.ConnectedSystemRunType;
        if (runType is ConnectedSystemRunType.FullSynchronisation or ConnectedSystemRunType.DeltaSynchronisation)
            return true;

        // Fallback: check if this looks like a sync based on stats or target name
        if (runType is null or ConnectedSystemRunType.NotSet)
        {
            if (_activity?.TargetName?.Contains("Sync", StringComparison.OrdinalIgnoreCase) == true)
                return true;
            if (_activityRunProfileExecutionStats != null &&
                (_activityRunProfileExecutionStats.TotalProjections > 0 ||
                 _activityRunProfileExecutionStats.TotalJoins > 0 ||
                 _activityRunProfileExecutionStats.TotalAttributeFlows > 0 ||
                 _activityRunProfileExecutionStats.TotalDisconnections > 0))
                return true;
        }

        return false;
    }

    /// <summary>
    /// Checks if this is an Export run.
    /// </summary>
    private bool IsExportRun()
    {
        if (IsHousekeepingActivity)
            return false;

        var runType = _activity?.ConnectedSystemRunType;
        if (runType == ConnectedSystemRunType.Export)
            return true;

        // Fallback: check if this looks like an export based on stats or target name
        if (runType is null or ConnectedSystemRunType.NotSet)
        {
            if (_activity?.TargetName?.Contains("Export", StringComparison.OrdinalIgnoreCase) == true)
                return true;
            if (_activityRunProfileExecutionStats != null &&
                (_activityRunProfileExecutionStats.TotalExported > 0 ||
                 _activityRunProfileExecutionStats.TotalDeprovisioned > 0))
                return true;
        }

        return false;
    }

    /// <summary>
    /// Gets the unchanged count safely.
    /// </summary>
    private int GetUnchangedCount()
    {
        return _activityRunProfileExecutionStats?.TotalUnchanged ?? 0;
    }

    /// <summary>
    /// Converts a MudBlazor Color to its CSS variable name suffix.
    /// </summary>
    private static string GetColorCssName(Color color)
    {
        return color switch
        {
            Color.Primary => "primary",
            Color.Secondary => "secondary",
            Color.Tertiary => "tertiary",
            Color.Info => "info",
            Color.Success => "success",
            Color.Warning => "warning",
            Color.Error => "error",
            Color.Dark => "dark",
            Color.Surface => "surface",
            _ => "default"
        };
    }

    /// <summary>
    /// Whether to show the target name in the page title. Some activity types have self-descriptive
    /// type names that make the target name redundant (e.g. HistoryRetentionCleanup).
    /// </summary>
    private bool ShowTargetInTitle()
    {
        return _activity?.TargetType != ActivityTargetType.HistoryRetentionCleanup;
    }

    /// <summary>
    /// Gets the display text for the target, including context if available.
    /// </summary>
    private string GetTargetDisplayText()
    {
        if (_activity == null)
            return "(no name)";

        var targetName = !string.IsNullOrEmpty(_activity.TargetName) ? _activity.TargetName : "(no name)";

        if (!string.IsNullOrEmpty(_activity.TargetContext))
            return $"{_activity.TargetContext} → {targetName}";

        return targetName;
    }

    private void StartPollingIfInProgress()
    {
        if (_activity?.Status != ActivityStatus.InProgress)
            return;

        // Cancel any existing polling
        _pollCts?.Cancel();
        _pollCts = new CancellationTokenSource();
        var token = _pollCts.Token;

        // Polling fallback (issue #202): push notifications drive refreshes in real time, so while
        // they are flowing this loop is only a slow reconciliation net; when they are unavailable
        // it polls at the pre-push cadence so progress keeps updating, just with higher latency.
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    var delay = UiNotifications.IsRealTimeAvailable ? TimeSpan.FromSeconds(30) : TimeSpan.FromSeconds(3);
                    await Task.Delay(delay, token);
                    await RefreshActivityAsync();

                    // Stop polling once the activity has completed
                    if (_activity?.Status != ActivityStatus.InProgress)
                        break;
                }
                catch (OperationCanceledException)
                {
                    // Polling was cancelled (navigation away or page dispose); exit quietly.
                    break;
                }
            }
        }, token);
    }

    /// <summary>
    /// Reloads the Activity and its dependent live data (ETA estimate, child count, stats).
    /// Guarded so overlapping triggers (push notifications and the reconciliation poll) skip
    /// rather than queue.
    /// </summary>
    private async Task RefreshActivityAsync()
    {
        if (!await _refreshLock.WaitAsync(0))
            return;

        try
        {
            using var jim = JimFactory.Create();
            var updated = await jim.Activities.GetActivityAsync(Id);
            if (updated == null)
                return;

            _activity = updated;
            _lastRefreshUtc = DateTime.UtcNow;
            UpdateEtaEstimate(updated);

            // Refresh child activities and stats alongside the activity itself
            _childActivityCount = (await jim.Activities.GetChildActivityCountsAsync([updated.Id])).GetValueOrDefault(updated.Id);
            if (ShowsExecutionItems)
            {
                _activityRunProfileExecutionStats = await jim.Activities.GetActivityRunProfileExecutionStatsAsync(updated.Id);
                _phases = await jim.Activities.GetActivityPhasesAsync(updated.Id);
                await LoadExcludedContainerNamesAsync(jim);
            }

            await InvokeAsync(StateHasChanged);

            // The Child Activities grid streams its rows from the data layer; ask it to re-fetch the windows in
            // view, re-counting as it goes because a running Activity can spawn further children.
            if (_childActivitiesGrid != null)
                await InvokeAsync(() => _childActivitiesGrid.RefreshAsync(invalidateTotals: true));
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException or ObjectDisposedException)
        {
            // Transient failure reading the activity: a database error, an EF Core operation in a bad state,
            // or the application scope disposed mid-refresh during navigation. Skip this refresh.
        }
        finally
        {
            _refreshLock.Release();
        }
    }

    /// <summary>
    /// Takes the administrator to the Connected System's settings once they have trusted the certificate, which is
    /// where they can re-run the connection test. An Activity cannot re-run one itself, and leaving them on a
    /// finished failure with no next step is the gap this whole action exists to close.
    /// </summary>
    private void ReloadAfterTrustingCertificateAsync()
    {
        if (_activity?.ConnectedSystemId is { } connectedSystemId)
            NavManager.NavigateTo($"/admin/connected-systems/{connectedSystemId}/?t=settings");
    }

    /// <summary>
    /// Feeds the shared ETA tracker while the Activity is in progress and releases its state once
    /// the run has finished, mirroring the progress API endpoint's behaviour so both surfaces
    /// derive the estimate from the same sample history.
    /// </summary>
    private void UpdateEtaEstimate(Activity activity)
    {
        if (activity.Status == ActivityStatus.InProgress)
        {
            _etaEstimate = EtaTracker.RecordSample(activity.Id, activity.ObjectsProcessed, activity.ObjectsToProcess);
            return;
        }

        if (activity.Status.IsTerminal())
            EtaTracker.Remove(activity.Id);
        _etaEstimate = default;
    }

    private void OnActivityProgressChanged(Guid activityId)
    {
        if (_activity == null)
            return;

        // Always refresh for this Activity's own updates. Other Activities' updates matter here
        // only when this Activity has children whose progress is rendered on this page; those
        // refreshes are rate-limited so a busy system does not hammer the page with unrelated work.
        var isSelf = activityId == Id;
        var mayBeChildUpdate = _childActivityCount > 0
            && _activity.Status == ActivityStatus.InProgress
            && DateTime.UtcNow - _lastRefreshUtc >= TimeSpan.FromSeconds(2);
        if (!isSelf && !mayBeChildUpdate)
            return;

        TriggerNotificationRefresh();
    }

    private void OnRealTimeAvailabilityChanged(bool available)
    {
        // On loss or recovery of real-time notifications, refresh immediately: on loss the last
        // notification may have been missed; on recovery the state may be stale.
        TriggerNotificationRefresh();
    }

    private void TriggerNotificationRefresh()
    {
        _ = Task.Run(async () =>
        {
            try
            {
                await RefreshActivityAsync();
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // Notification-triggered refreshes are best-effort; the reconciliation poll covers gaps.
            }
        });
    }

    public void Dispose()
    {
        UiNotifications.ActivityProgressChanged -= OnActivityProgressChanged;
        UiNotifications.RealTimeAvailabilityChanged -= OnRealTimeAvailabilityChanged;
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }
}
