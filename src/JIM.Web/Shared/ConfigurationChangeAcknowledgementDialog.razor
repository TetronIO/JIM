@* Thin surface over the shared ConsequenceConfirmationDialog, composing it from a configuration change      *@
@* preflight: what is changing, what the destructive parts of it will do, and the reminder that a Full       *@
@* Synchronisation is what makes it take effect. Every sync-affecting save surface shows this same dialog,   *@
@* so the experience does not vary by page. It is replaced per surface by the preview-driven confirmation    *@
@* as each adapter lands. See engineering/plans/doing/CONFIGURATION_CHANGE_PREVIEW.md (Phase 2, FR17).       *@

@* The verdict and the counts are the same answer twice, so only one of them is ever shown. The sentence wins where *@
@* there is one: an administrator deciding whether to save reads "2 objects would become eligible for deletion"     *@
@* faster than they read a two-row table, and the counts remain for surfaces whose adapter has not landed yet.      *@
<ConsequenceConfirmationDialog LeadingContent="@RenderVerdict"
                               Consequences="@ConfigurationChangePreflightConsequences.For(Preflight)"
                               Counts="@(Verdict == null ? Counts : [])"
                               AdditionalContent="@RenderChanges"
                               ConfirmButtonText="Save changes"
                               BusyText="Saving..."
                               ConfirmButtonColour="@(Preflight.IsDestructive ? Color.Error : Color.Warning)" />

@code {
    /// <summary>
    /// The evaluated change. Only ever passed here when it requires acknowledgement; the caller decides that.
    /// </summary>
    [Parameter]
    public ConfigurationChangePreflight Preflight { get; set; } = ConfigurationChangePreflight.None;

    /// <summary>
    /// The kind of object being changed, e.g. "Synchronisation Rule". Title Case, as a JIM domain entity name.
    /// </summary>
    [Parameter]
    public string ObjectTypeLabel { get; set; } = "configuration";

    /// <summary>
    /// The object's own name, rendered in the accent colour so it stands out from the label beside it.
    /// </summary>
    [Parameter]
    public string? ObjectName { get; set; }

    /// <summary>
    /// What a Configuration Change Preview found this change would do, as counts (#827). Empty where no preview was
    /// run, or where the surface has no adapter yet, in which case the dialog is exactly what it was before.
    ///
    /// This is the difference between "you are changing the Deletion Rule" and "you are changing the Deletion Rule,
    /// and 4,812 Metaverse Objects become eligible for deletion when you do". Only the second is something an
    /// administrator can meaningfully consent to.
    /// </summary>
    [Parameter]
    public IReadOnlyList<ImpactCount> Counts { get; set; } = [];

    /// <summary>
    /// The same finding as a sentence, worst consequence first (#1275). Where a surface supplies one it replaces
    /// <see cref="Counts"/> rather than joining it, because the two state the same numbers.
    /// </summary>
    [Parameter]
    public PreviewVerdict? Verdict { get; set; }

    private RenderFragment? RenderVerdict => Verdict is not { } verdict
        ? null
        : @<MudAlert Severity="@verdict.Severity" Variant="Variant.Outlined" data-testid="jim-acknowledgement-verdict">
              <MudText Typo="Typo.body1"><b>@verdict.Lead</b></MudText>
              @if (!string.IsNullOrEmpty(verdict.Detail))
              {
                  <MudText Typo="Typo.body2" Class="mt-1">@verdict.Detail</MudText>
              }
              <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">From the preview.</MudText>
          </MudAlert>;

    // A change touching dozens of properties is real (a scoping rewrite, a bulk mapping edit); listing every one
    // turns the dialog into a wall nobody reads. The most consequential lead, and the tail is counted.
    private const int MaxListedChanges = 12;

    private RenderFragment RenderChanges => @<div>
        <MudText Typo="Typo.subtitle2" Class="mb-1">
            @(Preflight.Items.Count == 1 ? "Change to" : "Changes to") @ObjectTypeLabel:
            <span class="mud-primary-text">@ObjectName</span>
        </MudText>
        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Outlined="true">
            <tbody>
                @foreach (var item in Preflight.Items.Take(MaxListedChanges))
                {
                    <tr>
                        <td>
                            @item.Label
                            @if (item.Class == ConfigurationChangeClass.Destructive)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" Class="ml-1" Style="vertical-align: text-bottom;" />
                            }
                        </td>
                        <td class="text-right">
                            @if (item.IsCollectionItem)
                            {
                                @* A whole item joining or leaving a collection. There is no before-and-after pair to *@
                                @* show: the label names it, and this says which way it went.                        *@
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    @(item.ChangeType == ConfigurationDiffChangeType.Added ? "Added" : "Removed")
                                </MudText>
                            }
                            else if (item.OldDisplayValue == null && item.NewDisplayValue == null)
                            {
                                @* A secret is reported as changed and never by value. *@
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Changed</MudText>
                            }
                            else
                            {
                                <TextValueDisplay Value="@item.OldDisplayValue" />
                                <MudIcon Icon="@Icons.Material.Filled.ArrowRightAlt" Size="Size.Small" Class="mx-1" Style="vertical-align: text-bottom;" />
                                <TextValueDisplay Value="@item.NewDisplayValue" />
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
        @if (Preflight.Items.Count > MaxListedChanges)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                and @((Preflight.Items.Count - MaxListedChanges).ToString("N0")) more change(s).
            </MudText>
        }
        @* Guidance rather than a warning: nothing has gone wrong, but saving alone changes nothing that already exists. *@
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
            Saving does not apply this to existing objects. Run a Full Synchronisation for the Connected Systems
            concerned to put it into effect.
        </MudAlert>
    </div>;

    /// <summary>
    /// Asks the administrator to acknowledge the change, returning true when the save should go ahead. A change that
    /// needs no acknowledgement (cosmetic, unchanged, a create, or one JIM cannot judge) returns true without showing
    /// anything, so callers can invoke this unconditionally on every save path.
    /// </summary>
    /// <param name="dialogService">The dialog service to show the acknowledgement with.</param>
    /// <param name="preflight">The evaluated change.</param>
    /// <param name="objectTypeLabel">The kind of object being changed, e.g. "Metaverse Object Type".</param>
    /// <param name="objectName">The object's own name.</param>
    /// <param name="counts">
    /// What a Configuration Change Preview found the change would do, where one was run. Optional: a preview is an
    /// affordance, not a precondition, and every surface without an adapter passes nothing.
    /// </param>
    /// <param name="verdict">
    /// The same finding as a sentence, where the surface has one. Supplying it suppresses the counts table, because
    /// the two state the same numbers.
    /// </param>
    public static async Task<bool> ConfirmAsync(IDialogService dialogService, ConfigurationChangePreflight preflight,
        string objectTypeLabel, string? objectName, IReadOnlyList<ImpactCount>? counts = null,
        PreviewVerdict? verdict = null)
    {
        ArgumentNullException.ThrowIfNull(dialogService);
        ArgumentNullException.ThrowIfNull(preflight);

        if (!preflight.RequiresAcknowledgement)
            return true;

        var parameters = new DialogParameters<ConfigurationChangeAcknowledgementDialog>
        {
            { x => x.Preflight, preflight },
            { x => x.ObjectTypeLabel, objectTypeLabel },
            { x => x.ObjectName, objectName },
            { x => x.Counts, counts ?? [] },
            { x => x.Verdict, verdict }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        // "Confirm a change to object removal" holds whichever way a destructive property is being moved, which
        // "Confirm a destructive change" does not: turning deletion off is the same class of change.
        var title = preflight.IsDestructive ? "Confirm a change to object removal" : "Confirm a configuration change";
        var dialog = await dialogService.ShowAsync<ConfigurationChangeAcknowledgementDialog>(title, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false };
    }
}
