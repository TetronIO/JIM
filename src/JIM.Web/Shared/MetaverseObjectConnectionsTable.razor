@* The Metaverse Object's Connections tab table (#1519): one row per Connected System Object joined to the
   Metaverse Object, its role, its derived State and a per-row Preview Sync. A component of its own
   (rather than inline markup on Types/View.razor) so the State chip and colour mapping have exactly
   one definition, reusable on the Connector Space list per D-S7, and so the shape is bUnit-testable.
   Each row expands to explain why the connection exists (#348): how it joined and its scoping now. *@

@if (IsLoading)
{
    <MudProgressLinear Indeterminate="true" Class="my-3" />
}
else if (IsLoaded && Connections.Count == 0)
{
    <MudPaper Outlined="true" Elevation="0" Class="jim-empty-state-panel">
        <TableEmptyState Icon="@Icons.Material.Filled.Hub"
                         PrimaryText="This Metaverse Object has no Connected System Objects joined to it." />
    </MudPaper>
}
else if (IsLoaded)
{
    <MudTable Items="Connections" Hover="true" Dense="@Dense" Outlined="true" Elevation="0" data-testid="jim-mvo-connections-table">
        <ToolBarContent>
            <TableDensityToggle Dense="@Dense" DenseChanged="@DenseChanged" />
            <TableObjectCount Count="@Connections.Count" SingularName="connection" PluralName="connections" ShowSeparator="true" />
        </ToolBarContent>
        <HeaderContent>
            <MudTh Class="jim-expand-column"></MudTh>
            <MudTh><MudTableSortLabel T="MetaverseObjectConnectionExplanation" SortBy="@(c => c.ConnectedSystemName)" InitialDirection="SortDirection.Ascending">Connected System</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="MetaverseObjectConnectionExplanation" SortBy="@(c => c.DisplayName)">Object</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="MetaverseObjectConnectionExplanation" SortBy="@(c => GetRoleSortKey(c))">Role</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="MetaverseObjectConnectionExplanation" SortBy="@(c => c.JoinType)">Join</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="MetaverseObjectConnectionExplanation" SortBy="@(c => c.State)">State</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel T="MetaverseObjectConnectionExplanation" SortBy="@(c => c.LastSynchronised ?? DateTime.MinValue)">Last synchronised</MudTableSortLabel></MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="jim-expand-column">
                @{ var expanded = ExpandedIds.Contains(context.ConnectedSystemObjectId); }
                <MudIconButton Icon="@(expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                               Size="Size.Small" aria-expanded="@(expanded ? "true" : "false")"
                               aria-label="@($"Why this Metaverse Object is connected to {context.ConnectedSystemName}")"
                               OnClick="@(() => ToggleExpanded(context))"
                               data-testid="jim-mvo-connection-expand" />
            </MudTd>
            <MudTd DataLabel="Connected System">
                <MudLink Href="@Utilities.GetConnectedSystemHref(context.ConnectedSystemId)">@context.ConnectedSystemName</MudLink>
            </MudTd>
            <MudTd DataLabel="Object">
                <MudLink Href="@Utilities.GetConnectedSystemObjectHref(context.ConnectedSystemId, context.ConnectedSystemObjectId)">
                    @context.DisplayName
                </MudLink>
            </MudTd>
            <MudTd DataLabel="Role">
                <MudStack Row="true" Spacing="1">
                    @if (context.IsSource)
                    {
                        <MudChip T="string" Variant="Variant.Text" Color="Color.Info" Class="ma-0">Source</MudChip>
                    }
                    @if (context.IsTarget)
                    {
                        <MudChip T="string" Variant="Variant.Text" Color="Color.Secondary" Class="ma-0">Target</MudChip>
                    }
                    @if (!context.IsSource && !context.IsTarget)
                    {
                        <EmptyValue />
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Join">
                <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetJoinTypeColor(context.JoinType)" Class="ma-0">
                    @context.JoinType
                </MudChip>
            </MudTd>
            <MudTd DataLabel="State">
                <MudStack Spacing="0">
                    <ConnectionStateChip State="context.State" />
                    @if (context.State == ConnectedSystemObjectConnectionState.UpdatePending && context.PendingAttributeChangeCount is { } count)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @count attribute@(count == 1 ? "" : "s")
                        </MudText>
                    }
                </MudStack>
            </MudTd>
            <MudTd DataLabel="Last synchronised">
                @if (context.LastSynchronised.HasValue)
                {
                    <MudTooltip Text="@context.LastSynchronised.Value.ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                        <span>@context.LastSynchronised.Value.ToRelativeTime()</span>
                    </MudTooltip>
                }
                else
                {
                    <EmptyValue />
                }
            </MudTd>
            <MudTd>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" DropShadow="false"
                           StartIcon="@Icons.Material.Filled.Visibility"
                           Disabled="@PreviewLoading"
                           OnClick="@(() => OnPreview.InvokeAsync(context))"
                           data-testid="jim-mvo-connection-preview">Preview Sync</MudButton>
            </MudTd>
        </RowTemplate>
        <ChildRowContent>
            @if (ExpandedIds.Contains(context.ConnectedSystemObjectId))
            {
                <MudTr>
                    <td colspan="8" class="jim-connection-detail-cell">
                        <MetaverseObjectConnectionDetail Connection="context" EvaluatedAt="EvaluatedAt" />
                    </td>
                </MudTr>
            }
        </ChildRowContent>
    </MudTable>
}

@code {
    /// <summary>
    /// Whether the connections are still loading (first open of the tab).
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Whether the connections have finished loading at least once. Distinct from
    /// <see cref="Connections"/> being empty, so a legitimate "no connections" result is not confused
    /// with "not loaded yet".
    /// </summary>
    [Parameter]
    public bool IsLoaded { get; set; }

    /// <summary>
    /// The rows to render.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<MetaverseObjectConnectionExplanation> Connections { get; set; } = [];

    /// <summary>
    /// When the connections' scoping was evaluated: one instant for the whole tab, shown in each expansion.
    /// </summary>
    [Parameter]
    public DateTime? EvaluatedAt { get; set; }

    /// <summary>
    /// The connections the reader has expanded, by Connected System Object id. The page's, so it belongs to the
    /// object on screen and is gone with it (see <c>MetaverseObjectViewState</c>); this table adds and removes ids.
    /// </summary>
    [Parameter]
    public ISet<Guid> ExpandedIds { get; set; } = new HashSet<Guid>();

    /// <summary>
    /// Compact or normal row spacing. The page's, since it holds the reader's preference for this tab's tables.
    /// </summary>
    [Parameter]
    public bool Dense { get; set; } = true;

    /// <summary>
    /// Raised when the reader toggles the row spacing.
    /// </summary>
    [Parameter]
    public EventCallback<bool> DenseChanged { get; set; }

    /// <summary>
    /// Whether a row's Preview Sync is currently running (disables every row's button, since only one
    /// preview is shown at a time).
    /// </summary>
    [Parameter]
    public bool PreviewLoading { get; set; }

    /// <summary>
    /// Raised with the row's connection when its Preview Sync button is clicked.
    /// </summary>
    [Parameter]
    public EventCallback<MetaverseObjectConnection> OnPreview { get; set; }

    private void ToggleExpanded(MetaverseObjectConnectionExplanation connection)
    {
        if (!ExpandedIds.Remove(connection.ConnectedSystemObjectId))
            ExpandedIds.Add(connection.ConnectedSystemObjectId);
    }

    /// <summary>
    /// Sort key for the Role column: sources before targets, and a connection that is both sorts with
    /// the sources, so a sort by role reads as "where does this Metaverse Object come from, then where does it go".
    /// </summary>
    private static string GetRoleSortKey(MetaverseObjectConnectionExplanation connection) =>
        (connection.IsSource, connection.IsTarget) switch
        {
            (true, true) => "1 source and target",
            (true, false) => "0 source",
            (false, true) => "2 target",
            _ => "3 none"
        };
}
