@* ─── Schedule Summary (admin-only) ─── *@
@* Context is renamed because the grid's own cell templates use "context"; AuthorizeView would otherwise claim
   the name for the authentication state and the two would collide. *@
<AuthorizeView Roles="Administrator" Context="auth">
    <MudText Typo="Typo.h5" Class="mt-8">Schedules</MudText>
    @if (_dataLoaded)
    {
        @* Schedules are a small configuration list, already loaded whole for the Getting Started checklist above,
           so the grid slices its windows from memory rather than growing a database range read. *@
        <VirtualisedDataGrid T="Schedule"
                             ContainerId="home-schedule-list"
                             UrlParameterPrefix="sc-"
                             DefaultSortBy="name"
                             LoadWindow="LoadScheduleWindowAsync"
                             SingularName="Schedule"
                             PluralName="Schedules"
                             SearchPlaceholder="Search Schedules"
                             RowClicked="HandleScheduleRowClicked">
            <Columns>
                <TemplateColumn Title="Name" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Name" Name="name" />
                    </HeaderTemplate>
                    <CellTemplate Context="cell">
                        <MudText Typo="Typo.body1">@cell.Item.Name</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Trigger" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Trigger" Name="trigger" />
                    </HeaderTemplate>
                    <CellTemplate Context="cell">
                        @if (cell.Item.TriggerType == ScheduleTriggerType.Cron)
                        {
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Info"
                                     Icon="@Icons.Material.Filled.Schedule">
                                @GetScheduleDescription(cell.Item)
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Default"
                                     Icon="@Icons.Material.Filled.TouchApp">
                                Manual
                            </MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Last Run" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Last Run" Name="lastrun" />
                    </HeaderTemplate>
                    <CellTemplate Context="cell">
                        @if (cell.Item.LastRunTime.HasValue)
                        {
                            var lastRun = cell.Item.LastRunTime.Value.ToLocalTime();
                            <MudTooltip Text="@lastRun.ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                                <MudText Typo="Typo.body1">@lastRun.ToRelativeTime()</MudText>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body1" Class="mud-text-disabled">Never</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Next Run" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Next Run" Name="nextrun" />
                    </HeaderTemplate>
                    <CellTemplate Context="cell">
                        @if (cell.Item.NextRunTime.HasValue && cell.Item.IsEnabled && cell.Item.TriggerType == ScheduleTriggerType.Cron)
                        {
                            var nextRun = cell.Item.NextRunTime.Value.ToLocalTime();
                            <MudTooltip Text="@nextRun.ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                                <MudText Typo="Typo.body1">@nextRun.ToRelativeTime()</MudText>
                            </MudTooltip>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Status" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Status" Name="status" />
                    </HeaderTemplate>
                    <CellTemplate Context="cell">
                        @if (cell.Item.IsEnabled)
                        {
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Success">Enabled</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Default">Disabled</MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@($"No Schedules match \"{grid.SearchText}\"")"
                                     SecondaryText="Try a different search term, or clear the search."
                                     ActionText="Clear Search"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Outlined.Schedule"
                                     PrimaryText="No Schedules have been created yet"
                                     SecondaryText="A Schedule runs Run Profiles on a recurring trigger; create one to start synchronising unattended."
                                     ActionText="Create a Schedule"
                                     OnAction="GoToSchedules" />
                }
            </EmptyContent>
        </VirtualisedDataGrid>
    }
</AuthorizeView>

