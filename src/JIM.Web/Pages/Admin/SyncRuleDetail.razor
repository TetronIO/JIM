@page "/admin/sync-rules/new"
@page "/admin/sync-rules/{Id:int}"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Activities
@using JIM.Models.Core
@using JIM.Models.Logic
@using JIM.Models.Preview
@using JIM.Models.Staging.DTOs
@using JIM.Models.Utility
@using JIM.Web.Pages.Admin.Components
@using JIM.Web.Services
@using JIM.Application
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IConfigurationChangePreviewStarter PreviewStarter
@implements IDisposable

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Synchronisation Rule: @_syncRuleNameOrCreate</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>Synchronisation Rule:</span> <span class="mud-primary-text">@_syncRuleNameOrCreate</span></MudText>
<div class="d-flex justify-space-between align-center">
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
    @if (_syncRule is { Id: > 0 })
    {
        <AuditInfo Entity="@_syncRule" />
    }
</div>

@if (_isLoading)
{
    <div class="d-flex flex-column align-center justify-center mt-16">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Typo="Typo.body2" Class="mt-4 mud-text-secondary">Loading Synchronisation Rule...</MudText>
    </div>
}
else if (_syncRule != null)
{
    @* Keyed on which tabs exist, because MudTabs orders its strip by the order panels register themselves rather
       than by their position in this markup: a panel that appears later (Passwords, when provisioning is
       switched on) is appended to the end, landing after Attribute Flow instead of before it. Changing the key
       rebuilds the component, so registration order becomes markup order again. *@
    <NavigableMudTabs @key="TabSetKey" Elevation="0" Rounded="true" ApplyEffectsToContainer="false" TabPanelsClass="pt-5" Class="mt-2" Outlined="true"
                      @bind-ActivePanelIndex="_activeTabIndex">

        <MudTabPanel Text="Details">
            <SyncRuleDetailsTab SyncRule="_syncRule"
                                ConnectedSystemHeaders="_connectedSystemHeaders"
                                MetaverseObjectTypes="_metaverseObjectTypes"
                                OnChanged="OnChildChanged" />
        </MudTabPanel>

        <MudTabPanel Text="Matching">
            <SyncRuleMatchingTab SyncRule="_syncRule" OnChanged="OnChildChanged" />
        </MudTabPanel>

        <MudTabPanel Text="Scope">
            <SyncRuleScopeTab SyncRule="_syncRule" OnChanged="OnChildChanged" />
        </MudTabPanel>

        @* Only meaningful for an Export rule that provisions, since only a newly created account has never had a
           password. Absent rather than disabled when provisioning is off: there is nothing to configure, and the
           switch that brings it back is on the Details tab, which is index 0 either way. *@
        @if (ShowInitialPasswordTab)
        {
            @* Badged with the parked count, which is what the panel's collapsed title used to carry. Accounts
               waiting on a person must be visible without opening the tab to find out. *@
            <MudTabPanel Text="Passwords" BadgeColor="Color.Warning"
                         BadgeData="@(_parkedInitialPasswordCount > 0 ? _parkedInitialPasswordCount.ToString("N0") : null)">
                <SyncRuleInitialPasswordTab SyncRule="_syncRule"
                                            OnInitialPasswordIssuesChanged="OnInitialPasswordIssuesChanged"
                                            OnChanged="OnChildChanged" />
            </MudTabPanel>
        }

        <MudTabPanel Text="Attribute Flow">
            <SyncRuleAttributeFlowTab SyncRule="_syncRule" OnChanged="OnChildChanged" />
        </MudTabPanel>

        @if (_syncRule.Id > 0)
        {
            <MudTabPanel Text="Changes" BadgeData="@(_changeCount > 0 ? _changeCount.ToString("N0") : null)" BadgeColor="Color.Primary">
                <ConfigurationChangesTab TargetType="ActivityTargetType.SynchronisationRule" ObjectId="_syncRule.Id" ObjectTypeLabel="Synchronisation Rule" />
            </MudTabPanel>
        }

        @if (_syncRule.Id > 0)
        {
            <MudTabPanel Text="Danger Zone" Icon="@Icons.Material.Filled.Warning" BadgeColor="Color.Error" ID="@("danger-zone")">
                <MudPaper Class="pa-4 jim-paper-danger-zone" Outlined="false">
                    <MudText Typo="Typo.h5" Class="mb-3">Danger Zone</MudText>
                    <MudText Class="mud-text-secondary mb-4">
                        Deleting this Synchronisation Rule is permanent and cannot be undone. All configuration and Attribute Flow
                        mappings will be lost.
                    </MudText>
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Delete" OnClick="HandleDeleteSyncRuleAsync"
                        DropShadow="false" Color="Color.Error">Delete Synchronisation Rule</MudButton>
                </MudPaper>
            </MudTabPanel>
        }

    </NavigableMudTabs>

    @* Save bar - applies to the whole rule from any editing tab, but not the read-only Changes or Danger Zone tabs *@
    @if (!IsReadOnlyTabActive)
    {
    @* Computed once per render: the same list gates the button below, and calling it twice would let the
       alert and the button disagree if anything about the rule changed between the two calls. *@
    var validationIssues = ValidationIssues();
    <div class="mt-6">
        @if (validationIssues.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" NoIcon="true" Class="mb-4">
                <MudText Class="mb-3">There are issues:</MudText>
                @foreach (var item in validationIssues)
                {
                    <div class="d-flex align-center mb-2">
                        <MudIcon Class="mr-2" Color="@(item.Level == ValidityStatusItemLevel.Warning ? Color.Warning : Color.Error)"
                            Icon="@(item.Level == ValidityStatusItemLevel.Warning ? @Icons.Material.Filled.Warning : @Icons.Material.Filled.Error)" />
                        <MudText>@item.Message</MudText>
                    </div>
                }
            </MudAlert>
        }

        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleCreateOrUpdateSyncRuleAsync"
                Disabled="@(validationIssues.Any(issue => issue.Level > ValidityStatusItemLevel.Warning))" DropShadow="false">@(_syncRule.Id == 0 ? "Create" : "Update") Synchronisation Rule
            </MudButton>
            @* Preview (#1115): the two destructive toggles (Deprovisioning Action, Out-of-Scope Action) can turn *@
            @* a routine scope exit into a deletion wave, so they are the settings that most need answering       *@
            @* beforehand. Only an existing rule can be previewed: the adapter evaluates the proposal against the *@
            @* persisted configuration, and a rule that does not exist yet stands over no objects.                *@
            @if (_syncRule.Id > 0)
            {
                <MudButton data-testid="jim-preview-destructive-toggles" Variant="Variant.Outlined" Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.Visibility" OnClick="PreviewDestructiveTogglesAsync"
                    Disabled="@_startingPreview">
                    Preview Deprovisioning Impact
                </MudButton>
                @* Preview (#1436): a Scoping Criteria edit decides which objects the rule manages at all, and what *@
                @* the ones that leave cost is read from the toggles beside it, so the two are previewed           *@
                @* separately and answer different questions.                                                     *@
                <MudButton data-testid="jim-preview-scoping-criteria" Variant="Variant.Outlined" Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.FilterAlt" OnClick="PreviewScopingCriteriaAsync"
                    Disabled="@_startingPreview">
                    Preview Scope Impact
                </MudButton>
                @* Preview (#1437): an Attribute Flow edit rewrites values on every object the rule already      *@
                @* manages, which is a third question again: scope decides WHICH objects, the toggles decide what *@
                @* leaving costs them, and this decides what the ones staying end up holding.                     *@
                <MudButton data-testid="jim-preview-attribute-flow" Variant="Variant.Outlined" Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.SyncAlt" OnClick="PreviewAttributeFlowAsync"
                    Disabled="@_startingPreview">
                    Preview Attribute Flow Impact
                </MudButton>
            }
        </MudStack>

        @if (_previewActivityId.HasValue)
        {
            var previewActivityId = _previewActivityId.Value;

            @if (DestructiveTogglePreviewIsStale)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-6"
                          data-testid="jim-preview-stale">
                    The Deprovisioning Action or Out-of-Scope Action has been edited since this preview ran, so it no
                    longer describes what saving would do. Preview again for an answer about the current settings.
                </MudAlert>
            }

            <ConfigurationChangePreviewPanel ActivityId="@previewActivityId"
                                             Title="Preview: Deprovisioning Impact"
                                             OnPreviewChanged="OnDestructiveTogglePreviewChanged"
                                             Class="mt-6" />
        }

        @if (_scopePreviewActivityId.HasValue)
        {
            var scopePreviewActivityId = _scopePreviewActivityId.Value;

            @if (ScopingPreviewIsStale)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-6"
                          data-testid="jim-scope-preview-stale">
                    The Scoping Criteria have been edited since this preview ran, so it no longer describes what
                    saving would do. Preview again for an answer about the current criteria.
                </MudAlert>
            }

            <ConfigurationChangePreviewPanel ActivityId="@scopePreviewActivityId"
                                             Title="Preview: Scope Impact"
                                             OnPreviewChanged="OnScopingPreviewChanged"
                                             Class="mt-6" />
        }

        @if (_attributeFlowPreviewActivityId.HasValue)
        {
            var attributeFlowPreviewActivityId = _attributeFlowPreviewActivityId.Value;

            @if (AttributeFlowPreviewIsStale)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-6"
                          data-testid="jim-attribute-flow-preview-stale">
                    The Attribute Flow has been edited since this preview ran, so it no longer describes what saving
                    would do. Preview again for an answer about the current mappings.
                </MudAlert>
            }

            <ConfigurationChangePreviewPanel ActivityId="@attributeFlowPreviewActivityId"
                                             Title="Preview: Attribute Flow Impact"
                                             OnPreviewChanged="OnAttributeFlowPreviewChanged"
                                             Class="mt-6" />
        }
    </div>
    }
}

@code {
    [Parameter]
    public int? Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string _syncRuleNameOrCreate = "New";
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private SyncRule? _syncRule;
    private bool _isLoading = true;
    private List<ConnectedSystemHeader>? _connectedSystemHeaders;
    private List<MetaverseObjectType>? _metaverseObjectTypes;
    private bool _loaded;
    private int? _loadedId;
    private int _activeTabIndex;
    private int _changeCount;

    /// <summary>
    /// Accounts parked against this rule, for the Passwords tab's badge. Loaded here beside the
    /// Changes count because a badge belongs to the tab strip, which is the page's, and the tab itself is
    /// not rendered until it is opened.
    /// </summary>
    private int _parkedInitialPasswordCount;

    /// <summary>
    /// Whether the rule can deliver an initial password at all, and so whether its tab is one of the editing
    /// tabs. See the comment on the tab itself.
    /// </summary>
    private bool ShowInitialPasswordTab =>
        _syncRule is { Direction: SyncRuleDirection.Export, ProvisionToConnectedSystem: true };

    /// <summary>
    /// Identifies which tabs exist, so that the strip is rebuilt whenever that set changes and the tabs render
    /// in the order they are written rather than the order they happened to register in. See the note on the
    /// component itself.
    /// </summary>
    private string TabSetKey => $"{ShowInitialPasswordTab}-{_syncRule is { Id: > 0 }}";

    // Details, Matching, Scope, [Passwords], Attribute Flow are the editing tabs; for an existing rule
    // Changes and Danger Zone follow, and both are read-only views, so the editing save bar is hidden when
    // either is active. Computed rather than a constant because the Passwords tab is conditional, and a
    // fixed index would put the save bar back on a read-only tab whenever it is present.
    private int ChangesTabIndex => ShowInitialPasswordTab ? 5 : 4;
    private bool IsReadOnlyTabActive => _syncRule is { Id: > 0 } && _activeTabIndex >= ChangesTabIndex;

    // A single JimApplication (and its DbContext) is held for the whole edit session. The rule is loaded
    // change-tracked and every tab mutates that tracked graph, so the final save lets EF Core diff and
    // persist the changes. A fresh context per handler would leave the rule detached at save time and the
    // update would silently persist nothing (e.g. toggling Enabled was lost this way).
    private JimApplication? _jim;

    // Both /admin/sync-rules/new and /admin/sync-rules/{id} resolve to this component, so creating a rule and
    // navigating from /new to /{id} reuses the instance (OnInitializedAsync does not run again). Load from
    // OnParametersSetAsync keyed on the route id so the page re-loads cleanly into edit mode after a create.
    protected override async Task OnParametersSetAsync()
    {
        if (_loaded && _loadedId == Id)
            return;

        _loaded = true;
        _loadedId = Id;
        _isLoading = true;
        await LoadSyncRuleAsync();
        _isLoading = false;
    }

    private async Task LoadSyncRuleAsync()
    {
        // Start a fresh context for this (re)load and hold it for the edit session; dispose any prior one
        // (e.g. the context used while creating, before navigating to the new rule's edit URL).
        _jim?.Dispose();
        _jim = JimFactory.Create();

        _breadcrumbs =
        [
            new BreadcrumbItem("Home", href: "/", icon: Icons.Material.Filled.Home),
            new BreadcrumbItem("Administration", href: "/admin"),
            new BreadcrumbItem("Synchronisation Rules", href: "/admin/sync-rules/")
        ];

        if (Id != null)
        {
            // edit an existing Synchronisation Rule - loaded change-tracked so edits persist on save
            _syncRule = await _jim.ConnectedSystems.GetSyncRuleAsync(Id.Value);
            if (_syncRule == null)
            {
                // Synchronisation Rule not found, redirect to index page
                _isLoading = false;
                NavManager.NavigateTo("../");
                return;
            }

            _syncRuleNameOrCreate = _syncRule.Name;
            _breadcrumbs.Add(new BreadcrumbItem(_syncRule.Name, href: null, disabled: true));

            // lightweight count for the Changes tab badge (one row fetched; TotalResults only)
            _changeCount = (await _jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.SynchronisationRule, _syncRule.Id, 1, 1)).TotalResults;

            // Counts only; the reasons behind them are the Passwords tab's own load.
            var attention = await _jim.InitialPasswords.GetAttentionBySyncRuleAsync([_syncRule.Id]);
            _parkedInitialPasswordCount = attention.TryGetValue(_syncRule.Id, out var parked) ? parked.ParkedCount : 0;
        }
        else
        {
            // create a new Synchronisation Rule
            _syncRule = new SyncRule();
            _syncRuleNameOrCreate = "New";
            _breadcrumbs.Add(new BreadcrumbItem("New", href: null, disabled: true));
            _connectedSystemHeaders = await _jim.ConnectedSystems.GetConnectedSystemHeadersAsync();
            _metaverseObjectTypes = await _jim.Metaverse.GetMetaverseObjectTypesAsync(true);
        }
    }

    /// <summary>
    /// What is wrong with the rule's initial-password settings, as the Details tab last assessed them. Held here
    /// rather than derived, because answering it needs the password policy discovered on the Connected System and
    /// the application layer's own assessment, both of which that tab loads.
    /// </summary>
    private IReadOnlyList<string> _initialPasswordIssues = [];

    /// <summary>
    /// Everything stopping this Synchronisation Rule being saved, or worth warning about: the rule's own model
    /// validation, plus whatever the tabs have reported that the model cannot see for itself.
    /// <para>
    /// Initial-password problems are Errors rather than Warnings because the REST API refuses the same settings
    /// outright. A configuration the target cannot satisfy parks every account the rule provisions, which is not
    /// something to let through with a note beside it.
    /// </para>
    /// </summary>
    private List<ValidityStatusItem> ValidationIssues()
    {
        var issues = _syncRule!.Validate();
        issues.AddRange(_initialPasswordIssues.Select(problem => new ValidityStatusItem(ValidityStatusItemLevel.Error, problem)));
        return issues;
    }

    private void OnInitialPasswordIssuesChanged(IReadOnlyList<string> issues)
    {
        _initialPasswordIssues = issues;
        StateHasChanged();
    }

    private void OnChildChanged()
    {
        // a tab mutated the shared Synchronisation Rule; re-render so the save bar's validation and
        // enabled state stay in sync with the latest edits.
        StateHasChanged();
    }

    // ─── Destructive-toggle preview (#1115) ───

    private Guid? _previewActivityId;
    private SyncRuleDestructiveToggleProposal? _previewedProposal;
    private ConfigurationChangePreview? _preview;
    private bool _startingPreview;

    /// <summary>
    /// The two destructive settings as they stand on the form. The proposal deliberately carries only these: the
    /// preview answers what the toggles would do, evaluated against the rule's persisted configuration, which is
    /// also why only an existing rule offers it.
    /// </summary>
    private SyncRuleDestructiveToggleProposal BuildDestructiveToggleProposal() =>
        new(_syncRule!.OutboundDeprovisionAction, _syncRule.InboundOutOfScopeAction);

    /// <summary>
    /// Whether the form has moved on from the settings the visible preview was run against.
    /// </summary>
    private bool DestructiveTogglePreviewIsStale =>
        _previewedProposal is not null && !BuildDestructiveToggleProposal().DescribesSameSettingsAs(_previewedProposal);

    private async Task PreviewDestructiveTogglesAsync()
    {
        if (_syncRule is not { Id: > 0 } || _startingPreview)
            return;

        _startingPreview = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var proposal = BuildDestructiveToggleProposal();

            // The starter, not StartAndDispatchPreviewAsync: it owns the question of whether a large preview keeps
            // every drill-down row, and that decision belongs in one place rather than at each surface.
            var activityId = await PreviewStarter.StartAsync(new ConfigurationChangePreviewRequest
            {
                Surface = ConfigurationChangePreviewSurface.SynchronisationRule,
                TargetId = _syncRule.Id,
                TargetName = _syncRule.Name,
                ProposedConfiguration = proposal,
                InitiatedByType = ActivityInitiatorType.User,
                InitiatedById = user?.Id,
                InitiatedByName = user?.Name
            });

            // Null means the administrator declined the data-set size question, which is a decision not to preview.
            if (activityId == null)
                return;

            _previewActivityId = activityId;
            _previewedProposal = proposal;
            _preview = null;
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            _previewActivityId = null;
            _previewedProposal = null;
            _preview = null;
            Snackbar.Add($"Failed to start the preview: {ex.Message}", Severity.Error);
        }
        finally
        {
            _startingPreview = false;
        }
    }

    /// <summary>
    /// Records the panel's latest read of the preview, for the save confirmation to state.
    ///
    /// Deliberately does not call <c>StateHasChanged</c>. The panel re-reads on every parameter set, so a page that
    /// re-rendered in response to this callback would set the panel's parameters again, which would refresh again,
    /// which would raise this again: a render loop that never settles and starves the panel's reconciliation poll.
    /// Nothing the page renders depends on this value, so storing it is enough.
    /// </summary>
    private void OnDestructiveTogglePreviewChanged(ConfigurationChangePreview? preview) => _preview = preview;

    // ─── Scoping Criteria preview (#1436) ───

    private Guid? _scopePreviewActivityId;
    private SyncRuleScopingProposal? _previewedScopingProposal;
    private ConfigurationChangePreview? _scopePreview;

    /// <summary>
    /// The Scoping Criteria as they stand on the form. The Scope tab edits the loaded rule's criteria in place, so
    /// this is already the proposal; the adapter re-reads the stored criteria from the database to compare against,
    /// which is why the page does not need to snapshot them itself.
    /// </summary>
    private SyncRuleScopingProposal BuildScopingProposal() => SyncRuleScopingProposal.FromCurrentScope(_syncRule!);

    /// <summary>
    /// Whether the criteria have moved on from the ones the visible preview was run against.
    /// </summary>
    private bool ScopingPreviewIsStale =>
        _previewedScopingProposal is not null && !BuildScopingProposal().DescribesSameScopeAs(_previewedScopingProposal);

    private async Task PreviewScopingCriteriaAsync()
    {
        if (_syncRule is not { Id: > 0 } || _startingPreview)
            return;

        _startingPreview = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var proposal = BuildScopingProposal();

            var activityId = await PreviewStarter.StartAsync(new ConfigurationChangePreviewRequest
            {
                Surface = ConfigurationChangePreviewSurface.SynchronisationRuleScope,
                TargetId = _syncRule.Id,
                TargetName = _syncRule.Name,
                ProposedConfiguration = proposal,
                InitiatedByType = ActivityInitiatorType.User,
                InitiatedById = user?.Id,
                InitiatedByName = user?.Name
            });

            // Null means the administrator declined the data-set size question, which is a decision not to preview.
            if (activityId == null)
                return;

            _scopePreviewActivityId = activityId;
            _previewedScopingProposal = proposal;
            _scopePreview = null;
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            _scopePreviewActivityId = null;
            _previewedScopingProposal = null;
            _scopePreview = null;
            Snackbar.Add($"Failed to start the preview: {ex.Message}", Severity.Error);
        }
        finally
        {
            _startingPreview = false;
        }
    }

    private void OnScopingPreviewChanged(ConfigurationChangePreview? preview) => _scopePreview = preview;

    // ─── Attribute Flow preview (#1437) ───

    private Guid? _attributeFlowPreviewActivityId;
    private SyncRuleAttributeFlowProposal? _previewedAttributeFlowProposal;
    private ConfigurationChangePreview? _attributeFlowPreview;

    /// <summary>
    /// The Attribute Flow as it stands on the form. The Attribute Flow tab edits the loaded rule's mappings in
    /// place, so this is already the proposal; the adapter re-reads the stored mappings from the database to
    /// compare against, which is why the page does not need to snapshot them itself.
    /// </summary>
    private SyncRuleAttributeFlowProposal BuildAttributeFlowProposal() =>
        SyncRuleAttributeFlowProposal.FromCurrentMappings(_syncRule!);

    /// <summary>
    /// Whether the mappings have moved on from the ones the visible preview was run against.
    /// </summary>
    private bool AttributeFlowPreviewIsStale =>
        _previewedAttributeFlowProposal is not null
        && !BuildAttributeFlowProposal().DescribesSameMappingsAs(_previewedAttributeFlowProposal);

    private async Task PreviewAttributeFlowAsync()
    {
        if (_syncRule is not { Id: > 0 } || _startingPreview)
            return;

        _startingPreview = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var proposal = BuildAttributeFlowProposal();

            var activityId = await PreviewStarter.StartAsync(new ConfigurationChangePreviewRequest
            {
                Surface = ConfigurationChangePreviewSurface.SynchronisationRuleAttributeFlow,
                TargetId = _syncRule.Id,
                TargetName = _syncRule.Name,
                ProposedConfiguration = proposal,
                InitiatedByType = ActivityInitiatorType.User,
                InitiatedById = user?.Id,
                InitiatedByName = user?.Name
            });

            // Null means the administrator declined the data-set size question, which is a decision not to preview.
            if (activityId == null)
                return;

            _attributeFlowPreviewActivityId = activityId;
            _previewedAttributeFlowProposal = proposal;
            _attributeFlowPreview = null;
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            _attributeFlowPreviewActivityId = null;
            _previewedAttributeFlowProposal = null;
            _attributeFlowPreview = null;
            Snackbar.Add($"Failed to start the preview: {ex.Message}", Severity.Error);
        }
        finally
        {
            _startingPreview = false;
        }
    }

    private void OnAttributeFlowPreviewChanged(ConfigurationChangePreview? preview) => _attributeFlowPreview = preview;

    /// <summary>
    /// The preview whose counts the save confirmation states, and the Activity the change is linked to.
    /// </summary>
    /// <remarks>
    /// A fresh Scoping Criteria preview wins over a fresh Attribute Flow one, which in turn wins over a fresh
    /// destructive-toggle one, in order of how much of the population each moves: a scope change decides which
    /// objects the rule manages at all and its counts already describe what leaving costs them, an Attribute Flow
    /// change rewrites values on the objects that stay, and the toggle preview describes the fate of objects whose
    /// scope is unchanged. Where several have been edited in one sitting no single preview is complete on its own
    /// (each evaluated the others' settings as stored), so the administrator is answering with the largest of the
    /// questions in front of them; the panels above show all of them in full.
    /// </remarks>
    private (ConfigurationChangePreview? Preview, bool IsStale, Guid? ActivityId) ConfirmingPreview =>
        _scopePreviewActivityId.HasValue && !ScopingPreviewIsStale
            ? (_scopePreview, false, _scopePreviewActivityId)
            : _attributeFlowPreviewActivityId.HasValue && !AttributeFlowPreviewIsStale
                ? (_attributeFlowPreview, false, _attributeFlowPreviewActivityId)
                : (_preview, DestructiveTogglePreviewIsStale, _previewActivityId);

    private async Task HandleCreateOrUpdateSyncRuleAsync()
    {
        if (_syncRule == null || _jim == null)
            return;

        // are we transitioning from new to existing?
        var isSyncRuleNew = _syncRule.Id == 0;

        // ask the administrator to acknowledge anything sync-affecting they are about to save, before asking why they
        // are saving it. A cosmetic edit (a rename, a description) shows nothing at all; cancelling aborts the save.
        // Where a destructive-toggle preview has run and still describes the form, its counts and verdict are stated
        // on the confirmation, so consent is to a number rather than to a sentence (#1115); a stale, failed or
        // still-running preview states nothing.
        var preflight = await _jim.ConfigurationChangePreflight.EvaluateSyncRuleAsync(_syncRule);
        var confirming = ConfirmingPreview;
        if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                "Synchronisation Rule", _syncRule.Name,
                ConfigurationChangePreviewCounts.ForConfirmation(confirming.Preview, confirming.IsStale),
                ConfigurationChangePreviewCounts.ForConfirmationVerdict(confirming.Preview, confirming.IsStale)))
            return;

        // offer an optional reason for the configuration change history; cancelling aborts the save
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, isSyncRuleNew ? "Create" : "Update");
        if (cancelled)
            return;

        // save on the SAME context the rule was loaded on, so EF Core's change tracker sees the edits.
        // A preview that still describes the form links the apply Activity back to it (#827: "previewed, then
        // applied" is auditable); a stale one is not claimed.
        var previewActivityId = confirming.IsStale ? null : confirming.ActivityId;
        var user = await Helpers.GetUserAsync(_jim, AuthenticationStateTask);
        var wasSuccessful = await _jim.ConnectedSystems.CreateOrUpdateSyncRuleAsync(_syncRule, user, changeReason: changeReason, previewActivityId: previewActivityId);
        switch (wasSuccessful)
        {
            // send the user to the existing-sync-rule view.
            // this helps ensure links are good to be shared/bookmarked, etc.
            // the snackbar is enqueued before navigating; ISnackbar is circuit-scoped and the provider
            // lives in the layout, so the message survives the soft navigation and shows on the edit page.
            case true when isSyncRuleNew:
                Snackbar.Add("Synchronisation Rule created.", Severity.Success);
                NavManager.NavigateTo($"/admin/sync-rules/{_syncRule.Id}");
                break;
            case true:
                Snackbar.Add("Changes saved.", Severity.Success);
                break;
            case false:
                Snackbar.Add("There was a problem saving your changes. Please check the details and try again.", Severity.Error);
                break;
        }
    }

    private async Task HandleDeleteSyncRuleAsync()
    {
        if (_syncRule == null || _jim == null)
            return;

        var confirmationResult = await DialogService.ShowMessageBoxAsync("Warning", "Are you sure you want to delete this Synchronisation Rule?", yesText: "Delete!", cancelText: "Cancel");
        if (confirmationResult.HasValue && confirmationResult.Value)
        {
            // offer an optional reason for the configuration change history; cancelling aborts the delete
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Delete");
            if (cancelled)
                return;

            // attribute the operation to the signed-in user; use the edit session's context
            var user = await Helpers.GetUserAsync(_jim, AuthenticationStateTask);
            await _jim.ConnectedSystems.DeleteSyncRuleAsync(_syncRule, user, changeReason);
            NavManager.NavigateTo("/admin/sync-rules");
        }
    }

    public void Dispose()
    {
        _jim?.Dispose();
    }
}
