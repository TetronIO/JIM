@page "/admin/connected-systems/{CsId:int}/connector-space/{CsoId}"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Logic
@using JIM.Models.Staging
@using JIM.Models.Staging.DTOs
@using JIM.Models.Transactional
@using JIM.Models.Activities
@using JIM.Models.Core
@using JIM.Models.Enums
@using JIM.Models.Utility
@using JIM.Utilities
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject IDialogService DialogService

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@(ConnectedSystemObject == null ? "Loading…" : $"Connected System Object: {GetDisplayIdentifier()}")</PageTitle>

<LoadingGate IsLoading="@(ConnectedSystemHeader == null || ConnectedSystemObject == null)">
    <Loading>
        <CsoDetailSkeleton />
    </Loading>
    <LongLoadMessage>
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
            Still loading. Large objects can take a few seconds to retrieve.
        </MudAlert>
    </LongLoadMessage>
    <Loaded>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>Connected System Object:</span> <span class="mud-primary-text">@GetDisplayIdentifier()</span>
</MudText>
<MudBreadcrumbs Items="Breadcrumbs" Class="ps-0"></MudBreadcrumbs>

<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    A view of this object as staged within JIM. This includes any attribute values imported from the Connected System,
    as well as any Pending Export changes awaiting export.
</MudText>

@if (ConnectedSystemHeader != null && ConnectedSystemObject != null)
{
    <MudPaper Class="pa-4 mt-4" Outlined="true">
        @* First row: Type, Status, Created, Updated, MVO Link *@
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="flex-wrap" Spacing="3">
            @* Object Type *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.body1" Class="mud-text-secondary">Type:</MudText>
                <MudChip T="string" Variant="Variant.Text" Color="Color.Primary">
                    @ConnectedSystemObject.Type.Name
                </MudChip>
            </MudStack>
            <MudDivider Vertical="true" FlexItem="true" Class="my-1" />

            @* Status *@
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudText Typo="Typo.body1" Class="mud-text-secondary">Status:</MudText>
                <MudChip T="string" Variant="Variant.Text" Color="GetStatusColor(ConnectedSystemObject.Status)">
                    @ConnectedSystemObject.Status.ToString().SplitOnCapitalLetters()
                </MudChip>
            </MudStack>
            <MudDivider Vertical="true" FlexItem="true" Class="my-1" />

            @* Created *@
            <MudTooltip Text="@ConnectedSystemObject.Created.ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">Created:</MudText>
                    <MudText Typo="Typo.body1">@ConnectedSystemObject.Created.ToRelativeTime()</MudText>
                </MudStack>
            </MudTooltip>

            @* Last Updated *@
            @if (ConnectedSystemObject.LastUpdated.HasValue)
            {
                <MudDivider Vertical="true" FlexItem="true" Class="my-1" />
                <MudTooltip Text="@ConnectedSystemObject.LastUpdated.Value.ToFriendlyDate()" Arrow="true"
                    Placement="Placement.Top">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                        <MudText Typo="Typo.body1" Class="mud-text-secondary">Updated:</MudText>
                        <MudText Typo="Typo.body1">@ConnectedSystemObject.LastUpdated.Value.ToRelativeTime()</MudText>
                    </MudStack>
                </MudTooltip>
            }

            @* Metaverse Link *@
            @if (ConnectedSystemObject.MetaverseObjectId.HasValue && ConnectedSystemObject.MetaverseObject != null)
            {
                <MudDivider Vertical="true" FlexItem="true" Class="my-1" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">Metaverse Object:</MudText>
                    <MudLink Typo="Typo.body1" Href="@Utilities.GetMetaverseObjectHref(ConnectedSystemObject.MetaverseObject)">
                        @(Utilities.GetMetaverseObjectHrefText(ConnectedSystemObject.MetaverseObject) ??
                                        ConnectedSystemObject.MetaverseObjectId.ToString())
                    </MudLink>
                </MudStack>
                <MudDivider Vertical="true" FlexItem="true" Class="my-1" />
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudText Typo="Typo.body1" Class="mud-text-secondary">Join Type:</MudText>
                    <MudChip T="string" Variant="Variant.Text" Color="GetJoinTypeColor(ConnectedSystemObject.JoinType)">
                        @ConnectedSystemObject.JoinType
                    </MudChip>
                </MudStack>
            }

            @* Offered only where the Connector can actually set a password, so the action is never presented *@
            @* against a Connected System that could not carry it out (issue #1121).                          *@
            @if (_supportedExpiryBehaviours.Count > 0)
            {
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" DropShadow="false"
                           StartIcon="@Icons.Material.Filled.Key" OnClick="OpenSetPasswordDialogAsync"
                           data-testid="jim-cso-set-password">Set Password</MudButton>
            }
        </MudStack>

    </MudPaper>

    @if (PendingExport != null && _pendingExportTotalCount > 0)
    {
        <MudPaper Class="pa-4 mt-6" Outlined="true">
            <MudText Typo="Typo.h6">Pending Exports</MudText>
            <MudText Typo="Typo.subtitle1" Class="my-3">
                The following attribute changes are pending for this Connected System. These may be awaiting export, or have
                already been exported
                and are awaiting confirmation via a subsequent import. Once confirmed, these changes will be reflected in the
                CSO attribute values below.
            </MudText>
            @* Queued changes are unbounded (one Pending Export can carry every value of a large group), so the
               grid streams windows from a range read rather than the page loading them all. No column offers a
               sort: the read has no sort parameter, and a header that reordered nothing would be a lie. *@
            <VirtualisedDataGrid T="PendingExportAttributeValueChange"
                                 ContainerId="cso-pending-exports"
                                 UrlParameterPrefix="pe-"
                                 StateKey="@CsoId"
                                 DefaultSortBy="@SourceOrderSort"
                                 LoadWindow="LoadPendingExportWindowAsync"
                                 SearchPlaceholder="Search Pending Exports..."
                                 SingularName="Change"
                                 PluralName="Changes">
                <Columns>
                    <TemplateColumn Title="Attribute" Sortable="false">
                        <HeaderTemplate>
                            <MudText Typo="Typo.button">Attribute</MudText>
                        </HeaderTemplate>
                        <CellTemplate>
                            @(context.Item.Attribute?.Name ?? $"Attribute {context.Item.AttributeId}")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Change Type" Sortable="false">
                        <HeaderTemplate>
                            <MudText Typo="Typo.button">Change Type</MudText>
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="string" Variant="Variant.Text" Color="GetAttributeChangeTypeColor(context.Item.ChangeType)">
                                @context.Item.ChangeType
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Value" Sortable="false">
                        <HeaderTemplate>
                            <MudText Typo="Typo.button">Value</MudText>
                        </HeaderTemplate>
                        <CellTemplate>
                            @* A value bound for the Connected System is an identifier or a literal, so it takes the
                               code font every other exported value on these pages does (the Change History, the
                               attribute table below). *@
                            <TextValueDisplay Value="@GetAttributeValue(context.Item)" Class="jim-text-code" />
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Status" Sortable="false">
                        <HeaderTemplate>
                            <MudText Typo="Typo.button">Status</MudText>
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="string" Variant="Variant.Text" Color="GetAttributeChangeStatusColor(context.Item.Status)">
                                @context.Item.Status.ToString().SplitOnCapitalLetters()
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Export Attempts" Sortable="false">
                        <HeaderTemplate>
                            <MudText Typo="Typo.button">Export Attempts</MudText>
                        </HeaderTemplate>
                        <CellTemplate>
                            @context.Item.ExportAttemptCount
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Last Exported" Sortable="false">
                        <HeaderTemplate>
                            <MudText Typo="Typo.button">Last Exported</MudText>
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.LastExportedAt.HasValue)
                            {
                                var lastExportedAt = context.Item.LastExportedAt.Value;
                                @lastExportedAt.ToFriendlyDate()
                            }
                            else
                            {
                                <EmptyValue />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <EmptyContent Context="grid">
                    @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                         PrimaryText="@($"No queued changes match \"{grid.SearchText}\"")"
                                         SecondaryText="Try a different search term, or clear the search."
                                         ActionText="Clear Search"
                                         OnAction="@(() => grid.ClearSearchAsync())" />
                    }
                    else
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.PublishedWithChanges"
                                         PrimaryText="No changes are queued for this object"
                                         SecondaryText="Changes appear here while a Pending Export waits to be exported, and are cleared once the Connected System confirms them." />
                    }
                </EmptyContent>
            </VirtualisedDataGrid>
        </MudPaper>
    }

    <div class="mt-6">
    @* pa-0 rather than pt-5: the Attributes grid carries the standing mt-5 gap of its own (VirtualisedDataGrid's
       GridClass default), and stacking the panels' padding on top of it opened a 44px gap under the tab bar. The
       Change History tab has no such margin of its own, so its content supplies the same gap itself below. See
       JIM.Web/CLAUDE.md "Tab content spacing". *@
    <NavigableMudTabs ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="OnActiveTabIndexChangedAsync"
                      TabPanelsClass="pa-0">
        <MudTabPanel Text="Attributes" Icon="@Icons.Material.Filled.ListAlt">
            @* One row per attribute, as before; the object's attribute values were loaded with the rest of the
               page (capped per multi-valued attribute), so windows are sliced from that list in memory rather
               than costing a database read per scroll. The sorts are the same five the paged table offered. *@
            <VirtualisedDataGrid T="AttributeGroup"
                                 ContainerId="cso-attributes"
                                 UrlParameterPrefix="attr-"
                                 StateKey="@CsoId"
                                 DefaultSortBy="attribute"
                                 LoadWindow="LoadAttributeWindowAsync"
                                 SearchPlaceholder="Search attribute name or value"
                                 SingularName="Attribute"
                                 PluralName="Attributes">
                <Columns>
                    <TemplateColumn Title="Attribute" Sortable="false" HeaderClass="jim-attr-header-name" CellClass="jim-attr-name">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Attribute" Name="attribute" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudText Typo="Typo.body1" Class="mud-text-secondary">@context.Item.AttributeName</MudText>
                            @if (IsUnmanagedAttribute(context.Item))
                            {
                                <MudTooltip Text="Initial Export Only: JIM set this attribute at initial provisioning (if it provisioned the object) and no longer exports changes to it; the Connected System owns the value" Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">Unmanaged</MudChip>
                                </MudTooltip>
                            }
                            @if (IsCreateOnlyAttribute(context.Item))
                            {
                                <MudTooltip Text="@Helpers.GetAttributeWritabilityDescription(AttributeWritability.WritableOnCreate)" Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">Set on creation only</MudChip>
                                </MudTooltip>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Value" Sortable="false" HeaderClass="jim-attr-header-value" CellClass="jim-attr-value">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Value" Name="value" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @* A row in a virtualised table is one line: the virtualiser positions every row from
                               one fixed ItemSize, so a cell that stacks its values (or nests a whole table) puts
                               everything below it at an offset nothing on the page agrees with. A multi-valued
                               attribute therefore shows its first value and sends the rest to a dialog, which
                               holds a virtualised grid of them so none is out of reach however many there are. *@
                            @{ var group = context.Item; }
                            <div class="jim-one-line-list">
                                <span class="jim-one-line-list-value"><CsoAttributeValue Value="@group.Values[0]" /></span>
                                @if (group.TotalCount > 1)
                                {
                                    <MudButton Variant="Variant.Outlined" Class="jim-attr-expand-btn"
                                               OnClick="@(() => OpenMvaDialogAsync(group))">
                                        +@((group.TotalCount - 1).ToString("N0")) more
                                    </MudButton>
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Type" Sortable="false" HeaderClass="jim-attr-header-type" CellClass="jim-attr-type">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Type" Name="type" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudText Typo="Typo.body1" Class="mud-text-secondary">@context.Item.Values[0].Attribute.Type</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Plurality" Sortable="false" HeaderClass="jim-attr-header-plurality" CellClass="jim-attr-plurality">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Plurality" Name="plurality" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudText Typo="Typo.body1" Class="mud-text-secondary">@(context.Item.IsMultiValued ? "Multi" : "Single")</MudText>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="External ID?" Sortable="false" HeaderClass="jim-attr-header-extid">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="External ID?" Name="externalid" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (IsExternalId(context.Item.Values[0]))
                            {
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">External ID</MudChip>
                            }
                            else if (IsSecondaryExternalId(context.Item.Values[0]))
                            {
                                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">Secondary ID</MudChip>
                            }
                            else
                            {
                                <EmptyValue />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <EmptyContent Context="grid">
                    @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                         PrimaryText="@($"No attributes match \"{grid.SearchText}\"")"
                                         SecondaryText="Try a different search term, or clear the search."
                                         ActionText="Clear Search"
                                         OnAction="@(() => grid.ClearSearchAsync())" />
                    }
                    else
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.ListAlt"
                                         PrimaryText="This object has no attribute values"
                                         SecondaryText="Values appear here once an Import brings them in from the Connected System." />
                    }
                </EmptyContent>
            </VirtualisedDataGrid>
        </MudTabPanel>
        <MudTabPanel Text="Change History" Icon="@Icons.Material.Filled.History" BadgeData="@_changeCount.ToString("N0")" BadgeColor="Color.Primary">
            @* mt-5 here matches the gap the Attributes grid gives itself above, since the panels carry none. *@
            <div class="mt-5">
            @if (_changeHistoryLoading && _changeHistoryRows.Count == 0)
            {
                <div class="d-flex justify-center pa-4">
                    <MudProgressCircular Indeterminate="true" />
                </div>
            }
            else if (_changeCount == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">No change history recorded for this object.</MudAlert>
            }
            else
            {
                <ChangeHistoryTimeline Changes="@_changeHistoryRows" />
                @if (_changeHistoryRows.Count < _changeHistoryTotal)
                {
                    <div class="d-flex justify-center mt-3">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@_changeHistoryLoading"
                                   OnClick="LoadMoreChangeHistoryAsync">
                            @if (_changeHistoryLoading)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                            }
                            Load more (@($"{_changeHistoryTotal - _changeHistoryRows.Count:N0}") remaining)
                        </MudButton>
                    </div>
                }
            }
            </div>
        </MudTabPanel>
    </NavigableMudTabs>
    </div>
}
    </Loaded>
</LoadingGate>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    /// <summary>
    /// Connected System ID.
    /// </summary>
    [Parameter]
    public int CsId { get; set; }

    /// <summary>
    /// Connected System Object ID.
    /// </summary>
    [Parameter]
    public string CsoId { get; set; } = null!;

    private ConnectedSystemHeader? ConnectedSystemHeader { get; set; }

    private ConnectedSystemObject? ConnectedSystemObject { get; set; }

    private Dictionary<string, int> AttributeValueTotalCounts { get; set; } = new();

    private ConnectedSystemObjectAttributeValue? ExternalIdAttributeValue { get; set; }

    private ConnectedSystemObjectAttributeValue? SecondaryExternalIdAttributeValue { get; set; }

    private PendingExport? PendingExport { get; set; }

    private int _pendingExportTotalCount;

    /// <summary>
    /// The sort key standing for "the order the application layer returned them in". A Pending Export's queued
    /// changes are read with no sort parameter, so no column offers a sort; naming the default something no
    /// header claims keeps the grid from showing a sort arrow over an order it did not choose.
    /// </summary>
    private const string SourceOrderSort = "order";

    // Change-history lazy-load state. Initial detail load returns only the count so the badge
    // can render immediately; the rows are fetched the first time the user opens the Change
    // History tab and paged via Load more.
    private const int ChangeHistoryPageSize = 50;
    private int _activeTabIndex;
    private int _changeCount;
    private int _changeHistoryTotal;
    private int _changeHistoryNextPage = 1;
    private bool _changeHistoryLoading;
    private readonly List<ChangeHistoryTimeline.ChangeGroup> _changeHistoryRows = new();

    private List<BreadcrumbItem> Breadcrumbs { get; set; } = null!;

    // What the Connector can do with a password, and the generator settings a Generate in the dialog should
    // follow. Read once with the rest of the page rather than when the dialog opens, so the Set Password action
    // is either offered or not rather than appearing and then turning out to be unavailable.
    private IReadOnlyCollection<PasswordExpiryBehaviour> _supportedExpiryBehaviours = [];
    private ConnectedSystemPasswordPolicy? _discoveredPasswordPolicy;

    /// <summary>
    /// Opens the set-password dialog for this account (issues #1121, #1172).
    /// <para>
    /// The same dialog the Metaverse Object uses, handed exactly one account. With no choice to make there is
    /// no picker and no progress rail, so it renders as the single-account dialog it was originally built as,
    /// while there remains one component to maintain rather than two that drift.
    /// </para>
    /// <para>
    /// Generation and the set itself are passed in as delegates rather than letting the dialog reach the
    /// application layer, so the dialog stays a piece of user interface with no knowledge of how JIM talks to a
    /// Connected System, and so the password it holds never travels further than those calls.
    /// </para>
    /// </summary>
    private async Task OpenSetPasswordDialogAsync()
    {
        if (ConnectedSystemObject == null || ConnectedSystemHeader == null)
            return;

        var account = new MetaverseObjectAccount
        {
            ConnectedSystemObjectId = ConnectedSystemObject.Id,
            ConnectedSystemId = CsId,
            ConnectedSystemName = ConnectedSystemHeader.Name,
            AccountIdentifier = GetDisplayIdentifier(),
            ConnectorCanSetPasswords = _supportedExpiryBehaviours.Count > 0,
            SupportedExpiryBehaviours = _supportedExpiryBehaviours,
            DiscoveredPolicy = _discoveredPasswordPolicy
        };

        var parameters = new DialogParameters<SetPasswordDialog>
        {
            { x => x.Accounts, new List<MetaverseObjectAccount> { account } },
            { x => x.AllowSelection, false },
            { x => x.Reconcile, ReconcilePasswordPolicies },
            { x => x.GeneratePassword, GeneratePassword },
            { x => x.SetPassword, SetPasswordOnAccountsAsync }
        };

        await DialogService.ShowAsync<SetPasswordDialog>("Set Password", parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private PasswordPolicyReconciliation ReconcilePasswordPolicies(IReadOnlyList<MetaverseObjectAccount> accounts)
    {
        using var jim = JimFactory.Create();
        return jim.PasswordGenerator.Reconcile(accounts
            .Select(a => new PasswordPolicyForSystem { ConnectedSystemName = a.ConnectedSystemName, Policy = a.DiscoveredPolicy })
            .ToList());
    }

    private string GeneratePassword(PasswordGenerationPolicy policy)
    {
        using var jim = JimFactory.Create();
        return jim.PasswordGenerator.Generate(policy);
    }

    private async Task<MultiAccountPasswordSetResult> SetPasswordOnAccountsAsync(
        IReadOnlyList<MetaverseObjectAccount> accounts,
        string password,
        PasswordSetOptions options,
        IProgress<AccountPasswordSetOutcome> progress)
    {
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        return await jim.ConnectedSystems.SetPasswordOnAccountsAsync(
            ConnectedSystemObject?.MetaverseObjectId ?? Guid.Empty, accounts, password, options, user, progress, CancellationToken.None);
    }

    protected override async Task OnParametersSetAsync()
    {
        using var jim = JimFactory.Create();
        ConnectedSystemHeader = await jim.ConnectedSystems.GetConnectedSystemHeaderAsync(CsId);
        if (ConnectedSystemHeader == null)
        {
            // ConnectedSystem not found, redirect to the Connected Systems index page
            NavManager.NavigateTo($"/admin/connected-systems/");
            return;
        }

        var csoIdValid = Guid.TryParse(CsoId, out var connectedSystemObjectId);
        if (!csoIdValid)
        {
            NavManager.NavigateTo(Utilities.GetConnectedSystemObjectsHref(CsId));
            return;
        }

        var detailResult = await jim.ConnectedSystems.GetConnectedSystemObjectDetailAsync(
            CsId, connectedSystemObjectId, CsoAttributeLoadStrategy.CappedMva);
        if (detailResult == null)
        {
            // ConnectedSystemObject not found, redirect to Connected System Objects index page
            NavManager.NavigateTo(Utilities.GetConnectedSystemObjectsHref(CsId));
            return;
        }

        ConnectedSystemObject = detailResult.ConnectedSystemObject;
        AttributeValueTotalCounts = detailResult.AttributeValueTotalCounts;
        _changeCount = detailResult.ChangeCount;

        // Grouped once here rather than per window read: the attributes grid slices its windows from this list,
        // and re-grouping every value on every scroll would do the same work again for no new information.
        _attributeGroups = GetGroupedAttributes();

        Breadcrumbs = new List<BreadcrumbItem>
        {
            new("Home", href: "/", icon: Icons.Material.Filled.Home),
            new("Administration", href: "/admin"),
            new("Connected Systems", href: "/admin/connected-systems/"),
            new(ConnectedSystemHeader.Name, href: Utilities.GetConnectedSystemHref(ConnectedSystemHeader)),
            new("Connector Space", href: Utilities.GetConnectedSystemObjectsHref(ConnectedSystemHeader)),
            new(GetDisplayIdentifier(), href: null, disabled: true)
        };

        ExternalIdAttributeValue = ConnectedSystemObject.ExternalIdAttributeValue;
        SecondaryExternalIdAttributeValue = ConnectedSystemObject.SecondaryExternalIdAttributeValue;

        _supportedExpiryBehaviours = await jim.ConnectedSystems.GetSupportedPasswordExpiryBehavioursAsync(CsId);
        if (_supportedExpiryBehaviours.Count > 0)
            // What JIM last discovered on the target, so a generated password satisfies the directory's own
            // rules without an administrator retyping them. The dialog reconciles it into generator settings.
            _discoveredPasswordPolicy = await jim.ConnectedSystems.GetPasswordPolicyAsync(CsId);

        // Fetch Pending Export header (without loading all attribute value changes) for this CSO
        var pendingExportResult = await jim.ConnectedSystems.GetPendingExportHeaderForObjectAsync(connectedSystemObjectId);
        if (pendingExportResult.HasValue)
        {
            PendingExport = pendingExportResult.Value.PendingExport;
            _pendingExportTotalCount = pendingExportResult.Value.ChangeCount;
        }

        // Derive which attributes are unmanaged via Initial Export Only mappings (#223)
        _unmanagedAttributeIds = await ComputeUnmanagedAttributeIdsAsync(jim);

        // Change history is loaded lazily when the user opens the Change History tab; the count
        // already came back on the detail result so the badge renders immediately.
    }

    private async Task OnActiveTabIndexChangedAsync(int newIndex)
    {
        _activeTabIndex = newIndex;
        // The Change History tab is the second one (index 1).
        if (newIndex == 1 && _changeHistoryRows.Count == 0 && _changeCount > 0 && !_changeHistoryLoading)
            await LoadChangeHistoryPageAsync();
    }

    private async Task LoadMoreChangeHistoryAsync()
    {
        await LoadChangeHistoryPageAsync();
    }

    private async Task LoadChangeHistoryPageAsync()
    {
        if (_changeHistoryLoading)
            return;

        _changeHistoryLoading = true;
        StateHasChanged();
        try
        {
            using var jim = JimFactory.Create();
            if (!Guid.TryParse(CsoId, out var connectedSystemObjectId))
                return;

            var (items, totalCount) = await jim.ConnectedSystems.GetCsoChangeHistoryAsync(
                connectedSystemObjectId, _changeHistoryNextPage, ChangeHistoryPageSize);
            _changeHistoryTotal = totalCount;
            _changeHistoryRows.AddRange(items.Select(MapDtoToChangeGroup));
            _changeHistoryNextPage++;
        }
        finally
        {
            _changeHistoryLoading = false;
            StateHasChanged();
        }
    }

    private ChangeHistoryTimeline.ChangeGroup MapDtoToChangeGroup(CsoChangeHistoryDto dto)
    {
        return new ChangeHistoryTimeline.ChangeGroup
        {
            ChangeType = dto.ChangeType,
            ChangeTime = dto.ChangeTime,
            ChangeInitiatorType = MapInitiatorType(dto.InitiatedByType),
            ChangeInitiatorName = dto.InitiatedByName,
            ChangeInitiatorId = dto.InitiatedById,
            ChangeMechanismType = "Import",
            ConnectedSystemId = ConnectedSystemHeader?.Id,
            ConnectedSystemName = ConnectedSystemHeader?.Name,
            RunProfileName = dto.RunProfileName,
            SyncRuleId = null,
            SyncRuleName = null,
            ActivityRunProfileExecutionItemId = dto.ActivityRunProfileExecutionItemId,
            AttributeChanges = dto.AttributeChanges
                .SelectMany(ac => ac.ValueChanges.Select(vc => new ChangeHistoryTimeline.AttributeChange
                {
                    AttributeName = ac.AttributeName,
                    ChangeType = vc.ValueChangeType,
                    Value = vc.ReferenceValue == null ? vc.ToDisplayString() : null,
                    ReferenceValue = vc.ReferenceValue != null
                        ? new ChangeHistoryTimeline.ReferenceValueInfo
                        {
                            TypeName = vc.ReferenceValue.TypeName,
                            DisplayName = vc.ReferenceValue.DisplayName ?? vc.ReferenceValue.Id.ToString(),
                            SecondaryId = vc.ReferenceValue.SecondaryId,
                            Href = Utilities.GetConnectedSystemObjectHref(vc.ReferenceValue.ConnectedSystemId, vc.ReferenceValue.Id)
                        }
                        : null,
                    IsMultiValued = ac.AttributePlurality == AttributePlurality.MultiValued,
                    AttributeType = ac.AttributeType
                }))
                .ToList()
        };
    }

    /// <summary>
    /// Opens the whole set of one multi-valued attribute's values, which the grid's own row cannot show: a row is
    /// one line tall, so the cell shows the first value and this dialog carries the rest, virtualised, so a group
    /// with half a million members is still reachable in full.
    /// </summary>
    private async Task OpenMvaDialogAsync(AttributeGroup group)
    {
        if (ConnectedSystemObject == null)
            return;

        // Captured before it is handed to the dialog rather than dereferenced through the guard in an initialiser:
        // a chained dereference under an @if is what CodeQL reads as a possible null (JIM.Web/CLAUDE.md).
        var connectedSystemObjectId = ConnectedSystemObject.Id;

        var parameters = new DialogParameters<CsoMvaDialog>
        {
            { x => x.AttributeName, group.AttributeName },
            { x => x.ConnectedSystemObjectId, connectedSystemObjectId },
            { x => x.IsReferenceAttribute, group.IsReference },
            { x => x.TotalCount, group.TotalCount }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        await DialogService.ShowAsync<CsoMvaDialog>(group.AttributeName, parameters, options);
    }

    /// <summary>
    /// One row of the attributes grid: an attribute and the values of it this object holds. Public so the grid's
    /// window loader can be exercised by name from the component tests.
    /// </summary>
    public record AttributeGroup(
    string AttributeName,
    List<ConnectedSystemObjectAttributeValue> Values,
    bool IsMultiValued,
    int TotalCount,
    bool IsReference);

    private List<AttributeGroup> _attributeGroups = new();

    /// <summary>
    /// Slices one window of attributes from the list the page already holds, applying the grid's search (the
    /// attribute's name and its loaded values) and the same five sorts the paged table offered. The values came
    /// back with the rest of the page, so a scroll costs no database read; the count is only taken when the
    /// request asks for it, so a null total means "not counted" rather than "nothing matched".
    /// </summary>
    private Task<VirtualisedWindow<AttributeGroup>> LoadAttributeWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<AttributeGroup> groups = _attributeGroups;

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            groups = groups.Where(g =>
                g.AttributeName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                g.Values.Any(v => (v.ToStringNoName() ?? string.Empty).Contains(search, StringComparison.OrdinalIgnoreCase)));
        }

        IOrderedEnumerable<AttributeGroup> Order<TKey>(Func<AttributeGroup, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? groups.OrderByDescending(key, comparer) : groups.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "value" => Order(g => g.Values[0].ToStringNoName() ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            "type" => Order(g => g.Values[0].Attribute.Type),
            "plurality" => Order(g => g.IsMultiValued),
            "externalid" => Order(GetExternalIdSortOrder),
            _ => Order(g => g.AttributeName, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    private List<AttributeGroup> GetGroupedAttributes()
    {
        if (ConnectedSystemObject == null)
            return new List<AttributeGroup>();

        return ConnectedSystemObject.AttributeValues
        .GroupBy(v => v.Attribute.Name)
        .Select(g =>
        {
            var values = g.ToList();
            var totalCount = AttributeValueTotalCounts.GetValueOrDefault(g.Key, values.Count);
            var isReference = values.Any(v => v.ReferenceValue != null || v.UnresolvedReferenceValue != null);
            return new AttributeGroup(
                g.Key,
                values,
                g.First().Attribute.AttributePlurality == AttributePlurality.MultiValued,
                totalCount,
                isReference);
        })
        .ToList();
    }

    private HashSet<int> _unmanagedAttributeIds = new();

    /// <summary>
    /// Computes the Connected System attribute IDs that are unmanaged on this Connected System Object via
    /// Initial Export Only mappings (#223). An attribute is unmanaged when the object is past provisioning,
    /// joined to a Metaverse Object, and every enabled export mapping targeting the attribute for this object
    /// type is Initial Export Only (a single normally-managed mapping keeps the attribute managed).
    /// </summary>
    private async Task<HashSet<int>> ComputeUnmanagedAttributeIdsAsync(JimApplication jim)
    {
        var result = new HashSet<int>();
        if (ConnectedSystemObject == null ||
            ConnectedSystemObject.Status == ConnectedSystemObjectStatus.PendingProvisioning ||
            !ConnectedSystemObject.MetaverseObjectId.HasValue)
            return result;

        var syncRules = await jim.ConnectedSystems.GetSyncRulesAsync(CsId, includeDisabledSyncRules: false);
        var exportMappings = syncRules
            .Where(sr => sr.Direction == SyncRuleDirection.Export && sr.ConnectedSystemObjectTypeId == ConnectedSystemObject.TypeId)
            .SelectMany(sr => sr.AttributeFlowRules)
            .Where(m => m.TargetConnectedSystemAttributeId.HasValue);

        // A disabled mapping (#1485) manages nothing, so an attribute whose every mapping is Initial Export
        // Only or disabled is unmanaged on this object.
        result.UnionWith(exportMappings
            .GroupBy(m => m.TargetConnectedSystemAttributeId!.Value)
            .Where(g => g.All(m => m.InitialExportOnly || !m.Enabled))
            .Select(g => g.Key));

        return result;
    }

    private bool IsUnmanagedAttribute(AttributeGroup group)
    {
        if (_unmanagedAttributeIds.Count == 0)
            return false;

        var value = group.Values[0];
        var attributeId = value.AttributeId != 0 ? value.AttributeId : value.Attribute?.Id ?? 0;
        return _unmanagedAttributeIds.Contains(attributeId);
    }

    /// <summary>
    /// Whether the Connected System will only accept a value for this attribute when the object is created.
    /// Unlike Initial Export Only, this is a property of the discovered schema rather than of the Attribute
    /// Flow, so it holds whatever the Synchronisation Rules say and needs no rule lookup.
    /// </summary>
    private static bool IsCreateOnlyAttribute(AttributeGroup group)
    {
        return group.Values[0].Attribute?.Writability == AttributeWritability.WritableOnCreate;
    }

    private int GetExternalIdSortOrder(AttributeGroup group)
    {
        if (IsExternalId(group.Values[0])) return 0;
        if (IsSecondaryExternalId(group.Values[0])) return 1;
        return 2;
    }

    private bool IsExternalId(ConnectedSystemObjectAttributeValue value)
    {
        if (ConnectedSystemObject == null) return false;
        var attributeId = value.AttributeId != 0 ? value.AttributeId : value.Attribute?.Id ?? 0;
        return attributeId == ConnectedSystemObject.ExternalIdAttributeId;
    }

    private bool IsSecondaryExternalId(ConnectedSystemObjectAttributeValue value)
    {
        if (ConnectedSystemObject?.SecondaryExternalIdAttributeId == null) return false;
        var attributeId = value.AttributeId != 0 ? value.AttributeId : value.Attribute?.Id ?? 0;
        return attributeId == ConnectedSystemObject.SecondaryExternalIdAttributeId;
    }

    /// <summary>
    /// Reads one window of the Pending Export's queued attribute value changes. One Pending Export can carry
    /// every value of a large group, so the changes are read by offset and count rather than loaded whole, and
    /// the request's skip-the-count contract is passed straight through: a null total means "not counted", never
    /// that nothing matched.
    /// </summary>
    private async Task<VirtualisedWindow<PendingExportAttributeValueChange>> LoadPendingExportWindowAsync(
        VirtualisedWindowRequest request, CancellationToken token)
    {
        if (PendingExport == null)
            return new VirtualisedWindow<PendingExportAttributeValueChange>([], request.IncludeTotalCount ? 0 : null);

        using var jim = JimFactory.Create();
        var result = await jim.ConnectedSystems.GetAllPendingExportChangesRangeAsync(
            PendingExport.Id,
            request.StartIndex,
            request.Count,
            request.SearchText,
            request.IncludeTotalCount);

        return new VirtualisedWindow<PendingExportAttributeValueChange>(result.Results, result.TotalResults);
    }

    private static string GetAttributeValue(PendingExportAttributeValueChange change)
    {
        if (!string.IsNullOrEmpty(change.UnresolvedReferenceValue))
            return $"[Unresolved Reference: {change.UnresolvedReferenceValue}]";

        if (change.StringValue != null)
            return change.StringValue;

        if (change.DateTimeValue.HasValue)
            return change.DateTimeValue.Value.ToFriendlyDate();

        if (change.IntValue.HasValue)
            return change.IntValue.Value.ToString();

        if (change.ByteValue != null)
            return $"[Binary data: {change.ByteValue.Length} bytes]";

        return "[null]";
    }

    private static MudBlazor.Color GetAttributeChangeTypeColor(PendingExportAttributeChangeType changeType)
    {
        return changeType switch
        {
            PendingExportAttributeChangeType.Add => MudBlazor.Color.Primary,
            PendingExportAttributeChangeType.Update => MudBlazor.Color.Info,
            PendingExportAttributeChangeType.Remove => MudBlazor.Color.Warning,
            PendingExportAttributeChangeType.RemoveAll => MudBlazor.Color.Error,
            _ => MudBlazor.Color.Default,
        };
    }

    private static MudBlazor.Color GetAttributeChangeStatusColor(PendingExportAttributeChangeStatus status)
    {
        return status switch
        {
            PendingExportAttributeChangeStatus.Pending => MudBlazor.Color.Default,
            PendingExportAttributeChangeStatus.ExportedPendingConfirmation => MudBlazor.Color.Info,
            PendingExportAttributeChangeStatus.ExportedNotConfirmed => MudBlazor.Color.Warning,
            PendingExportAttributeChangeStatus.Failed => MudBlazor.Color.Error,
            _ => MudBlazor.Color.Default,
        };
    }

    private static MudBlazor.Color GetStatusColor(ConnectedSystemObjectStatus status)
    {
        return status switch
        {
            ConnectedSystemObjectStatus.Normal => MudBlazor.Color.Success,
            ConnectedSystemObjectStatus.Obsolete => MudBlazor.Color.Warning,
            ConnectedSystemObjectStatus.PendingProvisioning => MudBlazor.Color.Info,
            _ => MudBlazor.Color.Default,
        };
    }

    private static MudBlazor.Color GetJoinTypeColor(ConnectedSystemObjectJoinType joinType)
    {
        return joinType switch
        {
            ConnectedSystemObjectJoinType.Projected => MudBlazor.Color.Primary,
            ConnectedSystemObjectJoinType.Provisioned => MudBlazor.Color.Secondary,
            ConnectedSystemObjectJoinType.Joined => MudBlazor.Color.Info,
            ConnectedSystemObjectJoinType.NotJoined => MudBlazor.Color.Default,
            _ => MudBlazor.Color.Default,
        };
    }

    private static string MapInitiatorType(ActivityInitiatorType initiatorType)
    {
        return initiatorType switch
        {
            ActivityInitiatorType.User => "User",
            ActivityInitiatorType.ApiKey => "ApiKey",
            _ => "Unknown"
        };
    }

    /// <summary>
    /// Gets a user-friendly display identifier for the CSO.
    /// Returns the external ID value if available, otherwise falls back to the internal GUID.
    /// </summary>
    private string GetDisplayIdentifier()
    {
        return ExternalIdAttributeValue?.ToStringNoName()
        ?? ConnectedSystemObject?.Id.ToString()
        ?? CsoId;
    }
