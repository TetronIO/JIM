@* Inline, searchable, virtualised table of a single Connected System Object attribute's values. Used directly
   in the attributes table's value cell for multi-valued attributes whose value count exceeds the inline cap,
   so all values are browsable in place without a dialog. The scrolling, the search box, the count and the
   density all belong to the shared grid; this component only says how a value renders and how a window of
   values is read. *@

<div class="jim-mva-dialog-table">
@if (_isReferenceAttribute)
{
    <VirtualisedDataGrid T="ConnectedSystemObjectAttributeValue"
                         ContainerId="@($"cso-mva-{_slug}-references")"
                         UrlParameterPrefix="@($"{_slug}-")"
                         StateKey="@AttributeName"
                         DefaultSortBy="@SourceOrderSort"
                         LoadWindow="LoadValueWindowAsync"
                         SearchPlaceholder="@($"Search {AttributeName.ToLower()}...")"
                         SingularName="Value"
                         PluralName="Values">
        <Columns>
            <TemplateColumn Title="Display Name" Sortable="false">
                <HeaderTemplate>
                    <MudText Typo="Typo.button">Display Name</MudText>
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.ReferenceValue != null)
                    {
                        var reference = context.Item.ReferenceValue;
                        <MudLink Href="@Utilities.GetConnectedSystemObjectHref(reference)">
                            @reference.NameOrId
                        </MudLink>
                    }
                    else if (context.Item.UnresolvedReferenceValue != null)
                    {
                        <span class="jim-attr-unresolved">
                            <MudIcon Icon="@Icons.Material.Filled.LinkOff" Class="mr-1" />
                            <span class="mud-text-secondary jim-text-code">@context.Item.UnresolvedReferenceValue</span>
                        </span>
                    }
                    else
                    {
                        <span class="jim-text-code">@(context.Item.ToStringNoName())</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Type" Sortable="false">
                <HeaderTemplate>
                    <MudText Typo="Typo.button">Type</MudText>
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.ReferenceValue != null)
                    {
                        var reference = context.Item.ReferenceValue;
                        <MudLink Href="@Utilities.GetConnectedSystemSchemaHref(reference.ConnectedSystemId, reference.Type.Name)">
                            @reference.Type.Name
                        </MudLink>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Secondary ID" Sortable="false">
                <HeaderTemplate>
                    <MudText Typo="Typo.button">Secondary ID</MudText>
                </HeaderTemplate>
                <CellTemplate>
                    @{
                        // Captured before the guard rather than dereferenced through it in the markup: a chained
                        // dereference under an @if is what CodeQL reads as a possible null (JIM.Web/CLAUDE.md).
                        var secondaryId = context.Item.ReferenceValue?.SecondaryExternalIdAttributeValue;
                    }
                    @if (secondaryId != null)
                    {
                        <span class="mud-text-secondary">
                            @secondaryId.ToStringNoName()
                        </span>
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <EmptyContent Context="grid">
            @RenderEmptyState(grid)
        </EmptyContent>
    </VirtualisedDataGrid>
}
else
{
    <VirtualisedDataGrid T="ConnectedSystemObjectAttributeValue"
                         ContainerId="@($"cso-mva-{_slug}-values")"
                         UrlParameterPrefix="@($"{_slug}-")"
                         StateKey="@AttributeName"
                         DefaultSortBy="@SourceOrderSort"
                         LoadWindow="LoadValueWindowAsync"
                         SearchPlaceholder="@($"Search {AttributeName.ToLower()}...")"
                         SingularName="Value"
                         PluralName="Values">
        <Columns>
            <TemplateColumn Title="Value" Sortable="false">
                <HeaderTemplate>
                    <MudText Typo="Typo.button">Value</MudText>
                </HeaderTemplate>
                <CellTemplate>
                    <CsoAttributeValue Value="@context.Item" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <EmptyContent Context="grid">
            @RenderEmptyState(grid)
        </EmptyContent>
    </VirtualisedDataGrid>
}
</div>

@* ─── Render Fragments ─── *@

@* A search that matched nothing is a different situation from an attribute that genuinely holds no values,
   and only the first has a way out to offer. *@
@{
    RenderFragment RenderEmptyState(VirtualisedDataGrid<ConnectedSystemObjectAttributeValue> grid) => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No values match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.List"
                             PrimaryText="This attribute has no values"
                             SecondaryText="Values appear here once an Import brings them in from the Connected System." />
        }
    };
}

@code {
    /// <summary>
    /// The name of the attribute whose values are being listed.
    /// </summary>
    [Parameter]
    public string AttributeName { get; set; } = string.Empty;

    /// <summary>
    /// The owning Connected System Object's ID.
    /// </summary>
    [Parameter]
    public Guid ConnectedSystemObjectId { get; set; }

    /// <summary>
    /// Whether this attribute holds reference values (drives the multi-column reference layout).
    /// </summary>
    [Parameter]
    public bool IsReferenceAttribute { get; set; }

    /// <summary>
    /// Whether the host page's tables are showing compact rows. Retained for the host's binding: the grid reads
    /// the same saved density preference the host's toggle writes, so it no longer needs threading through.
    /// </summary>
    [Parameter]
    public bool Dense { get; set; }

    /// <summary>
    /// The sort key standing for "the order the application layer returned them in". The range read takes no sort
    /// parameter (it orders by value id, which is the total order its offset and count are addressed against), so
    /// no column offers a sort; naming the default something no header claims keeps the grid from showing a sort
    /// arrow over an order it did not choose.
    /// </summary>
    private const string SourceOrderSort = "order";

    private bool _isReferenceAttribute;

    /// <summary>
    /// The attribute name reduced to a URL- and element-id-safe token. Several of these tables render on one
    /// page, one per capped multi-valued attribute, so the grid's element id and URL parameters have to carry
    /// which attribute they belong to.
    /// </summary>
    private string _slug = string.Empty;

    protected override void OnParametersSet()
    {
        _isReferenceAttribute = IsReferenceAttribute;
        _slug = Slugify(AttributeName);
    }

    /// <summary>
    /// Reads one window of this attribute's values: one range read at the offset and count the grid asked for.
    /// The total comes back only when the request asked for it, and a null total is passed straight through
    /// rather than turned into a zero, which the grid would read as "nothing matched".
    /// </summary>
    private async Task<VirtualisedWindow<ConnectedSystemObjectAttributeValue>> LoadValueWindowAsync(
        VirtualisedWindowRequest request, CancellationToken _)
    {
        using var jim = JimFactory.Create();
        var result = await jim.ConnectedSystems.GetAttributeValuesRangeAsync(
            ConnectedSystemObjectId, AttributeName, request.StartIndex, request.Count,
            request.SearchText, request.IncludeTotalCount);

        return new VirtualisedWindow<ConnectedSystemObjectAttributeValue>(result.Results, result.TotalResults);
    }

    private static string Slugify(string name)
    {
        var slug = new string(name.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray());
        return string.IsNullOrEmpty(slug) ? "attribute" : slug;
    }
}
