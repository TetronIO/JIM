@*
    Presents the certificate a directory server offered when a connection to it was refused, laid out like the
    certificate itself so it reads as the document being talked about rather than another block of error text.
    Everything here is public certificate material; no private key or credential is ever involved.
*@

@if (Diagnostic != null)
{
    <div class="jim-certificate @(Compact ? "jim-certificate-compact" : "")">
        <div class="jim-certificate-inner">
            <div class="jim-certificate-seal">
                <MudIcon Icon="@SealIcon" Size="Size.Medium" />
            </div>

            @* The frame stretches with the page; the content does not. It stays a centred column of a readable
               width, which is what keeps a wide card reading as a certificate rather than a banner. *@
            <div class="jim-certificate-content">
                <div class="jim-certificate-eyebrow">@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.CertEyebrow, Diagnostic.Host, Diagnostic.Port)</div>

                <div class="jim-certificate-subject">@CertificateDisplay.FormatDistinguishedName(Diagnostic.Subject)</div>

                <div class="jim-certificate-issuer">
                    @if (Diagnostic.IsSelfSigned)
                    {
                        <span>@ConnectedSystemText.CertSelfSigned</span>
                    }
                    else
                    {
                        <span>@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.CertIssuedBy, CertificateDisplay.FormatDistinguishedName(Diagnostic.Issuer))</span>
                    }
                </div>

                <div class="jim-certificate-rule"></div>

                <div class="jim-certificate-fields">
                    <div class="jim-certificate-field">
                        <span class="jim-certificate-label">@ConnectedSystemText.CertFieldIssuedFor</span>
                        @if (Diagnostic.SubjectAlternativeNames.Count > 0)
                        {
                            <span class="jim-certificate-names">
                                @foreach (var name in Diagnostic.SubjectAlternativeNames)
                                {
                                    <span class="jim-certificate-name @(NameMatchesHost(name) ? "jim-certificate-name-match" : "")">@name</span>
                                }
                            </span>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </div>

                    <div class="jim-certificate-field">
                        <span class="jim-certificate-label">@ConnectedSystemText.CertFieldValid</span>
                        <span class="jim-certificate-value @(Diagnostic.IsExpired || Diagnostic.IsNotYetValid ? "jim-certificate-value-problem" : "")">
                            @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.CertValidRange, FormatDate(Diagnostic.ValidFrom), FormatDate(Diagnostic.ValidTo))
                        </span>
                    </div>

                    <div class="jim-certificate-field">
                        <span class="jim-certificate-label">@ConnectedSystemText.CertFieldThumbprint</span>
                        <span class="jim-certificate-value jim-certificate-thumbprint">@CertificateDisplay.FormatThumbprint(Diagnostic.Thumbprint)</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Diagnostic.SignatureAlgorithm))
                    {
                        <div class="jim-certificate-field">
                            <span class="jim-certificate-label">@ConnectedSystemText.CertFieldSignature</span>
                            <span class="jim-certificate-value">@Diagnostic.SignatureAlgorithm</span>
                        </div>
                    }
                </div>

                @* Nothing wrong is the good outcome (JIM trusts it, or the connection failed for another reason), so it
                   is not drawn as a refusal. *@
                <div class="jim-certificate-verdict @(IsSound ? "jim-certificate-verdict-ok" : "")">
                    <MudIcon Icon="@(IsSound ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Block)" Size="Size.Small" Class="mr-2" />
                    <span class="jim-certificate-verdict-reason">@DescribeReason(Diagnostic.FailureReason)</span>
                </div>

                @if (!string.IsNullOrEmpty(Diagnostic.Remediation))
                {
                    <div class="jim-certificate-remediation">@(Diagnostic.RemediationDetail is { } remediation ? remediation.Show() : Diagnostic.Remediation)</div>
                }

                @* The chain JIM assembled, from the root down to the server, with where each certificate came from: a
                   certificate the server sent, or one downloaded from an address another certificate named, has not
                   been vouched for by anyone yet, which is worth knowing before trusting it. *@
                @if (Diagnostic.Chain.Count > 0)
                {
                    <div class="jim-certificate-chain">
                        <div class="jim-certificate-label">@ConnectedSystemText.CertChainHeading</div>
                        @if (!Diagnostic.IsChainComplete && !string.IsNullOrEmpty(Diagnostic.MissingIssuer))
                        {
                            <div class="jim-certificate-chain-row jim-certificate-chain-row-missing" data-testid="jim-certificate-chain-missing">
                                <span class="jim-certificate-chain-name">@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.CertChainMissing, CertificateDisplay.FormatDistinguishedName(Diagnostic.MissingIssuer))</span>
                                <span class="jim-certificate-chain-source">@ConnectedSystemText.CertChainNotSent</span>
                                <span class="jim-certificate-chain-role">@ConnectedSystemText.CertChainNotFound</span>
                            </div>
                        }
                        @* On a connection that accepts only a root, the whole chain is still shown, so the card does not read
                           as though the server sent one certificate; the root is marked as the one on offer and the rest
                           are there to read. Elsewhere every row is a working choice, so none is singled out. *@
                        @foreach (var link in ChainForDisplay)
                        {
                            <div class="jim-certificate-chain-row @RowClass(link)" data-testid="jim-certificate-chain-element"
                                 data-trust="@RowTrust(link)">
                                <span class="jim-certificate-chain-name">@link.CommonName</span>
                                <span class="jim-certificate-chain-source">@CertificateDisplay.FormatSource(link.Element.Source)</span>
                                <span class="jim-certificate-chain-role">@CertificateDisplay.FormatRole(link.Role)</span>
                            </div>
                        }
                        @if (Diagnostic.TrustAnchorMustBeRoot && ChainForDisplay.Any(link => !link.CanBeTrusted))
                        {
                            <div class="jim-certificate-chain-caption" data-testid="jim-certificate-chain-reference-note">
                                @ConnectedSystemText.CertChainReferenceNote
                            </div>
                        }
                    </div>
                }

                @* The decision is offered where the problem is reported, so the administrator does not have to go and
                   obtain the certificate by other means. Only for an untrusted issuer: for an expired certificate or
                   a name mismatch, trusting cannot fix the failure, and a button that cannot work invites the click. *@
                @if (ShowTrustAction)
                {
                    <div class="jim-certificate-actions">
                        <span class="jim-certificate-action-note">
                            @if (Diagnostic.IsSelfSigned)
                            {
                                <text>
                                    @ConnectedSystemText.CertSelfSignedBefore <MudLink Href="/admin/certificates">@ConnectedSystemText.CertTrustedStore</MudLink> @ConnectedSystemText.CertSelfSignedAfter
                                </text>
                            }
                            else if (Diagnostic.TrustAnchorMustBeRoot)
                            {
                                <text>
                                    @ConnectedSystemText.CertRootBefore <MudLink Href="/admin/certificates">@ConnectedSystemText.CertTrustedStore</MudLink>@ConnectedSystemText.CertAfterStoreLink
                                </text>
                            }
                            else if (HasAChoice)
                            {
                                <text>
                                    @ConnectedSystemText.CertChoiceBefore <MudLink Href="/admin/certificates">@ConnectedSystemText.CertTrustedStore</MudLink>@ConnectedSystemText.CertAfterStoreLink
                                </text>
                            }
                            else
                            {
                                <text>
                                    @ConnectedSystemText.CertServerOnlyBefore <MudLink Href="/admin/certificates">@ConnectedSystemText.CertTrustedStore</MudLink> @ConnectedSystemText.CertServerOnlyAfter
                                </text>
                            }
                        </span>
                        <MudButton Variant="Variant.Filled" DropShadow="false"
                                   StartIcon="@Icons.Material.Filled.VerifiedUser" Disabled="_trusting"
                                   OnClick="TrustAsync" data-testid="jim-certificate-trust">
                            @(Diagnostic.TrustAnchorMustBeRoot && !Diagnostic.IsSelfSigned ? ConnectedSystemText.CertTrustRoot : HasAChoice ? ConnectedSystemText.CertChooseTrust : ConnectedSystemText.CertTrustThis)
                        </MudButton>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    /// <summary>
    /// The certificate and the reason it was refused.
    /// </summary>
    [Parameter, EditorRequired]
    public ServerCertificateDiagnostic? Diagnostic { get; set; }

    /// <summary>
    /// Tightens the layout for use inside a settings form, where the card sits alongside other validation output.
    /// </summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>
    /// The Connected System this failure belongs to. Supplying it is what turns on the trust action, so the card
    /// stays usable where there is nothing to act on (for example an Activity that names no Connected System).
    /// </summary>
    [Parameter]
    public int? ConnectedSystemId { get; set; }

    /// <summary>
    /// Names the Connected System in the change reason JIM prefills.
    /// </summary>
    [Parameter]
    public string? ConnectedSystemName { get; set; }

    /// <summary>
    /// Connectivity settings the administrator has entered but not yet saved. Supplied by a settings form, where the
    /// address on screen is the one they are trying to reach and JIM has nothing saved for it: settings that fail
    /// validation are never saved, and a certificate JIM does not trust is a validation failure.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<ConnectedSystemSettingValueDraft>? DraftSettingValues { get; set; }

    /// <summary>
    /// Raised once a certificate has been trusted, so the host can do the thing the administrator was trying to do
    /// (re-run the connection test, reload the Activity) rather than leaving them to work out what happens next.
    /// </summary>
    [Parameter]
    public EventCallback OnTrusted { get; set; }

    private bool _trusting;

    /// <summary>
    /// Offered only where trusting the certificate is what fixes the failure, there is something in the chain that
    /// would fix it, and the caller supplied the context needed to act on it. A connection that accepts only a root
    /// offers nothing where JIM could not find the root: its remediation says where to get it.
    /// </summary>
    private bool ShowTrustAction =>
        ConnectedSystemId.HasValue &&
        Diagnostic?.FailureReason == ServerCertificateFailureReason.UntrustedIssuer &&
        !string.IsNullOrEmpty(Diagnostic.Thumbprint) &&
        ChainFromTheTop.Count > 0;

    /// <summary>
    /// The certificates in the chain, the root first, as the trust dialog will offer them.
    /// </summary>
    private List<ServerCertificateTrustOption> ChainFromTheTop =>
        Diagnostic == null ? [] : ServerCertificateTrustOption.For(Diagnostic);

    /// <summary>
    /// Every certificate in the chain, the root first, including those this connection cannot be told to trust.
    /// </summary>
    private List<ServerCertificateTrustOption> ChainForDisplay =>
        Diagnostic == null ? [] : ServerCertificateTrustOption.Chain(Diagnostic);

    private bool HasAChoice => ChainFromTheTop.Count > 1;

    /// <summary>
    /// Only a connection that accepts only a root distinguishes its rows; elsewhere the attribute is left off.
    /// </summary>
    private string? RowTrust(ServerCertificateTrustOption link) =>
        Diagnostic?.TrustAnchorMustBeRoot != true ? null : link.CanBeTrusted ? "offered" : "reference";

    private string RowClass(ServerCertificateTrustOption link) => RowTrust(link) switch
    {
        "offered" => "jim-certificate-chain-row-offered",
        "reference" => "jim-certificate-chain-row-reference",
        _ => string.Empty
    };

    private bool IsSound => Diagnostic?.FailureReason == ServerCertificateFailureReason.None;

    private async Task TrustAsync()
    {
        if (_trusting || Diagnostic == null || !ConnectedSystemId.HasValue)
            return;

        _trusting = true;

        try
        {
            var outcome = await TrustServerCertificateDialog.ShowAsync(DialogService, Diagnostic, ConnectedSystemId.Value, ConnectedSystemName, DraftSettingValues);
            if (outcome == null)
                return;

            Snackbar.Add(outcome == ServerCertificateTrustOutcome.AlreadyTrusted
                ? string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.CertAlreadyTrusted, ConnectedSystemText.CertTrustedStore)
                : ConnectedSystemText.CertTrusted, Severity.Success);

            await OnTrusted.InvokeAsync();
        }
        finally
        {
            _trusting = false;
        }
    }

    private string SealIcon => Diagnostic?.FailureReason switch
    {
        ServerCertificateFailureReason.Expired => Icons.Material.Filled.HistoryToggleOff,
        ServerCertificateFailureReason.NotYetValid => Icons.Material.Filled.HistoryToggleOff,
        ServerCertificateFailureReason.NameMismatch => Icons.Material.Filled.WrongLocation,
        ServerCertificateFailureReason.UntrustedIssuer => Icons.Material.Filled.GppMaybe,
        ServerCertificateFailureReason.NoCertificatePresented => Icons.Material.Filled.NoEncryption,
        ServerCertificateFailureReason.InvalidChain => Icons.Material.Filled.LinkOff,
        _ => Icons.Material.Filled.WorkspacePremium
    };

    private static string DescribeReason(ServerCertificateFailureReason reason) => reason switch
    {
        ServerCertificateFailureReason.UntrustedIssuer => string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.CertReasonUntrusted, ConnectedSystemText.CertTrustedStore),
        ServerCertificateFailureReason.InvalidChain => ConnectedSystemText.CertReasonInvalidChain,
        ServerCertificateFailureReason.NameMismatch => ConnectedSystemText.CertReasonNameMismatch,
        ServerCertificateFailureReason.Expired => ConnectedSystemText.CertReasonExpired,
        ServerCertificateFailureReason.NotYetValid => ConnectedSystemText.CertReasonNotYetValid,
        ServerCertificateFailureReason.NoCertificatePresented => ConnectedSystemText.CertReasonNoCertificate,
        ServerCertificateFailureReason.None => ConnectedSystemText.CertReasonNone,
        _ => ConnectedSystemText.CertReasonUnrecognised
    };

    /// <summary>
    /// Highlights the name that would have satisfied the check, so a mismatch is visible at a glance rather than
    /// needing the reader to compare strings themselves.
    /// </summary>
    private bool NameMatchesHost(string name)
    {
        if (Diagnostic == null || string.IsNullOrEmpty(Diagnostic.Host))
            return false;

        return string.Equals(name, Diagnostic.Host, StringComparison.OrdinalIgnoreCase);
    }


    private static string FormatDate(DateTime? value) => value?.ToString("dd MMM yyyy") ?? ConnectedSystemText.CertUnknownDate;

}
