@page "/admin/apikeys/{Id:guid}"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Activities
@using JIM.Models.Security
@using JIM.Models.Utility
@using JIM.Utilities
@using JIM.Web.Models
@using JIM.Web.Pages.Admin.Components
@using JIM.Web.Services
@using Humanizer
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>API Key: @_apiKey?.Name</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Api" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>API Key:</span> <span class="mud-primary-text">@_apiKey?.Name</span></MudText>
<div class="d-flex justify-space-between align-center">
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
    @if (_apiKey != null)
    {
        <AuditInfo Entity="@_apiKey" />
    }
</div>

@if (_apiKey != null)
{
    <NavigableMudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="false" Outlined="true" Class="mt-2" TabPanelsClass="pt-5">

        <MudTabPanel Text="Details">
            <MudPaper Class="pa-4" Outlined="true">
                <MudForm @bind-IsValid="_detailsFormValid">
                    <PrefilledFormValidator />
                    <MudTextField T="string" @bind-Value="_apiKey.Name" Label="Name" Required="true" RequiredError="A name is required"
                        Immediate="true" Variant="Variant.Outlined" />
                    <MudTextField T="string" @bind-Value="_apiKey.Description" Label="Description" Required="false"
                        Lines="2" MaxLines="6" Sizing="InputSizing.Auto" Variant="Variant.Outlined" Class="mt-5" />
                </MudForm>
                @* mt-3: see ConnectedSystemDetailsTab, same in-panel button spacing *@
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_detailsFormValid)" Class="mt-3" OnClick="HandleSaveDetailsAsync" DropShadow="false">Save Changes</MudButton>
            </MudPaper>

            <MudPaper Class="pa-4 mt-6" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-4">Metadata</MudText>
                <MudGrid Spacing="4">
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">ID:</MudText>
                        <MudText Class="jim-text-code">@_apiKey.Id</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Key Prefix:</MudText><br />
                        <MudTooltip Text="Only the key's prefix is stored, for security. The full key is shown once at creation and cannot be retrieved again." Arrow="true" Placement="Placement.Top">
                            <span class="jim-code-inline">@_apiKey.KeyPrefix...</span>
                        </MudTooltip>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Status:</MudText><br />
                        @if (_apiKey.IsEnabled)
                        {
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Success" Class="ml-0">Enabled</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Class="ml-0">Disabled</MudChip>
                        }
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Expires:</MudText>
                        @if (_apiKey.ExpiresAt.HasValue)
                        {
                            var expiresAt = _apiKey.ExpiresAt.Value;
                            @if (expiresAt < DateTime.UtcNow)
                            {
                                <br /><MudChip T="string" Variant="Variant.Text" Color="Color.Error" Class="ml-0">Expired (@expiresAt.ToLocalTime().ToFriendlyDate())</MudChip>
                            }
                            else
                            {
                                <MudText>@expiresAt.ToLocalTime().ToFriendlyDate()</MudText>
                            }
                        }
                        else
                        {
                            <MudText>Never</MudText>
                        }
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Last Used:</MudText>
                        @if (_apiKey.LastUsedAt.HasValue)
                        {
                            var lastUsedAt = _apiKey.LastUsedAt.Value;
                            <MudText>
                                @lastUsedAt.ToLocalTime().ToFriendlyDate()
                                @if (!string.IsNullOrEmpty(_apiKey.LastUsedFromIp))
                                {
                                    <span> from
                                        <MudTooltip Text="The IP address the most recent request authenticated with this key came from." Arrow="true" Placement="Placement.Top">
                                            <span class="jim-code-inline">@_apiKey.LastUsedFromIp</span>
                                        </MudTooltip>
                                    </span>
                                }
                            </MudText>
                        }
                        else
                        {
                            <MudText>Never</MudText>
                        }
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Roles:</MudText><br />
                        @if (_apiKey.Roles.Count > 0)
                        {
                            @foreach (var role in _apiKey.Roles)
                            {
                                <MudChip T="string" Variant="Variant.Text" Color="Color.Info" Class="mr-1">@role.Name</MudChip>
                            }
                        }
                        else
                        {
                            <MudText>No roles assigned</MudText>
                        }
                    </MudItem>

                    @if (_apiKey.IsInfrastructureKey)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.button" Class="mud-text-secondary">Type:</MudText><br />
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Warning" Icon="@Icons.Material.Filled.Construction">Infrastructure Key</MudChip>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Activity">
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                All Activities initiated by this API Key.
            </MudText>

            @* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count, density
               and the search box) lives in the shared grid; this page supplies the columns, the window loader and
               the empty states. *@
            <VirtualisedDataGrid T="Activity"
                                 ContainerId="api-key-activity"
                                 StateKey="@Id.ToString()"
                                 DefaultSortBy="created"
                                 DefaultSortDescending="true"
                                 LoadWindow="LoadActivityWindowAsync"
                                 RowClicked="HandleRowClicked"
                                 SingularName="Activity"
                                 PluralName="Activities"
                                 SearchPlaceholder="Search type or target">
                <Columns>
                    <TemplateColumn Title="Type" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Type" Name="type" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @context.Item.TargetType.ToString().SplitOnCapitalLetters()
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Target" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Target" Name="target" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @(!string.IsNullOrEmpty(context.Item.TargetName) ? context.Item.TargetName : "(no name)")
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Operation" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Operation" Name="operation" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="string" Variant="Variant.Text"
                                Color="Helpers.GetActivityMudBlazorColorForOperation(context.Item.TargetOperationType)">
                                @context.Item.TargetOperationType.ToString().SplitOnCapitalLetters()
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Created" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Created" Name="created" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                                <span>@context.Item.Created.ToLocalTime().ToRelativeTime()</span>
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Status" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Status" Name="status" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="string" Variant="Variant.Text"
                                Color="Helpers.GetActivityMudBlazorColorForStatus(context.Item.Status)">
                                @context.Item.Status.ToString().SplitOnCapitalLetters()
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Execution Time" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Execution Time" Name="executiontime" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.ExecutionTime.HasValue)
                            {
                                var executionTime = context.Item.ExecutionTime.Value;
                                @executionTime.ToCasualString()
                            }
                            else
                            {
                                <EmptyValue />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <EmptyContent Context="grid">
                    @* A search that matched nothing has a way out to offer; an API Key that has never been used
                       has none, so it says what would put rows here instead. *@
                    @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                         PrimaryText="@($"No Activities match \"{grid.SearchText}\"")"
                                         SecondaryText="Try a different search term, or clear the search."
                                         ActionText="Clear Search"
                                         OnAction="@(() => grid.ClearSearchAsync())" />
                    }
                    else
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.Api"
                                         PrimaryText="No Activities have been recorded for this API Key"
                                         SecondaryText="Activities appear here once this API Key is used to call the REST API." />
                    }
                </EmptyContent>
            </VirtualisedDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="Changes" BadgeData="@(_changeCount > 0 ? _changeCount.ToString("N0") : null)" BadgeColor="Color.Primary">
            <ConfigurationChangesTab TargetType="ActivityTargetType.ApiKey" ObjectGuidId="Id" ObjectTypeLabel="API Key" />
        </MudTabPanel>

    </NavigableMudTabs>
}
else if (!_loading)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-5">
        API Key not found. It may have been deleted.
    </MudAlert>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private ApiKey? _apiKey;
    private bool _loading = true;
    private int _changeCount;
    private bool _detailsFormValid;

    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnParametersSetAsync()
    {
        using var jim = JimFactory.Create();
        _loading = true;
        _apiKey = await jim.Security.GetApiKeyAsync(Id);
        _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.ApiKey, Id, 1, 1)).TotalResults;
        _loading = false;

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("Home", href: "/", icon: Icons.Material.Filled.Home),
            new("Administration", href: "/admin"),
            new("API Keys", href: "/admin/apikeys"),
            new(_apiKey?.Name ?? "Not Found", href: null, disabled: true)
        };
    }

    private async Task HandleSaveDetailsAsync()
    {
        if (_apiKey == null)
            return;

        // offer an optional reason for the configuration change history; cancelling aborts the save
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
        if (cancelled)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.Security.UpdateApiKeyAsync(_apiKey, user, changeReason);
        Snackbar.Add("API key updated successfully.", Severity.Success);
    }

    /// <summary>
    /// Reads one window of the Activities this API Key initiated. The list is unbounded (an API Key in daily use
    /// accumulates one Activity per write), so it is read by offset and count rather than loaded and sliced, and
    /// the request's skip-the-count contract is passed straight through: a null total means "not counted", never
    /// that nothing matched.
    /// </summary>
    private async Task<VirtualisedWindow<Activity>> LoadActivityWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        if (_apiKey == null)
            return new VirtualisedWindow<Activity>([], request.IncludeTotalCount ? 0 : null);

        using var jim = JimFactory.Create();
        var result = await jim.Activities.GetActivitiesRangeAsync(
            request.StartIndex,
            request.Count,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            _apiKey.Id,
            includeTotalCount: request.IncludeTotalCount);

        return new VirtualisedWindow<Activity>(result.Results, result.TotalResults);
    }

    private void HandleRowClicked(Activity activity)
    {
        NavManager.NavigateTo($"/activity/{activity.Id}");
    }
}
