@*
    The live plain-language summary for the WhenAuthoritativeSourceDisconnected deletion rule (#119).
    Deletion configuration is the most dangerous setting on the Metaverse Object Type page; this alert
    restates the full consequence (trigger mode, sources by name, grace period) in one sentence so a
    misconfiguration is visible before Save. Blazor re-rendering keeps it current as the administrator
    changes the trigger mode, source selection or grace period.

    Each sentence is one resource string. Its values are passed in as fragments (see Rich), so a translation
    can place the object type, the grace period and the source names where its grammar needs them.
*@

<MudAlert Severity="Severity.Info">
    <MudText Typo="Typo.body1">
        @if (SourceNames.Count == 0)
        {
            @ConnectorSpaceText.DtsNoSource
        }
        else if (TriggerMode == AuthoritativeSourceTriggerMode.AllSourcesDisconnect)
        {
            if (SourceNames.Count == 1)
            {
                @Rich(ConnectorSpaceText.DtsAllSingle, Strong(ObjectTypeName), FateFragment, NameList(SourceNames, ConnectorSpaceText.DtsListAnd))
            }
            else
            {
                @Rich(ConnectorSpaceText.DtsAllMany, Strong(ObjectTypeName), FateFragment, NameList(SourceNames, ConnectorSpaceText.DtsListAnd), Strong(ConnectorSpaceText.DtsAllWord))
            }
        }
        else
        {
            if (SourceNames.Count == 1)
            {
                @Rich(ConnectorSpaceText.DtsAnySingle, Strong(ObjectTypeName), FateFragment, NameList(SourceNames, ConnectorSpaceText.DtsListOr))
            }
            else
            {
                @Rich(ConnectorSpaceText.DtsAnyMany, Strong(ObjectTypeName), FateFragment, Strong(ConnectorSpaceText.DtsAnyWord), NameList(SourceNames, ConnectorSpaceText.DtsListOr))
            }
        }
    </MudText>
</MudAlert>

@code {
    /// <summary>
    /// The Metaverse Object Type's singular name, e.g. "Person".
    /// </summary>
    [Parameter, EditorRequired]
    public string ObjectTypeName { get; set; } = string.Empty;

    /// <summary>
    /// The trigger mode currently selected in the editor.
    /// </summary>
    [Parameter]
    public AuthoritativeSourceTriggerMode TriggerMode { get; set; }

    /// <summary>
    /// The display names of the currently selected authoritative sources.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> SourceNames { get; set; } = Array.Empty<string>();

    /// <summary>
    /// The grace period currently configured in the editor. Null or zero means immediate deletion.
    /// </summary>
    [Parameter]
    public TimeSpan? GracePeriod { get; set; }

    /// <summary>
    /// "scheduled for deletion, with a 30 day grace period," or "deleted immediately, with no grace period,"; the grace
    /// period is set in bold.
    /// </summary>
    private RenderFragment FateFragment =>
        GracePeriod is { } gracePeriod && gracePeriod > TimeSpan.Zero
            ? Rich(ConnectorSpaceText.DtsFateGrace, Strong(FormatGracePeriodAdjective(gracePeriod)))
            : Plain(ConnectorSpaceText.DtsFateImmediate);

    /// <summary>
    /// Renders a resource sentence in which each <c>{n}</c> is replaced by the fragment given at that position, so a
    /// translation can put each value where its grammar needs it. Text is encoded by Blazor; markup is only what this
    /// component builds.
    /// </summary>
    private static RenderFragment Rich(string template, params RenderFragment[] parts) => builder =>
    {
        var sequence = 0;
        var position = 0;
        while (position < template.Length)
        {
            var open = template.IndexOf('{', position);
            if (open < 0)
            {
                builder.AddContent(sequence++, template[position..]);
                break;
            }

            var close = template.IndexOf('}', open);
            builder.AddContent(sequence++, template[position..open]);
            builder.AddContent(sequence++, parts[int.Parse(template[(open + 1)..close], System.Globalization.CultureInfo.InvariantCulture)]);
            position = close + 1;
        }
    };

    private static RenderFragment Plain(string text) => builder => builder.AddContent(0, text);

    private static RenderFragment Strong(string text) => builder =>
    {
        builder.OpenElement(0, "strong");
        builder.AddContent(1, text);
        builder.CloseElement();
    };

    /// <summary>
    /// The selected source names in bold, joined with commas and the given final conjunction,
    /// e.g. "HR, Payroll and Active Directory".
    /// </summary>
    private static RenderFragment NameList(IReadOnlyList<string> names, string conjunction) => builder =>
    {
        var sequence = 0;
        for (var i = 0; i < names.Count; i++)
        {
            if (i > 0)
                builder.AddContent(sequence++, i == names.Count - 1 ? $" {conjunction} " : ", ");
            builder.OpenElement(sequence++, "strong");
            builder.AddContent(sequence++, names[i]);
            builder.CloseElement();
        }
    };

    /// <summary>
    /// Formats a grace period as a compound adjective ("30 day", "1 day, 6 hour"), for use in
    /// "a 30 day grace period"; compound adjectives take no plural.
    /// </summary>
    private static string FormatGracePeriodAdjective(TimeSpan period)
    {
        var parts = new List<string>();
        if (period.Days > 0) parts.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectorSpaceText.DtsAdjDay, period.Days));
        if (period.Hours > 0) parts.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectorSpaceText.DtsAdjHour, period.Hours));
        if (period.Minutes > 0) parts.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectorSpaceText.DtsAdjMinute, period.Minutes));
        return parts.Count > 0 ? string.Join(", ", parts) : ConnectorSpaceText.DtsAdjZero;
    }
}
