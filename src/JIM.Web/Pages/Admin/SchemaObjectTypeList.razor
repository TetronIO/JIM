<PageTitle>Schema</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Schema" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>Schema:</span> <span class="mud-primary-text">@TabTitle</span></MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">Manage Metaverse Object Types and their attributes, and see how data flows into and out of them.</MudText>

@* TabPanelsClass is pa-0 rather than pt-5 because both tabs host a virtualised grid, and the grid supplies its
   own mt-5 (see the tab content spacing rule in JIM.Web/CLAUDE.md: never stack panel padding on top of content
   margin). *@
<NavigableMudTabs @bind-ActivePanelIndex="_activeTabIndex" Elevation="0" Rounded="true" ApplyEffectsToContainer="false" Outlined="true" TabPanelsClass="pa-0" Class="mt-5">
    <MudTabPanel Text="Object Types" Icon="@Icons.Material.Filled.Category">
        @* Same shared grid as the Attributes tab, but windowed in memory: Object Types are a small configuration
           list, loaded whole once, so search and sort are applied in the page rather than each becoming a
           database range read. The URL parameters are prefixed so this grid's state cannot collide with the
           Attributes grid's (unprefixed) q/sort/desc/row on the shared page URL. The tab already says "Object
           Types", so there is no toolbar title and the count carries the nouns. *@
        <VirtualisedDataGrid @ref="_objectTypeGrid" T="MetaverseObjectTypeHeader"
                             ContainerId="metaverse-object-type-list"
                             UrlParameterPrefix="ot-"
                             DefaultSortBy="name"
                             LoadWindow="LoadObjectTypeWindowAsync"
                             SingularName="Metaverse Object Type"
                             PluralName="Metaverse Object Types"
                             SearchPlaceholder="Search by name">
            <ToolBarExtras>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           DropShadow="false" OnClick="OpenCreateObjectTypeDialogAsync">New Object Type</MudButton>
            </ToolBarExtras>
            <Columns>
                <TemplateColumn Title="Name" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Name" Name="name" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudIcon Icon="@Helpers.ResolveObjectTypeIcon(context.Item.Icon)" Class="mr-1" Style="vertical-align: middle;" />
                        <MudLink Href="@("/admin/schema/object-types/"+context.Item.Id)">@context.Item.Name</MudLink>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Attributes" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Attributes" Name="attributes" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.AttributesCount
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Deletion Rule" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Deletion Rule" Name="deletionrule" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @{
                            var (label, color, icon) = GetDeletionRuleDisplay(context.Item.DeletionRule);
                        }
                        <MudTooltip Text="@GetDeletionRuleTooltip(context.Item)" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Variant="Variant.Text" Color="@color" Icon="@icon">@label</MudChip>
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Predefined Searches?" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Predefined Searches?" Name="predefinedsearches" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @(context.Item.HasPredefinedSearches ? "Yes" : "No")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Built-in?" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Built-in?" Name="builtin" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @(context.Item.BuiltIn ? "Yes" : "No")
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Created" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Created" Name="created" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                            @context.Item.Created.ToLocalTime().ToRelativeTime()
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Sortable="false">
                    <HeaderTemplate></HeaderTemplate>
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            @if (!context.Item.BuiltIn)
                            {
                                <MudTooltip Text="Edit Object Type" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => OpenEditObjectTypeDialogAsync(context.Item))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete Object Type" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => OpenDeleteObjectTypeDialogAsync(context.Item))" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="Built-in Object Types cannot be renamed or deleted." Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Disabled="true" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="Change history" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.History" Size="Size.Small" OnClick="@(() => ShowObjectTypeHistoryDialogAsync(context.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@($"No Metaverse Object Types match \"{grid.SearchText}\"")"
                                     SecondaryText="Try a different search term, or clear the search."
                                     ActionText="Clear Search"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.Category"
                                     PrimaryText="No Metaverse Object Types yet"
                                     SecondaryText="Use the New Object Type button to create one." />
                }
            </EmptyContent>
        </VirtualisedDataGrid>
    </MudTabPanel>
    <MudTabPanel Text="Attributes" Icon="@Icons.Material.Filled.ListAlt">
        @* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count) lives in the
           shared grid; this tab supplies the columns, the window loader and the empty states. The tab itself already
           says "Attributes", so there is no toolbar title and the count carries the nouns. *@
        <VirtualisedDataGrid @ref="_attributeGrid" T="MetaverseAttributeHeader"
                             ContainerId="metaverse-attribute-list"
                             DefaultSortBy="name"
                             LoadWindow="LoadAttributeWindowAsync"
                             SingularName="Metaverse Attribute"
                             PluralName="Metaverse Attributes"
                             SearchPlaceholder="Search">
            <ToolBarExtras>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           DropShadow="false" OnClick="OpenCreateAttributeDialogAsync">New Attribute</MudButton>
            </ToolBarExtras>
            <Columns>
                <TemplateColumn Title="Name" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Name" Name="name" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.Name
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Type" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Type" Name="type" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudChip T="string" Color="@Helpers.GetAttributeTypeChipColour(context.Item.Type)" Variant="Variant.Outlined">
                            @context.Item.Type.ToString().SplitOnCapitalLetters()
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Plurality" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Plurality" Name="plurality" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudChip T="string" Color="@Helpers.GetAttributePluralityChipColour(context.Item.AttributePlurality)" Variant="Variant.Text">
                            @(context.Item.AttributePlurality == AttributePlurality.SingleValued ? "Single-Valued" : "Multi-Valued")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Built-in?" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Built-in?" Name="builtin" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.BuiltIn)
                        {
                            <MudTooltip Text="Built-in attribute" Arrow="true" Placement="Placement.Top">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mud-text-secondary" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Custom</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Created" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Created" Name="created" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                            @context.Item.Created.ToLocalTime().ToRelativeTime()
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Object Types" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Object Types</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @* A row in a virtualised grid is one line, so a chip per bound Object Type is a row that
                           grows with the attribute's bindings; the first is shown and the rest open in a dialog,
                           which draws them with the same linked chips rather than flattening them to names. *@
                        @{
                            var boundTypes = context.Item.MetaverseObjectTypes?.ToList() ?? new List<KeyValuePair<int, string>>();
                        }
                        <OverflowList TItem="KeyValuePair<int, string>" Items="@boundTypes" Title="Object Types">
                            <ItemTemplate Context="stub">
                                <MudChip T="string" Color="Color.Default" Variant="Variant.Filled"
                                         Href="@($"/admin/schema/object-types/{stub.Key}")">@stub.Value</MudChip>
                            </ItemTemplate>
                            <EmptyContent>
                                <MudTooltip Text="This custom attribute is not bound to any Object Type, so it is not collecting data." Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.RemoveCircleOutline">Not assigned</MudChip>
                                </MudTooltip>
                            </EmptyContent>
                        </OverflowList>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Sortable="false">
                    <HeaderTemplate></HeaderTemplate>
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            @if (!context.Item.BuiltIn)
                            {
                                <MudTooltip Text="Edit attribute" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => OpenEditAttributeDialogAsync(context.Item))" />
                                </MudTooltip>
                                <MudTooltip Text="Delete attribute" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="@(() => OpenDeleteAttributeDialogAsync(context.Item))" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="View attribute and Standard Mappings" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" OnClick="@(() => OpenViewAttributeDialogAsync(context.Item))" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="Change history" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.History" Size="Size.Small" OnClick="@(() => ShowAttributeHistoryDialogAsync(context.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@($"No Metaverse Attributes match \"{grid.SearchText}\"")"
                                     SecondaryText="Try a different search term, or clear the search."
                                     ActionText="Clear Search"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.ListAlt"
                                     PrimaryText="No Metaverse Attributes yet"
                                     SecondaryText="Use the New Attribute button to create one." />
                }
            </EmptyContent>
        </VirtualisedDataGrid>
    </MudTabPanel>
    <MudTabPanel Text="Data Flow" Icon="@Icons.Material.Filled.SwapHoriz">
        <DataFlowTab />
    </MudTabPanel>
</NavigableMudTabs>

@code {
    private int _activeTabIndex;

    /// <summary>
    /// The active tab's name, appended to the page heading. Indexed rather than switched on a slug because the
    /// tab strip is the source of truth for the order.
    /// </summary>
    private string TabTitle => _activeTabIndex switch
    {
        0 => "Object Types",
        1 => "Attributes",
        _ => "Data Flow"
    };
    private IList<MetaverseObjectTypeHeader>? _metaverseObjectTypeHeaders;
    private VirtualisedDataGrid<MetaverseObjectTypeHeader>? _objectTypeGrid;
    private VirtualisedDataGrid<MetaverseAttributeHeader>? _attributeGrid;

    private readonly List<BreadcrumbItem> _breadcrumbs = new List<BreadcrumbItem>
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Administration", href: "/admin"),
        new("Schema", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        // The /admin/schema/attributes route predates the tabs' ?t= slug sync and never actually selected the
        // Attributes tab: it rendered the page on its first tab, silently. Normalise it onto the slug mechanism
        // (preserving any other query parameters, such as the attribute grid's own state) so the deep link lands
        // where its name promises.
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (uri.AbsolutePath.EndsWith("/attributes", StringComparison.OrdinalIgnoreCase))
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            query["t"] = "attributes";
            NavigationManager.NavigateTo($"/admin/schema?{query}", replace: true);
            return;
        }

        using var jim = JimFactory.Create();
        _metaverseObjectTypeHeaders = await jim.Metaverse.GetMetaverseObjectTypeHeadersAsync();
    }

    /// <summary>
    /// Windows the in-memory Object Type list for the grid: Metaverse Object Types are a small configuration
    /// list, loaded whole once, so search and sort are applied here rather than each becoming a database range
    /// read (unlike the Attributes tab, whose list is large enough to earn a server-side range read).
    /// </summary>
    private Task<VirtualisedWindow<MetaverseObjectTypeHeader>> LoadObjectTypeWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        var headers = _metaverseObjectTypeHeaders ?? new List<MetaverseObjectTypeHeader>();

        var filtered = headers.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(request.SearchText))
            filtered = filtered.Where(x => x.Name.Contains(request.SearchText, StringComparison.OrdinalIgnoreCase));

        Func<MetaverseObjectTypeHeader, object> sortKey = request.SortBy switch
        {
            "attributes" => x => x.AttributesCount,
            "deletionrule" => x => x.DeletionRule,
            "predefinedsearches" => x => x.HasPredefinedSearches,
            "builtin" => x => x.BuiltIn,
            "created" => x => x.Created,
            _ => x => x.Name
        };

        var sorted = request.SortDescending
            ? filtered.OrderByDescending(sortKey)
            : filtered.OrderBy(sortKey);

        return Task.FromResult(sorted.ToWindow(request));
    }

    private async Task<VirtualisedWindow<MetaverseAttributeHeader>> LoadAttributeWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        using var jim = JimFactory.Create();
        var result = await jim.Metaverse.GetMetaverseAttributeHeadersRangeAsync(
            request.StartIndex,
            request.Count,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            includeTotalCount: request.IncludeTotalCount);

        return new VirtualisedWindow<MetaverseAttributeHeader>(result.Results, result.TotalResults);
    }

    /// <summary>
    /// Reloads the Attributes grid after a dialog creates, edits or deletes a Metaverse Attribute. The totals are
    /// invalidated because the change may have altered how many attributes exist or match the current search.
    /// </summary>
    private async Task ReloadAttributeGridAsync()
    {
        if (_attributeGrid != null)
            await _attributeGrid.RefreshAsync(invalidateTotals: true);
    }

    private async Task ShowAttributeHistoryDialogAsync(MetaverseAttributeHeader attribute)
    {
        await ConfigurationChangeHistoryDialog.ShowAsync(DialogService, ActivityTargetType.MetaverseAttribute,
            attribute.Id, "Metaverse Attribute", attribute.Name);
    }

    private async Task OpenCreateAttributeDialogAsync()
    {
        if (await MetaverseAttributeEditorDialog.ShowAsync(DialogService))
            await ReloadAttributeGridAsync();
    }

    private async Task OpenEditAttributeDialogAsync(MetaverseAttributeHeader header)
    {
        using var jim = JimFactory.Create();
        var attribute = await jim.Metaverse.GetMetaverseAttributeWithObjectTypesAsync(header.Id);
        if (attribute == null)
            return;

        if (await MetaverseAttributeEditorDialog.ShowAsync(DialogService, attribute))
            await ReloadAttributeGridAsync();
    }

    private async Task OpenViewAttributeDialogAsync(MetaverseAttributeHeader header)
    {
        using var jim = JimFactory.Create();
        var attribute = await jim.Metaverse.GetMetaverseAttributeWithObjectTypesAsync(header.Id);
        if (attribute == null)
            return;

        await MetaverseAttributeEditorDialog.ShowAsync(DialogService, attribute, readOnly: true);
    }

    private async Task OpenDeleteAttributeDialogAsync(MetaverseAttributeHeader header)
    {
        using var jim = JimFactory.Create();
        var attribute = await jim.Metaverse.GetMetaverseAttributeWithObjectTypesAsync(header.Id);
        if (attribute == null)
            return;

        if (await DeleteMetaverseAttributeDialog.ShowAsync(DialogService, attribute))
            await ReloadAttributeGridAsync();
    }

    private async Task OpenCreateObjectTypeDialogAsync()
    {
        if (await MetaverseObjectTypeEditorDialog.ShowAsync(DialogService))
            await ReloadObjectTypeHeadersAsync();
    }

    private async Task OpenEditObjectTypeDialogAsync(MetaverseObjectTypeHeader header)
    {
        using var jim = JimFactory.Create();
        var objectType = await jim.Metaverse.GetMetaverseObjectTypeAsync(header.Id, false);
        if (objectType == null)
            return;

        if (await MetaverseObjectTypeEditorDialog.ShowAsync(DialogService, objectType))
            await ReloadObjectTypeHeadersAsync();
    }

    private async Task OpenDeleteObjectTypeDialogAsync(MetaverseObjectTypeHeader header)
    {
        using var jim = JimFactory.Create();
        var objectType = await jim.Metaverse.GetMetaverseObjectTypeAsync(header.Id, false);
        if (objectType == null)
            return;

        if (await DeleteMetaverseObjectTypeDialog.ShowAsync(DialogService, objectType))
            await ReloadObjectTypeHeadersAsync();
    }

    private async Task ShowObjectTypeHistoryDialogAsync(MetaverseObjectTypeHeader header)
    {
        await ConfigurationChangeHistoryDialog.ShowAsync(DialogService, ActivityTargetType.MetaverseObjectType,
            header.Id, "Metaverse Object Type", header.Name);
    }

    /// <summary>
    /// Reloads the Object Type list after a dialog creates, edits or deletes a Metaverse Object Type, then
    /// refreshes the grid over it. The totals are invalidated because the change may have altered how many
    /// Object Types exist or match the current search.
    /// </summary>
    private async Task ReloadObjectTypeHeadersAsync()
    {
        using var jim = JimFactory.Create();
        _metaverseObjectTypeHeaders = await jim.Metaverse.GetMetaverseObjectTypeHeadersAsync();
        if (_objectTypeGrid != null)
            await _objectTypeGrid.RefreshAsync(invalidateTotals: true);
    }

    private (string Label, Color Color, string Icon) GetDeletionRuleDisplay(MetaverseObjectDeletionRule rule)
    {
        return rule switch
        {
            MetaverseObjectDeletionRule.Manual => ("Manual", Color.Default, Icons.Material.Filled.Block),
            MetaverseObjectDeletionRule.WhenLastConnectorDisconnected => ("Auto", Color.Warning, Icons.Material.Filled.LinkOff),
            MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected => ("Authoritative Source", Color.Error, Icons.Material.Filled.Star),
            _ => ("Unknown", Color.Default, Icons.Material.Filled.Help)
        };
    }

    private static string FormatGracePeriod(TimeSpan period)
    {
        var parts = new List<string>();
        if (period.Days > 0) parts.Add($"{period.Days} day{(period.Days != 1 ? "s" : "")}");
        if (period.Hours > 0) parts.Add($"{period.Hours} hour{(period.Hours != 1 ? "s" : "")}");
        if (period.Minutes > 0) parts.Add($"{period.Minutes} minute{(period.Minutes != 1 ? "s" : "")}");
        return parts.Count > 0 ? string.Join(", ", parts) : "0";
    }

    private string GetDeletionRuleTooltip(MetaverseObjectTypeHeader header)
    {
        var gracePeriod = header.DeletionGracePeriod.HasValue && header.DeletionGracePeriod.Value > TimeSpan.Zero
            ? $" ({FormatGracePeriod(header.DeletionGracePeriod.Value)} grace period)"
            : " (immediate)";

        return header.DeletionRule switch
        {
            MetaverseObjectDeletionRule.Manual => "Manual deletion only - objects are never automatically deleted",
            MetaverseObjectDeletionRule.WhenLastConnectorDisconnected => $"Delete when all connectors disconnect{gracePeriod}",
            // Include the trigger mode (#119) so the list reads the same as the detail page's radio options
            MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected =>
                header.DeletionTriggerMode == AuthoritativeSourceTriggerMode.AllSourcesDisconnect
                    ? $"All sources disconnect: delete only once every selected authoritative source has disconnected{gracePeriod}"
                    : $"Specific source(s) disconnect: delete when any one of the selected authoritative sources disconnects{gracePeriod}",
            _ => "Unknown deletion rule"
        };
    }
}
