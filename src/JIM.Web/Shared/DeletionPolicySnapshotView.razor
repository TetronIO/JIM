@*
    Renders the deletion policy facts recorded when a deletion rule evaluation was made (#119): rule,
    trigger mode, selected sources by name, grace period, triggering system and the sources still
    connected at decision time. Because the facts come from the decision-time snapshot rather than the
    object type's current configuration, the explanation stays accurate after an administrator edits
    the deletion rule.
*@

<MudAlert Severity="Severity.Info" Class="mb-5">
    <MudStack Spacing="2">
        <MudText Typo="Typo.body2">
            @if (!string.IsNullOrEmpty(ObjectTypeName))
            {
                @Rich(ConnectorSpaceText.DpvLeadTyped, (ObjectTypeName ?? string.Empty, true))
            }
            else
            {
                @Rich(ConnectorSpaceText.DpvLeadUntyped)
            }
        </MudText>

        @switch (Snapshot.DeletionRule)
        {
            case MetaverseObjectDeletionRule.Manual:
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.Block" Color="Color.Warning" />
                    <MudText Typo="Typo.body1">
                        <strong>@ConnectorSpaceText.DpvManualLabel</strong> @ConnectorSpaceText.DpvManualBody
                    </MudText>
                </MudStack>
                break;

            case MetaverseObjectDeletionRule.WhenLastConnectorDisconnected:
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.LinkOff" Color="Color.Info" />
                    <MudText Typo="Typo.body1">
                        <strong>@ConnectorSpaceText.DpvLastLabel</strong>
                        @FateSentence(true)
                    </MudText>
                </MudStack>
                break;

            case MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected:
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Info" />
                    <MudText Typo="Typo.body1">
                        <strong>@ConnectorSpaceText.DpvAuthLabel</strong>
                        @Rich(ConnectorSpaceText.DpvTriggerMode, (ModeLabel, true), (ModeDescription, false))
                        @FateSentence(false)
                    </MudText>
                </MudStack>
                @if (Snapshot.SelectedSourceSystemNames.Count > 0)
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="ml-6">
                        @foreach (var sourceName in Snapshot.SelectedSourceSystemNames)
                        {
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                                @sourceName
                            </MudChip>
                        }
                    </MudStack>
                }
                @if (!string.IsNullOrEmpty(Snapshot.TriggeringSystemName))
                {
                    <MudText Typo="Typo.body1" Class="ml-6">
                        @Rich(ConnectorSpaceText.DpvTriggeredBy, (Snapshot.TriggeringSystemName ?? string.Empty, true))
                    </MudText>
                }
                <MudText Typo="Typo.body1" Class="ml-6 mud-text-secondary">
                    @if (Snapshot.RemainingConnectedSourceSystemNames.Count > 0)
                    {
                        @Rich(ConnectorSpaceText.DpvStillConnected, (string.Join(", ", Snapshot.RemainingConnectedSourceSystemNames), true))
                    }
                    else
                    {
                        @ConnectorSpaceText.DpvNoneConnected
                    }
                </MudText>
                break;
        }

        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @ConnectorSpaceText.DpvRecorded
        </MudText>
    </MudStack>
</MudAlert>

@code {
    /// <summary>
    /// The decision-time deletion policy snapshot to render.
    /// </summary>
    [Parameter, EditorRequired]
    public MvoDeletionPolicySnapshot Snapshot { get; set; } = null!;

    /// <summary>
    /// The Metaverse Object Type's singular name for the lead sentence, when known.
    /// </summary>
    [Parameter]
    public string? ObjectTypeName { get; set; }

    private string ModeLabel => Snapshot.TriggerMode == AuthoritativeSourceTriggerMode.AllSourcesDisconnect
        ? ConnectorSpaceText.DelAllSourcesLabel
        : ConnectorSpaceText.DpvModeSpecific;

    private string ModeDescription => Snapshot.TriggerMode == AuthoritativeSourceTriggerMode.AllSourcesDisconnect
        ? ConnectorSpaceText.DpvModeAll
        : ConnectorSpaceText.DpvModeAny;

    /// <summary>
    /// "The Metaverse Object would be marked for deletion with a 30 days grace period.", or "... deleted immediately.",
    /// with the grace period set in bold. Asked for with the last connector's removal as its condition where that is
    /// the rule's trigger.
    /// </summary>
    private RenderFragment FateSentence(bool whenLastConnectorRemoved) =>
        Snapshot.GracePeriod is { } gracePeriod && gracePeriod > TimeSpan.Zero
            ? Rich(whenLastConnectorRemoved ? ConnectorSpaceText.DpvFateGraceLast : ConnectorSpaceText.DpvFateGrace, (FormatGracePeriod(gracePeriod), true))
            : Rich(whenLastConnectorRemoved ? ConnectorSpaceText.DpvFateImmediateLast : ConnectorSpaceText.DpvFateImmediate);

    /// <summary>
    /// Renders a resource sentence in which each <c>{n}</c> stands for one of the values, in the order given. A value
    /// flagged for emphasis is set in bold. The values are text, so Blazor encodes them; the sentence itself never
    /// passes through markup.
    /// </summary>
    private static RenderFragment Rich(string template, params (string Text, bool Emphasis)[] values) => builder =>
    {
        var sequence = 0;
        var position = 0;
        while (position < template.Length)
        {
            var open = template.IndexOf('{', position);
            if (open < 0)
            {
                builder.AddContent(sequence++, template[position..]);
                break;
            }

            var close = template.IndexOf('}', open);
            builder.AddContent(sequence++, template[position..open]);
            var (text, emphasis) = values[int.Parse(template[(open + 1)..close], System.Globalization.CultureInfo.InvariantCulture)];
            if (emphasis)
            {
                builder.OpenElement(sequence++, "strong");
                builder.AddContent(sequence++, text);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(sequence++, text);
            }

            position = close + 1;
        }
    };

    private static string FormatGracePeriod(TimeSpan period)
    {
        var parts = new List<string>();
        if (period.Days > 0) parts.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, PluralRules.Choose(period.Days, ConnectorSpaceText.PdlDayOne, ConnectorSpaceText.PdlDayOther), period.Days.ToString("N0")));
        if (period.Hours > 0) parts.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, PluralRules.Choose(period.Hours, ConnectorSpaceText.DpvHourOne, ConnectorSpaceText.DpvHourOther), period.Hours.ToString("N0")));
        if (period.Minutes > 0) parts.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, PluralRules.Choose(period.Minutes, ConnectorSpaceText.DpvMinuteOne, ConnectorSpaceText.DpvMinuteOther), period.Minutes.ToString("N0")));
        return parts.Count > 0 ? string.Join(", ", parts) : "0";
    }
}
