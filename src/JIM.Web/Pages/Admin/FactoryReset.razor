@page "/admin/factory-reset"
@attribute [Authorize(Roles = "Administrator")]
@using System.Globalization
@using JIM.Models.Activities
@using Microsoft.AspNetCore.Components.Authorization
@inject IJimApplicationFactory JimFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@AdminText.FactoryResetTitle</PageTitle>

<MudText Typo="Typo.h3" Color="Color.Error"><MudIcon Icon="@Icons.Material.Filled.RestartAlt" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />@AdminText.FactoryResetTitle
    <PageInfo Title="@AdminText.FactoryResetTitle" DocsPage="administration/factory-reset.md">
        @AdminText.FactoryResetPageInfo
    </PageInfo>
</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

<MudPaper Outlined="true" Class="pa-4 mt-2 jim-paper-danger-zone">
    <MudText Typo="Typo.h6" Color="Color.Error">@AdminText.FactoryResetWhatItDoes</MudText>
    <MudText Class="mt-2">
        <strong>@AdminText.FactoryResetBackupFirst</strong>@AdminText.FactoryResetDeletesPermanently<strong>@AdminText.FactoryResetCannotBeUndone</strong>@AdminText.FactoryResetBackupOnly
    </MudText>
    <MudText Class="mt-2">@AdminText.FactoryResetRemoves</MudText>
    <ul class="mt-2 ml-4">
        <li>@AdminText.FactoryResetRemovesConnectedSystems</li>
        <li>@AdminText.FactoryResetRemovesSynchronisation</li>
        <li>@AdminText.FactoryResetRemovesMetaverse</li>
        <li>@AdminText.FactoryResetRemovesActivities</li>
        <li>@AdminText.FactoryResetRemovesKeys</li>
    </ul>
    <MudText Class="mt-3">@AdminText.FactoryResetPreserves</MudText>
    <ul class="mt-2 ml-4">
        <li>@AdminText.FactoryResetPreservesSchema</li>
        <li>@AdminText.FactoryResetPreservesKey</li>
        <li><strong>@AdminText.FactoryResetAdminUsers</strong>@AdminText.FactoryResetAdminUsersUnless</li>
    </ul>
    <MudText Class="mt-3">
        @AdminText.FactoryResetRecordWritten<strong>@AdminText.FactoryResetSignedOut</strong>@AdminText.FactoryResetAuthenticateAgain
    </MudText>
</MudPaper>

<MudPaper Outlined="true" Class="pa-4 mt-6">
    <MudCheckBox @bind-Value="_includeAdministrators" Color="Color.Error">
        <MudText>@AdminText.FactoryResetAlsoDeleteAdmins</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @AdminText.FactoryResetAdminCaption
        </MudText>
    </MudCheckBox>

    @if (_includeAdministrators)
    {
        <MudAlert Severity="Severity.Warning" Class="mt-4">
            @AdminText.FactoryResetLockoutIntro
            <ul class="mt-2 ml-4">
                <li>@AdminText.FactoryResetLockoutApiKeyPrefix<strong>@AdminText.FactoryResetLockoutApiKey</strong>@AdminText.FactoryResetLockoutApiKeySuffix</li>
                <li>@AdminText.FactoryResetLockoutAdminPrefix<strong>@AdminText.FactoryResetLockoutAdminKey</strong>@AdminText.FactoryResetLockoutAdminSuffix</li>
            </ul>
            @AdminText.FactoryResetLockoutNeither
        </MudAlert>

        <MudCheckBox @bind-Value="_acknowledgeLockout" Color="Color.Error" Class="mt-2">
            <MudText>@AdminText.FactoryResetAcknowledge</MudText>
        </MudCheckBox>
    }
</MudPaper>

<MudPaper Outlined="true" Class="pa-4 mt-6">
    <MudTextField @bind-Value="_confirmText"
                  Label="@AdminText.FactoryResetConfirmLabel"
                  Variant="Variant.Outlined"
                  Immediate="true"
                  FullWidth="false" />
    <MudButton Variant="Variant.Outlined"
               Color="Color.Error"
               Class="mt-4"
               DropShadow="false"
               StartIcon="@(_resetInProgress ? null : Icons.Material.Filled.RestartAlt)"
               OnClick="HandleShowConfirmationAsync"
               Disabled="@(!IsConfirmValid() || _resetInProgress)">
        @if (_resetInProgress)
        {
            <MudProgressCircular Class="ms-n1" Indeterminate="true" Size="Size.Small" />
            <span class="ms-2">@AdminText.FactoryResetInProgress</span>
        }
        else
        {
            <text>@AdminText.FactoryResetTitle</text>
        }
    </MudButton>
</MudPaper>

<MudDialog @bind-Visible="_confirmVisible" Options="_confirmDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="mr-3" /> @AdminText.FactoryResetConfirmTitle
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Error" Class="mb-4">
            @AdminText.FactoryResetWipeWarning<strong>@AdminText.FactoryResetCannotBeUndone</strong>@AdminText.FactoryResetWipeWarningEnd
        </MudAlert>
        <MudText>
            @(_includeAdministrators
                ? AdminText.FactoryResetAdminsRemoved
                : AdminText.FactoryResetAdminsPreserved)
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _confirmVisible = false)" DropShadow="false">@CommonText.Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" DropShadow="false" OnClick="HandleResetConfirmedAsync">
            @AdminText.FactoryResetWipeButton
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
        new(LayoutText.NavAdministration, href: "/admin"),
        new(AdminText.FactoryResetTitle, href: null, disabled: true)
    };

    private readonly DialogOptions _confirmDialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };
    private bool _includeAdministrators;
    private bool _acknowledgeLockout;
    private string? _confirmText;
    private bool _confirmVisible;
    private bool _resetInProgress;

    private bool IsConfirmValid()
    {
        if (!string.Equals(_confirmText?.Trim(), "RESET", StringComparison.Ordinal))
            return false;

        // Removing administrators requires the lockout risk to be acknowledged in the UI.
        if (_includeAdministrators && !_acknowledgeLockout)
            return false;

        return true;
    }

    private Task HandleShowConfirmationAsync()
    {
        if (IsConfirmValid())
            _confirmVisible = true;
        return Task.CompletedTask;
    }

    private async Task HandleResetConfirmedAsync()
    {
        _confirmVisible = false;
        _resetInProgress = true;
        StateHasChanged();

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

            await jim.System.ResetSystemAsync(
                ActivityInitiatorType.User,
                user.Id,
                user.NameOrId,
                _includeAdministrators,
                acknowledgeAdministratorLockout: _acknowledgeLockout);

            Snackbar.Add(AdminText.FactoryResetComplete, Severity.Success);

            // The reset advanced the authentication epoch, so a full request will force re-authentication.
            await Task.Delay(1500);
            NavManager.NavigateTo("/", forceLoad: true);
        }
        catch (InvalidOperationException ex)
        {
            _resetInProgress = false;
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.FactoryResetRefused, ex.Message), Severity.Error);
            StateHasChanged();
        }
    }
}
