@* ─── Initial Password ─── *@
@* Headed rather than left to the tab to name it, because the tab is called Passwords: it says which password
   feature this is, and leaves room for the siblings that name invites. No expansion panel, though: these
   settings are the section's whole content, and a lid on a tab is a lid too many. *@
<MudPaper Class="pa-4" Outlined="true">
    <MudText Typo="Typo.h5" Class="mb-4">@SyncRuleText.InitialPasswordHeading</MudText>
                @if (!ConnectorCanSetPasswords)
                {
                    <MudAlert Severity="Severity.Info">
                        @string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.InitialPasswordConnectorCannotSet, ConnectorLabel)
                    </MudAlert>
                }
                else
                {
                    @* ─── Accounts waiting on a change to these settings ───
                       Placed above the settings rather than below them: the reason names the setting to change,
                       so reading it is the first step and scrolling past the whole editor to find it is not. *@
                    @if (ParkedReasons is { Count: > 0 })
                    {
                        @* Captured into a local: a property pattern does not establish non-null null-state for
                           CodeQL any more than a HasValue guard does (JIM.Web/CLAUDE.md). *@
                        var parkedReasons = ParkedReasons;
                        <MudAlert Severity="Severity.Warning" Class="mb-5">
                            <MudText Typo="Typo.body1" Class="mb-1">
                                @string.Format(System.Globalization.CultureInfo.CurrentCulture,
                                    PluralRules.Choose(ParkedAccountCount, SyncRuleText.ParkedWaitingOne, SyncRuleText.ParkedWaitingOther),
                                    ParkedAccountCount)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                                @SyncRuleText.ParkedExplanation
                            </MudText>
                            @foreach (var reason in parkedReasons)
                            {
                                <div class="d-flex mb-2">
                                    <MudText Typo="Typo.subtitle2" Class="me-3 flex-shrink-0"
                                             Style="min-width: 3rem; text-align: right;">@reason.AccountCount.ToString("N0")</MudText>
                                    <div>
                                        @* Verbatim, in monospace. A directory's rejection code is unreadable and is
                                           also the only thing precise enough to identify the fault, so it is shown
                                           exactly as the target sent it. *@
                                        <MudText Typo="Typo.body2" Style="font-family: var(--mud-typography-monospace-family, monospace);">
                                            @(string.IsNullOrWhiteSpace(reason.TargetMessage)
                                                ? SyncRuleText.ParkedNoReason
                                                : reason.TargetMessage)
                                        </MudText>
                                        @if (reason.FirstSeenAt.HasValue)
                                        {
                                            var firstSeen = reason.FirstSeenAt.Value;
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                @string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.ParkedFirstSeen, firstSeen.ToLocalTime().ToRelativeTime())
                                            </MudText>
                                        }
                                    </div>
                                </div>
                            }
                        </MudAlert>
                    }

                    @* Shown only once an edit would actually change what gets delivered, decided by the same
                       comparison the save path uses, so the panel cannot promise a release that saving will not
                       perform. Renaming the rule leaves it hidden, correctly. *@
                    @if (WillReleaseParkedOnSave)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-5">
                            <MudText Typo="Typo.body1">
                                @string.Format(System.Globalization.CultureInfo.CurrentCulture,
                                    PluralRules.Choose(ParkedAccountCount, SyncRuleText.ReleaseOnSaveOne, SyncRuleText.ReleaseOnSaveOther),
                                    ParkedAccountCount)
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @SyncRuleText.ReleaseOnSaveDetail
                            </MudText>
                        </MudAlert>
                    }

                    <MudSwitch @bind-Value="@Configuration.Enabled" @bind-Value:after="NotifyChangedAsync" Color="Color.Primary"
                               Label="@SyncRuleText.SetInitialPasswordQuestion" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">@SyncRuleText.SetInitialPasswordHelp</MudText>

                    @if (Configuration.Enabled)
                    {
                        <MudDivider Class="my-5" />

                        @* ─── Where the settings come from ─── *@
                        <MudText Typo="Typo.body1">@SyncRuleText.PasswordSettingsHeading</MudText>
                        <MudRadioGroup T="InitialPasswordSource" @bind-Value="@Configuration.Source" @bind-Value:after="NotifyChangedAsync">
                            <div class="mt-1">
                                <MudRadio T="InitialPasswordSource" Value="InitialPasswordSource.Discovered" Color="Color.Primary">@SyncRuleText.InitialPasswordSourceFollow</MudRadio>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">@SyncRuleText.InitialPasswordSourceFollowHelp</MudText>
                            </div>
                            <div class="mt-2">
                                <MudRadio T="InitialPasswordSource" Value="InitialPasswordSource.Custom" Color="Color.Primary">@SyncRuleText.InitialPasswordSourceCustom</MudRadio>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">@SyncRuleText.InitialPasswordSourceCustomHelp</MudText>
                            </div>
                            <div class="mt-2">
                                <div class="d-flex align-center">
                                    <MudRadio T="InitialPasswordSource" Value="InitialPasswordSource.Static" Color="Color.Primary">@SyncRuleText.InitialPasswordSourceStatic</MudRadio>
                                    @* On the option itself, not only inside it: the recommendation has to be readable
                                       while an administrator is choosing, not after they have chosen. *@
                                    <MudChip T="string" Class="ms-1" Color="Color.Warning" Variant="Variant.Text">@SyncRuleText.NotRecommended</MudChip>
                                </div>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">@SyncRuleText.InitialPasswordSourceStaticHelp</MudText>
                            </div>
                        </MudRadioGroup>

                        @if (Configuration.Source == InitialPasswordSource.Discovered && DiscoveredPolicy == null)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-4">
                                @SyncRuleText.NoDiscoveredPolicy
                            </MudAlert>
                        }

                        @if (Configuration.Source == InitialPasswordSource.Custom)
                        {
                            <MudDivider Class="my-5" />
                            @* ─── Generator settings ─── *@
                            <MudSelect T="PasswordGenerationStyle" Label="@SyncRuleText.PasswordStyleLabel" @bind-Value="@Configuration.CustomPolicy.Style"
                                       @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                                <MudSelectItem Value="PasswordGenerationStyle.RandomCharacters">@SyncRuleText.PasswordStyleRandom</MudSelectItem>
                                <MudSelectItem Value="PasswordGenerationStyle.Words">@SyncRuleText.PasswordStyleWords</MudSelectItem>
                                <MudSelectItem Value="PasswordGenerationStyle.Pronounceable">@SyncRuleText.PasswordStylePronounceable</MudSelectItem>
                            </MudSelect>

                            @if (Configuration.CustomPolicy.Style != PasswordGenerationStyle.Words)
                            {
                                <MudNumericField T="int" Label="@SyncRuleText.PasswordLengthLabel" @bind-Value="@Configuration.CustomPolicy.Length"
                                                 @bind-Value:after="NotifyChangedAsync" Min="1" Max="256" Immediate="true"
                                                 Variant="Variant.Outlined" Class="mt-4" />
                            }

                            @if (Configuration.CustomPolicy.Style == PasswordGenerationStyle.RandomCharacters)
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="@SyncRuleText.MinimumUppercaseLabel" @bind-Value="@Configuration.CustomPolicy.MinimumUppercase"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="@SyncRuleText.MinimumLowercaseLabel" @bind-Value="@Configuration.CustomPolicy.MinimumLowercase"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="@SyncRuleText.MinimumDigitsLabel" @bind-Value="@Configuration.CustomPolicy.MinimumDigits"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="@SyncRuleText.MinimumSymbolsLabel" @bind-Value="@Configuration.CustomPolicy.MinimumSymbols"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                </MudGrid>
                            }

                            @if (Configuration.CustomPolicy.Style == PasswordGenerationStyle.Words)
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="4">
                                        <MudNumericField T="int" Label="@SyncRuleText.NumberOfWordsLabel" @bind-Value="@Configuration.CustomPolicy.WordCount"
                                                         @bind-Value:after="NotifyChangedAsync" Min="1" Max="16" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudSelect T="PasswordWordSeparator" Label="@SyncRuleText.SeparatorLabel" @bind-Value="@Configuration.CustomPolicy.WordSeparator"
                                                   @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                                            <MudSelectItem Value="PasswordWordSeparator.None">@CommonText.None</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.Hyphen">@SyncRuleText.SeparatorHyphen</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.FullStop">@SyncRuleText.SeparatorFullStop</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.Underscore">@SyncRuleText.SeparatorUnderscore</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.Digit">@SyncRuleText.SeparatorDigit</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.RandomSymbol">@SyncRuleText.SeparatorRandomSymbol</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudSelect T="PasswordWordCapitalisation" Label="@SyncRuleText.CapitalisationLabel" @bind-Value="@Configuration.CustomPolicy.WordCapitalisation"
                                                   @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                                            <MudSelectItem Value="PasswordWordCapitalisation.Lowercase">@SyncRuleText.CapitalisationLowercase</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.EachWord">@SyncRuleText.CapitalisationEachWord</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.Uppercase">@SyncRuleText.CapitalisationUppercase</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.FirstWordOnly">@SyncRuleText.CapitalisationFirstWordOnly</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.RandomWord">@SyncRuleText.CapitalisationRandomWord</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            }

                            @if (Configuration.CustomPolicy.Style != PasswordGenerationStyle.RandomCharacters)
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="4">
                                        <MudNumericField T="int" Label="@SyncRuleText.AppendedDigitsLabel" @bind-Value="@Configuration.CustomPolicy.AppendedDigitCount"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="16" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="8" Class="d-flex align-center">
                                        <MudSwitch @bind-Value="@Configuration.CustomPolicy.AppendSymbol" @bind-Value:after="NotifyChangedAsync"
                                                   Color="Color.Primary" Label="@SyncRuleText.AppendSymbolLabel" />
                                    </MudItem>
                                </MudGrid>
                            }

                            <MudTextField T="string" Label="@SyncRuleText.PermittedSymbolsLabel" @bind-Value="@Configuration.CustomPolicy.PermittedSymbols"
                                          @bind-Value:after="NotifyChangedAsync" Immediate="true" Variant="Variant.Outlined" Class="mt-4" />
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@SyncRuleText.PermittedSymbolsHelp</MudText>

                            <MudSwitch Class="mt-4" @bind-Value="@Configuration.CustomPolicy.ExcludeAmbiguousCharacters"
                                       @bind-Value:after="NotifyChangedAsync" Color="Color.Primary"
                                       Label="@SyncRuleText.LeaveOutConfusedLabel" />
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">
                                @string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.LeaveOutConfusedHelp, PasswordGenerationPolicy.AmbiguousCharacters)</MudText>
                        }

                        @if (Configuration.Source == InitialPasswordSource.Static)
                        {
                            <MudDivider Class="my-5" />
                            @* ─── The one password every account gets ─── *@
                            <MudAlert Severity="Severity.Warning" Class="mb-5">
                                <MudText Typo="Typo.body1">@SyncRuleText.StaticNotRecommended</MudText>
                                <MudText Typo="Typo.body2">
                                    @SyncRuleText.StaticWarningBody
                                </MudText>
                            </MudAlert>

                            @* Blank on load, whatever is stored. Blank means "leave the stored password as it is", which
                               is what makes the field write-only without a special case anywhere else. *@
                            <MudTextField T="string" Label="@SyncRuleText.PasswordLabel" @bind-Value="@_staticPassword"
                                          @bind-Value:after="HandleStaticPasswordChangedAsync" Immediate="true"
                                          InputType="@(_showStaticPassword ? InputType.Text : InputType.Password)"
                                          Adornment="Adornment.End" AdornmentIcon="@(_showStaticPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                          OnAdornmentClick="ToggleStaticPasswordVisibility" AdornmentAriaLabel="@SyncRuleText.ShowOrHidePassword"
                                          Variant="Variant.Outlined" data-testid="initial-password-static" />

                            <MudTextField T="string" Label="@SyncRuleText.ConfirmPasswordLabel" @bind-Value="@_staticPasswordConfirm"
                                          @bind-Value:after="HandleStaticPasswordChangedAsync" Immediate="true"
                                          InputType="@(_showStaticPassword ? InputType.Text : InputType.Password)"
                                          Error="@StaticPasswordsDoNotMatch" ErrorText="@SyncRuleText.PasswordsDoNotMatch"
                                          Variant="Variant.Outlined" Class="mt-4" data-testid="initial-password-static-confirm" />

                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                                @if (Configuration.StaticPasswordSetAt.HasValue)
                                {
                                    @* Captured into a local per the Razor nullable-dereference rule. *@
                                    var setAt = Configuration.StaticPasswordSetAt.Value;
                                    <text>@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.StaticPasswordSetAt, setAt.ToLocalTime().ToRelativeTime())</text>
                                }
                                else if (!string.IsNullOrEmpty(Configuration.StaticPasswordEncryptedValue))
                                {
                                    <text>@SyncRuleText.StaticPasswordSet</text>
                                }
                                else
                                {
                                    <text>@SyncRuleText.StaticPasswordNotSet</text>
                                }
                            </MudText>

                            @* ─── What the supplied password contains ───
                               Deliberately no entropy figure: JIM knows what is in this password but nothing about how
                               it was chosen, and a figure it cannot stand behind is worse than none. *@
                            @if (StaticPasswordAssessment != null)
                            {
                                var staticAssessment = StaticPasswordAssessment;
                                <MudAlert Severity="@(staticAssessment.IsUsable ? Severity.Success : Severity.Error)" Class="mt-5">
                                    @if (staticAssessment.IsUsable)
                                    {
                                        <MudText Typo="Typo.body1">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.StaticPasswordUsable, staticAssessment.Length, staticAssessment.CharacterClassCount)</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body1">@SyncRuleText.StaticPasswordUnusable</MudText>
                                        <ul class="mt-1">
                                            @foreach (var problem in staticAssessment.Problems)
                                            {
                                                <li>@problem</li>
                                            }
                                        </ul>
                                    }
                                </MudAlert>
                            }
                        }

                        @* ─── What this configuration produces ───
                           Only for the sources that generate. A static password produces nothing to describe, and the
                           generator figures would be about passwords this rule will never produce. *@
                        @if (Assessment != null && Configuration.Source != InitialPasswordSource.Static)
                        {
                            var assessment = Assessment;
                            <MudAlert Severity="@(assessment.IsUsable ? Severity.Success : Severity.Error)" Class="mt-5">
                                @if (assessment.IsUsable)
                                {
                                    <MudText Typo="Typo.body1">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.GeneratedPasswordGuarantee, assessment.GuaranteedMinimumLength, assessment.GuaranteedCharacterClassCount, assessment.EntropyBits)</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body1">@SyncRuleText.SettingsCannotBeUsed</MudText>
                                    <ul class="mt-1">
                                        @foreach (var problem in assessment.Problems)
                                        {
                                            <li>@problem</li>
                                        }
                                    </ul>
                                }
                            </MudAlert>
                        }

                        <MudDivider Class="my-5" />

                        @* ─── What happens to the account ─── *@
                        <MudSelect T="PasswordExpiryBehaviour" Label="@SyncRuleText.AfterPasswordSetLabel" @bind-Value="@Configuration.ExpiryBehaviour"
                                   @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                            @foreach (var behaviour in SupportedExpiryBehaviours)
                            {
                                <MudSelectItem Value="behaviour">@DescribeExpiryBehaviour(behaviour)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                            @string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.ExpiryOnlyWhatConnectorApplies, ConnectorLabel)</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@((MarkupString)SyncRuleText.ExpiryUacNote)</MudText>
                        @if (Configuration.Source == InitialPasswordSource.Static)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@SyncRuleText.StaticExpiryNote</MudText>
                        }
                        @if (AccountControlFlowNotes.WarnsRequireChangeMayBeIgnored(RuleMapsUserAccountControl, Configuration))
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-3" data-testid="jim-require-change-may-be-ignored">
                                @((MarkupString)SyncRuleText.RequireChangeMayBeIgnored)
                                @if (Configuration.Source == InitialPasswordSource.Static)
                                {
                                    <text>@SyncRuleText.RequireChangeMayBeIgnoredStatic</text>
                                }
                            </MudAlert>
                        }

                        <MudSwitch Class="mt-4" @bind-Value="@Configuration.EnableAccount" @bind-Value:after="NotifyChangedAsync"
                                   Color="Color.Primary" Label="@SyncRuleText.EnableAccountLabel" />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">@((MarkupString)SyncRuleText.EnableAccountNote)</MudText>
                    }
                }
</MudPaper>

@code {
    /// <summary>
    /// The Synchronisation Rule's initial-password configuration, mutated in place. The parent owns creating it
    /// so that the rule's saved graph and this editor are never looking at two different objects.
    /// </summary>
    [Parameter]
    public SyncRuleInitialPassword Configuration { get; set; } = null!;

    /// <summary>
    /// The password policy JIM discovered on the Connected System, or null where none was discovered.
    /// </summary>
    [Parameter]
    public ConnectedSystemPasswordPolicy? DiscoveredPolicy { get; set; }

    /// <summary>
    /// What the Connected System's Connector can actually apply once the password is set. Empty means it cannot
    /// set passwords at all.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<PasswordExpiryBehaviour> SupportedExpiryBehaviours { get; set; } = [];

    /// <summary>
    /// What the current settings would produce, recomputed by the parent on every change. Null before the first
    /// assessment has been made.
    /// </summary>
    [Parameter]
    public PasswordGenerationAssessment? Assessment { get; set; }

    /// <summary>
    /// What the password an administrator typed contains, and whether the target would accept it. Null until one
    /// has been typed, which is also the state a saved rule loads in: the stored password is never read back.
    /// </summary>
    [Parameter]
    public SuppliedPasswordAssessment? StaticPasswordAssessment { get; set; }

    /// <summary>
    /// Raised with the password once both fields agree, and with null whenever they do not.
    /// <para>
    /// The plaintext leaves this component and goes no further than the parent, which encrypts it. Raising null
    /// rather than nothing on a mismatch is what stops a password committed from a field the administrator has
    /// since edited surviving on the model: the two fields would disagree on screen while the model held the
    /// earlier value, and saving would store a password nobody typed.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback<string?> OnStaticPasswordEntered { get; set; }

    [Parameter]
    public string ConnectorName { get; set; } = string.Empty;

    /// <summary>
    /// The Connector's name as it reads in a sentence.
    /// <para>
    /// Every reserved Connector name already ends in "Connector" and begins with "JIM", so interpolating one and
    /// then writing the word again produced "the JIM LDAP Connector Connector". The "JIM " prefix earns nothing
    /// in prose where every Connector carries it, and JIM.Web/CLAUDE.md permits dropping it here. The fallback,
    /// used when the Connector could not be resolved, is not a name and needs the noun supplied.
    /// </para>
    /// </summary>
    private string ConnectorLabel => string.IsNullOrWhiteSpace(ConnectorName)
        ? SyncRuleText.UnknownConnectorLabel
        : ConnectorName.StartsWith("JIM ", StringComparison.Ordinal) ? ConnectorName[4..] : ConnectorName;

    /// <summary>
    /// What the target said about the accounts parked against this rule, grouped by reason and biggest first.
    /// Empty or null when nothing is parked, which is the ordinary case and renders nothing at all.
    /// </summary>
    [Parameter]
    public IReadOnlyList<InitialPasswordRejection>? ParkedReasons { get; set; }

    /// <summary>
    /// True when the settings have been edited in a way that changes what would be delivered, so saving really
    /// will release the parked accounts. The parent owns this because only it holds what was saved.
    /// </summary>
    [Parameter]
    public bool WillReleaseParkedOnSave { get; set; }

    /// <summary>
    /// Whether this Synchronisation Rule has an Attribute Flow that writes <c>userAccountControl</c>, which then decides
    /// Password never expires for the accounts it writes (#2159); see
    /// <see cref="AccountControlFlowNotes.WarnsRequireChangeMayBeIgnored(bool, SyncRuleInitialPassword)"/>.
    /// </summary>
    [Parameter]
    public bool RuleMapsUserAccountControl { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private int ParkedAccountCount => ParkedReasons?.Sum(r => r.AccountCount) ?? 0;

    private bool ConnectorCanSetPasswords => SupportedExpiryBehaviours.Count > 0;

    /// <summary>
    /// The password being typed. Held here and never written into <see cref="Configuration"/>, which carries only
    /// the encrypted value; the parent does the encrypting.
    /// </summary>
    private string? _staticPassword;

    private string? _staticPasswordConfirm;

    private bool _showStaticPassword;

    /// <summary>
    /// Whether the two fields disagree. A confirm field nobody has typed in yet is not a disagreement, or the
    /// error would appear on the first keystroke of the password above it.
    /// </summary>
    private bool StaticPasswordsDoNotMatch =>
        !string.IsNullOrEmpty(_staticPassword) &&
        !string.IsNullOrEmpty(_staticPasswordConfirm) &&
        _staticPassword != _staticPasswordConfirm;

    private void ToggleStaticPasswordVisibility() => _showStaticPassword = !_showStaticPassword;

    /// <summary>
    /// Hands the parent the password once both fields agree, and null while they do not. See
    /// <see cref="OnStaticPasswordEntered"/> for why a mismatch raises null rather than staying quiet.
    /// </summary>
    private async Task HandleStaticPasswordChangedAsync()
    {
        var entered = !string.IsNullOrEmpty(_staticPassword) && _staticPassword == _staticPasswordConfirm
            ? _staticPassword
            : null;

        await OnStaticPasswordEntered.InvokeAsync(entered);
    }

    private async Task NotifyChangedAsync()
    {
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Describes an expiry behaviour in terms of what happens to the person using the account, rather than
    /// naming the directory attribute that implements it.
    /// </summary>
    private static string DescribeExpiryBehaviour(PasswordExpiryBehaviour behaviour) => behaviour switch
    {
        PasswordExpiryBehaviour.RequireChangeAtNextSignIn => SyncRuleText.ExpiryRequireChange,
        PasswordExpiryBehaviour.ExpiresAccordingToTargetPolicy => SyncRuleText.ExpiryAccordingToTarget,
        PasswordExpiryBehaviour.NeverExpires => SyncRuleText.ExpiryNeverExpires,
        _ => behaviour.ToString()
    };
}
