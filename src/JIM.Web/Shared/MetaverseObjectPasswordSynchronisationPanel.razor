@* One identity's Password Synchronisation history and outstanding work (#1119, requirement 25).
   Two sources, deliberately. History comes from Activities, which are durable; outstanding work comes from the
   queue, which is not. The queue row is deleted the moment the password arrives, so a panel built on the queue
   alone would show this person's failures and none of their successes, which is the most misleading possible
   view of whether their password propagated.
   Takes its data rather than fetching it, so the page owns the reads (and runs them only for readers allowed
   to see the tab) and this component stays testable without a data layer behind it. *@
@if (QueuedChanges.Count > 0)
{
    <MudPaper Class="pa-4" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.SyncLock" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Still to be delivered</MudText>
        </MudStack>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
            A change leaves the queue once it arrives. Anything here is still owed to that Connected System,
            or has stopped being attempted.
        </MudText>

        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mt-3">
            <thead>
                <tr>
                    <th>Connected System</th>
                    <th>Status</th>
                    <th>Attempts</th>
                    <th>Queued</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var change in QueuedChanges)
                {
                    <tr @key="change.Id">
                        <td>@change.ConnectedSystemName</td>
                        <td>
                            <OneLineText Text="@PendingPasswordChangeDisplay.Status(change)" Secondary="@PendingPasswordChangeDisplay.Detail(change)" />
                        </td>
                        <td>@change.AttemptCount.ToString("N0")</td>
                        <td>@change.CreatedAt.ToFriendlyDate()</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>
}

<MudPaper Class="@HistoryPanelClass" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" />
        <MudText Typo="Typo.h6">Recent password changes</MudText>
        <MudSpacer />
        <MudLink Href="@QueueHref">Password Synchronisation queue</MudLink>
    </MudStack>

    @if (Events.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
            JIM has never synchronised a password change for this person.
        </MudText>
    }
    else
    {
        @foreach (var passwordChange in Events)
        {
            <div class="mt-4" @key="passwordChange.ActivityId">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.subtitle2">@passwordChange.Created.ToFriendlyDate()</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@DescribeInitiator(passwordChange)</MudText>
                </MudStack>

                @if (passwordChange.Outcomes.Count == 0)
                {
                    @* A change that reached nothing must not render as a bare timestamp an administrator
                       reads as "it went out fine" (requirement 14 read from the other end). *@
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                        Recorded, but queued for no Connected System: none that this person has an account in
                        was enabled for Password Synchronisation at the time.
                    </MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mt-2">
                        <tbody>
                            @foreach (var outcome in passwordChange.Outcomes)
                            {
                                <tr @key="outcome.ActivityId">
                                    <td style="width: 40px;">
                                        <MudTooltip Arrow="true" Placement="Placement.Top">
                                            <TooltipContent><TooltipText Text="@DescribeOutcome(outcome)" /></TooltipContent>
                                            <ChildContent>
                                                <MudIcon Icon="@OutcomeIcon(outcome)" Color="@OutcomeColour(outcome)" Size="Size.Small" />
                                            </ChildContent>
                                        </MudTooltip>
                                    </td>
                                    <td>@outcome.ConnectedSystemName</td>
                                    <td>
                                        <OneLineText Text="@(outcome.ErrorMessage ?? outcome.Message)" />
                                    </td>
                                    <td style="width: 190px;">@outcome.OccurredAt.ToFriendlyDate()</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </div>
        }
    }
</MudPaper>


@code {
    /// <summary>
    /// The identity this panel is about, used to deep-link the queue to their outstanding changes.
    /// </summary>
    [Parameter]
    public Guid MetaverseObjectId { get; set; }

    /// <summary>
    /// This person's most recent password changes, newest first, with what each Connected System did with them.
    /// </summary>
    [Parameter]
    public IReadOnlyList<PasswordSynchronisationEvent> Events { get; set; } = [];

    /// <summary>
    /// What is still on the queue for this person: changes not yet delivered, or that have stopped being tried.
    /// </summary>
    [Parameter]
    public IReadOnlyList<PendingPasswordChangeHeader> QueuedChanges { get; set; } = [];

    private string QueueHref => $"/admin/operations?t=passwords&metaverseObjectId={MetaverseObjectId}";

    /// <summary>
    /// The history panel's spacing. It is the second panel when there is outstanding work above it, and the
    /// first when there is not; only in the first case does it need the uniform 24px gap between panels, since
    /// the tab's own top padding already spaces the first panel from the tab bar.
    /// </summary>
    private string HistoryPanelClass => QueuedChanges.Count > 0 ? "pa-4 mt-6" : "pa-4";

    private static string DescribeInitiator(PasswordSynchronisationEvent passwordChange)
    {
        if (string.IsNullOrWhiteSpace(passwordChange.InitiatedByName))
            return "Initiator not recorded";

        return passwordChange.InitiatedByType == ActivityInitiatorType.ApiKey
            ? $"via {passwordChange.InitiatedByName} (API key)"
            : $"by {passwordChange.InitiatedByName}";
    }

    private static string OutcomeIcon(PasswordSynchronisationEventOutcome outcome) => outcome.Succeeded switch
    {
        true => Icons.Material.Filled.CheckCircleOutline,
        false => Icons.Material.Filled.ErrorOutline,
        _ => Icons.Material.Filled.HourglassEmpty
    };

    private static Color OutcomeColour(PasswordSynchronisationEventOutcome outcome) => outcome.Succeeded switch
    {
        true => Color.Success,
        false => Color.Error,
        _ => Color.Default
    };

    private static string DescribeOutcome(PasswordSynchronisationEventOutcome outcome) => outcome.Succeeded switch
    {
        true => $"{outcome.ConnectedSystemName} took the change.",
        false => $"{outcome.ConnectedSystemName} did not take the change. The message beside it is the target's own, and is usually where the remedy lives.",
        _ => $"The attempt on {outcome.ConnectedSystemName} is still running."
    };
}
