@page "/admin/sync-rules"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Logic
@using JIM.Models.Logic.DTOs
@using JIM.Models.Transactional.DTOs
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Synchronisation Rules</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />Synchronisation Rules</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    Synchronisation Rules are used to define the flow of information between JIM and Connected Systems.
</MudText>

@if (!_canCreateSyncRules)
{
    <MudAlert Class="mt-5" Severity="Severity.Warning" Variant="Variant.Outlined">Please create a <MudLink Href="/admin/connected-systems/">Connected
        System</MudLink> first.</MudAlert>
}

@* ─── Filters ─── *@
@if (_syncRuleHeaders is { Count: > 0 })
{
    <MudStack Row="true" Spacing="3" Class="mt-4 flex-wrap" AlignItems="AlignItems.End">
        <MudItem Class="flex-grow-1">
            <MudSelect T="int" Label="Connected System" Variant="Variant.Outlined"
                       Dense="true" Clearable="true" MultiSelection="true"
                       SelectedValues="SelectedConnectedSystemIds"
                       SelectedValuesChanged="OnConnectedSystemFilterChanged"
                       MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetConnectedSystemFilterText))">
                @foreach (var connectedSystemId in _connectedSystemFilterOptionIds)
                {
                    <MudSelectItem T="int" Value="@connectedSystemId">@_connectedSystemNames[connectedSystemId]</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem Class="flex-grow-1">
            <MudSelect T="SyncRuleDirection" Label="Direction" Variant="Variant.Outlined"
                       Dense="true" Clearable="true" MultiSelection="true"
                       SelectedValues="SelectedDirections"
                       SelectedValuesChanged="OnDirectionFilterChanged"
                       MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetDirectionFilterText))">
                <MudSelectItem T="SyncRuleDirection" Value="SyncRuleDirection.Import">Inbound</MudSelectItem>
                <MudSelectItem T="SyncRuleDirection" Value="SyncRuleDirection.Export">Outbound</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem Class="flex-grow-1">
            <MudSelect T="SyncRuleActionType" Label="Action" Variant="Variant.Outlined"
                       Dense="true" Clearable="true" MultiSelection="true"
                       SelectedValues="SelectedActionTypes"
                       SelectedValuesChanged="OnActionTypeFilterChanged"
                       MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetActionTypeFilterText))">
                <MudSelectItem T="SyncRuleActionType" Value="SyncRuleActionType.Projects">Projects</MudSelectItem>
                <MudSelectItem T="SyncRuleActionType" Value="SyncRuleActionType.Provisions">Provisions</MudSelectItem>
                <MudSelectItem T="SyncRuleActionType" Value="SyncRuleActionType.FlowOnly">Flow Only</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem Class="flex-grow-1">
            <MudSelect T="SyncRuleStatus" Label="Status" Variant="Variant.Outlined"
                       Dense="true" Clearable="true" MultiSelection="true"
                       SelectedValues="SelectedStatuses"
                       SelectedValuesChanged="OnStatusFilterChanged"
                       MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetStatusFilterText))">
                <MudSelectItem T="SyncRuleStatus" Value="SyncRuleStatus.Enabled">Enabled</MudSelectItem>
                <MudSelectItem T="SyncRuleStatus" Value="SyncRuleStatus.Disabled">Disabled</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudStack>
}

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count, the search box)
   lives in the shared grid; this page loads the small configuration list once and windows it in memory. The
   facet selects above are page-owned filters, so their handlers refresh the grid and reset its scroll. *@
<VirtualisedDataGrid @ref="_grid" T="SyncRuleHeader"
                     ContainerId="sync-rule-list"
                     DefaultSortBy="name"
                     LoadWindow="LoadWindowAsync"
                     SingularName="Synchronisation Rule"
                     PluralName="Synchronisation Rules">
    <ToolBarExtras>
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Href="/admin/sync-rules/new"
                   Color="Color.Primary" Disabled="@(!_canCreateSyncRules)" DropShadow="false">Create Synchronisation Rule
        </MudButton>
    </ToolBarExtras>
    <Columns>
        <TemplateColumn Title="Name" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Name" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                <MudLink Href="@("/admin/sync-rules/" + context.Item.Id)">@context.Item.Name</MudLink>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Direction" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Direction" Name="direction" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.Direction == SyncRuleDirection.Import)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Info">Inbound</MudChip>
                }
                else
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Warning">Outbound</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Connected System" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Connected System" Name="connectedsystem" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.ConnectedSystemName
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Object Mapping" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Object Mapping" Name="objectmapping" />
            </HeaderTemplate>
            <CellTemplate>
                @* A row in a virtualised grid is one line: this pair of chips and the arrow between them is a
                   single statement, so it stays on one line and clips rather than wrapping into a second. *@
                <div class="jim-one-line-list" style="gap: 2px;">
                    @if (context.Item.Direction == SyncRuleDirection.Import)
                    {
                        @* Inbound: CS -> MV *@
                        <MudChip T="string" Size="Size.Medium">
                            <AvatarContent>
                                <MudTooltip Text="Connected System Object Type" Arrow="true" Placement="Placement.Top">
                                    <MudAvatar Color="Color.Secondary">CS</MudAvatar>
                                </MudTooltip>
                            </AvatarContent>
                            <ChildContent>@context.Item.ConnectedSystemObjectTypeName</ChildContent>
                        </MudChip>
                        <MudIcon Icon="@Icons.Material.Filled.TrendingFlat" Class="mud-text-secondary" />
                        <MudChip T="string" Size="Size.Medium">
                            <AvatarContent>
                                <MudTooltip Text="Metaverse Object Type" Arrow="true" Placement="Placement.Top">
                                    <MudAvatar Color="Color.Primary">MV</MudAvatar>
                                </MudTooltip>
                            </AvatarContent>
                            <ChildContent>@context.Item.MetaverseObjectTypeName</ChildContent>
                        </MudChip>
                    }
                    else
                    {
                        @* Outbound: MV -> CS *@
                        <MudChip T="string" Size="Size.Medium">
                            <AvatarContent>
                                <MudTooltip Text="Metaverse Object Type" Arrow="true" Placement="Placement.Top">
                                    <MudAvatar Color="Color.Primary">MV</MudAvatar>
                                </MudTooltip>
                            </AvatarContent>
                            <ChildContent>@context.Item.MetaverseObjectTypeName</ChildContent>
                        </MudChip>
                        <MudIcon Icon="@Icons.Material.Filled.TrendingFlat" Class="mud-text-secondary" />
                        <MudChip T="string" Size="Size.Medium">
                            <AvatarContent>
                                <MudTooltip Text="Connected System Object Type" Arrow="true" Placement="Placement.Top">
                                    <MudAvatar Color="Color.Secondary">CS</MudAvatar>
                                </MudTooltip>
                            </AvatarContent>
                            <ChildContent>@context.Item.ConnectedSystemObjectTypeName</ChildContent>
                        </MudChip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Actions" Name="actions" />
            </HeaderTemplate>
            <CellTemplate>
                <div class="d-flex align-center gap-1 flex-wrap">
                    @switch (SyncRuleFilter.GetActionType(context.Item))
                    {
                        case SyncRuleActionType.Projects:
                            <MudTooltip Text="Projects new objects to the Metaverse" Arrow="true" Placement="Placement.Top">
                                <MudChip T="string" Variant="Variant.Text" Color="Color.Info">Projects</MudChip>
                            </MudTooltip>
                            break;
                        case SyncRuleActionType.Provisions:
                            <MudTooltip Text="Provisions new objects to the Connected System" Arrow="true"
                                        Placement="Placement.Top">
                                <MudChip T="string" Variant="Variant.Text" Color="Color.Warning">Provisions</MudChip>
                            </MudTooltip>
                            break;
                        default:
                            <EmptyValue />
                            break;
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Attention" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Attention</MudText>
            </HeaderTemplate>
            <CellTemplate>
                <InitialPasswordAttentionIndicator Attention="@GetInitialPasswordAttention(context.Item.Id)"
                                                   SubjectName="@context.Item.Name" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Status" Name="status" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.Enabled)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Success">Enabled</MudChip>
                }
                else
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Default">Disabled</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Created" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Created" Name="created" />
            </HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                    @context.Item.Created.ToLocalTime().ToRelativeTime()
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No Synchronisation Rules match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else if (!_filter.IsEmpty)
        {
            <TableEmptyState Icon="@Icons.Material.Filled.FilterAlt"
                             PrimaryText="No Synchronisation Rules match the current filters"
                             SecondaryText="Adjust or clear the filters above to see more results." />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.Sync"
                             PrimaryText="No Synchronisation Rules yet"
                             SecondaryText="Use the Create Synchronisation Rule button to define your first flow." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private VirtualisedDataGrid<SyncRuleHeader>? _grid;
    private IList<SyncRuleHeader>? _syncRuleHeaders;
    private Dictionary<int, InitialPasswordAttention>? _initialPasswordAttention;
    private bool _canCreateSyncRules;

    // The single holder of filter state. SyncRuleFilter.Matches is the same predicate the REST API
    // filters through, so every surface narrows a Synchronisation Rule list identically. The grid's
    // search box feeds the Search facet via each window request; the selects above feed the rest.
    private readonly SyncRuleFilter _filter = new();

    private Dictionary<int, string> _connectedSystemNames = new();
    private List<int> _connectedSystemFilterOptionIds = [];

    private readonly List<BreadcrumbItem> _breadcrumbs = new List<BreadcrumbItem>
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Administration", href: "/admin"),
        new("Synchronisation Rules", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        await EnsureLoadedAsync();
    }

    /// <summary>
    /// Loads the Synchronisation Rule list, its filter options and its per-row indicator data once. The grid's
    /// window loader also calls this because the grid can request its first window before this page's
    /// initialisation has completed.
    /// </summary>
    private async Task EnsureLoadedAsync()
    {
        if (_syncRuleHeaders != null)
            return;

        using var jim = JimFactory.Create();
        _canCreateSyncRules = jim.ConnectedSystems.GetConnectedSystemCount() > 0;
        _syncRuleHeaders = await jim.ConnectedSystems.GetSyncRuleHeadersAsync();

        // Offer only the Connected Systems that actually have Synchronisation Rules; filtering by a
        // system with none would just empty the table.
        _connectedSystemNames = _syncRuleHeaders
            .GroupBy(h => h.ConnectedSystemId)
            .ToDictionary(g => g.Key, g => g.First().ConnectedSystemName);
        _connectedSystemFilterOptionIds = _connectedSystemNames.OrderBy(n => n.Value).Select(n => n.Key).ToList();

        // One grouped count for the whole page rather than one query per row, which is the shape a per-row
        // indicator turns into if each row asks for itself.
        if (_syncRuleHeaders.Count > 0)
            _initialPasswordAttention = await jim.InitialPasswords.GetAttentionBySyncRuleAsync(
                _syncRuleHeaders.Select(r => r.Id).ToList());
    }

    /// <summary>
    /// Windows the in-memory list for the grid: a small configuration list is loaded whole, then filtered,
    /// sorted and sliced here rather than growing a database range read. The grid's search text is fed into the
    /// shared filter's Search facet so all surfaces keep matching identically.
    /// </summary>
    private async Task<VirtualisedWindow<SyncRuleHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        await EnsureLoadedAsync();

        _filter.Search = request.SearchText;
        IEnumerable<SyncRuleHeader> filtered = _filter.IsEmpty
            ? _syncRuleHeaders!
            : _syncRuleHeaders!.Where(_filter.Matches);

        filtered = request.SortBy switch
        {
            "direction" => request.SortDescending
                ? filtered.OrderByDescending(r => r.Direction)
                : filtered.OrderBy(r => r.Direction),
            "connectedsystem" => request.SortDescending
                ? filtered.OrderByDescending(r => r.ConnectedSystemName)
                : filtered.OrderBy(r => r.ConnectedSystemName),
            "objectmapping" => request.SortDescending
                ? filtered.OrderByDescending(GetObjectMappingSortKey)
                : filtered.OrderBy(GetObjectMappingSortKey),
            "actions" => request.SortDescending
                ? filtered.OrderByDescending(SyncRuleFilter.GetActionType)
                : filtered.OrderBy(SyncRuleFilter.GetActionType),
            "status" => request.SortDescending
                ? filtered.OrderByDescending(r => r.Enabled)
                : filtered.OrderBy(r => r.Enabled),
            "created" => request.SortDescending
                ? filtered.OrderByDescending(r => r.Created)
                : filtered.OrderBy(r => r.Created),
            _ => request.SortDescending
                ? filtered.OrderByDescending(r => r.Name)
                : filtered.OrderBy(r => r.Name)
        };

        return filtered.ToWindow(request);
    }

    /// <summary>
    /// The Object Mapping column leads with the source side of the flow, so it sorts by it too: the Connected
    /// System Object Type for inbound rules and the Metaverse Object Type for outbound ones.
    /// </summary>
    private static string GetObjectMappingSortKey(SyncRuleHeader header) =>
        header.Direction == SyncRuleDirection.Import ? header.ConnectedSystemObjectTypeName : header.MetaverseObjectTypeName;

    private InitialPasswordAttention? GetInitialPasswordAttention(int syncRuleId) =>
        _initialPasswordAttention != null && _initialPasswordAttention.TryGetValue(syncRuleId, out var attention) ? attention : null;

    /// <summary>
    /// The facet selects are page-owned filters, so a change refreshes the grid with the totals invalidated (the
    /// old total describes a match set that no longer exists) and resets its scroll position.
    /// </summary>
    private async Task OnPageFilterChangedAsync()
    {
        if (_grid == null)
            return;

        await _grid.ResetScrollAsync();
        await _grid.RefreshAsync(invalidateTotals: true);
    }

    private IReadOnlyCollection<int> SelectedConnectedSystemIds => _filter.ConnectedSystemIds ?? [];

    private IReadOnlyCollection<SyncRuleDirection> SelectedDirections => _filter.Directions ?? [];

    private IReadOnlyCollection<SyncRuleActionType> SelectedActionTypes => _filter.ActionTypes ?? [];

    private IReadOnlyCollection<SyncRuleStatus> SelectedStatuses => _filter.Statuses ?? [];

    private async Task OnConnectedSystemFilterChanged(IReadOnlyCollection<int> selected)
    {
        _filter.ConnectedSystemIds = selected;
        await OnPageFilterChangedAsync();
    }

    private async Task OnDirectionFilterChanged(IReadOnlyCollection<SyncRuleDirection> selected)
    {
        _filter.Directions = selected;
        await OnPageFilterChangedAsync();
    }

    private async Task OnActionTypeFilterChanged(IReadOnlyCollection<SyncRuleActionType> selected)
    {
        _filter.ActionTypes = selected;
        await OnPageFilterChangedAsync();
    }

    private async Task OnStatusFilterChanged(IReadOnlyCollection<SyncRuleStatus> selected)
    {
        _filter.Statuses = selected;
        await OnPageFilterChangedAsync();
    }

    private string GetConnectedSystemFilterText(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues.Count == 1 &&
            int.TryParse(selectedValues[0], out var connectedSystemId) &&
            _connectedSystemNames.TryGetValue(connectedSystemId, out var connectedSystemName))
        {
            return connectedSystemName;
        }

        return GetMultiSelectText(selectedValues);
    }

    private static string GetDirectionFilterText(IReadOnlyList<string> selectedValues) =>
        GetMultiSelectText(selectedValues, value => value == nameof(SyncRuleDirection.Import) ? "Inbound" : "Outbound");

    private static string GetActionTypeFilterText(IReadOnlyList<string> selectedValues) =>
        GetMultiSelectText(selectedValues, value => value == nameof(SyncRuleActionType.FlowOnly) ? "Flow Only" : value);

    private static string GetStatusFilterText(IReadOnlyList<string> selectedValues) => GetMultiSelectText(selectedValues);

    /// <summary>
    /// Renders a multi-select's summary text: blank when nothing is selected (so the label's
    /// placeholder shows through), the single selection's display label when one is selected, and a
    /// count otherwise. Matches the convention used by the Activities and Operations filter bars.
    /// </summary>
    private static string GetMultiSelectText(IReadOnlyList<string> selectedValues, Func<string, string>? displayLabel = null)
    {
        return selectedValues.Count switch
        {
            0 => string.Empty,
            1 => displayLabel == null ? selectedValues[0] : displayLabel(selectedValues[0]),
            _ => $"{selectedValues.Count} selected"
        };
    }
}
