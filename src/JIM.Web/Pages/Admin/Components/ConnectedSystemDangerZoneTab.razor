@* ─── Deletion impact (#134) ─── *@
@* A deletion of a fenced system is already underway, so there is nothing left to preview. *@
@if (ConnectedSystem.Status != ConnectedSystemStatus.Deleting)
{
    <MudPaper Class="pa-4" Outlined="true" data-testid="jim-deletion-impact">
        <MudText Typo="Typo.h6">Deletion impact</MudText>
        <MudText Class="mt-2">
            See what deleting this system would do before you do it: which attribute values would be cleared or taken
            over by another Connected System, which Metaverse Objects would become eligible for deletion, and what would
            be exported downstream. Nothing changes while the preview runs, and you can leave this page while it does.
        </MudText>
        <div class="d-flex align-center flex-wrap gap-3 mt-4">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Secondary"
                       DropShadow="false"
                       StartIcon="@Icons.Material.Filled.Visibility"
                       Disabled="@(_startingPreview || _previewState.Status == ConnectedSystemPreviewStatus.Running)"
                       OnClick="StartPreviewAsync"
                       data-testid="jim-preview-deletion-impact">
                @(_previewActivityId.HasValue ? "Run again" : "Preview deletion impact")
            </MudButton>
            @if (!_previewActivityId.HasValue)
            {
                <MudText Class="mud-text-secondary">Not previewed yet</MudText>
            }
        </div>
    </MudPaper>

    @if (_previewActivityId.HasValue)
    {
        var previewActivityId = _previewActivityId.Value;

        @if (_previewState.Status == ConnectedSystemPreviewStatus.Stale)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-6" data-testid="jim-deletion-impact-stale">
                @_previewState.StaleReason since this preview ran (@_previewState.OvertakenBy), so it may no longer be accurate.
                Run it again before deleting; a deletion now records that the preview informing it was out of date.
            </MudAlert>
        }

        <ConfigurationChangePreviewPanel ActivityId="@previewActivityId"
                                         Title="Deletion impact preview"
                                         OnPreviewChanged="OnPreviewChangedAsync"
                                         OnClose="DiscardPreview"
                                         Class="mt-6" />
    }
}

<MudPaper Class="@(ConnectedSystem.Status == ConnectedSystemStatus.Deleting ? "pa-4 jim-paper-danger-zone" : "pa-4 mt-6 jim-paper-danger-zone")">
    <MudText Typo="Typo.h6" Color="Color.Error">Delete Connected System</MudText>
    <MudText Class="mt-2">
        Permanently delete this Connected System and all its related data, including:
    </MudText>
    <ul class="mt-2 ml-4">
        <li>All Connected System Objects</li>
        <li>All Synchronisation Rules</li>
        <li>All Run Profiles</li>
        <li>All Partitions and Containers</li>
        <li>All Pending Exports</li>
    </ul>
    <MudText Class="mt-2">
        Metaverse Objects joined to this system are disconnected from it. Any for which it is the last connector are then
        subject to their Object Type's deletion rule; the deletion impact preview above names them.
    </MudText>

    @if (ConnectedSystem.Status == ConnectedSystemStatus.Deleting)
    {
        <MudText Class="mt-2">
            A deletion is already underway or stopped partway for this system. Deleting again offers the
            exits: Deprovision through synchronisation resumes the run, and Delete immediately and keep
            contributed data completes the deletion at once.
        </MudText>
    }

    @* Stays live for a fenced (Status = Deleting) system: the dialog's two modes become the retry and
       finish-immediately exits (#809), and the server refuses anything that cannot proceed. *@
    <MudButton
        Variant="Variant.Filled"
        Color="Color.Error"
        Class="mt-5"
        DropShadow="false"
        StartIcon="@Icons.Material.Filled.Delete"
        OnClick="HandleShowDeleteConfirmationAsync">
        Delete Connected System
    </MudButton>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // The deletion impact preview on show (#134): the one started here, or the latest one found on arrival, so a
    // preview keeps running and is reattached to when the administrator navigates away and comes back.
    private Guid? _previewActivityId;
    private ConnectedSystemPreviewState _previewState = new(ConnectedSystemPreviewStatus.NotPreviewed);
    private bool _previewSettled;
    private bool _startingPreview;

    protected override async Task OnInitializedAsync()
    {
        if (ConnectedSystem.Status != ConnectedSystemStatus.Deleting)
            await ReloadPreviewStateAsync(attachToLatest: true);
    }

    /// <summary>
    /// Reads the latest deletion preview and whether anything has overtaken it. Attaches the panel to it when asked
    /// (on arrival, and when the delete dialog sends the administrator here to read it).
    /// </summary>
    private async Task ReloadPreviewStateAsync(bool attachToLatest)
    {
        using var jim = JimFactory.Create();
        var preview = await jim.ConfigurationChangePreviews.GetLatestConnectedSystemPreviewAsync(
            ConfigurationChangePreviewSurface.ConnectedSystemDeletion, ConnectedSystem.Id);
        var staleness = preview is { IsComplete: true }
            ? await jim.ConfigurationChangePreviews.GetPreviewStalenessAsync(preview.ActivityId)
            : null;

        _previewState = ConnectedSystemPreviewState.From(preview, staleness);
        _previewSettled = _previewState.Status is not (ConnectedSystemPreviewStatus.Running or ConnectedSystemPreviewStatus.NotPreviewed);
        if (attachToLatest && preview != null)
            _previewActivityId = preview.ActivityId;
    }

    private async Task StartPreviewAsync()
    {
        if (_startingPreview)
            return;

        _startingPreview = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

            // The starter, not StartAndDispatchPreviewAsync: it owns asking whether a large preview keeps every
            // drill-down row, so that question is asked the same way on every surface.
            var activityId = await PreviewStarter.StartAsync(new ConfigurationChangePreviewRequest
            {
                Surface = ConfigurationChangePreviewSurface.ConnectedSystemDeletion,
                TargetId = ConnectedSystem.Id,
                TargetName = ConnectedSystem.Name,
                ProposedConfiguration = new ConnectedSystemDeletionProposal(),
                InitiatedByType = ActivityInitiatorType.User,
                InitiatedById = user.Id,
                InitiatedByName = user.Name
            });

            // Null means the administrator declined the data-set size question, which is a decision not to preview.
            if (activityId == null)
                return;

            _previewActivityId = activityId;
            _previewState = new ConnectedSystemPreviewState(ConnectedSystemPreviewStatus.Running, activityId);
            _previewSettled = false;
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            Log.Error(ex, "Failed to start a deletion impact preview for Connected System {ConnectedSystemId}", ConnectedSystem.Id);
            Snackbar.Add($"Failed to start the preview: {ex.Message}", Severity.Error);
        }
        finally
        {
            _startingPreview = false;
        }
    }

    /// <summary>
    /// Re-reads the preview's state when it settles (finishes, fails or is cancelled), so the Run again button
    /// re-enables and staleness is judged.
    /// </summary>
    /// <remarks>
    /// Re-renders only on that one transition. The panel re-reads on every parameter set and raises this on every
    /// read, so re-rendering on every call would set its parameters again and restart its poll indefinitely (the
    /// reason recorded on the schema tab's equivalent handler).
    /// </remarks>
    private async Task OnPreviewChangedAsync(ConfigurationChangePreview? preview)
    {
        var settled = preview is { IsComplete: true } || preview is { HasFailed: true } || preview == null;
        if (settled == _previewSettled)
            return;

        await ReloadPreviewStateAsync(attachToLatest: false);
        StateHasChanged();
    }

    private void DiscardPreview()
    {
        _previewActivityId = null;
        _previewState = new ConnectedSystemPreviewState(ConnectedSystemPreviewStatus.NotPreviewed);
        _previewSettled = false;
    }

    private async Task HandleShowDeleteConfirmationAsync()
    {
        switch (await DeleteConnectedSystemDialog.ShowAsync(DialogService, ConnectedSystem))
        {
            // Deleted or queued: this system's detail page is about to stop being meaningful, so return to the list.
            case DeleteConnectedSystemDialogOutcome.Deleted:
                NavManager.NavigateTo("/admin/connected-systems/");
                break;

            case DeleteConnectedSystemDialogOutcome.PreviewRequested:
                await StartPreviewAsync();
                break;

            case DeleteConnectedSystemDialogOutcome.ShowPreview:
                await ReloadPreviewStateAsync(attachToLatest: true);
                break;
        }
    }
}
