@* Shared value editor for a scoping or predefined-search criterion. Renders the value input that matches
   the attribute's data type, including the Absolute/Relative value mode and relative sub-form for DateTime. *@

@* "has a value" and "has no value" compare against nothing, so there is no value to enter. *@
@if (ShowsValue)
{
@switch (AttributeType)
{
    case AttributeDataType.Text when SearchComparisonOperators.IsPattern(Criterion.ComparisonType):
        <MudTextField @bind-Value="Criterion.StringValue" @bind-Value:after="OnChangedAsync" Immediate="true" Required="true"
                      Label="@SyncRuleText.CriterionPattern" Variant="Variant.Outlined" Class="mt-5"
                      Error="@(PatternError != null)" ErrorText="@PatternError"
                      HelperText="@SyncRuleText.CriterionPatternHelp" />
        <MudCheckBox @bind-Value="Criterion.CaseSensitive" @bind-Value:after="OnChangedAsync" Label="@SyncRuleText.CriterionCaseSensitive" Class="mt-2" />
        break;
    case AttributeDataType.Text:
        <MudTextField @bind-Value="Criterion.StringValue" @bind-Value:after="OnChangedAsync" Immediate="true" Required="true" Label="@SyncRuleText.CriterionTextValue" Variant="Variant.Outlined" Class="mt-5" />
        <MudCheckBox @bind-Value="Criterion.CaseSensitive" @bind-Value:after="OnChangedAsync" Label="@SyncRuleText.CriterionCaseSensitive" Class="mt-2" />
        break;
    case AttributeDataType.Guid:
        <MudTextField @bind-Value="Criterion.GuidValue" @bind-Value:after="OnChangedAsync" Immediate="true" Required="true" Label="@SyncRuleText.CriterionGuidValue" Variant="Variant.Outlined" Class="mt-5" />
        break;
    case AttributeDataType.Number:
        <MudNumericField @bind-Value="Criterion.IntValue" @bind-Value:after="OnChangedAsync" Immediate="true" Label="@SyncRuleText.CriterionNumberValue" Variant="Variant.Outlined" Class="mt-5" />
        break;
    case AttributeDataType.LongNumber:
        <MudNumericField @bind-Value="Criterion.LongValue" @bind-Value:after="OnChangedAsync" Immediate="true" Label="@SyncRuleText.CriterionLongNumberValue" Variant="Variant.Outlined" Class="mt-5" />
        break;
    case AttributeDataType.Decimal:
        <MudNumericField @bind-Value="Criterion.DecimalValue" @bind-Value:after="OnChangedAsync" Immediate="true" Label="@SyncRuleText.CriterionDecimalValue" Variant="Variant.Outlined" Class="mt-5" />
        break;
    case AttributeDataType.DateTime:
        <MudRadioGroup T="DateCriteriaValueMode" Value="Criterion.ValueMode" ValueChanged="HandleValueModeChanged" Class="mt-5">
            <MudRadio T="DateCriteriaValueMode" Value="DateCriteriaValueMode.Absolute">@SyncRuleText.CriterionAbsoluteDate</MudRadio>
            <MudRadio T="DateCriteriaValueMode" Value="DateCriteriaValueMode.Relative">@SyncRuleText.CriterionRelativeToNow</MudRadio>
        </MudRadioGroup>

        @if (Criterion.ValueMode == DateCriteriaValueMode.Absolute)
        {
            <MudDatePicker @bind-Date="Criterion.DateTimeValue" @bind-Date:after="OnChangedAsync" Label="@SyncRuleText.CriterionDateValue" Variant="Variant.Outlined" Class="mt-3" />
        }
        else
        {
            <div class="d-flex gap-4 mt-3">
                <MudNumericField @bind-Value="Criterion.RelativeCount" @bind-Value:after="OnChangedAsync" Immediate="true" Label="@SyncRuleText.CriterionCount" Min="0" Variant="Variant.Outlined" />
                <MudSelect T="RelativeDateUnit?" @bind-Value="Criterion.RelativeUnit" @bind-Value:after="OnChangedAsync" Label="@SyncRuleText.CriterionUnit" Variant="Variant.Outlined">
                    @foreach (RelativeDateUnit unit in Enum.GetValues(typeof(RelativeDateUnit)))
                    {
                        <MudSelectItem T="RelativeDateUnit?" Value="@unit">@UnitName(unit)</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="RelativeDateDirection?" @bind-Value="Criterion.RelativeDirection" @bind-Value:after="OnChangedAsync" Label="@SyncRuleText.CriterionDirection" Variant="Variant.Outlined">
                    <MudSelectItem T="RelativeDateDirection?" Value="@RelativeDateDirection.Ago">@SyncRuleText.CriterionAgo</MudSelectItem>
                    <MudSelectItem T="RelativeDateDirection?" Value="@RelativeDateDirection.FromNow">@SyncRuleText.CriterionFromNow</MudSelectItem>
                </MudSelect>
            </div>
            @if (RelativePreview is { } preview)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.CriterionRelativePreview, preview)</MudText>
            }
        }
        break;
    case AttributeDataType.Boolean:
        <MudCheckBox @bind-Value="Criterion.BoolValue" @bind-Value:after="OnChangedAsync" TriState="true" Class="mt-5" Label="@SyncRuleText.CriterionBooleanValue">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.CriterionBooleanState, BooleanStateName(Criterion.BoolValue))</MudCheckBox>
        break;
    default:
        <MudAlert Severity="Severity.Warning" Class="mt-5">@SyncRuleText.CriterionUnsupported</MudAlert>
        break;
}
}

@code {
    /// <summary>
    /// The criterion being edited. The component mutates its value carriers directly.
    /// </summary>
    [Parameter, EditorRequired]
    public ICriterionValues Criterion { get; set; } = null!;

    /// <summary>
    /// The data type of the attribute the criterion targets; determines which value input is shown.
    /// </summary>
    [Parameter, EditorRequired]
    public AttributeDataType AttributeType { get; set; }

    /// <summary>
    /// Raised after any value the component mutates on <see cref="Criterion"/> changes. The host owns the criterion
    /// by reference, so a @bind here re-renders only this child; without this notification the host's dependent UI
    /// (for example an "Add Criteria" button gated on the criterion being valid) would not re-evaluate. Hosts wire
    /// this to StateHasChanged (or their own change handler).
    /// </summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private async Task OnChangedAsync() => await OnChanged.InvokeAsync();

    /// <summary>A relative date unit as a person reads it. The enum's own name is never shown.</summary>
    private static string UnitName(RelativeDateUnit unit) => unit switch
    {
        RelativeDateUnit.Hours => SyncRuleText.UnitHours,
        RelativeDateUnit.Days => SyncRuleText.UnitDays,
        RelativeDateUnit.Weeks => SyncRuleText.UnitWeeks,
        RelativeDateUnit.Months => SyncRuleText.UnitMonths,
        RelativeDateUnit.Years => SyncRuleText.UnitYears,
        _ => unit.ToString()
    };

    /// <summary>The state of a tri-state boolean criterion: not set is Null, otherwise True or False.</summary>
    private static string BooleanStateName(bool? value) => !value.HasValue
        ? SyncRuleText.CriterionNull
        : value.Value ? CommonText.True : CommonText.False;

    // Until an operator is chosen the value input shows, as it always has; it hides only for an operator that takes none.
    private bool ShowsValue => Criterion.ComparisonType == SearchComparisonType.NotSet || SearchComparisonOperators.TakesValue(Criterion.ComparisonType);

    // Shown once something has been typed; an empty pattern is the Required marker's job.
    private string? PatternError => string.IsNullOrEmpty(Criterion.StringValue)
        ? null
        : SearchComparisonOperators.ValidatePattern(Criterion.StringValue);

    private string? RelativePreview =>
        Criterion is { ValueMode: DateCriteriaValueMode.Relative, RelativeCount: { } count, RelativeUnit: { } unit, RelativeDirection: { } direction }
            ? RelativeDateResolver.Describe(count, unit, direction)
            : null;

    private async Task HandleValueModeChanged(DateCriteriaValueMode mode)
    {
        Criterion.ValueMode = mode;
        if (mode == DateCriteriaValueMode.Relative)
        {
            // Seed sensible defaults so the relative sub-form is immediately valid.
            Criterion.RelativeCount ??= 0;
            Criterion.RelativeUnit ??= RelativeDateUnit.Days;
            Criterion.RelativeDirection ??= RelativeDateDirection.Ago;
            Criterion.DateTimeValue = null;
        }
        else
        {
            Criterion.RelativeCount = null;
            Criterion.RelativeUnit = null;
            Criterion.RelativeDirection = null;
        }

        await OnChangedAsync();
    }
}
