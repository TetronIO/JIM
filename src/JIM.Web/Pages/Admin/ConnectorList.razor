@page "/admin/connected-systems/connectors"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Staging.DTOs
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Connectors</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Power" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />Connectors</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    JIM uses Connectors to connect to external systems and import/export data. A number are pre-supplied as built-in connectors for common system types, but you can also install third-party connectors.
    From here you can see which are installed and if any have updates that can be applied.
</MudText>

<MudButtonGroup Class="mt-3" OverrideStyles="false">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/admin/connected-systems">Connected Systems</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary">Connectors</MudButton>
</MudButtonGroup>

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count, the search box)
   lives in the shared grid; this page loads the small configuration list once and windows it in memory. *@
<VirtualisedDataGrid T="ConnectorDefinitionHeader"
                     ContainerId="connector-list"
                     DefaultSortBy="name"
                     LoadWindow="LoadWindowAsync"
                     SingularName="Connector"
                     PluralName="Connectors">
    <Columns>
        <TemplateColumn Title="Name" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Name" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                <span class="jim-nowrap"><MudLink Href="@("/admin/connected-systems/connectors/"+context.Item.Id)">@context.Item.Name</MudLink></span>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Description" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Description" Name="description" />
            </HeaderTemplate>
            <CellTemplate>
                @* A row in a virtualised grid is one line, so a long description is clipped rather than wrapped;
                   it is available in full on hover, and on the Connector's own page. *@
                <OneLineText Text="@context.Item.Description" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Built-in?" Sortable="false" HeaderClass="jim-nowrap" HeaderStyle="width: 90px;">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Built-in?" Name="builtin" />
            </HeaderTemplate>
            <CellTemplate>
                @(context.Item.BuiltIn ? "Yes" : "No")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="In-use?" Sortable="false" HeaderClass="jim-nowrap" HeaderStyle="width: 90px;">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="In-use?" Name="inuse" />
            </HeaderTemplate>
            <CellTemplate>
                @(context.Item.InUse ? "Yes" : "No")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Version(s)" Sortable="false" HeaderStyle="width: 110px;">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Version(s)" Name="versions" />
            </HeaderTemplate>
            <CellTemplate>
                @if (string.IsNullOrEmpty(context.Item.Versions))
                {
                    <EmptyValue />
                }
                else
                {
                    @context.Item.Versions
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No Connectors match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.Power"
                             PrimaryText="No Connectors installed"
                             SecondaryText="Built-in Connectors appear here once JIM has initialised." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private IList<ConnectorDefinitionHeader>? _headers;

    private readonly List<BreadcrumbItem> _breadcrumbs = new List<BreadcrumbItem>
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Administration", href: "/admin"),
        new("Connected Systems", href: "/admin/connected-systems/"),
        new("Connectors", href: null, disabled: true),
    };

    protected override async Task OnInitializedAsync()
    {
        await EnsureLoadedAsync();
    }

    /// <summary>
    /// Loads the Connector list once. The grid's window loader also calls this because the grid can request its
    /// first window before this page's initialisation has completed.
    /// </summary>
    private async Task EnsureLoadedAsync()
    {
        if (_headers != null)
            return;

        using var jim = JimFactory.Create();
        _headers = await jim.ConnectedSystems.GetConnectorDefinitionHeadersAsync();
    }

    /// <summary>
    /// Windows the in-memory list for the grid: a small configuration list is loaded whole, then searched, sorted
    /// and sliced here rather than growing a database range read.
    /// </summary>
    private async Task<VirtualisedWindow<ConnectorDefinitionHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        await EnsureLoadedAsync();

        IEnumerable<ConnectorDefinitionHeader> filtered = _headers!;
        if (!string.IsNullOrWhiteSpace(request.SearchText))
            filtered = filtered.Where(c => c.Name.Contains(request.SearchText, StringComparison.OrdinalIgnoreCase));

        filtered = request.SortBy switch
        {
            "description" => request.SortDescending
                ? filtered.OrderByDescending(c => c.Description ?? string.Empty)
                : filtered.OrderBy(c => c.Description ?? string.Empty),
            "builtin" => request.SortDescending
                ? filtered.OrderByDescending(c => c.BuiltIn)
                : filtered.OrderBy(c => c.BuiltIn),
            "inuse" => request.SortDescending
                ? filtered.OrderByDescending(c => c.InUse)
                : filtered.OrderBy(c => c.InUse),
            "versions" => request.SortDescending
                ? filtered.OrderByDescending(c => c.Versions ?? string.Empty)
                : filtered.OrderBy(c => c.Versions ?? string.Empty),
            _ => request.SortDescending
                ? filtered.OrderByDescending(c => c.Name)
                : filtered.OrderBy(c => c.Name)
        };

        return filtered.ToWindow(request);
    }
}
