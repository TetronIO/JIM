@* The Operations page's Activity tab (#2549): what the worker has queued, what it is running and what it has finished,
   on one page in time order, later at the top. It replaced the Queue and History tabs, between which an administrator
   had to flick to see what the system was doing as a whole. *@

@{
    var activeChips = _filters.ActiveChips(ScheduleNameFor);
}

@* ─── Toolbar ─── *@
@* mt-5 rather than a tab-panel padding: the Operations page hands its tabs no top padding of their own, because
   the Schedules tab opens straight onto a grid that already supplies this same gap. *@
@* The filter row sits behind its button, closed on arrival even when the URL carries filters: the chips beside the
   button say what narrows the view, each closing to put that one filter back, so the row is for changing filters
   rather than for reading them. Which rows are shown is said by the sections themselves, in their headings. *@
<div class="d-flex align-center flex-wrap gap-3 mt-5 mb-4">
    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Tune" OnClick="@(() => _filtersOpen = !_filtersOpen)"
               aria-expanded="@(_filtersOpen ? "true" : "false")" aria-controls="activity-filters" data-testid="toggle-filters">
        Filters
    </MudButton>
    @foreach (var chip in activeChips)
    {
        <MudChip T="string" Variant="Variant.Text" Color="Color.Primary" Class="ma-0" @key="chip.Kind"
                 OnClose="@(_ => SetFiltersAsync(_filters.Without(chip.Kind)))" data-testid="active-filter">@chip.Label</MudChip>
    }
    @if (activeChips.Count > 0)
    {
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearFiltersAsync" data-testid="clear-filters">Clear</MudButton>
    }
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlaylistAdd"
               OnClick="QueueRunProfileAsync">Queue a Run Profile</MudButton>
</div>

@* ─── Filters ─── *@
@* They apply to every section, except Result and Has child activities, which only mean something for work that
   has finished. *@
@if (_filtersOpen)
{
    <MudPaper Outlined="true" Class="pa-4 mb-6" id="activity-filters" data-testid="activity-filters">
        <MudStack Row="true" Spacing="3" AlignItems="AlignItems.End" Class="flex-wrap">
            <MudItem Class="flex-grow-1">
                <MudSelect T="string" Label="Connected System" Variant="Variant.Outlined"
                           Dense="true" Clearable="true" MultiSelection="true"
                           SelectedValues="_filters.ConnectedSystems"
                           SelectedValuesChanged="@(values => SetFiltersAsync(_filters with { ConnectedSystems = values.ToList() }))"
                           MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectText))">
                    @if (_filterOptions != null)
                    {
                        @foreach (var cs in _filterOptions.ConnectedSystems)
                        {
                            <MudSelectItem T="string" Value="@cs">@cs</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem Class="flex-grow-1">
                <MudSelect T="string" Label="Run Profile" Variant="Variant.Outlined"
                           Dense="true" Clearable="true" MultiSelection="true"
                           SelectedValues="_filters.RunProfiles"
                           SelectedValuesChanged="@(values => SetFiltersAsync(_filters with { RunProfiles = values.ToList() }))"
                           MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectText))">
                    @if (_filterOptions != null)
                    {
                        @foreach (var rp in _filterOptions.RunProfiles)
                        {
                            <MudSelectItem T="string" Value="@rp">@rp</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem Class="flex-grow-1">
                <MudSelect T="Guid" Label="Schedule" Variant="Variant.Outlined"
                           Dense="true" Clearable="true" MultiSelection="true"
                           SelectedValues="_filters.Schedules"
                           SelectedValuesChanged="@(values => SetFiltersAsync(_filters with { Schedules = values.ToList() }))"
                           MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetScheduleMultiSelectText))">
                    @if (_filterOptions != null)
                    {
                        @foreach (var schedule in _filterOptions.Schedules)
                        {
                            <MudSelectItem T="Guid" Value="@schedule.Id">@schedule.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem Class="flex-grow-1">
                <MudSelect T="ActivityStatus" Label="Result" Variant="Variant.Outlined"
                           Dense="true" Clearable="true" MultiSelection="true"
                           SelectedValues="_filters.Results"
                           SelectedValuesChanged="@(values => SetFiltersAsync(_filters with { Results = values.ToList() }))"
                           MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectText))">
                    <MudSelectItem T="ActivityStatus" Value="ActivityStatus.Complete">Complete</MudSelectItem>
                    <MudSelectItem T="ActivityStatus" Value="ActivityStatus.CompleteWithWarning">Complete With Warning</MudSelectItem>
                    <MudSelectItem T="ActivityStatus" Value="ActivityStatus.CompleteWithError">Complete With Error</MudSelectItem>
                    <MudSelectItem T="ActivityStatus" Value="ActivityStatus.FailedWithError">Failed With Error</MudSelectItem>
                    <MudSelectItem T="ActivityStatus" Value="ActivityStatus.Cancelled">Cancelled</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem Class="d-flex align-end">
                <MudCheckBox T="bool" Value="_filters.HasChildActivities"
                             ValueChanged="@(value => SetFiltersAsync(_filters with { HasChildActivities = value }))"
                             Label="Has child activities" Dense="true" Class="mb-1 mud-typography-nowrap" />
            </MudItem>
            <MudItem Class="d-flex align-end">
                <MudCheckBox T="bool" Value="_filters.ScheduledOnly"
                             ValueChanged="@(value => SetFiltersAsync(_filters with { ScheduledOnly = value }))"
                             Label="Scheduled only" Dense="true" Class="mb-1 mud-typography-nowrap" />
            </MudItem>
        </MudStack>
    </MudPaper>
}

@* ─── Sections, later at the top ─── *@
@* Every section is always on the page. The tab owns which are unfolded, because it keeps that in the URL; each
   section's chevron asks for its own to be flipped. *@
<div class="d-flex flex-column gap-4">
    <OperationsQueueSections QueuedExpanded="_sections.Queued" InProgressExpanded="_sections.InProgress"
                             ToggleRequested="OnToggleSectionAsync"
                             Filters="_filters" ScheduleName="ScheduleNameFor" />
    <OperationsCompletedSection Expanded="_sections.Completed"
                                ToggleRequested="@(() => OnToggleSectionAsync(ActivitySection.Completed))"
                                Filters="_filters" OnClearFilters="ClearFiltersAsync" />
</div>

@code {
    private const string SectionsQueryParameter = "s";

    private ActivitySectionState _sections = ActivitySectionState.All;
    private OperationsActivityFilters _filters = OperationsActivityFilters.None;
    private ActivityFilterOptions? _filterOptions;
    private bool _filtersOpen;

    protected override async Task OnInitializedAsync()
    {
        var query = new Uri(NavigationManager.Uri).Query;
        _sections = ActivitySectionState.Parse(System.Web.HttpUtility.ParseQueryString(query)[SectionsQueryParameter]);
        _filters = OperationsActivityFilters.FromQuery(query);

        using var jim = JimFactory.Create();
        _filterOptions = await jim.Activities.GetWorkerTaskActivityFilterOptionsAsync();
    }

    /// <summary>Applies the filters and writes them to the URL in place, as the section toggles are.</summary>
    private async Task SetFiltersAsync(OperationsActivityFilters filters)
    {
        _filters = filters;
        await UpdateUrlAsync(filters.ToQueryParameters());
    }

    private Task ClearFiltersAsync() => SetFiltersAsync(OperationsActivityFilters.None);

    /// <summary>
    /// Flips one section between unfolded and folded and writes the choice to the URL in place, so the view can be
    /// bookmarked and survives a refresh without the navigation that would re-run the page's load.
    /// </summary>
    private async Task OnToggleSectionAsync(ActivitySection section)
    {
        _sections = _sections.Toggle(section);
        var value = _sections.ToQueryValue();
        await UpdateUrlAsync(new Dictionary<string, string[]?> { [SectionsQueryParameter] = value == null ? null : [value] });
    }

    /// <summary>
    /// Writes the given parameters to the URL in place, without the navigation that would re-run the page's load.
    /// Only the parameters named are touched: the Completed list writes its own search and scroll position to the
    /// same URL, and naming everything would drop what it wrote.
    /// </summary>
    private async Task UpdateUrlAsync(IReadOnlyDictionary<string, string[]?> parameters)
    {
        try
        {
            await JS.InvokeVoidAsync("jimInterop.updateQueryString", parameters);
        }
        catch (JSDisconnectedException)
        {
            // The circuit has gone; there is no URL left to update.
        }
    }

    private async Task QueueRunProfileAsync() => await QueueRunProfileDialog.ShowAsync(DialogService);

    private string? ScheduleNameFor(Guid scheduleId) => _filterOptions?.Schedules.FirstOrDefault(s => s.Id == scheduleId)?.Name;

    private static string GetMultiSelectText(IReadOnlyList<string> selectedValues) => selectedValues.Count switch
    {
        0 => string.Empty,
        1 => selectedValues[0],
        _ => $"{selectedValues.Count} selected"
    };

    /// <summary>
    /// MultiSelectionTextFunc is typed against the string form of the selected values regardless of the select's T,
    /// so the Schedule select would otherwise render a raw GUID for a single selection. Map the id back to the
    /// Schedule's name via the loaded filter options.
    /// </summary>
    private string GetScheduleMultiSelectText(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues.Count == 0)
            return string.Empty;

        if (selectedValues.Count > 1)
            return $"{selectedValues.Count} selected";

        var schedule = _filterOptions?.Schedules.FirstOrDefault(s => s.Id.ToString() == selectedValues[0]);
        return schedule?.Name ?? selectedValues[0];
    }
}
