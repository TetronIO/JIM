@* A source named quietly (#399): a dot in the colour the contribution bar gives that source, then the source's *@
@* legend label ("HR"), then optionally the Synchronisation Rule as secondary text. Used where many rows name  *@
@* sources at once (the Inspect table's Source column), so the eye can scan them against the bar's legend      *@
@* without a column of pills competing with the values. The full origin is always on the title.               *@

<span class="jim-source-dot-label" title="@Title">
    <span class="jim-source-dot" style="background: var(@ValueOriginGrouping.ColourTokenFor(Group));" aria-hidden="true"></span>
    <span class="jim-source-dot-name">@Group.Label</span>
    @if (ShowRule && RuleText != null)
    {
        <span class="jim-source-dot-rule">@RuleText</span>
    }
</span>

@code {
    /// <summary>The source, as the contribution bar groups and labels it, so the dot and text match its legend.</summary>
    [Parameter, EditorRequired]
    public ValueOriginGrouping.Group Group { get; set; } = null!;

    /// <summary>
    /// Also names the Synchronisation Rule as secondary text, where the column has room for it. Omitted when the
    /// label already names the rule (a system contributing through more than one rule).
    /// </summary>
    [Parameter]
    public bool ShowRule { get; set; }

    private string? RuleText
    {
        get
        {
            if (Group.SyncRuleDeleted)
                return Group.Label.Contains("rule deleted") ? null : "rule deleted";
            if (string.IsNullOrEmpty(Group.SyncRuleName) || Group.Label.Contains(Group.SyncRuleName))
                return null;
            return Group.SyncRuleName;
        }
    }

    private string Title
    {
        get
        {
            var parts = new List<string?>();
            if (Group.Kind == ValueOriginKind.GeneratedByJim)
                parts.Add("Generated by JIM");
            if (Group.Kind is ValueOriginKind.SynchronisationRule or ValueOriginKind.GeneratedByJim)
            {
                parts.Add(Group.ConnectedSystemName);
                parts.Add(Group.SyncRuleDeleted ? "rule deleted" : Group.SyncRuleName);
            }
            else
            {
                parts.Add(Group.Label);
            }
            return string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));
        }
    }
}
