@* The one component that renders where a Metaverse Object attribute value came from (#399): a Connected  *@
@* System through a Synchronisation Rule, JIM itself, a person, or "not recorded". Every surface that shows *@
@* a value's origin (the Inspect view's Source column, the attribute inspector, later the Changes tab and     *@
@* Pending Export detail) renders through this one component, so an origin reads identically everywhere.       *@
@* One line, no wrapping: see .jim-value-origin-chip in site.css. *@

@if (Compact)
{
    @* Compact: the table-row form. The system chip and the rule as quiet text, no links (the row opens the   *@
    @* inspector, which carries them) and no separators, so a column of origins scans as aligned chips.       *@
    <span class="jim-value-origin-chip jim-value-origin-compact" title="@CompactTitle">
    @if (HasSeveralOrigins)
    {
        <span class="jim-value-origin-rule">Several sources</span>
    }
    else if (Origin.Kind == ValueOriginKind.SynchronisationRule)
    {
        <ObjectChip Kind="ObjectChipKind.ConnectedSystem" Name="@Origin.ConnectedSystemName" Class="ma-0" />
        @if (Origin.SyncRuleDeleted)
        {
            <span class="jim-value-origin-rule">rule deleted</span>
        }
        else if (!string.IsNullOrEmpty(Origin.SyncRuleName))
        {
            <span class="jim-value-origin-rule">@Origin.SyncRuleName</span>
        }
    }
    else if (Origin.Kind == ValueOriginKind.GeneratedByJim)
    {
        @if (!string.IsNullOrEmpty(Origin.ConnectedSystemName))
        {
            <ObjectChip Kind="ObjectChipKind.ConnectedSystem" Name="@Origin.ConnectedSystemName" Class="ma-0" />
        }
        <span class="jim-value-origin-rule">@(string.IsNullOrEmpty(Origin.SyncRuleName) ? "Generated by JIM" : $"Generated by JIM · {Origin.SyncRuleName}")</span>
    }
    else if (Origin.Kind == ValueOriginKind.SetByPerson)
    {
        <span>Set by @Origin.PersonName</span>
    }
    else
    {
        <span class="mud-text-disabled">Source not recorded</span>
    }
    </span>
}
else
{
    <span class="jim-value-origin-chip">
    @if (HasSeveralOrigins)
    {
        <span class="mud-text-secondary">Several sources</span>
    }
    else if (Origin.Kind == ValueOriginKind.SynchronisationRule)
    {
        <ObjectChip Kind="ObjectChipKind.ConnectedSystem" Name="@Origin.ConnectedSystemName" Href="@ConnectedSystemHref" Class="ma-0" />
        @if (Origin.SyncRuleDeleted)
        {
            <span class="mud-text-secondary">·</span>
            <span class="mud-text-disabled">rule deleted</span>
        }
        else if (!string.IsNullOrEmpty(Origin.SyncRuleName))
        {
            <span class="mud-text-secondary">·</span>
            <MudLink Href="@SyncRuleHref" Class="jim-value-origin-rule" title="@Origin.SyncRuleName">@Origin.SyncRuleName</MudLink>
        }
        @if (Origin.AssertsNoValue)
        {
            <span class="mud-text-secondary">asserts no value</span>
        }
    }
    else if (Origin.Kind == ValueOriginKind.GeneratedByJim)
    {
        <MudChip T="string" Variant="Variant.Text" Color="Color.Primary" Class="ma-0">Generated by JIM</MudChip>
        @if (!string.IsNullOrEmpty(Origin.ConnectedSystemName))
        {
            <span class="mud-text-secondary">·</span>
            <ObjectChip Kind="ObjectChipKind.ConnectedSystem" Name="@Origin.ConnectedSystemName" Href="@ConnectedSystemHref" Class="ma-0" />
            @if (!string.IsNullOrEmpty(Origin.SyncRuleName))
            {
                <span class="mud-text-secondary">·</span>
                <MudLink Href="@SyncRuleHref" Class="jim-value-origin-rule" title="@Origin.SyncRuleName">@Origin.SyncRuleName</MudLink>
            }
        }
        @if (Origin.Corrected)
        {
            <MudChip T="string" Variant="Variant.Text" Color="Color.Warning" Class="ma-0">Corrected</MudChip>
        }
    }
    else if (Origin.Kind == ValueOriginKind.SetByPerson)
    {
        <span>Set by @Origin.PersonName</span>
    }
    else
    {
        <span class="mud-text-disabled">Source not recorded</span>
    }
    </span>
}

@code {
    /// <summary>
    /// The origin to render. Ignored (but still required, since the contract's origin lists are never empty)
    /// when <see cref="HasSeveralOrigins"/> is set: a multi-valued attribute whose values came from more than
    /// one source reads as "Several sources" rather than naming just one of them.
    /// </summary>
    [Parameter, EditorRequired]
    public ValueOrigin Origin { get; set; } = null!;

    /// <summary>
    /// True when the attribute's values came from more than one distinct origin, in which case this renders
    /// "Several sources" instead of <see cref="Origin"/>.
    /// </summary>
    [Parameter]
    public bool HasSeveralOrigins { get; set; }

    /// <summary>
    /// Renders the table-row form: the Connected System chip and the Synchronisation Rule as quiet text, with no
    /// links or separators. The full origin sentence stays on the element's title, and the attribute inspector
    /// (which the row opens) carries the links.
    /// </summary>
    [Parameter]
    public bool Compact { get; set; }

    private string CompactTitle
    {
        get
        {
            if (HasSeveralOrigins)
                return "Several sources";

            return Origin.Kind switch
            {
                ValueOriginKind.SynchronisationRule => JoinParts(Origin.ConnectedSystemName,
                    Origin.SyncRuleDeleted ? "rule deleted" : Origin.SyncRuleName,
                    Origin.AssertsNoValue ? "asserts no value" : null),
                ValueOriginKind.GeneratedByJim => JoinParts("Generated by JIM", Origin.ConnectedSystemName, Origin.SyncRuleName,
                    Origin.Corrected ? "corrected" : null),
                ValueOriginKind.SetByPerson => $"Set by {Origin.PersonName}",
                _ => "Source not recorded"
            };
        }
    }

    private static string JoinParts(params string?[] parts) =>
        string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));

    private string? ConnectedSystemHref =>
        Origin.ConnectedSystemId.HasValue ? $"/admin/connected-systems/{Origin.ConnectedSystemId}" : null;

    private string? SyncRuleHref =>
        Origin.SyncRuleId.HasValue ? $"/admin/sync-rules/{Origin.SyncRuleId}" : null;
}
