@* Who started an Activity (#2066), shown the same way wherever it appears: a Schedule by name, with the Schedule icon;
   JIM itself as System, with an icon of its own; a person; an API key. System used to wear the Schedule's clock on the
   Activity pages, which read as "scheduled" although System also covers seeding and housekeeping, while the audit
   panels gave it a cog and the item page a robot. *@

@if (!string.IsNullOrEmpty(ScheduleName))
{
    <span class="@WrapperClass" data-testid="jim-initiator-schedule">
        <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mud-text-secondary" Size="@IconSize" />
        @if (ScheduleExecutionId is { } executionId)
        {
            <MudLink Href="@($"/admin/operations/schedule-executions/{executionId}")" Typo="Typo.inherit">@ScheduleName</MudLink>
        }
        else
        {
            <span>@ScheduleName</span>
        }
        <span class="mud-text-secondary">(Schedule)</span>
    </span>
}
else if (InitiatedByType == ActivityInitiatorType.System)
{
    <span class="@WrapperClass" data-testid="jim-initiator-system">
        <MudIcon Icon="@Helpers.GetInitiatorIcon(ActivityInitiatorType.System)" Class="mud-text-secondary" Size="@IconSize" />
        <span>System</span>
    </span>
}
else if (InitiatedByType == ActivityInitiatorType.User)
{
    <span class="@WrapperClass" data-testid="jim-initiator-user">
        <MudIcon Icon="@Helpers.GetInitiatorIcon(ActivityInitiatorType.User)" Class="mud-text-secondary" Size="@IconSize" />
        @if (UserLink is { } userLink)
        {
            <MudLink Href="@userLink" Typo="Typo.inherit">@DisplayName</MudLink>
        }
        else
        {
            <span>@DisplayName</span>
        }
    </span>
}
else if (InitiatedByType == ActivityInitiatorType.ApiKey)
{
    <span class="@WrapperClass" data-testid="jim-initiator-api-key">
        <MudIcon Icon="@Helpers.GetInitiatorIcon(ActivityInitiatorType.ApiKey)" Class="mud-text-secondary" Size="@IconSize" />
        @if (InitiatedById is { } keyId)
        {
            <MudLink Href="@($"/admin/apikeys/{keyId}")" Typo="Typo.inherit">@(InitiatedByName ?? "API Key")</MudLink>
        }
        else
        {
            <span>@(InitiatedByName ?? "API Key")</span>
        }
    </span>
}
else if (InitiatedByType == ActivityInitiatorType.Anonymous)
{
    @* An unidentified, unauthenticated caller (a failed sign-in attempt): plain text, never a link. *@
    <span class="@WrapperClass" data-testid="jim-initiator-anonymous">
        <MudIcon Icon="@Helpers.GetInitiatorIcon(ActivityInitiatorType.Anonymous)" Class="mud-text-secondary" Size="@IconSize" />
        <span>Anonymous</span>
    </span>
}
else if (!string.IsNullOrEmpty(InitiatedByName))
{
    <span>@InitiatedByName</span>
}
else
{
    <EmptyValue />
}

@code {
    /// <summary>What kind of principal started the Activity.</summary>
    [Parameter]
    public ActivityInitiatorType InitiatedByType { get; set; }

    /// <summary>The principal's id: the person's Metaverse Object, or the API key.</summary>
    [Parameter]
    public Guid? InitiatedById { get; set; }

    /// <summary>The principal's name when the Activity was recorded.</summary>
    [Parameter]
    public string? InitiatedByName { get; set; }

    /// <summary>The Schedule that produced the Activity, as named when it was recorded; null when none did.</summary>
    [Parameter]
    public string? ScheduleName { get; set; }

    /// <summary>The Schedule Execution that produced the Activity, which the Schedule's name links to while it exists.</summary>
    [Parameter]
    public Guid? ScheduleExecutionId { get; set; }

    /// <summary>
    /// The person's Metaverse Object page, where the call site has resolved it under its Object Type; otherwise the
    /// person links by id, as the configuration change history does, and a person with no id is named without a link.
    /// </summary>
    [Parameter]
    public string? UserHref { get; set; }

    /// <summary>Smaller icons for a dense row; the default suits a field on a page.</summary>
    [Parameter]
    public bool Dense { get; set; }

    private Size IconSize => Dense ? Size.Small : Size.Medium;

    private string WrapperClass => "jim-activity-initiator";

    private string DisplayName => InitiatedByName ?? InitiatedById?.ToString() ?? "Unknown";

    private string? UserLink => !string.IsNullOrEmpty(UserHref) ? UserHref : Helpers.GetInitiatorHref(InitiatedByType, InitiatedById);
}
