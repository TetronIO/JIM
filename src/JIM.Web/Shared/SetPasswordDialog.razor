@using JIM.Models.Staging
@using JIM.Models.Transactional.DTOs
@using JIM.Web.Models
@using JIM.Web.Services
@using Microsoft.JSInterop
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject IPasswordChangeOutcomeWaiter OutcomeWaiter
@implements IDisposable

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

@* Sets one password on one or more of a person's accounts (issues #1121, #1172, #1635).                  *@
@*                                                                                                       *@
@* One component for both surfaces. Opened from a Connected System Object the account is a given, so the *@
@* picker is not drawn; opened from a Metaverse Object the administrator chooses which accounts.         *@
@*                                                                                                       *@
@* The password goes onto the queue (#1635), one row per Connected System, and the Password Delivery    *@
@* Service writes it to each directory in its own lane. The dialog stays open and follows the change     *@
@* through the outcome waiter, so the rows below settle while the dialog is still being read: set where  *@
@* the system answered, retrying where it could not be reached, parked where it refused. What used to    *@
@* be a sequence of direct writes narrated by a progress rail is now a fan-out that finishes without the *@
@* dialog, which is why the wait is bounded and a change that outlasts it is followed on the Password    *@
@* tab rather than here.                                                                                 *@
@*                                                                                                       *@
@* The value is masked from the moment it is generated, and copy works while it is masked, so handing a  *@
@* password to the person who needs it never means putting it on a screen. Reveal is the secondary       *@
@* affordance and re-conceals on a timer. This component holds the password in memory for as long as it  *@
@* is open and writes it nowhere; JIM holds it encrypted only until each system has it.                  *@

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Style="min-width: 480px;">
            @if (_stage == Stage.Composing)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="jim-set-password-intro">
                    @if (AllowSelection)
                    {
                        <span>Sets the <b>same password</b> on the accounts you choose. JIM holds the password
                            encrypted only until each system has it, and keeps a refused one so it can finish the
                            job.</span>
                    }
                    else
                    {
                        <span>Sets the password on <b>@Accounts[0].AccountIdentifier</b> in
                            <b>@Accounts[0].ConnectedSystemName</b>. JIM holds the password encrypted only until the
                            system has it, and keeps a refused one so it can finish the job.</span>
                    }
                </MudText>
            }

            @if (!AnyAccountCanTakeAPassword)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="jim-set-password-unsupported">
                    @(AllowSelection
                        ? "None of this person's accounts are in a Connected System whose Connector can set passwords."
                        : "This Connected System's Connector cannot set passwords, so there is nothing to do here.")
                </MudAlert>
            }
            else
            {
                @* The consequence first, before the detail that explains it: which accounts still hold their *@
                @* old password is what the administrator has to act on, and what they have to tell the      *@
                @* person waiting on the telephone.                                                          *@
                @* Three outcomes, three severities. A refusal anywhere is an error, not a caution: reporting  *@
                @* it in amber understates it, and an administrator scanning for whether they still have work *@
                @* to do reads the colour before the sentence. A system JIM could not reach is a warning: the  *@
                @* password is kept and will be retried, so the job is unfinished rather than failed.         *@
                @if (_stage == Stage.Finished)
                {
                    <MudAlert Severity="@SummarySeverity" Variant="Variant.Outlined"
                              data-testid="jim-set-password-summary">
                        @SummarySentence
                    </MudAlert>
                }

                @* ─── Account picker: only while there is still a choice to make ─── *@
                @if (AllowSelection && _stage == Stage.Composing)
                {
                    <div>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Baseline">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">Accounts</MudText>
                            <MudLink Typo="Typo.body2" @onclick="SelectAll" data-testid="jim-set-password-select-all">
                                Select all
                            </MudLink>
                        </MudStack>

                        <MudPaper Outlined="true" Class="pa-0 mt-1">
                            @foreach (var account in SettableAccounts)
                            {
                                @* Aligned to the top so the control sits against the Connected System's name.  *@
                                @* Centring it across a two-line row leaves it floating between the name and    *@
                                @* the account identifier, belonging to neither.                                *@
                                <div class="jim-password-row d-flex align-start" data-testid="jim-set-password-account" @key="account.ConnectedSystemObjectId">
                                    <MudCheckBox T="bool" Value="@_selected.Contains(account.ConnectedSystemObjectId)"
                                                 ValueChanged="@(value => ToggleAccount(account, value))"
                                                 Dense="true" Class="mr-2 jim-password-account-control" />
                                    <MudStack Spacing="0" Class="flex-grow-1" Style="min-width:0">
                                        <MudText Typo="Typo.body2" Class="jim-password-system-name">@account.ConnectedSystemName</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @account.AccountIdentifier
                                        </MudText>
                                    </MudStack>
                                </div>
                            }
                        </MudPaper>

                        @if (UnsettableAccounts.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1"
                                     data-testid="jim-set-password-unsettable">
                                @UnsettableSentence
                            </MudText>
                        }
                    </div>
                }

                @* ─── Where the password has got to, one row per Connected System ─── *@
                @* Its own list rather than status bolted onto the picker: the checkbox column has nothing left *@
                @* to say, and a row that was a question is a poor place to read an answer. Each row updates as *@
                @* its system answers, through the outcome waiter.                                              *@
                @if (_stage != Stage.Composing && _targets.Count > 0)
                {
                    <div>
                        @if (_stage == Stage.Delivering)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2" data-testid="jim-set-password-following">
                                Delivering to @TargetNoun. Each row updates as its system answers.
                            </MudText>
                        }

                        <MudPaper Outlined="true" Class="pa-0 jim-password-results" data-testid="jim-set-password-results">
                            @foreach (var target in _targets)
                            {
                                var failed = PasswordChangeTargetDisplay.IsFailure(target.State);
                                var connectedSystemId = target.ConnectedSystemId;
                                @* The row carries the failure, not the sentence inside it. Setting the target's *@
                                @* own words in red made three lines of washed-out prose that read as milder    *@
                                @* than the thing it was reporting, and site.css already says why: the house    *@
                                @* error alert deliberately keeps its message in the ordinary text colour and   *@
                                @* signals severity through the container.                                      *@
                                <div class="jim-password-result jim-password-row @(failed ? "jim-password-result--failed" : "")"
                                     data-testid="jim-set-password-result" data-state="@target.State" @key="target.ConnectedSystemId">
                                    <MudIcon Icon="@PasswordChangeTargetDisplay.Icon(target.State)"
                                             Color="@PasswordChangeTargetDisplay.Colour(target.State)"
                                             Class="jim-password-result-icon" />
                                    <div class="jim-password-result-body">
                                        <MudText Typo="Typo.body2" Class="jim-password-system-name">@target.ConnectedSystemName</MudText>
                                        <MudText Typo="Typo.body2" Class="@(failed ? "jim-password-result-reason" : "mud-text-secondary")">
                                            @DescribeTarget(target)
                                        </MudText>

                                        @* A system JIM could not reach is retried on its own schedule; the one *@
                                        @* thing an administrator can do about it here is decide not to wait.   *@
                                        @if (target.State == PasswordChangeTargetState.Retrying)
                                        {
                                            <div>
                                                <MudButton Variant="Variant.Text" Size="Size.Small" DropShadow="false"
                                                           StartIcon="@Icons.Material.Filled.CancelScheduleSend"
                                                           Disabled="@_acting"
                                                           OnClick="@(() => StopTryingAsync(connectedSystemId))"
                                                           data-testid="jim-set-password-stop-trying">Stop trying</MudButton>
                                            </div>
                                        }

                                        @* A refusal gets the same guidance the queue page offers, folded away *@
                                        @* until asked for; its "new password for all" action re-runs this     *@
                                        @* dialog's fan-out rather than sending the refused value again.        *@
                                        @if (target.State == PasswordChangeTargetState.Parked)
                                        {
                                            <PasswordFailureGuidancePanel FailureReason="@(target.FailureReason ?? PasswordSetFailureReason.None)"
                                                                          ConnectedSystemId="@target.ConnectedSystemId"
                                                                          ConnectedSystemName="@target.ConnectedSystemName"
                                                                          AccountCount="@_targets.Count"
                                                                          OnRegenerateForAll="TryAnotherPasswordAsync" />
                                        }
                                    </div>
                                </div>
                            }
                        </MudPaper>

                        @if (_pausedSystemNames.Count > 0)
                        {
                            @* Decision D1: a named account is written to whether or not its system takes         *@
                            @* propagated passwords, because the administrator has made the decision the          *@
                            @* configuration exists to make. Said here so the row reading "Set" is not taken as   *@
                            @* evidence that the person's own password changes will reach this system too.        *@
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-2" data-testid="jim-set-password-paused">
                                @PausedSentence
                            </MudText>
                        }

                        @if (_waitRanOut)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3"
                                      data-testid="jim-set-password-still-delivering">
                                Still delivering. The password is safely queued and will be retried if a system is
                                unavailable; follow it on this person's Password tab, or on the
                                <MudLink Href="@QueueHref">Passwords tab of Operations</MudLink>.
                            </MudAlert>
                        }
                    </div>
                }

                @* ─── The password itself ─── *@
                @* Immediate, so the Set button follows what has been typed rather than waiting for a blur. *@
                <MudTextField T="string" Value="@_password" Label="Password" Immediate="true"
                              Variant="Variant.Outlined" ReadOnly="@(_stage != Stage.Composing)"
                              InputType="@(_revealed ? InputType.Text : InputType.Password)"
                              Placeholder="Generate one, or type your own"
                              ValueChanged="@(value => _password = value ?? string.Empty)"
                              data-testid="jim-set-password-value" />

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                    @if (_stage == Stage.Composing)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                                   StartIcon="@Icons.Material.Filled.Casino" OnClick="GenerateForSelection"
                                   Disabled="@(!CanGenerate)"
                                   data-testid="jim-set-password-generate">Generate</MudButton>
                    }

                    @* Copy deliberately does not require a reveal: transferring a password to the person who *@
                    @* needs it should never mean putting it on screen where it can be read over a shoulder.  *@
                    <MudTooltip Text="@CopyTooltip" Arrow="true" Placement="Placement.Top">
                        <span>
                            <MudButton Variant="Variant.Outlined" DropShadow="false"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       Disabled="@(!CanCopy)" OnClick="CopyAsync"
                                       data-testid="jim-set-password-copy">Copy</MudButton>
                        </span>
                    </MudTooltip>

                    <MudButton Variant="Variant.Text" DropShadow="false"
                               StartIcon="@(_revealed ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                               Disabled="@(_password.Length == 0)" OnClick="ToggleRevealAsync"
                               data-testid="jim-set-password-reveal">@(_revealed ? "Hide" : "Reveal")</MudButton>
                </MudStack>

                @if (_revealed)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="jim-set-password-reveal-notice">
                        Hidden again automatically in @($"{RevealDuration.TotalSeconds:0}") seconds.
                    </MudText>
                }

                @if (_stage == Stage.Composing)
                {
                    @if (_reconciliation is { Constraints.Count: > 0 })
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="jim-set-password-constraints">
                            Generated to satisfy @(SelectedAccounts.Count > 1 ? "every selected system" : "this system"):
                            @string.Join(", ", _reconciliation.Constraints).
                        </MudText>
                    }

                    @* Two different situations wear the same face here, and only one of them is the           *@
                    @* administrator's to fix: a schema that has not been imported yet, versus a system that    *@
                    @* publishes no password rules for any client to read. Saying which decides whether they    *@
                    @* go and do something or carry on.                                                        *@
                    @if (SystemsAwaitingSchemaRefresh.Count > 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true"
                                  data-testid="jim-set-password-unknown-policy">
                            <MudText Typo="Typo.body2">
                                JIM has no password policy for
                                <b>@string.Join(", ", SystemsAwaitingSchemaRefresh.Select(a => a.ConnectedSystemName))</b>,
                                so a generated password cannot be checked against
                                @(SystemsAwaitingSchemaRefresh.Count == 1 ? "its" : "their") rules before it is sent.
                                JIM reads the policy while it refreshes a Connected System's schema, so
                                <b>Refresh Schema</b> on the Schema tab will pick it up.
                            </MudText>
                            @foreach (var account in SystemsAwaitingSchemaRefresh)
                            {
                                var connectedSystemId = account.ConnectedSystemId;
                                <MudLink Href="@($"/admin/connected-systems/{connectedSystemId}/?t=schema")"
                                         Typo="Typo.body2" Class="d-inline-flex align-center mt-1 mr-3" @key="account.ConnectedSystemObjectId">
                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="mr-1" />
                                    @account.ConnectedSystemName's Schema tab
                                </MudLink>
                            }
                        </MudAlert>
                    }

                    @if (SystemsThatPublishNoPolicy.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                 data-testid="jim-set-password-no-published-policy">
                            @string.Join(", ", SystemsThatPublishNoPolicy.Select(a => a.ConnectedSystemName))
                            @(SystemsThatPublishNoPolicy.Count == 1 ? "does" : "do") not publish password rules
                            that any client can read, so JIM cannot check a password against them in advance.
                            There is nothing to configure: a password
                            @(SystemsThatPublishNoPolicy.Count == 1 ? "it refuses" : "they refuse") is reported
                            when it happens.
                        </MudText>
                    }

                    @if (_reconciliation is { IsUsable: false })
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined"
                                  data-testid="jim-set-password-irreconcilable">
                            No single password can satisfy every selected system.
                            @string.Join(" ", _reconciliation.Conflicts)
                            Set them separately, or deselect one.
                        </MudAlert>
                    }

                    <MudSelect T="PasswordExpiryBehaviour" Label="After the password is set" @bind-Value="_expiryBehaviour"
                               Variant="Variant.Outlined" Dense="true" data-testid="jim-set-password-expiry">
                        @foreach (var behaviour in AvailableExpiryBehaviours)
                        {
                            <MudSelectItem Value="behaviour" @key="behaviour">@DescribeExpiryBehaviour(behaviour)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSwitch T="bool" @bind-Value="_enableAccount" Color="Color.Primary"
                               Label="@(SelectedAccounts.Count > 1 ? "Enable the accounts as part of setting the password" : "Enable the account as part of setting the password")"
                               data-testid="jim-set-password-enable" />

                    @* Shared and permanent is the combination worth naming. A shared password is defensible   *@
                    @* when it must be changed at the next sign-in; one that never expires, held in several    *@
                    @* systems, means a credential taken from any one of them opens the others, with nothing   *@
                    @* to rotate it. Advisory rather than refused: JIM does not know the deployment's rules.   *@
                    @if (SelectedAccounts.Count > 1 && _expiryBehaviour == PasswordExpiryBehaviour.NeverExpires)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true"
                                  data-testid="jim-set-password-shared-permanent">
                            One password that never expires, held in @SelectedAccounts.Count systems. A credential
                            taken from any one of them opens the others, and nothing will rotate it. Consider
                            setting these separately.
                        </MudAlert>
                    }

                    @if (!_clipboardAvailable)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true"
                                  data-testid="jim-set-password-no-clipboard">
                            Copying is unavailable because this page was not served over HTTPS. Browsers only
                            allow clipboard access in a secure context.
                        </MudAlert>
                    }

                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        JIM clears the clipboard when this dialog closes where the browser allows it, but your
                        operating system may keep a copy in its own clipboard history.
                    </MudText>
                }

                @if (_failure != null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="jim-set-password-failure">
                        @_failure
                    </MudAlert>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        @if (_stage is Stage.Composing or Stage.Queueing)
        {
            <MudButton OnClick="CloseAsync" DropShadow="false" Disabled="@(_stage == Stage.Queueing)"
                       data-testid="jim-set-password-cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
                       Disabled="@(!CanSubmit)" OnClick="SubmitAsync" data-testid="jim-set-password-submit">
                @if (_stage == Stage.Queueing)
                {
                    <MudProgressCircular Class="ms-n1" Indeterminate="true" Size="Size.Small" />
                    <span class="ms-2">Setting...</span>
                }
                else
                {
                    <span>@SubmitLabel</span>
                }
            </MudButton>
        }
        else
        {
            @* Done rather than a disabled wait: the delivery does not need the dialog open to finish. Where a *@
            @* system refused the password, the primary action is the one thing that can still finish the    *@
            @* job: a fresh password on every account this change touched, so the person keeps one.          *@
            <MudButton OnClick="CloseAsync" DropShadow="false"
                       Variant="@(OfferAnotherPassword ? Variant.Text : Variant.Filled)"
                       Color="@(OfferAnotherPassword ? Color.Default : Color.Primary)"
                       data-testid="jim-set-password-cancel">
                @if (_stage == Stage.Delivering)
                {
                    <MudProgressCircular Class="ms-n1" Indeterminate="true" Size="Size.Small" />
                    <span class="ms-2">Done</span>
                }
                else
                {
                    <span>Done</span>
                }
            </MudButton>
            @if (OfferAnotherPassword)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
                           StartIcon="@Icons.Material.Filled.Casino" Disabled="@_acting"
                           OnClick="TryAnotherPasswordAsync" data-testid="jim-set-password-try-another">
                    Try another password
                </MudButton>
            }
        }
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// How often the rows are refreshed while the change is being followed. Each slice is one call to the waiter,
    /// which returns early the moment every target settles, so a change that lands in 800 ms is shown in 800 ms and
    /// one that takes longer is shown moving once a second.
    /// </summary>
    private static readonly TimeSpan FollowSlice = TimeSpan.FromSeconds(1);

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The accounts this dialog can set a password on, including those whose Connector cannot: they are shown
    /// as a sentence rather than left out, so an administrator looking for a system that is not offered can see
    /// that JIM knows about it and why it is not on the list.
    /// </summary>
    [Parameter]
    public IReadOnlyList<MetaverseObjectAccount> Accounts { get; set; } = [];

    /// <summary>
    /// The person whose accounts these are, for the link to their queue rows when a change outlasts the wait.
    /// </summary>
    [Parameter]
    public Guid MetaverseObjectId { get; set; }

    /// <summary>
    /// Whether the administrator chooses which accounts. False when the dialog was opened from one Connected
    /// System Object, where the account is a given and a picker would be a control with one option.
    /// </summary>
    [Parameter]
    public bool AllowSelection { get; set; }

    /// <summary>
    /// Works out one set of generator settings that satisfies every selected system at once, and what had to be
    /// assumed to get there. Supplied by the caller, which owns the policy lookups.
    /// </summary>
    [Parameter]
    public Func<IReadOnlyList<MetaverseObjectAccount>, PasswordPolicyReconciliation> Reconcile { get; set; } =
        _ => new PasswordPolicyReconciliation
        {
            Policy = new PasswordGenerationPolicy(),
            Constraints = [],
            SystemsWithNoDiscoveredPolicy = [],
            Conflicts = [],
            MayBeStricterThanDiscovered = false
        };

    /// <summary>
    /// Produces a password from the reconciled settings.
    /// </summary>
    [Parameter]
    public Func<PasswordGenerationPolicy, string> GeneratePassword { get; set; } = _ => string.Empty;

    /// <summary>
    /// Queues the password for the chosen accounts and returns what was queued. The host adds the person and the
    /// initiator; the dialog then follows the change through the outcome waiter. A request JIM refuses (an account
    /// that is not this person's, two in one system) surfaces as an <see cref="ArgumentException"/> and is shown.
    /// </summary>
    [Parameter]
    public Func<PasswordSetSubmission, Task<PasswordQueueResult>> SetPassword { get; set; } =
        _ => Task.FromResult(new PasswordQueueResult());

    /// <summary>
    /// Stops JIM retrying this person's change on one Connected System, by that system's id. The host owns the
    /// cancellation and its attribution.
    /// </summary>
    [Parameter]
    public Func<int, Task> StopTrying { get; set; } = _ => Task.CompletedTask;

    /// <summary>
    /// How long a revealed password stays on screen before hiding itself again.
    /// <para>
    /// A parameter so tests do not have to wait out the real interval; nothing in the application overrides it.
    /// </para>
    /// </summary>
    [Parameter]
    public TimeSpan RevealDuration { get; set; } = TimeSpan.FromSeconds(30);

    /// <summary>
    /// How long the dialog follows delivery before handing over to the Password tab. Ten seconds is long enough
    /// for every target to answer under ordinary conditions and short enough that an administrator is never left
    /// watching a spinner for a directory that is down; a component test shortens it.
    /// </summary>
    [Parameter]
    public TimeSpan DeliveryWait { get; set; } = TimeSpan.FromSeconds(10);

    private enum Stage { Composing, Queueing, Delivering, Finished }

    private Stage _stage = Stage.Composing;
    private string _password = string.Empty;
    private bool _revealed;
    private bool _clipboardAvailable = true;
    private string? _failure;
    private PasswordExpiryBehaviour _expiryBehaviour = PasswordExpiryBehaviour.RequireChangeAtNextSignIn;
    private bool _enableAccount;
    private CancellationTokenSource? _revealTimeout;
    private PasswordPolicyReconciliation? _reconciliation;

    private readonly HashSet<Guid> _selected = [];

    // The accounts the current change was aimed at, kept so "try another password" can aim the next one at exactly
    // the same set, including the accounts that already took the first.
    private readonly List<MetaverseObjectAccount> _attempted = [];
    private IReadOnlyList<PasswordChangeTargetOutcome> _targets = [];
    private IReadOnlyList<string> _pausedSystemNames = [];
    private bool _queued;
    private bool _acting;
    private bool _waitRanOut;
    private CancellationTokenSource _followCancellation = new();

    private IReadOnlyList<MetaverseObjectAccount> SettableAccounts =>
        Accounts.Where(a => a.ConnectorCanSetPasswords).ToList();

    private IReadOnlyList<MetaverseObjectAccount> UnsettableAccounts =>
        Accounts.Where(a => !a.ConnectorCanSetPasswords).ToList();

    private bool AnyAccountCanTakeAPassword => SettableAccounts.Count > 0;

    private IReadOnlyList<MetaverseObjectAccount> SelectedAccounts =>
        SettableAccounts.Where(a => _selected.Contains(a.ConnectedSystemObjectId)).ToList();

    /// <summary>
    /// Only the behaviours every selected Connector can apply. Offering one that some cannot would let an
    /// administrator choose a setting that is silently downgraded on part of the fan-out.
    /// </summary>
    private IReadOnlyList<PasswordExpiryBehaviour> AvailableExpiryBehaviours
    {
        get
        {
            var accounts = SelectedAccounts.Count > 0 ? SelectedAccounts : SettableAccounts;
            if (accounts.Count == 0)
                return [];

            return accounts
                .Select(a => a.SupportedExpiryBehaviours.ToHashSet())
                .Aggregate((left, right) => { left.IntersectWith(right); return left; })
                .OrderBy(b => b)
                .ToList();
        }
    }

    /// <summary>
    /// Selected systems whose Connector could read a password policy but where JIM holds none: a schema
    /// refresh away from being checkable, and therefore the administrator's to act on.
    /// <para>
    /// Refresh rather than retrieve, deliberately. The Schema tab offers <b>Retrieve Schema</b> only before a
    /// system has one, and every system reachable from this dialog necessarily has a schema already, because
    /// its accounts were imported through it. <b>Refresh Schema</b> is therefore the button they will find.
    /// </para>
    /// </summary>
    private IReadOnlyList<MetaverseObjectAccount> SystemsAwaitingSchemaRefresh =>
        SelectedAccounts.Where(a => a.ConnectorCanDiscoverPasswordPolicy && a.DiscoveredPolicy is not { HasAnyDiscoveredConstraint: true }).ToList();

    /// <summary>
    /// Selected systems that publish no password rules for any client to read. Worth stating once, so an absent
    /// policy does not read as something left undone, but there is nothing here to fix.
    /// </summary>
    private IReadOnlyList<MetaverseObjectAccount> SystemsThatPublishNoPolicy =>
        SelectedAccounts.Where(a => !a.ConnectorCanDiscoverPasswordPolicy).ToList();

    private bool CanGenerate => SelectedAccounts.Count > 0 && _reconciliation is not { IsUsable: false };

    private bool CanCopy => _clipboardAvailable && _password.Length > 0;

    private bool CanSubmit => AnyAccountCanTakeAPassword && _password.Length > 0 && _stage == Stage.Composing
                              && SelectedAccounts.Count > 0 && _reconciliation is not { IsUsable: false };

    /// <summary>
    /// Whether a fresh password across every attempted account is offered: only once the change has settled with
    /// a refusal somewhere, and only where one password can still satisfy every system involved.
    /// </summary>
    private bool OfferAnotherPassword =>
        _stage == Stage.Finished
        && _targets.Any(t => t.State == PasswordChangeTargetState.Parked)
        && _reconciliation is not { IsUsable: false };

    private string CopyTooltip => _clipboardAvailable
        ? "Copy the password without showing it"
        : "Clipboard access needs an HTTPS connection";

    private string QueueHref => $"/admin/operations?t=passwords&metaverseObjectId={MetaverseObjectId}";

    private string SubmitLabel => SelectedAccounts.Count > 1 ? $"Set on {SelectedAccounts.Count} accounts" : "Set Password";

    private string TargetNoun => _targets.Count == 1 ? "1 Connected System" : $"{_targets.Count} Connected Systems";

    private string UnsettableSentence
    {
        get
        {
            var names = string.Join(", ", UnsettableAccounts.Select(a => a.ConnectedSystemName));
            return UnsettableAccounts.Count == 1
                ? $"{names} holds an account for this person, but its Connector cannot set passwords."
                : $"{names} hold accounts for this person, but their Connectors cannot set passwords.";
        }
    }

    private string PausedSentence
    {
        get
        {
            var names = string.Join(", ", _pausedSystemNames);
            return _pausedSystemNames.Count == 1
                ? $"{names} is not taking propagated passwords; this one is delivered there because you named the account."
                : $"{names} are not taking propagated passwords; this one is delivered there because you named the accounts.";
        }
    }

    /// <summary>
    /// How loudly the outcome is reported. A refusal anywhere is an error, because the person now holds two
    /// different passwords and nothing will change that without somebody acting. A system JIM could not reach, or
    /// one still answering, is a warning: the password is kept and the job is unfinished rather than failed.
    /// </summary>
    private Severity SummarySeverity
    {
        get
        {
            if (_targets.Any(t => PasswordChangeTargetDisplay.IsFailure(t.State) || t.State == PasswordChangeTargetState.Cancelled))
                return Severity.Error;
            return _targets.All(t => t.State == PasswordChangeTargetState.Set) ? Severity.Success : Severity.Warning;
        }
    }

    private string SummarySentence
    {
        get
        {
            var total = _targets.Count;
            var set = _targets.Count(t => t.State == PasswordChangeTargetState.Set);
            if (set == total)
                return total == 1 ? "Password set." : $"Password set on all {total} accounts.";

            var parts = new List<string>();
            if (set > 0)
                parts.Add($"Set on {set} of {total} accounts.");

            // Names the consequence rather than the count: which accounts still hold their old password is what
            // decides what the administrator does next, and what they have to tell the person waiting.
            var refused = Names(t => t.State == PasswordChangeTargetState.Parked);
            if (refused != null)
                parts.Add(set == 0 && total == 1
                    ? $"The password was not set. {refused} refused it."
                    : $"The password in {refused} is unchanged, so this person now has a different one there.");

            var expired = Names(t => t.State == PasswordChangeTargetState.Expired);
            if (expired != null)
                parts.Add($"The change for {expired} expired before it could be delivered.");

            var cancelled = Names(t => t.State == PasswordChangeTargetState.Cancelled);
            if (cancelled != null)
                parts.Add($"Delivery to {cancelled} was stopped, so the password there is unchanged.");

            var retrying = _targets.Where(t => t.State == PasswordChangeTargetState.Retrying).ToList();
            if (retrying.Count > 0)
            {
                var names = string.Join(", ", retrying.Select(t => t.ConnectedSystemName));
                var next = retrying.Select(t => t.NextAttemptAt).Where(n => n.HasValue).Select(n => n!.Value).DefaultIfEmpty().Min();
                var when = next == default ? "shortly" : $"in {DescribeWait(next - DateTime.UtcNow)}";
                parts.Add($"{names} could not be reached, so JIM has kept the password and will try again {when}, " +
                          "then with a longer wait each time, until it is delivered or the change expires.");
            }

            var inFlight = Names(t => PasswordChangeTargetDisplay.IsInFlight(t.State));
            if (inFlight != null)
                parts.Add($"{inFlight} {(inFlight.Contains(',') ? "have" : "has")} not answered yet; delivery carries on without this dialog.");

            var held = Names(t => t.State == PasswordChangeTargetState.Held);
            if (held != null)
                parts.Add($"{held} will take it once Password Synchronisation is switched on there.");

            return string.Join(" ", parts);

            string? Names(Func<PasswordChangeTargetOutcome, bool> where)
            {
                var names = _targets.Where(where).Select(t => t.ConnectedSystemName).ToList();
                return names.Count == 0 ? null : string.Join(", ", names);
            }
        }
    }

    /// <summary>
    /// A wait in round words for the summary ("5 minutes", "about an hour"), never negative: a next attempt that is
    /// already due reads as "a moment".
    /// </summary>
    private static string DescribeWait(TimeSpan wait)
    {
        if (wait < TimeSpan.FromSeconds(30))
            return "a moment";
        if (wait < TimeSpan.FromMinutes(1.5))
            return "about a minute";
        if (wait < TimeSpan.FromHours(1))
            return $"{Math.Round(wait.TotalMinutes)} minutes";
        if (wait < TimeSpan.FromHours(1.5))
            return "about an hour";
        if (wait < TimeSpan.FromDays(1))
            return $"about {Math.Round(wait.TotalHours)} hours";
        return $"about {Math.Round(wait.TotalDays)} days";
    }

    protected override void OnInitialized()
    {
        // With no choice to make, the one account is the selection. Nothing is preselected where there is a
        // choice: somebody resetting a forgotten password in one system must not silently reset the others.
        if (!AllowSelection)
            foreach (var account in SettableAccounts)
                _selected.Add(account.ConnectedSystemObjectId);

        RefreshReconciliation();
        AlignExpiryBehaviour();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _clipboardAvailable = await JsRuntime.InvokeAsync<bool>("jimInterop.isClipboardAvailable");
            StateHasChanged();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException)
        {
            // The circuit went away, or JS is not ready. Copying stays offered; the attempt itself reports
            // failure honestly, which is a better outcome than hiding the button over a transient condition.
        }
    }

    private void ToggleAccount(MetaverseObjectAccount account, bool selected)
    {
        if (selected)
            _selected.Add(account.ConnectedSystemObjectId);
        else
            _selected.Remove(account.ConnectedSystemObjectId);

        RefreshReconciliation();
        AlignExpiryBehaviour();
    }

    private void SelectAll()
    {
        foreach (var account in SettableAccounts)
            _selected.Add(account.ConnectedSystemObjectId);

        RefreshReconciliation();
        AlignExpiryBehaviour();
    }

    /// <summary>
    /// Re-derives the generator settings whenever the selection changes, so what Generate would produce always
    /// matches the systems currently ticked rather than the ones ticked when it was last pressed.
    /// </summary>
    private void RefreshReconciliation()
    {
        _reconciliation = SelectedAccounts.Count == 0 ? null : Reconcile(SelectedAccounts);
    }

    /// <summary>
    /// Keeps the expiry choice to something every selected Connector can apply. Narrowing the selection can
    /// take the current choice away, and leaving it selected would submit a behaviour part of the fan-out
    /// silently downgrades.
    /// </summary>
    private void AlignExpiryBehaviour()
    {
        var available = AvailableExpiryBehaviours;
        if (available.Count > 0 && !available.Contains(_expiryBehaviour))
            _expiryBehaviour = available[0];
    }

    private void GenerateForSelection()
    {
        if (_reconciliation == null)
            return;

        _password = GeneratePassword(_reconciliation.Policy);
        _failure = null;

        // Generated masked, always. The administrator asked for a password, not to look at one.
        CancelRevealTimeout();
        _revealed = false;
    }

    private async Task CopyAsync()
    {
        var copied = await TryInvokeAsync<bool>("jimInterop.copyToClipboard", _password);
        if (copied)
            Snackbar.Add("Password copied to the clipboard.", Severity.Success);
        else
            Snackbar.Add("The password could not be copied. Reveal it and copy it by hand.", Severity.Warning);
    }

    /// <summary>
    /// Shows the password, and starts the clock that hides it again. Hiding early cancels that clock, so a
    /// second reveal always gets a full interval rather than inheriting the remains of the first.
    /// </summary>
    private async Task ToggleRevealAsync()
    {
        CancelRevealTimeout();
        _revealed = !_revealed;

        if (!_revealed)
            return;

        var timeout = new CancellationTokenSource();
        _revealTimeout = timeout;

        try
        {
            await Task.Delay(RevealDuration, timeout.Token);
            _revealed = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // Hidden by hand, revealed again, or the dialog closed. Nothing to do; whoever cancelled has
            // already set the state they wanted.
        }
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
            return;

        await QueueAsync(SelectedAccounts);
    }

    /// <summary>
    /// Generates a fresh password and sets it on <b>every</b> account this change touched, including the ones
    /// that already took the first one.
    /// <para>
    /// The only answer that serves the point of setting one password. Re-sending a value the target refused
    /// fails identically; replacing it only where it failed leaves the person with two different passwords. The
    /// queue holds one change per person per system, so the new value simply supersedes whatever is still owed.
    /// </para>
    /// </summary>
    private async Task TryAnotherPasswordAsync()
    {
        if (_acting || _stage != Stage.Finished)
            return;

        var accounts = _attempted.ToList();
        _reconciliation = Reconcile(accounts);
        if (_reconciliation is { IsUsable: false })
            return;

        _password = GeneratePassword(_reconciliation.Policy);
        CancelRevealTimeout();
        _revealed = false;

        await QueueAsync(accounts);
    }

    /// <summary>
    /// Queues the password for <paramref name="accounts"/> and then follows the change until every target
    /// settles or <see cref="DeliveryWait"/> runs out.
    /// </summary>
    private async Task QueueAsync(IReadOnlyList<MetaverseObjectAccount> accounts)
    {
        if (accounts.Count == 0)
            return;

        // A second change abandons the follow of the first; its rows are replaced by the new change's.
        _followCancellation.Cancel();
        _followCancellation.Dispose();
        _followCancellation = new CancellationTokenSource();

        _stage = Stage.Queueing;
        _failure = null;
        _waitRanOut = false;
        _attempted.Clear();
        _attempted.AddRange(accounts);

        PasswordQueueResult result;
        try
        {
            result = await SetPassword(new PasswordSetSubmission(
                accounts.Select(a => a.ConnectedSystemObjectId).ToList(),
                _password,
                _expiryBehaviour,
                // Null, not false: leaving an account's enabled state alone is the right default for a reset on
                // an account that is already in the state the administrator wants.
                _enableAccount ? true : null));
        }
        catch (ArgumentException ex)
        {
            // JIM refused the request before recording anything (an account that is not this person's, two
            // accounts in one system). The words are written for an administrator; show them and let them
            // change the selection.
            _failure = ex.Message;
            _stage = Stage.Composing;
            return;
        }

        _queued = true;

        // The rows start from what was queued, so the stage is never empty while the first read is in flight. A
        // named account is delivered whether or not its system takes propagated passwords (decision D1), so every
        // row starts Queued; the systems that are paused for propagation are named in a sentence beneath.
        _targets = result.Targets
            .OrderBy(t => t.ConnectedSystemName, StringComparer.OrdinalIgnoreCase)
            .Select(t => new PasswordChangeTargetOutcome
            {
                ConnectedSystemId = t.ConnectedSystemId,
                ConnectedSystemName = t.ConnectedSystemName,
                State = PasswordChangeTargetState.Queued
            })
            .ToList();
        _pausedSystemNames = result.Targets.Where(t => !t.Enabled).Select(t => t.ConnectedSystemName).OrderBy(n => n, StringComparer.OrdinalIgnoreCase).ToList();
        _stage = Stage.Delivering;
        StateHasChanged();

        await FollowDeliveryAsync(result.ActivityId, _followCancellation.Token);
    }

    /// <summary>
    /// Follows the change in one-second slices until every target settles or <see cref="DeliveryWait"/> runs out,
    /// re-rendering after each slice so the rows move as their systems answer. Closing the dialog cancels it.
    /// </summary>
    private async Task FollowDeliveryAsync(Guid activityId, CancellationToken token)
    {
        var deadline = DateTime.UtcNow + DeliveryWait;

        try
        {
            while (!token.IsCancellationRequested)
            {
                var remaining = deadline - DateTime.UtcNow;
                if (remaining <= TimeSpan.Zero)
                {
                    _waitRanOut = _targets.Any(t => PasswordChangeTargetDisplay.IsInFlight(t.State));
                    break;
                }

                var slice = remaining < FollowSlice ? remaining : FollowSlice;
                var sliceStarted = DateTime.UtcNow;
                var outcomes = await OutcomeWaiter.WaitForOutcomesAsync(activityId, slice, token);
                if (outcomes != null)
                    _targets = outcomes.Targets;

                if (outcomes?.IsSettled == true)
                    break;

                StateHasChanged();

                // The waiter only answers early when the change has settled, so this is idle in practice; it is
                // here so that nothing answering faster than its slice can turn this loop into a busy one.
                var unused = slice - (DateTime.UtcNow - sliceStarted);
                if (unused > TimeSpan.Zero)
                    await Task.Delay(unused, token);
            }
        }
        catch (OperationCanceledException)
        {
            // The dialog was closed mid-wait, or a second change replaced this one; delivery carries on regardless.
            return;
        }

        _stage = Stage.Finished;
        StateHasChanged();
    }

    /// <summary>
    /// Stops JIM retrying on one Connected System, then re-reads the change so the row reads Cancelled rather than
    /// waiting for a slice that is no longer running.
    /// </summary>
    private async Task StopTryingAsync(int connectedSystemId)
    {
        if (_acting)
            return;

        _acting = true;
        try
        {
            await StopTrying(connectedSystemId);
            _targets = _targets
                .Select(t => t.ConnectedSystemId == connectedSystemId
                    ? new PasswordChangeTargetOutcome
                    {
                        ConnectedSystemId = t.ConnectedSystemId,
                        ConnectedSystemName = t.ConnectedSystemName,
                        State = PasswordChangeTargetState.Cancelled,
                        Message = t.Message,
                        OccurredAt = t.OccurredAt,
                        AttemptCount = t.AttemptCount
                    }
                    : t)
                .ToList();
        }
        finally
        {
            _acting = false;
        }
    }

    /// <summary>
    /// The sentence under a target's name. Set says what was asked of the password beyond setting it, because
    /// that is the fact the administrator has to pass on ("you will be asked to change it"); everything else is
    /// the shared wording.
    /// </summary>
    private string DescribeTarget(PasswordChangeTargetOutcome target)
    {
        if (target.State != PasswordChangeTargetState.Set)
            return PasswordChangeTargetDisplay.Words(target);

        return _expiryBehaviour switch
        {
            PasswordExpiryBehaviour.RequireChangeAtNextSignIn => "Password set; must be changed at next sign-in",
            PasswordExpiryBehaviour.NeverExpires => "Password set; never expires",
            PasswordExpiryBehaviour.ExpiresAccordingToTargetPolicy => "Password set; ages according to the system's own policy",
            _ => "Password set"
        };
    }

    private async Task CloseAsync()
    {
        await ClearClipboardAsync();
        MudDialog.Close(DialogResult.Ok(_queued));
    }

    /// <summary>
    /// Best effort, and deliberately not reported. It can fail for reasons that are nobody's fault (the browser
    /// requires transient user activation to write to the clipboard), and it cannot touch the operating
    /// system's clipboard history either way, so a failure notice would be alarming without being actionable.
    /// The dialog says plainly that the history may retain the value instead.
    /// </summary>
    private async Task ClearClipboardAsync()
    {
        CancelRevealTimeout();
        await TryInvokeAsync<bool>("jimInterop.clearClipboard");
    }

    private async Task<T?> TryInvokeAsync<T>(string identifier, params object?[] args)
    {
        try
        {
            return await JsRuntime.InvokeAsync<T>(identifier, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException)
        {
            return default;
        }
    }

    /// <summary>
    /// Cancels the reveal timer and the delivery follow, so a dialog torn down while either is running does not
    /// leave a delay running against a disposed component.
    /// </summary>
    public void Dispose()
    {
        CancelRevealTimeout();
        _followCancellation.Cancel();
        _followCancellation.Dispose();
    }

    private void CancelRevealTimeout()
    {
        _revealTimeout?.Cancel();
        _revealTimeout?.Dispose();
        _revealTimeout = null;
    }

    private static string DescribeExpiryBehaviour(PasswordExpiryBehaviour behaviour) => behaviour switch
    {
        PasswordExpiryBehaviour.RequireChangeAtNextSignIn => "Require a change at the next sign-in",
        PasswordExpiryBehaviour.ExpiresAccordingToTargetPolicy => "Age according to the Connected System's own policy",
        PasswordExpiryBehaviour.NeverExpires => "Never expires",
        _ => behaviour.ToString()
    };
}
