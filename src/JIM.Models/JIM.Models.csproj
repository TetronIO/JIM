<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
      <!-- Publish the XML comments so the OpenAPI document describes the DTOs defined here (#1083). Missing
         comments are not warned about: not every public member is part of the API. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Tasking\" />
  </ItemGroup>

  <ItemGroup>
    <!-- FeatureFlagCatalogue.SubstituteForTesting: lets tests exercise the feature-flag mechanism against synthetic
         flags while the real catalogue is empty. Reached through JIM.TestSupport.FeatureFlagCatalogueScope. -->
    <InternalsVisibleTo Include="JIM.TestSupport" />
  </ItemGroup>
</Project>
