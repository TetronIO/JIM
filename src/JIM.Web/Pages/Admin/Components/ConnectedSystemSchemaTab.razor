@* How the tab opens depends on whether there is a schema. Without one, the only thing to say is how to start,
   and that is a call to action, so it stays an alert with the button in it. With one, a status line at the end of
   the Object Type tab strip says what the schema holds and offers a refresh (a panel of its own cost a row for one
   line); what a refresh does is said in the info button, and again on the refresh preview, which is where "before
   anything is applied" is actually true. It used to be an amber band on every visit, which is the page-description
   anti-pattern JIM.Web/CLAUDE.md describes. *@
@if (ConnectedSystem.ObjectTypes == null || ConnectedSystem.ObjectTypes.Count == 0)
{
    <MudAlert Severity="Severity.Info" data-testid="jim-schema-retrieve">
        <MudText>@SchemaText.RetrieveSchemaIntro</MudText>
        <AlertButton Severity="Severity.Info"
                     Disabled="@(_schemaBeingRetrieved || _schemaRefreshPreview != null)"
                     OnClick="HandleImportSchemaAsync"
                     Class="mt-5">
            @if (_schemaBeingRetrieved)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">@SchemaText.RetrievingSchema</span>
            }
            else
            {
                <text>@SchemaText.RetrieveSchema</text>
            }
        </AlertButton>
    </MudAlert>
}

@if (_schemaRefreshResult != null)
{
    var result = _schemaRefreshResult;
    <MudAlert Severity="@(result.Success ? (result.HasChanges ? Severity.Info : Severity.Success) : Severity.Error)"
              Icon="@(result.Success ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
              Class="mb-5 jim-alert-schema-refresh"
              ShowCloseIcon="true"
              CloseIconClicked="HandleCloseSchemaRefreshResult">
        <MudText Typo="Typo.subtitle1" Class="mb-2">
            <strong>@(result.Success ? SchemaText.RefreshCompleteTitle : SchemaText.RefreshFailedTitle)</strong>
        </MudText>

        @if (result.Success)
        {
            <MudText Class="mb-2">
                @((MarkupString)string.Format(CultureInfo.CurrentCulture, SchemaText.FoundSummary,
                    string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(result.TotalObjectTypes, SchemaText.ObjectTypeCountOne, SchemaText.ObjectTypeCountOther), result.TotalObjectTypes.ToString("N0", CultureInfo.CurrentCulture)),
                    string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(result.TotalAttributes, SchemaText.AttributeCountOne, SchemaText.AttributeCountOther), result.TotalAttributes.ToString("N0", CultureInfo.CurrentCulture))))
            </MudText>

            @if (result.AttributesSelectedByConnector.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2 mb-2">
                    <strong>@SchemaText.SelectedByConnector</strong>
                    @(string.Join(", ", result.AttributesSelectedByConnector.SelectMany(kvp => kvp.Value).Distinct())).
                    @SchemaText.SelectedByConnectorExplain
                </MudAlert>
            }

            @if (result.BlockedCredentialAttributeCount > 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2 mb-2">
                    <strong>@string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(result.BlockedCredentialAttributeCount, SchemaText.CredentialAttributesBlockedOne, SchemaText.CredentialAttributesBlockedOther), result.BlockedCredentialAttributeCount)</strong>
                    @(string.Join(", ", result.BlockedCredentialAttributes.SelectMany(kvp => kvp.Value).Distinct())).
                    @SchemaText.CredentialAttributesExplain
                </MudAlert>
            }

            @if (result.DiscoveryWarnings.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Class="mt-2 mb-2">
                    <strong>@SchemaText.DiscoveryWarningsLabel</strong> @SchemaText.DiscoveryWarningsText
                    <ul class="mt-1 mb-0">
                        @foreach (var warning in result.DiscoveryWarnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </MudAlert>
            }

            @if (!result.HasChanges)
            {
                <MudText Color="Color.Success">@SchemaText.NoChangesDetected</MudText>
            }
            else
            {
                <SchemaChangeTable Result="result" />

                @if (result.ActionRequired)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-3">
                        <strong>@SchemaText.ActionRequiredLabel</strong>
                        @SchemaText.ActionRequiredText
                    </MudAlert>
                }
            }
        }
        else
        {
            <MudText Color="Color.Error">@result.ErrorMessage</MudText>
        }
    </MudAlert>
}

@if (_schemaRefreshPreview != null)
{
    <SchemaRefreshPreviewPanel Result="_schemaRefreshPreview"
                               Dependents="_schemaRefreshDependents"
                               RemovalImpact="_schemaRefreshRemovalImpact"
                               Busy="_schemaRefreshApplying"
                               OnApply="HandleApplySchemaRefreshAsync"
                               OnApplyWithDisables="HandleApplySchemaRefreshWithDisablesAsync"
                               OnApplyWithRemovals="HandleApplySchemaRefreshWithRemovalsAsync"
                               OnDiscard="HandleDiscardSchemaRefresh" />
}

<MudDialog @bind-Visible="_editSchemaAttributeDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" /> @SchemaText.EditSchemaAttributeTitle @_objectTypeAttributeBeingEdited?.Name
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (ConnectedSystem.ConnectorDefinition.SupportsUserSelectedAttributeTypes)
        {
            @if (!_objectTypeAttributeBeingEditedIsEditable)
            {
                <MudAlert Severity="Severity.Error">
                    @(SupportsPlurality ? SchemaText.DataTypeLockedPlural : SchemaText.DataTypeLocked)
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Info">
                    @SchemaText.DataTypeChangeable
                    
                </MudAlert>
            }

            <MudSelect
                T="string"
                Label="@SchemaText.ChooseDataType"
                Required="true"
                Variant="Variant.Outlined"
                Class="mt-5"
                Disabled="!_objectTypeAttributeBeingEditedIsEditable"
                ToStringFunc="@(name => EnumDisplay.NameForDisplay<AttributeDataType>(name))"
                @bind-Value="_objectTypeAttributeBeingEditedText">
                @foreach (var type in Enum.GetValues<AttributeDataType>())
                {
                    if (type != AttributeDataType.NotSet)
                    {
                        <MudSelectItem Value="@type.ToString()">@type.ForDisplay()</MudSelectItem>
                    }
                }
            </MudSelect>
        }

        @* ─── Plurality, where the Connector cannot read it from the schema (#2186) ─── *@
        @if (SupportsPlurality)
        {
            var booleanChosen = !AttributeDataTypeCapabilities.SupportsMultiValued(EditedAttributeType());
            <div class="mt-5" data-testid="jim-schema-attribute-plurality">
                <MudSelect T="AttributePlurality"
                           Label="@SchemaText.ValuesPerObject"
                           Variant="Variant.Outlined"
                           Disabled="@(!_objectTypeAttributeBeingEditedIsEditable || booleanChosen)"
                           @bind-Value="_objectTypeAttributeBeingEditedPlurality">
                    <MudSelectItem Value="@AttributePlurality.SingleValued">@SchemaText.SingleValued</MudSelectItem>
                    <MudSelectItem Value="@AttributePlurality.MultiValued">@SchemaText.MultiValued</MudSelectItem>
                </MudSelect>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                    @if (booleanChosen)
                    {
                        @AttributeDataTypeCapabilities.MultiValuedBooleanRule
                    }
                    else
                    {
                        <span>@((MarkupString)string.Format(CultureInfo.CurrentCulture, SchemaText.MultiValuedColumnHelp, "<code>CN=Alice|CN=Bob</code>"))</span>
                        @(_objectTypeAttributeBeingEdited?.PluralitySetByAdministrator == true
                            ? " " + SchemaText.SetByAdministrator
                            : " " + SchemaText.CurrentlyDiscoveredFromFile)
                    }
                </MudText>
            </div>
        }

        @* ─── Case-exact declaration (#2051) ─── *@
        @if (SchemaAttributeEdit.OffersCaseExact(EditedAttributeType()))
        {
            <div class="@(ConnectedSystem.ConnectorDefinition.SupportsUserSelectedAttributeTypes ? "mt-5" : string.Empty)" data-testid="jim-schema-attribute-case-exact">
                <MudCheckBox T="bool" @bind-Value="_objectTypeAttributeBeingEditedCaseExact" Color="Color.Primary" Label="@SchemaText.ValuesCaseExact" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary ml-3">
                    @((MarkupString)string.Format(CultureInfo.CurrentCulture, SchemaText.CaseExactHelp, "<code>JBloggs</code>", "<code>jbloggs</code>"))
                    
                    @(_objectTypeAttributeBeingEdited?.CaseExactSetByAdministrator == true
                        ? SchemaText.SetByAdministrator
                        : SchemaText.CurrentlyDiscoveredFromSchema)
                </MudText>
            </div>
        }

        @* ─── Date and time resolution (#2153) ─── *@
        @if (SchemaAttributeEdit.OffersDateTimeResolution(EditedAttributeType()))
        {
            <div class="@(ConnectedSystem.ConnectorDefinition.SupportsUserSelectedAttributeTypes ? "mt-5" : string.Empty)" data-testid="jim-schema-attribute-date-time-resolution">
                <MudSelect T="DateTimeResolution" Label="@SchemaText.DatesHeldTo" Variant="Variant.Outlined" @bind-Value="_objectTypeAttributeBeingEditedResolution">
                    @foreach (var resolution in Enum.GetValues<DateTimeResolution>())
                    {
                        <MudSelectItem Value="@resolution">@SchemaAttributeEdit.Describe(resolution)</MudSelectItem>
                    }
                </MudSelect>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                    @SchemaText.ResolutionHelp
                    
                    @(_objectTypeAttributeBeingEdited?.DateTimeResolutionSetByAdministrator == true
                        ? SchemaText.SetByAdministrator
                        : SchemaText.CurrentlyDiscoveredFromSchema)
                </MudText>
            </div>
        }

    </DialogContent>
    <DialogActions>
        <MudButton
            DropShadow="false"
            Variant="Variant.Text"
            OnClick="@(() => _editSchemaAttributeDialogVisible = false)"
            Class="ma-4">@CommonText.Cancel</MudButton>
        <MudButton
            Disabled="!CanConfirmAttributeEdit()"
            DropShadow="false"
            Variant="Variant.Filled"
            Color="Color.Primary"
            OnClick="HandleEditAttributeButtonClickAsync"
            Class="ma-4">@SchemaText.ConfirmChange</MudButton>
    </DialogActions>
</MudDialog>

@if (ConnectedSystem.ObjectTypes is { Count: > 0 })
{
    var selectedObjectTypes = GetSelectedObjectTypes();
    <div class="schema-tabs">
        <MudTabs Elevation="0"
                 Rounded="true"
                 Outlined="true"
                 Border="true"
                 ApplyEffectsToContainer="true"
                 TabPanelsClass="pa-4"
                 ActivePanelIndex="_activeSchemaTabIndex"
                 ActivePanelIndexChanged="OnSchemaTabChanged"
                 HeaderPosition="TabHeaderPosition.After">
            @* The schema status sits after the tabs rather than in a panel above them. MudTabs keeps the header
               outside the scrolling tab area, so Refresh Schema stays in view however many types are selected. *@
            <Header Context="tabs">
                <div class="schema-status d-flex align-center gap-2 px-3" data-testid="jim-schema-status">
                    @* The same count the Object Types tab's "All" chip shows, so the two never disagree: internal
                       types the Connector classified are held back from both until the administrator asks to see them. *@
                    <MudText Typo="Typo.body2" Class="mud-text-secondary text-no-wrap">
                        @string.Format(CultureInfo.CurrentCulture, SchemaText.ObjectTypesAndSelected, GetVisibleObjectTypes().Count().ToString("N0", CultureInfo.CurrentCulture), GetSelectedObjectTypes().Count.ToString("N0", CultureInfo.CurrentCulture))
                    </MudText>
                    <InfoPopover Title="@SchemaText.SchemaInfoTitle">
                        @SchemaText.SchemaInfoBody
                        
                        
                        
                        
                    </InfoPopover>
                    <MudButton
                               Variant="Variant.Filled"
                               Size="Size.Small"
                               Class="text-no-wrap"
                               Disabled="@(_schemaBeingRetrieved || _schemaRefreshPreview != null)"
                               OnClick="HandleImportSchemaAsync"
                               DropShadow="false">
                        @if (_schemaBeingRetrieved)
                        {
                            <MudProgressCircular Class="ms-n1" Indeterminate="true" Size="Size.Small" />
                            <span class="ms-2">@SchemaText.RefreshingSchema</span>
                        }
                        else
                        {
                            <text>@SchemaText.RefreshSchema</text>
                        }
                    </MudButton>
                </div>
            </Header>
            <ChildContent>

            @* ─── Object type discovery & selection ─── *@
            <MudTabPanel Icon="@Icons.Material.Filled.Tune" Text="@SchemaText.ObjectTypesTab">
                @{
                    var visibleObjectTypeCount = GetVisibleObjectTypes().Count();
                    var hiddenInternalCount = GetHiddenInternalObjectTypeCount();
                }
                <MudText Typo="Typo.subtitle1" Class="mb-1">@SchemaText.ChooseObjectTypes</MudText>
                <MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
                    @SchemaText.ChooseObjectTypesHelp
                </MudText>

                <MudGrid>
                    <MudItem xs="12" md="8">
                        <SearchField @bind-Value="_objectTypeSearchString"
                                     Label="@SchemaText.SearchObjectTypes"
                                     HelperText="@SchemaText.SearchObjectTypesHelp"
                                     IconSize="Size.Small"
                                     Margin="Margin.None" />
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex align-center justify-md-end">
                        <MudChipSet T="bool"
                                    SelectionMode="SelectionMode.SingleSelection"
                                    SelectedValue="_objectTypeSelectedFilter"
                                    SelectedValueChanged="@((bool val) => _objectTypeSelectedFilter = val)">
                            <MudChip Value="false"
                                     Color="Color.Default"
                                     Variant="@(!_objectTypeSelectedFilter ? Variant.Filled : Variant.Outlined)">
                                @string.Format(CultureInfo.CurrentCulture, SchemaText.ChipAll, visibleObjectTypeCount)
                            </MudChip>
                            <MudChip Value="true"
                                     Color="Color.Primary"
                                     Variant="@(_objectTypeSelectedFilter ? Variant.Filled : Variant.Outlined)">
                                @string.Format(CultureInfo.CurrentCulture, SchemaText.ChipSelected, selectedObjectTypes.Count)
                            </MudChip>
                        </MudChipSet>
                    </MudItem>
                </MudGrid>

                @{
                    var discoveryObjectTypes = GetFilteredDiscoveryObjectTypes().ToList();
                }
                @if (discoveryObjectTypes.Count == 0)
                {
                    <MudText Class="mt-6 mb-2 mud-text-secondary" Align="Align.Center">@SchemaText.NoObjectTypesMatch</MudText>
                }
                else
                {
                    <MudGrid Spacing="2" Class="mt-2">
                        @foreach (var objectType in discoveryObjectTypes)
                        {
                            var selectedAttributeCount = objectType.Attributes.Count(a => a.Selected);
                            var totalAttributeCount = objectType.Attributes.Count;
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Outlined="true" Class="@(objectType.Selected ? "schema-type-card schema-type-card-selected" : "schema-type-card")">
                                    @* The whole card is the toggle target; the switch is presentational (read-only, no
                                       pointer events) so deselecting can be confirmed before anything actually changes. *@
                                    <div class="d-flex align-center pa-2 px-3" style="gap: 10px; cursor: pointer;"
                                         @onclick="@(() => HandleObjectTypeGridToggleAsync(objectType, !objectType.Selected))">
                                        <MudSwitch T="bool"
                                                   Value="@objectType.Selected"
                                                   Color="Color.Primary"
                                                   ReadOnly="true"
                                                   Style="pointer-events: none;" />
                                        <span class="flex-grow-1 text-truncate">@objectType.Name</span>
                                        <MudTooltip Text="@string.Format(CultureInfo.CurrentCulture, SchemaText.AttributesSelectedOf, selectedAttributeCount, totalAttributeCount)" Arrow="true" Placement="Placement.Top">
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@selectedAttributeCount / @totalAttributeCount</MudText>
                                        </MudTooltip>
                                    </div>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                    <MudText Typo="Typo.body1" Class="mt-4 mud-text-secondary d-block" Align="Align.Center">
                        @string.Format(CultureInfo.CurrentCulture, SchemaText.ShowingObjectTypes, discoveryObjectTypes.Count, visibleObjectTypeCount)
                    </MudText>
                }

                @* Internal object types are hidden rather than discarded, so the count and the way back are stated
                   plainly. Nothing here changes what was discovered or what is stored. *@
                @if (hiddenInternalCount > 0)
                {
                    <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-4">
                        <div class="d-flex align-center flex-wrap" style="gap: 8px;">
                            <span class="flex-grow-1">
                                @string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(hiddenInternalCount, SchemaText.InternalTypesHiddenOne, SchemaText.InternalTypesHiddenOther), hiddenInternalCount)
                                @SchemaText.InternalTypesExplain
                            </span>
                            <AlertButton Severity="Severity.Normal"
                                         StartIcon="@Icons.Material.Filled.Visibility"
                                         OnClick="@(() => _showInternalObjectTypes = true)">
                                @SchemaText.ShowInternalTypes
                            </AlertButton>
                        </div>
                    </MudAlert>
                }
                else if (_showInternalObjectTypes && AnyInternalObjectTypes())
                {
                    <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-4">
                        <div class="d-flex align-center flex-wrap" style="gap: 8px;">
                            <span class="flex-grow-1">@SchemaText.InternalTypesShown</span>
                            <AlertButton Severity="Severity.Normal"
                                         StartIcon="@Icons.Material.Filled.VisibilityOff"
                                         OnClick="@(() => _showInternalObjectTypes = false)">
                                @SchemaText.HideInternalTypes
                            </AlertButton>
                        </div>
                    </MudAlert>
                }
            </MudTabPanel>

            @* ─── One tab per selected object type ─── *@
            @foreach (var objectType in selectedObjectTypes)
            {
                <MudTabPanel Text="@objectType.Name">
                    @if (_selectedObjectType != null)
                    {
        @* Captured inside the guard so the markup below never dereferences the nullable field directly (see the
           nullable-dereference rule in JIM.Web/CLAUDE.md). *@
        var selectedObjectType = _selectedObjectType;

        @* Panel order follows how often each is visited: what the Object Type is made of (one line), then the
           attribute grid, which is what the tab exists for, then the settings, which are set once. Renders nothing
           unless the Connected System hands class membership to JIM to compute, which is what makes merging an
           auxiliary class mean anything. *@
        <AuxiliaryClassesPanel
            ConnectedSystem="ConnectedSystem"
            ObjectType="selectedObjectType"
            LatestDiscoveryRun="LatestAuxiliaryClassDiscoveryRun"
            OnSchemaChanged="OnConnectedSystemChanged" />

        <MudPaper Outlined="true" Class="pa-4 mt-5" data-testid="jim-schema-attribute-selection">
            <MudText Typo="Typo.h6" Class="mb-3">@SchemaText.AttributeSelection</MudText>
            <MudText>
                @SchemaText.AttributeSelectionHelp
            </MudText>

            @* Filtering by name is the grid's own search box, not a second one here: two boxes narrowing the same
               table is exactly the confusion the shared search convention exists to prevent. The grid's own
               negative top margin cancels its item padding; mt-0 replaces it so the fields sit one Spacing="4"
               step (16px) below the description, rather than stacking an extra margin on the full item padding. *@
            <MudGrid Spacing="4" Class="mt-0">
                @if (_selectedObjectTypeHasClasses)
                {
                    <MudItem xs="6">
                        <MudSelect
                            T="string"
                            Label="@SchemaText.FilterByClass"
                            MultiSelection="true"
                            @bind-SelectedValues="AttributeClassFilterSelectedValues"
                            @bind-SelectedValues:after="OnSchemaClassFilterChangedAsync"
                            Variant="Variant.Outlined"
                            HelperText="@SchemaText.FilterByClassHelp"
                            Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.FilterAlt"
                            IconSize="Size.Small">
                            @foreach (var className in _selectedObjectType.Attributes.Select(a => a.ClassName).OfType<string>().Distinct().OrderBy(a => a))
                            {
                                <MudSelectItem T="string" Value="@className">@className</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="@(_selectedObjectTypeHasClasses ? 6 : 12)">
                    <MudTextField
                        T="string"
                        Label="@SchemaText.SelectAttributesCsv"
                        @bind-Value="_attributeSelectionCsv"
                        HelperText="@SchemaText.SelectAttributesCsvHelp"
                        InputType="InputType.Text"
                        Adornment="Adornment.End"
                        AdornmentIcon="@Icons.Material.Filled.Check"
                        OnAdornmentClick="HandleAttributeCsvSubmitAsync"
                        IconSize="Size.Small"
                        Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="6" Class="mt-4 flex-wrap" AlignItems="AlignItems.Start">
                <div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@SchemaText.TypeFilterLabel</MudText>
                    <MudChipSet T="AttributeDataType"
                                SelectionMode="SelectionMode.MultiSelection"
                                SelectedValues="_selectedSchemaTypes"
                                SelectedValuesChanged="OnSchemaTypeFilterChangedAsync">
                        @foreach (var type in GetAvailableSchemaTypes())
                        {
                            <MudChip Value="@type.Key"
                                     Color="Color.Primary"
                                     Variant="@(_selectedSchemaTypes.Contains(type.Key) ? Variant.Filled : Variant.Outlined)">
                                @DataTypeLabel(type.Key) (@type.Value)
                            </MudChip>
                        }
                    </MudChipSet>
                </div>

                <div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@SchemaText.PluralityFilterLabel</MudText>
                    <MudChipSet T="AttributePlurality"
                                SelectionMode="SelectionMode.MultiSelection"
                                SelectedValues="_selectedSchemaPluralites"
                                SelectedValuesChanged="OnSchemaPluralityFilterChangedAsync">
                        @foreach (var plurality in GetAvailableSchemaPluralites())
                        {
                            <MudChip Value="@plurality.Key"
                                     Color="Color.Info"
                                     Variant="@(_selectedSchemaPluralites.Contains(plurality.Key) ? Variant.Filled : Variant.Outlined)">
                                @(plurality.Key == AttributePlurality.SingleValued ? SchemaText.SingleValued : SchemaText.MultiValued) (@plurality.Value)
                            </MudChip>
                        }
                    </MudChipSet>
                </div>

                @if (_selectedObjectTypeHasConstrainedAttributes)
                {
                    <div>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@SchemaText.WritabilityFilterLabel</MudText>
                        <MudChipSet T="AttributeWritability"
                                    SelectionMode="SelectionMode.MultiSelection"
                                    SelectedValues="_selectedSchemaWritabilities"
                                    SelectedValuesChanged="OnSchemaWritabilityFilterChangedAsync">
                            @foreach (var writability in GetAvailableSchemaWritabilities())
                            {
                                <MudChip Value="@writability.Key"
                                         Color="@Helpers.GetAttributeWritabilityChipColour(writability.Key)"
                                         Variant="@(_selectedSchemaWritabilities.Contains(writability.Key) ? Variant.Filled : Variant.Outlined)">
                                    @Helpers.GetAttributeWritabilityLabel(writability.Key) (@writability.Value)
                                </MudChip>
                            }
                        </MudChipSet>
                    </div>
                }

                @{
                    var selectionCounts = GetSchemaSelectionCounts();
                }
                <div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@SchemaText.SelectionFilterLabel</MudText>
                    <MudChipSet T="bool"
                                SelectionMode="SelectionMode.SingleSelection"
                                SelectedValue="_attributeSelectedFilter"
                                SelectedValueChanged="OnAttributeSelectedFilterChangedAsync">
                        <MudChip Value="false"
                                 Color="Color.Default"
                                 Variant="@(!_attributeSelectedFilter ? Variant.Filled : Variant.Outlined)">
                            @string.Format(CultureInfo.CurrentCulture, SchemaText.ChipAll, selectionCounts.allCount)
                        </MudChip>
                        <MudChip Value="true"
                                 Color="Color.Default"
                                 Variant="@(_attributeSelectedFilter ? Variant.Filled : Variant.Outlined)">
                            @string.Format(CultureInfo.CurrentCulture, SchemaText.ChipSelectedOnly, selectionCounts.selectedCount)
                        </MudChip>
                    </MudChipSet>
                </div>
            </MudStack>

            @* Operational attributes are held back rather than discarded, so the count and the way back are stated
               plainly, as internal object types are on the Object Types tab. A selected one is always listed. *@
            @{
                var hiddenOperationalCount = GetHiddenOperationalAttributeCount();
            }
            @if (hiddenOperationalCount > 0)
            {
                <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-4">
                    <div class="d-flex align-center flex-wrap" style="gap: 8px;">
                        <span class="flex-grow-1">
                            @string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(hiddenOperationalCount, SchemaText.OperationalAttributesHiddenOne, SchemaText.OperationalAttributesHiddenOther), hiddenOperationalCount)
                            @SchemaText.OperationalAttributesExplain
                        </span>
                        <AlertButton Severity="Severity.Normal"
                                     StartIcon="@Icons.Material.Filled.Visibility"
                                     OnClick="@(() => SetShowOperationalAttributesAsync(true))">
                            @SchemaText.ShowOperationalAttributes
                        </AlertButton>
                    </div>
                </MudAlert>
            }
            else if (_showOperationalAttributes && selectedObjectType.Attributes.Any(a => a.IsOperational))
            {
                <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-4">
                    <div class="d-flex align-center flex-wrap" style="gap: 8px;">
                        <span class="flex-grow-1">@SchemaText.OperationalAttributesShown</span>
                        <AlertButton Severity="Severity.Normal"
                                     StartIcon="@Icons.Material.Filled.VisibilityOff"
                                     OnClick="@(() => SetShowOperationalAttributesAsync(false))">
                            @SchemaText.HideOperationalAttributes
                        </AlertButton>
                    </div>
                </MudAlert>
            }
        </MudPaper>

        @* An Active Directory object type runs to several hundred attributes, which is what the infinite-scroll
           grid is for. The rows are the object type's own attribute objects, sliced in memory, so the selection
           switches still write straight through to what Save Changes persists. The chip filters above are the
           page's own, so changing one re-counts the match set (see RefreshAttributeGridAsync). *@
        <VirtualisedDataGrid @ref="_attributeGrid" T="ConnectedSystemObjectTypeAttribute"
                             ContainerId="@($"schema-attributes-{selectedObjectType.Id}")"
                             UrlParameterPrefix="@($"attr{selectedObjectType.Id}-")"
                             StateKey="@selectedObjectType.Id.ToString()"
                             DefaultSortBy="name"
                             LoadWindow="LoadAttributeWindowAsync"
                             SingularName="@SchemaText.AttributeSingular"
                             PluralName="@SchemaText.AttributePlural"
                             SearchPlaceholder="@SchemaText.SearchByName"
                             AlwaysDense="true">
            <Columns>
                <TemplateColumn Title="@SchemaText.ColumnSelected" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@SchemaText.ColumnSelected" Name="selected" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (CredentialAttributes.IsCredentialAttribute(context.Item.Name))
                        {
                            <MudTooltip Text="@SchemaText.CredentialAttributeTooltip" Arrow="true" Placement="Placement.Top">
                                <MudSwitch Value="false" Color="@Color.Primary" Size="Size.Small" Disabled="true" />
                            </MudTooltip>
                        }
                        else if (context.Item.IsExternalId || context.Item.IsSecondaryExternalId)
                        {
                            <MudTooltip Text="@SchemaText.ExternalIdUnselectable" Arrow="true" Placement="Placement.Top">
                                <MudSwitch Value="@context.Item.Selected" Color="@Color.Primary" Size="Size.Small" Disabled="true" />
                            </MudTooltip>
                        }
                        else if (context.Item.SelectionLocked && context.Item.Selected)
                        {
                            <MudTooltip Text="@SchemaText.ConnectorNeedsValuesUnselectable" Arrow="true" Placement="Placement.Top">
                                <MudSwitch Value="true" Color="@Color.Primary" Size="Size.Small" Disabled="true" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudSwitch @bind-Value="@context.Item.Selected" @bind-Value:after="OnAttributeSelectedChangedAsync" Color="@Color.Primary" Size="Size.Small" />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@SchemaText.ColumnExternalId" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@SchemaText.ColumnExternalId" Name="externalid" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.IsExternalId)
                        {
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Text">@SchemaText.ColumnExternalId</MudChip>
                        }
                        else if (context.Item.IsSecondaryExternalId)
                        {
                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Text">@SchemaText.SecondaryIdChip</MudChip>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@CommonText.ColumnName" Sortable="false" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@CommonText.ColumnName" Name="name" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.Name
                        <ConnectorDefinedChip Attribute="@context.Item" ConnectorName="@ConnectedSystem.ConnectorDefinition.Name" Class="ml-2" />
                    </CellTemplate>
                </TemplateColumn>
                @* Hidden rather than omitted, here and on Writability and Description below: MudDataGrid orders its
                   columns by the order they register with it, not by their position in this markup, so a column
                   whose condition only becomes true after the grid has rendered (each of these three is derived
                   from the selected Object Type's attributes, and the selection changes under the reader) would
                   register last and render at the far right, whatever the markup says. *@
                <TemplateColumn Title="@SchemaText.ColumnClass" Sortable="false" Hidden="@(!_selectedObjectTypeHasClasses)" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@SchemaText.ColumnClass" Name="class" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.IsOperational)
                        {
                            <MudTooltip Text="@SchemaText.OperationalTooltip" Arrow="true" Placement="Placement.Top">
                                <MudChip T="string" Color="Color.Default" Variant="Variant.Text">@SchemaText.OperationalChip</MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            @context.Item.ClassName
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@CommonText.ColumnType" Sortable="false" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@CommonText.ColumnType" Name="type" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @{
                            // The Object Type a Reference attribute declares as its target (#1285): resolved from the
                            // sibling list by id, so no navigation loading is relied upon.
                            var referencedObjectTypeName = context.Item.Type == AttributeDataType.Reference && context.Item.ReferencedObjectTypeId.HasValue
                                ? ConnectedSystem.ObjectTypes?.FirstOrDefault(ot => ot.Id == context.Item.ReferencedObjectTypeId.Value)?.Name
                                : null;
                        }
                        @if (referencedObjectTypeName != null)
                        {
                            <MudTooltip Text="@string.Format(CultureInfo.CurrentCulture, SchemaText.ReferenceTypeTooltip, referencedObjectTypeName)" Arrow="true" Placement="Placement.Top">
                                <MudChip T="string" Color="@Helpers.GetAttributeTypeChipColour(context.Item.Type)" Variant="Variant.Text">
                                    @string.Format(CultureInfo.CurrentCulture, SchemaText.ReferenceChip, referencedObjectTypeName)
                                </MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudChip T="string" Color="@Helpers.GetAttributeTypeChipColour(context.Item.Type)" Variant="Variant.Text">
                                @DataTypeLabel(context.Item.Type)
                            </MudChip>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@SchemaText.ColumnPlurality" Sortable="false" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@SchemaText.ColumnPlurality" Name="plurality" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudTooltip Text="@(context.Item.PluralitySetByAdministrator ? SchemaText.PluralitySetTooltip : SchemaText.PluralityDiscoveredTooltip)" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Color="@Helpers.GetAttributePluralityChipColour(context.Item.AttributePlurality)" Variant="Variant.Text">
                                @(context.Item.AttributePlurality == AttributePlurality.SingleValued ? SchemaText.SingleValued : SchemaText.MultiValued)
                            </MudChip>
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@SchemaText.ColumnCaseExact" Sortable="false" Hidden="@(!_selectedObjectTypeHasCaseExactAttributes)" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@SchemaText.ColumnCaseExact" Name="caseexact" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.CaseExact)
                        {
                            <MudTooltip Text="@(context.Item.CaseExactSetByAdministrator ? SchemaText.CaseExactTooltipSet : SchemaText.CaseExactTooltipDiscovered)" Arrow="true" Placement="Placement.Top">
                                <MudChip T="string" Color="Color.Warning" Variant="Variant.Text">@SchemaText.ColumnCaseExact</MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@SchemaText.ColumnDateResolution" Sortable="false" Hidden="@(!_selectedObjectTypeHasDateAttributes)" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@SchemaText.ColumnDateResolution" Name="dateresolution" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (SchemaAttributeEdit.OffersDateTimeResolution(context.Item.Type))
                        {
                            <MudTooltip Text="@(context.Item.DateTimeResolutionSetByAdministrator ? SchemaText.ResolutionTooltipSet : context.Item.DateTimeResolution.HasValue ? SchemaText.ResolutionTooltipDiscovered : SchemaText.ResolutionTooltipUndiscovered)" Arrow="true" Placement="Placement.Top">
                                <MudChip T="string" Variant="Variant.Text">@SchemaAttributeEdit.Describe(SchemaAttributeEdit.EffectiveDateTimeResolution(context.Item))</MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@SchemaText.ColumnWritability" Sortable="false" Hidden="@(!_selectedObjectTypeHasConstrainedAttributes)" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@SchemaText.ColumnWritability" Name="writability" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudTooltip Text="@Helpers.GetAttributeWritabilityDescription(context.Item.Writability)" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string"
                                     Color="@Helpers.GetAttributeWritabilityChipColour(context.Item.Writability)"
                                     Variant="Variant.Text">
                                @Helpers.GetAttributeWritabilityLabel(context.Item.Writability)
                            </MudChip>
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@CommonText.ColumnDescription" Sortable="false" Hidden="@(!_selectedObjectTypeHasDescriptions)" HeaderClass="jim-fill-column" CellClass="jim-fill-column">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@CommonText.ColumnDescription" Name="description" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @* Raw imported LDAP/SCIM text, so its length is the directory's business, not JIM's:
                           a row in a virtualised grid is one line, so it is clipped rather than wrapped, and
                           the whole description is on the cell's title. The class is used directly here
                           rather than through <OneLineText /> because the linkified RFC references are
                           markup. *@
                        @if (string.IsNullOrEmpty(context.Item.Description))
                        {
                            <EmptyValue />
                        }
                        else
                        {
                            var description = ConnectorSettingDisplay.AttributeDescription(ConnectedSystem.ConnectorDefinition.Name, _selectedObjectType?.Name, context.Item.Name, context.Item.Description)!;
                            <span class="jim-one-line" title="@description">@((MarkupString)Helpers.LinkifyRfcReferences(description))</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                @* Every Connector offers an edit now: the case-exact declaration applies to any Text attribute (#2051). *@
                <TemplateColumn Title="@SchemaText.ColumnAction" Sortable="false" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">@SchemaText.ColumnAction</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (SchemaAttributeEdit.CanEdit(context.Item, ConnectedSystem.ConnectorDefinition.SupportsUserSelectedAttributeTypes))
                        {
                            <MudButton
                                DropShadow="false"
                                Color="Color.Primary"
                                Variant="Variant.Text"
                                Size="Size.Small"
                                OnClick="() => HandleShowEditAttributeDialogAsync(context.Item)"
                                StartIcon="@Icons.Material.Filled.Edit">
                                @CommonText.Edit
                            </MudButton>
                        }
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@string.Format(CultureInfo.CurrentCulture, SchemaText.NoAttributesMatch, grid.SearchText)"
                                     SecondaryText="@SchemaText.TryDifferentSearch"
                                     ActionText="@CommonText.ClearSearch"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else if (_attributeSelectedFilter)
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                                     PrimaryText="@SchemaText.NoAttributesSelected"
                                     SecondaryText="@SchemaText.ChooseAllAbove" />
                }
                else if (AnySchemaFilterIsActive)
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                                     PrimaryText="@SchemaText.NoAttributesMatchFilters"
                                     SecondaryText="@SchemaText.ClearFilterToWiden" />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.ListAlt"
                                     PrimaryText="@SchemaText.NoAttributesDiscovered"
                                     SecondaryText="@SchemaText.RetrieveAgainOnceReported" />
                }
            </EmptyContent>
        </VirtualisedDataGrid>

        @if (ConnectedSystem.ConnectorDefinition.SupportsUserSelectedExternalId || ConnectedSystem.SupportsImportMode())
        {
            <MudPaper Outlined="true" Class="pa-4 mt-5" data-testid="jim-schema-object-type-settings">
                <MudText Typo="Typo.h6" Class="mb-3">@SchemaText.SettingsHeading</MudText>
                @if (ConnectedSystem.ConnectorDefinition.SupportsUserSelectedExternalId)
                {
                    <MudText>@SchemaText.ExternalIdSelectRequired</MudText>
                    <MudSelect
                        T="ConnectedSystemObjectTypeAttribute"
                        Label="@SchemaText.ExternalIdAttributeLabel"
                        Variant="Variant.Outlined"
                        Class="mt-3 mb-4"
                        Required="true"
                        RequiredError="@SchemaText.ExternalIdRequiredError"
                        Value="_selectedObjectType.Attributes.SingleOrDefault(q => q.IsExternalId)"
                        ValueChanged="HandleMakeExternalIdAsync">
                        @foreach (var objectTypeAttribute in _selectedObjectType.Attributes.Where(q => q.AttributePlurality == AttributePlurality.SingleValued))
                        {
                            <MudSelectItem Value="@objectTypeAttribute">@(objectTypeAttribute.Name)</MudSelectItem>
                        }
                    </MudSelect>
                }
                @if (ConnectedSystem.SupportsImportMode())
                {
                    <MudSwitch
                        @bind-Value="@_selectedObjectType.RemoveContributedAttributesOnObsoletion"
                        Color="@Color.Primary"
                        Label="@SchemaText.RemoveContributedLabel" />
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @SchemaText.RemoveContributedHelp
                    </MudText>
                }
            </MudPaper>
        }
                    }
                </MudTabPanel>
            }
            </ChildContent>
        </MudTabs>
    </div>

    <MudStack Row="true" Spacing="2" Class="mt-6">
        @* Preview (#1475): deselecting an Object Type obsoletes its objects on the next Full Import, well after the
           save (#1474), and deselecting an attribute has no visible effect at all. Either way this is the count an
           administrator needs before saving, not afterwards. *@
        <MudButton data-testid="jim-preview-schema-selection"
                   Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Visibility"
                   OnClick="PreviewSchemaSelectionAsync"
                   Disabled="@_startingSchemaPreview"
                   DropShadow="false">
            @SchemaText.PreviewChanges
        </MudButton>
        <MudButton
            Color="Color.Primary"
            Variant="Variant.Filled"
            OnClick="HandleObjectTypesAndAttributeSelectionSubmitAsync"
            DropShadow="false"
            Disabled="DisableSaveSchemaButton()">@CommonText.SaveChanges</MudButton>
    </MudStack>

    @if (_schemaPreviewActivityId.HasValue)
    {
        var schemaPreviewActivityId = _schemaPreviewActivityId.Value;

        @if (SchemaPreviewIsStale)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-6"
                      data-testid="jim-schema-preview-stale">
                @SchemaText.PreviewStale
                
            </MudAlert>
        }

        <ConfigurationChangePreviewPanel ActivityId="@schemaPreviewActivityId"
                                         Title="@SchemaText.SchemaSelectionPreviewTitle"
                                         OnPreviewChanged="OnSchemaPreviewChanged"
                                         OnClose="DiscardSchemaPreview"
                                         Class="mt-6" />
    }
}

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    /// <summary>
    /// The Connected System's last auxiliary class discovery run, or null when none has been run. Supplied by the
    /// page rather than fetched here: the tab renders one Auxiliary Classes panel per Object Type, and the run
    /// belongs to the whole Connected System.
    /// </summary>
    [Parameter]
    public AuxiliaryClassDiscoveryRun? LatestAuxiliaryClassDiscoveryRun { get; set; }

    [Parameter]
    public EventCallback OnConnectedSystemChanged { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private Guid? _schemaPreviewActivityId;
    private ConfigurationChangePreview? _schemaPreview;
    private ConnectedSystemSchemaProposal? _previewedSchema;
    private bool _startingSchemaPreview;

    private bool _schemaBeingRetrieved;
    private SchemaRefreshResult? _schemaRefreshResult;

    // A refresh with an existing schema previews first (#421): the merge runs against this freshly loaded
    // instance so the live graph the tabs render stays untouched until the administrator applies. Discarding
    // is just dropping the pair. The dependents are what the destructive changes invalidate, and double as
    // the Apply & Disable Dependents plan (#1485).
    private SchemaRefreshResult? _schemaRefreshPreview;
    private SchemaRefreshDependents? _schemaRefreshDependents;
    private SchemaRefreshRemovalImpact? _schemaRefreshRemovalImpact;
    private ConnectedSystem? _pendingSchemaRefreshSystem;
    private bool _schemaRefreshApplying;
    private ConnectedSystemObjectType? _selectedObjectType;
    private int _activeSchemaTabIndex;
    private string _objectTypeSearchString = "";
    private bool _objectTypeSelectedFilter;

    // Object types the Connected System classified as internal are held back until asked for. Not persisted as a
    // user preference: it is a per-visit "let me look at the plumbing", not a standing choice about every system.
    private bool _showInternalObjectTypes;

    // Likewise operational attributes, which an LDAP directory publishes by the dozen (#2153, D8).
    private bool _showOperationalAttributes;
    private bool _selectedObjectTypeHasClasses;
    private bool _selectedObjectTypeHasDescriptions;
    private bool _selectedObjectTypeHasConstrainedAttributes;
    private bool _selectedObjectTypeHasCaseExactAttributes;
    private bool _selectedObjectTypeHasDateAttributes;
    private IReadOnlyCollection<AttributeWritability> _selectedSchemaWritabilities = new List<AttributeWritability>();
    private string _schemaSearchString = "";
    private IReadOnlyCollection<string> AttributeClassFilterSelectedValues { get; set; } = new HashSet<string>();
    private bool _attributeSelectedFilter;
    private string? _attributeSelectionCsv;
    private IReadOnlyCollection<AttributeDataType> _selectedSchemaTypes = new List<AttributeDataType>();
    private IReadOnlyCollection<AttributePlurality> _selectedSchemaPluralites = new List<AttributePlurality>();
    private VirtualisedDataGrid<ConnectedSystemObjectTypeAttribute>? _attributeGrid;

    // Set when the active object type has been rebound onto a freshly loaded Connected System graph; consumed in
    // OnAfterRenderAsync, because the reload must run against the grid the new render produced.
    private bool _attributeGridReloadPending;

    private readonly DialogOptions _dialogOptions = new() { FullWidth = true };
    private bool _editSchemaAttributeDialogVisible;
    private ConnectedSystemObjectTypeAttribute? _objectTypeAttributeBeingEdited;
    private string? _objectTypeAttributeBeingEditedText;
    private bool _objectTypeAttributeBeingEditedIsEditable;
    private bool _objectTypeAttributeBeingEditedCaseExact;
    private DateTimeResolution _objectTypeAttributeBeingEditedResolution = DateTimeResolution.Microsecond;
    private AttributePlurality _objectTypeAttributeBeingEditedPlurality = AttributePlurality.SingleValued;

    private const string ObjectTypeQueryParameterName = "ot";
    private bool _objectTypeDeepLinkApplied;

    /// <summary>An attribute data type as the portal names it.</summary>
    private static string DataTypeLabel(AttributeDataType type) => type switch
    {
        AttributeDataType.NotSet => SchemaText.DataTypeNotSet,
        AttributeDataType.Text => SchemaText.DataTypeText,
        AttributeDataType.Number => SchemaText.DataTypeNumber,
        AttributeDataType.DateTime => SchemaText.DataTypeDateTime,
        AttributeDataType.Binary => SchemaText.DataTypeBinary,
        AttributeDataType.Reference => SchemaText.DataTypeReference,
        AttributeDataType.Guid => SchemaText.DataTypeGuid,
        AttributeDataType.Boolean => SchemaText.DataTypeBoolean,
        AttributeDataType.LongNumber => SchemaText.DataTypeLongNumber,
        AttributeDataType.Decimal => SchemaText.DataTypeDecimal,
        _ => type.ForDisplay()
    };

    protected override void OnParametersSet()
    {
        // The ConnectedSystem parameter is replaced wholesale on reload (e.g. after a schema refresh or save),
        // so a previously-resolved _selectedObjectType can become a stale, detached instance. Rebind it to the
        // matching type in the fresh collection (by Id, to preserve the active selection), then fall back to the
        // first selected type (which is how a single auto-selected type surfaces after import).
        var previousObjectType = _selectedObjectType;
        if (_selectedObjectType != null)
            _selectedObjectType = ConnectedSystem.ObjectTypes?.FirstOrDefault(ot => ot.Id == _selectedObjectType.Id);
        _selectedObjectType ??= ConnectedSystem.ObjectTypes?.FirstOrDefault(q => q.Selected);

        // The object type's id is unchanged across that rebind, so the grid has no way of knowing its rows now
        // point at attribute objects from a graph that has been thrown away; toggling a switch on one of them
        // would write to an instance nothing saves. Reload once the new render is in the DOM.
        if (!ReferenceEquals(previousObjectType, _selectedObjectType))
            _attributeGridReloadPending = true;

        // Deep-link support: "?t=schema&ot=jimPerson" selects that object type's sub-tab on first load. Applied
        // once only, so it never overrides the admin's own subsequent tab clicks after a schema refresh or save
        // reloads ConnectedSystem.
        if (!_objectTypeDeepLinkApplied && ConnectedSystem.ObjectTypes != null)
        {
            ApplyObjectTypeDeepLink();
            _objectTypeDeepLinkApplied = true;
        }

        if (_selectedObjectType != null)
        {
            _selectedObjectTypeHasClasses = _selectedObjectType.Attributes.Any(q => q.ClassName != null);
            _selectedObjectTypeHasDescriptions = _selectedObjectType.Attributes.Any(q => q.Description != null);
            _selectedObjectTypeHasConstrainedAttributes = _selectedObjectType.Attributes.Any(q => q.Writability != AttributeWritability.Writable);
            _selectedObjectTypeHasCaseExactAttributes = _selectedObjectType.Attributes.Any(q => q.CaseExact);
            _selectedObjectTypeHasDateAttributes = _selectedObjectType.Attributes.Any(q => q.Type == AttributeDataType.DateTime);
        }
    }

    /// <summary>
    /// Selects the sub-tab for the object type named by the "ot" query string parameter (e.g.
    /// "?t=schema&amp;ot=jimPerson"), matched case-insensitively against Connected System Object Type names. No-op
    /// when the parameter is absent, or names a type that is not (yet) selected for JIM to manage.
    /// </summary>
    private void ApplyObjectTypeDeepLink()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var objectTypeName = query[ObjectTypeQueryParameterName];
        if (string.IsNullOrEmpty(objectTypeName))
            return;

        var selected = GetSelectedObjectTypes();
        var index = selected.FindIndex(ot => ot.Name.Equals(objectTypeName, StringComparison.OrdinalIgnoreCase));
        if (index < 0)
            return;

        _selectedObjectType = selected[index];
        _activeSchemaTabIndex = index + 1;
    }

    /// <summary>
    /// Keeps the "ot" query string parameter in sync with the active object type sub-tab, so the URL is always a
    /// shareable deep link back to the currently viewed type. Mirrors NavigableMudTabs' own "t" parameter handling,
    /// preserving every other query parameter (notably "t=schema", set by the parent tab strip).
    /// </summary>
    private void UpdateObjectTypeQueryString()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var baseUri = uri.GetLeftPart(UriPartial.Path);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        if (_selectedObjectType == null)
            query.Remove(ObjectTypeQueryParameterName);
        else
            query[ObjectTypeQueryParameterName] = _selectedObjectType.Name;

        var qs = query.ToString();
        var newUrl = string.IsNullOrEmpty(qs) ? baseUri : $"{baseUri}?{qs}";
        NavManager.NavigateTo(newUrl, new NavigationOptions { ReplaceHistoryEntry = false });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_attributeGridReloadPending)
            return;

        _attributeGridReloadPending = false;
        await RefreshAttributeGridAsync();
    }

    /// <summary>
    /// Slices one window of the active object type's attributes, applying the page's chip filters, the grid's
    /// search (attribute name, which is what the tab's own name filter used to do) and its sort. The attributes
    /// belong to the Connected System the page already loaded, so there is no database range read: the switches in
    /// the Selected column write straight through to the objects Save Changes persists.
    /// </summary>
    private Task<VirtualisedWindow<ConnectedSystemObjectTypeAttribute>> LoadAttributeWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        // The chip counts beside the filters are contextual: they describe the attributes remaining under every
        // other filter, search included. The search now lives in the grid, so its text is mirrored back here and
        // the tab re-rendered, or the counts would describe a wider set than the rows underneath them.
        var searchText = request.SearchText ?? string.Empty;
        var searchChanged = !string.Equals(_schemaSearchString, searchText, StringComparison.Ordinal);
        _schemaSearchString = searchText;

        var attributes = (_selectedObjectType?.Attributes ?? new List<ConnectedSystemObjectTypeAttribute>())
            .Where(SchemaFilterFuncHandler);

        IOrderedEnumerable<ConnectedSystemObjectTypeAttribute> Order<TKey>(Func<ConnectedSystemObjectTypeAttribute, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? attributes.OrderByDescending(key, comparer) : attributes.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "selected" => Order(a => a.Selected),
            "externalid" => Order(a => a.IsExternalId),
            "class" => Order(a => a.ClassName ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            "type" => Order(a => a.Type),
            "plurality" => Order(a => a.AttributePlurality),
            "writability" => Order(a => a.Writability),
            "caseexact" => Order(a => a.CaseExact),
            "dateresolution" => Order(a => a.Type == AttributeDataType.DateTime ? (int)SchemaAttributeEdit.EffectiveDateTimeResolution(a) : 0),
            "description" => Order(a => a.Description ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            _ => Order(a => a.Name, StringComparer.OrdinalIgnoreCase)
        };

        var window = sorted.ToWindow(request);

        if (searchChanged)
            StateHasChanged();

        return Task.FromResult(window);
    }

    /// <summary>
    /// Whether any of the page's own chip filters is narrowing the attribute list, so the empty state can tell
    /// "nothing matches what you chose" apart from "this object type has no attributes".
    /// </summary>
    private bool AnySchemaFilterIsActive =>
        AttributeClassFilterSelectedValues.Count > 0 || _selectedSchemaTypes.Count > 0 ||
        _selectedSchemaPluralites.Count > 0 || _selectedSchemaWritabilities.Count > 0;

    /// <summary>
    /// Reloads the attribute grid after the page's own filters, or the attributes themselves, have changed. The
    /// totals are invalidated because the match set is a different one, and the reader is returned to the top
    /// because the position they held described rows that may no longer be there.
    /// </summary>
    private async Task RefreshAttributeGridAsync()
    {
        if (_attributeGrid == null)
            return;

        await _attributeGrid.ResetScrollAsync();
        await _attributeGrid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Handles a selection switch being toggled. Selecting changes which rows match only while the Selected Only
    /// filter is on, which is the one case that needs the window re-fetching; otherwise the row simply re-renders
    /// where it is, and reloading would throw the reader's scroll position away for nothing.
    /// </summary>
    private async Task OnAttributeSelectedChangedAsync()
    {
        if (_attributeSelectedFilter)
            await RefreshAttributeGridAsync();
    }

    private async Task HandleImportSchemaAsync()
    {
        // attribute the import to the user
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        _schemaBeingRetrieved = true;
        _schemaRefreshResult = null; // Clear any previous result
        _schemaRefreshPreview = null;
        _schemaRefreshDependents = null;
        _pendingSchemaRefreshSystem = null;
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            if (ConnectedSystem.ObjectTypes == null || ConnectedSystem.ObjectTypes.Count == 0)
            {
                // First retrieval: there is nothing to diff against and nothing a refresh could disturb, so
                // retrieve and persist in one step.
                _schemaRefreshResult = await jim.ConnectedSystems.ImportConnectedSystemSchemaAsync(ConnectedSystem, user);

                // A single, newly-discovered object type is auto-selected and persisted server-side (see
                // ImportConnectedSystemSchemaAsync); the reload below surfaces it, and OnParametersSet binds it as
                // the active object type so the admin lands straight on attribute selection.
                await OnConnectedSystemChanged.InvokeAsync();
            }
            else
            {
                // A refresh with an existing schema previews first (#421). The merge mutates the instance it is
                // given, so it runs against a freshly loaded one: the schema the tabs below render stays exactly
                // as persisted until the administrator applies, and discarding costs nothing.
                var pending = await jim.ConnectedSystems.GetConnectedSystemAsync(ConnectedSystem.Id)
                    ?? throw new InvalidOperationException($"Connected System {ConnectedSystem.Id} could not be reloaded for a schema refresh preview.");

                _schemaRefreshPreview = await jim.ConnectedSystems.PreviewConnectedSystemSchemaRefreshAsync(pending);
                _pendingSchemaRefreshSystem = pending;

                // A destructive diff names what depends on it, which is also the Apply & Disable plan, and
                // counts what Apply & Remove would take with it (#1485).
                if (_schemaRefreshPreview.HasRemovalsOrDefinitionChanges)
                {
                    // Through the server's single entry point, so the preview names the same dependents the REST
                    // API does, readers of removed attributes included (#2265).
                    _schemaRefreshDependents = await jim.ConnectedSystems.DetectSchemaRefreshDependentsAsync(ConnectedSystem.Id, _schemaRefreshPreview);
                    _schemaRefreshRemovalImpact = await jim.ConnectedSystems.ComputeSchemaRefreshRemovalImpactAsync(ConnectedSystem.Id, _schemaRefreshPreview);
                }
                else
                {
                    _schemaRefreshDependents = null;
                    _schemaRefreshRemovalImpact = null;
                }
            }
        }
        catch (CsvParsingException ex)
        {
            await ShowCsvErrorDialogAsync(ex);
            _schemaRefreshResult = SchemaRefreshResult.Failed(ex.ToDisplayText());
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to import schema for Connected System {SystemId}", ConnectedSystem.Id);
            _schemaRefreshResult = SchemaRefreshResult.Failed(ex.ToDisplayText());
        }
        finally
        {
            _schemaBeingRetrieved = false;
            StateHasChanged();
            await Task.Delay(1);
        }
    }

    /// <summary>
    /// Persists the previewed refresh: the same retrieve-merge-persist outcome the one-call import produces,
    /// with the administrator's decision in the middle. The preview's result becomes the applied summary.
    /// </summary>
    private async Task HandleApplySchemaRefreshAsync()
    {
        if (_schemaRefreshPreview == null || _pendingSchemaRefreshSystem == null)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        _schemaRefreshApplying = true;
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            await jim.ConnectedSystems.ApplyConnectedSystemSchemaRefreshAsync(_pendingSchemaRefreshSystem, _schemaRefreshPreview, user);
            _schemaRefreshResult = _schemaRefreshPreview;
            _schemaRefreshPreview = null;
            _schemaRefreshDependents = null;
            _schemaRefreshRemovalImpact = null;
            _pendingSchemaRefreshSystem = null;
            await OnConnectedSystemChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Deliberately broad, with the cancellation exclusion the fallback-dispatcher rule requires: whatever
            // the persist throws (database faults included, which are not domain exceptions), the administrator
            // must see the failure in the panel rather than have it escape and tear the circuit down.
            Log.Error(ex, "Failed to apply schema refresh for Connected System {SystemId}", ConnectedSystem.Id);
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.ApplyFailed, ex.ToDisplayText()), Severity.Error, options => options.RequireInteraction = true);
        }
        finally
        {
            _schemaRefreshApplying = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// The Apply &amp; Disable Dependents option (#1485): records the new schema, then disables every rule and
    /// mapping the plan names, each with its reason, so nothing runs against entries the source no longer reports.
    /// </summary>
    private async Task HandleApplySchemaRefreshWithDisablesAsync()
    {
        if (_schemaRefreshPreview == null || _pendingSchemaRefreshSystem == null || _schemaRefreshDependents == null)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        _schemaRefreshApplying = true;
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            await jim.ConnectedSystems.ApplyConnectedSystemSchemaRefreshAsync(_pendingSchemaRefreshSystem, _schemaRefreshPreview, _schemaRefreshDependents, user);
            Snackbar.Add(SchemaText.AppliedDisabled, Severity.Success);
            _schemaRefreshResult = _schemaRefreshPreview;
            _schemaRefreshPreview = null;
            _schemaRefreshDependents = null;
            _schemaRefreshRemovalImpact = null;
            _pendingSchemaRefreshSystem = null;
            await OnConnectedSystemChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Same boundary as the plain apply: any failure reaches the administrator, never the circuit.
            Log.Error(ex, "Failed to apply schema refresh with disables for Connected System {SystemId}", ConnectedSystem.Id);
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.ApplyFailed, ex.ToDisplayText()), Severity.Error, options => options.RequireInteraction = true);
        }
        finally
        {
            _schemaRefreshApplying = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// The Apply &amp; Remove option (#1485): records the new schema, deletes the invalidated rules and mappings
    /// under child Activities of the refresh, and queues the data removal as a worker task so the request path
    /// never pays for a large connector space.
    /// </summary>
    private async Task HandleApplySchemaRefreshWithRemovalsAsync()
    {
        if (_schemaRefreshPreview == null || _pendingSchemaRefreshSystem == null)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        _schemaRefreshApplying = true;
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            var creationResult = await jim.ConnectedSystems.ApplyConnectedSystemSchemaRefreshWithRemovalAsync(
                _pendingSchemaRefreshSystem, _schemaRefreshPreview, _schemaRefreshDependents ?? new SchemaRefreshDependents(), user);

            if (creationResult == null)
                Snackbar.Add(SchemaText.AppliedRemoved, Severity.Success);
            else if (creationResult.Success)
                Snackbar.Add(SchemaText.AppliedRemovedQueued, Severity.Success);
            else
                Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.AppliedRemovedNotQueued, creationResult.ErrorMessage), Severity.Error, options => options.RequireInteraction = true);

            _schemaRefreshResult = _schemaRefreshPreview;
            _schemaRefreshPreview = null;
            _schemaRefreshDependents = null;
            _schemaRefreshRemovalImpact = null;
            _pendingSchemaRefreshSystem = null;
            await OnConnectedSystemChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Same boundary as the plain apply: any failure reaches the administrator, never the circuit.
            Log.Error(ex, "Failed to apply schema refresh with removals for Connected System {SystemId}", ConnectedSystem.Id);
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.ApplyFailed, ex.ToDisplayText()), Severity.Error, options => options.RequireInteraction = true);
        }
        finally
        {
            _schemaRefreshApplying = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Drops the previewed refresh. The preview merged into its own instance, so the schema JIM holds was never
    /// touched; the panel has already confirmed the decision where the discard leaves JIM adrift of the source.
    /// </summary>
    private void HandleDiscardSchemaRefresh()
    {
        _schemaRefreshPreview = null;
        _schemaRefreshDependents = null;
        _schemaRefreshRemovalImpact = null;
        _pendingSchemaRefreshSystem = null;
    }

    private void HandleCloseSchemaRefreshResult()
    {
        _schemaRefreshResult = null;
        StateHasChanged();
    }

    private void HandleSelectedObjectTypeClick(ConnectedSystemObjectType connectedSystemObjectType, bool isObjectTypeChecked)
    {
        // actuate the state change
        connectedSystemObjectType.Selected = isObjectTypeChecked;

        // now cascade
        // if only one type is selected, make that the selected object type
        // if none are selected, clear selected object type
        // if the selected type is being de-selected, null the selected type
        if (ConnectedSystem.ObjectTypes != null && ConnectedSystem.ObjectTypes.Count(q => q.Selected) == 1)
            _selectedObjectType = ConnectedSystem.ObjectTypes.Single(q => q.Selected);
        else if (ConnectedSystem.ObjectTypes == null || ConnectedSystem.ObjectTypes.Count(q => q.Selected) == 0)
            _selectedObjectType = null;
        else if (_selectedObjectType != null && _selectedObjectType.Id == connectedSystemObjectType.Id && !isObjectTypeChecked)
            _selectedObjectType = null;

        // some parts of the UI only make sense if the attributes have classes
        _selectedObjectTypeHasClasses = connectedSystemObjectType.Attributes.Any(q => q.ClassName != null);
        _selectedObjectTypeHasDescriptions = connectedSystemObjectType.Attributes.Any(q => q.Description != null);
    }

    /// <summary>
    /// The selected object types, ordered by name. This is the ordering used to render the per-type sub-tabs, so the
    /// tab at index N+1 corresponds to GetSelectedObjectTypes()[N] (index 0 is the "Object Types" discovery tab).
    /// </summary>
    private List<ConnectedSystemObjectType> GetSelectedObjectTypes() =>
        ConnectedSystem.ObjectTypes?.Where(ot => ot.Selected).OrderBy(ot => ot.Name).ToList() ?? new List<ConnectedSystemObjectType>();

    /// <summary>
    /// The object types the discovery grid will consider before the administrator's own search and All / Selected
    /// filter narrow it further: everything the Connected System reported, less the ones it classified as internal.
    /// </summary>
    /// <remarks>
    /// A directory publishes its own configuration and operational classes in the same schema as the classes an
    /// administrator manages; on a stock OpenLDAP those account for well over a third of what is discovered. Hiding
    /// them is presentation only: they are still imported, still stored, and one click away.
    /// <para>
    /// A Selected object type is never hidden, whatever its classification. An administrator who has deliberately
    /// chosen to manage a class must always be able to see that they have.
    /// </para>
    /// </remarks>
    private IEnumerable<ConnectedSystemObjectType> GetVisibleObjectTypes()
    {
        var objectTypes = ConnectedSystem.ObjectTypes?.AsEnumerable() ?? Enumerable.Empty<ConnectedSystemObjectType>();
        return _showInternalObjectTypes ? objectTypes : objectTypes.Where(ot => ot.Selected || !ot.IsInternal());
    }

    /// <summary>
    /// How many internal object types the current view is holding back, which is what the disclosure below the grid
    /// reports. Zero while internal types are being shown.
    /// </summary>
    private int GetHiddenInternalObjectTypeCount()
    {
        return _showInternalObjectTypes
            ? 0
            : ConnectedSystem.ObjectTypes?.Count(ot => !ot.Selected && ot.IsInternal()) ?? 0;
    }

    /// <summary>
    /// Whether the Connected System reported any internal object types at all. Distinguishes "none are hidden
    /// because they are being shown" from "none are hidden because there are none", so the way back is only offered
    /// where there is something to go back to.
    /// </summary>
    private bool AnyInternalObjectTypes()
    {
        return ConnectedSystem.ObjectTypes?.Any(ot => ot.IsInternal()) ?? false;
    }

    /// <summary>
    /// The object types shown in the discovery grid, after applying the name search and the All / Selected filter.
    /// Selected types are ordered first so the current selection stays visible as the list is filtered.
    /// </summary>
    private IEnumerable<ConnectedSystemObjectType> GetFilteredDiscoveryObjectTypes()
    {
        var objectTypes = GetVisibleObjectTypes();

        if (_objectTypeSelectedFilter)
            objectTypes = objectTypes.Where(ot => ot.Selected);

        if (!string.IsNullOrWhiteSpace(_objectTypeSearchString))
            objectTypes = objectTypes.Where(ot => ot.Name.Contains(_objectTypeSearchString.Trim(), StringComparison.OrdinalIgnoreCase));

        return objectTypes.OrderByDescending(ot => ot.Selected).ThenBy(ot => ot.Name);
    }

    /// <summary>
    /// Keeps the active sub-tab and the active object type in sync. Index 0 is the "Object Types" discovery tab (no
    /// active object type); indexes 1..n map onto the per-type sub-tabs in GetSelectedObjectTypes() order.
    /// </summary>
    private void OnSchemaTabChanged(int index)
    {
        _activeSchemaTabIndex = index;

        var selected = GetSelectedObjectTypes();
        _selectedObjectType = index >= 1 && index - 1 < selected.Count ? selected[index - 1] : null;
        RecomputeSelectedObjectTypeFlags();
        UpdateObjectTypeQueryString();
    }

    /// <summary>
    /// Recomputes the flags that drive which optional columns and controls the attribute table shows, for the
    /// currently active object type. No-op when no object type is active (the discovery tab).
    /// </summary>
    private void RecomputeSelectedObjectTypeFlags()
    {
        if (_selectedObjectType == null)
            return;

        _selectedObjectTypeHasClasses = _selectedObjectType.Attributes.Any(q => q.ClassName != null);
        _selectedObjectTypeHasDescriptions = _selectedObjectType.Attributes.Any(q => q.Description != null);
        _selectedObjectTypeHasConstrainedAttributes = _selectedObjectType.Attributes.Any(q => q.Writability != AttributeWritability.Writable);
        _selectedObjectTypeHasCaseExactAttributes = _selectedObjectType.Attributes.Any(q => q.CaseExact);
        _selectedObjectTypeHasDateAttributes = _selectedObjectType.Attributes.Any(q => q.Type == AttributeDataType.DateTime);
    }

    /// <summary>
    /// Handles toggling an object type's selection from the discovery grid. Selecting is immediate; deselecting is
    /// confirmed first, because removing a type discards its attribute selection and configuration, which can
    /// represent significant effort. The grid switch is read-only/presentational, so nothing changes until this
    /// runs: cancelling simply leaves the type selected.
    /// </summary>
    private async Task HandleObjectTypeGridToggleAsync(ConnectedSystemObjectType connectedSystemObjectType, bool isSelected)
    {
        if (isSelected)
        {
            HandleSelectedObjectTypeClick(connectedSystemObjectType, true);
            return;
        }

        if (!await ConfirmObjectTypeRemovalAsync(connectedSystemObjectType))
            return;

        HandleSelectedObjectTypeClick(connectedSystemObjectType, false);
    }

    /// <summary>
    /// Asks the admin to confirm removing an object type from those JIM manages, spelling out that the type's
    /// attribute selection and configuration will be discarded. Returns true only if they confirm.
    /// </summary>
    private async Task<bool> ConfirmObjectTypeRemovalAsync(ConnectedSystemObjectType connectedSystemObjectType)
    {
        // HTML-encode the name: it is interpolated into a MarkupString, which bypasses Razor's auto-encoding.
        var encodedName = System.Net.WebUtility.HtmlEncode(connectedSystemObjectType.Name);
        var options = new MessageBoxOptions
        {
            Title = SchemaText.RemoveObjectTypeQuestion,
            MarkupMessage = (MarkupString)string.Format(CultureInfo.CurrentCulture, SchemaText.RemoveObjectTypeMessage, $"<code class=\"jim-code-inline\">{encodedName}</code>"),
            YesText = CommonText.Remove,
            CancelText = CommonText.Cancel
        };

        var confirmed = await DialogService.ShowMessageBoxAsync(options);
        return confirmed == true;
    }

    private async Task HandleMakeExternalIdAsync(ConnectedSystemObjectTypeAttribute selectedAttribute)
    {
        if (_selectedObjectType == null)
        {
            Log.Error($"Schema Tab > HandleMakeExternalIdAsync: {nameof(_selectedObjectType)} is null!");
            return;
        }

        // make sure there's not already an attribute marked as the external id
        foreach (var attribute in _selectedObjectType.Attributes.Where(a => a.IsExternalId))
            attribute.IsExternalId = false;

        // mark the intended attribute as the external id, and select it
        selectedAttribute.IsExternalId = true;
        selectedAttribute.Selected = true;
        Log.Verbose($"Schema Tab > HandleMakeExternalIdAsync: Set attribute id {selectedAttribute} as the external id.");

        // two rows changed (the old External ID lost the marker, the new one gained it and became selected), and
        // either can be outside the window on screen, so the grid re-reads rather than being left partly stale.
        await RefreshAttributeGridAsync();
    }

    private async Task HandleObjectTypesAndAttributeSelectionSubmitAsync()
    {
        // attribute the update to the user
        using var jim = JimFactory.Create();

        // deselecting an Object Type, a Partition or a Container takes objects out of management: the next Full
        // Import obsoletes them and the following synchronisation disconnects them (#1474). That would save silently
        // otherwise, so the administrator acknowledges the consequence first, and where a preview was run the
        // acknowledgement says how many objects that is (#1475).
        var preflight = await jim.ConfigurationChangePreflight.EvaluateConnectedSystemAsync(ConnectedSystem);
        if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                SchemaText.ConnectedSystemTermName, ConnectedSystem.Name,
                ConfigurationChangePreviewCounts.ForConfirmation(_schemaPreview, SchemaPreviewIsStale),
                ConfigurationChangePreviewCounts.ForConfirmationVerdict(_schemaPreview, SchemaPreviewIsStale)))
            return;

        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        IReadOnlyList<JIM.Models.Core.DTOs.AttributeReader> deselectionWarnings;
        try
        {
            deselectionWarnings = await jim.ConnectedSystems.UpdateConnectedSystemSchemaAsync(ConnectedSystem, user);
        }
        catch (InvalidSettingValuesException ex)
        {
            // the selection was refused: the Connector said this Connected System's settings cannot serve it (an Object
            // Type selected without what the configured Delta Import Mode needs, say), or an Object Type is deselected
            // while an enabled Synchronisation Rule still manages it (#1474). Nothing was saved; the message names the fix.
            Snackbar.Add(ex.ToDisplayText(), Severity.Error, options => options.RequireInteraction = true);
            return;
        }
        catch (AttributeReadByConfigurationException ex)
        {
            // an attribute a Scoping Criterion reads was deselected (#2265); nothing was saved, and the message names
            // each criterion to change first.
            Snackbar.Add(ex.ToDisplayText(), Severity.Error, options => options.RequireInteraction = true);
            return;
        }
        DiscardSchemaPreview();
        Snackbar.Add(SchemaText.AttributeChangesSaved, Severity.Success);
        if (deselectionWarnings.Count > 0)
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.DeselectedStillRead, string.Join("; ", deselectionWarnings.Select(r => r.ShowDescription()))),
                Severity.Warning, options => options.RequireInteraction = true);

        await OnConnectedSystemChanged.InvokeAsync();
    }

    // ─── Configuration Change Preview (#1475) ───

    /// <summary>
    /// The schema selection currently ticked, as the preview framework's proposal type.
    /// </summary>
    /// <remarks>
    /// Read from the loaded Connected System because the grids edit their <c>Selected</c> flags in place, so the
    /// entity graph already carries what the administrator has chosen but not yet saved.
    /// </remarks>
    private ConnectedSystemSchemaProposal BuildSchemaProposal() =>
        ConnectedSystemSchemaProposal.FromCurrentConfiguration(ConnectedSystem.ObjectTypes ?? []);

    /// <summary>
    /// Whether the selection has moved since the preview ran, which makes its answer about a selection nobody is
    /// about to save. Said plainly rather than silently discarded: an administrator who previewed and then made
    /// one more change is exactly the person most likely to trust the panel still on screen.
    /// </summary>
    private bool SchemaPreviewIsStale =>
        _previewedSchema is not null && !BuildSchemaProposal().DescribesSameSchemaAs(_previewedSchema);

    private async Task PreviewSchemaSelectionAsync()
    {
        if (_startingSchemaPreview)
            return;

        _startingSchemaPreview = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var proposal = BuildSchemaProposal();

            // The starter, not StartAndDispatchPreviewAsync: it owns the question of whether a large preview keeps
            // every drill-down row, and that decision belongs in one place rather than at each surface.
            var activityId = await PreviewStarter.StartAsync(new ConfigurationChangePreviewRequest
            {
                Surface = ConfigurationChangePreviewSurface.ConnectedSystemSchema,
                TargetId = ConnectedSystem.Id,
                TargetName = ConnectedSystem.Name,
                ProposedConfiguration = proposal,
                InitiatedByType = ActivityInitiatorType.User,
                InitiatedById = user?.Id,
                InitiatedByName = user?.Name
            });

            // Null means the administrator declined the data-set size question, which is a decision not to preview.
            if (activityId == null)
                return;

            _schemaPreviewActivityId = activityId;
            _previewedSchema = proposal;
            _schemaPreview = null;
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            DiscardSchemaPreview();
            Log.Error(ex, "Failed to start a schema selection preview for Connected System {ConnectedSystemId}", ConnectedSystem.Id);
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewStartFailed, ex.Message), Severity.Error);
        }
        finally
        {
            _startingSchemaPreview = false;
        }
    }

    /// <summary>
    /// Records the panel's latest read of the preview, for the save confirmation to state.
    /// </summary>
    /// <remarks>
    /// Deliberately does not call <c>StateHasChanged</c>, for the reason recorded on the pilot surface: the panel
    /// re-reads on every parameter set, so re-rendering here would set its parameters again, refresh again, and
    /// raise this again, cancelling and restarting its reconciliation poll on every pass so the panel never leaves
    /// stage 1. Nothing rendered here depends on this value, so storing it is enough.
    /// </remarks>
    private void OnSchemaPreviewChanged(ConfigurationChangePreview? preview) => _schemaPreview = preview;

    private void DiscardSchemaPreview()
    {
        _schemaPreviewActivityId = null;
        _previewedSchema = null;
        _schemaPreview = null;
    }

    private bool SchemaFilterFuncHandler(ConnectedSystemObjectTypeAttribute element) =>
        SchemaFilterFunc(element, _schemaSearchString, AttributeClassFilterSelectedValues, _attributeSelectedFilter, _selectedSchemaTypes, _selectedSchemaPluralites, _selectedSchemaWritabilities);

    /// <summary>
    /// Whether the attribute grid lists <paramref name="element"/> at all, before any filter: an unselected
    /// operational attribute is held back until asked for. Every count beside the filters goes through
    /// <see cref="SchemaFilterFunc"/>, so they all describe the rows the grid can show.
    /// </summary>
    private bool IsListed(ConnectedSystemObjectTypeAttribute element) =>
        _showOperationalAttributes || element.Selected || !element.IsOperational;

    /// <summary>
    /// How many operational attributes the current view is holding back, which is what the disclosure above the grid
    /// reports. Zero while they are being shown.
    /// </summary>
    private int GetHiddenOperationalAttributeCount() =>
        _selectedObjectType?.Attributes.Count(a => !IsListed(a)) ?? 0;

    private async Task SetShowOperationalAttributesAsync(bool show)
    {
        _showOperationalAttributes = show;
        await RefreshAttributeGridAsync();
    }

    private bool SchemaFilterFunc(
        ConnectedSystemObjectTypeAttribute element,
        string searchString,
        IReadOnlyCollection<string> attributeClassFilterSelectedValues,
        bool attributeSelectedFilter,
        IReadOnlyCollection<AttributeDataType> selectedTypes,
        IReadOnlyCollection<AttributePlurality> selectedPluralites,
        IReadOnlyCollection<AttributeWritability> selectedWritabilities)
    {
        // All filters must pass (AND logic)
        var classHashset = (HashSet<string>)attributeClassFilterSelectedValues;

        if (!IsListed(element))
            return false;

        // Filter by "show only selected" checkbox
        if (attributeSelectedFilter && !element.Selected)
            return false;

        // Filter by name search string
        if (!string.IsNullOrEmpty(searchString) && !element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return false;

        // Filter by class selection
        if (classHashset.Count > 0 && !classHashset.Any(q => q == element.ClassName))
            return false;

        // Filter by type selection
        if (selectedTypes.Count > 0 && !selectedTypes.Contains(element.Type))
            return false;

        // Filter by plurality selection
        if (selectedPluralites.Count > 0 && !selectedPluralites.Contains(element.AttributePlurality))
            return false;

        // Filter by writability selection
        if (selectedWritabilities.Count > 0 && !selectedWritabilities.Contains(element.Writability))
            return false;

        return true;
    }

    private async Task OnSchemaTypeFilterChangedAsync(IReadOnlyCollection<AttributeDataType> selectedTypes)
    {
        _selectedSchemaTypes = selectedTypes;
        await RefreshAttributeGridAsync();
    }

    private async Task OnSchemaPluralityFilterChangedAsync(IReadOnlyCollection<AttributePlurality> selectedPluralites)
    {
        _selectedSchemaPluralites = selectedPluralites;
        await RefreshAttributeGridAsync();
    }

    private async Task OnSchemaClassFilterChangedAsync()
    {
        await RefreshAttributeGridAsync();
    }

    private async Task OnAttributeSelectedFilterChangedAsync(bool selectedOnly)
    {
        _attributeSelectedFilter = selectedOnly;
        await RefreshAttributeGridAsync();
    }

    private IEnumerable<KeyValuePair<AttributeDataType, int>> GetAvailableSchemaTypes()
    {
        if (_selectedObjectType == null)
            return Enumerable.Empty<KeyValuePair<AttributeDataType, int>>();

        // Apply all filters EXCEPT type filter to get contextual counts
        var filteredAttributes = _selectedObjectType.Attributes
            .Where(a => SchemaFilterFunc(a, _schemaSearchString, AttributeClassFilterSelectedValues, _attributeSelectedFilter,
                new List<AttributeDataType>(), _selectedSchemaPluralites, _selectedSchemaWritabilities));

        return filteredAttributes
            .GroupBy(a => a.Type)
            .Select(g => new KeyValuePair<AttributeDataType, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key.ToString());
    }

    private IEnumerable<KeyValuePair<AttributePlurality, int>> GetAvailableSchemaPluralites()
    {
        if (_selectedObjectType == null)
            return Enumerable.Empty<KeyValuePair<AttributePlurality, int>>();

        // Apply all filters EXCEPT plurality filter to get contextual counts
        var filteredAttributes = _selectedObjectType.Attributes
            .Where(a => SchemaFilterFunc(a, _schemaSearchString, AttributeClassFilterSelectedValues, _attributeSelectedFilter,
                _selectedSchemaTypes, new List<AttributePlurality>(), _selectedSchemaWritabilities));

        return filteredAttributes
            .GroupBy(a => a.AttributePlurality)
            .Select(g => new KeyValuePair<AttributePlurality, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key);
    }

    private IEnumerable<KeyValuePair<AttributeWritability, int>> GetAvailableSchemaWritabilities()
    {
        if (_selectedObjectType == null)
            return Enumerable.Empty<KeyValuePair<AttributeWritability, int>>();

        // Apply all filters EXCEPT writability filter to get contextual counts
        var filteredAttributes = _selectedObjectType.Attributes
            .Where(a => SchemaFilterFunc(a, _schemaSearchString, AttributeClassFilterSelectedValues, _attributeSelectedFilter,
                _selectedSchemaTypes, _selectedSchemaPluralites, new List<AttributeWritability>()));

        return filteredAttributes
            .GroupBy(a => a.Writability)
            .Select(g => new KeyValuePair<AttributeWritability, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key);
    }

    private async Task OnSchemaWritabilityFilterChangedAsync(IReadOnlyCollection<AttributeWritability> selectedWritabilities)
    {
        _selectedSchemaWritabilities = selectedWritabilities;
        await RefreshAttributeGridAsync();
    }

    private (int allCount, int selectedCount) GetSchemaSelectionCounts()
    {
        if (_selectedObjectType == null)
            return (0, 0);

        // Apply all filters EXCEPT selection filter to get contextual counts
        var filteredAttributes = _selectedObjectType.Attributes
            .Where(a => SchemaFilterFunc(a, _schemaSearchString, AttributeClassFilterSelectedValues, false,
                _selectedSchemaTypes, _selectedSchemaPluralites, _selectedSchemaWritabilities))
            .ToList();

        return (filteredAttributes.Count, filteredAttributes.Count(a => a.Selected));
    }

    private async Task HandleAttributeCsvSubmitAsync()
    {
        if (_selectedObjectType == null)
        {
            Console.WriteLine($"{nameof(HandleAttributeCsvSubmitAsync)}: connectedSystem was null");
            return;
        }

        if (string.IsNullOrEmpty(_attributeSelectionCsv))
        {
            Console.WriteLine($"{nameof(HandleAttributeCsvSubmitAsync)}: attributeSelectionCsv is null or empty");
            return;
        }

        // clear the other filters, so the attributes just selected are all visible. The name search belongs to the
        // grid now, so it is cleared through the grid (which also reloads the window).
        ((HashSet<string>)AttributeClassFilterSelectedValues).Clear();
        if (_attributeGrid != null)
            await _attributeGrid.ClearSearchAsync();

        // convert the csv to a list, trim the entries, and resolve each to an attribute on the object type
        var matchedAttributes = _attributeSelectionCsv.Split(',')
            .Select(name => _selectedObjectType.Attributes.SingleOrDefault(a => a.Name.Equals(name.Trim(), StringComparison.OrdinalIgnoreCase)))
            .Where(a => a != null)
            .Select(a => a!)
            .ToList();

        // credential attributes are skipped: this path bypasses the table's disabled switch, so it needs its own guard
        var skippedCredentialAttributes = matchedAttributes
            .Where(a => CredentialAttributes.IsCredentialAttribute(a.Name))
            .Select(a => a.Name)
            .ToList();

        foreach (var attribute in matchedAttributes.Where(a => !CredentialAttributes.IsCredentialAttribute(a.Name)))
            attribute.Selected = true;

        // filter by selected
        _attributeSelectedFilter = true;

        // clear the attribute csv text box
        _attributeSelectionCsv = null;

        await RefreshAttributeGridAsync();

        // all done, let the user know
        Snackbar.Add(SchemaText.AttributesSelected, Severity.Success);

        if (skippedCredentialAttributes.Count > 0)
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.SkippedCredentialAttributes, string.Join(", ", skippedCredentialAttributes)), Severity.Warning);
    }

    private bool DisableSelectedSchemaObjectType(ConnectedSystemObjectType connectedSystemObjectType)
    {
        if (_selectedObjectType == null)
            return false;

        if (connectedSystemObjectType.Id.Equals(_selectedObjectType.Id))
            return true; // BOTH IDS ARE 0 WHEN THEY'RE DIFFERENT TYPES! HOW?! - BECAUSE THEY HAVEN'T BEEN PERSISTED YET!

        return false;
    }

    /// <summary>
    /// Determines whether the Save Schema changes button should be disabled or not.
    /// </summary>
    private bool DisableSaveSchemaButton()
    {
        // must select at least one object type
        // all selected object types must have an external id selected

        if (ConnectedSystem.ObjectTypes == null)
            return true;

        var objectTypesSelected = ConnectedSystem.ObjectTypes.Any(ot => ot.Selected);
        var externalIdsSet = ConnectedSystem.ObjectTypes.Where(ot => ot.Selected).All(ot => ot.Attributes.Any(a => a.IsExternalId));

        return !objectTypesSelected || !externalIdsSet;
    }

    private async Task HandleShowEditAttributeDialogAsync(ConnectedSystemObjectTypeAttribute connectedSystemObjectTypeAttribute)
    {
        // can the Connected System attribute be edited? are there any references to it?
        using var jim = JimFactory.Create();
        _objectTypeAttributeBeingEditedIsEditable = !await jim.ConnectedSystems.IsObjectTypeAttributeBeingReferencedAsync(connectedSystemObjectTypeAttribute);
        _objectTypeAttributeBeingEdited = connectedSystemObjectTypeAttribute;
        _objectTypeAttributeBeingEditedText = connectedSystemObjectTypeAttribute.Type.ToString();
        _objectTypeAttributeBeingEditedCaseExact = connectedSystemObjectTypeAttribute.CaseExact;
        _objectTypeAttributeBeingEditedResolution = SchemaAttributeEdit.EffectiveDateTimeResolution(connectedSystemObjectTypeAttribute);
        _objectTypeAttributeBeingEditedPlurality = connectedSystemObjectTypeAttribute.AttributePlurality;
        _editSchemaAttributeDialogVisible = true;
    }

    /// <summary>
    /// Whether the Connector lets the administrator say whether an attribute holds several values (#2186).
    /// </summary>
    private bool SupportsPlurality => ConnectedSystem.ConnectorDefinition.SupportsUserSelectedAttributePlurality;

    /// <summary>
    /// The type the attribute being edited will have once the dialog is confirmed: the one chosen in the dialog where
    /// the Connector allows an override, else the one it has.
    /// </summary>
    private AttributeDataType EditedAttributeType() =>
        ConnectedSystem.ConnectorDefinition.SupportsUserSelectedAttributeTypes &&
        Enum.TryParse<AttributeDataType>(_objectTypeAttributeBeingEditedText, out var chosenType)
            ? chosenType
            : _objectTypeAttributeBeingEdited?.Type ?? AttributeDataType.NotSet;

    /// <summary>
    /// Mirrors what confirming can act on (a type override, a case-exact declaration or a date resolution), so the
    /// button is never enabled with nothing to confirm.
    /// </summary>
    private bool CanConfirmAttributeEdit() =>
        _objectTypeAttributeBeingEdited != null &&
        (((ConnectedSystem.ConnectorDefinition.SupportsUserSelectedAttributeTypes || SupportsPlurality) && _objectTypeAttributeBeingEditedIsEditable) ||
         SchemaAttributeEdit.OffersCaseExact(EditedAttributeType()) ||
         SchemaAttributeEdit.OffersDateTimeResolution(EditedAttributeType()));

    private async Task HandleEditAttributeButtonClickAsync()
    {
        if (_objectTypeAttributeBeingEdited == null)
            return;

        // The type override goes through the server's rule set, the one the REST API (and so PowerShell) shares: it
        // re-checks the Connector and the attribute's references, and makes a Boolean single-valued (#2153).
        var madeSingleValued = false;
        if (ConnectedSystem.ConnectorDefinition.SupportsUserSelectedAttributeTypes &&
            _objectTypeAttributeBeingEditedIsEditable &&
            Enum.TryParse<AttributeDataType>(_objectTypeAttributeBeingEditedText, out var chosenType))
        {
            using var jim = JimFactory.Create();
            var typeOverride = await jim.ConnectedSystems.OverrideAttributeTypeAsync(ConnectedSystem, _objectTypeAttributeBeingEdited, chosenType);
            if (!typeOverride.Success)
            {
                Snackbar.Add(typeOverride.ErrorMessage ?? SchemaText.DataTypeNotChanged, Severity.Error);
                return;
            }

            madeSingleValued = typeOverride.MadeSingleValued;
        }

        // Plurality next, so it is checked against the type just chosen; a Boolean stays single-valued (#2186).
        if (SupportsPlurality && _objectTypeAttributeBeingEditedIsEditable &&
            AttributeDataTypeCapabilities.SupportsMultiValued(_objectTypeAttributeBeingEdited.Type))
        {
            using var jim = JimFactory.Create();
            var pluralityOverride = await jim.ConnectedSystems.OverrideAttributePluralityAsync(ConnectedSystem, _objectTypeAttributeBeingEdited, _objectTypeAttributeBeingEditedPlurality);
            if (!pluralityOverride.Success)
            {
                Snackbar.Add(pluralityOverride.ErrorMessage ?? SchemaText.PluralityNotChanged, Severity.Error);
                return;
            }
        }

        SchemaAttributeEdit.ApplyCaseExact(_objectTypeAttributeBeingEdited, _objectTypeAttributeBeingEditedCaseExact);
        SchemaAttributeEdit.ApplyDateTimeResolution(_objectTypeAttributeBeingEdited, _objectTypeAttributeBeingEditedResolution);

        RecomputeSelectedObjectTypeFlags();
        _editSchemaAttributeDialogVisible = false;

        // the Type chip filters are contextual and the row may no longer match the chosen ones, so the window is
        // re-read rather than left showing an attribute under a type it no longer has.
        await RefreshAttributeGridAsync();

        // all done, let the user know
        Snackbar.Add(madeSingleValued
            ? SchemaText.AttributeUpdatedSingleValued
            : SchemaText.AttributeUpdated, Severity.Success);
    }

    private async Task ShowCsvErrorDialogAsync(CsvParsingException ex)
    {
        var parameters = new DialogParameters<CsvErrorDialog>
        {
            { x => x.ErrorMessage, ex.Message },
            { x => x.RowNumber, ex.RowNumber },
            { x => x.ColumnInfo, ex.ColumnInfo },
            { x => x.RawData, ex.RawRow },
            { x => x.Suggestion, ex.Suggestion }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        await DialogService.ShowAsync<CsvErrorDialog>(SchemaText.CsvParsingErrorTitle, parameters, options);
    }
