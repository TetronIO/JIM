@*
    Says where an Activity came from when a Schedule produced it, and links back to the Schedule Execution that
    did. Renders nothing at all for an Activity with no Schedule behind it, or whose Schedule Execution has since
    been pruned, so a call site can place it unconditionally.
*@

@if (_execution is { } execution)
{
    var href = $"/admin/operations/schedule-executions/{execution.Id}";
    var statusText = execution.Status.ToString().SplitOnCapitalLetters();
    var statusColour = Helpers.GetScheduleExecutionMudBlazorColorForStatus(execution.Status);

    if (Compact)
    {
        @* Panel-section treatment, matching the sibling sections of the Operations History side panel. *@
        var contextText = BuildCompactContextText(execution);
        <MudPaper Elevation="0" Class="@CompactClass" Outlined="true">
            <MudText Typo="Typo.subtitle2" Class="mb-2" Color="Color.Primary">Schedule</MudText>
            <div class="d-flex align-center flex-wrap gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Schedule" />
                <MudLink Href="@href">@contextText</MudLink>
                <MudChip T="string" Variant="Variant.Text" Class="ml-0" Color="@statusColour">@statusText</MudChip>
            </div>
        </MudPaper>
    }
    else
    {
        @* Page-width treatment: a panel matching the detail page's other panels, so the context reads as another
           section of the page rather than a notice dropped on top of it. Laid out as labelled fields, one per
           line, matching the Summary panel it sits directly beneath; every value is labelled, and the status
           chip especially so, because the Activity carries a status chip of its own and an unlabelled second
           chip describing the whole run reads as a contradiction. *@
        <MudPaper Outlined="true" Class="@PanelClass">
            <MudText Typo="Typo.h5" Class="mb-4">Part of a Schedule</MudText>
            <MudGrid Spacing="4">
                <MudItem xs="12" sm="6" md="4">
                    <MudText Typo="Typo.button" Class="mud-text-secondary">Schedule:</MudText><br />
                    <MudLink Href="@href">@execution.ScheduleName</MudLink>
                </MudItem>

                @* Omitted entirely rather than rendered empty when the Activity carries no step index, or the
                   execution records no steps to count it against. *@
                @if (ScheduleStepIndex.HasValue && execution.TotalSteps > 0)
                {
                    var stepIndex = ScheduleStepIndex.Value;
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Step:</MudText>
                        @* ScheduleStepIndex is stored 0-based and read 1-based. *@
                        <MudText>@(stepIndex + 1) of @execution.TotalSteps</MudText>
                    </MudItem>
                }

                <MudItem xs="12" sm="6" md="4">
                    <MudText Typo="Typo.button" Class="mud-text-secondary">Schedule Execution:</MudText>
                    <div class="d-flex align-center flex-wrap gap-2">
                        <MudChip T="string" Variant="Variant.Text" Class="ml-0" Color="@statusColour">@statusText</MudChip>
                        <MudLink Href="@href">View Schedule Execution</MudLink>
                    </div>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }
}

@code {
    /// <summary>
    /// The Schedule Execution that produced the Activity, if any. Nothing is rendered when there is none.
    /// </summary>
    [Parameter, EditorRequired]
    public Guid? ScheduleExecutionId { get; set; }

    /// <summary>
    /// The zero-based index of the step within the Schedule Execution that produced the Activity. The step is
    /// shown one-based, and omitted entirely when this is not supplied.
    /// </summary>
    [Parameter]
    public int? ScheduleStepIndex { get; set; }

    /// <summary>
    /// When false (the default), renders a page-width panel matching the detail page's other panels. When true,
    /// renders a panel section matching the other sections of the Operations History side panel.
    /// </summary>
    [Parameter]
    public bool Compact { get; set; }

    /// <summary>
    /// Spacing and layout classes for the rendered element. The call site owns this decision, since only it
    /// knows what sits above and below.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    private ScheduleExecution? _execution;

    /// <summary>
    /// The Schedule Execution id the current <see cref="_execution"/> was loaded for. Guards the lookup: the
    /// Operations History tab polls and re-renders continuously, so an unguarded lookup would query the database
    /// on every poll tick.
    /// </summary>
    private Guid? _loadedExecutionId;

    private string CompactClass => string.IsNullOrWhiteSpace(Class) ? "pa-3" : $"pa-3 {Class}";

    private string PanelClass => string.IsNullOrWhiteSpace(Class) ? "pa-4" : $"pa-4 {Class}";

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedExecutionId == ScheduleExecutionId)
            return;

        _loadedExecutionId = ScheduleExecutionId;
        _execution = null;

        if (!ScheduleExecutionId.HasValue)
            return;

        var executionId = ScheduleExecutionId.Value;
        using var jim = JimFactory.Create();
        _execution = await jim.Scheduler.GetScheduleExecutionAsync(executionId);
    }

    /// <summary>
    /// Builds the single sentence naming the Schedule and the step for the compact treatment, which has no
    /// heading of its own and so carries the "Part of" prefix inline. The page-width treatment lays the same
    /// facts out as labelled fields under its own heading, and does not use this.
    /// </summary>
    private string BuildCompactContextText(ScheduleExecution execution)
    {
        if (ScheduleStepIndex.HasValue && execution.TotalSteps > 0)
        {
            var stepIndex = ScheduleStepIndex.Value;
            return $"Part of {execution.ScheduleName}, step {stepIndex + 1} of {execution.TotalSteps}";
        }

        return $"Part of {execution.ScheduleName}";
    }
}
