@page "/admin/connected-systems/{ConnectedSystemId:int}/pending-exports/{Id:guid}"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Staging.DTOs
@using JIM.Models.Transactional
@using JIM.Models.Transactional.DTOs
@using JIM.Utilities
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject ISnackbar Snackbar

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Pending Export Detail</PageTitle>

@if (_pendingExport != null)
{
    <MudText Typo="Typo.h3">
        <span>Pending Export:</span>
        <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetPendingExportChangeTypeColor(_pendingExport.ChangeType)" Class="ml-2">
            @_pendingExport.ChangeType
        </MudChip>
    </MudText>
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard Outlined="true" Elevation="0">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Details</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudSimpleTable Hover="true" Dense="true" Elevation="0" Class="jim-detail-table">
                        <tbody>
                            <tr>
                                <td><strong>ID</strong></td>
                                <td>@_pendingExport.Id</td>
                            </tr>
                            <tr>
                                <td><strong>Status</strong></td>
                                <td>
                                    <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetPendingExportStatusColor(_pendingExport.Status)">
                                        @_pendingExport.Status.ToString().SplitOnCapitalLetters()
                                    </MudChip>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Change Type</strong></td>
                                <td>
                                    <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetPendingExportChangeTypeColor(_pendingExport.ChangeType)">
                                        @_pendingExport.ChangeType
                                    </MudChip>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Connected System</strong></td>
                                <td>
                                    <MudLink Typo="Typo.body1" Href="@Utilities.GetConnectedSystemHref(_connectedSystemHeader!)">
                                        @_pendingExport.ConnectedSystem.Name
                                    </MudLink>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Created</strong></td>
                                <td>
                                    <MudTooltip Text="@_pendingExport.CreatedAt.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                                        <MudText>@_pendingExport.CreatedAt.ToLocalTime().ToRelativeTime()</MudText>
                                    </MudTooltip>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Has Unresolved References</strong></td>
                                <td>
                                    @if (_pendingExport.HasUnresolvedReferences)
                                    {
                                        <MudChip T="string" Variant="Variant.Text" Color="Color.Warning">Yes</MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body1">No</MudText>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Outlined="true" Elevation="0">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Related Objects</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudSimpleTable Hover="true" Dense="true" Elevation="0" Class="jim-detail-table">
                        <tbody>
                            <tr>
                                <td><strong>Target</strong></td>
                                <td>
                                    @if (_pendingExport.ConnectedSystemObject != null)
                                    {
                                        <MudStack Spacing="0">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <ObjectChip Kind="ObjectChipKind.ConnectedSystemObject"
                                                            TypeName="@_pendingExport.ConnectedSystemObject.Type.Name"
                                                            Name="@GetCsoDisplayName()"
                                                            Href="@($"/admin/connected-systems/{ConnectedSystemId}/connector-space/{_pendingExport.ConnectedSystemObject.Id}")"
                                                            Class="ma-0" />
                                            </MudStack>
                                            @* Says where the object lives; the chip above already names what it is,
                                               so the sub-line carries only the place (#1669 follow-up). *@
                                            <span class="mud-text-secondary jim-object-place">
                                                @ObjectDescription.ForConnectedSystemObjectPlace(_pendingExport.ConnectedSystem.Name)
                                            </span>
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <span class="mud-text-secondary">New object (will be created)</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Source</strong></td>
                                <td>
                                    @if (_pendingExport.SourceMetaverseObject != null)
                                    {
                                        <MudStack Spacing="0">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                <ObjectChip Kind="ObjectChipKind.MetaverseObject"
                                                            TypeName="@_pendingExport.SourceMetaverseObject.Type.Name"
                                                            Name="@GetMvoDisplayName()"
                                                            Href="@Utilities.GetMetaverseObjectHref(_pendingExport.SourceMetaverseObject)"
                                                            Class="ma-0" />
                                            </MudStack>
                                            @* Says where the object lives, matching the Target row's own sub-line (#1669 follow-up). *@
                                            <span class="mud-text-secondary jim-object-place">
                                                @ObjectDescription.ForMetaverseObjectPlace()
                                            </span>
                                        </MudStack>
                                    }
                                    else if (_pendingExport.SourceMetaverseObjectId.HasValue)
                                    {
                                        <span>@_pendingExport.SourceMetaverseObjectId</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @if (_pendingExport.ErrorCount > 0 || !string.IsNullOrEmpty(_pendingExport.LastErrorMessage))
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Error" Class="mt-0" Style="align-items: flex-start;">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="line-height: 1.5rem;">Error Information</MudText>
                    <MudSimpleTable Hover="true" Dense="true" Elevation="0" Style="background: transparent;">
                        <tbody>
                            <tr>
                                <td style="width: 200px;"><strong>Error Count</strong></td>
                                <td>
                                    <MudChip T="string" Variant="Variant.Text" Color="Color.Error">
                                        @_pendingExport.ErrorCount / @_pendingExport.MaxRetries
                                    </MudChip>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Last Attempted</strong></td>
                                <td>@(_pendingExport.LastAttemptedAt?.ToFriendlyDate() ?? "-")</td>
                            </tr>
                            @* Next Retry is hidden until event-based sync is implemented
                            <tr>
                                <td><strong>Next Retry</strong></td>
                                <td>@(_pendingExport.NextRetryAt?.ToFriendlyDate() ?? "-")</td>
                            </tr>
                            *@
                            @if (!string.IsNullOrEmpty(_pendingExport.LastErrorMessage))
                            {
                                <tr>
                                    <td><strong>Error Message</strong></td>
                                    <td>
                                        <pre style="white-space: pre-wrap; word-wrap: break-word; margin: 0;">@_pendingExport.LastErrorMessage</pre>
                                    </td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(_pendingExport.LastErrorStackTrace))
                            {
                                <tr>
                                    <td><strong>Stack Trace</strong></td>
                                    <td>
                                        <CollapsibleStackTrace StackTrace="@_pendingExport.LastErrorStackTrace" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudAlert>
            </MudItem>
        }

        @if (_unresolvedReferences.Count > 0)
        {
            @* ─── Unresolved References ─── *@
            @* Each reference change that has not been written yet, and why, computed against the target's
               current state when the page loaded (#1398). The three reasons call for three different
               responses from an administrator, which is why they are told apart rather than lumped as
               "unresolved": one needs nothing, one needs the referenced object's own export to land, and one
               needs the referenced object brought into scope or provisioned. *@
            <MudItem xs="12">
                <MudCard Outlined="true" Elevation="0">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Unresolved References</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body1" Class="mb-3">
                            These reference values have not been written to the Connected System yet. Everything else on this Pending Export is written
                            as soon as it can be; each reference is written when the object it refers to can be addressed in this Connected System.
                        </MudText>
                        <MudSimpleTable Hover="true" Dense="true" Elevation="0">
                            <thead>
                                <tr>
                                    <th>Attribute</th>
                                    <th>Referenced Object</th>
                                    <th>Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reference in _unresolvedReferences)
                                {
                                    <tr @key="reference.AttributeChangeId">
                                        <td><MudText Typo="Typo.body1" Class="mud-text-secondary">@reference.AttributeName</MudText></td>
                                        <td>
                                            <MudTooltip Text="@reference.ReferencedMetaverseObjectId.ToString()" Arrow="true" Placement="Placement.Top">
                                                <MudText Typo="Typo.body1">@(reference.ReferencedMetaverseObjectDisplayName ?? reference.ReferencedMetaverseObjectId.ToString())</MudText>
                                            </MudTooltip>
                                        </td>
                                        <td>
                                            <MudTooltip Arrow="true" Placement="Placement.Top">
                                                <TooltipContent>
                                                    <TooltipText Text="@GetUnresolvedReferenceExplanation(reference.Reason)" />
                                                </TooltipContent>
                                                <ChildContent>
                                                    <MudChip T="string" Variant="Variant.Text" Color="@GetUnresolvedReferenceReasonColour(reference.Reason)">
                                                        @GetUnresolvedReferenceReasonLabel(reference.Reason)
                                                    </MudChip>
                                                </ChildContent>
                                            </MudTooltip>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }

        <MudItem xs="12">
            @if (_pendingExport.AttributeValueChanges.Count > 0)
            {
                @* One row per attribute. The changes came back with the rest of the page (capped per multi-valued
                   attribute), so the search and the sort run over that list in memory. *@
                <AttributeTable TItem="AttributeChangeGroup"
                                Items="@_attributeChangeGroups"
                                Matches="MatchesAttributeChangeSearch"
                                Sort="SortAttributeChanges"
                                DefaultSortBy="attribute"
                                RowClassFunc="@((group, _) => group.TotalCount > 1 ? "jim-attr-row-mva" : string.Empty)"
                                Class="mt-5">
                    <ToolBarExtras>
                        <MudText Typo="Typo.h6">Attribute Changes</MudText>
                        @* Bare number: the title beside it already names the objects (JIM.Web/CLAUDE.md
                           convention). It counts the changes; the table's own count on the right counts the rows,
                           which are attributes, and a multi-valued attribute is one row carrying many changes. *@
                        <TableObjectCount Count="@_attributeChangeTotalCounts.Values.Sum()" Class="ml-2" />
                    </ToolBarExtras>
                    <HeaderContent>
                        <MudTh Class="jim-attr-header-name"><VirtualisedSortHeader Title="Attribute" Name="attribute" /></MudTh>
                        <MudTh><MudText Typo="Typo.button">Change Type</MudText></MudTh>
                        <MudTh><MudText Typo="Typo.button">Status</MudText></MudTh>
                        <MudTh><MudText Typo="Typo.button">Attribute Flow</MudText></MudTh>
                        <MudTh><MudText Typo="Typo.button">Value from</MudText></MudTh>
                        <MudTh Class="jim-attr-header-value"><MudText Typo="Typo.button">Value</MudText></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="jim-attr-name">
                            <MudText Typo="Typo.body1" Class="mud-text-secondary">@context.AttributeName</MudText>
                        </MudTd>
                        <MudTd>
                            @if (context.TotalCount == 1)
                            {
                                @RenderChangeTypeChip(context.Values[0])
                            }
                            else
                            {
                                <MudText Typo="Typo.body1" Class="mud-text-secondary">@context.TotalCount.ToString("N0") changes</MudText>
                            }
                        </MudTd>
                        <MudTd>
                            @if (context.TotalCount == 1)
                            {
                                @RenderStatusChip(context.Values[0])
                            }
                        </MudTd>
                        <MudTd>
                            @* The staging Synchronisation Rule (#399), kept apart from "Value from" below: this
                               names what wrote the value to this Connected System, not where it came from. *@
                            @{ var flow = GetAttributeFlow(context.Values); }
                            @if (flow.Several)
                            {
                                <MudText Class="mud-text-secondary">Several</MudText>
                            }
                            else if (!string.IsNullOrEmpty(flow.SyncRuleName))
                            {
                                <ObjectChip Kind="ObjectChipKind.SynchronisationRule" Name="@flow.SyncRuleName"
                                            Href="@(flow.SyncRuleId.HasValue ? $"/admin/sync-rules/{flow.SyncRuleId}" : null)"
                                            Class="ma-0" />
                            }
                            else
                            {
                                <EmptyValue />
                            }
                        </MudTd>
                        <MudTd>
                            @* Where the Metaverse value originated (#399), as distinct from the Attribute Flow
                               column: an expression or generated value is computed rather than read, and a
                               single-attribute source links into that attribute's Inspect view. *@
                            @{ var source = _valueSourcesByAttributeId.GetValueOrDefault(context.Values[0].AttributeId); }
                            @if (source == null)
                            {
                                <EmptyValue />
                            }
                            else if (source.IsGeneratedValue)
                            {
                                <MudText Typo="Typo.body2">@ValueOriginGrouping.GeneratedValueLabel</MudText>
                            }
                            else if (source.IsComputed)
                            {
                                <AttributeChip Kind="AttributeChipKind.Expression" Expression="@source.Expression" />
                            }
                            else
                            {
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    @if (source.SourceMetaverseAttributeId.HasValue)
                                    {
                                        var sourceAttributeId = source.SourceMetaverseAttributeId.Value;
                                        <MudLink Href="@GetValueFromHref(sourceAttributeId)">@source.SourceMetaverseAttributeName</MudLink>
                                    }
                                    <ValueOriginChip Origin="@source.Origin" HasSeveralOrigins="@source.HasSeveralOrigins" />
                                </MudStack>
                            }
                        </MudTd>
                        <MudTd Class="jim-attr-value">
                            @* An attribute carrying several changes stacks them, each line saying what will happen to
                               its value (its own change type and status), since adding one member and removing another
                               are different things; the row's own Change Type and Status cells summarise instead. *@
                            @{ var group = context; }
                            <AttributeValuesCell TValue="PendingExportAttributeValueChange" Values="@group.Values" TotalCount="@group.TotalCount">
                                <ValueTemplate Context="change">
                                    @if (group.TotalCount == 1)
                                    {
                                        @GetAttributeValue(change)
                                    }
                                    else
                                    {
                                        <span class="jim-one-line-list">
                                            @RenderChangeTypeChip(change)
                                            @RenderStatusChip(change)
                                            <span class="jim-one-line-list-value">@GetAttributeValue(change)</span>
                                        </span>
                                    }
                                </ValueTemplate>
                                <OverflowContent>
                                    <PendingExportMvaTable @key="group.AttributeName"
                                                           ValueCount="@group.TotalCount"
                                                           AttributeName="@group.AttributeName"
                                                           PendingExportId="@Id" />
                                </OverflowContent>
                            </AttributeValuesCell>
                        </MudTd>
                    </RowTemplate>
                </AttributeTable>
            }
            else
            {
                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Attribute Changes (0)</MudText>
                    <MudText Class="mud-text-secondary">
                        @if (_pendingExport.ChangeType == PendingExportChangeType.Delete)
                        {
                            <text>No attribute changes (object will be deleted).</text>
                        }
                        else
                        {
                            <text>No attribute changes recorded.</text>
                        }
                    </MudText>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}
else if (_notFound)
{
    @* A Pending Export is deleted the moment it is exported, so a link to one is only good while it
       is still queued. Saying "not found" implies something is wrong; almost always nothing is, the
       change simply reached its Connected System. Name the likely reasons rather than leave the
       reader wondering whether they have hit a bug. *@
    <MudAlert Severity="Severity.Info">
        This Pending Export is no longer queued. It has either been exported to the Connected System,
        or been superseded by a later change to the same Connected System Object. Pending Exports are
        removed once they are no longer waiting to be applied, so links to an individual one stop
        resolving after its export runs.
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="@($"/admin/connected-systems/{ConnectedSystemId}/pending-exports")" Class="mt-4">
        Back to List
    </MudButton>
}
else
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mt-5" />
}


@* ─── Render Fragments ─── *@

@{
    RenderFragment RenderChangeTypeChip(PendingExportAttributeValueChange change) => __builder =>
    {
        <MudChip T="string" Variant="Variant.Text" Color="GetAttributeChangeTypeColor(change.ChangeType)">
            @change.ChangeType
        </MudChip>
    };

    RenderFragment RenderStatusChip(PendingExportAttributeValueChange change) => __builder =>
    {
        <MudChip T="string" Variant="Variant.Text" Color="GetAttributeChangeStatusColor(change.Status)">
            @change.Status.ToString().SplitOnCapitalLetters()
        </MudChip>
    };
}

@code {
    [Parameter]
    public int ConnectedSystemId { get; set; }

    [Parameter]
    public Guid Id { get; set; }

    private PendingExport? _pendingExport;
    private ConnectedSystemHeader? _connectedSystemHeader;
    private Dictionary<string, int> _attributeChangeTotalCounts = new();
    private List<PendingExportUnresolvedReference> _unresolvedReferences = new();
    private Dictionary<Guid, PendingExportUnresolvedReference> _unresolvedReferencesByChangeId = new();
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private bool _notFound;
    private List<AttributeChangeGroup> _attributeChangeGroups = new();
    private Dictionary<int, PendingExportValueSource> _valueSourcesByAttributeId = new();

    protected override async Task OnParametersSetAsync()
    {
        using var jim = JimFactory.Create();
        _connectedSystemHeader = await jim.ConnectedSystems.GetConnectedSystemHeaderAsync(ConnectedSystemId);
        if (_connectedSystemHeader == null)
        {
            NavManager.NavigateTo("/admin/connected-systems/");
            return;
        }

        var detailResult = await jim.ConnectedSystems.GetPendingExportDetailAsync(Id);
        _pendingExport = detailResult?.PendingExport;
        _attributeChangeTotalCounts = detailResult?.AttributeChangeTotalCounts ?? new();
        _unresolvedReferences = detailResult?.UnresolvedReferences ?? new();
        _unresolvedReferencesByChangeId = _unresolvedReferences.ToDictionary(r => r.AttributeChangeId);
        _valueSourcesByAttributeId = (detailResult?.ValueSources ?? new()).ToDictionary(s => s.ConnectedSystemAttributeId);
        if (_pendingExport == null)
        {
            _notFound = true;
            _breadcrumbs = new List<BreadcrumbItem>
            {
                new("Home", href: "/", icon: Icons.Material.Filled.Home),
                new("Administration", href: "/admin"),
                new("Connected Systems", href: "/admin/connected-systems/"),
                new(_connectedSystemHeader.Name, href: Utilities.GetConnectedSystemHref(_connectedSystemHeader)),
                new("Pending Exports", href: $"/admin/connected-systems/{ConnectedSystemId}/pending-exports"),
                new("Not Found", href: null, disabled: true)
            };
            return;
        }

        // Grouped once here rather than per window read: the grid slices its windows from this list, and
        // re-grouping every change on every scroll would do the same work again for no new information.
        _attributeChangeGroups = GetGroupedChanges();

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("Home", href: "/", icon: Icons.Material.Filled.Home),
            new("Connected Systems", href: "/admin/connected-systems/"),
            new(_connectedSystemHeader.Name, href: Utilities.GetConnectedSystemHref(_connectedSystemHeader)),
            new("Pending Exports", href: $"/admin/connected-systems/{ConnectedSystemId}/pending-exports"),
            new(_pendingExport.ChangeType.ToString(), href: null, disabled: true)
        };
    }

    private string GetCsoDisplayName()
    {
        if (_pendingExport?.ConnectedSystemObject == null)
            return "Unknown";

        return _pendingExport.ConnectedSystemObject.NameOrId
            ?? _pendingExport.ConnectedSystemObject.Id.ToString();
    }

    private string GetMvoDisplayName()
    {
        if (_pendingExport?.SourceMetaverseObject == null)
            return _pendingExport?.SourceMetaverseObjectId?.ToString() ?? "Unknown";

        // Use the built-in DisplayName property which looks up the displayname attribute
        return _pendingExport.SourceMetaverseObject.NameOrId
            ?? _pendingExport.SourceMetaverseObject.Id.ToString();
    }

    private string GetAttributeValue(PendingExportAttributeValueChange change)
    {
        if (!string.IsNullOrEmpty(change.UnresolvedReferenceValue))
        {
            // Named and explained where the detail could work it out; the raw identifier is the fallback for a
            // change loaded some other way (the paged multi-valued dialog reads the same helper).
            if (_unresolvedReferencesByChangeId.TryGetValue(change.Id, out var reference))
                return $"{reference.ReferencedMetaverseObjectDisplayName ?? reference.ReferencedMetaverseObjectId.ToString()} [{GetUnresolvedReferenceReasonLabel(reference.Reason).ToLowerInvariant()}]";
            return $"[Unresolved Reference: {change.UnresolvedReferenceValue}]";
        }

        if (change.StringValue != null)
            return change.StringValue;

        if (change.DateTimeValue.HasValue)
            return change.DateTimeValue.Value.ToFriendlyDate();

        if (change.IntValue.HasValue)
            return change.IntValue.Value.ToString();

        if (change.ByteValue != null)
            return $"[Binary data: {change.ByteValue.Length} bytes]";

        return "[null]";
    }

    private static string GetUnresolvedReferenceReasonLabel(UnresolvedReferenceReason reason) => reason switch
    {
        UnresolvedReferenceReason.Resolvable => "Resolvable on next export",
        UnresolvedReferenceReason.AwaitingAnchor => "Awaiting anchor",
        UnresolvedReferenceReason.NotInTargetSystem => "Not in this Connected System",
        _ => reason.ToString()
    };

    private static MudBlazor.Color GetUnresolvedReferenceReasonColour(UnresolvedReferenceReason reason) => reason switch
    {
        UnresolvedReferenceReason.Resolvable => MudBlazor.Color.Info,
        UnresolvedReferenceReason.AwaitingAnchor => MudBlazor.Color.Warning,
        UnresolvedReferenceReason.NotInTargetSystem => MudBlazor.Color.Error,
        _ => MudBlazor.Color.Default
    };

    private static string GetUnresolvedReferenceExplanation(UnresolvedReferenceReason reason) => reason switch
    {
        UnresolvedReferenceReason.Resolvable => "The referenced object now has an anchor in this Connected System. The reference is written on the next export run.",
        UnresolvedReferenceReason.AwaitingAnchor => "The referenced object exists in this Connected System but does not carry an anchor yet. Its own export has not been executed or confirmed. The reference is written once it has.",
        UnresolvedReferenceReason.NotInTargetSystem => "The referenced object has no Connected System Object in this Connected System. It is out of scope for every Synchronisation Rule into this system, or has not been provisioned. The reference cannot be written until it is.",
        _ => string.Empty
    };

    private static MudBlazor.Color GetAttributeChangeTypeColor(PendingExportAttributeChangeType changeType)
    {
        return changeType switch
        {
            PendingExportAttributeChangeType.Add => MudBlazor.Color.Primary,
            PendingExportAttributeChangeType.Update => MudBlazor.Color.Info,
            PendingExportAttributeChangeType.Remove => MudBlazor.Color.Warning,
            PendingExportAttributeChangeType.RemoveAll => MudBlazor.Color.Error,
            _ => MudBlazor.Color.Default,
        };
    }

    private static MudBlazor.Color GetAttributeChangeStatusColor(PendingExportAttributeChangeStatus status)
    {
        return status switch
        {
            PendingExportAttributeChangeStatus.Pending => MudBlazor.Color.Default,
            PendingExportAttributeChangeStatus.ExportedPendingConfirmation => MudBlazor.Color.Info,
            PendingExportAttributeChangeStatus.ExportedNotConfirmed => MudBlazor.Color.Warning,
            PendingExportAttributeChangeStatus.Failed => MudBlazor.Color.Error,
            _ => MudBlazor.Color.Default,
        };
    }

    /// <summary>
    /// The staging Synchronisation Rule for an attribute's queued changes (#399's Attribute Flow column). A
    /// multi-valued attribute's values can carry different staging rules (values queued across separate export
    /// evaluations), in which case naming just one would misrepresent the row; <c>Several</c> covers that case.
    /// </summary>
    private static (int? SyncRuleId, string? SyncRuleName, bool Several) GetAttributeFlow(List<PendingExportAttributeValueChange> values)
    {
        var distinctRules = values.Select(v => (v.SyncRuleId, v.SyncRuleName)).Distinct().ToList();
        if (distinctRules.Count > 1)
            return (null, null, true);

        var only = distinctRules[0];
        return (only.SyncRuleId, only.SyncRuleName, false);
    }

    /// <summary>
    /// The source Metaverse Object's Inspect view for one of its attributes (#399's "Value from" link). The
    /// source Metaverse Object is the same one for every attribute on this Pending Export, so only the target
    /// attribute id varies per call.
    /// </summary>
    private string? GetValueFromHref(int metaverseAttributeId)
    {
        var mvo = _pendingExport?.SourceMetaverseObject;
        if (mvo?.Type == null)
            return null;

        return Utilities.GetMetaverseObjectInspectHref(mvo.Id, mvo.Type.PluralName, metaverseAttributeId);
    }

    private List<AttributeChangeGroup> GetGroupedChanges()
    {
        if (_pendingExport == null)
            return new List<AttributeChangeGroup>();

        return _pendingExport.AttributeValueChanges
            .GroupBy(v => v.Attribute?.Name ?? $"Attribute {v.AttributeId}")
            .Select(g => new AttributeChangeGroup(
                g.Key,
                g.ToList(),
                _attributeChangeTotalCounts.GetValueOrDefault(g.Key, g.Count())))
            .OrderBy(g => g.AttributeName)
            .ToList();
    }

    /// <summary>
    /// Whether an attribute matches the table's search: its name, or the value of any of its loaded changes.
    /// </summary>
    private bool MatchesAttributeChangeSearch(AttributeChangeGroup group, string search) =>
        group.AttributeName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        group.Values.Any(v => GetAttributeValue(v).Contains(search, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Orders the attributes by name, the one sort the table's headers offer.
    /// </summary>
    private static IEnumerable<AttributeChangeGroup> SortAttributeChanges(
        IEnumerable<AttributeChangeGroup> groups, string sortBy, bool descending) =>
        descending
            ? groups.OrderByDescending(g => g.AttributeName, StringComparer.OrdinalIgnoreCase)
            : groups.OrderBy(g => g.AttributeName, StringComparer.OrdinalIgnoreCase);

    /// <summary>
    /// One row of the attribute changes table: an attribute and the queued changes to it this Pending Export
    /// carries. Public so the component tests can read the table's rows by name.
    /// </summary>
    public record AttributeChangeGroup(
        string AttributeName,
        List<PendingExportAttributeValueChange> Values,
        int TotalCount);
}
