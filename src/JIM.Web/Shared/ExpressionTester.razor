@if (!string.IsNullOrWhiteSpace(Expression))
{
    <MudText Typo="Typo.subtitle2" Class="mt-5">Test this Expression</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
        Supply a sample value for each attribute the Expression reads and see what it produces, before saving it and
        finding out from a Synchronisation. Leave an input empty to see what the Expression does when the object has
        no value for it.
        @if (TestsAttributeFlow)
        {
            @: Each value is read as its attribute's type, and the result goes through this Attribute Flow's value
            @: processing and Missing Input Behaviour, exactly as a Synchronisation would.
        }
    </MudText>

    @if (_inputs.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            This Expression reads no attributes, so it produces the same value for every object. Run the test to see it.
        </MudText>
    }
    else
    {
        <MudGrid Spacing="2" Class="mt-1">
            @foreach (var input in _inputs)
            {
                var accessor = input.Accessor;
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" Label="@accessor" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" Clearable="true"
                                  Value="@GetSampleValue(accessor)"
                                  ValueChanged="@(v => SetSampleValue(accessor, v))" />
                </MudItem>
            }
        </MudGrid>
    }

    <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-3"
               OnClick="RunTest">Run test</MudButton>

    @if (_inputErrors.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">
            @foreach (var inputError in _inputErrors)
            {
                <MudText Typo="Typo.body2">@inputError</MudText>
            }
        </MudAlert>
    }

    @if (_result != null)
    {
        @if (_result.IsValid)
        {
            <MudPaper Outlined="true" Class="pa-3 mt-3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Output</MudText>
                @if (_outputLines.Count == 0)
                {
                    <MudText Typo="Typo.body1"><EmptyValue /></MudText>
                    @if (_flowEvaluation == null)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            The Expression returned no value. JIM treats that as an authoritative "no value" from this
                            contribution, resolved by Attribute Priority and "Null is a value".
                        </MudText>
                    }
                }
                else
                {
                    @* One value per line, each as JIM writes it to a Text attribute *@
                    @foreach (var line in _outputLines)
                    {
                        <MudText Typo="Typo.body1" Class="jim-expression-output">@line</MudText>
                    }
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Type: @_result.ResultType</MudText>
                }
            </MudPaper>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">
                @_result.ErrorMessage
                @if (_errorPosition.HasValue)
                {
                    var position = _errorPosition.Value;
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Position @position</MudText>
                }
            </MudAlert>
        }
    }

    @* What synchronisation would do with it (#2055): the same pipeline a synchronisation runs, so an Expression that
       evaluates but whose result the target cannot hold fails here as it fails there. *@
    @if (_flowEvaluation != null)
    {
        var evaluation = _flowEvaluation;
        <MudPaper Outlined="true" Class="pa-3 mt-3">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">What a Synchronisation would do</MudText>
            @if (evaluation.Outcome == AttributeFlowOutcome.Values)
            {
                @foreach (var line in evaluation.Values.Select(ExpressionText.Describe))
                {
                    <MudText Typo="Typo.body1" Class="jim-expression-output">@line</MudText>
                }
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@_flowDescription Type: @evaluation.TargetType</MudText>
            }
            else
            {
                <MudAlert Severity="@(evaluation.Outcome == AttributeFlowOutcome.Error ? Severity.Error : Severity.Info)" Dense="true">
                    @_flowDescription
                </MudAlert>
            }
        </MudPaper>
    }
}

@code {
    /// <summary>
    /// The Expression to test. The inputs offered below are resolved from it, so they follow it as it is edited.
    /// </summary>
    [Parameter]
    public string? Expression { get; set; }

    /// <summary>
    /// Raised whenever a sample value changes, carrying a snapshot of every value entered so far (keyed by
    /// accessor, e.g. <c>cs["firstName"]</c>). Unset by every call site except the "Generated Value" live
    /// preview (Unique Value Generation, #242, Phase 3, Work Package D2), which evaluates the base expression
    /// against these same sample values so the preview matches what "Run test" would show.
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyDictionary<string, string?>> SampleValuesChanged { get; set; }

    /// <summary>
    /// The Synchronisation Rule the Attribute Flow belongs to, whose object types give each sample its attribute's type.
    /// With <see cref="Mapping"/> and <see cref="Source"/>, the test runs the Attribute Flow as a Synchronisation would
    /// (#2055); without them, the Expression is evaluated alone.
    /// </summary>
    [Parameter]
    public SyncRule? SyncRule { get; set; }

    /// <summary>
    /// The Attribute Flow being edited: its target attribute and value processing, read as they stand when the test runs.
    /// </summary>
    [Parameter]
    public SyncRuleMapping? Mapping { get; set; }

    /// <summary>
    /// The source being edited: its Missing Input Behaviour, read as it stands when the test runs.
    /// </summary>
    [Parameter]
    public SyncRuleMappingSource? Source { get; set; }

    private IReadOnlyList<ExpressionInput> _inputs = Array.Empty<ExpressionInput>();
    private readonly Dictionary<string, string?> _sampleValues = new();
    private ExpressionTestResult? _result;
    private IReadOnlyList<string> _outputLines = Array.Empty<string>();
    private int? _errorPosition;
    private string? _resolvedFrom;
    private IReadOnlyList<string> _inputErrors = Array.Empty<string>();
    private AttributeFlowEvaluation? _flowEvaluation;
    private string? _flowDescription;

    /// <summary>
    /// The target attribute's name when the Attribute Flow has one to test against, by direction.
    /// </summary>
    private string? FlowTargetName => SyncRule?.Direction == SyncRuleDirection.Export
        ? Mapping?.TargetConnectedSystemAttribute?.Name
        : Mapping?.TargetMetaverseAttribute?.Name;

    private bool TestsAttributeFlow => SyncRule != null && Source != null && FlowTargetName != null;

    protected override void OnParametersSet()
    {
        // Re-resolve only when the Expression itself changed: the sample values are keyed on accessors, so
        // re-resolving on every render would discard nothing, but the result below must not outlive its Expression.
        if (_resolvedFrom == Expression)
            return;

        _resolvedFrom = Expression;
        _inputs = ExpressionInputResolver.Resolve(Expression);
        ClearResult();
    }

    private void ClearResult()
    {
        _result = null;
        _errorPosition = null;
        _inputErrors = Array.Empty<string>();
        _flowEvaluation = null;
        _flowDescription = null;
    }

    private string? GetSampleValue(string accessor) => _sampleValues.GetValueOrDefault(accessor);

    private async Task SetSampleValue(string accessor, string? value)
    {
        _sampleValues[accessor] = value;

        // The displayed output belongs to the values that produced it; keeping it beside changed inputs would
        // read as the answer to a question that was not asked.
        ClearResult();

        if (SampleValuesChanged.HasDelegate)
            await SampleValuesChanged.InvokeAsync(_sampleValues);
    }

    private void RunTest()
    {
        if (string.IsNullOrWhiteSpace(Expression))
            return;

        ClearResult();

        var validation = ExpressionEvaluator.Validate(Expression);
        if (!validation.IsValid)
        {
            _result = ExpressionTestResult.Failure(validation.ErrorMessage ?? "The Expression could not be parsed.");
            _errorPosition = validation.ErrorPosition;
            return;
        }

        if (TestsAttributeFlow)
        {
            RunAttributeFlowTest(Expression);
            return;
        }

        var metaverseAttributes = new Dictionary<string, object?>();
        var connectedSystemAttributes = new Dictionary<string, object?>();

        foreach (var input in _inputs)
        {
            // An empty box means the object has no value for that attribute, which is the case worth being able to
            // see: an Expression that reads it will produce whatever it produces from nothing.
            var sampleValue = _sampleValues.GetValueOrDefault(input.Accessor);
            var value = string.IsNullOrEmpty(sampleValue) ? null : (object)sampleValue;

            if (input.Source == ExpressionInputSource.Metaverse)
                metaverseAttributes[input.AttributeName] = value;
            else
                connectedSystemAttributes[input.AttributeName] = value;
        }

        _result = ExpressionEvaluator.Test(Expression, new ExpressionContext(metaverseAttributes, connectedSystemAttributes));

        // Several values show one per line rather than as their list's type name (#2179), and every value shows in
        // JIM's one text form, so a date reads as it would be written to a Text attribute (#2153, N1).
        _outputLines = _result.IsValid ? ExpressionText.ToDisplayLines(_result.Result) : Array.Empty<string>();
    }

    /// <summary>
    /// Runs the Attribute Flow being edited through the evaluation pipeline a Synchronisation runs (#2055): each sample
    /// read as its attribute's type, then Missing Input Behaviour, the Expression, value processing and conversion to
    /// the target attribute's type. An empty box is no value.
    /// </summary>
    private void RunAttributeFlowTest(string expression)
    {
        var inputs = _inputs
            .Select(input => new AttributeFlowTestInput(input.Source, input.AttributeName,
                string.IsNullOrEmpty(_sampleValues.GetValueOrDefault(input.Accessor))
                    ? Array.Empty<object>()
                    : new object[] { _sampleValues[input.Accessor]! }))
            .ToList();

        // The source as it stands in the editor, with the Expression as typed.
        var source = new SyncRuleMappingSource { Expression = expression, MissingInputBehaviour = Source!.MissingInputBehaviour };
        var tested = AttributeFlowTester.Test(SyncRule!, Mapping!, source, inputs, ExpressionEvaluator);

        if (tested.Evaluation is not { } evaluation)
        {
            _inputErrors = tested.InputErrors;
            return;
        }

        _flowEvaluation = evaluation;
        _flowDescription = AttributeFlowTester.Describe(evaluation, FlowTargetName!);

        // The Expression's own result, as before, beside what the Attribute Flow would then do with it. A failed
        // Expression has no result; the outcome's description, which carries its message, takes its place.
        if (evaluation.Source.Outcome == ExpressionSourceOutcome.EvaluationFailed)
        {
            _result = ExpressionTestResult.Failure(_flowDescription);
            _flowEvaluation = null;
            return;
        }

        if (evaluation.Source.Outcome is ExpressionSourceOutcome.Result or ExpressionSourceOutcome.NoValue && evaluation.Source.MissingInputs.Count == 0)
        {
            var output = evaluation.Source.Result;
            _result = ExpressionTestResult.Success(output);
            _outputLines = ExpressionText.ToDisplayLines(output);
        }
    }
}
