# Auto detect text files and normalize line endings to LF
* text=auto

# Shell scripts - always LF
*.sh text eol=lf
.devcontainer/** text eol=lf
.githooks/* text eol=lf

# Batch files - always CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source code - always LF
*.cs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.html text eol=lf
*.razor text eol=lf
*.css text eol=lf
*.md text eol=lf

# CHANGELOG: union-merge concurrent [Unreleased] entries so parallel branches and
# releases combine automatically instead of conflicting on every merge/rebase.
#
# The cost is that union merging re-adds lines rather than reconciling them, so a
# branch that merges or rebases across a release brings the entries it contributed
# back into [Unreleased], where they read as unshipped work. scripts/Lint-Changelog.ps1
# fails the build on an entry that has already shipped in a released section, and on
# two identical entries in one subsection, so the re-add is caught at PR time rather
# than found in the next release notes. Duplicate ### headers are not detected; eyeball
# the section after a merge.
CHANGELOG.md merge=union

# The docs conformance baseline (#1454) keeps one sorted line per rule and page, so two pull
# requests that lower neighbouring entries touch adjacent lines, which git reports as a conflict.
# A union merge keeps both sides instead; where that leaves two lines for one rule and page,
# Test-DocsConformance.ps1 takes the lower count, and a line the other side removed comes back
# only to fail the check until -UpdateBaseline removes it again.
docs/.conformance/baseline.tsv merge=union

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.otf binary
*.db binary

# Podman deployment files are read by Podman and systemd on Linux hosts
deploy/podman/** text eol=lf

# The deployment lab runs on a Linux host and sends bash, embedded in its PowerShell, to Linux VMs: a CR at the end of
# each line breaks that bash, so these keep LF even though *.ps1 is CRLF elsewhere
test/ci/deployment/lab/** text eol=lf

# Integration test images are built on Linux from these files (Dockerfiles, LDIF, ACL/SDDL, shell): a CR at the
# end of each line corrupts what they feed to the directory tools (Samba rejected the JIM delegation SDDL), so
# they keep LF even on a Windows checkout
test/integration/docker/** text eol=lf
test/integration/docker/**/*.ps1 text eol=crlf
