# Root entry and base OUs for Yellowstone (dc=yellowstone,dc=local)
# Loaded automatically by Bitnami into the LDAP_ROOT database.
#
# IMPORTANT: When LDAP_CUSTOM_LDIF_DIR contains files, Bitnami skips
# the default tree creation, so we must create the root entry ourselves.

dn: dc=yellowstone,dc=local
objectClass: dcObject
objectClass: organization
dc: yellowstone
o: Yellowstone Test Organisation

dn: ou=People,dc=yellowstone,dc=local
objectClass: organizationalUnit
ou: People

dn: ou=Groups,dc=yellowstone,dc=local
objectClass: organizationalUnit
ou: Groups

# Delegated JIM service account (issue #1715). JIM's Connected Systems bind
# as this identity instead of the directory administrator (cn=admin), so the
# lab exercises the access-control set a customer would actually grant.
# ou=Policies and its ppolicy default policy are added later by
# scripts/01-add-second-suffix.sh: pwdPolicy needs the ppolicy schema, which
# is only registered once the ppolicy module is loaded into a running slapd,
# and this file is loaded by Bitnami's entrypoint before slapd is ever
# started with our modules configured.
dn: ou=Services,dc=yellowstone,dc=local
objectClass: organizationalUnit
ou: Services

# Password is "Svc-Jim@123!", hashed with slappasswd -s. Deliberately
# different from the admin password (Test@123!) so an accidental rootDN bind
# by a Connected System does not pass unnoticed.
dn: cn=svc-jim,ou=Services,dc=yellowstone,dc=local
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: svc-jim
description: Delegated account JIM's Connected Systems bind as (#1715). Not for interactive or administrative use.
userPassword: {SSHA}r7H2mmv2uzFq1oLpedFt7GS+XFIYGWDL

# Dedicated account for a Connected System that imports MORE THAN ONE
# partition from this server (issue #1715): a single import scoped across
# both the Yellowstone and Glitterband suffixes needs one identity that can
# bind against both, which a single-suffix service account cannot do (each
# suffix's cn=jim group only grants its own suffix's account). This account
# is added as a member of both suffixes' cn=jim groups (see the group entry
# below, and scripts/01-add-second-suffix.sh for Glitterband's). A
# single-partition Connected System keeps using its own suffix's cn=svc-jim
# account and is unaffected: isolation between suffixes still holds for it.
# Password is "Svc-Jim-Partitions@123!", hashed with slappasswd -s.
dn: cn=svc-jim-partitions,ou=Services,dc=yellowstone,dc=local
objectClass: organizationalRole
objectClass: simpleSecurityObject
cn: svc-jim-partitions
description: Delegated account for a JIM Connected System that imports more than one partition from this server (#1715); a member of every suffix's cn=jim group it manages. Not for interactive or administrative use.
userPassword: {SSHA}9wQ2EQ4pXjXIti57jJjDuqNEKEcVMdOB

# Members of this group may bind as JIM's Connected System service account
# for THIS suffix (issue #1715): the access-control set in
# ../acl/jim-service-account-access.ldif grants to "group.exact" this DN,
# not to an individual account's DN. To delegate a new Connected System (or a
# second one against the same suffix), add its service account as a further
# "member" here; no ACL change is needed. A Connected System that imports
# more than one partition from this server is a member of each partition's
# cn=jim group (see cn=svc-jim-partitions above).
dn: cn=jim,ou=Services,dc=yellowstone,dc=local
objectClass: groupOfNames
cn: jim
description: JIM service accounts permitted to manage dc=yellowstone,dc=local (#1715). Membership, not the ACL, controls which accounts this grants.
member: cn=svc-jim,ou=Services,dc=yellowstone,dc=local
member: cn=svc-jim-partitions,ou=Services,dc=yellowstone,dc=local
