@* A source named quietly (#399): a swatch in the colour the contribution bar gives that source, then the source's *@
@* legend label ("HR"), then optionally the Synchronisation Rule as secondary text. Used where many rows name  *@
@* sources at once (the Inspect table's Source column), so the eye can scan them against the bar's legend      *@
@* without a column of pills competing with the values. The full origin is always on the title.               *@

<span class="jim-source-dot-label" title="@Title">
    <span class="jim-source-dot" style="background: var(@ValueOriginGrouping.ColourTokenFor(Group));" aria-hidden="true"></span>
    <span class="jim-source-dot-name">@NameText</span>
    @if (ShowRule && RuleText != null)
    {
        @* The same dot a group header puts before its count; a gap alone reads the system and its rule as one name. *@
        <span class="jim-source-dot-sep" aria-hidden="true">·</span>
        <span class="jim-source-dot-rule">@RuleText</span>
    }
    @if (ShowsGeneratedValue)
    {
        @* The end of the path: the Attribute Flow generated the value rather than reading it (System · Rule · Generated Value). *@
        <span class="jim-source-dot-sep" aria-hidden="true">·</span>
        <span class="jim-source-dot-type">@ValueOriginGrouping.GeneratedValueLabel</span>
    }
</span>

@code {
    /// <summary>The source, as the contribution bar groups and labels it, so the dot and text match its legend.</summary>
    [Parameter, EditorRequired]
    public ValueOriginGrouping.Group Group { get; set; } = null!;

    /// <summary>
    /// Also names the Synchronisation Rule as secondary text, where the column has room for it. Omitted when the
    /// label already names the rule (a system contributing through more than one rule).
    /// </summary>
    [Parameter]
    public bool ShowRule { get; set; }

    /// <summary>A Generated Value that names the Connected System it came through, so the path has a system to end.</summary>
    private bool ShowsGeneratedValue => Group.Kind == ValueOriginKind.GeneratedValue && !string.IsNullOrEmpty(Group.ConnectedSystemName);

    /// <summary>
    /// The legend label, less the Generated Value ending when this renders that ending as its own part, so the
    /// path reads System · Rule · Generated Value however much of it the column has room for.
    /// </summary>
    private string NameText
    {
        get
        {
            var suffix = $" · {ValueOriginGrouping.GeneratedValueLabel}";
            return ShowsGeneratedValue && Group.Label.EndsWith(suffix, StringComparison.Ordinal)
                ? Group.Label[..^suffix.Length]
                : Group.Label;
        }
    }

    private string? RuleText
    {
        get
        {
            if (Group.SyncRuleDeleted)
                return NameText.Contains("rule deleted") ? null : "rule deleted";
            if (string.IsNullOrEmpty(Group.SyncRuleName) || NameText.Contains(Group.SyncRuleName))
                return null;
            return Group.SyncRuleName;
        }
    }

    private string Title
    {
        get
        {
            var parts = new List<string?>();
            if (Group.Kind is ValueOriginKind.SynchronisationRule or ValueOriginKind.GeneratedValue)
            {
                parts.Add(Group.ConnectedSystemName);
                parts.Add(Group.SyncRuleDeleted ? "rule deleted" : Group.SyncRuleName);
                if (Group.Kind == ValueOriginKind.GeneratedValue)
                    parts.Add(ValueOriginGrouping.GeneratedValueLabel);
            }
            else
            {
                parts.Add(Group.Label);
            }
            return string.Join(" · ", parts.Where(p => !string.IsNullOrEmpty(p)));
        }
    }
}
