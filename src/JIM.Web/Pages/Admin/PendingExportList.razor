@page "/admin/connected-systems/{Id:int}/pending-exports"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Staging.DTOs
@using JIM.Models.Transactional
@using JIM.Models.Transactional.DTOs
@using JIM.Utilities
@using JIM.Web.Models
@using JIM.Web.Services
@using JIM.Web.Shared
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Pending Exports: @_connectedSystemHeader?.Name</PageTitle>
<MudText Typo="Typo.h3"><span>Pending Exports:</span> <span class="mud-primary-text">@_connectedSystemHeader?.Name</span></MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    Pending Exports are changes that need to be applied to the Connected System. These are created when Metaverse Objects
    change and need to be synchronised to this target system.
</MudText>

@if (_connectedSystemHeader != null)
{
    <MudPaper Elevation="0" Class="pa-4 mt-4" Outlined="true">
        <MudSelect T="PendingExportStatus" Label="Filter by Status" MultiSelection="true"
                   SelectedValues="_statusFilters" SelectedValuesChanged="OnStatusFiltersChanged"
                   MultiSelectionTextFunc="@GetStatusFilterText"
                   Variant="Variant.Outlined" Clearable="true" Dense="true" Style="max-width: 350px;">
            <MudSelectItem T="PendingExportStatus" Value="@PendingExportStatus.Pending">Pending</MudSelectItem>
            <MudSelectItem T="PendingExportStatus" Value="@PendingExportStatus.Executing">Executing</MudSelectItem>
            <MudSelectItem T="PendingExportStatus" Value="@PendingExportStatus.ExportNotConfirmed">Export Not Confirmed</MudSelectItem>
            <MudSelectItem T="PendingExportStatus" Value="@PendingExportStatus.Failed">Failed</MudSelectItem>
            <MudSelectItem T="PendingExportStatus" Value="@PendingExportStatus.Exported">Exported</MudSelectItem>
        </MudSelect>
    </MudPaper>

    @* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count, density, the
       search box) lives in the shared grid; this page supplies the columns, the window loader, the Status filter
       above and the empty states. *@
    <VirtualisedDataGrid @ref="_grid" T="PendingExportHeader"
                         ContainerId="pending-export-list"
                         DefaultSortBy="created"
                         DefaultSortDescending="true"
                         LoadWindow="LoadWindowAsync"
                         RowClicked="HandleRowClicked"
                         SingularName="Pending Export"
                         PluralName="Pending Exports"
                         SearchPlaceholder="Search target, source MVO, or errors">
        <Columns>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Change Type" Name="changetype" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetPendingExportChangeTypeColor(context.Item.ChangeType)" Style="font-size: 1rem;">
                        @context.Item.ChangeType
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Status" Name="status" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetPendingExportStatusColor(context.Item.Status)" Style="font-size: 1rem;">
                        @context.Item.Status.ToString().SplitOnCapitalLetters()
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Source MVO" Name="sourcemvo" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.SourceMetaverseObjectId.HasValue)
                    {
                        var sourceMetaverseObjectId = context.Item.SourceMetaverseObjectId.Value;
                        @* The row navigates on click and so does this link; stopping the click here keeps a link
                           click to one navigation while preserving middle-click and open-in-new-tab. *@
                        <span @onclick:stopPropagation="true">
                            <MudLink Href="@($"/admin/metaverse/objects/{sourceMetaverseObjectId}")">
                                @(context.Item.SourceMetaverseObjectDisplayName ?? sourceMetaverseObjectId.ToString())
                            </MudLink>
                        </span>
                    }
                    else
                    {
                        <EmptyValue />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Target Object" Name="targetobject" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.ConnectedSystemObjectId.HasValue)
                    {
                        var connectedSystemObjectId = context.Item.ConnectedSystemObjectId.Value;
                        <span @onclick:stopPropagation="true">
                            <MudLink Href="@($"/admin/connected-systems/{Id}/connector-space/{connectedSystemObjectId}")">
                                @(context.Item.TargetObjectIdentifier ?? connectedSystemObjectId.ToString())
                            </MudLink>
                        </span>
                    }
                    else
                    {
                        <span class="mud-text-secondary">New object</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Changes" Name="changes" />
                </HeaderTemplate>
                <CellTemplate>
                    @context.Item.AttributeChangeCount
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Created" Name="created" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudTooltip Text="@context.Item.CreatedAt.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                        <span>@context.Item.CreatedAt.ToLocalTime().ToRelativeTime()</span>
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Errors" Name="errors" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.ErrorCount > 0)
                    {
                        <MudChip T="string" Variant="Variant.Text" Color="Color.Error">
                            @context.Item.ErrorCount / @context.Item.MaxRetries
                        </MudChip>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="References Owed" Name="references" />
                </HeaderTemplate>
                <CellTemplate>
                    @* How many reference changes this export could not write yet because their targets
                       have no resolvable object in the Connected System (#1398); the detail page explains
                       each owed reference and its reason. *@
                    @if (context.Item.UnresolvedReferenceCount > 0)
                    {
                        <MudTooltip Text="This export was written without these references; they retry automatically once their targets exist. The detail page explains each one." Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Warning">
                                @context.Item.UnresolvedReferenceCount
                            </MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <EmptyValue />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Next Retry" Name="nextretry" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.NextRetryAt.HasValue)
                    {
                        var nextRetryAt = context.Item.NextRetryAt.Value;
                        @nextRetryAt.ToFriendlyDate()
                    }
                    else
                    {
                        <EmptyValue />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <EmptyContent Context="grid">
            @* An empty list means one of three different things, and the message says which: a search that matched
               nothing, a Status filter that matched nothing (each with the way out as the action), or genuinely no
               Pending Exports, which is the good state: everything has been exported. *@
            @if (!string.IsNullOrWhiteSpace(grid.SearchText))
            {
                <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                 PrimaryText="@($"No Pending Exports match \"{grid.SearchText}\"")"
                                 SecondaryText="Try a different search term, or clear the search."
                                 ActionText="Clear Search"
                                 OnAction="@(() => grid.ClearSearchAsync())" />
            }
            else if (_statusFilters.Any())
            {
                <TableEmptyState Icon="@Icons.Material.Filled.FilterAlt"
                                 PrimaryText="No Pending Exports match the Status filter"
                                 SecondaryText="Try different statuses, or clear the filter."
                                 ActionText="Clear Filter"
                                 OnAction="@(() => OnStatusFiltersChanged(new HashSet<PendingExportStatus>()))" />
            }
            else
            {
                <TableEmptyState Icon="@Icons.Material.Filled.TaskAlt"
                                 PrimaryText="No Pending Exports"
                                 SecondaryText="Changes waiting to be written to this Connected System appear here." />
            }
        </EmptyContent>
    </VirtualisedDataGrid>
}
else
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mt-5" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private VirtualisedDataGrid<PendingExportHeader>? _grid;
    private ConnectedSystemHeader? _connectedSystemHeader;
    private IReadOnlyCollection<PendingExportStatus> _statusFilters = new HashSet<PendingExportStatus>();
    private List<BreadcrumbItem> _breadcrumbs = null!;

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _connectedSystemHeader = await jim.ConnectedSystems.GetConnectedSystemHeaderAsync(Id);
        if (_connectedSystemHeader == null)
        {
            NavManager.NavigateTo("../");
            return;
        }

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("Home", href: "/", icon: Icons.Material.Filled.Home),
            new("Administration", href: "/admin"),
            new("Connected Systems", href: "/admin/connected-systems/"),
            new(_connectedSystemHeader.Name, href: Utilities.GetConnectedSystemHref(_connectedSystemHeader)),
            new("Pending Exports", href: null, disabled: true)
        };
    }

    private async Task<VirtualisedWindow<PendingExportHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        using var jim = JimFactory.Create();
        var result = await jim.ConnectedSystems.GetPendingExportHeadersRangeAsync(
            Id,
            request.StartIndex,
            request.Count,
            _statusFilters.Any() ? _statusFilters : null,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            includeTotalCount: request.IncludeTotalCount);

        return new VirtualisedWindow<PendingExportHeader>(result.Results, result.TotalResults);
    }

    private string GetStatusFilterText(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues == null || selectedValues.Count == 0)
            return "All";

        if (selectedValues.Count == 1)
            return selectedValues[0].SplitOnCapitalLetters();

        return $"{selectedValues.Count} selected";
    }

    /// <summary>
    /// Applies a Status filter change and reloads the grid. The filter changes which objects match, so the total
    /// (and the unfiltered baseline it anchors) must be re-counted, and the reader's scroll position describes a
    /// match set that no longer exists, so they are returned to the top.
    /// </summary>
    private async Task OnStatusFiltersChanged(IReadOnlyCollection<PendingExportStatus> newFilters)
    {
        _statusFilters = newFilters;

        if (_grid != null)
        {
            await _grid.ResetScrollAsync();
            await _grid.RefreshAsync(invalidateTotals: true);
        }
    }

    private void HandleRowClicked(PendingExportHeader item)
    {
        NavManager.NavigateTo($"/admin/connected-systems/{Id}/pending-exports/{item.Id}");
    }
}
