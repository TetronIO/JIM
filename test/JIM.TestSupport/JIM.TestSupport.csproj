<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="4.6.1" />
    <!-- Same version the solution already resolves transitively via Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3
         in JIM.PostgresData; referenced directly here so DatabaseIsolationSnapshot reads through raw ADO rather
         than an EF context, sharing nothing with the code it checks. Not a new dependency. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- InMemoryServiceSettingsRepository (#1781): a minimal fake of IServiceSettingsRepository so a test can
         construct a JimApplication/FeatureFlagServer with flags on without mocking the whole ServiceSettings
         audit path. See test/CLAUDE.md > "Tests run with flags on". -->
    <ProjectReference Include="..\..\src\JIM.Data\JIM.Data.csproj" />
    <ProjectReference Include="..\..\src\JIM.Models\JIM.Models.csproj" />
  </ItemGroup>

</Project>
