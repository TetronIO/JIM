@* Sets the password on one account in a Connected System, at an administrator's request (issue #1121).  *@
@* The manual counterpart to the initial password an export delivers: the account whose provisioning     *@
@* password was parked, the person who never received theirs, the reset that has to happen now.          *@
@*                                                                                                       *@
@* The value is masked from the moment it is generated, and copy works while it is masked, so handing a  *@
@* password to somebody never requires putting it on a screen. Reveal is the secondary affordance, for   *@
@* reading it aloud or checking a transcription, and re-conceals on a timer.                             *@
@*                                                                                                       *@
@* This component holds the password in memory for as long as it is open and writes it nowhere. It is    *@
@* handed to the caller's SetPassword delegate and dropped when the dialog closes.                       *@

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Style="min-width: 460px;">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Sets the password on <b>@ObjectName</b> in <b>@ConnectedSystemName</b>. JIM writes it straight to the
                Connected System; it is not staged, not retried, and not stored anywhere in JIM.
            </MudText>

            @if (!ConnectorCanSetPasswords)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="jim-set-password-unsupported">
                    This Connected System's Connector cannot set passwords, so there is nothing to do here.
                </MudAlert>
            }
            else
            {
                @* Immediate, so the Set button follows what has been typed rather than waiting for a blur. *@
                <MudTextField T="string" Value="@_password" Label="Password" Immediate="true"
                              Variant="Variant.Outlined"
                              InputType="@(_revealed ? InputType.Text : InputType.Password)"
                              Placeholder="Generate one, or type your own"
                              ValueChanged="@(value => _password = value ?? string.Empty)"
                              data-testid="jim-set-password-value" />

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                               StartIcon="@Icons.Material.Filled.Casino" OnClick="Generate"
                               data-testid="jim-set-password-generate">Generate</MudButton>

                    @* Copy deliberately does not require a reveal: transferring a password to the person who *@
                    @* needs it should never mean putting it on screen where it can be read over a shoulder.  *@
                    <MudTooltip Text="@CopyTooltip" Arrow="true" Placement="Placement.Top">
                        <span>
                            <MudButton Variant="Variant.Outlined" DropShadow="false"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       Disabled="@(!CanCopy)" OnClick="CopyAsync"
                                       data-testid="jim-set-password-copy">Copy</MudButton>
                        </span>
                    </MudTooltip>

                    <MudButton Variant="Variant.Text" DropShadow="false"
                               StartIcon="@(_revealed ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                               Disabled="@(_password.Length == 0)" OnClick="ToggleRevealAsync"
                               data-testid="jim-set-password-reveal">@(_revealed ? "Hide" : "Reveal")</MudButton>
                </MudStack>

                @if (_revealed)
                {
                    <MudText Typo="Typo.caption" class="mud-text-secondary" data-testid="jim-set-password-reveal-notice">
                        Hidden again automatically in @($"{RevealDuration.TotalSeconds:0}") seconds.
                    </MudText>
                }

                <MudSelect T="PasswordExpiryBehaviour" Label="After the password is set" @bind-Value="_expiryBehaviour"
                           Variant="Variant.Outlined" Dense="true" data-testid="jim-set-password-expiry">
                    @foreach (var behaviour in SupportedExpiryBehaviours)
                    {
                        <MudSelectItem Value="behaviour">@DescribeExpiryBehaviour(behaviour)</MudSelectItem>
                    }
                </MudSelect>

                <MudSwitch T="bool" @bind-Value="_enableAccount" Color="Color.Primary"
                           Label="Enable the account as part of setting the password"
                           data-testid="jim-set-password-enable" />

                @if (!_clipboardAvailable)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true"
                              data-testid="jim-set-password-no-clipboard">
                        Copying is unavailable because this page was not served over HTTPS. Browsers only allow
                        clipboard access in a secure context.
                    </MudAlert>
                }

                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    JIM clears the clipboard when this dialog closes where the browser allows it, but your operating
                    system may keep a copy in its own clipboard history.
                </MudText>

                @if (_failure != null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="jim-set-password-failure">
                        @_failure
                    </MudAlert>
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAsync" DropShadow="false" data-testid="jim-set-password-cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
                   Disabled="@(!CanSubmit)" OnClick="SubmitAsync" data-testid="jim-set-password-submit">
            @if (_busy)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" Size="Size.Small" />
                <span class="ms-2">Setting...</span>
            }
            else
            {
                <span>Set Password</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The account the password is being set on, for the sentence at the top of the dialog.
    /// </summary>
    [Parameter]
    public string ObjectName { get; set; } = string.Empty;

    /// <summary>
    /// The Connected System the account lives in, for the same sentence.
    /// </summary>
    [Parameter]
    public string ConnectedSystemName { get; set; } = string.Empty;

    /// <summary>
    /// The expiry behaviours this Connected System's Connector can apply. Empty means it cannot set passwords
    /// at all, which the dialog says rather than offering an action that cannot work.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<PasswordExpiryBehaviour> SupportedExpiryBehaviours { get; set; } = [];

    /// <summary>
    /// Produces a password meeting the Connected System's discovered policy. Supplied by the caller, which owns
    /// the policy lookup; this component only decides when to ask for one.
    /// </summary>
    [Parameter]
    public Func<string> GeneratePassword { get; set; } = () => string.Empty;

    /// <summary>
    /// Sets the password on the account, returning the classified outcome. A target that refuses the password is
    /// a result rather than an exception, and the reason is shown here so the administrator can choose another.
    /// </summary>
    [Parameter]
    public Func<string, PasswordSetOptions, Task<PasswordSetResult>> SetPassword { get; set; } =
        (_, _) => Task.FromResult(PasswordSetResult.Failed(PasswordSetFailureReason.ConfigurationFault, "No handler was supplied."));

    /// <summary>
    /// How long a revealed password stays on screen before hiding itself again.
    /// <para>
    /// A parameter so tests do not have to wait out the real interval; nothing in the application overrides it.
    /// </para>
    /// </summary>
    [Parameter]
    public TimeSpan RevealDuration { get; set; } = TimeSpan.FromSeconds(30);

    private string _password = string.Empty;
    private bool _revealed;
    private bool _busy;
    private bool _clipboardAvailable = true;
    private string? _failure;
    private PasswordExpiryBehaviour _expiryBehaviour = PasswordExpiryBehaviour.RequireChangeAtNextSignIn;
    private bool _enableAccount;
    private CancellationTokenSource? _revealTimeout;

    private bool ConnectorCanSetPasswords => SupportedExpiryBehaviours.Count > 0;

    private bool CanCopy => _clipboardAvailable && _password.Length > 0;

    private bool CanSubmit => ConnectorCanSetPasswords && _password.Length > 0 && !_busy;

    private string CopyTooltip => _clipboardAvailable
        ? "Copy the password without showing it"
        : "Clipboard access needs an HTTPS connection";

    protected override void OnInitialized()
    {
        // Start on whatever the Connector actually offers rather than assuming the default is among them: a
        // directory that cannot force a change at next sign-in would otherwise open on an unusable selection.
        if (ConnectorCanSetPasswords && !SupportedExpiryBehaviours.Contains(_expiryBehaviour))
            _expiryBehaviour = SupportedExpiryBehaviours.First();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _clipboardAvailable = await JsRuntime.InvokeAsync<bool>("jimInterop.isClipboardAvailable");
            StateHasChanged();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException)
        {
            // The circuit went away, or JS is not ready. Copying stays offered; the attempt itself reports
            // failure honestly, which is a better outcome than hiding the button over a transient condition.
        }
    }

    private void Generate()
    {
        _password = GeneratePassword();
        _failure = null;

        // Generated masked, always. The administrator asked for a password, not to look at one.
        CancelRevealTimeout();
        _revealed = false;
    }

    private async Task CopyAsync()
    {
        var copied = await TryInvokeAsync<bool>("jimInterop.copyToClipboard", _password);
        if (copied)
            Snackbar.Add("Password copied to the clipboard.", Severity.Success);
        else
            Snackbar.Add("The password could not be copied. Reveal it and copy it by hand.", Severity.Warning);
    }

    /// <summary>
    /// Shows the password, and starts the clock that hides it again. Hiding early cancels that clock, so a
    /// second reveal always gets a full interval rather than inheriting the remains of the first.
    /// </summary>
    private async Task ToggleRevealAsync()
    {
        CancelRevealTimeout();
        _revealed = !_revealed;

        if (!_revealed)
            return;

        var timeout = new CancellationTokenSource();
        _revealTimeout = timeout;

        try
        {
            await Task.Delay(RevealDuration, timeout.Token);
            _revealed = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // Hidden by hand, revealed again, or the dialog closed. Nothing to do; whoever cancelled has
            // already set the state they wanted.
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _failure = null;

        try
        {
            var result = await SetPassword(_password, new PasswordSetOptions
            {
                ExpiryBehaviour = _expiryBehaviour,
                // Null, not false: leaving an account's enabled state alone is the right default for a reset on
                // an account that is already in the state the administrator wants.
                EnableAccount = _enableAccount ? true : null
            });

            if (!result.Success)
            {
                // Kept open, carrying the target's own words: the administrator's next move is almost always to
                // generate a different password and try again, and closing would lose the reason.
                _failure = result.ErrorMessage ?? "The Connected System refused the password without saying why.";
                return;
            }

            Snackbar.Add(result.ExpiryBehaviourWarning == null
                ? "Password set."
                : $"Password set. {result.ExpiryBehaviourWarning}",
                result.ExpiryBehaviourWarning == null ? Severity.Success : Severity.Warning);

            await ClearClipboardAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CloseAsync()
    {
        await ClearClipboardAsync();
        MudDialog.Cancel();
    }

    /// <summary>
    /// Best effort, and deliberately not reported. It can fail for reasons that are nobody's fault (the browser
    /// requires transient user activation to write to the clipboard), and it cannot touch the operating system's
    /// clipboard history either way, so a failure notice would be alarming without being actionable. The dialog
    /// says plainly that the history may retain the value instead.
    /// </summary>
    private async Task ClearClipboardAsync()
    {
        CancelRevealTimeout();
        await TryInvokeAsync<bool>("jimInterop.clearClipboard");
    }

    private async Task<T?> TryInvokeAsync<T>(string identifier, params object?[] args)
    {
        try
        {
            return await JsRuntime.InvokeAsync<T>(identifier, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException)
        {
            return default;
        }
    }

    /// <summary>
    /// Cancels the reveal timer so a dialog that is torn down while a password is on screen does not leave a
    /// delay running against a disposed component.
    /// </summary>
    public void Dispose()
    {
        CancelRevealTimeout();
    }

    private void CancelRevealTimeout()
    {
        _revealTimeout?.Cancel();
        _revealTimeout?.Dispose();
        _revealTimeout = null;
    }

    private static string DescribeExpiryBehaviour(PasswordExpiryBehaviour behaviour) => behaviour switch
    {
        PasswordExpiryBehaviour.RequireChangeAtNextSignIn => "Require a change at the next sign-in",
        PasswordExpiryBehaviour.ExpiresAccordingToTargetPolicy => "Age according to the Connected System's own policy",
        PasswordExpiryBehaviour.NeverExpires => "Never expires",
        _ => behaviour.ToString()
    };
}
