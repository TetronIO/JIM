@using JIM.Application
@using JIM.Application.Interfaces
@using JIM.Application.Servers
@using JIM.Models.Activities
@using JIM.Models.Preview
@using JIM.Models.Utility
@using JIM.Utilities
@using JIM.Web.Models
@using JIM.Web.Services
@inject IJimApplicationFactory JimFactory
@inject IUiNotificationService UiNotifications
@implements IDisposable

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

@* Renders a Configuration Change Preview (#827): what a proposed change would do, filling in as each stage of the
   evaluation completes. Shared by every surface that can be previewed; the surface starts the preview and passes
   the Activity id it was given.

   Two rules govern everything below, and both are about not saying more than the preview knows:

   A preview that failed has evaluated an arbitrary subset of the population, so its groups and counts are withheld
   rather than rendered with a warning beside them. A number on screen is read as an answer whatever sits next to it.

   An empty summary means "nothing would change" only when the summary stage actually completed. While it is running
   there is no answer yet, and where the adapter produces no deltas at all there never will be one from this stage.

   Spacing: every block below the header (alert, progress, stage list, subtitle, grid, drill-down heading) sits mt-4
   from the one above it, so a panel reads as one column whatever mix of blocks a given preview produces. Text
   inside a block uses mt-1 / mt-2; a warning that qualifies the block directly beneath its heading uses mt-2. *@

<MudPaper Outlined="true" Class="@($"pa-4 {Class}")">

    @* ─── Header ─── *@
    <div class="d-flex align-center flex-wrap gap-2">
        <MudText Typo="Typo.h6">@Title</MudText>
        @if (_activity != null)
        {
            <MudChip T="string" Color="@StatusColour" Variant="Variant.Filled">@StatusLabel</MudChip>
        }
        <MudSpacer />
        @if (IsRunning)
        {
            <MudButton data-testid="jim-preview-cancel" Variant="Variant.Text" Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Cancel" Disabled="@_cancelling" OnClick="CancelAsync">
                Cancel
            </MudButton>
        }
        @if (OnClose.HasDelegate)
        {
            <MudTooltip Text="Close this preview" Arrow="true" Placement="Placement.Top">
                <MudIconButton data-testid="jim-preview-close" Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                               aria-label="Close this preview" OnClick="OnClose" />
            </MudTooltip>
        }
    </div>

    <LoadingGate IsLoading="@_loading">
        <Loading>
            <div>
                <MudSkeleton Class="mt-4" Height="12px" />
                <MudSkeleton Height="12px" />
                <MudSkeleton Height="180px" />
            </div>
        </Loading>
        <Loaded>
            @if (_preview == null || _activity == null)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                    This preview is no longer available. Previews are removed with their Activity under the retention
                    period configured for this system; run the preview again to see what the change would do now.
                </MudAlert>
            }
            else
            {
                var preview = _preview;
                var activity = _activity;

                @* ─── Progress ─── *@
                @if (IsRunning && ShowProgress)
                {
                    @if (activity.ObjectsToProcess > 0)
                    {
                        <MudProgressLinear Value="@ProgressPercentage" Color="Color.Info" Rounded="true" Class="mt-4" />
                        <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">
                            @activity.ObjectsProcessed.ToString("N0") / @activity.ObjectsToProcess.ToString("N0")@(string.IsNullOrEmpty(activity.Message) ? "" : $" - {activity.Message}")
                        </MudText>
                    }
                    else
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Info" Rounded="true" Class="mt-4" />
                        @if (!string.IsNullOrEmpty(activity.Message))
                        {
                            <MudText Typo="Typo.body2" Class="mt-2 mud-text-secondary">@activity.Message</MudText>
                        }
                    }
                }

                @* ─── Stages ─── *@
                @* Only while there is something to watch. A preview whose every stage completed says so once, in the *@
                @* header's status chip; the four green ticks underneath restated it in five more elements and were  *@
                @* the largest thing on a finished panel. A stage that failed, was cancelled or did not apply is     *@
                @* kept, because those genuinely qualify the answer below.                                          *@
                @if (StagesAreWorthShowing(preview))
                {
                <div class="d-flex flex-wrap gap-4 mt-4">
                    @foreach (var stage in Stages(preview))
                    {
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@StageIcon(stage.Status)" Color="@StageColour(stage.Status)" Size="Size.Small" />
                            <MudText Typo="Typo.body2" Class="@(stage.Status == ConfigurationChangePreviewStageStatus.NotStarted ? "mud-text-disabled" : "")">
                                @stage.Name
                            </MudText>
                        </div>
                    }
                </div>
                }

                @* ─── Failure ─── *@
                @if (preview.HasFailed)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">
                        <MudText Typo="Typo.body1">
                            The preview did not finish, so it has seen only part of the objects the change would
                            affect. Nothing it recorded is shown, because a partial count read as a whole one is how a
                            change gets approved as safe.
                        </MudText>
                        @if (!string.IsNullOrEmpty(activity.ErrorMessage))
                        {
                            <MudText Typo="Typo.body2" Class="mt-2">@activity.ErrorMessage</MudText>
                        }
                    </MudAlert>
                }
                else if (activity.Status == ActivityStatus.Cancelled)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                        The preview was cancelled, so it covers only the objects it had reached. Run it again for a
                        complete answer.
                    </MudAlert>
                }

                @* ─── Staleness ─── *@
                @if (preview.StalenessBaseline.HasValue)
                {
                    var baseline = preview.StalenessBaseline.Value;
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="mt-4" Dense="true">
                        <MudTooltip Arrow="true" Placement="Placement.Top" Text="@baseline.ToLocalTime().ToFriendlyDate()">
                            Evaluated against data as it stood @baseline.ToLocalTime().ToRelativeTime(). An import
                            since then may have moved the answer.
                        </MudTooltip>
                    </MudAlert>
                }

                @* ─── Validation findings ─── *@
                @if (_findings.Count > 0)
                {
                    @if (_findings.Any(f => f.Severity == PreviewValidationSeverity.Blocking))
                    {
                        <MudText Typo="Typo.body1" Class="mt-4">
                            The proposed configuration cannot be applied.
                        </MudText>
                    }
                    @foreach (var finding in _findings.OrderByDescending(f => f.Severity))
                    {
                        <MudAlert Severity="@FindingSeverity(finding.Severity)" Variant="Variant.Outlined" Class="mt-4" Dense="true">
                            @* a finding about one Metaverse Attribute names it separately so the quoted name in
                               the plain-text message renders as the standard Metaverse attribute chip here *@
                            @foreach (var part in FindingMessageParts(finding))
                            {
                                @if (part.IsAttribute)
                                {
                                    <AttributeChip Kind="AttributeChipKind.Metaverse" Name="@part.Text" />
                                }
                                else
                                {
                                    @part.Text
                                }
                            }
                            @if (!string.IsNullOrEmpty(finding.PropertyName))
                            {
                                <span class="mud-text-secondary"> (@finding.PropertyName.SplitOnCapitalLetters())</span>
                            }
                        </MudAlert>
                    }
                }

                @if (!preview.HasFailed)
                {
                    @* ─── Verdict ─── *@
                    @* What the counts add up to, in one sentence, worst consequence first. This replaced a list of *@
                    @* transition chips and their counts that said exactly what the summary table below says, only  *@
                    @* without ordering it by how much the consequence matters.                                     *@
                    @if (ConfigurationChangePreviewVerdict.Describe(_impactCounts) is { } verdict)
                    {
                        <MudAlert Severity="@verdict.Severity" Variant="Variant.Outlined" Class="mt-4"
                                  data-testid="jim-preview-verdict">
                            <MudText Typo="Typo.body1"><b>@verdict.Lead</b></MudText>
                            @if (!string.IsNullOrEmpty(verdict.Detail))
                            {
                                <MudText Typo="Typo.body2" Class="mt-1">@verdict.Detail</MudText>
                            }
                        </MudAlert>
                    }

                    @* ─── Summary groups: the landing view ─── *@
                    @if (_groups.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mt-4">What would change</MudText>
                        @* The summary groups are already in memory (they are read whole on every refresh), so the
                           grid slices its windows from the list rather than reading a range. *@
                        <VirtualisedDataGrid @ref="_groupsGrid" T="ConfigurationChangePreviewGroup"
                                             ContainerId="preview-group-list"
                                             UrlParameterPrefix="pg-"
                                             DefaultSortBy="objects"
                                             DefaultSortDescending="true"
                                             LoadWindow="LoadGroupWindowAsync"
                                             SingularName="Change"
                                             PluralName="Changes"
                                             SearchPlaceholder="Search changes"
                                             RowClicked="OnGroupClicked">
                            <Columns>
                                <TemplateColumn Title="Change" Sortable="false">
                                    <HeaderTemplate>
                                        <VirtualisedSortHeader Title="Change" Name="change" />
                                    </HeaderTemplate>
                                    <CellTemplate Context="row">
                                        @* A dot, not a chip. The outlined pill was carrying five unrelated meanings on  *@
                                        @* one panel (status, transition, sampling, scope), so it had stopped encoding  *@
                                        @* anything; severity is the one thing worth reading at a glance here.          *@
                                        @* The pattern is what turns a transition into a sentence: "38,900 would have Email
                                           changed" reads very differently from "38,900 would have their email domain changed".
                                           Absent where no detector recognised the change, or where the group's deltas did not
                                           all agree on one, and nothing is shown in its place. It sits inline after the
                                           transition rather than under it, because a row in a virtualised grid is one line. *@
                                        @{
                                            var transitionName = Helpers.GetOutcomeTypePlainName(row.Item.TransitionType);
                                            var patternName = PreviewPatternKeys.GetDisplayName(row.Item.PatternKey);
                                        }
                                        <span class="jim-one-line" title="@(string.IsNullOrEmpty(patternName) ? transitionName : $"{transitionName} ({patternName})")">
                                            <MudIcon Icon="@Icons.Material.Filled.Circle" Size="Size.Small" Class="mr-2"
                                                     Color="@Helpers.GetOutcomeTypeMudBlazorColor(row.Item.TransitionType)" />
                                            @transitionName
                                            @if (!string.IsNullOrEmpty(patternName))
                                            {
                                                <span class="jim-one-line-secondary">@patternName</span>
                                            }
                                        </span>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Applies to" Sortable="false">
                                    <HeaderTemplate>
                                        <VirtualisedSortHeader Title="Applies to" Name="appliesto" />
                                    </HeaderTemplate>
                                    <CellTemplate Context="row">
                                        @if (string.IsNullOrEmpty(row.Item.MetaverseObjectTypeName))
                                        {
                                            <EmptyValue />
                                        }
                                        else
                                        {
                                            @* The object type is a schema identifier, so it takes the inline-code
                                               treatment the rest of the portal gives one and is written exactly as its
                                               system spells it. "objects" after it is what says the row covers a
                                               population rather than one of them, without inflecting a name JIM does
                                               not own; the system it belongs to is prose beside that. *@
                                            <span class="jim-code-inline">@row.Item.MetaverseObjectTypeName</span>
                                            <span> objects</span>
                                            @if (!string.IsNullOrEmpty(row.Item.ConnectedSystemName))
                                            {
                                                <span> in @row.Item.ConnectedSystemName</span>
                                            }
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Attribute" Sortable="false">
                                    <HeaderTemplate>
                                        <VirtualisedSortHeader Title="Attribute" Name="attribute" />
                                    </HeaderTemplate>
                                    <CellTemplate Context="row">
                                        @* One line: the value transition reads inline after the attribute it
                                           belongs to rather than as a paragraph under it. *@
                                        @if (string.IsNullOrEmpty(row.Item.AttributeName))
                                        {
                                            <EmptyValue />
                                        }
                                        else
                                        {
                                            <span class="jim-one-line" title="@($"{row.Item.AttributeName}: {row.Item.OldValue} -> {row.Item.NewValue}")">
                                                @row.Item.AttributeName
                                                @if (!string.IsNullOrEmpty(row.Item.OldValue) || !string.IsNullOrEmpty(row.Item.NewValue))
                                                {
                                                    <span class="jim-one-line-secondary">
                                                        <TextValueDisplay Value="@row.Item.OldValue" /> &rarr; <TextValueDisplay Value="@row.Item.NewValue" />
                                                    </span>
                                                }
                                            </span>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                @* Right-aligned and tabular so the counts line up as a column of numbers rather than
                                   starting wherever the label beside them happened to end. *@
                                <TemplateColumn Title="Objects" Sortable="false" CellClass="jim-preview-count">
                                    <HeaderTemplate>
                                        <VirtualisedSortHeader Title="Objects" Name="objects" />
                                    </HeaderTemplate>
                                    <CellTemplate Context="row">
                                        @if (row.Item.DeltasSampled)
                                        {
                                            <MudTooltip Arrow="true" Placement="Placement.Top"
                                                        Text="@($"This count is exact. Its object list below is a sample of {ConfigurationChangePreviewServer.MaximumDeltasPerGroup:N0} of them, not all of them.")">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Class="mr-2">
                                                    List sampled
                                                </MudChip>
                                            </MudTooltip>
                                        }
                                        @row.Item.ObjectCount.ToString("N0")
                                    </CellTemplate>
                                </TemplateColumn>
                                @* Unlabelled, and deliberately: the column holds the chevron that says a row opens.
                                   The drill-down is the most useful thing in the panel and its only other affordance
                                   is a pointer cursor, which nothing on a touch screen ever sees. *@
                                <TemplateColumn Sortable="false" CellClass="jim-preview-open">
                                    <HeaderTemplate></HeaderTemplate>
                                    <CellTemplate Context="row">
                                        <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                                 Class="mud-text-secondary" />
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <EmptyContent Context="grid">
                                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                                {
                                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                                     PrimaryText="@($"No changes match \"{grid.SearchText}\"")"
                                                     SecondaryText="Try a different search term, or clear the search."
                                                     ActionText="Clear Search"
                                                     OnAction="@(() => grid.ClearSearchAsync())" />
                                }
                                else
                                {
                                    <TableEmptyState Icon="@Icons.Material.Filled.CheckCircle"
                                                     PrimaryText="Nothing would change"
                                                     SecondaryText="No object moves through any transition as a result of this change." />
                                }
                            </EmptyContent>
                        </VirtualisedDataGrid>
                    }
                    else if (NothingWouldChange)
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-4">
                            This change would not change anything: no object moves through any transition as a result
                            of it.
                        </MudAlert>
                    }

                    @* ─── Drill-down ─── *@
                    @if (_selectedGroup != null)
                    {
                        var selected = _selectedGroup;
                        @* Which group is open, on two lines: value pairs run to the length of a Distinguished Name,
                           and on one line they push the Close button off the row they belong to. *@
                        <div class="d-flex align-start mt-4" data-testid="jim-preview-drilldown-heading">
                            <div>
                                <MudText Typo="Typo.subtitle1">
                                    @Helpers.GetOutcomeTypePlainName(selected.TransitionType)@(string.IsNullOrEmpty(DescribePopulation(selected)) ? "" : $": {DescribePopulation(selected)}")
                                </MudText>
                                @if (!string.IsNullOrEmpty(DescribeAttributeChange(selected)))
                                {
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        @DescribeAttributeChange(selected)
                                    </MudText>
                                }
                            </div>
                            <MudSpacer />
                            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Close" OnClick="CloseDrillDown">
                                Close
                            </MudButton>
                        </div>

                        @if (selected.DeltasSampled)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2" Dense="true">
                                @selected.ObjectCount.ToString("N0") objects are in this group. The list below is a
                                sample of the first @ConfigurationChangePreviewServer.MaximumDeltasPerGroup.ToString("N0")
                                of them, so an object being absent from it does not mean it is unaffected.
                            </MudAlert>
                        }

                        @* StateKey is the open group, so switching group on a reused grid instance re-reads its URL
                           state and reloads rather than keeping the previous group's rows. The column headers carry
                           no sort affordance because the stored read offers no ordering to drive one; the rows
                           arrive in the order the preview recorded them. *@
                        <VirtualisedDataGrid @ref="_deltasGrid" T="ConfigurationChangePreviewDelta"
                                             ContainerId="preview-delta-list"
                                             UrlParameterPrefix="pd-"
                                             StateKey="@selected.Id.ToString()"
                                             DefaultSortBy="recorded"
                                             LoadWindow="LoadDeltaWindowAsync"
                                             SingularName="Object"
                                             PluralName="Objects"
                                             SearchPlaceholder="Search object, attribute or value">
                            <Columns>
                                <TemplateColumn Title="Object" Sortable="false">
                                    <HeaderTemplate>
                                        <MudText Typo="Typo.button">Object</MudText>
                                    </HeaderTemplate>
                                    <CellTemplate Context="row">
                                        @* The name is the way into the object, so it links to the object the transition
                                           acts on: the Connected System Object where the row carries one, otherwise the
                                           Metaverse Object (see ObjectHref). A row naming nothing addressable stays text;
                                           a dead link is worse than none. *@
                                        @{
                                            var objectHref = ObjectHref(row.Item);
                                        }
                                        @if (objectHref != null && !string.IsNullOrWhiteSpace(row.Item.ObjectDisplayName))
                                        {
                                            <MudLink Href="@objectHref">@row.Item.ObjectDisplayName</MudLink>
                                        }
                                        else
                                        {
                                            <TextValueDisplay Value="@row.Item.ObjectDisplayName" />
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Type" Sortable="false">
                                    <HeaderTemplate>
                                        <MudText Typo="Typo.button">Type</MudText>
                                    </HeaderTemplate>
                                    <CellTemplate Context="row">
                                        <TextValueDisplay Value="@row.Item.ObjectTypeName" />
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Attribute" Sortable="false">
                                    <HeaderTemplate>
                                        <MudText Typo="Typo.button">Attribute</MudText>
                                    </HeaderTemplate>
                                    <CellTemplate Context="row">
                                        @* Per row as well as per group: a group that collapsed back to the attribute level
                                           holds rows of several kinds, and this is where an administrator sees which is which.
                                           Inline after the attribute, because a row in a virtualised grid is one line. *@
                                        @{
                                            var deltaPatternName = PreviewPatternKeys.GetDisplayName(row.Item.PatternKey);
                                        }
                                        <span class="jim-one-line" title="@(string.IsNullOrEmpty(deltaPatternName) ? row.Item.AttributeName : $"{row.Item.AttributeName} ({deltaPatternName})")">
                                            <TextValueDisplay Value="@row.Item.AttributeName" />
                                            @if (!string.IsNullOrEmpty(deltaPatternName))
                                            {
                                                <span class="jim-one-line-secondary">@deltaPatternName</span>
                                            }
                                        </span>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Current value" Sortable="false">
                                    <HeaderTemplate>
                                        <MudText Typo="Typo.button">Current value</MudText>
                                    </HeaderTemplate>
                                    <CellTemplate Context="row">
                                        <TextValueDisplay Value="@row.Item.OldValue" />
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn Title="Proposed value" Sortable="false">
                                    <HeaderTemplate>
                                        <MudText Typo="Typo.button">Proposed value</MudText>
                                    </HeaderTemplate>
                                    <CellTemplate Context="row">
                                        <TextValueDisplay Value="@row.Item.NewValue" />
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <EmptyContent Context="grid">
                                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                                {
                                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                                     PrimaryText="No objects in this group match that search"
                                                     SecondaryText="Try a different search term, or clear the search."
                                                     ActionText="Clear Search"
                                                     OnAction="@(() => grid.ClearSearchAsync())" />
                                }
                                else
                                {
                                    <TableEmptyState Icon="@Icons.Material.Filled.ManageSearch"
                                                     PrimaryText="No object-level detail was kept for this group"
                                                     SecondaryText="Object detail is recorded only when the preview was asked to keep it; the group's count above is still exact." />
                                }
                            </EmptyContent>
                        </VirtualisedDataGrid>
                    }
                }
            }
        </Loaded>
    </LoadingGate>
</MudPaper>

@code {
    /// <summary>
    /// The preview to render, identified by its Activity. The surface being changed starts the preview (only it
    /// knows the proposal) and passes the id it was handed back; everything after that point belongs here.
    /// </summary>
    [Parameter, EditorRequired]
    public Guid ActivityId { get; set; }

    private readonly record struct FindingMessagePart(string Text, bool IsAttribute);

    /// <summary>
    /// Splits a finding's message so its Metaverse Attribute renders as the standard attribute chip: the name
    /// appears quoted in the plain-text message (which REST and PowerShell consumers read whole), and a finding
    /// that names its attribute has each quoted occurrence swapped for a chip part. A finding naming no
    /// attribute renders as one text part, unchanged.
    /// </summary>
    private static IEnumerable<FindingMessagePart> FindingMessageParts(PreviewValidationFinding finding)
    {
        if (string.IsNullOrEmpty(finding.MetaverseAttributeName))
            return [new FindingMessagePart(finding.Message, false)];

        var token = $"'{finding.MetaverseAttributeName}'";
        var segments = finding.Message.Split(token);
        if (segments.Length == 1)
            return [new FindingMessagePart(finding.Message, false)];

        var parts = new List<FindingMessagePart>();
        for (var i = 0; i < segments.Length; i++)
        {
            if (segments[i].Length > 0)
                parts.Add(new FindingMessagePart(segments[i], false));
            if (i < segments.Length - 1)
                parts.Add(new FindingMessagePart(finding.MetaverseAttributeName!, true));
        }
        return parts;
    }

    /// <summary>Heading for the panel. Surfaces override it where a more specific noun reads better.</summary>
    [Parameter]
    public string Title { get; set; } = "Preview";

    /// <summary>
    /// Whether the panel renders the preview's own progress bar and message. Set false where the host already shows
    /// them for the same Activity (the Activity detail page, which also has throughput and an ETA the panel does
    /// not). The status chip and Cancel stay either way: the stages are the panel's own, and stopping a running
    /// preview is an affordance no host currently offers.
    /// </summary>
    [Parameter]
    public bool ShowProgress { get; set; } = true;

    /// <summary>
    /// Raised whenever the panel has re-read the preview, so a host can react to it reaching a terminal state (for
    /// example, enabling its Apply button once the preview completes without blocking findings).
    /// </summary>
    [Parameter]
    public EventCallback<ConfigurationChangePreview?> OnPreviewChanged { get; set; }

    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Raised when the administrator closes the panel. The surface that opened the preview decides what closing
    /// means (the Synchronisation Rule editor forgets the preview, so the save confirmation stops citing it); a
    /// surface that shows a preview as a record, such as the Activity page, leaves this unset and gets no button.
    /// A running preview closed this way is not cancelled: it finishes as an Activity, where it can still be read.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    private ConfigurationChangePreview? _preview;
    private Activity? _activity;
    private List<ConfigurationChangePreviewGroup> _groups = [];
    private List<PreviewValidationFinding> _findings = [];
    private List<PreviewImpactCount> _impactCounts = [];
    private ConfigurationChangePreviewGroup? _selectedGroup;

    /// <summary>
    /// The plural name of the open group's Metaverse Object Type, which a Metaverse Object's page is addressed by and
    /// the stored rows do not carry. Resolved once per drill-down, and only when a fetched row will link to one.
    /// </summary>
    private string? _selectedGroupTypePluralName;
    private VirtualisedDataGrid<ConfigurationChangePreviewGroup>? _groupsGrid;
    private VirtualisedDataGrid<ConfigurationChangePreviewDelta>? _deltasGrid;

    /// <summary>The preview this panel has loaded, so a parent re-render does not re-read the one it already has.</summary>
    private Guid _loadedActivityId;

    private bool _loading = true;
    private bool _cancelling;

    /// <summary>
    /// How many object-level rows one read of the stored deltas fetches. The stored read is page-based while the
    /// grid asks for arbitrary windows, so a window is served from whole pages of this size that cover it. A window
    /// is at most a screenful plus its overscan, so this is one read, occasionally two.
    /// </summary>
    private const int DeltaPageSize = 200;

    private readonly SemaphoreSlim _refreshLock = new(1, 1);
    private CancellationTokenSource? _pollCts;

    private bool IsRunning => _activity?.Status == ActivityStatus.InProgress;

    private double ProgressPercentage => _activity is { ObjectsToProcess: > 0 }
        ? (double)_activity.ObjectsProcessed / _activity.ObjectsToProcess * 100
        : 0;

    /// <summary>
    /// True only where the summary stage ran to completion and found nothing. A stage still running has no answer
    /// yet, and one recorded not-applicable never will have: neither is evidence that nothing would change.
    /// </summary>
    private bool NothingWouldChange =>
        _preview is { HasFailed: false, SummaryStatus: ConfigurationChangePreviewStageStatus.Complete }
        && _groups.Count == 0
        && _impactCounts.All(c => c.ObjectCount == 0);

    private Color StatusColour => _activity?.Status switch
    {
        ActivityStatus.InProgress => Color.Info,
        ActivityStatus.Complete => Color.Success,
        ActivityStatus.CompleteWithWarning => Color.Warning,
        ActivityStatus.FailedWithError => Color.Error,
        ActivityStatus.Cancelled => Color.Default,
        _ => Color.Default
    };

    private string StatusLabel => _activity?.Status switch
    {
        ActivityStatus.InProgress => "Running",
        ActivityStatus.Complete => "Complete",
        ActivityStatus.CompleteWithWarning => "Complete with warnings",
        ActivityStatus.FailedWithError => "Failed",
        ActivityStatus.Cancelled => "Cancelled",
        _ => "Queued"
    };

    protected override void OnInitialized()
    {
        UiNotifications.ActivityProgressChanged += OnActivityProgressChanged;
        UiNotifications.RealTimeAvailabilityChanged += OnRealTimeAvailabilityChanged;
    }

    /// <summary>
    /// Loads a preview once, when the panel is first given one or is pointed at a different one. Deliberately not
    /// on every parameter set.
    ///
    /// A host that binds <see cref="OnPreviewChanged"/> re-renders when the callback fires, because that is what an
    /// <c>EventCallback</c> does; re-reading on every parameter set would turn that into a loop, and the loop
    /// starves the reconciliation poll below, whose delay is cancelled and restarted on each pass and so never
    /// elapses. The panel would then sit on stage 1 for ever while the preview finished behind it. Refreshes are
    /// the job of the notification handler and the poll, both of which run without the host's involvement; a parent
    /// re-render is not new information about the preview.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (ActivityId == _loadedActivityId)
            return;

        _loadedActivityId = ActivityId;
        _loading = true;
        _selectedGroup = null;
        await RefreshAsync();
        _loading = false;
        StartPollingIfRunning();
    }

    /// <summary>
    /// Re-reads the preview, its Activity and its summary groups. Guarded so a notification and the reconciliation
    /// poll arriving together skip rather than queue.
    /// </summary>
    private async Task RefreshAsync()
    {
        if (!await _refreshLock.WaitAsync(0))
            return;

        try
        {
            using var jim = JimFactory.Create();
            var preview = await jim.ConfigurationChangePreviews.GetPreviewAsync(ActivityId);
            if (preview == null)
            {
                _preview = null;
                _activity = null;
                await PublishAsync();
                return;
            }

            _preview = preview;
            _activity = await jim.Activities.GetActivityAsync(ActivityId);
            _findings = preview.ReadValidationFindings();
            _impactCounts = preview.ReadImpactCounts();

            // Groups are read but deliberately not rendered for a failed preview; keeping the read unconditional
            // means the failure branch is the only thing deciding what is shown.
            _groups = await jim.ConfigurationChangePreviews.GetPreviewGroupsAsync(ActivityId);

            // A group the administrator had open can disappear between refreshes only if the preview was re-run;
            // dropping the selection is better than paging a group that is no longer in the summary.
            if (_selectedGroup != null && _groups.TrueForAll(g => g.Id != _selectedGroup.Id))
                _selectedGroup = null;

            await PublishAsync();
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException or ObjectDisposedException)
        {
            // A transient read failure, or the application scope disposed mid-refresh during navigation. The
            // reconciliation poll covers it; what must not happen is the panel tearing down over one bad read.
            // Logged rather than swallowed silently: a panel that stops updating and says nothing anywhere is
            // indistinguishable from a preview that never finished, and cost an afternoon to diagnose once.
            Serilog.Log.Debug(ex, "ConfigurationChangePreviewPanel: refresh of preview {ActivityId} failed", ActivityId);
        }
        finally
        {
            _refreshLock.Release();
        }
    }

    /// <summary>
    /// Renders what was just read, and tells the host about it, both on the renderer's Dispatcher.
    ///
    /// <see cref="OnPreviewChanged"/> is an <c>EventCallback</c>, so invoking it re-renders the host, and rendering
    /// off the Dispatcher throws "The current thread is not associated with the Dispatcher". Every refresh that
    /// matters comes from a background thread (the notification handler and the reconciliation poll), so raising it
    /// outside <c>InvokeAsync</c> threw on every one of them, before the panel's own StateHasChanged, and the
    /// exception was caught by the same handler that exists for transient read failures. The panel then sat on
    /// whatever stage it had first read while the preview finished behind it, with nothing anywhere saying why.
    /// </summary>
    private async Task PublishAsync() => await InvokeAsync(async () =>
    {
        if (OnPreviewChanged.HasDelegate)
            await OnPreviewChanged.InvokeAsync(_preview);

        StateHasChanged();

        // The summary grid caches the rows it is holding, so a running preview that has just produced (or replaced)
        // its groups needs the grid told, not just the panel re-rendered. The total is invalidated because the
        // number of groups is exactly what changed.
        if (_groupsGrid != null)
            await _groupsGrid.RefreshAsync(invalidateTotals: true);
    });

    /// <summary>
    /// Slices one window of the summary groups, applying the grid's search and sort. The groups are read whole on
    /// every refresh (they are the panel's landing view), so there is nothing further to read here. Objects lead
    /// the default sort, descending: the biggest population is the one an administrator has to answer for first.
    /// </summary>
    private Task<VirtualisedWindow<ConfigurationChangePreviewGroup>> LoadGroupWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<ConfigurationChangePreviewGroup> groups = _groups;

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            groups = groups.Where(g =>
                Helpers.GetOutcomeTypePlainName(g.TransitionType).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                g.MetaverseObjectTypeName?.Contains(search, StringComparison.OrdinalIgnoreCase) == true ||
                g.ConnectedSystemName?.Contains(search, StringComparison.OrdinalIgnoreCase) == true ||
                g.AttributeName?.Contains(search, StringComparison.OrdinalIgnoreCase) == true ||
                g.OldValue?.Contains(search, StringComparison.OrdinalIgnoreCase) == true ||
                g.NewValue?.Contains(search, StringComparison.OrdinalIgnoreCase) == true);
        }

        IOrderedEnumerable<ConfigurationChangePreviewGroup> Order<TKey>(Func<ConfigurationChangePreviewGroup, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? groups.OrderByDescending(key, comparer) : groups.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "change" => Order(g => Helpers.GetOutcomeTypePlainName(g.TransitionType), StringComparer.OrdinalIgnoreCase),
            "appliesto" => Order(g => g.MetaverseObjectTypeName ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            "attribute" => Order(g => g.AttributeName ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            _ => Order(g => g.ObjectCount)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    /// <summary>
    /// Reads one window of the open group's object-level rows. The stored read is page-based, so the window is
    /// served from the whole pages of <see cref="DeltaPageSize"/> that cover it, then sliced to exactly what was
    /// asked for. A read failure returns an empty window rather than tearing the panel down; the next window, or
    /// the reconciliation poll's refresh, retries.
    /// </summary>
    private async Task<VirtualisedWindow<ConfigurationChangePreviewDelta>> LoadDeltaWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        var group = _selectedGroup;
        if (group == null)
            return new VirtualisedWindow<ConfigurationChangePreviewDelta>([], request.IncludeTotalCount ? 0 : null);

        try
        {
            using var jim = JimFactory.Create();
            var search = string.IsNullOrWhiteSpace(request.SearchText) ? null : request.SearchText;

            var firstPage = request.StartIndex / DeltaPageSize;
            var lastPage = (request.StartIndex + request.Count - 1) / DeltaPageSize;
            var fetched = new List<ConfigurationChangePreviewDelta>();
            var total = 0;

            for (var page = firstPage; page <= lastPage; page++)
            {
                var result = await jim.ConfigurationChangePreviews.GetPreviewDeltasAsync(
                    ActivityId, group.Id, page + 1, DeltaPageSize, search);

                total = result.TotalResults;
                fetched.AddRange(result.Results);

                // A short page is the last one; asking for the next would cost a read that can only come back empty.
                if (result.Results.Count < DeltaPageSize)
                    break;
            }

            await ResolveMetaverseObjectTypePluralNameAsync(jim, group, fetched);

            var offsetIntoFirstPage = request.StartIndex - (firstPage * DeltaPageSize);
            return new VirtualisedWindow<ConfigurationChangePreviewDelta>(
                fetched.Skip(offsetIntoFirstPage).Take(request.Count).ToList(),
                request.IncludeTotalCount ? total : null);
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException or ObjectDisposedException)
        {
            Serilog.Log.Debug(ex, "ConfigurationChangePreviewPanel: reading object detail for preview {ActivityId} failed", ActivityId);
            return new VirtualisedWindow<ConfigurationChangePreviewDelta>([], request.IncludeTotalCount ? 0 : null);
        }
    }

    private async Task OnGroupClicked(ConfigurationChangePreviewGroup group)
    {
        _selectedGroup = group;
        _selectedGroupTypePluralName = null;
        StateHasChanged();

        // The grid may not exist yet on the first drill-down (the section it lives in has only just been rendered);
        // its StateKey carries the group id, so a reused instance reloads itself when the id changes.
        if (_deltasGrid != null)
            await _deltasGrid.RefreshAsync(invalidateTotals: true);
    }

    private void CloseDrillDown()
    {
        _selectedGroup = null;
        _selectedGroupTypePluralName = null;
    }

    /// <summary>
    /// Where a drill-down row's name leads. The Connected System Object where the row carries one, because that is the
    /// object the transition acts on: the target object an export would remove, the joined object an import would
    /// disconnect, the object a matching rule would join elsewhere; its page shows the Metaverse Object beside it.
    /// Otherwise the Metaverse Object, once its type's plural name is known. Null where the row names nothing
    /// addressable (a container, or a row stored before ids were recorded).
    /// </summary>
    private string? ObjectHref(ConfigurationChangePreviewDelta row)
    {
        if (row is { ConnectedSystemObjectId: { } connectedSystemObjectId, ConnectedSystemId: { } connectedSystemId })
            return Utilities.GetConnectedSystemObjectHref(connectedSystemId, connectedSystemObjectId);

        if (row.MetaverseObjectId is { } metaverseObjectId && _selectedGroupTypePluralName is { Length: > 0 } pluralName)
            return Utilities.GetMetaverseObjectHref(metaverseObjectId, pluralName);

        return null;
    }

    /// <summary>
    /// Resolves the plural name a Metaverse Object link needs, once per drill-down, and only when a fetched row would
    /// link to a Metaverse Object (it carries the id and no Connected System Object of its own). A lookup that fails
    /// costs the link and nothing else: the rows still render, as text.
    /// </summary>
    private async Task ResolveMetaverseObjectTypePluralNameAsync(JimApplication jim, ConfigurationChangePreviewGroup group,
        List<ConfigurationChangePreviewDelta> fetched)
    {
        if (_selectedGroupTypePluralName != null || group.MetaverseObjectTypeId is not { } typeId)
            return;

        if (!fetched.Any(row => row.MetaverseObjectId.HasValue && ObjectHref(row) == null))
            return;

        try
        {
            var type = await jim.Metaverse.GetMetaverseObjectTypeAsync(typeId, false);
            _selectedGroupTypePluralName = type?.PluralName;
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException or ObjectDisposedException)
        {
            Serilog.Log.Debug(ex, "ConfigurationChangePreviewPanel: resolving the Metaverse Object Type for preview {ActivityId} failed", ActivityId);
        }
    }

    private async Task CancelAsync()
    {
        _cancelling = true;
        try
        {
            using var jim = JimFactory.Create();
            await jim.ConfigurationChangePreviews.CancelPreviewAsync(ActivityId);
            await RefreshAsync();
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException or ObjectDisposedException)
        {
            // Cancelling is best-effort from here: the preview either stopped or had already finished, and the next
            // refresh reports whichever it was.
        }
        finally
        {
            _cancelling = false;
        }
    }

    /// <summary>
    /// The reconciliation poll (#202/#307). Real-time notifications drive refreshes while they are flowing, so this
    /// runs slowly; when they are unavailable it takes over at the pre-notification cadence.
    /// </summary>
    private void StartPollingIfRunning()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = null;

        if (!IsRunning)
            return;

        _pollCts = new CancellationTokenSource();
        var token = _pollCts.Token;
        _ = Task.Run(async () =>
        {
            while (!token.IsCancellationRequested)
            {
                try
                {
                    await Task.Delay(UiNotifications.IsRealTimeAvailable ? TimeSpan.FromSeconds(30) : TimeSpan.FromSeconds(3), token);
                    await RefreshAsync();
                    if (!IsRunning)
                        break;
                }
                catch (OperationCanceledException)
                {
                    break;
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    // Sanctioned broad catch: this loop is the panel's only guarantee of eventual consistency, and
                    // an exception escaping it kills the task silently, leaving the panel frozen on whatever stage
                    // it last read. Log and keep polling. Cancellation is excluded because an abandoned poll must
                    // stop rather than grind on, and it is handled above.
                    Serilog.Log.Debug(ex, "ConfigurationChangePreviewPanel: reconciliation poll for preview {ActivityId} failed", ActivityId);
                }
            }
        }, token);
    }

    private void OnActivityProgressChanged(Guid activityId)
    {
        // Filtered to this preview's own Activity: a busy system raises these constantly, and a panel that re-read
        // on every one would spend a run profile execution hammering the database on another Activity's behalf.
        if (activityId != ActivityId)
            return;

        TriggerRefresh();
    }

    private void OnRealTimeAvailabilityChanged(bool available) => TriggerRefresh();

    private void TriggerRefresh() => _ = Task.Run(async () =>
    {
        try
        {
            await RefreshAsync();
            await InvokeAsync(StartPollingIfRunning);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Notification-triggered refreshes are best-effort; the reconciliation poll covers what they miss.
        }
    });

    /// <summary>
    /// The attribute and value pair a group covers, for the drill-down heading. Value-pair grouping puts several
    /// rows on screen that share a transition and a population and differ only in their values, so without this the
    /// heading identifies none of them. Empty for a group that names no attribute.
    /// </summary>
    private static string DescribeAttributeChange(ConfigurationChangePreviewGroup group)
    {
        if (string.IsNullOrEmpty(group.AttributeName))
            return string.Empty;

        // The values are absent on a group that collapsed past the cardinality guard, which covers many of them and
        // must not be labelled with one.
        return string.IsNullOrEmpty(group.OldValue) && string.IsNullOrEmpty(group.NewValue)
            ? group.AttributeName
            : $"{group.AttributeName}: {group.OldValue} → {group.NewValue}";
    }

    /// <summary>
    /// The population a summary row covers, for the drill-down heading. "objects" follows the type name for the
    /// same reason the Applies to column carries it: the row is about many of them, and the type name itself is
    /// whatever its system calls the type, not something to inflect.
    /// </summary>
    private static string DescribePopulation(ConfigurationChangePreviewGroup group)
    {
        var parts = new List<string>(2);
        if (!string.IsNullOrEmpty(group.MetaverseObjectTypeName))
            parts.Add($"{group.MetaverseObjectTypeName} objects");
        if (!string.IsNullOrEmpty(group.ConnectedSystemName))
            parts.Add(group.ConnectedSystemName);
        return string.Join(" in ", parts);
    }

    private static IEnumerable<(string Name, ConfigurationChangePreviewStageStatus Status)> Stages(ConfigurationChangePreview preview) =>
    [
        ("Validation", preview.ValidationStatus),
        ("Objects affected", preview.ImpactCountsStatus),
        ("Summary", preview.SummaryStatus),
        ("Object detail", preview.DeltasStatus)
    ];

    /// <summary>
    /// Whether the stage row still earns its space. It does while the preview is working, because it is the only
    /// thing saying which part of the answer has arrived; and it does when a stage ended in anything other than
    /// success, because that qualifies whatever is rendered below it. A preview whose every stage completed has
    /// already said so in the header's status chip, and four green ticks repeating it were the largest element on
    /// a finished panel.
    /// </summary>
    private static bool StagesAreWorthShowing(ConfigurationChangePreview preview) =>
        Stages(preview).Any(s => s.Status != ConfigurationChangePreviewStageStatus.Complete);

    private static string StageIcon(ConfigurationChangePreviewStageStatus status) => status switch
    {
        ConfigurationChangePreviewStageStatus.Complete => Icons.Material.Filled.CheckCircle,
        ConfigurationChangePreviewStageStatus.InProgress => Icons.Material.Filled.Autorenew,
        ConfigurationChangePreviewStageStatus.Failed => Icons.Material.Filled.Error,
        ConfigurationChangePreviewStageStatus.Cancelled => Icons.Material.Filled.Cancel,
        ConfigurationChangePreviewStageStatus.NotApplicable => Icons.Material.Filled.RemoveCircleOutline,
        _ => Icons.Material.Filled.RadioButtonUnchecked
    };

    private static Color StageColour(ConfigurationChangePreviewStageStatus status) => status switch
    {
        ConfigurationChangePreviewStageStatus.Complete => Color.Success,
        ConfigurationChangePreviewStageStatus.InProgress => Color.Info,
        ConfigurationChangePreviewStageStatus.Failed => Color.Error,
        _ => Color.Default
    };

    private static Severity FindingSeverity(PreviewValidationSeverity severity) => severity switch
    {
        PreviewValidationSeverity.Blocking => Severity.Error,
        PreviewValidationSeverity.Warning => Severity.Warning,
        _ => Severity.Info
    };

    public void Dispose()
    {
        UiNotifications.ActivityProgressChanged -= OnActivityProgressChanged;
        UiNotifications.RealTimeAvailabilityChanged -= OnRealTimeAvailabilityChanged;
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _refreshLock.Dispose();
    }
}
