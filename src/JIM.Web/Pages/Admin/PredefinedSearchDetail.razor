@page "/admin/predefined-searches/{Uri}"
@attribute [Authorize(Roles = "Administrator")]
@using System.Globalization
@using JIM.Models.Activities
@using JIM.Models.Core
@using JIM.Models.Search
@using JIM.Utilities
@using JIM.Web.Models
@using JIM.Web.Pages.Admin.Components
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@string.Format(CultureInfo.CurrentCulture, SearchText.DetailPageTitle, _predefinedSearch?.Name)</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.SavedSearch" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>@SearchText.DetailHeading</span> <span class="mud-primary-text">@_predefinedSearch?.Name</span>
    <PageInfo Title="@SearchText.PredefinedSearch" DocsPage="configuration/predefined-searches.md">
        @SearchText.DetailPageInfo
    </PageInfo>
</MudText>
<div class="d-flex justify-space-between align-center">
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
    @if (_predefinedSearch != null)
    {
        <AuditInfo Entity="@_predefinedSearch" />
    }
</div>

@if (_predefinedSearch != null)
{
    // Captured once here (rather than dereferencing _predefinedSearch again inside RenderGroupHeader/RenderCriteria
    // below) because nullable-flow narrowing on a field does not survive an intervening method call.
    var predefinedSearchBuiltIn = _predefinedSearch.BuiltIn;

    <NavigableMudTabs Class="mt-2" TabPanelsClass="pt-6">

        <MudTabPanel Text="@SearchText.Details">
    <MudPaper Class="pa-4" Outlined="true">
        <MudText Typo="Typo.h5" Class="mb-3">@SearchText.Details</MudText>
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="6" md="4">
                <MudField Label="@CommonText.ColumnName" Variant="Variant.Outlined">@_predefinedSearch.Name</MudField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudField Label="@SearchText.FieldUri" Variant="Variant.Outlined">@_predefinedSearch.Uri</MudField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudField Label="@SearchText.ColumnObjectType" Variant="Variant.Outlined">@_predefinedSearch.MetaverseObjectType.Name</MudField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudField Label="@SearchText.IsDefaultForObjectType" Variant="Variant.Outlined">@(_predefinedSearch.IsDefaultForMetaverseObjectType ? SearchText.Yes : SearchText.No)</MudField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudField Label="@SearchText.ColumnBuiltIn" Variant="Variant.Outlined">@(_predefinedSearch.BuiltIn ? SearchText.Yes : SearchText.No)</MudField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudSwitch T="bool" Value="_predefinedSearch.IsEnabled" Color="Color.Success"
                           Label="@CommonText.Enabled" ValueChanged="async (bool val) => await ToggleEnabledAsync(val)" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@SearchText.DisabledSearchesHint</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mt-6" Outlined="true">
        <MudText Typo="Typo.h5">@SearchText.MetaverseAttributes</MudText>
        <MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-3">@SearchText.MetaverseAttributesIntro</MudText>
        <div>
            @foreach (var psa in _predefinedSearch.Attributes)
            {
                <MudChip T="string" Color="Color.Primary">@psa.MetaverseAttribute.Name</MudChip>
            }
        </div>
    </MudPaper>

    <MudPaper Class="pa-4 mt-6" Outlined="true">
        <div class="d-flex justify-space-between align-center mb-3">
            <div>
                <MudText Typo="Typo.h5">@SearchText.Criteria</MudText>
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary">@SearchText.CriteriaIntro</MudText>
            </div>
            <MudTooltip Text="@BuiltInCriteriaTooltipText" Arrow="true" Placement="Placement.Top" Disabled="!predefinedSearchBuiltIn">
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="HandleOpenAddGroupDialog" DropShadow="false" Disabled="predefinedSearchBuiltIn">@SearchText.AddCriteriaGroup</MudButton>
            </MudTooltip>
        </div>

        @if (_predefinedSearch.CriteriaGroups.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@string.Format(CultureInfo.CurrentCulture, SearchText.NoCriteriaAlert, _predefinedSearch.MetaverseObjectType.Name)</MudAlert>
        }
        else
        {
            <MudStack>
                @foreach (var criteriaGroup in _predefinedSearch.CriteriaGroups.OrderBy(g => g.Position))
                {
                    @RenderGroup(criteriaGroup, predefinedSearchBuiltIn, nested: false)
                }
            </MudStack>
        }
    </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="@SearchText.Changes" BadgeData="@(_changeCount > 0 ? _changeCount.ToString("N0") : null)" BadgeColor="Color.Primary">
            <ConfigurationChangesTab TargetType="ActivityTargetType.PredefinedSearch" ObjectId="@_predefinedSearch.Id" ObjectTypeLabel="@SearchText.PredefinedSearch" />
        </MudTabPanel>

    </NavigableMudTabs>

    @* ─── Add Criteria Group dialog ─── *@
    <MudDialog @bind-Visible="_addGroupDialogVisible" Options="_dialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-3" /> @SearchText.AddCriteriaGroup</MudText>
        </TitleContent>
        <DialogContent>
            <MudSelect T="string" Label="@SearchText.LogicType" Required="true" Variant="Variant.Outlined" @bind-Value="_newGroupType">
                @foreach (var type in Enum.GetValues(typeof(SearchGroupType)))
                {
                    <MudSelectItem Value="@type.ToString()" />
                }
            </MudSelect>
        </DialogContent>
        <DialogActions>
            <MudButton DropShadow="false" OnClick="@(() => _addGroupDialogVisible = false)" Class="me-2">@CommonText.Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrEmpty(_newGroupType)" OnClick="HandleAddGroupAsync" DropShadow="false">@SearchText.AddGroup</MudButton>
        </DialogActions>
    </MudDialog>

    @* ─── Add/Edit Criteria dialog ─── *@
    <MudDialog @bind-Visible="_addCriteriaDialogVisible" Options="_dialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Compare" Class="mr-3" /> @(_editingCriterionId.HasValue ? SearchText.EditCriteria : SearchText.AddCriteria)</MudText>
        </TitleContent>
        <DialogContent>
            @if (_newCriterion != null)
            {
                <MudSelect T="MetaverseAttribute"
                           Value="_newCriterionAttribute"
                           ValueChanged="HandleAttributeSelection"
                           Label="@SearchText.MetaverseAttribute"
                           Placeholder="@SearchText.SelectMetaverseAttribute"
                           Required="true"
                           Class="mt-5"
                           Variant="Variant.Outlined"
                           ToStringFunc="@(a => a?.Name ?? string.Empty)">
                    @foreach (var attr in _objectTypeAttributes.OrderBy(a => a.Name))
                    {
                        <MudSelectItem Value="@attr">@attr.Name</MudSelectItem>
                    }
                </MudSelect>

                @if (_newCriterionAttribute != null)
                {
                    <MudSelect T="SearchComparisonType?"
                               @bind-Value="NewCriterionComparisonType"
                               Label="@SearchText.ComparisonType"
                               Placeholder="@SearchText.SelectComparisonType"
                               Required="true"
                               Class="mt-5"
                               Variant="Variant.Outlined">
                        @foreach (var op in CriterionOperatorOptions.ForType(_newCriterionAttribute.Type, CriterionContext.PredefinedSearch))
                        {
                            <MudSelectItem T="SearchComparisonType?" Value="@op.Operator">@op.Label</MudSelectItem>
                        }
                    </MudSelect>

                    <CriterionValueEditor Criterion="_newCriterion" AttributeType="_newCriterionAttribute.Type" OnChanged="StateHasChanged" />
                }
            }
        </DialogContent>
        <DialogActions>
            <MudButton DropShadow="false" OnClick="@(() => _addCriteriaDialogVisible = false)" Class="me-2">@CommonText.Cancel</MudButton>
            <MudButton Disabled="DisableAddCriteriaButton()" Variant="Variant.Filled" DropShadow="false" Color="Color.Primary" OnClick="HandleSaveCriterionAsync">@(_editingCriterionId.HasValue ? SearchText.Save : SearchText.AddCriteria)</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private static string BuiltInCriteriaTooltipText => SearchText.BuiltInCriteriaTooltip;

    [Parameter]
    public string? Uri { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private PredefinedSearch? _predefinedSearch;
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private int _changeCount;

    // Attributes of the search's Metaverse Object Type, for the criterion attribute picker.
    private List<MetaverseAttribute> _objectTypeAttributes = new();

    private readonly DialogOptions _dialogOptions = new() { FullWidth = true };

    // Add Criteria Group dialog state.
    private bool _addGroupDialogVisible;
    private string? _newGroupType;
    private int? _addGroupParentId;

    // Add/Edit Criteria dialog state.
    private bool _addCriteriaDialogVisible;
    private int _addCriteriaGroupId;
    private int? _editingCriterionId;
    private PredefinedSearchCriteria? _newCriterion;
    private MetaverseAttribute? _newCriterionAttribute;

    // Adapter that maps the model's NotSet sentinel to null at the binding boundary, so the
    // Comparison Type select shows its placeholder (and enforces Required) until the user chooses.
    private SearchComparisonType? NewCriterionComparisonType
    {
        get => _newCriterion is { ComparisonType: not SearchComparisonType.NotSet } c ? c.ComparisonType : null;
        set { if (_newCriterion != null) _newCriterion.ComparisonType = value ?? SearchComparisonType.NotSet; }
    }

    // ─── Render helpers (shared by groups at every depth) ───

    // Groups nest to any depth, as the REST API and PowerShell allow, so a group renders its own child groups through
    // this same fragment and every group offers both adds.
    private RenderFragment RenderGroup(PredefinedSearchCriteriaGroup group, bool builtIn, bool nested) =>@<MudPaper Class="@(nested ? "pa-5 mt-4 ml-6" : "pa-5")" Outlined="true">
        @RenderGroupHeader(group, builtIn)
        @RenderCriteria(group, builtIn)

        <div class="mt-4">
            <MudTooltip Text="@BuiltInCriteriaTooltipText" Arrow="true" Placement="Placement.Top" Disabled="!builtIn">
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Class="me-3"
                           OnClick="@(() => HandleOpenAddCriteriaDialog(group.Id))" DropShadow="false" Disabled="builtIn">@SearchText.AddCriteria</MudButton>
            </MudTooltip>
            <MudTooltip Text="@BuiltInCriteriaTooltipText" Arrow="true" Placement="Placement.Top" Disabled="!builtIn">
                <MudButton StartIcon="@Icons.Material.Filled.AccountTree" Variant="Variant.Filled"
                           OnClick="@(() => HandleOpenAddChildGroupDialog(group.Id))" DropShadow="false" Disabled="builtIn">@SearchText.AddCriteriaGroup</MudButton>
            </MudTooltip>
        </div>

        @foreach (var childGroup in group.ChildGroups.OrderBy(g => g.Position))
        {
            @RenderGroup(childGroup, builtIn, nested: true)
        }
    </MudPaper>;

    private RenderFragment RenderGroupHeader(PredefinedSearchCriteriaGroup group, bool builtIn) =>@<div class="d-flex justify-space-between align-center">
        <MudText Typo="Typo.overline"><span class="mud-text-secondary">@SearchText.CriteriaGroupHeading</span> @group.Type.ToString().SplitOnCapitalLetters().ToUpper()</MudText>
        <MudTooltip Text="@(builtIn ? BuiltInCriteriaTooltipText : SearchText.DeleteGroupTooltip)" Arrow="true" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" DropShadow="false"
                           aria-label="@SearchText.DeleteGroupAriaLabel" OnClick="@(() => HandleDeleteGroupAsync(group.Id))" Disabled="builtIn" />
        </MudTooltip>
    </div>;

    private RenderFragment RenderCriteria(PredefinedSearchCriteriaGroup group, bool builtIn) =>@<text>
        @if (group.Criteria.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">@SearchText.NoCriteriaInGroup</MudAlert>
        }
        @foreach (var criteria in group.Criteria)
        {
            <div class="mt-3 d-flex align-center">
                <MudChip T="string">
                    <AvatarContent>
                        @* object-chip: exempt - names an Attribute, not an object; AttributeChip migration debt *@
                        <MudTooltip Text="@SearchText.MetaverseAttribute" Arrow="true" Placement="Placement.Top">
                            <MudAvatar Color="Color.Primary">MV</MudAvatar>
                        </MudTooltip>
                    </AvatarContent>
                    <ChildContent>@criteria.GetAttributeName()</ChildContent>
                </MudChip>
                <MudChip T="string">@FriendlyComparison(criteria)</MudChip>
                @if (SearchComparisonOperators.TakesValue(criteria.ComparisonType))
                {
                    <MudChip T="string">@criteria.ToString()</MudChip>
                }
                <MudTooltip Text="@(builtIn ? BuiltInCriteriaTooltipText : SearchText.EditCriteriaTooltip)" Arrow="true" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" DropShadow="false"
                                   aria-label="@SearchText.EditCriteriaAriaLabel" OnClick="@(() => HandleOpenEditCriteriaDialog(criteria))" Disabled="builtIn" />
                </MudTooltip>
                <MudTooltip Text="@(builtIn ? BuiltInCriteriaTooltipText : SearchText.DeleteCriteriaTooltip)" Arrow="true" Placement="Placement.Top">
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" DropShadow="false" Disabled="builtIn"
                                   aria-label="@SearchText.DeleteCriteriaAriaLabel" OnClick="@(() => HandleDeleteCriterionAsync(criteria.Id))" />
                </MudTooltip>
            </div>
        }
    </text>;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Uri))
        {
            // no predefined search parameter passed in, redirect to index page
            NavManager.NavigateTo("../");
            return;
        }

        using var jim = JimFactory.Create();
        _predefinedSearch = await jim.Search.GetPredefinedSearchAsync(Uri);
        if (_predefinedSearch == null)
        {
            // predefined search not found, redirect to index page
            NavManager.NavigateTo("../");
            return;
        }

        // Load the object type's attributes so the criterion editor can offer them.
        var objectType = await jim.Metaverse.GetMetaverseObjectTypeAsync(_predefinedSearch.MetaverseObjectType.Id, includeChildObjects: true);
        _objectTypeAttributes = objectType?.Attributes ?? new List<MetaverseAttribute>();

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
            new(LayoutText.NavAdministration, href: "/admin"),
            new(SearchText.PredefinedSearches, href: "/admin/predefined-searches/"),
            new(_predefinedSearch.Name, href: null, disabled: true)
        };

        _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.PredefinedSearch, _predefinedSearch.Id, 1, 1)).TotalResults;
    }

    private async Task ReloadAsync()
    {
        if (string.IsNullOrEmpty(Uri))
            return;

        using var jim = JimFactory.Create();
        _predefinedSearch = await jim.Search.GetPredefinedSearchAsync(Uri);
        if (_predefinedSearch != null)
        {
            // Criteria group/criterion edits roll up into the owning search's configuration history too, so refresh
            // the Changes tab badge whenever the search is reloaded, not just after the main Save.
            _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.PredefinedSearch, _predefinedSearch.Id, 1, 1)).TotalResults;
        }
    }

    // ─── Criteria group operations ───

    private void HandleOpenAddGroupDialog()
    {
        _addGroupParentId = null;
        _newGroupType = SearchGroupType.All.ToString();
        _addGroupDialogVisible = true;
    }

    private void HandleOpenAddChildGroupDialog(int parentGroupId)
    {
        _addGroupParentId = parentGroupId;
        _newGroupType = SearchGroupType.Any.ToString();
        _addGroupDialogVisible = true;
    }

    private async Task HandleAddGroupAsync()
    {
        if (_predefinedSearch == null || string.IsNullOrEmpty(_newGroupType))
            return;

        var type = (SearchGroupType)Enum.Parse(typeof(SearchGroupType), _newGroupType);

        // Position among siblings: child groups order within their parent, top-level groups among themselves.
        int position;
        if (_addGroupParentId.HasValue)
        {
            var parent = FindGroup(_predefinedSearch.CriteriaGroups, _addGroupParentId.Value);
            position = parent?.ChildGroups.Count ?? 0;
        }
        else
        {
            position = _predefinedSearch.CriteriaGroups.Count;
        }

        try
        {
            using var jim = JimFactory.Create();
            await jim.Search.CreatePredefinedSearchCriteriaGroupAsync(_predefinedSearch.Id, _addGroupParentId, type, position);
            _addGroupDialogVisible = false;
            await ReloadAsync();
            Snackbar.Add(SearchText.CriteriaGroupAdded, Severity.Success);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SearchText.AddGroupFailed, ex.Message), Severity.Error);
        }
    }

    private static PredefinedSearchCriteriaGroup? FindGroup(IEnumerable<PredefinedSearchCriteriaGroup> groups, int groupId)
    {
        foreach (var group in groups)
        {
            if (group.Id == groupId)
                return group;
            var match = FindGroup(group.ChildGroups, groupId);
            if (match != null)
                return match;
        }
        return null;
    }

    private async Task HandleDeleteGroupAsync(int groupId)
    {
        try
        {
            using var jim = JimFactory.Create();
            await jim.Search.DeletePredefinedSearchCriteriaGroupAsync(groupId);
            await ReloadAsync();
            Snackbar.Add(SearchText.CriteriaGroupDeleted, Severity.Success);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SearchText.DeleteGroupFailed, ex.Message), Severity.Error);
        }
    }

    // ─── Criterion operations ───

    private void HandleOpenAddCriteriaDialog(int groupId)
    {
        _addCriteriaGroupId = groupId;
        _editingCriterionId = null;
        _newCriterion = new PredefinedSearchCriteria();
        _newCriterionAttribute = null;
        _addCriteriaDialogVisible = true;
    }

    private void HandleOpenEditCriteriaDialog(PredefinedSearchCriteria criteria)
    {
        _editingCriterionId = criteria.Id;
        // Work on a copy so cancelling the dialog leaves the displayed criterion untouched.
        _newCriterion = new PredefinedSearchCriteria
        {
            Id = criteria.Id,
            ComparisonType = criteria.ComparisonType,
            MetaverseAttributeId = criteria.MetaverseAttribute?.Id ?? criteria.MetaverseAttributeId,
            StringValue = criteria.StringValue,
            IntValue = criteria.IntValue,
            LongValue = criteria.LongValue,
            DecimalValue = criteria.DecimalValue,
            DateTimeValue = criteria.DateTimeValue,
            BoolValue = criteria.BoolValue,
            GuidValue = criteria.GuidValue,
            CaseSensitive = criteria.CaseSensitive,
            ValueMode = criteria.ValueMode,
            RelativeCount = criteria.RelativeCount,
            RelativeUnit = criteria.RelativeUnit,
            RelativeDirection = criteria.RelativeDirection
        };
        var attributeId = criteria.MetaverseAttribute?.Id ?? criteria.MetaverseAttributeId;
        _newCriterionAttribute = _objectTypeAttributes.FirstOrDefault(a => a.Id == attributeId) ?? criteria.MetaverseAttribute;
        _addCriteriaDialogVisible = true;
    }

    private void HandleAttributeSelection(MetaverseAttribute attribute)
    {
        _newCriterionAttribute = attribute;
        if (_newCriterion != null)
        {
            // Reset operator/value when the attribute (and therefore its data type) changes.
            _newCriterion.ComparisonType = SearchComparisonType.NotSet;
            _newCriterion.StringValue = null;
            _newCriterion.IntValue = null;
            _newCriterion.LongValue = null;
            _newCriterion.DecimalValue = null;
            _newCriterion.DateTimeValue = null;
            _newCriterion.BoolValue = null;
            _newCriterion.GuidValue = null;
        }
    }

    private async Task HandleSaveCriterionAsync()
    {
        if (_predefinedSearch == null || _newCriterion == null || _newCriterionAttribute == null)
            return;

        _newCriterion.MetaverseAttributeId = _newCriterionAttribute.Id;
        CriterionValidation.ClearValues(_newCriterion);
        var editing = _editingCriterionId.HasValue;
        try
        {
            using var jim = JimFactory.Create();
            if (editing)
                await jim.Search.UpdatePredefinedSearchCriterionAsync(_newCriterion);
            else
                await jim.Search.CreatePredefinedSearchCriterionAsync(_addCriteriaGroupId, _newCriterion);

            _addCriteriaDialogVisible = false;
            _newCriterion = null;
            _newCriterionAttribute = null;
            _editingCriterionId = null;
            await ReloadAsync();
            Snackbar.Add(editing ? SearchText.CriteriaUpdated : SearchText.CriteriaAdded, Severity.Success);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SearchText.SaveCriteriaFailed, ex.Message), Severity.Error);
        }
    }

    private async Task HandleDeleteCriterionAsync(int criterionId)
    {
        try
        {
            using var jim = JimFactory.Create();
            await jim.Search.DeletePredefinedSearchCriterionAsync(criterionId);
            await ReloadAsync();
            Snackbar.Add(SearchText.CriteriaDeleted, Severity.Success);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SearchText.DeleteCriteriaFailed, ex.Message), Severity.Error);
        }
    }

    private bool DisableAddCriteriaButton()
    {
        if (_newCriterion == null || _newCriterionAttribute == null)
            return true;
        // The same rule the REST API applies (#2053).
        return CriterionValidation.Validate(_newCriterion, _newCriterionAttribute.Type, CriterionContext.PredefinedSearch, _newCriterionAttribute.Name) != null;
    }

    /// <summary>
    /// Renders a criterion's comparison operator in friendly wording (DateTime uses the prior-art labels).
    /// </summary>
    private static string FriendlyComparison(PredefinedSearchCriteria criteria) =>
        CriterionOperatorOptions.FriendlyComparison(criteria.ComparisonType, criteria.GetAttributeDataType());

    private async Task ToggleEnabledAsync(bool isEnabled)
    {
        if (_predefinedSearch == null)
            return;

        // offer an optional reason for the configuration change history; cancelling aborts the save
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
        if (cancelled)
            return;

        try
        {
            using var jim = JimFactory.Create();
            var core = await jim.Search.GetPredefinedSearchCoreAsync(_predefinedSearch.Id);
            if (core == null)
            {
                Snackbar.Add(SearchText.SearchNoLongerExists, Severity.Error);
                return;
            }

            core.IsEnabled = isEnabled;
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Search.UpdatePredefinedSearchAsync(core, user, changeReason);
            _predefinedSearch.IsEnabled = isEnabled;
            _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.PredefinedSearch, _predefinedSearch.Id, 1, 1)).TotalResults;
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, isEnabled ? SearchText.SearchEnabledSnackbar : SearchText.SearchDisabledSnackbar, _predefinedSearch.Name), Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SearchText.UpdateFailed, ex.Message), Severity.Error);
        }
    }
}
