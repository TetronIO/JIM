@using JIM.Models.Activities
@using JIM.Models.Activities.DTOs
@using System.Globalization
@using JIM.Web.Causality
@inject IUserPreferenceService PreferenceService

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

@* An object's causal timeline in the Causality Explorer (#2100): what happened to the object, newest first, each row
   with the run that did it, what it did, and its nearest recorded cause, worded as the Lineage words it. Explore
   re-centres the explorer on the row's item. The host pages the rows in, fifty at a time. *@

<MudTable T="CausalTimelineRow" Items="Rows" Dense="_dense" Hover="true" Elevation="0" Outlined="true"
          RowClass="jim-causality-timeline-row" Class="jim-causality-timeline">
    <ToolBarContent>
        <TableDensityToggle @bind-Dense="_dense" />
        <MudText Class="mx-2 mud-text-disabled">|</MudText>
        <MudText Typo="Typo.h6">@CausalityText.ObjectTimelineTitle</MudText>
        <MudSpacer />
        @if (TotalCount > 0)
        {
            <span class="jim-causality-timeline-count">
                @(Rows.Count < TotalCount
                    ? string.Format(CultureInfo.CurrentCulture, CausalityText.ObjectTimelineCountOf, Rows.Count, TotalCount)
                    : string.Format(CultureInfo.CurrentCulture, TotalCount == 1 ? CausalityText.ObjectTimelineCountOne : CausalityText.ObjectTimelineCountOther, TotalCount))
            </span>
        }
    </ToolBarContent>
    <HeaderContent>
        <MudTh>@CausalityText.ObjectTimelineWhen</MudTh>
        <MudTh>@CausalityText.ObjectTimelineRun</MudTh>
        <MudTh>@CausalityText.ObjectTimelineWhatHappened</MudTh>
        <MudTh>@CausalityText.ObjectTimelineBecause</MudTh>
        <MudTh />
    </HeaderContent>
    <RowTemplate>
        @{ var executedLocal = context.Entry.Executed.ToLocalTime(); }
        <MudTd DataLabel="@CausalityText.ObjectTimelineWhen" Class="jim-nowrap">
            <span title="@executedLocal.ToFriendlyDate()">@executedLocal.ToRelativeTime()</span>
        </MudTd>
        <MudTd DataLabel="@CausalityText.ObjectTimelineRun" Class="jim-nowrap">
            <div>@(context.Entry.ActivityTargetName ?? CausalityText.SummaryRun)</div>
            @if (!string.IsNullOrWhiteSpace(context.Entry.ActivityTargetContext))
            {
                <div class="mud-text-secondary jim-causality-timeline-system">@context.Entry.ActivityTargetContext</div>
            }
        </MudTd>
        <MudTd DataLabel="@CausalityText.ObjectTimelineWhatHappened">
            <OutcomeSummaryChips OutcomeSummary="@context.Entry.OutcomeSummary" ErrorType="@context.Entry.ErrorType" />
        </MudTd>
        <MudTd DataLabel="@CausalityText.ObjectTimelineBecause">
            <CausalityNearestCause NearestCauses="context.NearestCauses" EffectName="@context.Entry.DisplayName" />
        </MudTd>
        <MudTd Class="jim-nowrap">
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="jim-causality-explore"
                       StartIcon="@Icons.Material.Filled.CenterFocusStrong" Href="@Links.ItemHref(context.Entry.RunProfileExecutionItemId)">
                @CausalityText.ObjectTimelineExplore
            </MudButton>
        </MudTd>
    </RowTemplate>
    <ChildRowContent>
        @* The row's follow-ups (#2668), directly beneath it: work its item set in motion that finishes after its run, one
           row each showing where it stands now. Its attempts are on its own Activity. *@
        @if (FollowUps.TryGetValue(context.Entry.RunProfileExecutionItemId, out var followUps))
        {
            foreach (var followUp in followUps)
            {
                var createdLocal = followUp.Created.ToLocalTime();
                <MudTr @key="followUp.ActivityId" Class="jim-causality-timeline-followup">
                    <MudTd DataLabel="@CausalityText.ObjectTimelineWhen" Class="jim-nowrap">
                        <span title="@createdLocal.ToFriendlyDate()">@createdLocal.ToRelativeTime()</span>
                    </MudTd>
                    <MudTd DataLabel="@CausalityText.ObjectTimelineRun" Class="jim-nowrap">
                        <div class="jim-causality-timeline-followup-run">
                            <MudIcon Icon="@Icons.Material.Filled.SubdirectoryArrowRight" Size="Size.Small" aria-hidden="true" />
                            <span>@CausalityText.ObjectTimelineFollowUp</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(followUp.TargetName))
                        {
                            <div class="mud-text-secondary jim-causality-timeline-system">@followUp.TargetName</div>
                        }
                    </MudTd>
                    <MudTd DataLabel="@CausalityText.ObjectTimelineWhatHappened">
                        <span class="@($"jim-status-pill jim-status-pill--{followUp.PillModifier}")">
                            <span class="jim-status-dot"></span>@followUp.Title<span class="jim-status-pill-suffix"> · @followUp.StateLabel</span>
                        </span>
                    </MudTd>
                    <MudTd DataLabel="@CausalityText.ObjectTimelineBecause">
                        <span class="mud-text-secondary">@followUp.Detail</span>
                    </MudTd>
                    <MudTd Class="jim-nowrap">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="@followUp.ActivityHref">
                            @CausalityText.LineageViewActivity
                        </MudButton>
                    </MudTd>
                </MudTr>
            }
        }
    </ChildRowContent>
    <NoRecordsContent>
        <TableEmptyState Icon="@Icons.Material.Filled.History" PrimaryText="@CausalityText.ObjectTimelineEmptyTitle"
                         SecondaryText="@CausalityText.ObjectTimelineEmptyText" />
    </NoRecordsContent>
</MudTable>

@if (Rows.Count < TotalCount && OnShowMore.HasDelegate)
{
    <div class="jim-causality-timeline-more">
        <MudButton Variant="Variant.Filled" Class="jim-causality-show-more" Disabled="@Loading" OnClick="OnShowMore">
            @string.Format(CultureInfo.CurrentCulture, CausalityText.ObjectTimelineShowMore, Math.Min(ActivityServerPageSize, TotalCount - Rows.Count))
        </MudButton>
    </div>
}

@if (MetaverseObjectChangesNotRecorded)
{
    <div class="jim-causality-timeline-note">@ChangesNotRecordedNote</div>
}
@if (Header is { IsDeleted: true } deleted)
{
    <div class="jim-causality-timeline-note">
        @if (deleted.Subject.Kind == CausalTimelineSubjectKind.ConnectedSystemObject)
        {
            @string.Format(CultureInfo.CurrentCulture, CausalityText.ObjectTimelineDeletedConnectedSystemObject, deleted.ConnectedSystemName ?? CausalityText.LineageItsConnectedSystem)
        }
        else
        {
            @CausalityText.ObjectTimelineDeletedMetaverseObject
        }
    </div>
}

@code {
    /// <summary>
    /// How many rows the host reads at a time.
    /// </summary>
    private const int ActivityServerPageSize = JIM.Application.Servers.ActivityServer.CausalTimelineDefaultPageSize;

    /// <summary>
    /// The rows read so far, newest first.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<CausalTimelineRow> Rows { get; set; } = [];

    /// <summary>
    /// How many rows the object's timeline holds in all.
    /// </summary>
    [Parameter]
    public int TotalCount { get; set; }

    /// <summary>
    /// Where a row's Explore goes.
    /// </summary>
    [Parameter, EditorRequired]
    public ICausalityLinks Links { get; set; } = null!;

    /// <summary>
    /// Whether the object is a Metaverse Object on a deployment that records no Metaverse Object changes.
    /// </summary>
    [Parameter]
    public bool MetaverseObjectChangesNotRecorded { get; set; }

    /// <summary>
    /// The object, where it is known; a deleted one says how its rows were found.
    /// </summary>
    [Parameter]
    public CausalObjectHeader? Header { get; set; }

    /// <summary>
    /// Each row's follow-ups (#2668), keyed by the row's execution item; a row with none is absent.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<Guid, IReadOnlyList<JIM.Web.Models.ExecutionItemFollowUpDisplay>> FollowUps { get; set; } =
        new Dictionary<Guid, IReadOnlyList<JIM.Web.Models.ExecutionItemFollowUpDisplay>>();

    /// <summary>
    /// Whether the host is reading the next rows.
    /// </summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>
    /// Reads the next rows; the button shows only where the host handles it.
    /// </summary>
    [Parameter]
    public EventCallback OnShowMore { get; set; }

    private static string ChangesNotRecordedNote => CausalityText.ObjectTimelineChangesNotRecorded;

    private bool _dense;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _dense = await PreferenceService.GetTableDenseAsync() == true;
        StateHasChanged();
    }
}
