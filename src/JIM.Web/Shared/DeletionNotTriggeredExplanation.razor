@*
    The explanation for a disconnection that did NOT trigger Metaverse Object deletion, rendered from the
    decision-time policy snapshot (#119). Renders inline so a host alert can lead with its own headline
    ("The Metaverse Object was not deleted.") and follow with this recorded reasoning, in the trigger
    mode vocabulary, without any current-configuration caveat.

    Each sentence is one resource string; the values it names are set in bold where the English sets them
    (see Rich), so a translation can put them where its grammar needs them.
*@

@switch (Snapshot.DeletionRule)
{
    case MetaverseObjectDeletionRule.Manual:
        if (string.IsNullOrEmpty(ObjectTypeName))
        {
            @Rich(ConnectorSpaceText.DelManualUntyped, (ConnectorSpaceText.DelManualLabel, true))
        }
        else
        {
            @Rich(ConnectorSpaceText.DelManualTyped, (ObjectTypeName, true), (ConnectorSpaceText.DelManualLabel, true))
        }
        break;

    case MetaverseObjectDeletionRule.WhenLastConnectorDisconnected:
        if (string.IsNullOrEmpty(ObjectTypeName))
        {
            @Rich(ConnectorSpaceText.DelLastConnectorUntyped, (ConnectorSpaceText.DelAllConnectors, true))
        }
        else
        {
            @Rich(ConnectorSpaceText.DelLastConnectorTyped, (ObjectTypeName, true), (ConnectorSpaceText.DelAllConnectors, true))
        }
        break;

    case MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected:
        if (TriggeringSystemWasNotASource)
        {
            @Rich(ConnectorSpaceText.DelNotSourceSystem, (Snapshot.TriggeringSystemName ?? string.Empty, true))
        }
        else if (Snapshot.TriggerMode == AuthoritativeSourceTriggerMode.AllSourcesDisconnect
                 && Snapshot.RemainingConnectedSourceSystemNames.Count > 0)
        {
            @Rich(ConnectorSpaceText.DelAllSourcesMode,
                (ConnectorSpaceText.DelAllSourcesLabel, true),
                (Snapshot.TriggeringSystemName ?? string.Empty, true),
                (Snapshot.RemainingConnectedSourceSystemIds.Count.ToString(), false),
                (Snapshot.SelectedSourceSystemIds.Count.ToString(), false),
                (string.Join(", ", Snapshot.RemainingConnectedSourceSystemNames), true))
        }
        else if (string.IsNullOrEmpty(ObjectTypeName))
        {
            @Rich(ConnectorSpaceText.DelAuthoritativeUntyped)
        }
        else
        {
            @Rich(ConnectorSpaceText.DelAuthoritativeTyped, (ObjectTypeName, true))
        }
        break;
}
<text> @ConnectorSpaceText.DelExplainFooter</text>

@code {
    /// <summary>
    /// The decision-time deletion policy snapshot to explain.
    /// </summary>
    [Parameter, EditorRequired]
    public MvoDeletionPolicySnapshot Snapshot { get; set; } = null!;

    /// <summary>
    /// The Metaverse Object Type's singular name, when known, e.g. "Person".
    /// </summary>
    [Parameter]
    public string? ObjectTypeName { get; set; }

    private bool TriggeringSystemWasNotASource =>
        Snapshot.TriggeringSystemId is { } triggeringSystemId
        && !Snapshot.SelectedSourceSystemIds.Contains(triggeringSystemId);

    /// <summary>
    /// Renders a resource sentence in which each <c>{n}</c> stands for one of the values, in the order given. A value
    /// flagged for emphasis is set in bold. The values are text, so Blazor encodes them; the sentence itself never
    /// passes through markup.
    /// </summary>
    private static RenderFragment Rich(string template, params (string Text, bool Emphasis)[] values) => builder =>
    {
        var sequence = 0;
        var position = 0;
        while (position < template.Length)
        {
            var open = template.IndexOf('{', position);
            if (open < 0)
            {
                builder.AddContent(sequence++, template[position..]);
                break;
            }

            var close = template.IndexOf('}', open);
            builder.AddContent(sequence++, template[position..open]);
            var (text, emphasis) = values[int.Parse(template[(open + 1)..close], System.Globalization.CultureInfo.InvariantCulture)];
            if (emphasis)
            {
                builder.OpenElement(sequence++, "strong");
                builder.AddContent(sequence++, text);
                builder.CloseElement();
            }
            else
            {
                builder.AddContent(sequence++, text);
            }

            position = close + 1;
        }
    };
}
