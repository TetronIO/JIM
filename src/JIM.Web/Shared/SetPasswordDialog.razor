@using JIM.Models.Staging
@using Microsoft.JSInterop
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@implements IDisposable

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

@* Sets one password on one or more of a person's accounts (issues #1121, #1172).                        *@
@*                                                                                                       *@
@* One component for both surfaces. Opened from a Connected System Object the account is a given, so the *@
@* picker and the progress rail are not drawn; opened from a Metaverse Object the administrator chooses  *@
@* which accounts, and the rail carries progress across them. A rail of one step is decoration, so the   *@
@* single-account case collapses to exactly the dialog that shipped for #1121.                           *@
@*                                                                                                       *@
@* The value is masked from the moment it is generated, and copy works while it is masked, so handing a  *@
@* password to the person who needs it never means putting it on a screen. Reveal is the secondary       *@
@* affordance and re-conceals on a timer.                                                                *@
@*                                                                                                       *@
@* This component holds the password in memory for as long as it is open and writes it nowhere.          *@

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4" Style="min-width: 480px;">
            @if (_stage == Stage.Composing)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @if (AllowSelection)
                    {
                        <span>Sets the <b>same password</b> on the accounts you choose. Each Connected System is
                            written to separately; JIM stores nothing.</span>
                    }
                    else
                    {
                        <span>Sets the password on <b>@Accounts[0].AccountIdentifier</b> in
                            <b>@Accounts[0].ConnectedSystemName</b>. JIM writes it straight to the Connected
                            System; it is not staged, not retried, and not stored anywhere in JIM.</span>
                    }
                </MudText>
            }

            @if (!AnyAccountCanTakeAPassword)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" data-testid="jim-set-password-unsupported">
                    @(AllowSelection
                        ? "None of this person's accounts are in a Connected System whose Connector can set passwords."
                        : "This Connected System's Connector cannot set passwords, so there is nothing to do here.")
                </MudAlert>
            }
            else
            {
                @* The consequence first, before the detail that explains it: which accounts still hold their *@
                @* old password is what the administrator has to act on, and what they have to tell the      *@
                @* person waiting on the telephone.                                                          *@
                @* Three outcomes, three severities. Nothing set at all is a failure, not a caution: reporting *@
                @* it in amber understates it, and an administrator scanning for whether they still have work  *@
                @* to do reads the colour before the sentence. Partly set is genuinely a warning, because some *@
                @* accounts did take the password and the rest are the exception.                              *@
                @if (_stage == Stage.Finished && _result != null)
                {
                    <MudAlert Severity="@SummarySeverity" Variant="Variant.Outlined"
                              data-testid="jim-set-password-summary">
                        @SummarySentence
                    </MudAlert>
                }

                @* ─── Account picker: only while there is still a choice to make ─── *@
                @if (AllowSelection && _stage == Stage.Composing)
                {
                    <div>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Baseline">
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">Accounts</MudText>
                            <MudLink Typo="Typo.body2" @onclick="SelectAll" data-testid="jim-set-password-select-all">
                                Select all
                            </MudLink>
                        </MudStack>

                        <MudPaper Outlined="true" Class="pa-0 mt-1">
                            @foreach (var account in SettableAccounts)
                            {
                                @* Aligned to the top so the control sits against the Connected System's name.  *@
                                @* Centring it across a two-line row leaves it floating between the name and    *@
                                @* the account identifier, belonging to neither.                                *@
                                <div class="jim-password-row d-flex align-start" data-testid="jim-set-password-account">
                                    <MudCheckBox T="bool" Value="@_selected.Contains(account.ConnectedSystemObjectId)"
                                                 ValueChanged="@(value => ToggleAccount(account, value))"
                                                 Dense="true" Class="mr-2 jim-password-account-control" />
                                    <MudStack Spacing="0" Class="flex-grow-1" Style="min-width:0">
                                        <MudText Typo="Typo.body2" Class="jim-password-system-name">@account.ConnectedSystemName</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                            @account.AccountIdentifier
                                        </MudText>
                                    </MudStack>
                                </div>
                            }
                        </MudPaper>

                        @if (UnsettableAccounts.Count > 0)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1"
                                     data-testid="jim-set-password-unsettable">
                                @UnsettableSentence
                            </MudText>
                        }
                    </div>
                }

                @* ─── The rail: one step per Connected System, drawn only when there is a sequence ─── *@
                @if (ShowRail)
                {
                    <div class="jim-password-rail" data-testid="jim-set-password-rail">
                        @if (_stage == Stage.Composing)
                        {
                            <MudText Typo="Typo.overline" Class="mud-text-secondary">Will be written in this order</MudText>
                        }
                        <div class="jim-password-rail-steps">
                            @for (var index = 0; index < RailAccounts.Count; index++)
                            {
                                var account = RailAccounts[index];
                                if (index > 0)
                                {
                                    <div class="jim-password-rail-connector">
                                        <span class="jim-password-rail-connector-fill jim-password-rail-connector-fill--@RailState(RailAccounts[index - 1])"></span>
                                    </div>
                                }
                                <div class="jim-password-rail-step jim-password-rail-step--@RailState(account)">
                                    <span class="jim-password-rail-marker jim-password-rail-marker--@RailState(account)">
                                        <MudIcon Icon="@RailIcon(account)" />
                                    </span>
                                    <MudText Typo="Typo.caption" Class="jim-password-rail-step-name">@account.ConnectedSystemName</MudText>
                                    @* Only the duration earns a second line; what a step means is carried by  *@
                                    @* its marker, and repeating it as a caption under every one is noise.     *@
                                    @if (OutcomeFor(account) is { } railOutcome)
                                    {
                                        <MudText Typo="Typo.caption" Class="jim-phase-step-duration">
                                            @railOutcome.Duration.ToAbbreviatedString()
                                        </MudText>
                                    }
                                </div>
                            }
                        </div>
                        @if (_runningAccount != null)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="jim-set-password-rail-detail">
                                Setting the password on @_runningAccount.AccountIdentifier
                            </MudText>
                        }
                    </div>
                }

                @* ─── What happened, one row per account written to ─── *@
                @* Its own list rather than status bolted onto the picker: the checkbox column has nothing left *@
                @* to say, and a row that was a question is a poor place to read an answer. Drawn only for a    *@
                @* fan-out; with one account the summary above is the same sentence.                            *@
                @if (_stage == Stage.Finished && _attempted.Count > 1)
                {
                    <MudPaper Outlined="true" Class="pa-0 jim-password-results" data-testid="jim-set-password-results">
                        @* Paired and filtered in the sequence rather than guarded in the body: a cancelled     *@
                        @* fan-out leaves later accounts without an outcome, so the filter is load-bearing, and *@
                        @* CodeQL reads a loop whose body is one if as a Where waiting to happen.               *@
                        @foreach (var row in _attempted
                            .Select(a => (Account: a, Outcome: OutcomeFor(a)))
                            .Where(r => r.Outcome != null))
                        {
                            var account = row.Account;
                            var outcome = row.Outcome!;
                            {
                                @* The row carries the failure, not the sentence inside it. Setting the target's *@
                                @* own words in red made three lines of washed-out prose that read as milder    *@
                                @* than the thing it was reporting, and site.css already says why: the house    *@
                                @* error alert deliberately keeps its message in the ordinary text colour and   *@
                                @* signals severity through the container.                                      *@
                                <div class="jim-password-result jim-password-row jim-password-result--@RailState(account)"
                                     data-testid="jim-set-password-result">
                                    <MudIcon Icon="@OutcomeIcon(account)" Color="@OutcomeColour(account)"
                                             Class="jim-password-result-icon" />
                                    <div class="jim-password-result-body">
                                        <MudText Typo="Typo.body2" Class="jim-password-system-name">@account.ConnectedSystemName</MudText>
                                        <MudText Typo="Typo.body2"
                                                 Class="@(outcome.Result.Success ? "mud-text-secondary" : "jim-password-result-reason")">
                                            @DescribeOutcome(outcome)
                                        </MudText>
                                        <PasswordFailureGuidancePanel FailureReason="@outcome.Result.FailureReason"
                                                                      ConnectedSystemId="@account.ConnectedSystemId"
                                                                      ConnectedSystemName="@account.ConnectedSystemName"
                                                                      AccountCount="@_attempted.Count"
                                                                      OnRegenerateForAll="RegenerateForAllAsync" />
                                    </div>
                                </div>
                            }
                        }
                    </MudPaper>
                }

                @* ─── The password itself ─── *@
                @* Immediate, so the Set button follows what has been typed rather than waiting for a blur. *@
                <MudTextField T="string" Value="@_password" Label="Password" Immediate="true"
                              Variant="Variant.Outlined" ReadOnly="@(_stage != Stage.Composing)"
                              InputType="@(_revealed ? InputType.Text : InputType.Password)"
                              Placeholder="Generate one, or type your own"
                              ValueChanged="@(value => _password = value ?? string.Empty)"
                              data-testid="jim-set-password-value" />

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="flex-wrap">
                    @if (_stage != Stage.Running)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                                   StartIcon="@Icons.Material.Filled.Casino" OnClick="GenerateForSelection"
                                   Disabled="@(!CanGenerate)"
                                   data-testid="jim-set-password-generate">Generate</MudButton>
                    }

                    @* Copy deliberately does not require a reveal: transferring a password to the person who *@
                    @* needs it should never mean putting it on screen where it can be read over a shoulder.  *@
                    <MudTooltip Text="@CopyTooltip" Arrow="true" Placement="Placement.Top">
                        <span>
                            <MudButton Variant="Variant.Outlined" DropShadow="false"
                                       StartIcon="@Icons.Material.Filled.ContentCopy"
                                       Disabled="@(!CanCopy)" OnClick="CopyAsync"
                                       data-testid="jim-set-password-copy">Copy</MudButton>
                        </span>
                    </MudTooltip>

                    <MudButton Variant="Variant.Text" DropShadow="false"
                               StartIcon="@(_revealed ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                               Disabled="@(_password.Length == 0)" OnClick="ToggleRevealAsync"
                               data-testid="jim-set-password-reveal">@(_revealed ? "Hide" : "Reveal")</MudButton>
                </MudStack>

                @if (_revealed)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="jim-set-password-reveal-notice">
                        Hidden again automatically in @($"{RevealDuration.TotalSeconds:0}") seconds.
                    </MudText>
                }

                @if (_stage == Stage.Composing)
                {
                    @if (_reconciliation is { Constraints.Count: > 0 })
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary" data-testid="jim-set-password-constraints">
                            Generated to satisfy @(SelectedAccounts.Count > 1 ? "every selected system" : "this system"):
                            @string.Join(", ", _reconciliation.Constraints).
                        </MudText>
                    }

                    @* Two different situations wear the same face here, and only one of them is the           *@
                    @* administrator's to fix: a schema that has not been imported yet, versus a system that    *@
                    @* publishes no password rules for any client to read. Saying which decides whether they    *@
                    @* go and do something or carry on.                                                        *@
                    @if (SystemsAwaitingSchemaRefresh.Count > 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true"
                                  data-testid="jim-set-password-unknown-policy">
                            <MudText Typo="Typo.body2">
                                JIM has no password policy for
                                <b>@string.Join(", ", SystemsAwaitingSchemaRefresh.Select(a => a.ConnectedSystemName))</b>,
                                so a generated password cannot be checked against
                                @(SystemsAwaitingSchemaRefresh.Count == 1 ? "its" : "their") rules before it is sent.
                                JIM reads the policy while it refreshes a Connected System's schema, so
                                <b>Refresh Schema</b> on the Schema tab will pick it up.
                            </MudText>
                            @foreach (var account in SystemsAwaitingSchemaRefresh)
                            {
                                var connectedSystemId = account.ConnectedSystemId;
                                <MudLink Href="@($"/admin/connected-systems/{connectedSystemId}/?t=schema")"
                                         Typo="Typo.body2" Class="d-inline-flex align-center mt-1 mr-3">
                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="mr-1" />
                                    @account.ConnectedSystemName's Schema tab
                                </MudLink>
                            }
                        </MudAlert>
                    }

                    @if (SystemsThatPublishNoPolicy.Count > 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary"
                                 data-testid="jim-set-password-no-published-policy">
                            @string.Join(", ", SystemsThatPublishNoPolicy.Select(a => a.ConnectedSystemName))
                            @(SystemsThatPublishNoPolicy.Count == 1 ? "does" : "do") not publish password rules
                            that any client can read, so JIM cannot check a password against
                            @(SystemsThatPublishNoPolicy.Count == 1 ? "them" : "them") in advance. There is
                            nothing to configure: a password
                            @(SystemsThatPublishNoPolicy.Count == 1 ? "it refuses" : "they refuse") is reported
                            when it happens.
                        </MudText>
                    }

                    @if (_reconciliation is { IsUsable: false })
                    {
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined"
                                  data-testid="jim-set-password-irreconcilable">
                            No single password can satisfy every selected system.
                            @string.Join(" ", _reconciliation.Conflicts)
                            Set them separately, or deselect one.
                        </MudAlert>
                    }

                    <MudSelect T="PasswordExpiryBehaviour" Label="After the password is set" @bind-Value="_expiryBehaviour"
                               Variant="Variant.Outlined" Dense="true" data-testid="jim-set-password-expiry">
                        @foreach (var behaviour in AvailableExpiryBehaviours)
                        {
                            <MudSelectItem Value="behaviour">@DescribeExpiryBehaviour(behaviour)</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSwitch T="bool" @bind-Value="_enableAccount" Color="Color.Primary"
                               Label="@(SelectedAccounts.Count > 1 ? "Enable the accounts as part of setting the password" : "Enable the account as part of setting the password")"
                               data-testid="jim-set-password-enable" />

                    @* Shared and permanent is the combination worth naming. A shared password is defensible   *@
                    @* when it must be changed at the next sign-in; one that never expires, held in several    *@
                    @* systems, means a credential taken from any one of them opens the others, with nothing   *@
                    @* to rotate it. Advisory rather than refused: JIM does not know the deployment's rules.   *@
                    @if (SelectedAccounts.Count > 1 && _expiryBehaviour == PasswordExpiryBehaviour.NeverExpires)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true"
                                  data-testid="jim-set-password-shared-permanent">
                            One password that never expires, held in @SelectedAccounts.Count systems. A credential
                            taken from any one of them opens the others, and nothing will rotate it. Consider
                            setting these separately.
                        </MudAlert>
                    }

                    @if (!_clipboardAvailable)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true"
                                  data-testid="jim-set-password-no-clipboard">
                            Copying is unavailable because this page was not served over HTTPS. Browsers only
                            allow clipboard access in a secure context.
                        </MudAlert>
                    }

                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        JIM clears the clipboard when this dialog closes where the browser allows it, but your
                        operating system may keep a copy in its own clipboard history.
                    </MudText>
                }

                @if (_failure != null)
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" data-testid="jim-set-password-failure">
                        @_failure
                    </MudAlert>
                }

                @* One account writes no results list, because the summary above is already that sentence; its *@
                @* guidance therefore hangs off the summary instead. Keyed on what was attempted rather than on *@
                @* which surface opened the dialog, so selecting a single account on a Metaverse Object gets    *@
                @* the same treatment as opening it from that account's Connected System Object.                *@
                @if (_stage == Stage.Finished && _attempted.Count == 1 && _result != null && _result.Failed.Count > 0)
                {
                    var onlyFailure = _result.Failed[0];
                    <PasswordFailureGuidancePanel FailureReason="@onlyFailure.Result.FailureReason"
                                                  ConnectedSystemId="@onlyFailure.ConnectedSystemId"
                                                  ConnectedSystemName="@onlyFailure.ConnectedSystemName"
                                                  AccountCount="1" />
                }
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="CloseAsync" DropShadow="false" Disabled="@(_stage == Stage.Running)"
                   data-testid="jim-set-password-cancel">
            @(_stage == Stage.Finished ? "Done" : "Cancel")
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
                   Disabled="@(!CanSubmit)" OnClick="SubmitAsync" data-testid="jim-set-password-submit">
            @if (_stage == Stage.Running)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" Size="Size.Small" />
                <span class="ms-2">Setting...</span>
            }
            else
            {
                <span>@SubmitLabel</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The accounts this dialog can set a password on, including those whose Connector cannot: they are shown
    /// as a sentence rather than left out, so an administrator looking for a system that is not offered can see
    /// that JIM knows about it and why it is not on the list.
    /// </summary>
    [Parameter]
    public IReadOnlyList<MetaverseObjectAccount> Accounts { get; set; } = [];

    /// <summary>
    /// Whether the administrator chooses which accounts. False when the dialog was opened from one Connected
    /// System Object, where the account is a given and a picker would be a control with one option.
    /// </summary>
    [Parameter]
    public bool AllowSelection { get; set; }

    /// <summary>
    /// Works out one set of generator settings that satisfies every selected system at once, and what had to be
    /// assumed to get there. Supplied by the caller, which owns the policy lookups.
    /// </summary>
    [Parameter]
    public Func<IReadOnlyList<MetaverseObjectAccount>, PasswordPolicyReconciliation> Reconcile { get; set; } =
        _ => new PasswordPolicyReconciliation
        {
            Policy = new PasswordGenerationPolicy(),
            Constraints = [],
            SystemsWithNoDiscoveredPolicy = [],
            Conflicts = [],
            MayBeStricterThanDiscovered = false
        };

    /// <summary>
    /// Produces a password from the reconciled settings.
    /// </summary>
    [Parameter]
    public Func<PasswordGenerationPolicy, string> GeneratePassword { get; set; } = _ => string.Empty;

    /// <summary>
    /// Sets the password on the chosen accounts, reporting each outcome as it lands. A Connected System that
    /// refuses is a result rather than an exception, and its reason is shown against that account.
    /// </summary>
    [Parameter]
    public Func<IReadOnlyList<MetaverseObjectAccount>, string, PasswordSetOptions, IProgress<AccountPasswordSetOutcome>, Task<MultiAccountPasswordSetResult>> SetPassword { get; set; } =
        (_, _, _, _) => Task.FromResult(new MultiAccountPasswordSetResult { Outcomes = [] });

    /// <summary>
    /// How long a revealed password stays on screen before hiding itself again.
    /// <para>
    /// A parameter so tests do not have to wait out the real interval; nothing in the application overrides it.
    /// </para>
    /// </summary>
    [Parameter]
    public TimeSpan RevealDuration { get; set; } = TimeSpan.FromSeconds(30);

    private enum Stage { Composing, Running, Finished }

    private Stage _stage = Stage.Composing;
    private string _password = string.Empty;
    private bool _revealed;
    private bool _clipboardAvailable = true;
    private string? _failure;
    private PasswordExpiryBehaviour _expiryBehaviour = PasswordExpiryBehaviour.RequireChangeAtNextSignIn;
    private bool _enableAccount;
    private CancellationTokenSource? _revealTimeout;
    private PasswordPolicyReconciliation? _reconciliation;

    private readonly HashSet<Guid> _selected = [];
    private readonly List<MetaverseObjectAccount> _attempted = [];
    private readonly Dictionary<Guid, AccountPasswordSetOutcome> _outcomes = [];
    private MetaverseObjectAccount? _runningAccount;
    private MultiAccountPasswordSetResult? _result;

    private IReadOnlyList<MetaverseObjectAccount> SettableAccounts =>
        Accounts.Where(a => a.ConnectorCanSetPasswords).ToList();

    private IReadOnlyList<MetaverseObjectAccount> UnsettableAccounts =>
        Accounts.Where(a => !a.ConnectorCanSetPasswords).ToList();

    private bool AnyAccountCanTakeAPassword => SettableAccounts.Count > 0;

    private IReadOnlyList<MetaverseObjectAccount> SelectedAccounts =>
        SettableAccounts.Where(a => _selected.Contains(a.ConnectedSystemObjectId)).ToList();

    /// <summary>
    /// The accounts the rail draws: what is selected while composing, what was attempted afterwards.
    /// </summary>
    private IReadOnlyList<MetaverseObjectAccount> RailAccounts =>
        _stage == Stage.Composing ? SelectedAccounts : _attempted;

    /// <summary>
    /// A rail of one step is decoration, so it appears only where there is genuinely a sequence to narrate.
    /// </summary>
    private bool ShowRail => RailAccounts.Count > 1;

    /// <summary>
    /// Only the behaviours every selected Connector can apply. Offering one that some cannot would let an
    /// administrator choose a setting that is silently downgraded on part of the fan-out.
    /// </summary>
    private IReadOnlyList<PasswordExpiryBehaviour> AvailableExpiryBehaviours
    {
        get
        {
            var accounts = SelectedAccounts.Count > 0 ? SelectedAccounts : SettableAccounts;
            if (accounts.Count == 0)
                return [];

            return accounts
                .Select(a => a.SupportedExpiryBehaviours.ToHashSet())
                .Aggregate((left, right) => { left.IntersectWith(right); return left; })
                .OrderBy(b => b)
                .ToList();
        }
    }

    /// <summary>
    /// Selected systems whose Connector could read a password policy but where JIM holds none: a schema
    /// refresh away from being checkable, and therefore the administrator's to act on.
    /// <para>
    /// Refresh rather than retrieve, deliberately. The Schema tab offers <b>Retrieve Schema</b> only before a
    /// system has one, and every system reachable from this dialog necessarily has a schema already, because
    /// its accounts were imported through it. <b>Refresh Schema</b> is therefore the button they will find.
    /// </para>
    /// </summary>
    private IReadOnlyList<MetaverseObjectAccount> SystemsAwaitingSchemaRefresh =>
        SelectedAccounts.Where(a => a.ConnectorCanDiscoverPasswordPolicy && a.DiscoveredPolicy is not { HasAnyDiscoveredConstraint: true }).ToList();

    /// <summary>
    /// Selected systems that publish no password rules for any client to read. Worth stating once, so an absent
    /// policy does not read as something left undone, but there is nothing here to fix.
    /// </summary>
    private IReadOnlyList<MetaverseObjectAccount> SystemsThatPublishNoPolicy =>
        SelectedAccounts.Where(a => !a.ConnectorCanDiscoverPasswordPolicy).ToList();

    private bool CanGenerate => SelectedAccounts.Count > 0 && _reconciliation is not { IsUsable: false };

    private bool CanCopy => _clipboardAvailable && _password.Length > 0;

    private bool CanSubmit => AnyAccountCanTakeAPassword && _password.Length > 0 && _stage != Stage.Running
                              && SelectedAccounts.Count > 0 && _reconciliation is not { IsUsable: false };

    private string CopyTooltip => _clipboardAvailable
        ? "Copy the password without showing it"
        : "Clipboard access needs an HTTPS connection";

    private string SubmitLabel
    {
        get
        {
            if (_stage == Stage.Finished && _result is { } result && result.Failed.Count > 0)
                return result.Failed.Count == 1
                    ? $"Retry {result.Failed[0].ConnectedSystemName}"
                    : $"Retry {result.Failed.Count} failed";

            return SelectedAccounts.Count > 1 ? $"Set on {SelectedAccounts.Count} accounts" : "Set Password";
        }
    }

    private string UnsettableSentence
    {
        get
        {
            var names = string.Join(", ", UnsettableAccounts.Select(a => a.ConnectedSystemName));
            return UnsettableAccounts.Count == 1
                ? $"{names} holds an account for this person, but its Connector cannot set passwords."
                : $"{names} hold accounts for this person, but their Connectors cannot set passwords.";
        }
    }

    /// <summary>
    /// How loudly the outcome is reported. A fan-out where nothing landed is an error; one where some accounts
    /// took the password and others did not is a warning, because the person now holds two different passwords.
    /// </summary>
    private Severity SummarySeverity => _result switch
    {
        { FailedCount: 0 } => Severity.Success,
        { SucceededCount: 0 } => Severity.Error,
        _ => Severity.Warning
    };

    private string SummarySentence
    {
        get
        {
            if (_result == null)
                return string.Empty;

            if (_result.FailedCount == 0)
                return _result.Outcomes.Count == 1
                    ? "Password set."
                    : $"Password set on all {_result.Outcomes.Count} accounts.";

            // Names the consequence rather than the count: which accounts still hold their old password is what
            // decides what the administrator does next, and what they have to tell the person waiting.
            var failedNames = string.Join(", ", _result.Failed.Select(f => f.ConnectedSystemName));
            return _result.SucceededCount == 0
                ? $"The password was not set. {failedNames} refused it."
                : $"Set on {_result.SucceededCount} of {_result.Outcomes.Count} accounts. The password in {failedNames} is unchanged, so this person now has a different one there.";
        }
    }

    protected override void OnInitialized()
    {
        // With no choice to make, the one account is the selection. Nothing is preselected where there is a
        // choice: somebody resetting a forgotten password in one system must not silently reset the others.
        if (!AllowSelection)
            foreach (var account in SettableAccounts)
                _selected.Add(account.ConnectedSystemObjectId);

        RefreshReconciliation();
        AlignExpiryBehaviour();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _clipboardAvailable = await JsRuntime.InvokeAsync<bool>("jimInterop.isClipboardAvailable");
            StateHasChanged();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or InvalidOperationException)
        {
            // The circuit went away, or JS is not ready. Copying stays offered; the attempt itself reports
            // failure honestly, which is a better outcome than hiding the button over a transient condition.
        }
    }

    private void ToggleAccount(MetaverseObjectAccount account, bool selected)
    {
        if (selected)
            _selected.Add(account.ConnectedSystemObjectId);
        else
            _selected.Remove(account.ConnectedSystemObjectId);

        RefreshReconciliation();
        AlignExpiryBehaviour();
    }

    private void SelectAll()
    {
        foreach (var account in SettableAccounts)
            _selected.Add(account.ConnectedSystemObjectId);

        RefreshReconciliation();
        AlignExpiryBehaviour();
    }

    /// <summary>
    /// Re-derives the generator settings whenever the selection changes, so what Generate would produce always
    /// matches the systems currently ticked rather than the ones ticked when it was last pressed.
    /// </summary>
    private void RefreshReconciliation()
    {
        _reconciliation = SelectedAccounts.Count == 0 ? null : Reconcile(SelectedAccounts);
    }

    /// <summary>
    /// Keeps the expiry choice to something every selected Connector can apply. Narrowing the selection can
    /// take the current choice away, and leaving it selected would submit a behaviour part of the fan-out
    /// silently downgrades.
    /// </summary>
    private void AlignExpiryBehaviour()
    {
        var available = AvailableExpiryBehaviours;
        if (available.Count > 0 && !available.Contains(_expiryBehaviour))
            _expiryBehaviour = available[0];
    }

    private void GenerateForSelection()
    {
        if (_reconciliation == null)
            return;

        _password = GeneratePassword(_reconciliation.Policy);
        _failure = null;

        // Generated masked, always. The administrator asked for a password, not to look at one.
        CancelRevealTimeout();
        _revealed = false;
    }

    private async Task CopyAsync()
    {
        var copied = await TryInvokeAsync<bool>("jimInterop.copyToClipboard", _password);
        if (copied)
            Snackbar.Add("Password copied to the clipboard.", Severity.Success);
        else
            Snackbar.Add("The password could not be copied. Reveal it and copy it by hand.", Severity.Warning);
    }

    /// <summary>
    /// Shows the password, and starts the clock that hides it again. Hiding early cancels that clock, so a
    /// second reveal always gets a full interval rather than inheriting the remains of the first.
    /// </summary>
    private async Task ToggleRevealAsync()
    {
        CancelRevealTimeout();
        _revealed = !_revealed;

        if (!_revealed)
            return;

        var timeout = new CancellationTokenSource();
        _revealTimeout = timeout;

        try
        {
            await Task.Delay(RevealDuration, timeout.Token);
            _revealed = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // Hidden by hand, revealed again, or the dialog closed. Nothing to do; whoever cancelled has
            // already set the state they wanted.
        }
    }

    /// <summary>
    /// Runs the fan-out over the accounts still owed a password: everything selected on the first attempt, and
    /// only what failed on a retry. Retrying an account that took the password would reset a password the
    /// person may already be using.
    /// </summary>
    private async Task SubmitAsync()
    {
        var accounts = _stage == Stage.Finished && _result is { } result && result.Failed.Count > 0
            ? result.Failed.Select(f => _attempted.Single(a => a.ConnectedSystemObjectId == f.ConnectedSystemObjectId)).ToList()
            : SelectedAccounts;

        await RunAsync(accounts);
    }

    /// <summary>
    /// Generates a fresh password and sets it on <b>every</b> account this fan-out touched, including the ones
    /// that already succeeded.
    /// <para>
    /// The only answer that serves the point of setting one password. Re-sending a value the target refused
    /// fails identically; replacing it only where it failed leaves the person with two different passwords.
    /// </para>
    /// </summary>
    private async Task RegenerateForAllAsync()
    {
        var accounts = _attempted.ToList();
        _reconciliation = Reconcile(accounts);
        if (_reconciliation is { IsUsable: false })
            return;

        _password = GeneratePassword(_reconciliation.Policy);
        CancelRevealTimeout();
        _revealed = false;

        await RunAsync(accounts);
    }

    private async Task RunAsync(IReadOnlyList<MetaverseObjectAccount> accounts)
    {
        if (accounts.Count == 0)
            return;

        _stage = Stage.Running;
        _failure = null;
        _attempted.Clear();
        _attempted.AddRange(accounts);
        foreach (var account in accounts)
            _outcomes.Remove(account.ConnectedSystemObjectId);
        _runningAccount = accounts[0];

        var options = new PasswordSetOptions
        {
            ExpiryBehaviour = _expiryBehaviour,
            // Null, not false: leaving an account's enabled state alone is the right default for a reset on an
            // account that is already in the state the administrator wants.
            EnableAccount = _enableAccount ? true : null
        };

        var progress = new Progress<AccountPasswordSetOutcome>(outcome =>
        {
            _outcomes[outcome.ConnectedSystemObjectId] = outcome;
            var next = accounts.SkipWhile(a => _outcomes.ContainsKey(a.ConnectedSystemObjectId)).FirstOrDefault();
            _runningAccount = next;
            StateHasChanged();
        });

        try
        {
            _result = await SetPassword(accounts, _password, options, progress);
            foreach (var outcome in _result.Outcomes)
                _outcomes[outcome.ConnectedSystemObjectId] = outcome;
        }
        finally
        {
            _runningAccount = null;
            _stage = Stage.Finished;
        }

        if (_result.FailedCount == 0)
        {
            var warning = _result.Outcomes.Select(o => o.Result.ExpiryBehaviourWarning).FirstOrDefault(w => w != null);
            Snackbar.Add(warning == null ? "Password set." : $"Password set. {warning}",
                warning == null ? Severity.Success : Severity.Warning);
            await ClearClipboardAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private AccountPasswordSetOutcome? OutcomeFor(MetaverseObjectAccount account) =>
        _outcomes.TryGetValue(account.ConnectedSystemObjectId, out var outcome) ? outcome : null;

    private static string DescribeOutcome(AccountPasswordSetOutcome outcome)
    {
        if (!outcome.Result.Success)
            // The target's own words, kept verbatim: why a directory refuses a password is a property of that
            // directory's policy, and paraphrasing loses the only detail that helps.
            return outcome.Result.ErrorMessage ?? "The Connected System refused the password without saying why.";

        return outcome.Result.ExpiryBehaviourWarning == null
            ? "Password set."
            : $"Password set. {outcome.Result.ExpiryBehaviourWarning}";
    }

    private string OutcomeIcon(MetaverseObjectAccount account) => OutcomeFor(account) switch
    {
        { Result.Success: true } => Icons.Material.Filled.CheckCircle,
        { Result.Success: false } => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.RadioButtonUnchecked
    };

    private Color OutcomeColour(MetaverseObjectAccount account) => OutcomeFor(account) switch
    {
        { Result.Success: true } => Color.Success,
        { Result.Success: false } => Color.Error,
        _ => Color.Default
    };

    /// <summary>
    /// Where one Connected System has got to, as the modifier that colours its marker and name. The same four
    /// states the Run Profile stepper reports, so a rail means the same thing wherever JIM draws one.
    /// </summary>
    private string RailState(MetaverseObjectAccount account)
    {
        if (OutcomeFor(account) is { } outcome)
            return outcome.Result.Success ? "completed" : "failed";

        return _runningAccount?.ConnectedSystemObjectId == account.ConnectedSystemObjectId ? "active" : "pending";
    }

    /// <summary>
    /// A finished step shows its outcome and a running one shows the work; a step that has not started shows
    /// nothing, because its empty ring already says so and a glyph inside the ring is a circle in a circle.
    /// </summary>
    private string RailIcon(MetaverseObjectAccount account) => RailState(account) switch
    {
        "completed" => Icons.Material.Filled.Check,
        "failed" => Icons.Material.Filled.Close,
        "active" => Icons.Material.Filled.Key,
        _ => string.Empty
    };

    private async Task CloseAsync()
    {
        await ClearClipboardAsync();
        MudDialog.Close(DialogResult.Ok(_result is { SucceededCount: > 0 }));
    }

    /// <summary>
    /// Best effort, and deliberately not reported. It can fail for reasons that are nobody's fault (the browser
    /// requires transient user activation to write to the clipboard), and it cannot touch the operating
    /// system's clipboard history either way, so a failure notice would be alarming without being actionable.
    /// The dialog says plainly that the history may retain the value instead.
    /// </summary>
    private async Task ClearClipboardAsync()
    {
        CancelRevealTimeout();
        await TryInvokeAsync<bool>("jimInterop.clearClipboard");
    }

    private async Task<T?> TryInvokeAsync<T>(string identifier, params object?[] args)
    {
        try
        {
            return await JsRuntime.InvokeAsync<T>(identifier, args);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or InvalidOperationException)
        {
            return default;
        }
    }

    /// <summary>
    /// Cancels the reveal timer so a dialog that is torn down while a password is on screen does not leave a
    /// delay running against a disposed component.
    /// </summary>
    public void Dispose()
    {
        CancelRevealTimeout();
    }

    private void CancelRevealTimeout()
    {
        _revealTimeout?.Cancel();
        _revealTimeout?.Dispose();
        _revealTimeout = null;
    }

    private static string DescribeExpiryBehaviour(PasswordExpiryBehaviour behaviour) => behaviour switch
    {
        PasswordExpiryBehaviour.RequireChangeAtNextSignIn => "Require a change at the next sign-in",
        PasswordExpiryBehaviour.ExpiresAccordingToTargetPolicy => "Age according to the Connected System's own policy",
        PasswordExpiryBehaviour.NeverExpires => "Never expires",
        _ => behaviour.ToString()
    };
}
