@* ─── Nothing retrieved yet: the only thing to say is how to start ─── *@
@if (ConnectedSystem.Partitions == null || ConnectedSystem.Partitions.Count == 0)
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        <MudText>Retrieve the @PartitionAndHierarchyText hierarchy from the Connected System, to be able to select which ones you want to manage with JIM.</MudText>
        <MudButton Disabled="@_hierarchyBeingRetrieved" Color="Color.Primary" OnClick="HandleImportHierarchyAsync"
                   Variant="Variant.Filled" Class="mt-5" DropShadow="false">
            @if (_hierarchyBeingRetrieved)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">Retrieving Hierarchy</span>
            }
            else
            {
                <text>Retrieve Hierarchy</text>
            }
        </MudButton>
    </MudAlert>
}
else
{
    @* ─── What this system currently imports, before anything about how to change it ─── *@
    <div class="jim-scope-summary" data-testid="jim-scope-summary">
        <div class="jim-scope-stat">
            <span class="jim-scope-stat-value">@SelectedContainerCount of @TotalContainerCount</span>
            <span class="jim-scope-stat-label">Containers selected</span>
        </div>
        <div class="jim-scope-stat">
            <span class="jim-scope-stat-value">@SelectedPartitionCount of @ConnectedSystem.Partitions.Count</span>
            <span class="jim-scope-stat-label">@(ConnectedSystem.Partitions.Count == 1 ? "Partition" : "Partitions") managed</span>
        </div>
        @* Only where there are any: a permanent "0 excluded" would sit on every Connected System that has never
           carved anything out, which is most of them, saying nothing. Where there are exclusions the selected count
           alone overstates what is imported, so the figure has to appear beside it. *@
        @if (ExcludedContainerCount > 0)
        {
            <div class="jim-scope-stat" data-testid="jim-scope-excluded">
                <span class="jim-scope-stat-value">@ExcludedContainerCount</span>
                <span class="jim-scope-stat-label">@(ExcludedContainerCount == 1 ? "Container" : "Containers") excluded</span>
            </div>
        }
    </div>

    @* ─── Guidance, demoted: the timestamp is the useful part, the caveat is read once ─── *@
    <div class="jim-scope-hint" data-testid="jim-scope-hint">
        <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" />
        <span>
            @if (_hierarchyRetrievedAt.HasValue)
            {
                var retrievedAt = _hierarchyRetrievedAt.Value;
                <text>Hierarchy retrieved @retrievedAt.ToLocalTime().ToFriendlyDate()</text>
            }
            else
            {
                <text>Hierarchy retrieved from the Connected System</text>
            }
        </span>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@_hierarchyBeingRetrieved"
                   OnClick="HandleImportHierarchyAsync" DropShadow="false">
            @if (_hierarchyBeingRetrieved)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <span class="ms-2">Refreshing</span>
            }
            else
            {
                <text>Refresh</text>
            }
        </MudButton>
        <MudButton Variant="Variant.Text" Size="Size.Small" DropShadow="false"
                   OnClick="@(() => _refreshCaveatShown = !_refreshCaveatShown)"
                   data-testid="jim-scope-hint-disclose">
            What refreshing does to my selections
        </MudButton>
    </div>

    @if (_refreshCaveatShown)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-2"
                  data-testid="jim-scope-hint-caveat">
            <MudText Typo="Typo.body2">
                <strong>Refreshing preserves your selections</strong> where possible. Existing partitions and Containers are matched
                by their external ID, so renamed or moved items keep their selection state. Partitions and Containers that no longer
                exist in the Connected System (deleted OUs, permission changes) are removed. Make sure the Connected System identity
                has the permissions needed to retrieve the hierarchy.
            </MudText>
        </MudAlert>
    }
}

@* Hierarchy Refresh Results Panel *@
@if (_hierarchyRefreshResult != null && _hierarchyRefreshResult.HasChanges)
{
    <MudExpansionPanels Class="mt-4" Elevation="0">
        <MudExpansionPanel Expanded="false">
            <TitleContent>
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Sync" />
                    <MudText Typo="Typo.body1">
                        Hierarchy refreshed: @_hierarchyRefreshResult.GetSummary()
                    </MudText>
                    @if (_hierarchyRefreshResult.HasSelectedItemsRemoved)
                    {
                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">
                            Selected items removed
                        </MudChip>
                    }
                </div>
            </TitleContent>
            <ChildContent>
                <div class="pa-4">
                    <div class="d-flex justify-end mb-3">
                        <MudButton StartIcon="@Icons.Material.Filled.ContentCopy"
                                   Variant="Variant.Outlined"

                                   OnClick="CopyHierarchyChangesToClipboardAsync">
                            Copy Changes
                        </MudButton>
                    </div>

                    @* Removed Items (show first if any were selected - important warning) *@
                    @if (_hierarchyRefreshResult.RemovedPartitions.Count > 0 || _hierarchyRefreshResult.RemovedContainers.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-1" Color="Color.Error" />
                            Removed
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-4" Style="background: transparent;">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Name</th>
                                    <th>External ID</th>
                                    <th>Was Selected</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _hierarchyRefreshResult.RemovedPartitions)
                                {
                                    <tr class="@(item.WasSelected ? "mud-error-text" : "")">
                                        <td>Partition</td>
                                        <td>@item.Name</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                        <td>
                                            @if (item.WasSelected)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Class="mr-1" />
                                                <text>Yes</text>
                                            }
                                            else
                                            {
                                                <text>No</text>
                                            }
                                        </td>
                                    </tr>
                                }
                                @foreach (var item in _hierarchyRefreshResult.RemovedContainers)
                                {
                                    <tr class="@(item.WasSelected ? "mud-error-text" : "")">
                                        <td>Container</td>
                                        <td>@item.Name</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                        <td>
                                            @if (item.WasSelected)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Class="mr-1" />
                                                <text>Yes</text>
                                            }
                                            else
                                            {
                                                <text>No</text>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    @* Added Items *@
                    @if (_hierarchyRefreshResult.AddedPartitions.Count > 0 || _hierarchyRefreshResult.AddedContainers.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-1" Color="Color.Success" />
                            Added
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-4" Style="background: transparent;">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Name</th>
                                    <th>External ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _hierarchyRefreshResult.AddedPartitions)
                                {
                                    <tr>
                                        <td>Partition</td>
                                        <td>@item.Name</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                    </tr>
                                }
                                @foreach (var item in _hierarchyRefreshResult.AddedContainers)
                                {
                                    <tr>
                                        <td>Container</td>
                                        <td>@item.Name</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    @* Renamed Items *@
                    @if (_hierarchyRefreshResult.RenamedPartitions.Count > 0 || _hierarchyRefreshResult.RenamedContainers.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-1" Color="Color.Info" />
                            Renamed
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-4" Style="background: transparent;">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Old Name</th>
                                    <th>New Name</th>
                                    <th>External ID</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _hierarchyRefreshResult.RenamedPartitions)
                                {
                                    <tr>
                                        <td>Partition</td>
                                        <td>@item.OldName</td>
                                        <td>@item.NewName</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                    </tr>
                                }
                                @foreach (var item in _hierarchyRefreshResult.RenamedContainers)
                                {
                                    <tr>
                                        <td>Container</td>
                                        <td>@item.OldName</td>
                                        <td>@item.NewName</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    @* Moved Containers *@
                    @if (_hierarchyRefreshResult.MovedContainers.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" Class="mr-1" Color="Color.Info" />
                            Moved
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-4" Style="background: transparent;">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Old Parent</th>
                                    <th>New Parent</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _hierarchyRefreshResult.MovedContainers)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@(item.OldParentExternalId ?? "(root)")</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@(item.NewParentExternalId ?? "(root)")</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </div>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@if (ConnectedSystem.Partitions is { Count: > 0 } && !ConnectedSystem.HasPartitionsOrContainersSelected())
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-5">
        <MudText>
            <strong>No partitions or containers have been selected.</strong> You must select at least one partition
            @if (ConnectedSystem.ConnectorDefinition.SupportsPartitionContainers)
            {
                <text> and at least one container within that partition</text>
            }
            before you can configure Object Matching Rules or create Run Profiles.
        </MudText>
    </MudAlert>
}

@* ─── Simple or Advanced: the same scope, edited as a tree or as text ─── *@
@if (ConnectedSystem.Partitions is { Count: > 0 } && ConnectedSystem.ConnectorDefinition.SupportsPartitionContainers)
{
    <div class="jim-scope-mode mt-6">
        <MudToggleGroup T="bool" Value="@_advancedMode" ValueChanged="SetAdvancedMode" Outlined="true"
                        Delimiters="true" Color="Color.Primary" CheckMark="true" FixedContent="true"
                        data-testid="jim-scope-mode">
            <MudToggleItem Value="false" Text="Simple" />
            <MudToggleItem Value="true" Text="Advanced" />
        </MudToggleGroup>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @(_advancedMode
                ? "One statement per line, in hierarchy order. This states the whole of Container Scope: a Container it does not name is not managed."
                : "Tick the Containers to manage. Advanced states the same scope as text, for a hierarchy too large to click through.")
        </MudText>
    </div>
}

@if (_advancedMode)
{
    <MudPaper Class="pa-4 mt-6" Outlined="true">
        <MudTextField T="string" @bind-Value="_advancedText" Immediate="true" Variant="Variant.Outlined"
                      Lines="10" Label="Container Scope" spellcheck="false"
                      Class="jim-scope-text" data-testid="jim-scope-text"
                      HelperText="include (or +) or exclude (or -), an optional one-level, then the Container's path. Blank lines and lines beginning with # are ignored." />

        @if (_advancedErrors.Count > 0)
        {
            @* Every problem at once, each tied to its line: an administrator correcting a scope of any size one
               round trip at a time is how a half-corrected text gets saved. *@
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4" data-testid="jim-scope-text-errors">
                <MudText Class="mb-2"><strong>This Container Scope was not applied.</strong> Nothing has been changed.</MudText>
                <ul class="jim-scope-text-error-list">
                    @foreach (var error in _advancedErrors)
                    {
                        <li>Line @error.LineNumber: @error.Message</li>
                    }
                </ul>
            </MudAlert>
        }

        <div class="d-flex align-center gap-4 mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       OnClick="ApplyAdvancedTextWithFeedback" data-testid="jim-scope-text-apply">
                Apply
            </MudButton>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Applying edits the selection; nothing reaches the Connected System until you save.
            </MudText>
        </div>
    </MudPaper>
}

@if (ConnectedSystem.Partitions is { Count: > 0 })
{
    @foreach (var partition in VisiblePartitions)
    {
        <MudPaper Class="mt-6" Outlined="true">
            <div class="jim-scope-partition-head">
                <span class="jim-scope-partition-name">@partition.Name</span>
                <MudSwitch T="bool" Value="@partition.Selected" ValueChanged="@(v => PartitionSelectedChanged(partition, v))"
                           Color="Color.Primary" Label="Manage this partition" Class="ms-auto" />
            </div>

            @if (partition.Selected && ConnectedSystem.ConnectorDefinition.SupportsPartitionContainers)
            {
                <div class="pa-4 pt-0">
                    @if (partition.Containers != null)
                    {
                        <ScopedHierarchyPicker Partition="@partition" OnChanged="OnSelectionEdited" />
                    }
                </div>
            }
        </MudPaper>
    }

    @* ─── Committing: what is pending, what it would do, and only then the button ─── *@
    <div class="jim-scope-actions mt-6">
        @if (_selectionEdited)
        {
            <span class="jim-scope-pending" data-testid="jim-scope-pending">
                <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" />
                Unsaved changes to what this Connected System imports
            </span>
        }
        else
        {
            <span class="jim-scope-pending jim-scope-pending-clean" data-testid="jim-scope-saved">
                No unsaved changes
            </span>
        }

        @* Preview (#1251): deselecting a container takes everything beneath it out of import scope, which obsoletes *@
        @* those objects, disconnects whatever they were joined to, and can leave Metaverse Objects with no          *@
        @* connectors at all. This is the count an administrator needs before saving, not afterwards.                *@
        <MudButton data-testid="jim-preview-scope-selection" Variant="Variant.Outlined" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Visibility" OnClick="PreviewScopeSelectionAsync"
                   Disabled="@_startingPreview" DropShadow="false">
            Preview Changes
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="HandleHierarchySelectionSubmitAsync"
                   DropShadow="false" data-testid="jim-scope-save">
            Save Changes
        </MudButton>
    </div>

    @if (_previewActivityId.HasValue)
    {
        var previewActivityId = _previewActivityId.Value;

        @if (ScopeSelectionPreviewIsStale)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-6"
                      data-testid="jim-preview-stale">
                The selection has been edited since this preview ran, so it no longer describes what saving would do.
                Preview again for an answer about the current selection.
            </MudAlert>
        }

        <ConfigurationChangePreviewPanel ActivityId="@previewActivityId"
                                         Title="Preview: Partitions and Containers"
                                         OnPreviewChanged="OnScopeSelectionPreviewChanged"
                                         OnClose="DiscardScopeSelectionPreview"
                                         Class="mt-6" />
    }
}

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [Parameter]
    public string? PartitionsAndHierarchiesText { get; set; }

    [Parameter]
    public string? PartitionAndHierarchyText { get; set; }

    [Parameter]
    public EventCallback OnConnectedSystemChanged { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _hierarchyBeingRetrieved;
    private HierarchyRefreshResult? _hierarchyRefreshResult;
    private bool _refreshCaveatShown;
    private bool _selectionEdited;
    private DateTime? _hierarchyRetrievedAt;

    /// <summary>How many Containers across every partition are selected, for the summary above the tree.</summary>
    private int SelectedContainerCount =>
        (ConnectedSystem.Partitions ?? []).Sum(ContainerSelectionEditor.CountSelected);

    /// <summary>How many Containers are carved out of a selection, across every partition.</summary>
    private int ExcludedContainerCount =>
        (ConnectedSystem.Partitions ?? []).Sum(ContainerSelectionEditor.CountExcluded);

    private int TotalContainerCount =>
        (ConnectedSystem.Partitions ?? []).Sum(ContainerSelectionEditor.CountAll);

    private int SelectedPartitionCount => (ConnectedSystem.Partitions ?? []).Count(p => p.Selected);

    // ─── Configuration Change Preview (#1251) ───
    private Guid? _previewActivityId;
    private ConfigurationChangePreview? _preview;
    private ConnectedSystemScopeSelectionProposal? _previewedProposal;
    private bool _startingPreview;

    protected override void OnParametersSet()
    {
        ApplyContainerIncludedToPartitions(ConnectedSystem);
    }

    /// <summary>
    /// Records that the administrator has edited the selection, so the action bar can say there is something to save
    /// and the preview can report itself stale.
    /// </summary>
    private void OnSelectionEdited() => _selectionEdited = true;

    // ─── Advanced Mode (#1255): the same scope, stated as text ───

    private bool _advancedMode;
    private string _advancedText = string.Empty;
    private IReadOnlyList<ContainerScopeTextError> _advancedErrors = [];

    /// <summary>
    /// The partitions the tree renders. Empty in Advanced Mode, where the text is the editor.
    /// </summary>
    private IEnumerable<ConnectedSystemPartition> VisiblePartitions =>
        _advancedMode ? [] : ConnectedSystem.Partitions ?? [];

    /// <summary>
    /// Switches between editing the scope as a tree and editing it as text.
    /// </summary>
    /// <remarks>
    /// Leaving Advanced Mode applies the text rather than discarding it, because the text is the pending edit and
    /// dropping it on a click of "Simple" would lose work with nothing said. Where it cannot be applied the switch
    /// does not happen and the errors stand; the two modes express exactly the same scopes, so there is nothing an
    /// administrator can write here that the tree cannot then show them.
    /// </remarks>
    private void SetAdvancedMode(bool advanced)
    {
        if (advanced == _advancedMode)
            return;

        if (advanced)
        {
            _advancedText = ContainerScopeText.Project(ConnectedSystem.Partitions ?? []);
            _advancedErrors = [];
            _advancedMode = true;
            return;
        }

        if (ApplyAdvancedText())
            _advancedMode = false;
    }

    private void ApplyAdvancedTextWithFeedback()
    {
        if (ApplyAdvancedText())
            Snackbar.Add("Container Scope applied. Save your changes to send them to the Connected System.", Severity.Success);
    }

    /// <summary>
    /// Resolves the authored text against the hierarchy and applies it to the in-memory selection, exactly as
    /// ticking boxes in the tree does. Nothing is persisted here: the Save Changes button below owns that, so
    /// Advanced Mode inherits the confirmation, the preview link and the audit rather than having its own.
    /// </summary>
    private bool ApplyAdvancedText()
    {
        var partitions = ConnectedSystem.Partitions ?? [];
        var before = ContainerScopeText.Project(partitions);

        _advancedErrors = ContainerScopeText.Apply(_advancedText, partitions);
        if (_advancedErrors.Count > 0)
            return false;

        // Hand back what was actually applied, so the administrator sees the canonical form of what they wrote
        // rather than being left to wonder whether their shorthand was understood.
        _advancedText = ContainerScopeText.Project(partitions);

        if (_advancedText != before)
            OnSelectionEdited();

        return true;
    }

    /// <summary>
    /// Deselecting a partition takes every Container within it out of scope too, so its selections are cleared
    /// rather than left set behind an unmanaged partition, where they would say one thing and do another.
    /// </summary>
    private void PartitionSelectedChanged(ConnectedSystemPartition partition, bool selected)
    {
        partition.Selected = selected;

        if (!selected)
            ContainerSelectionEditor.ClearSelection(partition);

        OnSelectionEdited();
    }

    private async Task HandleImportHierarchyAsync()
    {
        // attribute the import to the user
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        _hierarchyBeingRetrieved = true;
        _hierarchyRefreshResult = null; // Clear previous result
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            _hierarchyRefreshResult = await jim.ConnectedSystems.ImportConnectedSystemHierarchyAsync(ConnectedSystem, user);

            if (_hierarchyRefreshResult.Success)
            {
                _hierarchyRetrievedAt = DateTime.UtcNow;

                if (_hierarchyRefreshResult.HasSelectedItemsRemoved)
                {
                    Snackbar.Add("Hierarchy refreshed with warnings. Some selected items were removed.", Severity.Warning);
                }
                else if (_hierarchyRefreshResult.HasChanges)
                {
                    Snackbar.Add($"Hierarchy refreshed: {_hierarchyRefreshResult.GetSummary()}", Severity.Success);
                }
                else
                {
                    Snackbar.Add("Hierarchy refreshed. No changes detected.", Severity.Info);
                }
            }
            else
            {
                Snackbar.Add($"Hierarchy refresh failed: {_hierarchyRefreshResult.ErrorMessage}", Severity.Error);
            }

            await OnConnectedSystemChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to import hierarchy for Connected System {ConnectedSystemId}", ConnectedSystem.Id);
            Snackbar.Add($"Failed to retrieve hierarchy: {ex.Message}", Severity.Error);
        }
        finally
        {
            _hierarchyBeingRetrieved = false;
            StateHasChanged();
        }
    }

    private async Task CopyHierarchyChangesToClipboardAsync()
    {
        if (_hierarchyRefreshResult == null)
            return;

        var sb = new StringBuilder();
        sb.AppendLine("Hierarchy Refresh Results");
        sb.AppendLine(new string('=', 50));
        sb.AppendLine($"Summary: {_hierarchyRefreshResult.GetSummary()}");
        sb.AppendLine($"Total Partitions: {_hierarchyRefreshResult.TotalPartitions}");
        sb.AppendLine($"Total Containers: {_hierarchyRefreshResult.TotalContainers}");
        sb.AppendLine();

        if (_hierarchyRefreshResult.RemovedPartitions.Count > 0 || _hierarchyRefreshResult.RemovedContainers.Count > 0)
        {
            sb.AppendLine("REMOVED:");
            foreach (var item in _hierarchyRefreshResult.RemovedPartitions)
                sb.AppendLine($"  [Partition] {item.Name} ({item.ExternalId}){(item.WasSelected ? " - WAS SELECTED!" : "")}");
            foreach (var item in _hierarchyRefreshResult.RemovedContainers)
                sb.AppendLine($"  [Container] {item.Name} ({item.ExternalId}){(item.WasSelected ? " - WAS SELECTED!" : "")}");
            sb.AppendLine();
        }

        if (_hierarchyRefreshResult.AddedPartitions.Count > 0 || _hierarchyRefreshResult.AddedContainers.Count > 0)
        {
            sb.AppendLine("ADDED:");
            foreach (var item in _hierarchyRefreshResult.AddedPartitions)
                sb.AppendLine($"  [Partition] {item.Name} ({item.ExternalId})");
            foreach (var item in _hierarchyRefreshResult.AddedContainers)
                sb.AppendLine($"  [Container] {item.Name} ({item.ExternalId})");
            sb.AppendLine();
        }

        if (_hierarchyRefreshResult.RenamedPartitions.Count > 0 || _hierarchyRefreshResult.RenamedContainers.Count > 0)
        {
            sb.AppendLine("RENAMED:");
            foreach (var item in _hierarchyRefreshResult.RenamedPartitions)
                sb.AppendLine($"  [Partition] \"{item.OldName}\" -> \"{item.NewName}\" ({item.ExternalId})");
            foreach (var item in _hierarchyRefreshResult.RenamedContainers)
                sb.AppendLine($"  [Container] \"{item.OldName}\" -> \"{item.NewName}\" ({item.ExternalId})");
            sb.AppendLine();
        }

        if (_hierarchyRefreshResult.MovedContainers.Count > 0)
        {
            sb.AppendLine("MOVED:");
            foreach (var item in _hierarchyRefreshResult.MovedContainers)
                sb.AppendLine($"  [Container] {item.Name}: {item.OldParentExternalId ?? "(root)"} -> {item.NewParentExternalId ?? "(root)"}");
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
            Snackbar.Add("Changes copied to clipboard", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Failed to copy to clipboard. Please copy manually.", Severity.Warning);
        }
    }

    private async Task HandleHierarchySelectionSubmitAsync()
    {
        // attribute the action to the user
        using var jim = JimFactory.Create();

        // deselecting a partition takes everything imported from it out of scope, which obsoletes those objects and
        // deprovisions whatever they are joined to. The acknowledgement says so, and where a preview was run it
        // says how many objects that is (#1251).
        var preflight = await jim.ConfigurationChangePreflight.EvaluateConnectedSystemAsync(ConnectedSystem);
        if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                "Connected System", ConnectedSystem.Name,
                ConfigurationChangePreviewCounts.ForConfirmation(_preview, ScopeSelectionPreviewIsStale),
                ConfigurationChangePreviewCounts.ForConfirmationVerdict(_preview, ScopeSelectionPreviewIsStale)))
            return;

        // The preview is linked only when it actually describes this change. A link to a preview run against a
        // different selection would make the audit assert something untrue about what the administrator read.
        var previewActivityId = ScopeSelectionPreviewIsStale ? null : _previewActivityId;

        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.ConnectedSystems.UpdateConnectedSystemAsync(ConnectedSystem, user, previewActivityId: previewActivityId);
        DiscardScopeSelectionPreview();
        _selectionEdited = false;
        Snackbar.Add("Your hierarchy changes have been saved.", Severity.Success);
        await OnConnectedSystemChanged.InvokeAsync();
    }

    // ─── Configuration Change Preview (#1251) ───

    /// <summary>
    /// The selection currently ticked in the tree, as the preview framework's proposal type.
    /// </summary>
    /// <remarks>
    /// Read from the loaded Connected System because the tree edits its <c>Selected</c> flags in place, so the
    /// in-memory graph *is* what the administrator is about to save. The adapter loads its own copy from the
    /// database for the "before" side, which is why handing it this graph directly would have it compare the
    /// proposal against itself.
    /// </remarks>
    private ConnectedSystemScopeSelectionProposal BuildScopeSelectionProposal() =>
        ConnectedSystemScopeSelectionProposal.FromCurrentSelection(ConnectedSystem);

    /// <summary>
    /// Whether the tree has moved on from the selection the visible preview was run against.
    /// </summary>
    private bool ScopeSelectionPreviewIsStale =>
        _previewedProposal is not null && !BuildScopeSelectionProposal().DescribesSameSelectionAs(_previewedProposal);

    private async Task PreviewScopeSelectionAsync()
    {
        if (_startingPreview)
            return;

        _startingPreview = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var proposal = BuildScopeSelectionProposal();

            // The starter, not StartAndDispatchPreviewAsync: it owns the question of whether a large preview keeps
            // every drill-down row, and that decision belongs in one place rather than at each surface.
            var activityId = await PreviewStarter.StartAsync(new ConfigurationChangePreviewRequest
            {
                Surface = ConfigurationChangePreviewSurface.ConnectedSystem,
                TargetId = ConnectedSystem.Id,
                TargetName = ConnectedSystem.Name,
                ProposedConfiguration = proposal,
                InitiatedByType = ActivityInitiatorType.User,
                InitiatedById = user?.Id,
                InitiatedByName = user?.Name
            });

            // Null means the administrator declined the data-set size question, which is a decision not to preview.
            if (activityId == null)
                return;

            _previewActivityId = activityId;
            _previewedProposal = proposal;
            _preview = null;
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            DiscardScopeSelectionPreview();
            Log.Error(ex, "Failed to start a partition and container selection preview for Connected System {ConnectedSystemId}", ConnectedSystem.Id);
            Snackbar.Add($"Failed to start the preview: {ex.Message}", Severity.Error);
        }
        finally
        {
            _startingPreview = false;
        }
    }

    /// <summary>
    /// Records the panel's latest read of the preview, for the save confirmation to state.
    /// </summary>
    /// <remarks>
    /// Deliberately does not call <c>StateHasChanged</c>, for the reason recorded on the pilot surface: the panel
    /// re-reads on every parameter set, so re-rendering here would set its parameters again, refresh again, and
    /// raise this again, cancelling and restarting its reconciliation poll on every pass so the panel never leaves
    /// stage 1. Nothing rendered here depends on this value, so storing it is enough.
    /// </remarks>
    private void OnScopeSelectionPreviewChanged(ConfigurationChangePreview? preview) => _preview = preview;

    private void DiscardScopeSelectionPreview()
    {
        _previewActivityId = null;
        _previewedProposal = null;
        _preview = null;
    }

    private static void ApplyContainerIncludedToPartitions(ConnectedSystem connectedSystemInQuestion)
    {
        if (connectedSystemInQuestion.Partitions == null)
            return;

        // The coverage rule lives with the one the import applies, so the tree cannot show one scope while the
        // import performs another.
        foreach (var partition in connectedSystemInQuestion.Partitions)
            ConnectedSystemUtilities.ApplyContainerInclusion(partition);
    }

}
