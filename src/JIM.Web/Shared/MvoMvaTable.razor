@* Inline, searchable, virtualised table of a single Metaverse Object attribute's values. Used directly
   in the details table's value cell for multi-valued attributes whose value count exceeds the inline cap,
   so all values are browsable in place without a dialog. The scrolling, the search box, the count and the
   density all belong to the shared grid; this component only says how a value renders and how a window of
   values is read. *@

<div class="jim-mva-dialog-table">
@if (_isReferenceAttribute)
{
    <VirtualisedDataGrid T="MetaverseObjectAttributeValue"
                         ContainerId="@($"mvo-mva-{_slug}-references")"
                         UrlParameterPrefix="@($"{_slug}-")"
                         StateKey="@AttributeName"
                         DefaultSortBy="@SourceOrderSort"
                         LoadWindow="LoadValueWindowAsync"
                         SearchPlaceholder="@($"Search {AttributeName.ToLower()}...")"
                         SingularName="Value"
                         PluralName="Values">
        <Columns>
            <TemplateColumn Title="Display Name" Sortable="false">
                <HeaderTemplate>
                    <MudText Typo="Typo.button">Display Name</MudText>
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.ReferenceValue != null)
                    {
                        var reference = context.Item.ReferenceValue;
                        <MudLink Href="@Utilities.GetMetaverseObjectHref(reference)">
                            @(reference.NameOrId ?? reference.Id.ToString())
                        </MudLink>
                    }
                    else
                    {
                        <TextValueDisplay Value="@GetDisplayValue(context.Item)" />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Type" Sortable="false">
                <HeaderTemplate>
                    <MudText Typo="Typo.button">Type</MudText>
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.ReferenceValue != null)
                    {
                        var reference = context.Item.ReferenceValue;
                        @reference.Type?.Name
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <EmptyContent Context="grid">
            @RenderEmptyState(grid)
        </EmptyContent>
    </VirtualisedDataGrid>
}
else
{
    <VirtualisedDataGrid T="MetaverseObjectAttributeValue"
                         ContainerId="@($"mvo-mva-{_slug}-values")"
                         UrlParameterPrefix="@($"{_slug}-")"
                         StateKey="@AttributeName"
                         DefaultSortBy="@SourceOrderSort"
                         LoadWindow="LoadValueWindowAsync"
                         SearchPlaceholder="@($"Search {AttributeName.ToLower()}...")"
                         SingularName="Value"
                         PluralName="Values">
        <Columns>
            <TemplateColumn Title="Value" Sortable="false">
                <HeaderTemplate>
                    <MudText Typo="Typo.button">Value</MudText>
                </HeaderTemplate>
                <CellTemplate>
                    <TextValueDisplay Value="@GetDisplayValue(context.Item)" />
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <EmptyContent Context="grid">
            @RenderEmptyState(grid)
        </EmptyContent>
    </VirtualisedDataGrid>
}
</div>

@* ─── Render Fragments ─── *@

@* A search that matched nothing is a different situation from an attribute that genuinely holds no values,
   and only the first has a way out to offer. *@
@{
    RenderFragment RenderEmptyState(VirtualisedDataGrid<MetaverseObjectAttributeValue> grid) => __builder =>
    {
        if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No values match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.List"
                             PrimaryText="This attribute has no values"
                             SecondaryText="Values arrive here from a Connected System through an Inbound Synchronisation Rule." />
        }
    };
}

@code {
    /// <summary>
    /// The name of the attribute whose values are being listed.
    /// </summary>
    [Parameter]
    public string AttributeName { get; set; } = string.Empty;

    /// <summary>
    /// The owning Metaverse Object's ID.
    /// </summary>
    [Parameter]
    public Guid MetaverseObjectId { get; set; }

    /// <summary>
    /// Whether this attribute holds reference values (drives the multi-column reference layout).
    /// </summary>
    [Parameter]
    public bool IsReferenceAttribute { get; set; }

    /// <summary>
    /// Whether the host page's tables are showing compact rows. Retained for the host's binding: the grid reads
    /// the same saved density preference the host's toggle writes, so it no longer needs threading through.
    /// </summary>
    [Parameter]
    public bool Dense { get; set; }

    /// <summary>
    /// The sort key standing for "the order the application layer returned them in". Attribute values are read a
    /// page at a time with no sort parameter, so no column offers a sort; naming the default something no header
    /// claims keeps the grid from showing a sort arrow over an order it did not choose.
    /// </summary>
    private const string SourceOrderSort = "order";

    /// <summary>
    /// The page size windows are stitched from. It matches the largest page the application layer will serve
    /// (larger requests are clamped there), so a window never silently comes back from a different offset.
    /// </summary>
    private const int SourcePageSize = 100;

    private bool _isReferenceAttribute;

    /// <summary>
    /// The attribute name reduced to a URL- and element-id-safe token. Several of these tables render on one
    /// page, one per capped multi-valued attribute, so the grid's element id and URL parameters have to carry
    /// which attribute they belong to.
    /// </summary>
    private string _slug = string.Empty;

    protected override void OnParametersSet()
    {
        _isReferenceAttribute = IsReferenceAttribute;
        _slug = Slugify(AttributeName);
    }

    /// <summary>
    /// Reads one window of this attribute's values. The application layer serves attribute values a page at a
    /// time, so a window is stitched from the pages spanning it rather than read at an arbitrary offset; the
    /// values are ordered by their own id, so the pages join without gaps or repeats.
    /// </summary>
    private async Task<VirtualisedWindow<MetaverseObjectAttributeValue>> LoadValueWindowAsync(
        VirtualisedWindowRequest request, CancellationToken _)
    {
        var items = new List<MetaverseObjectAttributeValue>(request.Count);
        var firstPage = request.StartIndex / SourcePageSize;
        var skipInFirstPage = request.StartIndex % SourcePageSize;
        var totalValues = 0;

        using var jim = JimFactory.Create();
        for (var page = firstPage; items.Count < request.Count; page++)
        {
            var result = await jim.Metaverse.GetAttributeValuesPagedAsync(
                MetaverseObjectId, AttributeName, page + 1, SourcePageSize, request.SearchText);
            totalValues = result.TotalResults;

            IEnumerable<MetaverseObjectAttributeValue> values = result.Results;
            if (page == firstPage)
                values = values.Skip(skipInFirstPage);

            items.AddRange(values.Take(request.Count - items.Count));

            // A short page is the last one; asking for the next would only cost a round trip to learn that.
            if (result.Results.Count < SourcePageSize)
                break;
        }

        return new VirtualisedWindow<MetaverseObjectAttributeValue>(
            items, request.IncludeTotalCount ? totalValues : null);
    }

    private static string Slugify(string name)
    {
        var slug = new string(name.Select(c => char.IsLetterOrDigit(c) ? char.ToLowerInvariant(c) : '-').ToArray());
        return string.IsNullOrEmpty(slug) ? "attribute" : slug;
    }

    private static string GetDisplayValue(MetaverseObjectAttributeValue value)
    {
        if (!string.IsNullOrEmpty(value.StringValue))
            return value.StringValue;
        if (value.DateTimeValue.HasValue)
            return value.DateTimeValue.Value.ToFriendlyDate();
        if (value.IntValue.HasValue)
            return value.IntValue.Value.ToString();
        if (value.LongValue.HasValue)
            return value.LongValue.Value.ToString();
        if (value.DecimalValue.HasValue)
            return value.DecimalValue.Value.ToString(CultureInfo.InvariantCulture);
        if (value.GuidValue.HasValue)
            return value.GuidValue.Value.ToString();
        if (value.BoolValue.HasValue)
            return value.BoolValue.Value ? "True" : "False";
        if (value.ByteValue != null)
            return $"{value.ByteValue.Length} bytes";
        return string.Empty;
    }
}
