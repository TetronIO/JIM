<MudSimpleTable Dense="true" Hover="true" Bordered="true" Elevation="0" Class="mt-2 jim-schema-change-table">
    <thead>
        <tr>
            <th>Change Type</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @if (ShowAdditions && Result.AddedObjectTypes.Count > 0)
        {
            <tr>
                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Success" Class="me-1" /><span>Object Types Added</span></div></td>
                <td class="jim-text-code">@string.Join(", ", Result.AddedObjectTypes)</td>
            </tr>
        }
        @if (ShowAdditions && Result.UpdatedObjectTypes.Count > 0)
        {
            <tr>
                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Update" Color="Color.Info" Class="me-1" /><span>Object Types Updated</span></div></td>
                <td class="jim-text-code">@string.Join(", ", Result.UpdatedObjectTypes)</td>
            </tr>
        }
        @if (ShowAdditions && Result.RenamedObjectTypes.Count > 0)
        {
            <tr>
                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.DriveFileRenameOutline" Color="Color.Info" Class="me-1" /><span>Object Types Renamed</span></div></td>
                <td class="jim-text-code">@string.Join(", ", Result.RenamedObjectTypes.Select(DescribeRename))</td>
            </tr>
        }
        @if (ShowAdditions && Result.ObjectTypesWithClassificationUpdates.Count > 0)
        {
            <tr>
                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Update" Color="Color.Info" Class="me-1" /><span>Object Type Classification Recorded</span></div></td>
                <td class="jim-text-code">@string.Join(", ", Result.ObjectTypesWithClassificationUpdates)</td>
            </tr>
        }
        @if (ShowAdditions)
        {
            @foreach (var kvp in Result.AddedAttributes)
            {
                <tr>
                    <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Success" Class="me-1" /><span>Attributes Added (@kvp.Key)</span></div></td>
                    <td class="jim-text-code">@string.Join(", ", kvp.Value)</td>
                </tr>
            }
            @foreach (var kvp in Result.RenamedAttributes)
            {
                <tr>
                    <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.DriveFileRenameOutline" Color="Color.Info" Class="me-1" /><span>Attributes Renamed (@kvp.Key)</span></div></td>
                    <td class="jim-text-code">@string.Join(", ", kvp.Value.Select(DescribeRename))</td>
                </tr>
            }
        }
        @if (ShowDestructive && Result.RemovedObjectTypes.Count > 0)
        {
            <tr>
                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Error" Class="me-1" /><span>Object Types No Longer Reported</span></div></td>
                <td class="jim-text-code">@string.Join(", ", Result.RemovedObjectTypes)</td>
            </tr>
        }
        @if (ShowDestructive)
        {
            @foreach (var kvp in Result.RemovedAttributes)
            {
                <tr>
                    <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Warning" Class="me-1" /><span>Attributes No Longer Reported (@kvp.Key)</span></div></td>
                    <td class="jim-text-code">@string.Join(", ", kvp.Value)</td>
                </tr>
            }
            @foreach (var kvp in Result.ChangedAttributes)
            {
                <tr>
                    <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Warning" Class="me-1" /><span>Attribute Definitions Changed (@kvp.Key)</span></div></td>
                    <td class="jim-text-code">@string.Join(", ", kvp.Value.Select(Describe))</td>
                </tr>
            }
        }
        @if (ShowReclassified)
        {
            @foreach (var kvp in Result.ChangedObjectTypeClassifications)
            {
                <tr>
                    <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Warning" Class="me-1" /><span>Object Type Classification Changed (@kvp.Key)</span></div></td>
                    <td class="jim-text-code">@string.Join("; ", kvp.Value.Select(DescribeClassification))</td>
                </tr>
            }
        }
    </tbody>
</MudSimpleTable>

@code {
    /// <summary>
    /// The schema refresh whose changes this table lists. Shared by the refresh preview panel and the applied
    /// refresh summary so the two can never describe the same refresh differently.
    /// </summary>
    [Parameter, EditorRequired]
    public SchemaRefreshResult Result { get; set; } = null!;

    /// <summary>
    /// Which changes to list: everything (the applied summary), the safe additions alone, the destructive changes
    /// alone (the refresh review renders the two as separate groups, #1485), or the Object Type classification
    /// changes alone (their own group, since they are neither safe nor destructive, #2049).
    /// </summary>
    [Parameter]
    public SchemaChangeSection Section { get; set; } = SchemaChangeSection.All;

    private bool ShowAdditions => Section is SchemaChangeSection.All or SchemaChangeSection.Additions;

    private bool ShowDestructive => Section is SchemaChangeSection.All or SchemaChangeSection.Destructive;

    private bool ShowReclassified => Section is SchemaChangeSection.All or SchemaChangeSection.Reclassified;

    private static string Describe(SchemaAttributeDefinitionChange change)
    {
        var aspect = change.Aspect == SchemaAttributeChangeAspect.DataType ? "data type" : "plurality";
        return $"{change.AttributeName}: {aspect} {change.OldValue} → {change.NewValue}";
    }

    private static string DescribeRename(SchemaNameChange rename) => $"{rename.OldName} → {rename.NewName}";

    private static string DescribeClassification(SchemaObjectTypeClassificationChange change)
    {
        var aspect = change.Aspect == SchemaObjectTypeClassificationAspect.ClassKind ? "class kind" : "inherited classes";
        return $"{aspect} {DescribeValues(change.OldValues)} → {DescribeValues(change.NewValues)}";
    }

    private static string DescribeValues(List<string> values) => values.Count == 0 ? "none" : string.Join(", ", values);

    /// <summary>
    /// The slice of a refresh's changes a <see cref="SchemaChangeTable"/> renders.
    /// </summary>
    public enum SchemaChangeSection
    {
        All = 0,
        Additions = 1,
        Destructive = 2,
        Reclassified = 3
    }
}
