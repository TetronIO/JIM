@* ─── Initial Password ─── *@
@* Headed rather than left to the tab to name it, because the tab is called Passwords: it says which password
   feature this is, and leaves room for the siblings that name invites. No expansion panel, though: these
   settings are the section's whole content, and a lid on a tab is a lid too many. *@
<MudPaper Class="pa-4" Outlined="true">
    <MudText Typo="Typo.h5" Class="mb-4">Initial Password</MudText>
                @if (!ConnectorCanSetPasswords)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        The @ConnectorLabel cannot set passwords, so JIM cannot give the accounts this
                        Synchronisation Rule provisions an initial password.
                    </MudAlert>
                }
                else
                {
                    @* ─── Accounts waiting on a change to these settings ───
                       Placed above the settings rather than below them: the reason names the setting to change,
                       so reading it is the first step and scrolling past the whole editor to find it is not. *@
                    @if (ParkedReasons is { Count: > 0 })
                    {
                        @* Captured into a local: a property pattern does not establish non-null null-state for
                           CodeQL any more than a HasValue guard does (JIM.Web/CLAUDE.md). *@
                        var parkedReasons = ParkedReasons;
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-5">
                            <MudText Typo="Typo.body1" Class="mb-1">
                                @(ParkedAccountCount == 1
                                    ? "1 account is waiting on a change to these settings"
                                    : $"{ParkedAccountCount:N0} accounts are waiting on a change to these settings")
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                                The Connected System refused the password these settings produced, so JIM has
                                stopped trying: the same settings produce another password it refuses for the same
                                reason. Correct them below and save, and the accounts are attempted again on the
                                next export run.
                            </MudText>
                            @foreach (var reason in parkedReasons)
                            {
                                <div class="d-flex mb-2">
                                    <MudText Typo="Typo.subtitle2" Class="me-3 flex-shrink-0"
                                             Style="min-width: 3rem; text-align: right;">@reason.AccountCount.ToString("N0")</MudText>
                                    <div>
                                        @* Verbatim, in monospace. A directory's rejection code is unreadable and is
                                           also the only thing precise enough to identify the fault, so it is shown
                                           exactly as the target sent it. *@
                                        <MudText Typo="Typo.body2" Style="font-family: var(--mud-typography-monospace-family, monospace);">
                                            @(string.IsNullOrWhiteSpace(reason.TargetMessage)
                                                ? "The target refused the password without saying why."
                                                : reason.TargetMessage)
                                        </MudText>
                                        @if (reason.FirstSeenAt.HasValue)
                                        {
                                            var firstSeen = reason.FirstSeenAt.Value;
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                First seen @firstSeen.ToLocalTime().ToRelativeTime()
                                            </MudText>
                                        }
                                    </div>
                                </div>
                            }
                        </MudAlert>
                    }

                    @* Shown only once an edit would actually change what gets delivered, decided by the same
                       comparison the save path uses, so the panel cannot promise a release that saving will not
                       perform. Renaming the rule leaves it hidden, correctly. *@
                    @if (WillReleaseParkedOnSave)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-5">
                            <MudText Typo="Typo.body1">
                                @(ParkedAccountCount == 1
                                    ? "Saving will release 1 parked account"
                                    : $"Saving will release {ParkedAccountCount:N0} parked accounts")
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                They will be attempted again with these settings on the next export run. Nothing is
                                generated now: each password is generated at the moment it is set.
                            </MudText>
                        </MudAlert>
                    }

                    <MudSwitch @bind-Value="@Configuration.Enabled" @bind-Value:after="NotifyChangedAsync" Color="Color.Primary"
                               Label="Set an initial password on accounts this Synchronisation Rule provisions?" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">A newly provisioned account has no
                        password and cannot be signed in to. Enabling this has JIM set one through the Connected System's
                        password channel, straight after the account is created. By default JIM generates a different
                        password for each account and stores none of them.</MudText>

                    @if (Configuration.Enabled)
                    {
                        <MudDivider Class="my-5" />

                        @* ─── Where the settings come from ─── *@
                        <MudText Typo="Typo.body1">Password Settings</MudText>
                        <MudRadioGroup T="InitialPasswordSource" @bind-Value="@Configuration.Source" @bind-Value:after="NotifyChangedAsync">
                            <div class="mt-1">
                                <MudRadio T="InitialPasswordSource" Value="InitialPasswordSource.Discovered" Color="Color.Primary">Follow the Connected System</MudRadio>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">The settings are derived from the
                                    password policy discovered on the Connected System, and re-derived whenever that policy
                                    is read again. Nothing to configure, and nothing to keep in step by hand.</MudText>
                            </div>
                            <div class="mt-2">
                                <MudRadio T="InitialPasswordSource" Value="InitialPasswordSource.Custom" Color="Color.Primary">Custom</MudRadio>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">Exactly the settings saved here.
                                    JIM will not change them because the Connected System published something different,
                                    but it will still tell you when they cannot satisfy it.</MudText>
                            </div>
                            <div class="mt-2">
                                <div class="d-flex align-center">
                                    <MudRadio T="InitialPasswordSource" Value="InitialPasswordSource.Static" Color="Color.Primary">One password for every account</MudRadio>
                                    @* On the option itself, not only inside it: the recommendation has to be readable
                                       while an administrator is choosing, not after they have chosen. *@
                                    <MudChip T="string" Class="ms-1" Color="Color.Warning" Variant="Variant.Text">Not recommended</MudChip>
                                </div>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">One password you choose, set on
                                    every account this Synchronisation Rule provisions, so you can tell a new starter what
                                    it is.</MudText>
                            </div>
                        </MudRadioGroup>

                        @if (Configuration.Source == InitialPasswordSource.Discovered && DiscoveredPolicy == null)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                                JIM has not discovered a password policy on this Connected System, either because the
                                Connector cannot read one or because the schema has not been imported since the
                                capability was added. JIM's own defaults apply until it does.
                            </MudAlert>
                        }

                        @if (Configuration.Source == InitialPasswordSource.Custom)
                        {
                            <MudDivider Class="my-5" />
                            @* ─── Generator settings ─── *@
                            <MudSelect T="PasswordGenerationStyle" Label="Style" @bind-Value="@Configuration.CustomPolicy.Style"
                                       @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                                <MudSelectItem Value="PasswordGenerationStyle.RandomCharacters">Random characters (t7Rm#qK4vHx2Ndbf)</MudSelectItem>
                                <MudSelectItem Value="PasswordGenerationStyle.Words">Words (Brown-Chicken-Ladder-47)</MudSelectItem>
                                <MudSelectItem Value="PasswordGenerationStyle.Pronounceable">Pronounceable (tovanic-hupelo-92)</MudSelectItem>
                            </MudSelect>

                            @if (Configuration.CustomPolicy.Style != PasswordGenerationStyle.Words)
                            {
                                <MudNumericField T="int" Label="Length" @bind-Value="@Configuration.CustomPolicy.Length"
                                                 @bind-Value:after="NotifyChangedAsync" Min="1" Max="256" Immediate="true"
                                                 Variant="Variant.Outlined" Class="mt-4" />
                            }

                            @if (Configuration.CustomPolicy.Style == PasswordGenerationStyle.RandomCharacters)
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="Minimum uppercase" @bind-Value="@Configuration.CustomPolicy.MinimumUppercase"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="Minimum lowercase" @bind-Value="@Configuration.CustomPolicy.MinimumLowercase"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="Minimum digits" @bind-Value="@Configuration.CustomPolicy.MinimumDigits"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="Minimum symbols" @bind-Value="@Configuration.CustomPolicy.MinimumSymbols"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                </MudGrid>
                            }

                            @if (Configuration.CustomPolicy.Style == PasswordGenerationStyle.Words)
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="4">
                                        <MudNumericField T="int" Label="Number of words" @bind-Value="@Configuration.CustomPolicy.WordCount"
                                                         @bind-Value:after="NotifyChangedAsync" Min="1" Max="16" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudSelect T="PasswordWordSeparator" Label="Separator" @bind-Value="@Configuration.CustomPolicy.WordSeparator"
                                                   @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                                            <MudSelectItem Value="PasswordWordSeparator.None">None</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.Hyphen">Hyphen</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.FullStop">Full stop</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.Underscore">Underscore</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.Digit">Digit</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.RandomSymbol">Random symbol</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudSelect T="PasswordWordCapitalisation" Label="Capitalisation" @bind-Value="@Configuration.CustomPolicy.WordCapitalisation"
                                                   @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                                            <MudSelectItem Value="PasswordWordCapitalisation.Lowercase">Lowercase</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.EachWord">Each word</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.Uppercase">Uppercase</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.FirstWordOnly">First word only</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.RandomWord">One random word</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            }

                            @if (Configuration.CustomPolicy.Style != PasswordGenerationStyle.RandomCharacters)
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="4">
                                        <MudNumericField T="int" Label="Appended digits" @bind-Value="@Configuration.CustomPolicy.AppendedDigitCount"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="16" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="8" Class="d-flex align-center">
                                        <MudSwitch @bind-Value="@Configuration.CustomPolicy.AppendSymbol" @bind-Value:after="NotifyChangedAsync"
                                                   Color="Color.Primary" Label="Append a symbol" />
                                    </MudItem>
                                </MudGrid>
                            }

                            <MudTextField T="string" Label="Permitted symbols" @bind-Value="@Configuration.CustomPolicy.PermittedSymbols"
                                          @bind-Value:after="NotifyChangedAsync" Immediate="true" Variant="Variant.Outlined" Class="mt-4" />
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">The symbols JIM may use. Narrow this
                                where something downstream of the Connected System cannot cope with a particular character.</MudText>

                            <MudSwitch Class="mt-4" @bind-Value="@Configuration.CustomPolicy.ExcludeAmbiguousCharacters"
                                       @bind-Value:after="NotifyChangedAsync" Color="Color.Primary"
                                       Label="Leave out easily confused characters" />
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">Excludes
                                @PasswordGenerationPolicy.AmbiguousCharacters, which are hard to tell apart when a password
                                is read out or copied by hand. An initial password is transcribed far more often than a
                                permanent one.</MudText>
                        }

                        @if (Configuration.Source == InitialPasswordSource.Static)
                        {
                            <MudDivider Class="my-5" />
                            @* ─── The one password every account gets ─── *@
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-5">
                                <MudText Typo="Typo.body1">This option is not recommended</MudText>
                                <MudText Typo="Typo.body2">
                                    Every account this Synchronisation Rule provisions shares this password until each
                                    person changes it, so anybody who learns of this can sign in as any new starter who
                                    has not. Note: the password is stored encrypted and cannot be shown to you again.
                                </MudText>
                            </MudAlert>

                            @* Blank on load, whatever is stored. Blank means "leave the stored password as it is", which
                               is what makes the field write-only without a special case anywhere else. *@
                            <MudTextField T="string" Label="Password" @bind-Value="@_staticPassword"
                                          @bind-Value:after="HandleStaticPasswordChangedAsync" Immediate="true"
                                          InputType="@(_showStaticPassword ? InputType.Text : InputType.Password)"
                                          Adornment="Adornment.End" AdornmentIcon="@(_showStaticPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                          OnAdornmentClick="ToggleStaticPasswordVisibility" AdornmentAriaLabel="Show or hide the password"
                                          Variant="Variant.Outlined" data-testid="initial-password-static" />

                            <MudTextField T="string" Label="Confirm password" @bind-Value="@_staticPasswordConfirm"
                                          @bind-Value:after="HandleStaticPasswordChangedAsync" Immediate="true"
                                          InputType="@(_showStaticPassword ? InputType.Text : InputType.Password)"
                                          Error="@StaticPasswordsDoNotMatch" ErrorText="The two passwords do not match."
                                          Variant="Variant.Outlined" Class="mt-4" data-testid="initial-password-static-confirm" />

                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                                @if (Configuration.StaticPasswordSetAt.HasValue)
                                {
                                    @* Captured into a local per the Razor nullable-dereference rule. *@
                                    var setAt = Configuration.StaticPasswordSetAt.Value;
                                    <text>A password is set, last changed @setAt.ToLocalTime().ToRelativeTime(). Leave these
                                    fields blank to keep it.</text>
                                }
                                else if (!string.IsNullOrEmpty(Configuration.StaticPasswordEncryptedValue))
                                {
                                    <text>A password is set. Leave these fields blank to keep it.</text>
                                }
                                else
                                {
                                    <text>No password has been set. Until one is, the accounts this Synchronisation Rule
                                    provisions are held for an administrator rather than given a password nobody
                                    knows.</text>
                                }
                            </MudText>

                            @* ─── What the supplied password contains ───
                               Deliberately no entropy figure: JIM knows what is in this password but nothing about how
                               it was chosen, and a figure it cannot stand behind is worse than none. *@
                            @if (StaticPasswordAssessment != null)
                            {
                                var staticAssessment = StaticPasswordAssessment;
                                <MudAlert Severity="@(staticAssessment.IsUsable ? Severity.Success : Severity.Error)" Variant="Variant.Outlined" Class="mt-5">
                                    @if (staticAssessment.IsUsable)
                                    {
                                        <MudText Typo="Typo.body1">This password is @staticAssessment.Length characters and
                                            covers @staticAssessment.CharacterClassCount of the character categories this
                                            Connected System counts.</MudText>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body1">This password cannot be used:</MudText>
                                        <ul class="mt-1">
                                            @foreach (var problem in staticAssessment.Problems)
                                            {
                                                <li>@problem</li>
                                            }
                                        </ul>
                                    }
                                </MudAlert>
                            }
                        }

                        @* ─── What this configuration produces ───
                           Only for the sources that generate. A static password produces nothing to describe, and the
                           generator figures would be about passwords this rule will never produce. *@
                        @if (Assessment != null && Configuration.Source != InitialPasswordSource.Static)
                        {
                            var assessment = Assessment;
                            <MudAlert Severity="@(assessment.IsUsable ? Severity.Success : Severity.Error)" Variant="Variant.Outlined" Class="mt-5">
                                @if (assessment.IsUsable)
                                {
                                    <MudText Typo="Typo.body1">Every generated password will be at least
                                        @assessment.GuaranteedMinimumLength characters, cover
                                        @assessment.GuaranteedCharacterClassCount of the four character categories, and carry at
                                        least @assessment.EntropyBits.ToString("F1") bits of entropy.</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body1">These settings cannot be used:</MudText>
                                    <ul class="mt-1">
                                        @foreach (var problem in assessment.Problems)
                                        {
                                            <li>@problem</li>
                                        }
                                    </ul>
                                }
                            </MudAlert>
                        }

                        <MudDivider Class="my-5" />

                        @* ─── What happens to the account ─── *@
                        <MudSelect T="PasswordExpiryBehaviour" Label="After the password is set" @bind-Value="@Configuration.ExpiryBehaviour"
                                   @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                            @foreach (var behaviour in SupportedExpiryBehaviours)
                            {
                                <MudSelectItem Value="behaviour">@DescribeExpiryBehaviour(behaviour)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">Only what the @ConnectorLabel
                            can apply is offered. Where a particular target cannot honour the choice, JIM records what it
                            applied instead rather than assuming the request was met.</MudText>
                        @if (Configuration.Source == InitialPasswordSource.Static)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">Requiring a change at the next
                                sign-in is what ends an account's share of the one password above. Any other choice leaves
                                every account this rule provisions on it until somebody changes it by hand.</MudText>
                        }

                        <MudSwitch Class="mt-4" @bind-Value="@Configuration.EnableAccount" @bind-Value:after="NotifyChangedAsync"
                                   Color="Color.Primary" Label="Enable the account once the password is set" />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">Directories that refuse to enable an
                            account without a compliant password need the password first, which is why this belongs here
                            rather than in an Attribute Flow. Turn it off where accounts are enabled by a separate process.</MudText>
                    }
                }
</MudPaper>

@code {
    /// <summary>
    /// The Synchronisation Rule's initial-password configuration, mutated in place. The parent owns creating it
    /// so that the rule's saved graph and this editor are never looking at two different objects.
    /// </summary>
    [Parameter]
    public SyncRuleInitialPassword Configuration { get; set; } = null!;

    /// <summary>
    /// The password policy JIM discovered on the Connected System, or null where none was discovered.
    /// </summary>
    [Parameter]
    public ConnectedSystemPasswordPolicy? DiscoveredPolicy { get; set; }

    /// <summary>
    /// What the Connected System's Connector can actually apply once the password is set. Empty means it cannot
    /// set passwords at all.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<PasswordExpiryBehaviour> SupportedExpiryBehaviours { get; set; } = [];

    /// <summary>
    /// What the current settings would produce, recomputed by the parent on every change. Null before the first
    /// assessment has been made.
    /// </summary>
    [Parameter]
    public PasswordGenerationAssessment? Assessment { get; set; }

    /// <summary>
    /// What the password an administrator typed contains, and whether the target would accept it. Null until one
    /// has been typed, which is also the state a saved rule loads in: the stored password is never read back.
    /// </summary>
    [Parameter]
    public SuppliedPasswordAssessment? StaticPasswordAssessment { get; set; }

    /// <summary>
    /// Raised with the password once both fields agree, and with null whenever they do not.
    /// <para>
    /// The plaintext leaves this component and goes no further than the parent, which encrypts it. Raising null
    /// rather than nothing on a mismatch is what stops a password committed from a field the administrator has
    /// since edited surviving on the model: the two fields would disagree on screen while the model held the
    /// earlier value, and saving would store a password nobody typed.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback<string?> OnStaticPasswordEntered { get; set; }

    [Parameter]
    public string ConnectorName { get; set; } = UnknownConnectorName;

    private const string UnknownConnectorName = "Connected System's";

    /// <summary>
    /// The Connector's name as it reads in a sentence.
    /// <para>
    /// Every reserved Connector name already ends in "Connector" and begins with "JIM", so interpolating one and
    /// then writing the word again produced "the JIM LDAP Connector Connector". The "JIM " prefix earns nothing
    /// in prose where every Connector carries it, and JIM.Web/CLAUDE.md permits dropping it here. The fallback,
    /// used when the Connector could not be resolved, is not a name and needs the noun supplied.
    /// </para>
    /// </summary>
    private string ConnectorLabel => ConnectorName == UnknownConnectorName
        ? "Connected System's Connector"
        : ConnectorName.StartsWith("JIM ", StringComparison.Ordinal) ? ConnectorName[4..] : ConnectorName;

    /// <summary>
    /// What the target said about the accounts parked against this rule, grouped by reason and biggest first.
    /// Empty or null when nothing is parked, which is the ordinary case and renders nothing at all.
    /// </summary>
    [Parameter]
    public IReadOnlyList<InitialPasswordRejection>? ParkedReasons { get; set; }

    /// <summary>
    /// True when the settings have been edited in a way that changes what would be delivered, so saving really
    /// will release the parked accounts. The parent owns this because only it holds what was saved.
    /// </summary>
    [Parameter]
    public bool WillReleaseParkedOnSave { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private int ParkedAccountCount => ParkedReasons?.Sum(r => r.AccountCount) ?? 0;

    private bool ConnectorCanSetPasswords => SupportedExpiryBehaviours.Count > 0;

    /// <summary>
    /// The password being typed. Held here and never written into <see cref="Configuration"/>, which carries only
    /// the encrypted value; the parent does the encrypting.
    /// </summary>
    private string? _staticPassword;

    private string? _staticPasswordConfirm;

    private bool _showStaticPassword;

    /// <summary>
    /// Whether the two fields disagree. A confirm field nobody has typed in yet is not a disagreement, or the
    /// error would appear on the first keystroke of the password above it.
    /// </summary>
    private bool StaticPasswordsDoNotMatch =>
        !string.IsNullOrEmpty(_staticPassword) &&
        !string.IsNullOrEmpty(_staticPasswordConfirm) &&
        _staticPassword != _staticPasswordConfirm;

    private void ToggleStaticPasswordVisibility() => _showStaticPassword = !_showStaticPassword;

    /// <summary>
    /// Hands the parent the password once both fields agree, and null while they do not. See
    /// <see cref="OnStaticPasswordEntered"/> for why a mismatch raises null rather than staying quiet.
    /// </summary>
    private async Task HandleStaticPasswordChangedAsync()
    {
        var entered = !string.IsNullOrEmpty(_staticPassword) && _staticPassword == _staticPasswordConfirm
            ? _staticPassword
            : null;

        await OnStaticPasswordEntered.InvokeAsync(entered);
    }

    private async Task NotifyChangedAsync()
    {
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Describes an expiry behaviour in terms of what happens to the person using the account, rather than
    /// naming the directory attribute that implements it.
    /// </summary>
    private static string DescribeExpiryBehaviour(PasswordExpiryBehaviour behaviour) => behaviour switch
    {
        PasswordExpiryBehaviour.RequireChangeAtNextSignIn => "Require a change at the next sign-in",
        PasswordExpiryBehaviour.ExpiresAccordingToTargetPolicy => "Age according to the Connected System's own policy",
        PasswordExpiryBehaviour.NeverExpires => "Never expires",
        _ => behaviour.ToString()
    };
}
