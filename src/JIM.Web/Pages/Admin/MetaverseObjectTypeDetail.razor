@page "/admin/schema/object-types/{Id:int}"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Activities
@using JIM.Models.Core
@using JIM.Models.Logic
@using JIM.Models.Logic.DTOs
@using JIM.Models.Preview
@using JIM.Models.Staging
@using JIM.Utilities
@using JIM.Web.Models
@using JIM.Web.Pages.Admin.Components
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IConfigurationChangePreviewStarter PreviewStarter

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Metaverse Object Type: @_metaverseObjectType?.Name</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Helpers.ResolveObjectTypeIcon(_metaverseObjectType?.Icon)" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>Metaverse Object Type:</span> <span class="mud-primary-text">@_metaverseObjectType?.Name</span></MudText>
<div class="d-flex justify-space-between align-center">
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
    @if (_metaverseObjectType != null)
    {
        <AuditInfo Entity="@_metaverseObjectType" />
    }
</div>

@if (_metaverseObjectType != null)
{
    <NavigableMudTabs TabPanelsClass="pt-5" Class="mt-2">

        <MudTabPanel Text="Details">
            <MudPaper Class="pa-4" Outlined="true">
                <div class="d-flex justify-space-between align-center mb-4">
                    <MudText Typo="Typo.h5">Details</MudText>
                    @if (!_metaverseObjectType.BuiltIn)
                    {
                        <MudTooltip Text="Edit Object Type" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Class="my-n3" aria-label="edit object type" OnClick="OpenEditObjectTypeDialogAsync" />
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="Built-in Object Types cannot be renamed or re-iconed." Arrow="true" Placement="Placement.Top">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mud-text-secondary" />
                        </MudTooltip>
                    }
                </div>
                <MudGrid Spacing="4">
                    <MudItem xs="12" sm="6" md="4">
                        <MudField Label="Name" Variant="Variant.Outlined">@_metaverseObjectType.Name</MudField>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudField Label="Plural Name" Variant="Variant.Outlined">@_metaverseObjectType.PluralName</MudField>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudField Label="Built-in?" Variant="Variant.Outlined">@(_metaverseObjectType.BuiltIn ? "Yes" : "No")</MudField>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudField Label="Icon" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Helpers.ResolveObjectTypeIcon(_metaverseObjectType.Icon)">
                            @(_metaverseObjectType.Icon ?? "None")
                        </MudField>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">
                            Browse available icons at the <MudLink Href="https://mudblazor.com/features/icons" Target="_blank">MudBlazor Icon Gallery</MudLink>. Use the <strong>Filled</strong> icon name (e.g., "Person", "Groups", "Devices").
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Class="pa-4 mt-6" Outlined="true">
                <MudText Typo="Typo.h5" Class="mb-2">Deletion Rules</MudText>
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-4">Configure when Metaverse Objects of this type should be automatically deleted.</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6" md="4">
                        <MudSelect T="MetaverseObjectDeletionRule" Label="Deletion Rule" @bind-Value="_deletionRule"
                            Variant="Variant.Outlined" HelperText="@GetDeletionRuleHelperText()">
                            <MudSelectItem Value="MetaverseObjectDeletionRule.Manual">Manual</MudSelectItem>
                            <MudSelectItem Value="MetaverseObjectDeletionRule.WhenLastConnectorDisconnected">When Last Connector Disconnected</MudSelectItem>
                            <MudSelectItem Value="MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected">When Authoritative Source Disconnected</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="4" sm="2" md="2">
                        <MudNumericField T="int" Label="Days" @bind-Value="_gracePeriodDays"
                            Variant="Variant.Outlined" Min="0" Max="3650" Immediate="true"
                            HelperText="Grace period" />
                    </MudItem>
                    <MudItem xs="4" sm="2" md="2">
                        <MudNumericField T="int" Label="Hours" @bind-Value="_gracePeriodHours"
                            Variant="Variant.Outlined" Min="0" Max="23" Immediate="true" />
                    </MudItem>
                    <MudItem xs="4" sm="2" md="2">
                        <MudNumericField T="int" Label="Minutes" @bind-Value="_gracePeriodMinutes"
                            Variant="Variant.Outlined" Min="0" Max="59" Immediate="true" />
                    </MudItem>
                </MudGrid>

                @if (_deletionRule == MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected)
                {
                    @* Deletion Trigger mode (#119): whether every selected source must disconnect, or any one *@
                    <div class="mt-4">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Deletion Trigger</MudText>
                        <MudRadioGroup T="AuthoritativeSourceTriggerMode" @bind-Value="_deletionTriggerMode">
                            <MudStack Spacing="1">
                                <MudRadio Value="AuthoritativeSourceTriggerMode.AllSourcesDisconnect" Color="Color.Primary">
                                    <MudText Typo="Typo.body1">All sources disconnect</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        Delete only once every selected source has disconnected. Resilient to a single
                                        system failing or being rebuilt. This is the default.
                                    </MudText>
                                </MudRadio>
                                <MudRadio Value="AuthoritativeSourceTriggerMode.SpecificSourcesDisconnect" Color="Color.Primary">
                                    <MudText Typo="Typo.body1">Specific source(s) disconnect</MudText>
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        Delete when any one of the selected sources disconnects, even if others remain connected.
                                    </MudText>
                                </MudRadio>
                            </MudStack>
                        </MudRadioGroup>
                    </div>

                    <div class="mt-4">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Authoritative Sources</MudText>
                        @if (_contributingSystems.Any())
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                                Select the Connected Systems that are authoritative sources for this object type.
                                At least one contributing system must be selected; nothing is selected by default.
                            </MudText>
                            @foreach (var system in _contributingSystems)
                            {
                                <MudCheckBox T="bool" Value="@_selectedAuthoritativeSources.Contains(system.Id)"
                                    ValueChanged="@((bool val) => ToggleAuthoritativeSource(system.Id, val))"
                                    Label="@system.Name" Color="Color.Primary" />
                            }
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                No contributing systems found. Create inbound Synchronisation Rules for this object type to enable authoritative source selection.
                            </MudAlert>
                        }
                    </div>

                    @if (_contributingSystems.Any())
                    {
                        @* Live summary (#119): restates trigger mode, sources by name and grace period before Save *@
                        <div class="mt-4">
                            <DeletionTriggerSummary ObjectTypeName="@_metaverseObjectType.Name"
                                TriggerMode="_deletionTriggerMode"
                                SourceNames="@GetSelectedSourceNames()"
                                GracePeriod="@GetEditedGracePeriod()" />
                        </div>
                    }
                }

                <MudStack Row="true" Class="mt-5" Spacing="2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveDeletionRulesAsync"
                        Disabled="@(!CanSave())">
                        Save Changes
                    </MudButton>
                    @* Preview (#1114): the one change in JIM that can make existing Metaverse Objects eligible for *@
                    @* deletion the moment it is saved, so it is the one that most needs answering beforehand.      *@
                    <MudButton data-testid="jim-preview-deletion-settings" Variant="Variant.Outlined" Color="Color.Primary"
                        StartIcon="@Icons.Material.Filled.Visibility" OnClick="PreviewDeletionRulesAsync"
                        Disabled="@(!CanSave() || _startingPreview)">
                        Preview Changes
                    </MudButton>
                    <MudButton Variant="Variant.Text" OnClick="ResetDeletionRules">Reset</MudButton>
                </MudStack>

                @if (_previewActivityId.HasValue)
                {
                    var previewActivityId = _previewActivityId.Value;

                    @if (DeletionSettingsPreviewIsStale)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-6"
                                  data-testid="jim-preview-stale">
                            The deletion settings have been edited since this preview ran, so it no longer describes
                            what saving would do. Preview again for an answer about the current settings.
                        </MudAlert>
                    }

                    <ConfigurationChangePreviewPanel ActivityId="@previewActivityId"
                                                     Title="Preview: Deletion Rules"
                                                     OnPreviewChanged="OnDeletionSettingsPreviewChanged"
                                                     Class="mt-6" />
                }
            </MudPaper>

            <MudPaper Class="pa-4 mt-6" Outlined="true">
                <MudText Typo="Typo.h5" Class="mb-2">Downstream Deprovisioning</MudText>
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-4">When a Metaverse Object of this type is deleted
                    (or leaves an export Synchronisation Rule's scope), each export Synchronisation Rule's Deprovisioning Action
                    determines what happens to the corresponding object in its Connected System: Disconnect leaves it in place;
                    Delete removes it. Disabled Synchronisation Rules do not apply during synchronisation.</MudText>

                @* The export Synchronisation Rules targeting this type are a handful even on a large deployment, and
                   are already loaded, so the grid slices its windows from memory rather than reading a range. *@
                <VirtualisedDataGrid @ref="_deprovisioningGrid" T="SyncRuleHeader"
                                     ContainerId="mvot-deprovisioning-list"
                                     UrlParameterPrefix="dp-"
                                     DefaultSortBy="connectedsystem"
                                     LoadWindow="LoadExportRuleWindowAsync"
                                     SingularName="Synchronisation Rule"
                                     PluralName="Synchronisation Rules"
                                     SearchPlaceholder="Search rules">
                    <Columns>
                        <TemplateColumn Title="Connected System" Sortable="false">
                            <HeaderTemplate>
                                <VirtualisedSortHeader Title="Connected System" Name="connectedsystem" />
                            </HeaderTemplate>
                            <CellTemplate>
                                <MudLink Href="@($"/admin/connected-systems/{context.Item.ConnectedSystemId}")">@context.Item.ConnectedSystemName</MudLink>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Synchronisation Rule" Sortable="false">
                            <HeaderTemplate>
                                <VirtualisedSortHeader Title="Synchronisation Rule" Name="name" />
                            </HeaderTemplate>
                            <CellTemplate>
                                <MudLink Href="@($"/admin/sync-rules/{context.Item.Id}")">@context.Item.Name</MudLink>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Status" Sortable="false">
                            <HeaderTemplate>
                                <VirtualisedSortHeader Title="Status" Name="status" />
                            </HeaderTemplate>
                            <CellTemplate>
                                @if (context.Item.Enabled)
                                {
                                    <MudChip T="string" Variant="Variant.Text" Color="Color.Success">Enabled</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Variant="Variant.Text" Color="Color.Default">Disabled</MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Deprovisioning Action" Sortable="false">
                            <HeaderTemplate>
                                <VirtualisedSortHeader Title="Deprovisioning Action" Name="deprovisioningaction" />
                            </HeaderTemplate>
                            <CellTemplate>
                                @{
                                    var header = context.Item;
                                }
                                <MudSelect T="OutboundDeprovisionAction" Value="@header.OutboundDeprovisionAction"
                                           ValueChanged="@((OutboundDeprovisionAction newAction) => OnDeprovisionActionChangedAsync(header, newAction))"
                                           Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-0" Style="max-width: 200px;">
                                    <MudSelectItem Value="OutboundDeprovisionAction.Disconnect">Disconnect</MudSelectItem>
                                    <MudSelectItem Value="OutboundDeprovisionAction.Delete">Delete</MudSelectItem>
                                </MudSelect>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <EmptyContent Context="grid">
                        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                        {
                            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                             PrimaryText="@($"No export Synchronisation Rules match \"{grid.SearchText}\"")"
                                             SecondaryText="Try a different search term, or clear the search."
                                             ActionText="Clear Search"
                                             OnAction="@(() => grid.ClearSearchAsync())" />
                        }
                        else
                        {
                            <TableEmptyState Icon="@Icons.Material.Filled.Output"
                                             PrimaryText="No export Synchronisation Rules target this Metaverse Object Type"
                                             SecondaryText="When Metaverse Objects of this type are deleted, no objects in Connected Systems are affected. Create an export Synchronisation Rule for this type to change that." />
                        }
                    </EmptyContent>
                </VirtualisedDataGrid>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Attributes">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.h5" Class="mb-2">Attributes</MudText>
                <MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-4">These are the attributes bound to the Metaverse Object Type:</MudText>

            @* Filter Chips Section *@
            <MudStack Row="true" Spacing="6" Class="mb-3 flex-wrap" AlignItems="AlignItems.Start">
                @* Type Filter *@
                <div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Filter by Type:</MudText>
                    <MudChipSet T="AttributeDataType"
                                SelectionMode="SelectionMode.MultiSelection"
                                SelectedValues="_selectedTypes"
                                SelectedValuesChanged="OnTypeFilterChanged">
                        @foreach (var type in GetAvailableTypes())
                        {
                            <MudChip Value="@type.Key"
                                     Color="@(_selectedTypes.Contains(type.Key) ? Color.Default : Color.Primary)"
                                     Variant="@(_selectedTypes.Contains(type.Key) ? Variant.Filled : Variant.Outlined)"
                                     SelectedColor="Color.Primary">
                                @type.Key.ToString().SplitOnCapitalLetters()
                                <MudText Typo="Typo.caption" Class="ml-1">(@type.Value)</MudText>
                            </MudChip>
                        }
                    </MudChipSet>
                </div>

                @* Plurality Filter *@
                <div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Filter by Plurality:</MudText>
                    <MudChipSet T="AttributePlurality"
                                SelectionMode="SelectionMode.MultiSelection"
                                SelectedValues="_selectedPluralities"
                                SelectedValuesChanged="OnPluralityFilterChanged">
                        @foreach (var plurality in GetAvailablePluralities())
                        {
                            <MudChip Value="@plurality.Key"
                                     Color="@(_selectedPluralities.Contains(plurality.Key) ? Color.Default : Color.Info)"
                                     Variant="@(_selectedPluralities.Contains(plurality.Key) ? Variant.Filled : Variant.Outlined)"
                                     SelectedColor="Color.Info">
                                @(plurality.Key == AttributePlurality.SingleValued ? "Single-Valued" : "Multi-Valued")
                                <MudText Typo="Typo.caption" Class="ml-1">(@plurality.Value)</MudText>
                            </MudChip>
                        }
                    </MudChipSet>
                </div>

                @* Built-in Filter *@
                <div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Filter by Built-in:</MudText>
                    <MudChipSet T="bool"
                                SelectionMode="SelectionMode.MultiSelection"
                                SelectedValues="_selectedBuiltIn"
                                SelectedValuesChanged="OnBuiltInFilterChanged">
                        @foreach (var builtIn in GetAvailableBuiltIn())
                        {
                            <MudChip Value="@builtIn.Key"
                                     Color="Color.Default"
                                     Variant="@(_selectedBuiltIn.Contains(builtIn.Key) ? Variant.Filled : Variant.Outlined)"
                                     SelectedColor="Color.Default">
                                @(builtIn.Key ? "Yes" : "No")
                                <MudText Typo="Typo.caption" Class="ml-1">(@builtIn.Value)</MudText>
                            </MudChip>
                        }
                    </MudChipSet>
                </div>
            </MudStack>

            @* The attributes bound to an Object Type run to a few hundred on a well-modelled deployment, and are
               already loaded with it, so the grid slices its windows from memory. The chip filters above stay the
               page's own: they change which attributes match, so each one re-counts and returns the reader to the
               top rather than leaving a total and a scroll position describing a match set that has gone. *@
            <VirtualisedDataGrid @ref="_attributeGrid" T="MetaverseAttribute"
                                 ContainerId="mvot-attribute-list"
                                 UrlParameterPrefix="at-"
                                 DefaultSortBy="name"
                                 LoadWindow="LoadAttributeWindowAsync"
                                 SingularName="Attribute"
                                 PluralName="Attributes"
                                 SearchPlaceholder="Search attributes">
                <ToolBarExtras>
                    <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                               DropShadow="false" OnClick="OpenAddAttributeBindingDialogAsync">Add Attribute</MudButton>
                </ToolBarExtras>
                <Columns>
                    <TemplateColumn Title="Name" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Name" Name="name" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @context.Item.Name
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Type" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Type" Name="type" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="string" Color="@Helpers.GetAttributeTypeChipColour(context.Item.Type)" Variant="Variant.Outlined">
                                @context.Item.Type.ToString().SplitOnCapitalLetters()
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Plurality" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Plurality" Name="plurality" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="string" Color="@Helpers.GetAttributePluralityChipColour(context.Item.AttributePlurality)" Variant="Variant.Text">
                                @(context.Item.AttributePlurality == AttributePlurality.SingleValued ? "Single-Valued" : "Multi-Valued")
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Built-in?" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Built-in?" Name="builtin" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.BuiltIn)
                            {
                                <MudTooltip Text="Built-in attribute" Arrow="true" Placement="Placement.Top">
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mud-text-secondary" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">Custom</MudText>
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Created" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Created" Name="created" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @{
                                var created = context.Item.Created.ToLocalTime();
                            }
                            <MudTooltip Text="@created.ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                                @created.ToRelativeTime()
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="Contributors" Sortable="false">
                        <HeaderTemplate>
                            <MudTooltip Text="The number of Synchronisation Rules that contribute this attribute inbound. More than one means an Attribute Priority order determines which wins." Arrow="true" Placement="Placement.Top">
                                <VirtualisedSortHeader Title="Contributors" Name="contributors" />
                            </MudTooltip>
                        </HeaderTemplate>
                        <CellTemplate>
                            @{
                                var attribute = context.Item;
                                var contributorCount = _contributorCounts.GetValueOrDefault(attribute.Id, 0);
                            }
                            @if (contributorCount > 1)
                            {
                                <MudTooltip Text="Multiple contributors. Click to manage the Attribute Priority order." Arrow="true" Placement="Placement.Top">
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                               EndIcon="@Icons.Material.Filled.OpenInNew"
                                               OnClick="@(() => OpenAttributePriorityDialog(attribute))">
                                        @contributorCount contributors
                                    </MudButton>
                                </MudTooltip>
                            }
                            else if (contributorCount == 1)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">1</MudText>
                            }
                            else
                            {
                                <EmptyValue />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Sortable="false">
                        <HeaderTemplate></HeaderTemplate>
                        <CellTemplate>
                            @{
                                var rowAttribute = context.Item;
                            }
                            <div class="d-flex justify-end">
                                <MudTooltip Text="Change history" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.History" OnClick="@(() => ShowAttributeHistoryDialogAsync(rowAttribute))" />
                                </MudTooltip>
                                @if (rowAttribute.BuiltIn)
                                {
                                    <MudTooltip Text="Built-in attributes cannot be unbound." Arrow="true" Placement="Placement.Top">
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mud-text-secondary ml-2" />
                                    </MudTooltip>
                                }
                                else
                                {
                                    <MudTooltip Text="Remove this attribute from the Object Type" Arrow="true" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Close" Color="Color.Error" OnClick="@(() => OpenRemoveAttributeBindingDialogAsync(rowAttribute))" />
                                    </MudTooltip>
                                }
                            </div>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <EmptyContent Context="grid">
                    @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                         PrimaryText="@($"No attributes match \"{grid.SearchText}\"")"
                                         SecondaryText="Try a different search term, or clear the search."
                                         ActionText="Clear Search"
                                         OnAction="@(() => grid.ClearSearchAsync())" />
                    }
                    else if (HasAttributeChipFilters)
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                                         PrimaryText="No attributes match the selected filters"
                                         SecondaryText="Clear the Type, Plurality and Built-in filters above to see every attribute bound to this Metaverse Object Type."
                                         ActionText="Clear Filters"
                                         OnAction="ClearAttributeFiltersAsync" />
                    }
                    else
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.ListAlt"
                                         PrimaryText="No attributes are bound to this Metaverse Object Type"
                                         SecondaryText="Use the Add Attribute button to bind one; until then, Metaverse Objects of this type can hold no values." />
                    }
                </EmptyContent>
            </VirtualisedDataGrid>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Changes" BadgeData="@(_changeCount > 0 ? _changeCount.ToString("N0") : null)" BadgeColor="Color.Primary">
            <ConfigurationChangesTab TargetType="ActivityTargetType.MetaverseObjectType" ObjectId="Id" ObjectTypeLabel="Metaverse Object Type" />
        </MudTabPanel>

    </NavigableMudTabs>

    @* Attribute Priority (#91, Surface 2). This was an expander row underneath the attribute it belongs to, which a
       virtualised grid cannot carry: the virtualiser positions rows from a fixed row height, and a row that grows a
       drag-and-drop list underneath itself breaks the arithmetic every row below it depends on. A dialog keeps the
       ordering editable, and keeps it anchored to the attribute by naming it in the title. *@
    <MudDialog @bind-Visible="_priorityDialogVisible" Options="_priorityDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.LowPriority" Class="mr-3" />Attribute Priority: @_priorityAttribute?.Name
            </MudText>
        </TitleContent>
        <DialogContent>
            @if (_priorityAttribute != null)
            {
                var priorityAttribute = _priorityAttribute;
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                    Multiple Synchronisation Rules can contribute this attribute. Drag to set which wins when more than one supplies a value; the highest priority is at the top. The first to supply a value wins (unless <code class="jim-code-inline jim-code-inline-strong">Null is a value</code> is selected). Disabled rules hold their position but never contribute.
                </MudText>
                <AttributePriorityList MetaverseObjectTypeId="Id" MetaverseAttributeId="priorityAttribute.Id" MetaverseAttributeName="@priorityAttribute.Name" />
            }
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="CloseAttributePriorityDialog" DropShadow="false">Close</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private MetaverseObjectType? _metaverseObjectType;
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private int _changeCount;

    // Attribute Priority (#91, Surface 2): per-attribute import contributor counts (drives the multi-contributor
    // badge), and the attribute whose priority order is open in the dialog.
    private Dictionary<int, int> _contributorCounts = new();
    private MetaverseAttribute? _priorityAttribute;
    private bool _priorityDialogVisible;
    private readonly DialogOptions _priorityDialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true };

    // The two virtualised grids on this page. Each holds its own search, sort and scroll state, under its own URL
    // parameter prefix, and is refreshed by the page whenever the page's own filters or data change underneath it.
    private VirtualisedDataGrid<MetaverseAttribute>? _attributeGrid;
    private VirtualisedDataGrid<SyncRuleHeader>? _deprovisioningGrid;

    // Attribute filter state
    private IReadOnlyCollection<AttributeDataType> _selectedTypes = new List<AttributeDataType>();
    private IReadOnlyCollection<AttributePlurality> _selectedPluralities = new List<AttributePlurality>();
    private IReadOnlyCollection<bool> _selectedBuiltIn = new List<bool>();

    // Deletion rules state
    private MetaverseObjectDeletionRule _deletionRule;
    private AuthoritativeSourceTriggerMode _deletionTriggerMode;
    private int _gracePeriodDays;
    private int _gracePeriodHours;
    private int _gracePeriodMinutes;
    private HashSet<int> _selectedAuthoritativeSources = new();
    private List<(int Id, string Name)> _contributingSystems = new();

    // Configuration Change Preview of the deletion settings (#1114). The proposal the preview was started for is
    // kept beside its Activity id so the panel can be labelled stale the moment the form moves on from it: a
    // preview presented against settings it did not evaluate is worse than no preview, because it is believed.
    private Guid? _previewActivityId;
    private MetaverseObjectTypeDeletionSettingsProposal? _previewedProposal;
    private ConfigurationChangePreview? _preview;
    private bool _startingPreview;

    // Original values for change detection
    private MetaverseObjectDeletionRule _originalDeletionRule;
    private AuthoritativeSourceTriggerMode _originalDeletionTriggerMode;
    private int _originalGracePeriodDays;
    private int _originalGracePeriodHours;
    private int _originalGracePeriodMinutes;
    private HashSet<int> _originalAuthoritativeSources = new();

    // Downstream Deprovisioning (#655): export Synchronisation Rules targeting this Metaverse Object
    // Type, with their inline-editable Deprovisioning Action.
    private IList<SyncRuleHeader>? _exportRuleHeaders;

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _metaverseObjectType = await jim.Metaverse.GetMetaverseObjectTypeAsync(Id, true);
        if (_metaverseObjectType == null)
        {
            NavManager.NavigateTo("../");
            return;
        }

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("Home", href: "/", icon: Icons.Material.Filled.Home),
            new("Administration", href: "/admin"),
            new("Schema", href: "/admin/schema/"),
            new(_metaverseObjectType.Name, href: null, disabled: true)
        };

        _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.MetaverseObjectType, Id, 1, 1)).TotalResults;

        // Attribute Priority (#91): import contributor count per attribute, for the multi-contributor badge.
        _contributorCounts = await jim.ConnectedSystems.GetAttributeContributorCountsAsync(Id);

        // Load contributing systems (systems with inbound Synchronisation Rules for this object type)
        await LoadContributingSystemsAsync();

        // Downstream Deprovisioning (#655): export Synchronisation Rules targeting this object type
        _exportRuleHeaders = await jim.ConnectedSystems.GetSyncRuleHeadersAsync(Id, SyncRuleDirection.Export);

        // Initialise deletion rules state
        InitialiseDeletionRulesState();
    }

    private async Task OnDeprovisionActionChangedAsync(SyncRuleHeader header, OutboundDeprovisionAction newAction)
    {
        if (newAction == header.OutboundDeprovisionAction)
            return;

        try
        {
            using var jim = JimFactory.Create();
            var rule = await jim.ConnectedSystems.GetSyncRuleAsync(header.Id);
            if (rule == null)
            {
                Snackbar.Add("The Synchronisation Rule could not be found. It may have been deleted.", Severity.Error);
                await RevertDeprovisionSelectAsync();
                return;
            }

            // This dropdown changes a Synchronisation Rule's Deprovisioning Action without going near the rule editor,
            // so it needs the same acknowledgement the editor gives: switching to Delete means deprovisioned objects
            // are deleted in the Connected System rather than disconnected from JIM.
            rule.OutboundDeprovisionAction = newAction;
            var preflight = await jim.ConfigurationChangePreflight.EvaluateSyncRuleAsync(rule);
            if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                    "Synchronisation Rule", rule.Name))
            {
                await RevertDeprovisionSelectAsync();
                return;
            }

            // offer an optional reason for the configuration change history; cancelling aborts the change
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
            if (cancelled)
            {
                await RevertDeprovisionSelectAsync();
                return;
            }

            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var success = await jim.ConnectedSystems.CreateOrUpdateSyncRuleAsync(rule, user, changeReason: changeReason);
            if (!success)
            {
                Snackbar.Add($"Failed to update Synchronisation Rule '{rule.Name}'.", Severity.Error);
                await RevertDeprovisionSelectAsync();
                return;
            }

            header.OutboundDeprovisionAction = newAction;
            Snackbar.Add($"Deprovisioning Action for '{rule.Name}' set to {newAction}.", Severity.Success);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add($"Failed to update the Synchronisation Rule: {ex.Message}", Severity.Error);
            await RevertDeprovisionSelectAsync();
        }
    }

    /// <summary>
    /// Puts the Deprovisioning Action drop-down back to the value on the header, after a change the administrator
    /// abandoned or that failed to save. A page re-render is not enough: the grid caches the rows it is holding,
    /// so the select keeps showing the abandoned choice until the grid itself repaints them.
    /// </summary>
    private async Task RevertDeprovisionSelectAsync()
    {
        if (_deprovisioningGrid != null)
            await _deprovisioningGrid.RefreshAsync();
        else
            StateHasChanged();
    }

    private async Task LoadContributingSystemsAsync()
    {
        using var jim = JimFactory.Create();
        var importRuleHeaders = await jim.ConnectedSystems.GetSyncRuleHeadersAsync(Id, SyncRuleDirection.Import);
        _contributingSystems = importRuleHeaders
            .GroupBy(h => h.ConnectedSystemId)
            .Select(g => (Id: g.Key, Name: g.First().ConnectedSystemName))
            .OrderBy(s => s.Name)
            .ToList();
    }

    private void InitialiseDeletionRulesState()
    {
        if (_metaverseObjectType == null) return;

        _deletionRule = _metaverseObjectType.DeletionRule;

        // Trigger mode (#119): honour the stored mode for an existing WhenAuthoritativeSourceDisconnected
        // configuration; for any other rule the stored value is meaningless (existing rows read the
        // behaviour-preserving column default), so pre-select the safe default (All) ready for the
        // administrator configuring the rule anew.
        _deletionTriggerMode = _metaverseObjectType.DeletionRule == MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected
            ? _metaverseObjectType.DeletionTriggerMode
            : AuthoritativeSourceTriggerMode.AllSourcesDisconnect;

        var gp = _metaverseObjectType.DeletionGracePeriod ?? TimeSpan.Zero;
        _gracePeriodDays = gp.Days;
        _gracePeriodHours = gp.Hours;
        _gracePeriodMinutes = gp.Minutes;
        _selectedAuthoritativeSources = new HashSet<int>(_metaverseObjectType.DeletionTriggerConnectedSystemIds ?? new List<int>());

        // Store original values
        _originalDeletionRule = _deletionRule;
        _originalDeletionTriggerMode = _deletionTriggerMode;
        _originalGracePeriodDays = _gracePeriodDays;
        _originalGracePeriodHours = _gracePeriodHours;
        _originalGracePeriodMinutes = _gracePeriodMinutes;
        _originalAuthoritativeSources = new HashSet<int>(_selectedAuthoritativeSources);
    }

    private void ResetDeletionRules()
    {
        _deletionRule = _originalDeletionRule;
        _deletionTriggerMode = _originalDeletionTriggerMode;
        _gracePeriodDays = _originalGracePeriodDays;
        _gracePeriodHours = _originalGracePeriodHours;
        _gracePeriodMinutes = _originalGracePeriodMinutes;
        _selectedAuthoritativeSources = new HashSet<int>(_originalAuthoritativeSources);

        // Reset means "discard my edits", and the preview is an answer about exactly those edits.
        DiscardDeletionSettingsPreview();
    }

    private void DiscardDeletionSettingsPreview()
    {
        _previewActivityId = null;
        _previewedProposal = null;
        _preview = null;
    }

    private void ToggleAuthoritativeSource(int systemId, bool selected)
    {
        if (selected)
            _selectedAuthoritativeSources.Add(systemId);
        else
            _selectedAuthoritativeSources.Remove(systemId);
    }

    private string GetDeletionRuleHelperText()
    {
        return _deletionRule switch
        {
            MetaverseObjectDeletionRule.Manual => "Objects must be manually deleted by an administrator.",
            MetaverseObjectDeletionRule.WhenLastConnectorDisconnected => "Delete when all Connected System Objects are disconnected.",
            MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected => "Delete according to the authoritative source trigger below.",
            _ => string.Empty
        };
    }

    /// <summary>
    /// The display names of the currently selected authoritative sources, in contributing-system order,
    /// for the live summary (#119).
    /// </summary>
    private List<string> GetSelectedSourceNames()
    {
        return _contributingSystems
            .Where(s => _selectedAuthoritativeSources.Contains(s.Id))
            .Select(s => s.Name)
            .ToList();
    }

    /// <summary>
    /// The grace period currently entered in the editor fields, or null when zero, for the live summary (#119).
    /// </summary>
    private TimeSpan? GetEditedGracePeriod()
    {
        var gracePeriod = new TimeSpan(_gracePeriodDays, _gracePeriodHours, _gracePeriodMinutes, 0);
        return gracePeriod == TimeSpan.Zero ? null : gracePeriod;
    }

    private bool CanSave()
    {
        // Check if WhenAuthoritativeSourceDisconnected requires at least one source selected
        if (_deletionRule == MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected &&
            !_selectedAuthoritativeSources.Any())
        {
            return false;
        }

        // Check if there are actual changes
        return HasChanges();
    }

    // ─── Configuration Change Preview (#1114) ───

    /// <summary>
    /// The deletion settings currently entered, as the preview framework's proposal type. Built from the form
    /// rather than the entity so the preview evaluates what an administrator is about to save, which is the whole
    /// point of asking before saving it.
    /// </summary>
    private MetaverseObjectTypeDeletionSettingsProposal BuildDeletionSettingsProposal() =>
        new(_deletionRule,
            GetEditedGracePeriod(),
            _deletionRule == MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected
                ? _selectedAuthoritativeSources.OrderBy(id => id).ToList()
                : [],
            _deletionRule == MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected
                ? _deletionTriggerMode
                : _metaverseObjectType?.DeletionTriggerMode ?? AuthoritativeSourceTriggerMode.AllSourcesDisconnect);

    /// <summary>
    /// Whether the form has moved on from the settings the visible preview was run against.
    /// </summary>
    private bool DeletionSettingsPreviewIsStale =>
        _previewedProposal is not null && !BuildDeletionSettingsProposal().DescribesSameSettingsAs(_previewedProposal);

    private async Task PreviewDeletionRulesAsync()
    {
        if (_metaverseObjectType == null || _startingPreview)
            return;

        _startingPreview = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var proposal = BuildDeletionSettingsProposal();

            // The starter, not StartAndDispatchPreviewAsync: it owns the question of whether a large preview keeps
            // every drill-down row, and that decision belongs in one place rather than at each surface.
            var activityId = await PreviewStarter.StartAsync(new ConfigurationChangePreviewRequest
            {
                Surface = ConfigurationChangePreviewSurface.MetaverseObjectType,
                TargetId = _metaverseObjectType.Id,
                TargetName = _metaverseObjectType.Name,
                ProposedConfiguration = proposal,
                InitiatedByType = ActivityInitiatorType.User,
                InitiatedById = user?.Id,
                InitiatedByName = user?.Name
            });

            // Null means the administrator declined the data-set size question, which is a decision not to preview.
            if (activityId == null)
                return;

            _previewActivityId = activityId;
            _previewedProposal = proposal;
            _preview = null;
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            DiscardDeletionSettingsPreview();
            Snackbar.Add($"Failed to start the preview: {ex.Message}", Severity.Error);
        }
        finally
        {
            _startingPreview = false;
        }
    }

    /// <summary>
    /// Records the panel's latest read of the preview, for the save confirmation to state.
    ///
    /// Deliberately does not call <c>StateHasChanged</c>. The panel re-reads on every parameter set, so a page that
    /// re-rendered in response to this callback would set the panel's parameters again, which would refresh again,
    /// which would raise this again: a render loop that never settles and, worse, cancels and restarts the panel's
    /// reconciliation poll on every pass, so its delay never elapses and the panel sits on stage 1 for ever. Found
    /// by driving the portal; no test in the suite could have seen it. Nothing the page renders depends on this
    /// value, so storing it is enough.
    /// </summary>
    private void OnDeletionSettingsPreviewChanged(ConfigurationChangePreview? preview) => _preview = preview;

    private bool HasChanges()
    {
        if (_deletionRule != _originalDeletionRule) return true;
        if (_deletionTriggerMode != _originalDeletionTriggerMode) return true;
        if (_gracePeriodDays != _originalGracePeriodDays) return true;
        if (_gracePeriodHours != _originalGracePeriodHours) return true;
        if (_gracePeriodMinutes != _originalGracePeriodMinutes) return true;
        if (!_selectedAuthoritativeSources.SetEquals(_originalAuthoritativeSources)) return true;
        return false;
    }

    private async Task SaveDeletionRulesAsync()
    {
        if (_metaverseObjectType == null) return;

        // What is on the entity now, so an abandoned save leaves it as it was persisted. The form keeps the
        // administrator's edits either way; only the entity is rolled back.
        var persistedRule = _metaverseObjectType.DeletionRule;
        var persistedGracePeriod = _metaverseObjectType.DeletionGracePeriod;
        var persistedTriggers = _metaverseObjectType.DeletionTriggerConnectedSystemIds;

        void RollBack()
        {
            _metaverseObjectType.DeletionRule = persistedRule;
            _metaverseObjectType.DeletionGracePeriod = persistedGracePeriod;
            _metaverseObjectType.DeletionTriggerConnectedSystemIds = persistedTriggers;
        }

        try
        {
            // Update the object type. Applied to the entity before the preflight runs, because the preflight compares
            // the entity as it will be saved against its last captured snapshot.
            _metaverseObjectType.DeletionRule = _deletionRule;
            var gracePeriod = new TimeSpan(_gracePeriodDays, _gracePeriodHours, _gracePeriodMinutes, 0);
            _metaverseObjectType.DeletionGracePeriod = gracePeriod == TimeSpan.Zero ? null : gracePeriod;
            _metaverseObjectType.DeletionTriggerConnectedSystemIds = _deletionRule == MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected
                ? _selectedAuthoritativeSources.ToList()
                : new List<int>();

            // Trigger mode (#119): only meaningful for WhenAuthoritativeSourceDisconnected; leave the
            // stored value untouched for other rules so switching rule does not churn change history.
            if (_deletionRule == MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected)
                _metaverseObjectType.DeletionTriggerMode = _deletionTriggerMode;

            using var jim = JimFactory.Create();

            // Deletion settings are the one place in JIM where saving alone can make existing Metaverse Objects
            // eligible for deletion, with no synchronisation run in between; the acknowledgement says so, and where
            // a preview was run it says how many objects that is (#1114).
            var preflight = await jim.ConfigurationChangePreflight.EvaluateMetaverseObjectTypeAsync(_metaverseObjectType);
            if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                    "Metaverse Object Type", _metaverseObjectType.Name,
                    ConfigurationChangePreviewCounts.ForConfirmation(_preview, DeletionSettingsPreviewIsStale),
                    ConfigurationChangePreviewCounts.ForConfirmationVerdict(_preview, DeletionSettingsPreviewIsStale)))
            {
                RollBack();
                return;
            }

            // offer an optional reason for the configuration change history; cancelling aborts the save
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
            if (cancelled)
            {
                RollBack();
                return;
            }

            // The preview is linked only when it actually describes this change. A link to a preview run against
            // different settings would make the audit assert something untrue about what the administrator read.
            var previewActivityId = DeletionSettingsPreviewIsStale ? null : _previewActivityId;

            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Metaverse.UpdateMetaverseObjectTypeAsync(_metaverseObjectType, user, changeReason, previewActivityId);

            // Update original values to reflect saved state
            _originalDeletionRule = _deletionRule;
            _originalDeletionTriggerMode = _deletionTriggerMode;
            _originalGracePeriodDays = _gracePeriodDays;
            _originalGracePeriodHours = _gracePeriodHours;
            _originalGracePeriodMinutes = _gracePeriodMinutes;
            _originalAuthoritativeSources = new HashSet<int>(_selectedAuthoritativeSources);

            _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.MetaverseObjectType, Id, 1, 1)).TotalResults;

            Snackbar.Add("Deletion rules saved successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            // The entity was mutated before the save was attempted; leaving it mutated would make a failed save look
            // like a successful one everywhere else on the page.
            RollBack();
            Snackbar.Add($"Failed to save deletion rules: {ex.Message}", Severity.Error);
        }
    }

