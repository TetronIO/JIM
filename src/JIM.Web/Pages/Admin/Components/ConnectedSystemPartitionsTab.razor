@* ─── Nothing retrieved yet: the only thing to say is how to start ─── *@
@if (ConnectedSystem.Partitions == null || ConnectedSystem.Partitions.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        <MudText>@string.Format(CultureInfo.CurrentCulture, SchemaText.RetrieveHierarchyIntro, PartitionAndHierarchyText)</MudText>
        <AlertButton Severity="Severity.Info" Disabled="@_hierarchyBeingRetrieved" OnClick="HandleImportHierarchyAsync" Class="mt-5">
            @if (_hierarchyBeingRetrieved)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">@SchemaText.RetrievingHierarchy</span>
            }
            else
            {
                <text>@SchemaText.RetrieveHierarchy</text>
            }
        </AlertButton>
    </MudAlert>
}
else
{
    @* ─── What this system currently imports, before anything about how to change it ─── *@
    <MudPaper Outlined="true" Class="pa-4">
        <div class="jim-scope-summary" data-testid="jim-scope-summary">
            <div class="jim-scope-stat">
                <span class="jim-scope-stat-value">@string.Format(CultureInfo.CurrentCulture, SchemaText.ValueOfTotal, SelectedContainerCount, TotalContainerCount)</span>
                <span class="jim-scope-stat-label">@SchemaText.ContainersSelected</span>
            </div>
            <div class="jim-scope-stat">
                <span class="jim-scope-stat-value">@string.Format(CultureInfo.CurrentCulture, SchemaText.ValueOfTotal, SelectedPartitionCount, ConnectedSystem.Partitions.Count)</span>
                <span class="jim-scope-stat-label">@PluralRules.Choose(ConnectedSystem.Partitions.Count, SchemaText.PartitionsManagedOne, SchemaText.PartitionsManagedOther)</span>
            </div>
            @* Only where there are any: a permanent "0 excluded" would sit on every Connected System that has never
               carved anything out, which is most of them, saying nothing. Where there are exclusions the selected count
               alone overstates what is imported, so the figure has to appear beside it. *@
            @if (ExcludedContainerCount > 0)
            {
                <div class="jim-scope-stat" data-testid="jim-scope-excluded">
                    <span class="jim-scope-stat-value">@ExcludedContainerCount</span>
                    <span class="jim-scope-stat-label">@PluralRules.Choose(ExcludedContainerCount, SchemaText.ContainersExcludedOne, SchemaText.ContainersExcludedOther)</span>
                </div>
            }
        </div>

        @* ─── When the hierarchy was last read, and how to read it again; what a refresh does is in the info button ─── *@
        <div class="jim-scope-hint mt-4" data-testid="jim-scope-hint">
            <MudIcon Icon="@Icons.Material.Filled.Sync" Size="Size.Small" />
            <span>
                @if (_hierarchyRetrievedAt.HasValue)
                {
                    var retrievedAt = _hierarchyRetrievedAt.Value;
                    <MudTooltip Arrow="true" Placement="Placement.Top" Text="@retrievedAt.ToLocalTime().ToFriendlyDate()">
                        @string.Format(CultureInfo.CurrentCulture, SchemaText.HierarchyLastRetrieved, retrievedAt.ToLocalTime().ToRelativeTime())
                    </MudTooltip>
                }
                else
                {
                    <text>@string.Format(CultureInfo.CurrentCulture, SchemaText.HierarchyAsRetrievedFrom, ConnectedSystem.Name)</text>
                }
            </span>
            <InfoPopover Title="@SchemaText.RefreshingHierarchyTitle">
                @SchemaText.RefreshHierarchyInfo
                
                
                
                
            </InfoPopover>
            <MudButton Variant="Variant.Filled" Size="Size.Small" Disabled="@_hierarchyBeingRetrieved"
                       OnClick="HandleImportHierarchyAsync" DropShadow="false" Class="ms-auto" data-testid="jim-hierarchy-refresh">
                @if (_hierarchyBeingRetrieved)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <span class="ms-2">@SchemaText.Refreshing</span>
                }
                else
                {
                    <text>@SchemaText.RefreshButton</text>
                }
            </MudButton>
        </div>
    </MudPaper>
}

@* Hierarchy Refresh Results Panel *@
@if (_hierarchyRefreshResult != null && _hierarchyRefreshResult.HasChanges)
{
    <MudExpansionPanels Class="mt-4" Elevation="0">
        <MudExpansionPanel Expanded="false">
            <TitleContent>
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Sync" />
                    <MudText Typo="Typo.body1">
                        @string.Format(CultureInfo.CurrentCulture, SchemaText.HierarchyRefreshedSummary, _hierarchyRefreshResult.GetSummary())
                    </MudText>
                    @if (_hierarchyRefreshResult.HasSelectedItemsRemoved)
                    {
                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">
                            @SchemaText.SelectedItemsRemoved
                        </MudChip>
                    }
                    @if (_hierarchyRefreshResult.AffectedRunProfiles.Count > 0)
                    {
                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">
                            @SchemaText.RunProfilesDisabled
                        </MudChip>
                    }
                    @if (_hierarchyRefreshResult.PartitionsSelectedForMovedContainers.Count > 0)
                    {
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Text">
                            @SchemaText.PartitionsSelected
                        </MudChip>
                    }
                </div>
            </TitleContent>
            <ChildContent>
                <div class="pa-4">
                    <div class="d-flex justify-end mb-3">
                        <MudButton StartIcon="@Icons.Material.Filled.ContentCopy"
                                   Variant="Variant.Filled"

                                   OnClick="CopyHierarchyChangesToClipboardAsync">
                            @SchemaText.CopyChanges
                        </MudButton>
                    </div>

                    @* Removed Items (show first if any were selected - important warning) *@
                    @if (_hierarchyRefreshResult.AffectedRunProfiles.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.PauseCircleOutline" Class="mr-1" Color="Color.Warning" />
                            @SchemaText.RunProfilesDisabled
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-4" Style="background: transparent;">
                            <thead>
                                <tr>
                                    <th>@SchemaText.RunProfileHeader</th>
                                    <th>@SchemaText.PartitionRemovedHeader</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var runProfile in _hierarchyRefreshResult.AffectedRunProfiles)
                                {
                                    <tr @key="runProfile.RunProfileId">
                                        <td>@runProfile.RunProfileName</td>
                                        <td><span class="jim-code-inline">@runProfile.PartitionName</span></td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    @* Partitions the refresh selected: it widened what JIM imports, so it says so *@
                    @if (_hierarchyRefreshResult.PartitionsSelectedForMovedContainers.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.CheckBox" Class="mr-1" Color="Color.Info" />
                            @SchemaText.PartitionsSelected
                        </MudText>
                        <MudText Class="mb-2">
                            @SchemaText.PartitionsSelectedExplain
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-4" Style="background: transparent;">
                            <thead>
                                <tr>
                                    <th>@SchemaText.PartitionNoun</th>
                                    <th>@SchemaText.ContainersMovedIn</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _hierarchyRefreshResult.PartitionsSelectedForMovedContainers)
                                {
                                    <tr @key="item.ExternalId">
                                        <td>@item.Name</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">
                                            @foreach (var containerExternalId in item.ContainerExternalIds)
                                            {
                                                <div>@containerExternalId</div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    @if (_hierarchyRefreshResult.RemovedPartitions.Count > 0 || _hierarchyRefreshResult.RemovedContainers.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-1" Color="Color.Error" />
                            @SchemaText.RemovedHeading
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-4" Style="background: transparent;">
                            <thead>
                                <tr>
                                    <th>@CommonText.ColumnType</th>
                                    <th>@CommonText.ColumnName</th>
                                    <th>@SchemaText.ColumnExternalId</th>
                                    <th>@SchemaText.WasSelected</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _hierarchyRefreshResult.RemovedPartitions)
                                {
                                    <tr class="@(item.WasSelected ? "mud-error-text" : "")">
                                        <td>@SchemaText.PartitionNoun</td>
                                        <td>@item.Name</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                        <td>
                                            @if (item.WasSelected)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Class="mr-1" />
                                                <text>@CommonText.Yes</text>
                                            }
                                            else
                                            {
                                                <text>@CommonText.No</text>
                                            }
                                        </td>
                                    </tr>
                                }
                                @foreach (var item in _hierarchyRefreshResult.RemovedContainers)
                                {
                                    <tr class="@(item.WasSelected ? "mud-error-text" : "")">
                                        <td>@SchemaText.ContainerNoun</td>
                                        <td>@item.Name</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                        <td>
                                            @if (item.WasSelected)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Class="mr-1" />
                                                <text>@CommonText.Yes</text>
                                            }
                                            else
                                            {
                                                <text>@CommonText.No</text>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    @* Added Items *@
                    @if (_hierarchyRefreshResult.AddedPartitions.Count > 0 || _hierarchyRefreshResult.AddedContainers.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-1" Color="Color.Success" />
                            @SchemaText.AddedHeading
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-4" Style="background: transparent;">
                            <thead>
                                <tr>
                                    <th>@CommonText.ColumnType</th>
                                    <th>@CommonText.ColumnName</th>
                                    <th>@SchemaText.ColumnExternalId</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _hierarchyRefreshResult.AddedPartitions)
                                {
                                    <tr>
                                        <td>@SchemaText.PartitionNoun</td>
                                        <td>@item.Name</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                    </tr>
                                }
                                @foreach (var item in _hierarchyRefreshResult.AddedContainers)
                                {
                                    <tr>
                                        <td>@SchemaText.ContainerNoun</td>
                                        <td>@item.Name</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    @* Renamed Items *@
                    @if (_hierarchyRefreshResult.RenamedPartitions.Count > 0 || _hierarchyRefreshResult.RenamedContainers.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-1" Color="Color.Info" />
                            @SchemaText.RenamedHeading
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-4" Style="background: transparent;">
                            <thead>
                                <tr>
                                    <th>@CommonText.ColumnType</th>
                                    <th>@SchemaText.OldName</th>
                                    <th>@SchemaText.NewName</th>
                                    <th>@SchemaText.ColumnExternalId</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _hierarchyRefreshResult.RenamedPartitions)
                                {
                                    <tr>
                                        <td>@SchemaText.PartitionNoun</td>
                                        <td>@item.OldName</td>
                                        <td>@item.NewName</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                    </tr>
                                }
                                @foreach (var item in _hierarchyRefreshResult.RenamedContainers)
                                {
                                    <tr>
                                        <td>@SchemaText.ContainerNoun</td>
                                        <td>@item.OldName</td>
                                        <td>@item.NewName</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@item.ExternalId</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }

                    @* Moved Containers *@
                    @if (_hierarchyRefreshResult.MovedContainers.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">
                            <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" Class="mr-1" Color="Color.Info" />
                            @SchemaText.MovedHeading
                        </MudText>
                        <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mb-4" Style="background: transparent;">
                            <thead>
                                <tr>
                                    <th>@CommonText.ColumnName</th>
                                    <th>@SchemaText.OldParent</th>
                                    <th>@SchemaText.NewParent</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _hierarchyRefreshResult.MovedContainers)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@DescribeMoveEnd(item.OldParentExternalId, item.OldPartitionExternalId)</td>
                                        <td style="font-family: monospace; font-size: 0.85em;">@DescribeMoveEnd(item.NewParentExternalId, item.NewPartitionExternalId)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </div>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@if (ConnectedSystem.Partitions is { Count: > 0 } && !ConnectedSystem.HasPartitionsOrContainersSelected())
{
    <MudAlert Severity="Severity.Warning" Class="mt-5">
        <MudText>
            <strong>@SchemaText.NoPartitionsSelectedLabel</strong> @string.Format(CultureInfo.CurrentCulture, SchemaText.NoPartitionsSelectedBody, ConnectedSystem.ConnectorDefinition.SupportsPartitionContainers ? SchemaText.AndContainerWithinPartition : string.Empty)
        </MudText>
    </MudAlert>
}

@* ─── Simple or Advanced: the same scope, edited as a tree or as text ─── *@
@if (ConnectedSystem.Partitions is { Count: > 0 } && ConnectedSystem.ConnectorDefinition.SupportsPartitionContainers)
{
    <div class="jim-scope-mode mt-6">
        <SegmentedToggle TValue="bool" Options="@ScopeModes" Value="@_advancedMode" ValueChanged="SetAdvancedMode"
                         AriaLabel="@SchemaText.ContainerScopeEditorLabel" TestId="jim-scope-mode" />
        <TermHint Term="Term.ContainerScope" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @(_advancedMode
                ? SchemaText.ScopeTextModeHelp
                : SchemaText.ScopeTreeModeHelp)
        </MudText>
    </div>
}

@if (_advancedMode)
{
    <MudPaper Class="pa-4 mt-6" Outlined="true">
        <MudTextField T="string" @bind-Value="_advancedText" Immediate="true" Variant="Variant.Outlined"
                      Lines="10" Label="@SchemaText.ContainerScopeLabel" spellcheck="false"
                      Class="jim-scope-text" data-testid="jim-scope-text"
                      HelperText="@SchemaText.ScopeTextHelper" />

        @if (_advancedErrors.Count > 0)
        {
            @* Every problem at once, each tied to its line: an administrator correcting a scope of any size one
               round trip at a time is how a half-corrected text gets saved. *@
            <MudAlert Severity="Severity.Error" Class="mt-4" data-testid="jim-scope-text-errors">
                <MudText Class="mb-2"><strong>@SchemaText.ScopeNotApplied</strong> @SchemaText.NothingChanged</MudText>
                <ul class="jim-scope-text-error-list">
                    @foreach (var error in _advancedErrors)
                    {
                        <li>@string.Format(CultureInfo.CurrentCulture, SchemaText.ScopeErrorLine, error.LineNumber, error.Message)</li>
                    }
                </ul>
            </MudAlert>
        }

        <div class="d-flex align-center gap-4 mt-4">
            <MudButton Variant="Variant.Filled" DropShadow="false"
                       OnClick="ApplyAdvancedTextWithFeedback" data-testid="jim-scope-text-apply">
                @CommonText.Apply
            </MudButton>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @SchemaText.ScopeApplyingExplain
            </MudText>
        </div>
    </MudPaper>
}

@if (ConnectedSystem.Partitions is { Count: > 0 })
{
    @foreach (var partition in VisiblePartitions)
    {
        <MudPaper Class="mt-6" Outlined="true">
            <div class="jim-scope-partition-head">
                <span class="jim-scope-partition-name">@partition.Name</span>
                <MudSwitch T="bool" Value="@partition.Selected" ValueChanged="@(v => PartitionSelectedChanged(partition, v))"
                           Color="Color.Primary" Label="@SchemaText.ManagePartition" Class="ms-auto" />
            </div>

            @* Where this partition's next Delta Import starts (#2715); nothing for a deselected one *@
            <PartitionDeltaImportWatermark Partition="@partition" Watermarks="@PartitionWatermarks" />

            @if (partition.Selected && ConnectedSystem.ConnectorDefinition.SupportsPartitionContainers)
            {
                @* px-4 pb-4, not pa-4 pt-0: MudBlazor declares pa-4 after pt-0, so the pair kept a 16px top. *@
                <div class="px-4 pb-4">
                    @if (partition.Containers != null)
                    {
                        <ScopedHierarchyPicker Partition="@partition" OnChanged="OnSelectionEdited" />
                    }
                </div>
            }
        </MudPaper>
    }

    @* ─── Committing: what is pending, what it would do, and only then the button ─── *@
    <div class="jim-scope-actions mt-6">
        @if (_selectionEdited)
        {
            <span class="jim-scope-pending" data-testid="jim-scope-pending">
                <MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" />
                @SchemaText.UnsavedChangesImports
            </span>
        }
        else
        {
            <span class="jim-scope-pending jim-scope-pending-clean" data-testid="jim-scope-saved">
                @SchemaText.NoUnsavedChanges
            </span>
        }

        @* Preview (#1251): deselecting a container takes everything beneath it out of import scope, which obsoletes *@
        @* those objects, disconnects whatever they were joined to, and can leave Metaverse Objects with no          *@
        @* connectors at all. This is the count an administrator needs before saving, not afterwards.                *@
        <MudButton data-testid="jim-preview-scope-selection" Variant="Variant.Filled"
                   StartIcon="@Icons.Material.Filled.Visibility" OnClick="PreviewScopeSelectionAsync"
                   Disabled="@_startingPreview" DropShadow="false">
            @SchemaText.PreviewChanges
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="HandleHierarchySelectionSubmitAsync"
                   DropShadow="false" data-testid="jim-scope-save">
            @CommonText.SaveChanges
        </MudButton>
    </div>

    @if (_previewActivityId.HasValue)
    {
        var previewActivityId = _previewActivityId.Value;

        @if (ScopeSelectionPreviewIsStale)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-6"
                      data-testid="jim-preview-stale">
                @SchemaText.ScopePreviewStale
            </MudAlert>
        }

        <ConfigurationChangePreviewPanel ActivityId="@previewActivityId"
                                         Title="@SchemaText.ScopePreviewTitle"
                                         OnPreviewChanged="OnScopeSelectionPreviewChanged"
                                         OnClose="DiscardScopeSelectionPreview"
                                         Class="mt-6" />
    }
}

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [Parameter]
    public string? PartitionsAndHierarchiesText { get; set; }

    [Parameter]
    public string? PartitionAndHierarchyText { get; set; }

    [Parameter]
    public EventCallback OnConnectedSystemChanged { get; set; }

    /// <summary>
    /// Each partition's Delta Import watermark, by partition id (#2715), as read with the Connected System; null where its
    /// Connector keeps none per partition. The page reads them, so this tab reaches the application layer only to save.
    /// </summary>
    [Parameter]
    public IReadOnlyDictionary<int, DescribedPartitionWatermark>? PartitionWatermarks { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _hierarchyBeingRetrieved;
    private HierarchyRefreshResult? _hierarchyRefreshResult;
    private bool _selectionEdited;
    private DateTime? _hierarchyRetrievedAt;

    /// <summary>How many Containers across every partition are selected, for the summary above the tree.</summary>
    private int SelectedContainerCount =>
        (ConnectedSystem.Partitions ?? []).Sum(ContainerSelectionEditor.CountSelected);

    /// <summary>How many Containers are carved out of a selection, across every partition.</summary>
    private int ExcludedContainerCount =>
        (ConnectedSystem.Partitions ?? []).Sum(ContainerSelectionEditor.CountExcluded);

    private int TotalContainerCount =>
        (ConnectedSystem.Partitions ?? []).Sum(ContainerSelectionEditor.CountAll);

    private int SelectedPartitionCount => (ConnectedSystem.Partitions ?? []).Count(p => p.Selected);

    // ─── Configuration Change Preview (#1251) ───
    private Guid? _previewActivityId;
    private ConfigurationChangePreview? _preview;
    private ConnectedSystemScopeSelectionProposal? _previewedProposal;
    private bool _startingPreview;

    protected override void OnParametersSet()
    {
        ApplyContainerIncludedToPartitions(ConnectedSystem);
    }

    /// <summary>
    /// Records that the administrator has edited the selection, so the action bar can say there is something to save
    /// and the preview can report itself stale.
    /// </summary>
    private void OnSelectionEdited() => _selectionEdited = true;

    // ─── Advanced Mode (#1255): the same scope, stated as text ───

    private bool _advancedMode;
    private string _advancedText = string.Empty;
    private IReadOnlyList<ContainerScopeTextError> _advancedErrors = [];

    /// <summary>
    /// The partitions the tree renders. Empty in Advanced Mode, where the text is the editor.
    /// </summary>
    private IEnumerable<ConnectedSystemPartition> VisiblePartitions =>
        _advancedMode ? [] : ConnectedSystem.Partitions ?? [];

    /// <summary>
    /// Switches between editing the scope as a tree and editing it as text.
    /// </summary>
    /// <remarks>
    /// Leaving Advanced Mode applies the text rather than discarding it, because the text is the pending edit and
    /// dropping it on a click of "Simple" would lose work with nothing said. Where it cannot be applied the switch
    /// does not happen and the errors stand; the two modes express exactly the same scopes, so there is nothing an
    /// administrator can write here that the tree cannot then show them.
    /// </remarks>
    private static IReadOnlyList<SegmentedToggleOption<bool>> ScopeModes =>
    [
        new(false, SchemaText.ScopeSimple, "jim-scope-mode-simple"),
        new(true, SchemaText.ScopeAdvanced, "jim-scope-mode-advanced")
    ];

    private void SetAdvancedMode(bool advanced)
    {
        if (advanced == _advancedMode)
            return;

        if (advanced)
        {
            _advancedText = ContainerScopeText.Project(ConnectedSystem.Partitions ?? []);
            _advancedErrors = [];
            _advancedMode = true;
            return;
        }

        if (ApplyAdvancedText())
            _advancedMode = false;
    }

    private void ApplyAdvancedTextWithFeedback()
    {
        if (ApplyAdvancedText())
            Snackbar.Add(SchemaText.ScopeAppliedSave, Severity.Success);
    }

    /// <summary>
    /// Resolves the authored text against the hierarchy and applies it to the in-memory selection, exactly as
    /// ticking boxes in the tree does. Nothing is persisted here: the Save Changes button below owns that, so
    /// Advanced Mode inherits the confirmation, the preview link and the audit rather than having its own.
    /// </summary>
    private bool ApplyAdvancedText()
    {
        var partitions = ConnectedSystem.Partitions ?? [];
        var before = ContainerScopeText.Project(partitions);

        _advancedErrors = ContainerScopeText.Apply(_advancedText, partitions);
        if (_advancedErrors.Count > 0)
            return false;

        // Hand back what was actually applied, so the administrator sees the canonical form of what they wrote
        // rather than being left to wonder whether their shorthand was understood.
        _advancedText = ContainerScopeText.Project(partitions);

        if (_advancedText != before)
            OnSelectionEdited();

        return true;
    }

    /// <summary>
    /// Deselecting a partition takes every Container within it out of scope too, so its selections are cleared
    /// rather than left set behind an unmanaged partition, where they would say one thing and do another.
    /// </summary>
    private void PartitionSelectedChanged(ConnectedSystemPartition partition, bool selected)
    {
        partition.Selected = selected;

        if (!selected)
            ContainerSelectionEditor.ClearSelection(partition);

        OnSelectionEdited();
    }

    private async Task HandleImportHierarchyAsync()
    {
        // The refresh saves the hierarchy it reads and the page then reloads this Connected System, so a selection
        // edited but not saved is gone afterwards (#2743). Never without the administrator choosing it.
        var discardingEdits = _selectionEdited;
        if (discardingEdits && !await ConfirmDiscardingUnsavedEditsAsync())
            return;

        // attribute the import to the user
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        _hierarchyBeingRetrieved = true;
        _hierarchyRefreshResult = null; // Clear previous result
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            // By id: the refresh loads and saves its own change-tracked copy (#2743). The page reloads this tab's
            // Connected System afterwards (OnConnectedSystemChanged below), so the tab shows what was saved.
            //
            // Asked to cancel first (#2740): a refresh that would remove a partition a Run Profile targets then saves
            // nothing, and the administrator chooses. Disabling those Run Profiles refreshes again; cancelling leaves
            // everything, the unsaved selection edits included, as it was.
            _hierarchyRefreshResult = await jim.ConnectedSystems.ImportConnectedSystemHierarchyAsync(ConnectedSystem.Id, user, RemovedPartitionRunProfileAction.Cancel);

            if (!_hierarchyRefreshResult.Applied)
            {
                var affected = _hierarchyRefreshResult.AffectedRunProfiles;
                _hierarchyRefreshResult = null;
                if (!await RemovedPartitionRunProfilesDialog.ShowAsync(DialogService, affected))
                {
                    Snackbar.Add(SchemaText.RefreshCancelled, Severity.Info);
                    return;
                }

                _hierarchyRefreshResult = await jim.ConnectedSystems.ImportConnectedSystemHierarchyAsync(ConnectedSystem.Id, user, RemovedPartitionRunProfileAction.Disable);
            }

            if (_hierarchyRefreshResult.Success)
            {
                _hierarchyRetrievedAt = DateTime.UtcNow;

                if (_hierarchyRefreshResult.AffectedRunProfiles.Count > 0)
                {
                    var count = _hierarchyRefreshResult.AffectedRunProfiles.Count;
                    Snackbar.Add(string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(count, SchemaText.RefreshedDisabledOne, SchemaText.RefreshedDisabledOther), count), Severity.Warning);
                }
                else if (_hierarchyRefreshResult.HasSelectedItemsRemoved)
                {
                    Snackbar.Add(SchemaText.RefreshedWithWarnings, Severity.Warning);
                }
                else if (_hierarchyRefreshResult.PartitionsSelectedForMovedContainers.Count > 0)
                {
                    // A refresh that widened what JIM imports says why, not only that it did.
                    Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.RefreshedKeepInScope, _hierarchyRefreshResult.GetSummary()), Severity.Info);
                }
                else if (_hierarchyRefreshResult.HasChanges)
                {
                    Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.HierarchyRefreshedSummary, _hierarchyRefreshResult.GetSummary()), Severity.Success);
                }
                else
                {
                    Snackbar.Add(SchemaText.RefreshedNoChanges, Severity.Info);
                }
            }
            else
            {
                Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.RefreshFailed, _hierarchyRefreshResult.ErrorMessage), Severity.Error);
            }

            // The reload below replaces the edited selection with the saved one, so there is nothing left unsaved,
            // and a preview of the edits no longer describes anything.
            if (discardingEdits)
            {
                _selectionEdited = false;
                DiscardScopeSelectionPreview();
            }

            await OnConnectedSystemChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to import hierarchy for Connected System {ConnectedSystemId}", ConnectedSystem.Id);
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.RetrieveFailed, ex.ToDisplayText()), Severity.Error);
        }
        finally
        {
            _hierarchyBeingRetrieved = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Asks whether to refresh the hierarchy at the cost of the selection edits not yet saved.
    /// </summary>
    /// <returns>True to discard the edits and refresh; false to keep them.</returns>
    private async Task<bool> ConfirmDiscardingUnsavedEditsAsync() =>
        await DialogService.ShowMessageBoxAsync(
            SchemaText.DiscardUnsavedTitle,
            SchemaText.DiscardUnsavedBody,
            yesText: SchemaText.DiscardAndRefresh,
            cancelText: CommonText.Cancel) == true;

    private async Task CopyHierarchyChangesToClipboardAsync()
    {
        if (_hierarchyRefreshResult == null)
            return;

        var sb = new StringBuilder();
        sb.AppendLine(SchemaText.ClipboardTitle);
        sb.AppendLine(new string('=', 50));
        sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardSummary, _hierarchyRefreshResult.GetSummary()));
        sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardTotalPartitions, _hierarchyRefreshResult.TotalPartitions));
        sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardTotalContainers, _hierarchyRefreshResult.TotalContainers));
        sb.AppendLine();

        if (_hierarchyRefreshResult.AffectedRunProfiles.Count > 0)
        {
            sb.AppendLine(SchemaText.ClipboardRunProfilesDisabled);
            foreach (var runProfile in _hierarchyRefreshResult.AffectedRunProfiles)
                sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardRunProfile, runProfile.RunProfileName, runProfile.PartitionName));
            sb.AppendLine();
        }

        if (_hierarchyRefreshResult.PartitionsSelectedForMovedContainers.Count > 0)
        {
            sb.AppendLine(SchemaText.ClipboardPartitionsSelected);
            foreach (var item in _hierarchyRefreshResult.PartitionsSelectedForMovedContainers)
                sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardPartitionSelectedLine, item.Name, item.ExternalId, string.Join(", ", item.ContainerExternalIds)));
            sb.AppendLine();
        }

        if (_hierarchyRefreshResult.RemovedPartitions.Count > 0 || _hierarchyRefreshResult.RemovedContainers.Count > 0)
        {
            sb.AppendLine(SchemaText.ClipboardRemoved);
            foreach (var item in _hierarchyRefreshResult.RemovedPartitions)
                sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardRemovedPartition, item.Name, item.ExternalId, item.WasSelected ? SchemaText.ClipboardWasSelected : string.Empty));
            foreach (var item in _hierarchyRefreshResult.RemovedContainers)
                sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardRemovedContainer, item.Name, item.ExternalId, item.WasSelected ? SchemaText.ClipboardWasSelected : string.Empty));
            sb.AppendLine();
        }

        if (_hierarchyRefreshResult.AddedPartitions.Count > 0 || _hierarchyRefreshResult.AddedContainers.Count > 0)
        {
            sb.AppendLine(SchemaText.ClipboardAdded);
            foreach (var item in _hierarchyRefreshResult.AddedPartitions)
                sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardPartitionLine, item.Name, item.ExternalId));
            foreach (var item in _hierarchyRefreshResult.AddedContainers)
                sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardContainerLine, item.Name, item.ExternalId));
            sb.AppendLine();
        }

        if (_hierarchyRefreshResult.RenamedPartitions.Count > 0 || _hierarchyRefreshResult.RenamedContainers.Count > 0)
        {
            sb.AppendLine(SchemaText.ClipboardRenamed);
            foreach (var item in _hierarchyRefreshResult.RenamedPartitions)
                sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardRenamedPartition, item.OldName, item.NewName, item.ExternalId));
            foreach (var item in _hierarchyRefreshResult.RenamedContainers)
                sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardRenamedContainer, item.OldName, item.NewName, item.ExternalId));
            sb.AppendLine();
        }

        if (_hierarchyRefreshResult.MovedContainers.Count > 0)
        {
            sb.AppendLine(SchemaText.ClipboardMoved);
            foreach (var item in _hierarchyRefreshResult.MovedContainers)
                sb.AppendLine(string.Format(CultureInfo.CurrentCulture, SchemaText.ClipboardMovedContainer, item.Name, DescribeMoveEnd(item.OldParentExternalId, item.OldPartitionExternalId), DescribeMoveEnd(item.NewParentExternalId, item.NewPartitionExternalId)));
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
            Snackbar.Add(SchemaText.ChangesCopied, Severity.Success);
        }
        catch
        {
            Snackbar.Add(SchemaText.ChangesCopyFailed, Severity.Warning);
        }
    }

    /// <summary>
    /// Where a moved Container came from or went to: its parent Container; or, at the top level of a Partition it moved
    /// into or out of, that Partition; or "(root)", at the top level of the Partition it stayed in.
    /// </summary>
    private static string DescribeMoveEnd(string? parentExternalId, string? partitionExternalId) =>
        parentExternalId ?? partitionExternalId ?? SchemaText.ClipboardRoot;

    private async Task HandleHierarchySelectionSubmitAsync()
    {
        // attribute the action to the user
        using var jim = JimFactory.Create();

        // deselecting a partition takes everything imported from it out of scope, which obsoletes those objects and
        // deprovisions whatever they are joined to. The acknowledgement says so, and where a preview was run it
        // says how many objects that is (#1251).
        var preflight = await jim.ConfigurationChangePreflight.EvaluateConnectedSystemAsync(ConnectedSystem);
        if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                SchemaText.ConnectedSystemTermName, ConnectedSystem.Name,
                ConfigurationChangePreviewCounts.ForConfirmation(_preview, ScopeSelectionPreviewIsStale),
                ConfigurationChangePreviewCounts.ForConfirmationVerdict(_preview, ScopeSelectionPreviewIsStale)))
            return;

        // The preview is linked only when it actually describes this change. A link to a preview run against a
        // different selection would make the audit assert something untrue about what the administrator read.
        var previewActivityId = ScopeSelectionPreviewIsStale ? null : _previewActivityId;

        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.ConnectedSystems.UpdateConnectedSystemAsync(ConnectedSystem, user, previewActivityId: previewActivityId);
        DiscardScopeSelectionPreview();
        _selectionEdited = false;
        Snackbar.Add(SchemaText.HierarchySaved, Severity.Success);
        await OnConnectedSystemChanged.InvokeAsync();
    }

    // ─── Configuration Change Preview (#1251) ───

    /// <summary>
    /// The selection currently ticked in the tree, as the preview framework's proposal type.
    /// </summary>
    /// <remarks>
    /// Read from the loaded Connected System because the tree edits its <c>Selected</c> flags in place, so the
    /// in-memory graph *is* what the administrator is about to save. The adapter loads its own copy from the
    /// database for the "before" side, which is why handing it this graph directly would have it compare the
    /// proposal against itself.
    /// </remarks>
    private ConnectedSystemScopeSelectionProposal BuildScopeSelectionProposal() =>
        ConnectedSystemScopeSelectionProposal.FromCurrentSelection(ConnectedSystem);

    /// <summary>
    /// Whether the tree has moved on from the selection the visible preview was run against.
    /// </summary>
    private bool ScopeSelectionPreviewIsStale =>
        _previewedProposal is not null && !BuildScopeSelectionProposal().DescribesSameSelectionAs(_previewedProposal);

    private async Task PreviewScopeSelectionAsync()
    {
        if (_startingPreview)
            return;

        _startingPreview = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var proposal = BuildScopeSelectionProposal();

            // The starter, not StartAndDispatchPreviewAsync: it owns the question of whether a large preview keeps
            // every drill-down row, and that decision belongs in one place rather than at each surface.
            var activityId = await PreviewStarter.StartAsync(new ConfigurationChangePreviewRequest
            {
                Surface = ConfigurationChangePreviewSurface.ConnectedSystem,
                TargetId = ConnectedSystem.Id,
                TargetName = ConnectedSystem.Name,
                ProposedConfiguration = proposal,
                InitiatedByType = ActivityInitiatorType.User,
                InitiatedById = user?.Id,
                InitiatedByName = user?.Name
            });

            // Null means the administrator declined the data-set size question, which is a decision not to preview.
            if (activityId == null)
                return;

            _previewActivityId = activityId;
            _previewedProposal = proposal;
            _preview = null;
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            DiscardScopeSelectionPreview();
            Log.Error(ex, "Failed to start a partition and container selection preview for Connected System {ConnectedSystemId}", ConnectedSystem.Id);
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewStartFailed, ex.Message), Severity.Error);
        }
        finally
        {
            _startingPreview = false;
        }
    }

    /// <summary>
    /// Records the panel's latest read of the preview, for the save confirmation to state.
    /// </summary>
    /// <remarks>
    /// Deliberately does not call <c>StateHasChanged</c>, for the reason recorded on the pilot surface: the panel
    /// re-reads on every parameter set, so re-rendering here would set its parameters again, refresh again, and
    /// raise this again, cancelling and restarting its reconciliation poll on every pass so the panel never leaves
    /// stage 1. Nothing rendered here depends on this value, so storing it is enough.
    /// </remarks>
    private void OnScopeSelectionPreviewChanged(ConfigurationChangePreview? preview) => _preview = preview;

    private void DiscardScopeSelectionPreview()
    {
        _previewActivityId = null;
        _previewedProposal = null;
        _preview = null;
    }

    private static void ApplyContainerIncludedToPartitions(ConnectedSystem connectedSystemInQuestion)
    {
        if (connectedSystemInQuestion.Partitions == null)
            return;

        // The coverage rule lives with the one the import applies, so the tree cannot show one scope while the
        // import performs another.
        foreach (var partition in connectedSystemInQuestion.Partitions)
            ConnectedSystemUtilities.ApplyContainerInclusion(partition);
    }

}
