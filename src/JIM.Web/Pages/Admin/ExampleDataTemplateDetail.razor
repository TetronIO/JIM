<PageTitle>Data Generation Template: @_template?.Name</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>Data Generation Template:</span> <span class="mud-primary-text">@_template?.Name</span></MudText>
<div class="d-flex justify-space-between align-center">
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
    @if (_template != null)
    {
        <AuditInfo Entity="@_template" />
    }
</div>

@if (_template != null)
{
    <NavigableMudTabs Class="mt-2" TabPanelsClass="pa-0">

        <MudTabPanel Text="Details">
    @* One virtualised grid per Metaverse Object Type in the template. The object type's name is the heading above
       its grid rather than a toolbar title, because the grid's toolbar belongs to the density toggle, the count and
       the search box. Each grid's URL parameters are prefixed with its own object type id, so several grids on this
       page cannot overwrite each other's search, sort and scroll state. The attributes are already loaded with the
       template, so the window is sliced from memory. *@
    @foreach (var objectType in _template.ObjectTypes)
    {
        <MudText Typo="Typo.h6" Class="mt-5">@objectType.MetaverseObjectType.Name</MudText>
        <VirtualisedDataGrid @key="objectType.Id" T="ExampleDataTemplateAttribute"
                             ContainerId="@($"template-attributes-{objectType.Id}")"
                             UrlParameterPrefix="@($"ot{objectType.Id}-")"
                             DefaultSortBy="attribute"
                             LoadWindow="@((request, token) => LoadTemplateAttributeWindowAsync(objectType, request, token))"
                             SingularName="Template Attribute"
                             PluralName="Template Attributes"
                             SearchPlaceholder="Search attributes">
            <Columns>
                <TemplateColumn Title="Attribute" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Attribute" Name="attribute" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.MetaverseAttribute?.Name
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Type" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Type" Name="type" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.MetaverseAttribute?.Type
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Population %" Sortable="false" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Population %" Name="population" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.PopulatedValuesPercentage
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Rules" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Rules</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @* A row in a virtualised grid is one line, and an attribute can carry half a dozen
                           generation rules, so the first is shown and the rest open in a dialog. Which rules an
                           attribute has is decided in GetGenerationRules rather than here, so the cell and the
                           dialog cannot draw two different sets. *@
                        <OverflowList TItem="KeyValuePair<string, string>" Items="@GetGenerationRules(context.Item)" Title="Rules">
                            <ItemTemplate Context="rule">
                                <MudChip T="string" Color="Color.Primary" Variant="Variant.Text"><b>@rule.Key:</b>&nbsp;@rule.Value</MudChip>
                            </ItemTemplate>
                        </OverflowList>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@($"No Template Attributes match \"{grid.SearchText}\"")"
                                     SecondaryText="Try a different search term, or clear the search."
                                     ActionText="Clear Search"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.Science"
                                     PrimaryText="No Template Attributes are configured for this Metaverse Object Type"
                                     SecondaryText="Nothing will be generated for this type until the Data Generation Template gives it at least one attribute." />
                }
            </EmptyContent>
        </VirtualisedDataGrid>
    }

    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
    <MudText Typo="Typo.h6">Warning</MudText>
    <MudText>
        Executing this template will cause example data to be inserted into the Metaverse. It's not recommended to do this on a system with Connectors and that is already initialised.
        This feature is primarily designed to enable demo or proof of concept work. There is no easy way to undo this once performed.
    </MudText>
    <MudButton Class="mt-5"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.BuildCircle"
               Color="Color.Warning"
               Disabled="@(_status != null || _isExecuting)"
               OnClick="ExecuteTemplateAsync"
               DropShadow="false">
        @if (_status is WorkerTaskStatus.Processing)
        {
            <text>Processing...</text>
        }
        else if (_status is WorkerTaskStatus.Queued)
        {
            <text>Queued...</text>
        }
        else
        {
            <text>Execute Template</text>
        }
    </MudButton>
    </MudAlert>

    @if (_workerTask != null)
    {
        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" Class="mb-2">Data generation progress</MudText>
            <WorkerTaskProgress Status="@_workerTask.Status" ObjectsToProcess="@_workerTask.ObjectsToProcess" ObjectsProcessed="@_workerTask.ObjectsProcessed" ProgressMessage="@_workerTask.ProgressMessage" />
        </MudPaper>
    }
    else if (_completedActivity != null)
    {
        var completed = _completedActivity;
        <MudPaper Outlined="true" Class="pa-4 mt-4">
            <MudText Typo="Typo.h6" Class="mb-2">Data generation progress</MudText>
            @if (completed.Status is ActivityStatus.Complete or ActivityStatus.CompleteWithWarning)
            {
                <MudProgressLinear Value="100" Color="Color.Success" Rounded="true" />
                <div class="d-flex align-center mt-3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mr-2" />
                    <MudText Typo="Typo.body2">Generation complete: @completed.TotalCreated.ToString("N0") objects created.</MudText>
                </div>
                @if (completed.Status == ActivityStatus.CompleteWithWarning && !string.IsNullOrEmpty(completed.Message))
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">@completed.Message</MudText>
                }
            }
            else if (completed.Status == ActivityStatus.Cancelled)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-1">Generation was cancelled. <MudLink Href="@($"/activity/{completed.Id}")">View details</MudLink></MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-1">Generation failed@(string.IsNullOrEmpty(completed.Message) ? "." : $": {completed.Message}") <MudLink Href="@($"/activity/{completed.Id}")">View details</MudLink></MudAlert>
            }
        </MudPaper>
    }
        </MudTabPanel>

        <MudTabPanel Text="Changes" BadgeData="@(_changeCount > 0 ? _changeCount.ToString("N0") : null)" BadgeColor="Color.Primary">
            <ConfigurationChangesTab TargetType="ActivityTargetType.ExampleDataTemplate" ObjectId="@_template.Id" ObjectTypeLabel="Example Data Template" />
        </MudTabPanel>

    </NavigableMudTabs>
}

@code {
    /// <summary>
    /// The generation rules configured on one Template Attribute, as label/value pairs, in the order they read
    /// in: which rules apply depends on the Metaverse Attribute's data type, and only those actually set are
    /// returned. Built here rather than in the markup so the cell and the dialog behind its "+n more" affordance
    /// cannot draw two different sets.
    /// </summary>
    private static List<KeyValuePair<string, string>> GetGenerationRules(ExampleDataTemplateAttribute attribute)
    {
        var rules = new List<KeyValuePair<string, string>>();

        void Add(string label, string value) => rules.Add(new KeyValuePair<string, string>(label, value));

        switch (attribute.MetaverseAttribute?.Type)
        {
            case AttributeDataType.Text:
                if (!string.IsNullOrEmpty(attribute.Pattern))
                    Add("Pattern", attribute.Pattern);

                if (!string.IsNullOrEmpty(attribute.Expression))
                    Add("Expression", attribute.Expression);

                if (attribute.ExampleDataSetInstances is { Count: > 0 })
                    Add("Data set(s)", string.Join(", ", attribute.ExampleDataSetInstances.Select(set => set.ExampleDataSet.Name)));

                if (attribute.MinNumber.HasValue)
                    Add("Min", attribute.MinNumber.Value.ToString("N0"));

                if (attribute.MaxNumber.HasValue)
                    Add("Max", attribute.MaxNumber.Value.ToString("N0"));

                if (attribute.WeightedStringValues is { Count: > 0 })
                    Add("Weighted Values", string.Join(", ", attribute.WeightedStringValues.Select(wsv => $"{wsv.Value}: {wsv.Weight}")));

                break;

            case AttributeDataType.Number:
            case AttributeDataType.LongNumber:
            case AttributeDataType.Decimal:
                if (attribute.MinNumber.HasValue)
                    Add("Min", attribute.MinNumber.Value.ToString("N0"));

                if (attribute.MaxNumber.HasValue)
                    Add("Max", attribute.MaxNumber.Value.ToString("N0"));

                if (attribute.SequentialNumbers.HasValue)
                    Add("Sequential", attribute.SequentialNumbers.Value.ToString());

                if (attribute.RandomNumbers.HasValue)
                    Add("Random numbers", attribute.RandomNumbers.Value.ToString());

                break;

            case AttributeDataType.Boolean:
                if (attribute.BoolShouldBeRandom.HasValue)
                    Add("Random", attribute.BoolShouldBeRandom.Value.ToString());

                if (attribute.BoolTrueDistribution.HasValue)
                    Add("True distribution", attribute.BoolTrueDistribution.Value.ToString("N0"));

                break;

            case AttributeDataType.DateTime:
                if (attribute.MinDate.HasValue)
                    Add("Min", attribute.MinDate.Value.ToShortDateString());

                if (attribute.MaxDate.HasValue)
                    Add("Max", attribute.MaxDate.Value.ToShortDateString());

                break;

            case AttributeDataType.Reference:
                if (attribute.MvaRefMinAssignments.HasValue)
                    Add("MVA min assignments", attribute.MvaRefMinAssignments.Value.ToString("N0"));

                if (attribute.MvaRefMaxAssignments.HasValue)
                    Add("MVA max assignments", attribute.MvaRefMaxAssignments.Value.ToString("N0"));

                if (attribute.ReferenceMetaverseObjectTypes is { Count: > 0 })
                    Add("Reference type(s)", string.Join(", ", attribute.ReferenceMetaverseObjectTypes.Select(refType => refType.Name)));

                if (attribute.ManagerDepthPercentage.HasValue)
                    Add("Manager depth", $"{attribute.ManagerDepthPercentage.Value}%");

                break;
        }

        return rules;
    }

    [Parameter]
    public int Id { get; set; }
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private ExampleDataTemplate? _template;
    private ExampleDataTemplateWorkerTask? _task;
    private WorkerTaskHeader? _workerTask;
    private WorkerTaskStatus? _status;
    // The Activity id of the task while it is running, captured so its outcome can be shown once it completes.
    private Guid? _activeActivityId;
    // The completed Activity, left in place after the task finishes so the progress panel shows the result
    // rather than disappearing. Only set for a run observed to complete during this page session.
    private Activity? _completedActivity;
    private bool _isExecuting;
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private int _changeCount;
    private Timer? _statusPollTimer;
    private readonly SemaphoreSlim _refreshLock = new(1, 1);

    /// <summary>
    /// Slices one window of a Metaverse Object Type's Template Attributes, applying the grid's search (attribute
    /// name) and sort. The template is loaded whole with its attributes, so there is no database range read; an
    /// attribute with no Metaverse Attribute reads as an empty name for both search and sort rather than being
    /// dropped, so a malformed row stays visible to whoever has to fix it.
    /// </summary>
    private Task<VirtualisedWindow<ExampleDataTemplateAttribute>> LoadTemplateAttributeWindowAsync(
        ExampleDataObjectType objectType, VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<ExampleDataTemplateAttribute> attributes = objectType.TemplateAttributes;

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            attributes = attributes.Where(a =>
                a.MetaverseAttribute?.Name.Contains(search, StringComparison.OrdinalIgnoreCase) == true);
        }

        IOrderedEnumerable<ExampleDataTemplateAttribute> Order<TKey>(Func<ExampleDataTemplateAttribute, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? attributes.OrderByDescending(key, comparer) : attributes.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "type" => Order(a => a.MetaverseAttribute?.Type ?? AttributeDataType.NotSet),
            "population" => Order(a => a.PopulatedValuesPercentage ?? 0),
            _ => Order(a => a.MetaverseAttribute?.Name ?? string.Empty, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _template = await jim.ExampleData.GetTemplateAsync(Id);
        if (_template == null)
        {
            // template not found, redirect to index page
            NavManager.NavigateTo("../");
            return;
        }

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("Home", href: "/", icon: Icons.Material.Filled.Home),
            new("Administration", href: "/admin"),
            new("Example Data", href: "/admin/example-data/"),
            new(_template.Name, href: null, disabled: true)
        };

        _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.ExampleDataTemplate, _template.Id, 1, 1)).TotalResults;

        // Has this template already been scheduled, or is it already being processed on the service queue?
        // Event-driven refresh (issue #307): a Worker Task change notification triggers an immediate
        // status refresh, and an Activity progress notification refreshes the live progress bar as objects
        // are generated and persisted; the timer is the polling fallback, re-armed each cycle at 2 seconds
        // while real-time notifications are unavailable or 30 seconds (a reconciliation safety net) while
        // they are flowing.
        UiNotifications.WorkerTaskChanged += OnWorkerTaskChanged;
        UiNotifications.ActivityProgressChanged += OnActivityProgressChanged;
        UiNotifications.RealTimeAvailabilityChanged += OnRealTimeAvailabilityChanged;
        await RefreshWorkerTaskStatusAsync();
        _statusPollTimer = new Timer(async _ => await OnStatusPollTimerElapsedAsync(), null, GetPollingInterval(), Timeout.InfiniteTimeSpan);
    }

    public void Dispose()
    {
        UiNotifications.WorkerTaskChanged -= OnWorkerTaskChanged;
        UiNotifications.ActivityProgressChanged -= OnActivityProgressChanged;
        UiNotifications.RealTimeAvailabilityChanged -= OnRealTimeAvailabilityChanged;
        _statusPollTimer?.Dispose();
        _statusPollTimer = null;
    }

    private TimeSpan GetPollingInterval()
    {
        return UiNotifications.IsRealTimeAvailable ? TimeSpan.FromSeconds(30) : TimeSpan.FromSeconds(2);
    }

    private async Task OnStatusPollTimerElapsedAsync()
    {
        try
        {
            await RefreshWorkerTaskStatusAsync();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Transient refresh failures are recoverable; the next timer cycle retries
        }
        finally
        {
            // Re-arm the one-shot timer with the interval for the current real-time availability
            try
            {
                _statusPollTimer?.Change(GetPollingInterval(), Timeout.InfiniteTimeSpan);
            }
            catch (ObjectDisposedException)
            {
                // The component was disposed while this callback was running; nothing to re-arm
            }
        }
    }

    private void OnWorkerTaskChanged(WorkerTaskChangeNotification notification) => TriggerNotificationRefresh();

    // An Activity progress update (objects generated/persisted, message changed) moves the live progress bar.
    private void OnActivityProgressChanged(Guid activityId) => TriggerNotificationRefresh();

    // On reconnection, refresh immediately to reconcile anything missed while real-time was unavailable.
    private void OnRealTimeAvailabilityChanged(bool available) => TriggerNotificationRefresh();

    /// <summary>
    /// Runs a status refresh in response to a notification. Event handlers run off the sync context and
    /// must never throw into the notification relay, so failures are swallowed; the timer fallback retries.
    /// </summary>
    private void TriggerNotificationRefresh()
    {
        _ = Task.Run(async () =>
        {
            try
            {
                await RefreshWorkerTaskStatusAsync();
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                // Transient refresh failures are recoverable; the timer fallback covers the gap
            }
        });
    }

    /// <summary>
    /// Fetches the current Worker Task header (status plus live progress) for this template and re-renders
    /// only when the status or any progress field changed. Serves both the timer fallback and event-driven
    /// refreshes; overlapping invocations are skipped via a non-blocking semaphore.
    /// </summary>
    private async Task RefreshWorkerTaskStatusAsync()
    {
        if (_template == null)
            return;

        if (!await _refreshLock.WaitAsync(0))
            return;

        try
        {
            using var refreshJim = JimFactory.Create();
            var newWorkerTask = await refreshJim.Tasking.GetFirstExampleDataTemplateWorkerTaskHeaderAsync(_template.Id);
            var stateHasChanged = HasWorkerTaskChanged(_workerTask, newWorkerTask);

            // Capture the Activity id while the task is processing, so we can show its outcome once it completes.
            if (newWorkerTask?.ActivityId != null)
                _activeActivityId = newWorkerTask.ActivityId;

            // Task just finished (was active, now gone): fetch its completed Activity and leave the result in the
            // panel rather than letting it vanish. Only do this for a task we observed running (ActivityId captured).
            if (newWorkerTask == null && _workerTask != null && _activeActivityId != null)
            {
                _completedActivity = await refreshJim.Activities.GetActivityAsync(_activeActivityId.Value);
                _activeActivityId = null;
                stateHasChanged = true;
            }

            _workerTask = newWorkerTask;
            _status = newWorkerTask?.Status;

            // Reset the executing flag when the task completes (no active task remains)
            if (newWorkerTask == null && _isExecuting)
            {
                _isExecuting = false;
                stateHasChanged = true;
            }

            if (stateHasChanged)
                await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _refreshLock.Release();
        }
    }

    private static bool HasWorkerTaskChanged(WorkerTaskHeader? existing, WorkerTaskHeader? updated)
    {
        if (existing == null && updated == null)
            return false;
        if (existing == null || updated == null)
            return true;

        return existing.Status != updated.Status ||
               existing.ObjectsProcessed != updated.ObjectsProcessed ||
               existing.ObjectsToProcess != updated.ObjectsToProcess ||
               existing.ProgressMessage != updated.ProgressMessage;
    }

    private async Task ExecuteTemplateAsync()
    {
        if (_template == null || _isExecuting)
            return;

        // Immediately disable the button to prevent double-clicks
        _isExecuting = true;

        // Clear any previous run's result so the panel shows this run's progress, not the last outcome.
        _completedActivity = null;
        _activeActivityId = null;

        // attribute the execution to the user
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        _task = ExampleDataTemplateWorkerTask.ForUser(_template.Id, user.Id, user.NameOrId);
        var result = await jim.Tasking.CreateWorkerTaskAsync(_task);

        if (!result.Success)
        {
            _isExecuting = false;
            // Error would be shown elsewhere, but this task type shouldn't have validation errors
            return;
        }

        // Reflect the queued state immediately so the button and the progress panel update without waiting for
        // the first refresh; the next refresh replaces this with the real header carrying Activity progress.
        _status = WorkerTaskStatus.Queued;
        _workerTask = new WorkerTaskHeader { Status = WorkerTaskStatus.Queued, Name = _template.Name, Type = "Example Data Template" };
    }
}