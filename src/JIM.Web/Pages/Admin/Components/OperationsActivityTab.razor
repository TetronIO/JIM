@* The Operations page's Activity tab (#2549): what the worker has queued, what it is running and what it has finished,
   on one page in time order, later at the top. It replaced the Queue and History tabs, between which an administrator
   had to flick to see what the system was doing as a whole. *@

@* ─── Toolbar ─── *@
@* mt-5 rather than a tab-panel padding: the Operations page hands its tabs no top padding of their own, because
   the Schedules tab opens straight onto a grid that already supplies this same gap. *@
<div class="d-flex align-center flex-wrap gap-3 mt-5 mb-4">
    <MudText Typo="Typo.body2" Class="mud-text-secondary">Show</MudText>
    <MudChipSet T="ActivitySection" SelectionMode="SelectionMode.MultiSelection"
                SelectedValues="_sections.Selected()" SelectedValuesChanged="OnSectionsChangedAsync"
                CheckMark="true" Class="d-contents">
        <MudChip Value="ActivitySection.Queued" Variant="Variant.Text" Color="Color.Warning" SelectedColor="Color.Warning"
                 Icon="@Icons.Material.Filled.PendingActions" data-testid="toggle-queued">Queued @CountText(_queuedCount)</MudChip>
        <MudChip Value="ActivitySection.InProgress" Variant="Variant.Text" Color="Color.Info" SelectedColor="Color.Info"
                 Icon="@Icons.Material.Filled.Autorenew" data-testid="toggle-in-progress">In Progress @CountText(_runningCount)</MudChip>
        <MudChip Value="ActivitySection.Completed" Variant="Variant.Text" Color="Color.Success" SelectedColor="Color.Success"
                 Icon="@Icons.Material.Filled.TaskAlt" data-testid="toggle-completed">Completed</MudChip>
    </MudChipSet>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlaylistAdd"
               OnClick="QueueRunProfileAsync">Queue a Run Profile</MudButton>
</div>

@* ─── Filters ─── *@
@* They apply to every section shown, except Result and Has child activities, which only mean something for work
   that has finished. *@
<MudStack Row="true" Spacing="3" AlignItems="AlignItems.End" Class="flex-wrap mb-6">
    <MudItem Class="flex-grow-1">
        <MudSelect T="string" Label="Connected System" Variant="Variant.Outlined"
                   Dense="true" Clearable="true" MultiSelection="true"
                   SelectedValues="_filters.ConnectedSystems"
                   SelectedValuesChanged="@(values => SetFilters(_filters with { ConnectedSystems = values.ToList() }))"
                   MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectText))">
            @if (_filterOptions != null)
            {
                @foreach (var cs in _filterOptions.ConnectedSystems)
                {
                    <MudSelectItem T="string" Value="@cs">@cs</MudSelectItem>
                }
            }
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1">
        <MudSelect T="string" Label="Run Profile" Variant="Variant.Outlined"
                   Dense="true" Clearable="true" MultiSelection="true"
                   SelectedValues="_filters.RunProfiles"
                   SelectedValuesChanged="@(values => SetFilters(_filters with { RunProfiles = values.ToList() }))"
                   MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectText))">
            @if (_filterOptions != null)
            {
                @foreach (var rp in _filterOptions.RunProfiles)
                {
                    <MudSelectItem T="string" Value="@rp">@rp</MudSelectItem>
                }
            }
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1">
        <MudSelect T="Guid" Label="Schedule" Variant="Variant.Outlined"
                   Dense="true" Clearable="true" MultiSelection="true"
                   SelectedValues="_filters.Schedules"
                   SelectedValuesChanged="@(values => SetFilters(_filters with { Schedules = values.ToList() }))"
                   MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetScheduleMultiSelectText))">
            @if (_filterOptions != null)
            {
                @foreach (var schedule in _filterOptions.Schedules)
                {
                    <MudSelectItem T="Guid" Value="@schedule.Id">@schedule.Name</MudSelectItem>
                }
            }
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1">
        <MudSelect T="ActivityStatus" Label="Result" Variant="Variant.Outlined" HelperText="Completed only"
                   Dense="true" Clearable="true" MultiSelection="true" Disabled="@(!_sections.Completed)"
                   SelectedValues="_filters.Results"
                   SelectedValuesChanged="@(values => SetFilters(_filters with { Results = values.ToList() }))"
                   MultiSelectionTextFunc="@(new Func<IReadOnlyList<string>, string>(GetMultiSelectText))">
            <MudSelectItem T="ActivityStatus" Value="ActivityStatus.Complete">Complete</MudSelectItem>
            <MudSelectItem T="ActivityStatus" Value="ActivityStatus.CompleteWithWarning">Complete With Warning</MudSelectItem>
            <MudSelectItem T="ActivityStatus" Value="ActivityStatus.CompleteWithError">Complete With Error</MudSelectItem>
            <MudSelectItem T="ActivityStatus" Value="ActivityStatus.FailedWithError">Failed With Error</MudSelectItem>
            <MudSelectItem T="ActivityStatus" Value="ActivityStatus.Cancelled">Cancelled</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1">
        <SearchField Value="@_filters.InitiatedBy"
                     ValueChanged="@(text => SetFilters(_filters with { InitiatedBy = text }))"
                     Label="Initiated By"
                     Placeholder="Search by name..."
                     DebounceInterval="500"
                     Margin="Margin.None" />
    </MudItem>
    <MudItem Class="d-flex align-end">
        <MudCheckBox T="bool" Value="_filters.HasChildActivities" Disabled="@(!_sections.Completed)"
                     ValueChanged="@(value => SetFilters(_filters with { HasChildActivities = value }))"
                     Label="Has child activities" Dense="true" Class="mb-1 mud-typography-nowrap" />
    </MudItem>
    <MudItem Class="d-flex align-end">
        <MudCheckBox T="bool" Value="_filters.ScheduledOnly"
                     ValueChanged="@(value => SetFilters(_filters with { ScheduledOnly = value }))"
                     Label="Scheduled only" Dense="true" Class="mb-1 mud-typography-nowrap" />
    </MudItem>
</MudStack>

@* ─── Sections, later at the top ─── *@
<div class="d-flex flex-column gap-6">
    <OperationsQueueSections ShowQueued="_sections.Queued" ShowInProgress="_sections.InProgress"
                             Filters="_filters" ScheduleName="ScheduleNameFor" CountsChanged="OnCountsChanged" />

    @if (_sections.Completed)
    {
        <OperationsCompletedSection Filters="_filters" OnClearFilters="ClearFilters" />
    }

    @if (_sections.NothingSelected)
    {
        <MudPaper Outlined="true" Class="pa-6 d-flex justify-center">
            <MudText Class="mud-text-secondary">Nothing to show. Choose Queued, In Progress or Completed above.</MudText>
        </MudPaper>
    }
</div>

@code {
    private const string SectionsQueryParameter = "s";

    private ActivitySectionState _sections = ActivitySectionState.All;
    private OperationsActivityFilters _filters = OperationsActivityFilters.None;
    private ActivityFilterOptions? _filterOptions;
    private int? _queuedCount;
    private int? _runningCount;

    protected override async Task OnInitializedAsync()
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(NavigationManager.Uri).Query);
        _sections = ActivitySectionState.Parse(query[SectionsQueryParameter]);

        using var jim = JimFactory.Create();
        _filterOptions = await jim.Activities.GetWorkerTaskActivityFilterOptionsAsync();
    }

    private void SetFilters(OperationsActivityFilters filters) => _filters = filters;

    private void ClearFilters() => _filters = OperationsActivityFilters.None;

    private void OnCountsChanged((int Queued, int Running) counts)
    {
        _queuedCount = counts.Queued;
        _runningCount = counts.Running;
    }

    /// <summary>
    /// Applies the toggles and writes them to the URL in place, so the view can be bookmarked and survives a refresh
    /// without the navigation that would re-run the page's load.
    /// </summary>
    private async Task OnSectionsChangedAsync(IReadOnlyCollection<ActivitySection>? selected)
    {
        var chosen = selected ?? [];
        _sections = new ActivitySectionState(
            chosen.Contains(ActivitySection.Queued),
            chosen.Contains(ActivitySection.InProgress),
            chosen.Contains(ActivitySection.Completed));

        var uri = NavigationManager.GetUriWithQueryParameter(SectionsQueryParameter, _sections.ToQueryValue());
        try
        {
            await JS.InvokeVoidAsync("jimInterop.replaceQueryString", new Uri(uri).Query.TrimStart('?'));
        }
        catch (JSDisconnectedException)
        {
            // The circuit has gone; there is no URL left to update.
        }
    }

    private async Task QueueRunProfileAsync() => await QueueRunProfileDialog.ShowAsync(DialogService);

    private string? ScheduleNameFor(Guid scheduleId) => _filterOptions?.Schedules.FirstOrDefault(s => s.Id == scheduleId)?.Name;

    private static string CountText(int? count) => count is { } value ? value.ToString("N0") : string.Empty;

    private static string GetMultiSelectText(IReadOnlyList<string> selectedValues) => selectedValues.Count switch
    {
        0 => string.Empty,
        1 => selectedValues[0],
        _ => $"{selectedValues.Count} selected"
    };

    /// <summary>
    /// MultiSelectionTextFunc is typed against the string form of the selected values regardless of the select's T,
    /// so the Schedule select would otherwise render a raw GUID for a single selection. Map the id back to the
    /// Schedule's name via the loaded filter options.
    /// </summary>
    private string GetScheduleMultiSelectText(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues.Count == 0)
            return string.Empty;

        if (selectedValues.Count > 1)
            return $"{selectedValues.Count} selected";

        var schedule = _filterOptions?.Schedules.FirstOrDefault(s => s.Id.ToString() == selectedValues[0]);
        return schedule?.Name ?? selectedValues[0];
    }
}
