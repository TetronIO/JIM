@page "/admin"
@using JIM.Utilities
@using JIM.Web.Models
@attribute [Authorize(Roles = "Administrator")]
@inject NavigationManager NavManager
@inject IJimApplicationFactory JimFactory

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@LayoutText.NavAdministration</PageTitle>

<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />@LayoutText.NavAdministration</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
@* page-description: exempt - the Administration landing page orients a first-time visitor to the sections
   below; it is a directory of the admin area, not a page with a purpose of its own to explain. *@
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    @AdminText.AdminIntro
</MudText>

@* ─── Operations & Monitoring ─── *@
<MudText Typo="Typo.h5" Class="mt-8">@AdminText.AdminSectionOperations</MudText>
<MudGrid Class="mt-3" Spacing="4">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/operations"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                @* A red dot on the icon when a service is down or a task has stalled: the same verdict as the
                   banner's, read once when the index loads. The tile is the way to the strip that explains it. *@
                @if (_operationsNeedAttention)
                {
                    <MudTooltip Text="@AdminText.AdminOperationsAttention" Arrow="true" Placement="Placement.Top">
                        <MudBadge Dot="true" Color="Color.Error" Overlap="true">
                            <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Primary" />
                        </MudBadge>
                    </MudTooltip>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Primary" />
                }
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@AdminText.AdminTileOperations</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTileOperationsDesc</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/logs"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Custom.FileFormats.FileDocument" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@AdminText.LogsPageTitle</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTileLogsDesc</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo(Utilities.GetPendingDeletionsHref()))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.AutoDelete" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@AdminText.AdminTilePendingDeletions</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTilePendingDeletionsDesc</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@* ─── Identity Configuration ─── *@
<MudText Typo="Typo.h5" Class="mt-8">@AdminText.AdminSectionSyncConfig</MudText>
<MudGrid Class="mt-3" Spacing="4">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/connected-systems"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Cable" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@LayoutText.NavConnectedSystems</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTileConnectedSystemsDesc</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/sync-rules"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Sync" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@LayoutText.NavSynchronisationRules</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTileDefineFlow</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/schema"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Schema" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@AdminText.SchemaPageTitle</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTileSchemaDesc</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@* ─── Data Management ─── *@
<MudText Typo="Typo.h5" Class="mt-8">@AdminText.AdminSectionData</MudText>
<MudGrid Class="mt-3" Spacing="4">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/predefined-searches"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.SavedSearch" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@AdminText.AdminTilePredefinedSearches</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTilePredefinedSearchesDesc</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/example-data"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Science" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@AdminText.AdminTileExampleData</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTileExampleDataDesc</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/deleted-objects"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Delete" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@AdminText.AdminTileDeletedObjects</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTileDeletedObjectsDesc</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@* ─── Security & Settings ─── *@
<MudText Typo="Typo.h5" Class="mt-8">@AdminText.AdminSectionSecurity</MudText>
<MudGrid Class="mt-3" Spacing="4">
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/apikeys"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.Api" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@AdminText.ApiKeyPageTitle</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTileApiKeysDesc</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/certificates"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.EnhancedEncryption" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@AdminText.CertificateBreadcrumb</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTileCertificatesDesc</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/settings"))">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.DisplaySettings" Color="Color.Primary" />
                <MudText Typo="Typo.body1" Style="font-weight: 500;">@AdminText.AdminTileSettings</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTileSettingsDesc</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@* ─── Danger Zone (hidden by default; click the link to reveal destructive actions) ─── *@
<MudDivider Class="mt-8 mb-4" />
<div class="d-flex align-center cursor-pointer" style="width: fit-content;" @onclick="@(() => _dangerZoneExpanded = !_dangerZoneExpanded)">
    <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Color="Color.Error" Size="Size.Small" Class="me-2" />
    <MudText Typo="Typo.body2" Color="Color.Error" Style="font-weight: 500;">@AdminText.AdminTileDangerZone</MudText>
    <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Color="Color.Error" Size="Size.Small" Class="ms-1"
             Style="@($"transition: transform .25s ease; transform: rotate({(_dangerZoneExpanded ? "180" : "0")}deg);")" />
</div>
<MudCollapse Expanded="_dangerZoneExpanded">
    <MudGrid Class="mt-3" Spacing="4">
        <MudItem xs="12" sm="6" md="4">
            <MudPaper Class="pa-4 cursor-pointer jim-quick-link" Outlined="true" @onclick="@(() => NavManager.NavigateTo("/admin/factory-reset"))">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.RestartAlt" Color="Color.Error" />
                    <MudText Typo="Typo.body1" Style="font-weight: 500;">@AdminText.FactoryResetTitle</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AdminTileFactoryResetDesc</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudCollapse>

@code {
    private bool _dangerZoneExpanded;

    /// <summary>
    /// Whether the Operations tile carries its red dot. Read once on load; the index is a menu, not a monitor, and
    /// the banner above it is what keeps watching.
    /// </summary>
    private bool _operationsNeedAttention;

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        var report = await jim.SystemHealth.GetServiceHealthAsync(DateTime.UtcNow);
        _operationsNeedAttention = ServiceHealthDisplay.NeedsAttention(report);
    }

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
        new(LayoutText.NavAdministration, href: null, disabled: true)
    };
}
