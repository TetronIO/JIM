@* The Password tab of a person's page (#1119 requirement 25, #1635): what needs attention, the one action, what
   is still owed to a Connected System, and what each past change did, in that order.
   Two sources, deliberately. History comes from Activities, which are durable; outstanding work comes from the
   queue, which is not. The queue row is deleted the moment the password arrives, so a panel built on the queue
   alone would show this person's failures and none of their successes, which is the most misleading possible
   view of whether their password propagated.
   Takes its data and raises its actions rather than reaching the application layer, so the page owns the reads
   (and runs them only for readers allowed to see the tab) and the writes, and this component stays testable
   without a data layer behind it. *@

@if (Loading)
{
    <div class="d-flex justify-center pa-4">
        <MudProgressCircular Indeterminate="true" />
    </div>
}
else
{
    <MudStack Spacing="6">
        @* ─── Attention: what nothing will move without a person ─── *@
        @if (AttentionRows.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" data-testid="jim-password-attention">
                @* One row reads as one sentence pair with its action beside it; several get the headline and then a
                   line per row, so each Retry sits against the system it retries. *@
                @if (AttentionRows.Count > 1)
                {
                    <MudText Typo="Typo.body1">@AttentionHeadline</MudText>
                }
                @foreach (var change in AttentionRows)
                {
                    var connectedSystemId = change.ConnectedSystemId;
                    <div class="@(AttentionRows.Count > 1 ? "d-flex align-center flex-wrap mt-1" : "d-flex align-center flex-wrap")" style="gap: 0.5rem 1rem;" @key="change.Id">
                        <MudText Typo="Typo.body1">@(AttentionRows.Count > 1 ? DescribeAttention(change) : $"{AttentionHeadline} {DescribeAttention(change)}")</MudText>
                        @if (change.Status == PendingPasswordChangeStatus.Parked)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Inherit" DropShadow="false"
                                       StartIcon="@Icons.Material.Filled.Replay" Disabled="@Busy"
                                       OnClick="@(() => OnRetry.InvokeAsync(connectedSystemId))"
                                       data-testid="jim-password-attention-retry">Retry</MudButton>
                        }
                    </div>
                }
                <MudLink Href="@QueueHref" Class="d-inline-flex align-center mt-2" data-testid="jim-password-attention-queue">
                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="mr-1" />
                    Open in queue
                </MudLink>
            </MudAlert>
        }

        @* ─── Set Password: the one action ─── *@
        @* One card and one operation (#1635). Which accounts it reaches is chosen in the dialog; the coverage line
           here answers "will it reach everywhere?" before anything is typed. *@
        <MudPaper Class="pa-4" Outlined="true" data-testid="jim-password-set-card">
            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="4">
                <MudIcon Icon="@Icons.Material.Filled.Key" Color="Color.Primary" Class="mt-1" />
                <MudStack Spacing="1" Class="flex-grow-1">
                    <MudText Typo="Typo.h6">Set Password</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Choose a password and apply it to the accounts you tick. Set now where the system answers;
                        kept and retried where it does not.
                    </MudText>
                    @if (Accounts.Count > 0)
                    {
                        <MudText Typo="Typo.body2" data-testid="jim-password-coverage">
                            <b>@SettableAccountCount of @Accounts.Count</b> @(Accounts.Count == 1 ? "account" : "accounts") can take a password
                        </MudText>
                    }
                    @if (SettableAccountCount == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="jim-password-set-unavailable">
                            @(Accounts.Count == 0
                                ? "Unavailable: this person has no account in any Connected System."
                                : "Unavailable: none of this person's accounts are in a Connected System whose Connector can set passwords.")
                        </MudText>
                    }
                </MudStack>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                           Disabled="@(SettableAccountCount == 0 || Busy)"
                           OnClick="@(() => OnSetPassword.InvokeAsync())"
                           data-testid="jim-password-set">Set Password</MudButton>
            </MudStack>
        </MudPaper>

        @* ─── Still to be delivered: what the queue is still carrying for this person ─── *@
        @if (QueuedChanges.Count > 0)
        {
            <MudPaper Class="pa-4" Outlined="true" data-testid="jim-password-queued">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIcon Icon="@Icons.Material.Filled.SyncLock" Color="Color.Primary" />
                    <MudText Typo="Typo.h6">Still to be delivered</MudText>
                </MudStack>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                    A change leaves the queue once it arrives. Anything here is still owed to that Connected System,
                    or has stopped being attempted.
                </MudText>

                <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mt-3">
                    <thead>
                        <tr>
                            <th>Connected System</th>
                            <th>Status</th>
                            <th>Attempts</th>
                            <th>Next attempt</th>
                            <th>Queued</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var change in QueuedChanges)
                        {
                            var connectedSystemId = change.ConnectedSystemId;
                            <tr @key="change.Id" data-testid="jim-password-queued-row">
                                <td>@change.ConnectedSystemName</td>
                                <td>
                                    <OneLineText Text="@PendingPasswordChangeDisplay.Status(change)" Secondary="@PendingPasswordChangeDisplay.Detail(change)" />
                                </td>
                                <td>@change.AttemptCount.ToString("N0")</td>
                                <td>
                                    @if (NextAttempt(change) is { } nextAttempt)
                                    {
                                        @nextAttempt
                                    }
                                    else
                                    {
                                        <EmptyValue />
                                    }
                                </td>
                                <td>@change.CreatedAt.ToLocalTime().ToFriendlyDate()</td>
                                <td class="text-right">
                                    @* Retry where JIM has given up; stop where it has not. A row that is neither
                                       (waiting its first attempt, held, expired, cancelled) has no action here:
                                       the queue page carries the whole set for the rarer cases. *@
                                    @if (change.Status == PendingPasswordChangeStatus.Parked)
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" DropShadow="false"
                                                   StartIcon="@Icons.Material.Filled.Replay" Disabled="@Busy"
                                                   OnClick="@(() => OnRetry.InvokeAsync(connectedSystemId))"
                                                   data-testid="jim-password-queued-retry">Retry</MudButton>
                                    }
                                    else if (IsRetrying(change))
                                    {
                                        <MudButton Variant="Variant.Text" Color="Color.Default" DropShadow="false"
                                                   StartIcon="@Icons.Material.Filled.CancelScheduleSend" Disabled="@Busy"
                                                   OnClick="@(() => OnStopTrying.InvokeAsync(connectedSystemId))"
                                                   data-testid="jim-password-queued-stop">Stop trying</MudButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }

        @* ─── Recent password changes: the durable record ─── *@
        <MudPaper Class="pa-4" Outlined="true" data-testid="jim-password-history">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Recent password changes</MudText>
                <MudSpacer />
                <MudLink Href="@QueueHref">Password queue</MudLink>
            </MudStack>

            @if (Events.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                    JIM has never set or synchronised a password for this person.
                </MudText>
            }
            else
            {
                @foreach (var passwordChange in Events)
                {
                    <div class="mt-4" @key="passwordChange.ActivityId">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.subtitle2">@passwordChange.Created.ToLocalTime().ToFriendlyDate()</MudText>
                            @* The kind chip (#1635): a change an administrator aimed at named accounts reads
                               differently from one JIM carried after the person changed their own password. An
                               Activity from before origins were recorded carries neither and gets no chip rather
                               than a guessed one. *@
                            @if (passwordChange.Origin is { } origin)
                            {
                                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small"
                                         Color="@(origin == PendingPasswordChangeOrigin.Explicit ? Color.Primary : Color.Default)"
                                         Class="ma-0" data-testid="jim-password-kind">
                                    @(origin == PendingPasswordChangeOrigin.Explicit ? "Set" : "Propagated")
                                </MudChip>
                            }
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@DescribeInitiator(passwordChange)</MudText>
                        </MudStack>

                        @if (passwordChange.Outcomes.Count == 0)
                        {
                            @* A change that reached nothing must not render as a bare timestamp an administrator
                               reads as "it went out fine" (requirement 14 read from the other end). *@
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                                Recorded, but queued for no Connected System: none that this person has an account in
                                was enabled for Password Synchronisation at the time.
                            </MudText>
                        }
                        else
                        {
                            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Class="mt-2">
                                <tbody>
                                    @foreach (var outcome in passwordChange.Outcomes)
                                    {
                                        <tr @key="outcome.ActivityId">
                                            <td style="width: 40px;">
                                                <MudTooltip Arrow="true" Placement="Placement.Top">
                                                    <TooltipContent><TooltipText Text="@DescribeOutcome(outcome)" /></TooltipContent>
                                                    <ChildContent>
                                                        <MudIcon Icon="@OutcomeIcon(outcome)" Color="@OutcomeColour(outcome)" Size="Size.Small" />
                                                    </ChildContent>
                                                </MudTooltip>
                                            </td>
                                            <td>@outcome.ConnectedSystemName</td>
                                            <td>
                                                <OneLineText Text="@(outcome.ErrorMessage ?? outcome.Message)" />
                                            </td>
                                            <td style="width: 190px;">@outcome.OccurredAt.ToLocalTime().ToFriendlyDate()</td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        }
                    </div>
                }
            }
        </MudPaper>
    </MudStack>
}

@code {
    /// <summary>
    /// The identity this panel is about, used to deep-link the queue to their outstanding changes.
    /// </summary>
    [Parameter]
    public Guid MetaverseObjectId { get; set; }

    /// <summary>
    /// This person's most recent password changes, newest first, with what each Connected System did with them.
    /// </summary>
    [Parameter]
    public IReadOnlyList<PasswordSynchronisationEvent> Events { get; set; } = [];

    /// <summary>
    /// What is still on the queue for this person: changes not yet delivered, or that have stopped being tried.
    /// </summary>
    [Parameter]
    public IReadOnlyList<PendingPasswordChangeHeader> QueuedChanges { get; set; } = [];

    /// <summary>
    /// This person's accounts, capable or not, for the coverage line and for whether Set Password is offered.
    /// </summary>
    [Parameter]
    public IReadOnlyList<MetaverseObjectAccount> Accounts { get; set; } = [];

    /// <summary>
    /// True while the page is reading the tab's data on its first activation; the panel shows a spinner rather
    /// than an empty history that reads as "nothing ever happened".
    /// </summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>
    /// True while the page is running one of the actions below, so a second click cannot queue a second retry.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    /// <summary>
    /// Raised when the administrator asks to set a password. The page opens the dialog; the panel only decides
    /// whether the action is offered.
    /// </summary>
    [Parameter]
    public EventCallback OnSetPassword { get; set; }

    /// <summary>
    /// Raised with a Connected System id when the administrator retries this person's parked change there.
    /// </summary>
    [Parameter]
    public EventCallback<int> OnRetry { get; set; }

    /// <summary>
    /// Raised with a Connected System id when the administrator stops JIM retrying this person's change there.
    /// </summary>
    [Parameter]
    public EventCallback<int> OnStopTrying { get; set; }

    private string QueueHref => $"/admin/operations?t=passwords&metaverseObjectId={MetaverseObjectId}";

    private int SettableAccountCount => Accounts.Count(a => a.ConnectorCanSetPasswords);

    /// <summary>
    /// The rows nothing will move out of without a person: parked (JIM gave up) and expired (nothing can deliver
    /// it now). Retrying is deliberately not among them; JIM is still on it.
    /// </summary>
    private IReadOnlyList<PendingPasswordChangeHeader> AttentionRows =>
        QueuedChanges.Where(c => c.Status is PendingPasswordChangeStatus.Parked or PendingPasswordChangeStatus.Expired).ToList();

    /// <summary>
    /// A pending row that has been attempted and is waiting out its backoff: the one state where "stop trying"
    /// means something. A held row is waiting on a person switching the system on, not on a retry.
    /// </summary>
    private static bool IsRetrying(PendingPasswordChangeHeader change) =>
        change.Status == PendingPasswordChangeStatus.Pending && !change.IsHeld && change.AttemptCount > 0;

    /// <summary>
    /// When JIM will next try, for a row it is still trying: now for one being delivered, the booked time for one
    /// waiting out a backoff, and nothing for every other state.
    /// </summary>
    private static string? NextAttempt(PendingPasswordChangeHeader change)
    {
        if (change.Status == PendingPasswordChangeStatus.Delivering)
            return "Now";

        if (change.Status == PendingPasswordChangeStatus.Pending && !change.IsHeld && change.NextRetryAt is { } nextRetryAt)
            return nextRetryAt.ToLocalTime().ToFriendlyDate();

        return null;
    }

    private string AttentionHeadline
    {
        get
        {
            var parked = AttentionRows.Count(c => c.Status == PendingPasswordChangeStatus.Parked);
            var expired = AttentionRows.Count - parked;
            return (parked, expired) switch
            {
                (1, 0) => "1 password change is parked.",
                (_, 0) => $"{parked} password changes are parked.",
                (0, 1) => "1 password change has expired.",
                (0, _) => $"{expired} password changes have expired.",
                _ => $"{Count(parked, "password change")} {(parked == 1 ? "is" : "are")} parked and {expired} {(expired == 1 ? "has" : "have")} expired."
            };

            static string Count(int n, string noun) => n == 1 ? $"1 {noun}" : $"{n} {noun}s";
        }
    }

    /// <summary>
    /// One sentence per row needing attention: the system, JIM's classification of what went wrong in the words
    /// the queue page uses for it, and that nothing more will happen without a person. The target's own words are
    /// on the row below; the strip is for deciding whether to act, not for diagnosing.
    /// </summary>
    private static string DescribeAttention(PendingPasswordChangeHeader change)
    {
        if (change.Status == PendingPasswordChangeStatus.Expired)
            return $"{change.ConnectedSystemName}: expired before it could be delivered.";

        var verb = change.FailureReason switch
        {
            PasswordSetFailureReason.PolicyRejection => "refused it",
            PasswordSetFailureReason.Transient => "could not be reached",
            PasswordSetFailureReason.ConfigurationFault => "could not take it",
            PasswordSetFailureReason.TargetObjectNotFound => "has no account to set it on",
            PasswordSetFailureReason.UnsupportedOperation => "cannot set passwords",
            _ => "did not take it"
        };
        var reason = change.FailureReason is { } failureReason and not PasswordSetFailureReason.None
            ? $" ({PendingPasswordChangeDisplay.Reason(failureReason).ToLowerInvariant()})"
            : string.Empty;
        return $"{change.ConnectedSystemName} {verb}{reason} and JIM has stopped trying.";
    }

    private static string DescribeInitiator(PasswordSynchronisationEvent passwordChange)
    {
        if (string.IsNullOrWhiteSpace(passwordChange.InitiatedByName))
            return "Initiator not recorded";

        return passwordChange.InitiatedByType == ActivityInitiatorType.ApiKey
            ? $"via {passwordChange.InitiatedByName} (API key)"
            : $"by {passwordChange.InitiatedByName}";
    }

    private static string OutcomeIcon(PasswordSynchronisationEventOutcome outcome) => outcome.Succeeded switch
    {
        true => Icons.Material.Filled.CheckCircleOutline,
        false => Icons.Material.Filled.ErrorOutline,
        _ => Icons.Material.Filled.HourglassEmpty
    };

    private static Color OutcomeColour(PasswordSynchronisationEventOutcome outcome) => outcome.Succeeded switch
    {
        true => Color.Success,
        false => Color.Error,
        _ => Color.Default
    };

    private static string DescribeOutcome(PasswordSynchronisationEventOutcome outcome) => outcome.Succeeded switch
    {
        true => $"{outcome.ConnectedSystemName} took the change.",
        false => $"{outcome.ConnectedSystemName} did not take the change. The message beside it is the target's own, and is usually where the remedy lives.",
        _ => $"The attempt on {outcome.ConnectedSystemName} is still running."
    };
}
