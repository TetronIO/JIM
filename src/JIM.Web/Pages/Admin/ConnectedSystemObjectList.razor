<PageTitle>Connector Space: @_connectedSystemHeader?.Name</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>Connector Space:</span> <span class="mud-primary-text">@_connectedSystemHeader?.Name</span></MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
@if (_showIntro)
{
    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="mt-3 mb-3" ShowCloseIcon="true" CloseIconClicked="() => _showIntro = false">
        The Connector Space holds this Connected System's Connected System Objects. Inbound changes from the system are held here before being committed to the Metaverse. Outbound changes are held here ahead of synchronisation to the Connected System.
    </MudAlert>
}

@if (_connectedSystemHeader != null)
{
    @* Filter Chips *@
    <MudStack Row="true" Spacing="6" Class="mt-4 mb-3 flex-wrap" AlignItems="AlignItems.Start">
        <div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Filter by Status:</MudText>
            <MudChipSet T="ConnectedSystemObjectStatus"
                        SelectionMode="SelectionMode.MultiSelection"
                        SelectedValues="_selectedStatuses"
                        SelectedValuesChanged="OnStatusFilterChanged">
                @foreach (var status in GetAvailableStatuses())
                {
                    <MudChip Value="@status"
                             Color="@(_selectedStatuses.Contains(status) ? Color.Default : GetStatusColor(status))"
                             Variant="@(_selectedStatuses.Contains(status) ? Variant.Filled : Variant.Outlined)"
                             SelectedColor="@GetStatusColor(status)">
                        @status.ToString().SplitOnCapitalLetters()
                    </MudChip>
                }
            </MudChipSet>
        </div>

        @if (_objectTypes.Count > 1)
        {
            <div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Filter by Object Type:</MudText>
                <MudChipSet T="int"
                            SelectionMode="SelectionMode.MultiSelection"
                            SelectedValues="_selectedObjectTypeIds"
                            SelectedValuesChanged="OnObjectTypeFilterChanged">
                    @foreach (var type in _objectTypes)
                    {
                        <MudChip Value="@type.Id"
                                 Color="Color.Default"
                                 Variant="@(_selectedObjectTypeIds.Contains(type.Id) ? Variant.Filled : Variant.Outlined)"
                                 SelectedColor="Color.Default">
                            @type.Name
                        </MudChip>
                    }
                </MudChipSet>
            </div>
        }

        <div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Filter by Join Type:</MudText>
            <MudChipSet T="ConnectedSystemObjectJoinType"
                        SelectionMode="SelectionMode.MultiSelection"
                        SelectedValues="_selectedJoinTypes"
                        SelectedValuesChanged="OnJoinTypeFilterChanged">
                @foreach (var joinType in GetAvailableJoinTypes())
                {
                    <MudChip Value="@joinType"
                             Color="Color.Default"
                             Variant="@(_selectedJoinTypes.Contains(joinType) ? Variant.Filled : Variant.Outlined)"
                             SelectedColor="Color.Default">
                        @joinType.ToString().SplitOnCapitalLetters()
                    </MudChip>
                }
            </MudChipSet>
        </div>

        <MudSpacer />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Delete"
                   DropShadow="false"
                   OnClick="HandleDeleteAllObjectsClickAsync"
                   Style="align-self: end;">
            Delete All Objects
        </MudButton>
    </MudStack>

    @* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count, density, the
       search box) lives in the shared grid; this page supplies the columns, the window loader, the chip filters
       above and the empty states. *@
    <VirtualisedDataGrid @ref="_grid" T="ConnectedSystemObjectHeader"
                         ContainerId="connector-space-list"
                         DefaultSortBy="created"
                         DefaultSortDescending="true"
                         LoadWindow="LoadWindowAsync"
                         RowClicked="HandleRowClicked"
                         SingularName="Connected System Object"
                         PluralName="Connected System Objects"
                         SearchPlaceholder="Search external ID, secondary ID, or display name">
        <Columns>
            <TemplateColumn Sortable="false">
                <HeaderTemplate></HeaderTemplate>
                <CellTemplate>
                    @* The row navigates on click and so does this button, so without stopping the click here a
                       reader who clicks View gets two identical navigations. The button is what offers middle-click
                       and open-in-new-tab, which a row-click handler cannot. *@
                    <span @onclick:stopPropagation="true">
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   Href="@(Utilities.GetConnectedSystemObjectHref(context.Item))">
                            View
                        </MudButton>
                    </span>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false" CellClass="jim-text-code mud-text-secondary">
                <HeaderTemplate>
                    @* The header names the Connected System's own anchor attribute once the first window reveals
                       it, e.g. "External Id (objectGUID)". *@
                    <VirtualisedSortHeader Title="@_externalIdColumnHeader" Name="externalid" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.PendingExternalId))
                    {
                        <MudTooltip Text="Pending Export - not yet confirmed" Arrow="true" Placement="Placement.Top">
                            <MudText Color="Color.Info">@context.Item.PendingExternalId</MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        @context.Item.ExternalIdValue
                    }
                </CellTemplate>
            </TemplateColumn>
            @* Hidden rather than omitted: MudDataGrid orders its columns by the order they register with it, not by
               their position in this markup, and whether the rows carry a secondary external ID is only known once
               the first window has loaded. Wrapping this column in an @if therefore registers it after every column
               below and renders it last, whatever the markup says. *@
            <TemplateColumn Sortable="false" Hidden="@(!_hasSecondaryExternalId)" CellClass="jim-text-code mud-text-secondary">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@_secondaryExternalIdColumnHeader" Name="secondaryexternalid" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.SecondaryExternalIdValue))
                    {
                        @context.Item.SecondaryExternalIdValue
                    }
                    else if (!string.IsNullOrEmpty(context.Item.PendingSecondaryExternalId))
                    {
                        <MudTooltip Text="Pending Export - not yet confirmed" Arrow="true" Placement="Placement.Top">
                            <MudText Color="Color.Info">@context.Item.PendingSecondaryExternalId</MudText>
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Display Name" Name="displayname" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (!string.IsNullOrEmpty(context.Item.DisplayName))
                    {
                        @context.Item.DisplayName
                    }
                    else if (!string.IsNullOrEmpty(context.Item.PendingDisplayName))
                    {
                        <MudTooltip Text="Pending Export - not yet confirmed" Arrow="true" Placement="Placement.Top">
                            <MudText Color="Color.Info">@context.Item.PendingDisplayName</MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        <EmptyValue />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Type" Name="type" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudChip T="string" Text="@context.Item.TypeName" Variant="Variant.Text" Color="@_typeChipColors.GetColor(context.Item.TypeName)" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Created" Name="created" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                        <MudText>@context.Item.Created.ToLocalTime().ToRelativeTime()</MudText>
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Date Joined" Name="datejoined" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.DateJoined.HasValue)
                    {
                        var dateJoined = context.Item.DateJoined.Value;
                        <MudTooltip Text="@dateJoined.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                            <MudText>@dateJoined.ToLocalTime().ToRelativeTime()</MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        <EmptyValue />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Status" Name="status" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudChip T="string" Text="@context.Item.Status.ToString().SplitOnCapitalLetters()" Variant="Variant.Text" />
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Join Type" Name="jointype" />
                </HeaderTemplate>
                <CellTemplate>
                    @context.Item.JoinType.ToString().SplitOnCapitalLetters()
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <EmptyContent Context="grid">
            @* An empty list means one of three different things, and the message says which: a search that matched
               nothing (with the way out as the action), filter chips nothing satisfies (the chips above offer their
               own clear), or a Connector Space no import has populated yet. *@
            @if (!string.IsNullOrWhiteSpace(grid.SearchText))
            {
                <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                 PrimaryText="@($"No Connected System Objects match \"{grid.SearchText}\"")"
                                 SecondaryText="Try a different search term, or clear the search."
                                 ActionText="Clear Search"
                                 OnAction="@(() => grid.ClearSearchAsync())" />
            }
            else if (HasActiveChipFilters)
            {
                <TableEmptyState Icon="@Icons.Material.Filled.FilterAlt"
                                 PrimaryText="No Connected System Objects match the selected filters"
                                 SecondaryText="Clear the filter chips above to browse the whole Connector Space." />
            }
            else
            {
                <TableEmptyState Icon="@Icons.Material.Filled.Cable"
                                 PrimaryText="No Connected System Objects yet"
                                 SecondaryText="Objects appear here once an import brings them in from the Connected System." />
            }
        </EmptyContent>
    </VirtualisedDataGrid>

    <MudDialog @bind-Visible="_clearDialogVisible" Options="_clearDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Class="mr-3" /> Clear Connector Space
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
                This action will delete all Connected System Objects from JIM.
            </MudAlert>

            <MudText>
                Deleting the Connected System Objects does not cause objects to be deleted in the external system.
                It just removes the objects from JIM. A full-import on this Connected System and full-synchronisation on all Connected Systems is needed to rebuild the correct state.
            </MudText>

            <MudText Class="mt-3">
                The deletes will be executed via a task and may take some time. Check the <MudLink Href="/admin/operations" Target="_blank">Operations</MudLink> page or refresh this one to see progress.
            </MudText>

            <MudCheckBox @bind-Value="_clearDeleteChangeHistory" Class="mt-4" Color="Color.Primary">
                <MudText>Delete change history for cleared objects</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    When enabled, all change history records for the cleared CSOs will also be deleted.
                    This is recommended when clearing for re-import as the old history becomes irrelevant.
                </MudText>
            </MudCheckBox>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _clearDialogVisible = false)" DropShadow="false">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" DropShadow="false" StartIcon="@Icons.Material.Filled.DeleteForever" OnClick="HandleClearConfirmedAsync">
                Clear Connector Space
            </MudButton>
        </DialogActions>
    </MudDialog>
}
else
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mt-5" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    /// <summary>
    /// Deep link: a status to open the list narrowed to. Reached from the Connected System page, which
    /// counts the objects waiting on a synchronisation and needs somewhere to send the reader that shows
    /// exactly those (#1527). Unrecognised values are ignored rather than refused: a stale or hand-typed
    /// link should open the list, not an error page.
    /// </summary>
    [SupplyParameterFromQuery(Name = "status")]
    public string? DeepLinkStatus { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [CascadingParameter]
    private MainLayout? Layout { get; set; }

    private VirtualisedDataGrid<ConnectedSystemObjectHeader>? _grid;
    private ConnectedSystemHeader? _connectedSystemHeader;
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private bool _showIntro = true;
    private bool _clearDialogVisible;
    private bool _clearDeleteChangeHistory = true; // Default to true (recommended for re-import)
    private readonly DialogOptions _clearDialogOptions = new() { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };

    private readonly TypeChipColorAssigner _typeChipColors = new();

    // Column headers derived from the rows in hand: the External Id headers name the Connected System's own anchor
    // attributes, and the Secondary External Id column only exists when any row carries (or is about to carry) a
    // secondary external id. Recomputed per window by UpdateColumnHeaders.
    private bool _hasSecondaryExternalId;
    private string _externalIdColumnHeader = "External Id";
    private string _secondaryExternalIdColumnHeader = "Secondary External Id";

    // Filter state
    private IReadOnlyCollection<ConnectedSystemObjectStatus> _selectedStatuses = new List<ConnectedSystemObjectStatus>();
    private IReadOnlyCollection<int> _selectedObjectTypeIds = new List<int>();
    private IReadOnlyCollection<ConnectedSystemObjectJoinType> _selectedJoinTypes = new List<ConnectedSystemObjectJoinType>();
    private List<ConnectedSystemObjectType> _objectTypes = new();

    // True when any status, object type or join type chip narrows the list; the empty state uses this to tell
    // "the filters matched nothing" apart from "no import has populated the Connector Space yet".
    private bool HasActiveChipFilters => _selectedStatuses.Count > 0 || _selectedObjectTypeIds.Count > 0 || _selectedJoinTypes.Count > 0;

    protected override async Task OnInitializedAsync()
    {
        Layout?.SetFullWidth();

        using var jim = JimFactory.Create();
        _connectedSystemHeader = await jim.ConnectedSystems.GetConnectedSystemHeaderAsync(Id);
        if (_connectedSystemHeader == null)
        {
            NavManager.NavigateTo("../");
            return;
        }

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("Home", href: "/", icon: Icons.Material.Filled.Home),
            new("Administration", href: "/admin"),
            new("Connected Systems", href: "/admin/connected-systems/"),
            new(_connectedSystemHeader.Name, href: Utilities.GetConnectedSystemHref(_connectedSystemHeader)),
            new("Connector Space", href: null, disabled: true)
        };

        _objectTypes = (await jim.ConnectedSystems.GetObjectTypesAsync(Id))
            .Where(t => t.Selected)
            .ToList();

        // Applied before the grid's first window loads, so the deep link opens on the narrowed list rather
        // than painting everything and then filtering it away.
        if (Enum.TryParse<ConnectedSystemObjectStatus>(DeepLinkStatus, ignoreCase: true, out var deepLinkStatus)
            && GetAvailableStatuses().Contains(deepLinkStatus))
        {
            _selectedStatuses = new List<ConnectedSystemObjectStatus> { deepLinkStatus };
        }
    }

    private async Task<VirtualisedWindow<ConnectedSystemObjectHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        using var jim = JimFactory.Create();

        // Build filters - null means show all
        IEnumerable<ConnectedSystemObjectStatus>? statusFilter = _selectedStatuses.Count > 0 ? _selectedStatuses : null;
        IEnumerable<int>? objectTypeFilter = _selectedObjectTypeIds.Count > 0 ? _selectedObjectTypeIds : null;
        IEnumerable<ConnectedSystemObjectJoinType>? joinTypeFilter = _selectedJoinTypes.Count > 0 ? _selectedJoinTypes : null;

        var result = await jim.ConnectedSystems.GetConnectedSystemObjectHeadersRangeAsync(
            Id,
            request.StartIndex,
            request.Count,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            statusFilter,
            objectTypeFilter,
            joinTypeFilter,
            includeTotalCount: request.IncludeTotalCount);

        // Update column headers based on the window in hand; the grid re-renders its header templates when the
        // window arrives, so the new values paint without an explicit StateHasChanged.
        UpdateColumnHeaders(result.Results);

        return new VirtualisedWindow<ConnectedSystemObjectHeader>(result.Results, result.TotalResults);
    }

    private void UpdateColumnHeaders(List<ConnectedSystemObjectHeader> results)
    {
        if (results.Count == 0)
        {
            _externalIdColumnHeader = "External Id";
            _secondaryExternalIdColumnHeader = "Secondary External Id";
            _hasSecondaryExternalId = false;
            return;
        }

        var first = results.First();
        _externalIdColumnHeader = string.IsNullOrEmpty(first.ExternalIdAttributeName)
            ? "External Id"
            : $"External Id ({first.ExternalIdAttributeName})";

        // Show secondary external ID column if any confirmed OR pending values exist
        _hasSecondaryExternalId = results.Any(r =>
            !string.IsNullOrEmpty(r.SecondaryExternalIdValue) || !string.IsNullOrEmpty(r.PendingSecondaryExternalId));
        if (_hasSecondaryExternalId)
        {
            var secondaryAttrName = results
                .FirstOrDefault(r => !string.IsNullOrEmpty(r.SecondaryExternalIdValue))?.SecondaryExternalIdAttributeName;
            _secondaryExternalIdColumnHeader = string.IsNullOrEmpty(secondaryAttrName)
                ? "Secondary External Id"
                : $"Secondary External Id ({secondaryAttrName})";
        }
    }

    private void HandleRowClicked(ConnectedSystemObjectHeader item)
    {
        NavManager.NavigateTo(Utilities.GetConnectedSystemObjectHref(item));
    }

    private void HandleDeleteAllObjectsClickAsync()
    {
        _clearDialogVisible = true;
    }

    private async Task HandleClearConfirmedAsync()
    {
        _clearDialogVisible = false;

        using var jim = JimFactory.Create();
        // attribute the execution to the user
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        var task = ClearConnectedSystemObjectsWorkerTask.ForUser(Id, user.Id, user.NameOrId, _clearDeleteChangeHistory);
        var result = await jim.Tasking.CreateWorkerTaskAsync(task);

        if (!result.Success)
        {
            Snackbar.Add(result.ErrorMessage ?? "Failed to create task.", Severity.Error);
            return;
        }

        Snackbar.Add("Connected System Objects queued for deletion.", Severity.Info);
    }

    private static IEnumerable<ConnectedSystemObjectStatus> GetAvailableStatuses()
    {
        // Obsolete belongs here as much as the other two: it is the state an object sits in between the
        // import that found it gone and the synchronisation that deletes it, and it was the one status
        // the portal could not filter for, though the REST API and PowerShell always could (#1527).
        return new[]
        {
            ConnectedSystemObjectStatus.Normal,
            ConnectedSystemObjectStatus.PendingProvisioning,
            ConnectedSystemObjectStatus.Obsolete
        };
    }

    private static IEnumerable<ConnectedSystemObjectJoinType> GetAvailableJoinTypes()
    {
        return new[]
        {
            ConnectedSystemObjectJoinType.NotJoined,
            ConnectedSystemObjectJoinType.Projected,
            ConnectedSystemObjectJoinType.Provisioned,
            ConnectedSystemObjectJoinType.Joined
        };
    }

    private static Color GetStatusColor(ConnectedSystemObjectStatus status)
    {
        return status switch
        {
            ConnectedSystemObjectStatus.Normal => Color.Success,
            ConnectedSystemObjectStatus.PendingProvisioning => Color.Info,
            // Warning rather than Error: an obsolete object is on its way out by design, and only a
            // pile of them that never clears is a problem.
            ConnectedSystemObjectStatus.Obsolete => Color.Warning,
            _ => Color.Default
        };
    }

    private async Task OnStatusFilterChanged(IReadOnlyCollection<ConnectedSystemObjectStatus> selected)
    {
        _selectedStatuses = selected;
        await RefreshGridForFilterChangeAsync();
    }

    private async Task OnObjectTypeFilterChanged(IReadOnlyCollection<int> selected)
    {
        _selectedObjectTypeIds = selected;
        await RefreshGridForFilterChangeAsync();
    }

    private async Task OnJoinTypeFilterChanged(IReadOnlyCollection<ConnectedSystemObjectJoinType> selected)
    {
        _selectedJoinTypes = selected;
        await RefreshGridForFilterChangeAsync();
    }

    /// <summary>
    /// Reloads the grid after a chip filter change. The filters change which objects match, so the total (and the
    /// unfiltered baseline it anchors) must be re-counted, and the reader's scroll position describes a match set
    /// that no longer exists, so they are returned to the top.
    /// </summary>
    private async Task RefreshGridForFilterChangeAsync()
    {
        if (_grid != null)
        {
            await _grid.ResetScrollAsync();
            await _grid.RefreshAsync(invalidateTotals: true);
        }
    }

    public void Dispose()
    {
        Layout?.ResetWidth();
    }
}
