@using JIM.Models.Activities
@using JIM.Models.Core
@using JIM.Models.Core.DTOs
@using JIM.Models.Enums
@using JIM.Models.Transactional
@using JIM.Models.Utility
@using JIM.Utilities
@using JIM.Web.Models

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

@if ((Changes == null || !Changes.Any()) && !Retirements.Any())
{
    <MudText Class="mud-text-secondary pa-1">No change history available.</MudText>
}
else
{
    <!-- Search and Filter Controls -->
    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <SearchField @bind-Value="_searchText" Label="Search" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" @bind-Value="_filterChangeType" Label="Change type" Variant="Variant.Outlined"
                           Dense="true" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@((string)null!)">All Changes</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Set")">Set</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Updated")">Updated</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Removed")">Removed</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Add")">Add</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Remove")">Remove</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Timeline -->
    <MudTimeline TimelinePosition="TimelinePosition.Start" TimelineOrientation="TimelineOrientation.Vertical">
        @foreach (var entry in GetTimelineEntries())
        {
            @if (entry.Retirement is { } retirement)
            {
                @* ─── A retired generated value (Unique Value Generation, #242, Phase 6) ─── *@
                <MudTimelineItem Color="Color.Warning" Elevation="0">
                    <ItemContent>
                        <MudCard Outlined="true" data-testid="jim-timeline-retirement">
                            <MudCardContent>
                                <MudStack Spacing="2">
                                    <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center" Style="flex-wrap: wrap; gap: 6px;">
                                        <MudIcon Icon="@Icons.Material.Outlined.Archive" Color="Color.Warning" />
                                        <MudText Typo="Typo.body1" Style="margin-right: 14px;"><strong>Value retired</strong></MudText>
                                        <MudTooltip Text="@retirement.RetiredAt.ToLocalTime().ToFriendlyDate()" Placement="Placement.Top" Arrow="true">
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="margin-right: 12px;">
                                                @GetRelativeTime(retirement.RetiredAt)</MudText>
                                        </MudTooltip>
                                        @if (retirement.ActivityId is { } retirementActivityId)
                                        {
                                            <MudLink Typo="Typo.body2" Href="@($"/activity/{retirementActivityId}")">
                                                @(retirement.ActivityTargetName ?? "View Activity")
                                            </MudLink>
                                        }
                                    </MudStack>
                                    <MudDivider />
                                    <div class="d-flex align-center flex-wrap gap-2">
                                        <MudText Class="mud-text-secondary">@retirement.AttributeName</MudText>
                                        <MudText>generated value</MudText>
                                        <code class="jim-code-inline" style="text-decoration: line-through;" title="@retirement.Value">@retirement.Value</code>
                                        <MudText>retired</MudText>
                                        <MudTooltip Arrow="true" Placement="Placement.Top">
                                            <ChildContent>
                                                <MudChip T="string" Variant="Variant.Text" Color="@RetiredGeneratedValueReasonDisplay.Colour(retirement.Reason)" Class="ma-0">
                                                    @RetiredGeneratedValueReasonDisplay.Label(retirement.Reason)
                                                </MudChip>
                                            </ChildContent>
                                            <TooltipContent>
                                                <TooltipText Text="@RetiredGeneratedValueReasonDisplay.Tooltip(retirement.Reason)" />
                                            </TooltipContent>
                                        </MudTooltip>
                                    </div>
                                </MudStack>
                            </MudCardContent>
                        </MudCard>
                    </ItemContent>
                </MudTimelineItem>
            }
            else if (entry.Change is { } changeGroup)
            {
            <MudTimelineItem Color="@GetChangeTypeColor(changeGroup.ChangeType)" Elevation="0">
                <ItemContent>
                    <MudCard Outlined="true" Class="cursor-pointer change-card" @onclick="() => OpenChangeDetails(changeGroup)">
                        <MudCardContent>
                            <MudStack Spacing="2">
                                <!-- Change Header: {icon} {type}    {relative date}    {mechanism icon} {mechanism} by {initiator} -->
                                <MudStack Row="true" Spacing="0" AlignItems="AlignItems.Center"
                                          Style="flex-wrap: wrap; gap: 6px;">
                                    <MudIcon Icon="@GetChangeTypeIcon(changeGroup.ChangeType)"
                                             Color="@GetChangeTypeColor(changeGroup.ChangeType)" />
                                    <MudText Typo="Typo.body1" Style="margin-right: 14px;">
                                        <strong>@changeGroup.ChangeType.ToString().SplitOnCapitalLetters()</strong>
                                    </MudText>
                                    @if ((changeGroup.ChangeType == ObjectChangeType.Joined ||
                                                                 changeGroup.ChangeType == ObjectChangeType.Projected) &&
                                                                !string.IsNullOrEmpty(changeGroup.CsoExternalId))
                                    {
                                        <span style="margin-right: 12px;">
                                            <MudTooltip Text="@(changeGroup.ConnectedSystemName ?? "Connected System")"
                                                        Placement="Placement.Top" Arrow="true">
                                                @if (changeGroup.CsoId.HasValue && changeGroup.ConnectedSystemId.HasValue)
                                                {
                                                    <MudLink Typo="Typo.body2"
                                                    Class="jim-text-code"
                                                    Href="@Utilities.GetConnectedSystemObjectHref(changeGroup.ConnectedSystemId.Value, changeGroup.CsoId.Value)"
                                                    @onclick:stopPropagation="true">@changeGroup.CsoExternalId</MudLink>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body2" Class="jim-text-code">@changeGroup.CsoExternalId</MudText>
                                                }
                                            </MudTooltip>
                                        </span>
                                    }
                                    <MudTooltip Text="@changeGroup.ChangeTime.ToLocalTime().ToFriendlyDate()"
                                                Placement="Placement.Top" Arrow="true">
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="margin-right: 12px;">
                                            @GetRelativeTime(changeGroup.ChangeTime)</MudText>
                                        </MudTooltip>
                                        <InitiatorChip InitiatedByType="@changeGroup.InitiatedByType" InitiatedById="@changeGroup.ChangeInitiatorId"
                                                       InitiatedByName="@changeGroup.ChangeInitiatorName" ChangeInitiatorType="@MechanismInitiator(changeGroup)"
                                                       SyncRuleId="@changeGroup.SyncRuleId" SyncRuleName="@changeGroup.SyncRuleName"
                                                       ConnectedSystemId="@changeGroup.ConnectedSystemId" ConnectedSystemName="@changeGroup.ConnectedSystemName" />
                                    </MudStack>

                                    <!-- Summary of Changes -->
                                    @if (changeGroup.AttributeChanges.Any())
                                    {
                                        <MudDivider />
                                        <div class="change-summary">
                                            @foreach (var change in GetVisibleDisplayChanges(changeGroup))
                                            {
                                                <MudText Class="mud-text-secondary change-summary-attribute">
                                                    @change.AttributeName
                                                </MudText>
                                                <MudChip T="string" Variant="Variant.Text" Color="@GetDisplayChangeTypeColor(change)">
                                                    @change.DisplayChangeType
                                                </MudChip>
                                                @* The value is one line, clipped with an ellipsis. A .jim-one-line-list rather than a
                                                   clamp on the cell itself, because the clamp has to sit on the element that directly
                                                   contains the text: MudText renders a block <p>, so an ellipsis declared on the cell
                                                   never applied and a long Distinguished Name was hard-cut mid-value. The arrow holds
                                                   its size and only the values give way. Each value carries its full text as a title,
                                                   and the card opens the change detail dialog, so nothing clipped here is lost. *@
                                                <div class="jim-one-line-list">
                                                    @if (change.IsUpdate)
                                                    {
                                                        @if (change.OldReferenceValue != null || change.NewReferenceValue != null)
                                                        {
                                                            var oldReferenceName = change.OldReferenceValue?.DisplayName ?? "(none)";
                                                            var newReferenceName = change.NewReferenceValue?.DisplayName ?? "(none)";
                                                            <MudText Class="mud-text-secondary jim-one-line-list-value" title="@oldReferenceName">@oldReferenceName</MudText>
                                                            <MudText Class="mud-text-secondary">→</MudText>
                                                            <MudText Class="jim-one-line-list-value" title="@newReferenceName">@newReferenceName</MudText>
                                                        }
                                                        else
                                                        {
                                                            <MudText Class="mud-text-secondary jim-one-line-list-value" title="@change.OldValue">
                                                                <TextValueDisplay Value="@change.OldValue" Class="jim-text-code" />
                                                            </MudText>
                                                            <MudText Class="mud-text-secondary">→</MudText>
                                                            <MudText Class="jim-one-line-list-value" title="@change.NewValue">
                                                                <TextValueDisplay Value="@change.NewValue" Class="jim-text-code" />
                                                            </MudText>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        @* Set/Add values get bold emphasis, Removed values get de-emphasised. The code
                                                           face goes on TextValueDisplay's Class, which applies it to a real value only,
                                                           so the hyphen and the "(whitespace)" affordance keep the ordinary face. *@
                                                        var displayValue = GetDisplayValue(change);
                                                        @if (change.DisplayChangeType == "Removed" || change.DisplayChangeType == "Remove")
                                                        {
                                                            <MudText Class="mud-text-secondary jim-one-line-list-value" title="@displayValue">
                                                                <TextValueDisplay Value="@displayValue" Class="jim-text-code" />
                                                            </MudText>
                                                        }
                                                        else
                                                        {
                                                            <MudText Class="jim-one-line-list-value" title="@displayValue">
                                                                <TextValueDisplay Value="@displayValue" Class="jim-text-code" />
                                                            </MudText>
                                                        }
                                                    }
                                                </div>
                                            }
                                            @if (ShouldShowMoreIndicatorForDisplay(changeGroup))
                                            {
                                                <div class="more-changes-indicator">
                                                    <MudChip T="string" Variant="Variant.Filled" Color="Color.Primary">
                                                        +@GetRemainingDisplayChangesCount(changeGroup).ToString("N0") more
                                                    </MudChip>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else if (changeGroup.ChangeType == ObjectChangeType.Deleted)
                                    {
                                        <MudText Class="mud-text-secondary">
                                            Object was deleted. Final attribute values were not captured.
                                        </MudText>
                                    }
                                                </MudStack>
                                            </MudCardContent>
                                        </MudCard>
                                    </ItemContent>
                                </MudTimelineItem>
            }
                            }
                        </MudTimeline>
                    }

                    <!-- Change Details Dialog -->
                    <MudDialog @bind-Visible="_detailsDialogVisible" Options="_dialogOptions">
                        <TitleContent>
                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start">
                                <MudIcon Icon="@GetChangeTypeIcon(_selectedChange?.ChangeType ?? ObjectChangeType.Updated)"
                                         Color="@GetChangeTypeColor(_selectedChange?.ChangeType ?? ObjectChangeType.Updated)" Size="Size.Large"
                                         Style="margin-top: 4px;" />
                                <div>
                                    <MudText Typo="Typo.h6">
                                        @_selectedChange?.ChangeType.ToString().SplitOnCapitalLetters()
                                        @if (_selectedChange?.ChangeType == ObjectChangeType.Joined &&
                                            !string.IsNullOrEmpty(_selectedChange?.CsoExternalId))
                                        {
                                            @(" ")@if (_selectedChange?.CsoId.HasValue == true && _selectedChange?.ConnectedSystemId.HasValue == true)
                                            {
                                                <MudLink
                                                    Href="@Utilities.GetConnectedSystemObjectHref(_selectedChange.ConnectedSystemId!.Value, _selectedChange.CsoId!.Value)">@_selectedChange.CsoExternalId</MudLink>
                                            }
                                            else
                                            {
                                                @_selectedChange?.CsoExternalId
                                            }
                                        }
                                    </MudText>
                                        <MudText Class="mud-text-secondary">
                                            @_selectedChange?.ChangeTime.ToLocalTime().ToFriendlyDate()
                                        </MudText>
                                    </div>
                                </MudStack>
                            </TitleContent>
                            <DialogContent>
                                @if (_selectedChange != null)
                                {
                                    <!-- Initiator Context Section: Who | How | Activity -->
                                    <MudPaper Class="pa-3 mb-4" Outlined="true">
                                        <div style="display: flex; flex-wrap: wrap; gap: 24px;">
                                            <!-- Initiated By (Who) - the principal that triggered the change -->
                                            <div>
                                                <MudText Typo="Typo.button" Class="mud-text-secondary">Initiated By</MudText>
                                                @* Who only: the rule, the how, is the Mechanism beside it. *@
                                                <div>
                                                    <InitiatorChip InitiatedByType="@_selectedChange.InitiatedByType" InitiatedById="@_selectedChange.ChangeInitiatorId"
                                                                   InitiatedByName="@_selectedChange.ChangeInitiatorName" ChangeInitiatorType="@MechanismInitiator(_selectedChange)" />
                                                </div>
                                            </div>

                                            <!-- Mechanism (How) - how the change was triggered -->
                                            <div>
                                                <MudText Typo="Typo.button" Class="mud-text-secondary">Mechanism</MudText>
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                    @GetModalMechanismIcon(_selectedChange)
                                                    @GetModalMechanismText(_selectedChange)
                                                </MudStack>
                                            </div>

                                            <!-- Activity Link -->
                                            @if (_selectedChange.ActivityRunProfileExecutionItemId != null)
                                            {
                                                <div>
                                                    <MudText Typo="Typo.button" Class="mud-text-secondary">Activity</MudText>
                                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                                        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Class="mud-text-secondary" />
                                                        <MudLink Href="@($"/activity/item/{_selectedChange.ActivityRunProfileExecutionItemId}")">View
                                                            Activity</MudLink>
                                                    </MudStack>
                                                </div>
                                            }
                                        </div>
                                    </MudPaper>

                                        @* What the host page knows about this change that the timeline does not *@
                                        @if (ChangeDetailExtra != null)
                                        {
                                            @ChangeDetailExtra(_selectedChange)
                                        }

                                        <!-- Aggregated Summary (shown when more than 1 change) -->
                                        @if (_selectedChange.AttributeChanges.Count > 1)
                                        {
                                            <MudExpansionPanels Elevation="0" Class="mb-4">
                                                <MudExpansionPanel Text="Summary">
                                                    <MudGrid Spacing="2">
                                                        @foreach (var summary in GetAggregatedSummary(_selectedChange))
                                                        {
                                                            <MudItem xs="12" sm="6" md="4">
                                                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                                    <MudText Class="mud-text-secondary" Style="min-width: 120px;">
                                                                        @summary.AttributeName
                                                                    </MudText>
                                                                    @* SVA terminology: Set, Updated, Removed *@
                                                                    @if (summary.SetCount > 0)
                                                                    {
                                                                        <MudChip T="string" Variant="Variant.Text" Color="Color.Success">
                                                                            Set
                                                                        </MudChip>
                                                                    }
                                                                    @if (summary.UpdateCount > 0)
                                                                    {
                                                                        <MudChip T="string" Variant="Variant.Text" Color="Color.Info">
                                                                            Updated
                                                                        </MudChip>
                                                                    }
                                                                    @if (summary.RemovedCount > 0)
                                                                    {
                                                                        <MudChip T="string" Variant="Variant.Text" Color="Color.Error">
                                                                            Removed
                                                                        </MudChip>
                                                                    }
                                                                    @* MVA terminology: Add (+count), Remove (-count) *@
                                                                    @if (summary.AddCount > 0)
                                                                    {
                                                                        <MudChip T="string" Variant="Variant.Text" Color="Color.Success">
                                                                            +@summary.AddCount
                                                                        </MudChip>
                                                                    }
                                                                    @if (summary.RemoveCount > 0)
                                                                    {
                                                                        <MudChip T="string" Variant="Variant.Text" Color="Color.Error">
                                                                            -@summary.RemoveCount
                                                                        </MudChip>
                                                                    }
                                                                </MudStack>
                                                            </MudItem>
                                                        }
                                                    </MudGrid>
                                                </MudExpansionPanel>
                                            </MudExpansionPanels>
                                        }
                                    }
                                    @if (_selectedChange != null && _selectedChange.AttributeChanges.Count > 0)
                                    {
                                        // Captured so the toolbar fragment, a lambda the compiler's null-state
                                        // analysis does not reach into, works against a non-null change group.
                                        var selectedChange = _selectedChange;

                                        @* A grid inside a dialog states its own height ceiling rather than measuring
                                           where the page footer lands (that footer belongs to the page behind the
                                           overlay), and keeps its search and scroll position to itself rather than
                                           writing them into an address bar that outlives the dialog. All three of the
                                           table's filters survive: the grid's own search box replaces the standalone
                                           one, and the attribute and change-type selects sit beside it in the toolbar. *@
                                        <VirtualisedDataGrid @ref="_attributeChangesGrid"
                                                             T="AttributeChangeDisplay"
                                                             ContainerId="change-history-attribute-changes"
                                                             TrackUrlState="false"
                                                             MaxHeight="400px"
                                                             StateKey="@GetSelectedChangeStateKey()"
                                                             DefaultSortBy="@SourceOrderSort"
                                                             LoadWindow="LoadAttributeChangeWindow"
                                                             SearchPlaceholder="Search changes..."
                                                             SingularName="Change"
                                                             PluralName="Changes">
                                            <ToolBarExtras>
                                                <div style="width: 180px;">
                                                    <MudSelect T="string" Value="@_modalFilterAttribute"
                                                               ValueChanged="OnModalFilterAttributeChangedAsync"
                                                               Label="Attribute" Variant="Variant.Outlined"
                                                               Dense="true" Margin="Margin.Dense">
                                                        <MudSelectItem T="string" Value="@((string)null!)">All Attributes</MudSelectItem>
                                                        @foreach (var attr in GetUniqueAttributes(selectedChange))
                                                        {
                                                            <MudSelectItem T="string" Value="@attr">@attr</MudSelectItem>
                                                        }
                                                    </MudSelect>
                                                </div>
                                                <div style="width: 150px;" class="ml-3">
                                                    <MudSelect T="string" Value="@_modalFilterChangeType"
                                                               ValueChanged="OnModalFilterChangeTypeChangedAsync"
                                                               Label="Change type" Variant="Variant.Outlined"
                                                               Dense="true" Margin="Margin.Dense">
                                                        <MudSelectItem T="string" Value="@((string)null!)">All</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("Set")">Set</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("Updated")">Updated</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("Removed")">Removed</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("Add")">Add</MudSelectItem>
                                                        <MudSelectItem T="string" Value="@("Remove")">Remove</MudSelectItem>
                                                    </MudSelect>
                                                </div>
                                            </ToolBarExtras>
                                            <Columns>
                                                <TemplateColumn Title="Change" Sortable="false">
                                                    <HeaderTemplate>
                                                        <MudText Typo="Typo.button">Change</MudText>
                                                    </HeaderTemplate>
                                                    <CellTemplate>
                                                        <MudChip T="string" Variant="Variant.Text" Color="@GetDisplayChangeTypeColor(context.Item)">
                                                            @context.Item.DisplayChangeType
                                                        </MudChip>
                                                    </CellTemplate>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Attribute" Sortable="false">
                                                    <HeaderTemplate>
                                                        <MudText Typo="Typo.button">Attribute</MudText>
                                                    </HeaderTemplate>
                                                    <CellTemplate>
                                                        @* Linked into the attribute's Inspect view (#399) wherever the change carries a
                                                           Metaverse attribute id; plain text everywhere else (no provenance, or the
                                                           attribute has since been deleted). *@
                                                        @if (!string.IsNullOrEmpty(context.Item.AttributeInspectHref))
                                                        {
                                                            <MudLink Href="@context.Item.AttributeInspectHref">@context.Item.AttributeName</MudLink>
                                                        }
                                                        else
                                                        {
                                                            <MudText Class="mud-text-secondary">@context.Item.AttributeName</MudText>
                                                        }
                                                    </CellTemplate>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Source" Sortable="false">
                                                    <HeaderTemplate>
                                                        <MudText Typo="Typo.button">Source</MudText>
                                                    </HeaderTemplate>
                                                    <CellTemplate>
                                                        @* No contributor recorded (change rows from before provenance existed, or a
                                                           caller with no provenance at all) renders nothing rather than "Source not
                                                           recorded", which would otherwise shout on every pre-provenance row. *@
                                                        @if (context.Item.Origin is { } origin)
                                                        {
                                                            <ValueOriginChip Origin="@origin" />
                                                        }
                                                        else
                                                        {
                                                            <EmptyValue />
                                                        }
                                                    </CellTemplate>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Type" Sortable="false">
                                                    <HeaderTemplate>
                                                        <MudText Typo="Typo.button">Type</MudText>
                                                    </HeaderTemplate>
                                                    <CellTemplate>
                                                        <MudText Class="mud-text-secondary">@context.Item.AttributeType</MudText>
                                                    </CellTemplate>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Plurality" Sortable="false">
                                                    <HeaderTemplate>
                                                        <MudText Typo="Typo.button">Plurality</MudText>
                                                    </HeaderTemplate>
                                                    <CellTemplate>
                                                        <MudText Class="mud-text-secondary">
                                                            @(context.Item.IsMultiValued ? "Multi-Valued" : "Single-Valued")
                                                        </MudText>
                                                    </CellTemplate>
                                                </TemplateColumn>
                                                <TemplateColumn Title="Value" Sortable="false">
                                                    <HeaderTemplate>
                                                        <MudText Typo="Typo.button">Value</MudText>
                                                    </HeaderTemplate>
                                                    <CellTemplate>
                                                        <ChangeValueCell Change="@context.Item" />
                                                    </CellTemplate>
                                                </TemplateColumn>
                                            </Columns>
                                            <EmptyContent Context="grid">
                                                @if (!string.IsNullOrWhiteSpace(grid.SearchText)
                                                     || !string.IsNullOrEmpty(_modalFilterAttribute)
                                                     || !string.IsNullOrEmpty(_modalFilterChangeType))
                                                {
                                                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                                                     PrimaryText="No changes match the current filters"
                                                                     SecondaryText="Try a different search term, or widen the attribute and change type filters."
                                                                     ActionText="Clear Filters"
                                                                     OnAction="@(() => ClearModalFiltersAsync(grid))" />
                                                }
                                                else
                                                {
                                                    <TableEmptyState Icon="@Icons.Material.Filled.List"
                                                                     PrimaryText="There is nothing to show for these attribute changes" />
                                                }
                                            </EmptyContent>
                                        </VirtualisedDataGrid>
                                    }
                                            else if (_selectedChange?.ChangeType == ObjectChangeType.Deleted)
                                            {
                                                <MudText Class="mud-text-secondary">
                                                    Object was deleted. Final attribute values were not captured.
                                                </MudText>
                                            }
                                            else
                                            {
                                                <MudText Class="mud-text-secondary">
                                                    No attribute changes were recorded for this operation.
                                                </MudText>
                                            }
                                        </DialogContent>
                                        <DialogActions>
                                            <MudButton OnClick="CloseDetailsDialog">Close</MudButton>
                                        </DialogActions>
                                    </MudDialog>

                                    <style>
                                        /* The summary grid inside a change card: attribute name, change
                                           type, value. The value track is minmax(0, 1fr) rather than 1fr so
                                           that it can shrink below its own content: a grid item's automatic
                                           minimum is its min-content width, which an unbroken Distinguished
                                           Name would otherwise force the whole card to accommodate, and the
                                           one-line clamp on the value would never get to engage. */
                                        .change-summary {
                                            position: relative;
                                            display: grid;
                                            grid-template-columns: auto auto minmax(0, 1fr);
                                            align-items: center;
                                            gap: 4px 8px;
                                        }

                                        /* The attribute name labels the row, so it holds its width and the
                                           value beside it is what gives way. */
                                        .change-summary-attribute {
                                            white-space: nowrap;
                                        }

                                        .more-changes-indicator {
                                            margin-top: 4px;
                                        }

                                        .cursor-pointer {
                                            cursor: pointer;
                                        }

                                        /* The hover colour must be opaque, and identical on the card body and the
                                           arrow's ::after fill, for the two to render as one contiguous shape: the
                                           timeline arrow is two stacked border-triangles (::before draws the opaque
                                           outline, ::after the fill, and the fill also covers the card's left border
                                           at the seam), so a translucent hover colour composites differently over
                                           each layer and the arrow visibly detaches from the card. Hence a Material
                                           state layer computed as an opaque colour: 8% of the text colour over the
                                           card's resting fill, which follows every theme automatically. */
                                        .change-card {
                                            --jim-change-card-resting: var(--jim-inner-surface, var(--mud-palette-surface));
                                            --jim-change-card-hover: color-mix(in srgb,
                                                var(--mud-palette-text-primary) 8%,
                                                var(--jim-change-card-resting));
                                        }

                                        /* Inside dialogs the resting fill is the dialog inner surface (site.css). */
                                        .mud-dialog .change-card {
                                            --jim-change-card-resting: var(--jim-dialog-inner-surface, var(--mud-palette-surface));
                                        }

                                        /* The html[lang] qualifier and !important are load-bearing: the cards' resting
