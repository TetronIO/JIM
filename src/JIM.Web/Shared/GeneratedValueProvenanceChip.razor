@* The small provenance chip an attribute row wears when its committed value came from Unique Value Generation
   (#242, Phase 3, Work Package D2; approved mockup screen 04): "Generated by JIM", or "Adopted by JIM" when
   the value was adopted from an existing accepted value rather than generated (plan decision 5, "adopt before
   generate"). Clicking it opens a small menu: "Open Synchronisation Rule" (the rule whose mapping produced the
   value) and, where the page carries a change history to link to, "View history". No "Generate a new value"
   action here: that is deferred to internal Metaverse Object management (#614). This is the first consumer of
   #399's provenance display, per the plan; it does not attempt to be that display itself. *@

<MudMenu data-testid="jim-generated-value-chip-menu">
    <ActivatorContent>
        @* A custom ActivatorContent is not wired to the menu automatically; MudMenu's own docs pattern is
           OnClick="@context.ToggleAsync" on the activator element itself (MenuContext, passed as `context`). *@
        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Class="@Class" OnClick="@context.ToggleAsync"
                 data-testid="jim-generated-value-chip">
            @(Assignment.Adopted ? "Adopted by JIM" : "Generated by JIM")
        </MudChip>
    </ActivatorContent>
    <ChildContent>
        <MudMenuItem Href="@($"/admin/sync-rules/{Assignment.SyncRuleId}")" data-testid="jim-generated-value-chip-open-rule">
            Open Synchronisation Rule
        </MudMenuItem>
        @if (ShowHistoryLink)
        {
            <MudMenuItem Href="@HistoryHref" data-testid="jim-generated-value-chip-view-history">View history</MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    /// <summary>The committed assignment this chip describes.</summary>
    [Parameter, EditorRequired]
    public GeneratedValueAssignmentHeader Assignment { get; set; } = null!;

    /// <summary>
    /// Whether to offer "View history". True by default: every current call site (the Metaverse Object page's
    /// Details tab) carries an object-level change history (its "Changes" tab) even though no attribute-scoped
    /// one exists yet (#399); pass false from a page that carries neither.
    /// </summary>
    [Parameter]
    public bool ShowHistoryLink { get; set; } = true;

    /// <summary>Additional CSS classes for the chip, for the surrounding geometry only.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The current page's own URL with its query replaced by <c>?t=changes</c>, matching the slug
    /// <c>NavigableMudTabs</c> gives the "Changes" tab (its text, lower-cased).
    /// </summary>
    private string HistoryHref => $"{NavManager.Uri.Split('?')[0]}?t=changes";
}
