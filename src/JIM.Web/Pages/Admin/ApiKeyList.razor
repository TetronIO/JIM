<PageTitle>API Keys</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Api" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />API Keys</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    Manage API keys for non-interactive authentication. API keys can be used for CI/CD pipelines,
    integration testing, and automation scripts.
</MudText>

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the density toggle, the search box
   and the toolbar count) lives in the shared grid; this page loads the full list once (API keys are a small
   configuration list) and slices windows from it in memory. *@
<VirtualisedDataGrid @ref="_grid" T="ApiKey"
                     ContainerId="api-key-list"
                     DefaultSortBy="name"
                     LoadWindow="LoadApiKeyWindowAsync"
                     SingularName="API Key"
                     PluralName="API Keys">
    <ToolBarExtras>
        <MudButton OnClick="ShowCreateDialog" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                   DropShadow="false">Create API Key</MudButton>
    </ToolBarExtras>
    <Columns>
        <TemplateColumn Title="Name" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Name" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                <div class="d-flex align-center gap-2">
                    <MudLink Href="@($"/admin/apikeys/{context.Item.Id}")">@context.Item.Name</MudLink>
                    @if (context.Item.IsInfrastructureKey)
                    {
                        <MudTooltip Text="Infrastructure key auto-created from the JIM_INFRASTRUCTURE_API_KEY environment variable." Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Warning" Icon="@Icons.Material.Filled.Construction">Infrastructure</MudChip>
                        </MudTooltip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Key Prefix" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Key Prefix" Name="prefix" />
            </HeaderTemplate>
            <CellTemplate>
                <span class="jim-text-code">@context.Item.KeyPrefix...</span>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Roles" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Roles</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @foreach (var role in context.Item.Roles)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Info" Class="mr-1">@role.Name</MudChip>
                }
                @if (context.Item.Roles.Count == 0)
                {
                    <span class="mud-text-secondary">No roles</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Last Used" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Last Used" Name="lastused" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.LastUsedAt.HasValue)
                {
                    var lastUsed = context.Item.LastUsedAt.Value.ToLocalTime();
                    <MudTooltip Text="@($"{lastUsed.ToFriendlyDate()} from IP: {context.Item.LastUsedFromIp ?? "Unknown"}")" Arrow="true" Placement="Placement.Top">
                        @lastUsed.ToRelativeTime()
                    </MudTooltip>
                }
                else
                {
                    <span class="mud-text-secondary">Never</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Expires" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Expires" Name="expires" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.ExpiresAt.HasValue)
                {
                    var expiresAt = context.Item.ExpiresAt.Value;
                    @if (expiresAt < DateTime.UtcNow)
                    {
                        <MudTooltip Text="@expiresAt.ToLocalTime().ToFriendlyDate()"
                            Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Error">Expired</MudChip>
                        </MudTooltip>
                    }
                    else if (expiresAt < DateTime.UtcNow.AddDays(7))
                    {
                        <MudTooltip Text="@expiresAt.ToLocalTime().ToFriendlyDate()"
                            Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Warning">@((expiresAt - DateTime.UtcNow).Humanize(precision: 2, minUnit: Humanizer.TimeUnit.Minute))</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="@expiresAt.ToLocalTime().ToFriendlyDate()"
                            Arrow="true" Placement="Placement.Top">
                            @expiresAt.ToLocalTime().ToFriendlyDate()
                        </MudTooltip>
                    }
                }
                else
                {
                    <span class="mud-text-secondary">Never</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Status" Name="status" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.IsEnabled)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Success">Enabled</MudChip>
                }
                else
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Default">Disabled</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Actions</MudText>
            </HeaderTemplate>
            <CellTemplate>
                <div class="d-flex justify-end gap-2">
                    <MudTooltip Text="Edit" Arrow="true" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Variant="Variant.Filled" Size="Size.Small" OnClick="_ => ShowEditDialog(context.Item)" />
                    </MudTooltip>
                    <MudTooltip Text="Delete" Arrow="true" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Variant="Variant.Filled" Size="Size.Small" Color="Color.Error" OnClick="_ => HandleDeleteAsync(context.Item)" />
                    </MudTooltip>
                </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No API Keys match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.Api"
                             PrimaryText="No API Keys have been created yet"
                             SecondaryText="Use the Create API Key button to create one." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@* Create API Key Dialog *@
<MudDialog @bind-Visible="_createDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Key" Class="mr-3" /> Create API Key
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_createName" Label="Name" Required="true"
            RequiredError="A name is required" Immediate="true" Variant="Variant.Outlined" Class="mt-3"
            HelperText="A friendly name for this API key (e.g., 'CI/CD Pipeline')" />
        <MudTextField T="string" @bind-Value="_createDescription" Label="Description" Lines="2" MaxLines="6" Sizing="InputSizing.Auto"
            Variant="Variant.Outlined" Class="mt-4" HelperText="Optional description of what this key is used for" />
        <MudText Typo="Typo.subtitle2" Class="mt-5 mb-2">Roles</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
            Select the roles to assign to this API key. Roles determine what actions the key can perform.
        </MudText>
        @foreach (var role in _availableRoles)
        {
            <MudCheckBox T="bool" Value="@_createSelectedRoleIds.Contains(role.Id)"
                ValueChanged="@(value => ToggleRole(role.Id, value))" Label="@role.Name" Class="ml-n2" />
        }
        <MudDatePicker @bind-Date="_createExpiresAt" Label="Expires (Optional)" Variant="Variant.Outlined" Class="mt-4"
            HelperText="Leave empty for no expiration" Clearable="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _createDialogVisible = false" DropShadow="false">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            Disabled="@(string.IsNullOrWhiteSpace(_createName) || _creating)" OnClick="HandleCreateAsync">
            @if (_creating)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">Creating</span>
            }
            else
            {
                <text>Create</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* Created Key Dialog (shows full key once) *@
<MudDialog @bind-Visible="_createdKeyDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-3" /> API Key Created
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4">
            Copy this API key now. It will not be possible to show it again.
        </MudAlert>
        <MudTextField T="string" Value="@_createdFullKey" Label="API Key" ReadOnly="true" Variant="Variant.Outlined"
            Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
            OnAdornmentClick="CopyKeyToClipboard" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            Use this key in the X-API-Key header when making API requests.
        </MudText>
        <MudText Typo="Typo.body2" Class="mt-4">
            <strong>Example usage:</strong>
        </MudText>
        <pre class="jim-code-block mt-2"><code>@((MarkupString)Helpers.HighlightShell(ExampleCurlCommand, ShellLanguage.Bash))</code></pre>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            OnClick="() => _createdKeyDialogVisible = false">Done</MudButton>
    </DialogActions>
</MudDialog>

@* Edit API Key Dialog *@
<MudDialog @bind-Visible="_editDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" /> Edit API Key
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_editName" Label="Name" Required="true" RequiredError="A name is required"
            Immediate="true" Variant="Variant.Outlined" Class="mt-3" />
        <MudTextField T="string" @bind-Value="_editDescription" Label="Description" Lines="2" MaxLines="6" Sizing="InputSizing.Auto" Variant="Variant.Outlined"
            Class="mt-4" />
        <MudText Typo="Typo.subtitle2" Class="mt-5 mb-2">Roles</MudText>
        @foreach (var role in _availableRoles)
        {
            <MudCheckBox T="bool" Value="@_editSelectedRoleIds.Contains(role.Id)"
                ValueChanged="@(value => ToggleEditRole(role.Id, value))" Label="@role.Name" Class="ml-n2" />
        }
        <MudDatePicker @bind-Date="_editExpiresAt" Label="Expires (Optional)" Variant="Variant.Outlined" Class="mt-4"
            HelperText="Leave empty for no expiration" Clearable="true" />
        <MudSwitch @bind-Value="_editEnabled" Color="Color.Primary" Label="Enabled" Class="mt-4" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editDialogVisible = false" DropShadow="false">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            Disabled="@(string.IsNullOrWhiteSpace(_editName) || _saving)" OnClick="HandleSaveEditAsync">
            @if (_saving)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">Saving</span>
            }
            else
            {
                <text>Save Changes</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<ApiKey>? _apiKeys;
    private List<Role> _availableRoles = new();
    private VirtualisedDataGrid<ApiKey>? _grid;

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Administration", href: "/admin"),
        new("API Keys", href: null, disabled: true)
    };

    private readonly DialogOptions _dialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };

    // Create dialog
    private bool _createDialogVisible;
    private string _createName = "";
    private string _createDescription = "";
    private List<int> _createSelectedRoleIds = new();
    private DateTime? _createExpiresAt;
    private bool _creating;

    // Created key dialog
    private bool _createdKeyDialogVisible;
    private string _createdFullKey = "";

    // The example request shown (syntax-highlighted) in the created-key dialog. '\' before the
    // newline is a bash line continuation.
    private string ExampleCurlCommand =>
        $"curl -H \"X-API-Key: {_createdFullKey}\" \\\n  https://your-jim-server/api/v1/metaverse/objects";

    // Edit dialog
    private bool _editDialogVisible;
    private ApiKey? _editingKey;
    private string _editName = "";
    private string _editDescription = "";
    private List<int> _editSelectedRoleIds = new();
    private DateTime? _editExpiresAt;
    private bool _editEnabled;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        using var jim = JimFactory.Create();
        _apiKeys = await jim.Security.GetApiKeysAsync();
        _availableRoles = await jim.Security.GetRolesAsync();
    }

    /// <summary>
    /// Reloads the list from the database and refreshes the grid after any action that changes it (create, edit,
    /// delete), so the rows and the toolbar count stay honest.
    /// </summary>
    private async Task ReloadListAsync()
    {
        await LoadDataAsync();
        if (_grid != null)
            await _grid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Slices one window of API keys from the in-memory list, applying the grid's search (name, key prefix,
    /// description; the same fields the old table filtered) and sort. API keys are a small configuration list,
    /// so there is no repository range read; the full list is loaded once and windowed here.
    /// </summary>
    private Task<VirtualisedWindow<ApiKey>> LoadApiKeyWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<ApiKey> keys = _apiKeys ?? Enumerable.Empty<ApiKey>();

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            keys = keys.Where(k =>
                k.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                k.KeyPrefix.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                k.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) == true);
        }

        IOrderedEnumerable<ApiKey> Order<TKey>(Func<ApiKey, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? keys.OrderByDescending(key, comparer) : keys.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "prefix" => Order(k => k.KeyPrefix, StringComparer.OrdinalIgnoreCase),
            "lastused" => Order(k => k.LastUsedAt ?? DateTime.MinValue),
            "expires" => Order(k => k.ExpiresAt ?? DateTime.MaxValue),
            "status" => Order(k => k.IsEnabled),
            _ => Order(k => k.Name, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    private void ShowCreateDialog()
    {
        _createName = "";
        _createDescription = "";
        _createSelectedRoleIds = new List<int>();
        _createExpiresAt = null;
        _createDialogVisible = true;
    }

    private void ToggleRole(int roleId, bool selected)
    {
        if (selected && !_createSelectedRoleIds.Contains(roleId))
            _createSelectedRoleIds.Add(roleId);
        else if (!selected)
            _createSelectedRoleIds.Remove(roleId);
    }

    private void ToggleEditRole(int roleId, bool selected)
    {
        if (selected && !_editSelectedRoleIds.Contains(roleId))
            _editSelectedRoleIds.Add(roleId);
        else if (!selected)
            _editSelectedRoleIds.Remove(roleId);
    }

    private async Task HandleCreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_createName))
            return;

        _creating = true;
        StateHasChanged();

        try
        {
            // offer an optional reason for the configuration change history; cancelling aborts the create
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Create");
            if (cancelled)
                return;

            // Generate the API key
            var (fullKey, keyPrefix) = ApiKeyAuthenticationHandler.GenerateApiKey();
            var keyHash = ApiKeyAuthenticationHandler.HashApiKey(fullKey);

            // Get the roles
            var roles = _availableRoles.Where(r => _createSelectedRoleIds.Contains(r.Id)).ToList();

            // Create the API key entity
            var apiKey = new ApiKey
            {
                Id = Guid.NewGuid(),
                Name = _createName,
                Description = string.IsNullOrWhiteSpace(_createDescription) ? null : _createDescription,
                KeyHash = keyHash,
                KeyPrefix = keyPrefix,
                ExpiresAt = _createExpiresAt?.ToUniversalTime(),
                Roles = roles
            };

            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Security.CreateApiKeyAsync(apiKey, user, changeReason);

            Snackbar.Add("API key created successfully.", Severity.Success);
            _createDialogVisible = false;

            // Show the created key dialog
            _createdFullKey = fullKey;
            _createdKeyDialogVisible = true;

            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to create API key: {ex.Message}", Severity.Error);
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task CopyKeyToClipboard()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _createdFullKey);
            Snackbar.Add("API key copied to clipboard.", Severity.Info);
        }
        catch
        {
            Snackbar.Add("Failed to copy to clipboard. Please copy manually.", Severity.Warning);
        }
    }

    private void ShowEditDialog(ApiKey apiKey)
    {
        _editingKey = apiKey;
        _editName = apiKey.Name;
        _editDescription = apiKey.Description ?? "";
        _editSelectedRoleIds = apiKey.Roles.Select(r => r.Id).ToList();
        _editExpiresAt = apiKey.ExpiresAt?.ToLocalTime();
        _editEnabled = apiKey.IsEnabled;
        _editDialogVisible = true;
    }

    private async Task HandleSaveEditAsync()
    {
        if (_editingKey == null || string.IsNullOrWhiteSpace(_editName))
            return;

        _saving = true;
        StateHasChanged();

        try
        {
            // offer an optional reason for the configuration change history; cancelling aborts the save
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
            if (cancelled)
                return;

            // Create a new ApiKey object with updated values to avoid EF tracking issues
            // The repository will fetch the actual entity and update it
            var updatedKey = new ApiKey
            {
                Id = _editingKey.Id,
                Name = _editName,
                Description = string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription,
                ExpiresAt = _editExpiresAt?.ToUniversalTime(),
                IsEnabled = _editEnabled,
                // Create stub Role objects with just IDs - the repository will fetch the real ones
                Roles = _editSelectedRoleIds.Select(id => new Role { Id = id }).ToList()
            };

            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Security.UpdateApiKeyAsync(updatedKey, user, changeReason);

            Snackbar.Add("API key updated successfully.", Severity.Success);
            _editDialogVisible = false;
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update API key: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleDeleteAsync(ApiKey apiKey)
    {
        var result = await DialogService.ShowMessageBoxAsync(
        "Delete API Key",
        $"Are you sure you want to delete the API key '{apiKey.Name}'? Any requests using this key will immediately fail.",
        yesText: "Delete",
        cancelText: "Cancel");

        if (result != true)
            return;

        // offer an optional reason for the configuration change history; cancelling aborts the delete
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Delete");
        if (cancelled)
            return;

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Security.DeleteApiKeyAsync(apiKey.Id, user, changeReason);

            Snackbar.Add("API key deleted successfully.", Severity.Success);
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete API key: {ex.Message}", Severity.Error);
        }
    }
}
