@* ─── Initial Password ─── *@
<MudExpansionPanels Elevation="0" Class="mt-5 jim-expansion-panel">
    <MudExpansionPanel Expanded="@(Configuration.Enabled)">
        <TitleContent>
            <div class="d-flex align-center">
                <MudIcon Icon="@Icons.Material.Filled.Password" Class="me-2" />
                <MudText Typo="Typo.subtitle1">Initial Password</MudText>
                @if (Configuration.Enabled)
                {
                    <MudChip T="string" Class="ms-3" Color="Color.Primary" Variant="Variant.Text">On</MudChip>
                }
            </div>
        </TitleContent>
        <ChildContent>
            <div class="pa-2">
                @if (!ConnectorCanSetPasswords)
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        The @ConnectorName Connector cannot set passwords, so JIM cannot give the accounts this
                        Synchronisation Rule provisions an initial password.
                    </MudAlert>
                }
                else
                {
                    <MudSwitch @bind-Value="@Configuration.Enabled" @bind-Value:after="NotifyChangedAsync" Color="Color.Primary"
                               Label="Set an initial password on accounts this Synchronisation Rule provisions?" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">A newly provisioned account has no
                        password and cannot be signed in to. Enabling this has JIM generate one per account and set it
                        through the Connected System's password channel, straight after the account is created. The
                        password is generated at the moment it is set and is never stored by JIM.</MudText>

                    @if (Configuration.Enabled)
                    {
                        <MudDivider Class="my-5" />

                        @* ─── Where the settings come from ─── *@
                        <MudText Typo="Typo.body1">Password Settings</MudText>
                        <MudRadioGroup T="InitialPasswordSource" @bind-Value="@Configuration.Source" @bind-Value:after="NotifyChangedAsync">
                            <div class="mt-1">
                                <MudRadio T="InitialPasswordSource" Value="InitialPasswordSource.Discovered" Color="Color.Primary">Follow the Connected System</MudRadio>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">JIM derives the settings from the
                                    password policy it discovered on the Connected System, and re-derives them whenever that
                                    policy is read again. Nothing to configure, and nothing to keep in step by hand.</MudText>
                            </div>
                            <div class="mt-2">
                                <MudRadio T="InitialPasswordSource" Value="InitialPasswordSource.Custom" Color="Color.Primary">Custom</MudRadio>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">Exactly the settings saved here.
                                    JIM will not change them because the Connected System published something different,
                                    but it will still tell you when they cannot satisfy it.</MudText>
                            </div>
                        </MudRadioGroup>

                        @if (Configuration.Source == InitialPasswordSource.Discovered && DiscoveredPolicy == null)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                                JIM has not discovered a password policy on this Connected System, either because the
                                Connector cannot read one or because the schema has not been imported since the
                                capability was added. JIM's own defaults apply until it does.
                            </MudAlert>
                        }

                        @if (Configuration.Source == InitialPasswordSource.Custom)
                        {
                            <MudDivider Class="my-5" />
                            @* ─── Generator settings ─── *@
                            <MudSelect T="PasswordGenerationStyle" Label="Style" @bind-Value="@Configuration.CustomPolicy.Style"
                                       @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                                <MudSelectItem Value="PasswordGenerationStyle.RandomCharacters">Random characters (t7Rm#qK4vHx2Ndbf)</MudSelectItem>
                                <MudSelectItem Value="PasswordGenerationStyle.Words">Words (Brown-Chicken-Ladder-47)</MudSelectItem>
                                <MudSelectItem Value="PasswordGenerationStyle.Pronounceable">Pronounceable (tovanic-hupelo-92)</MudSelectItem>
                            </MudSelect>

                            @if (Configuration.CustomPolicy.Style != PasswordGenerationStyle.Words)
                            {
                                <MudNumericField T="int" Label="Length" @bind-Value="@Configuration.CustomPolicy.Length"
                                                 @bind-Value:after="NotifyChangedAsync" Min="1" Max="256" Immediate="true"
                                                 Variant="Variant.Outlined" Class="mt-4" />
                            }

                            @if (Configuration.CustomPolicy.Style == PasswordGenerationStyle.RandomCharacters)
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="Minimum uppercase" @bind-Value="@Configuration.CustomPolicy.MinimumUppercase"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="Minimum lowercase" @bind-Value="@Configuration.CustomPolicy.MinimumLowercase"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="Minimum digits" @bind-Value="@Configuration.CustomPolicy.MinimumDigits"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="3">
                                        <MudNumericField T="int" Label="Minimum symbols" @bind-Value="@Configuration.CustomPolicy.MinimumSymbols"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="64" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                </MudGrid>
                            }

                            @if (Configuration.CustomPolicy.Style == PasswordGenerationStyle.Words)
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="4">
                                        <MudNumericField T="int" Label="Number of words" @bind-Value="@Configuration.CustomPolicy.WordCount"
                                                         @bind-Value:after="NotifyChangedAsync" Min="1" Max="16" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudSelect T="PasswordWordSeparator" Label="Separator" @bind-Value="@Configuration.CustomPolicy.WordSeparator"
                                                   @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                                            <MudSelectItem Value="PasswordWordSeparator.None">None</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.Hyphen">Hyphen</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.FullStop">Full stop</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.Underscore">Underscore</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.Digit">Digit</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordSeparator.RandomSymbol">Random symbol</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="4">
                                        <MudSelect T="PasswordWordCapitalisation" Label="Capitalisation" @bind-Value="@Configuration.CustomPolicy.WordCapitalisation"
                                                   @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                                            <MudSelectItem Value="PasswordWordCapitalisation.Lowercase">Lowercase</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.EachWord">Each word</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.Uppercase">Uppercase</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.FirstWordOnly">First word only</MudSelectItem>
                                            <MudSelectItem Value="PasswordWordCapitalisation.RandomWord">One random word</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            }

                            @if (Configuration.CustomPolicy.Style != PasswordGenerationStyle.RandomCharacters)
                            {
                                <MudGrid Class="mt-1">
                                    <MudItem xs="4">
                                        <MudNumericField T="int" Label="Appended digits" @bind-Value="@Configuration.CustomPolicy.AppendedDigitCount"
                                                         @bind-Value:after="NotifyChangedAsync" Min="0" Max="16" Immediate="true" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="8" Class="d-flex align-center">
                                        <MudSwitch @bind-Value="@Configuration.CustomPolicy.AppendSymbol" @bind-Value:after="NotifyChangedAsync"
                                                   Color="Color.Primary" Label="Append a symbol" />
                                    </MudItem>
                                </MudGrid>
                            }

                            <MudTextField T="string" Label="Permitted symbols" @bind-Value="@Configuration.CustomPolicy.PermittedSymbols"
                                          @bind-Value:after="NotifyChangedAsync" Immediate="true" Variant="Variant.Outlined" Class="mt-4" />
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">The symbols JIM may use. Narrow this
                                where something downstream of the Connected System cannot cope with a particular character.</MudText>

                            <MudSwitch Class="mt-4" @bind-Value="@Configuration.CustomPolicy.ExcludeAmbiguousCharacters"
                                       @bind-Value:after="NotifyChangedAsync" Color="Color.Primary"
                                       Label="Leave out easily confused characters" />
                            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">Excludes
                                @PasswordGenerationPolicy.AmbiguousCharacters, which are hard to tell apart when a password
                                is read out or copied by hand. An initial password is transcribed far more often than a
                                permanent one.</MudText>
                        }

                        @* ─── What this configuration produces ─── *@
                        @if (Assessment != null)
                        {
                            var assessment = Assessment;
                            <MudAlert Severity="@(assessment.IsUsable ? Severity.Success : Severity.Error)" Variant="Variant.Outlined" Class="mt-5">
                                @if (assessment.IsUsable)
                                {
                                    <MudText Typo="Typo.body1">Every generated password will be at least
                                        @assessment.GuaranteedMinimumLength characters, cover
                                        @assessment.GuaranteedCharacterClassCount of the four character categories, and carry at
                                        least @assessment.EntropyBits.ToString("F1") bits of entropy.</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body1">These settings cannot be used:</MudText>
                                    <ul class="mt-1">
                                        @foreach (var problem in assessment.Problems)
                                        {
                                            <li>@problem</li>
                                        }
                                    </ul>
                                }
                            </MudAlert>
                        }

                        <MudDivider Class="my-5" />

                        @* ─── What happens to the account ─── *@
                        <MudSelect T="PasswordExpiryBehaviour" Label="After the password is set" @bind-Value="@Configuration.ExpiryBehaviour"
                                   @bind-Value:after="NotifyChangedAsync" Variant="Variant.Outlined">
                            @foreach (var behaviour in SupportedExpiryBehaviours)
                            {
                                <MudSelectItem Value="behaviour">@DescribeExpiryBehaviour(behaviour)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">Only what the @ConnectorName Connector
                            can apply is offered. Where a particular target cannot honour the choice, JIM records what it
                            applied instead rather than assuming the request was met.</MudText>

                        <MudSwitch Class="mt-4" @bind-Value="@Configuration.EnableAccount" @bind-Value:after="NotifyChangedAsync"
                                   Color="Color.Primary" Label="Enable the account once the password is set" />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">Directories that refuse to enable an
                            account without a compliant password need the password first, which is why this belongs here
                            rather than in an Attribute Flow. Turn it off where accounts are enabled by a separate process.</MudText>
                    }
                }
            </div>
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    /// <summary>
    /// The Synchronisation Rule's initial-password configuration, mutated in place. The parent owns creating it
    /// so that the rule's saved graph and this editor are never looking at two different objects.
    /// </summary>
    [Parameter]
    public SyncRuleInitialPassword Configuration { get; set; } = null!;

    /// <summary>
    /// The password policy JIM discovered on the Connected System, or null where none was discovered.
    /// </summary>
    [Parameter]
    public ConnectedSystemPasswordPolicy? DiscoveredPolicy { get; set; }

    /// <summary>
    /// What the Connected System's Connector can actually apply once the password is set. Empty means it cannot
    /// set passwords at all.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<PasswordExpiryBehaviour> SupportedExpiryBehaviours { get; set; } = [];

    /// <summary>
    /// What the current settings would produce, recomputed by the parent on every change. Null before the first
    /// assessment has been made.
    /// </summary>
    [Parameter]
    public PasswordGenerationAssessment? Assessment { get; set; }

    [Parameter]
    public string ConnectorName { get; set; } = "Connected System's";

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool ConnectorCanSetPasswords => SupportedExpiryBehaviours.Count > 0;

    private async Task NotifyChangedAsync()
    {
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Describes an expiry behaviour in terms of what happens to the person using the account, rather than
    /// naming the directory attribute that implements it.
    /// </summary>
    private static string DescribeExpiryBehaviour(PasswordExpiryBehaviour behaviour) => behaviour switch
    {
        PasswordExpiryBehaviour.RequireChangeAtNextSignIn => "Require a change at the next sign-in",
        PasswordExpiryBehaviour.ExpiresAccordingToTargetPolicy => "Age according to the Connected System's own policy",
        PasswordExpiryBehaviour.NeverExpires => "Never expires",
        _ => behaviour.ToString()
    };
}
