<MudText Class="mud-text-secondary">
    When a password changes for an identity, JIM delivers it to every Connected System configured and enabled
    here, retrying automatically if the system is unavailable. Passwords are held encrypted until they are
    delivered and are never readable, shown in a preview, or written to a change record.
</MudText>

@if (_editor == null)
{
    <MudSkeleton Class="mt-5" Height="200px" />
}
else
{
    <MudSwitch T="bool" @bind-Value="_editor.Enabled" Color="Color.Primary" Class="mt-5"
               Label="Deliver password changes to this Connected System" />

    <MudText Typo="Typo.body2" Class="mud-text-secondary ml-12" Style="margin-top: -8px;">
        @if (_editor.Enabled)
        {
            <text>
                Password changes are delivered as they happen. Switching this off does not discard them: they
                queue up and are delivered when you switch it back on.
            </text>
        }
        else
        {
            <text>
                Password changes for identities with an account here are queued but not delivered. Switch this
                on to deliver everything that has accumulated, oldest first.
            </text>
        }
    </MudText>

    <MudSelect T="int" @bind-Value="_editor.TargetObjectTypeId" Class="mt-6"
               Label="Object Type holding user accounts" Variant="Variant.Outlined" Required="true"
               HelperText="The Connected System Object Type whose objects receive passwords.">
        @foreach (var objectType in SelectableObjectTypes())
        {
            <MudSelectItem T="int" Value="@objectType.Id">@objectType.Name</MudSelectItem>
        }
    </MudSelect>

    <MudText Typo="Typo.h6" Class="mt-8">Delivery</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        How hard JIM tries before it stops and asks you to look. A password change that runs out of attempts is
        kept and stays retryable; it is never silently dropped.
    </MudText>

    <div class="d-flex gap-4 mt-4 flex-wrap">
        <MudNumericField T="int" @bind-Value="_editor.MaxRetries" Label="Maximum attempts"
                         Variant="Variant.Outlined" Min="0" Max="100" Style="max-width: 220px;"
                         HelperText="@($"0 uses JIM's default of {ConnectedSystemPasswordSynchronisation.DefaultMaxRetries}.")" />

        <MudNumericField T="int" @bind-Value="BackoffMinutes" Label="First retry after (minutes)"
                         Variant="Variant.Outlined" Min="0" Max="1440" Style="max-width: 260px;"
                         HelperText="Each further attempt waits twice as long as the one before." />
    </div>

    <MudSwitch T="bool" @bind-Value="_editor.RequireSecureTransport" Color="Color.Primary" Class="mt-6"
               Label="Only send passwords over an encrypted connection" />

    <MudText Typo="Typo.body2" Class="mud-text-secondary ml-12" Style="margin-top: -8px;">
        JIM cannot always tell an encrypted connection from an unencrypted one; a signed and sealed bind is
        encrypted but does not look it from the Connected System's settings. Leave this off unless you know this
        system's connection is encrypted, and turn it on to have JIM refuse to transmit rather than warn.
    </MudText>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-6">
        A queued password change waits <strong>@FormatTimeToLive()</strong> for this system before JIM expires it
        rather than delivering a password that has since been superseded. Change that on the Settings tab; it is
        shared with initial password provisioning.
    </MudAlert>

    @if (_problems.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-6">
            <MudText Typo="Typo.body2"><strong>These settings cannot be saved:</strong></MudText>
            <ul class="mt-1 mb-0">
                @foreach (var problem in _problems)
                {
                    <li><MudText Typo="Typo.body2">@problem</MudText></li>
                }
            </ul>
        </MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6"
               Disabled="@(_saving || !HasChanges())" OnClick="SaveAsync">
        @(_saving ? "Saving..." : "Save")
    </MudButton>
}

@code {
    [Parameter]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [Parameter]
    public EventCallback OnConnectedSystemChanged { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// The configuration being edited. A Connected System with none yet gets a fresh one here rather than on
    /// save, so the form has something to bind to and an administrator sees the defaults they are agreeing to.
    /// </summary>
    private ConnectedSystemPasswordSynchronisation? _editor;

    /// <summary>
    /// What was saved, for telling an edit from an untouched form. The editor mutates its instance in place, so
    /// without a copy taken up front there is nothing left to compare against.
    /// </summary>
    private ConnectedSystemPasswordSynchronisation? _asSaved;

    /// <summary>
    /// The Connected System instance this tab last bound to, so a page reload that hands over a freshly loaded
    /// instance rebinds rather than leaving the editor pointed at a stale one.
    /// </summary>
    private ConnectedSystem? _boundTo;

    private IReadOnlyList<string> _problems = [];
    private bool _saving;

    /// <summary>
    /// The backoff base in whole minutes. Bound rather than exposing a TimeSpan field, because a duration typed
    /// as text is a worse experience than a number with its unit in the label, and minutes is the granularity
    /// this setting is actually chosen in.
    /// </summary>
    private int BackoffMinutes
    {
        get => _editor == null ? 0 : (int)Math.Round(_editor.RetryBackoffBase.TotalMinutes);
        set
        {
            if (_editor != null)
                _editor.RetryBackoffBase = TimeSpan.FromMinutes(Math.Max(value, 0));
        }
    }

    protected override void OnParametersSet()
    {
        // Rebound whenever the page reloads the Connected System, so a save elsewhere on the page does not
        // leave this tab editing a stale instance.
        if (_editor != null && ReferenceEquals(_boundTo, ConnectedSystem))
            return;

        var stored = ConnectedSystem.PasswordSynchronisation;

        _editor = stored ?? new ConnectedSystemPasswordSynchronisation
        {
            ConnectedSystemId = ConnectedSystem.Id,
            TargetObjectTypeId = DefaultObjectTypeId()
        };

        _asSaved = _editor.SnapshotDeliverySettings();
        _boundTo = ConnectedSystem;
        _problems = [];
    }

    /// <summary>
    /// Only Object Types selected for synchronisation: an unselected type holds no Connected System Objects, so
    /// choosing it would queue passwords for accounts that never appear.
    /// </summary>
    private IEnumerable<ConnectedSystemObjectType> SelectableObjectTypes() =>
        (ConnectedSystem.ObjectTypes ?? []).Where(ot => ot.Selected).OrderBy(ot => ot.Name);

    /// <summary>
    /// Pre-selects the sole selected Object Type where there is only one, so the common case needs no choice.
    /// </summary>
    private int DefaultObjectTypeId()
    {
        var selected = SelectableObjectTypes().ToList();
        return selected.Count == 1 ? selected[0].Id : 0;
    }

    private string FormatTimeToLive()
    {
        var timeToLive = ConnectedSystem.EffectiveInitialPasswordTimeToLive;
        return timeToLive.TotalDays >= 1
            ? $"{timeToLive.TotalDays:0.#} day{(Math.Abs(timeToLive.TotalDays - 1) < 0.05 ? string.Empty : "s")}"
            : $"{timeToLive.TotalHours:0.#} hours";
    }

    private bool HasChanges() =>
        !ConnectedSystemPasswordSynchronisation.WouldDeliverTheSameAs(_editor, _asSaved);

    private async Task SaveAsync()
    {
        if (_editor == null || _saving)
            return;

        _saving = true;

        // The same assessment the REST API and PowerShell are gated on, so all three surfaces accept and refuse
        // exactly the same settings.
        _problems = _editor.Validate(ConnectedSystem);
        if (_problems.Count > 0)
        {
            _saving = false;
            return;
        }

        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
        if (cancelled)
        {
            _saving = false;
            return;
        }

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        ConnectedSystem.PasswordSynchronisation = _editor;
        await jim.ConnectedSystems.UpdateConnectedSystemAsync(ConnectedSystem, user, changeReason);

        _asSaved = _editor.SnapshotDeliverySettings();

        Snackbar.Add(_editor.Enabled
            ? "Password Synchronisation is on for this Connected System. Anything queued while it was off will be delivered."
            : "Your Password Synchronisation settings have been saved.", Severity.Success);

        _saving = false;
        await OnConnectedSystemChanged.InvokeAsync();
    }
}
