@* The Password Synchronisation queue (#1119, requirements 21 and 22), as the Passwords tab of Operations (#1635).
   Delivery already worked before this view; what it lacked was somewhere to look. A change that parked because a
   directory refused it was visible only by hunting through Activities, which is no way to run the one thing that
   must never diverge quietly. It sits under Operations rather than on a page of its own because it answers the
   same question as the other three tabs: what JIM is doing, and what it has stopped doing. *@

@* mt-5 rather than a tab-panel padding: the Operations page hands its tabs no top padding of their own, because
   the Schedules tab opens straight onto a grid that already supplies this same gap. *@
<MudText Typo="Typo.h6" Class="mt-5 mb-1">@OperationsText.PasswordsQueueHeading</MudText>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary mb-4">
    @OperationsText.PasswordsQueueIntro
</MudText>

@* Four cards, not five. "Due now" is a subset of waiting rather than a sibling of it, so it reads as a second
   line inside that card: as its own card a reader adding the row up would count the same changes twice. *@
<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true" Style="height:100%;">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">@OperationsText.PasswordsStatusWaiting</MudText>
            <MudText Typo="Typo.h4">@_summary.WaitingCount.ToString("N0")</MudText>
            <MudTooltip Arrow="true" Placement="Placement.Top">
                <TooltipContent>
                    <TooltipText Text="@OperationsText.PasswordsWaitingTooltip" />
                </TooltipContent>
                <ChildContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@string.Format(CultureInfo.CurrentCulture, OperationsText.PasswordsDueNow, _summary.DueCount.ToString("N0", CultureInfo.CurrentCulture))</MudText>
                </ChildContent>
            </MudTooltip>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true" Style="height:100%; border-left: 3px solid var(--mud-palette-warning);">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">@OperationsText.PasswordsStatusParked</MudText>
            <MudTooltip Arrow="true" Placement="Placement.Top">
                <TooltipContent>
                    <TooltipText Text="@OperationsText.PasswordsParkedTooltip" />
                </TooltipContent>
                <ChildContent>
                    <MudText Typo="Typo.h4" Color="@(_summary.ParkedCount > 0 ? Color.Warning : Color.Default)">@_summary.ParkedCount.ToString("N0")</MudText>
                </ChildContent>
            </MudTooltip>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true" Style="height:100%; border-left: 3px solid var(--mud-palette-error);">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">@OperationsText.PasswordsStatusExpired</MudText>
            <MudTooltip Arrow="true" Placement="Placement.Top">
                <TooltipContent>
                    <TooltipText Text="@OperationsText.PasswordsExpiredTooltip" />
                </TooltipContent>
                <ChildContent>
                    <MudText Typo="Typo.h4" Color="@(_summary.ExpiredCount > 0 ? Color.Error : Color.Default)">@_summary.ExpiredCount.ToString("N0")</MudText>
                </ChildContent>
            </MudTooltip>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true" Style="height:100%;">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">@OperationsText.CompletedStatusCancelled</MudText>
            <MudTooltip Arrow="true" Placement="Placement.Top">
                <TooltipContent>
                    <TooltipText Text="@OperationsText.PasswordsCancelledTooltip" />
                </TooltipContent>
                <ChildContent>
                    <MudText Typo="Typo.h4">@_summary.CancelledCount.ToString("N0")</MudText>
                </ChildContent>
            </MudTooltip>
        </MudPaper>
    </MudItem>
</MudGrid>

@* Said out loud, because the summary cards above count the whole queue while the list below is narrowed to one
   person. Without this the two disagree and nothing on the page explains why. *@
@if (MetaverseObjectIdFilter.HasValue)
{
    <MudAlert Severity="Severity.Info" Class="mt-6">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <span>
                @OperationsText.PasswordsShowingOne
            </span>
            <AlertButton Severity="Severity.Info" Size="Size.Small" OnClick="ClearIdentityFilterAsync">@OperationsText.PasswordsShowWhole</AlertButton>
        </MudStack>
    </MudAlert>
}

@* mt-0 rather than a margin class: MudGrid pulls itself up by its items' 24px top padding, so a positive
   margin stacks on top of that padding. Cancelling the pull leaves exactly the 24px section gap. *@
<MudGrid Class="mt-0">
    <MudItem xs="12" sm="4">
        <MudSelect T="int?" Label="@OperationsText.CompletedColConnectedSystem" Value="_connectedSystemId" ValueChanged="OnConnectedSystemFilterChangedAsync"
                   Variant="Variant.Outlined" Clearable="true" Dense="true">
            @foreach (var (id, name) in _connectedSystemNames.OrderBy(n => n.Value))
            {
                <MudSelectItem T="int?" Value="@id">@name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudSelect T="PendingPasswordChangeStatus?" Label="@CommonText.ColumnStatus" Value="_status" ValueChanged="OnStatusFilterChangedAsync"
                   Variant="Variant.Outlined" Clearable="true" Dense="true">
            @* Waiting also returns a change being delivered right now: the repository widens Pending to cover
               Delivering (#1635), matching the Waiting card above, which counts both. *@
            <MudSelectItem T="PendingPasswordChangeStatus?" Value="@PendingPasswordChangeStatus.Pending">@OperationsText.PasswordsStatusWaiting</MudSelectItem>
            <MudSelectItem T="PendingPasswordChangeStatus?" Value="@PendingPasswordChangeStatus.Parked">@OperationsText.PasswordsStatusParked</MudSelectItem>
            <MudSelectItem T="PendingPasswordChangeStatus?" Value="@PendingPasswordChangeStatus.Expired">@OperationsText.PasswordsStatusExpired</MudSelectItem>
            <MudSelectItem T="PendingPasswordChangeStatus?" Value="@PendingPasswordChangeStatus.Cancelled">@OperationsText.CompletedStatusCancelled</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudSelect T="PasswordSetFailureReason?" Label="@OperationsText.PasswordsFailureReasonLabel" Value="_failureReason" ValueChanged="OnFailureReasonFilterChangedAsync"
                   Variant="Variant.Outlined" Clearable="true" Dense="true">
            @foreach (var reason in FilterableFailureReasons)
            {
                <MudSelectItem T="PasswordSetFailureReason?" Value="@reason">@PendingPasswordChangeDisplay.Reason(reason)</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>

<VirtualisedDataGrid @ref="_grid" T="PendingPasswordChangeHeader"
                     ContainerId="password-synchronisation-queue"
                     DefaultSortBy="queued"
                     LoadWindow="LoadWindowAsync"
                     RowClicked="HandleRowClickedAsync"
                     SingularName="@OperationsText.PasswordsSingularName"
                     PluralName="@OperationsText.PasswordsPluralName"
                     SearchPlaceholder="@OperationsText.PasswordsSearchPlaceholder">
    <ToolBarExtras>
        @* Act on the filter the reader is looking at, not on a selection of rows. "Retry everything shown" is
           the action this page exists for, and expressing it as the filter means it covers the whole match set
           rather than the window that happens to be on screen. *@
        <MudButton StartIcon="@Icons.Material.Filled.Replay" Size="Size.Small" Disabled="@(_busy || _grid?.TotalItems is null or 0)"
                   OnClick="RetryShownAsync">
            @OperationsText.PasswordsRetryShown
        </MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.CancelScheduleSend" Size="Size.Small" Disabled="@(_busy || _grid?.TotalItems is null or 0)"
                   OnClick="CancelShownAsync">
            @OperationsText.PasswordsCancelShown
        </MudButton>
    </ToolBarExtras>
    <Columns>
        @* The narrow columns are sized and Status is left to absorb the rest, so the target's own message is
           clipped by its own cell rather than pushing the row actions off the side of the table. *@
        <TemplateColumn Sortable="false" HeaderStyle="width: 200px;">
            <HeaderTemplate>
                <MudTooltip Arrow="true" Placement="Placement.Top">
                    <TooltipContent>
                        <TooltipText Text="@OperationsText.PasswordsIdentityTooltip" />
                    </TooltipContent>
                    <ChildContent><VirtualisedSortHeader Title="@OperationsText.CompletedMetaverseObject" Name="identity" /></ChildContent>
                </MudTooltip>
            </HeaderTemplate>
            <CellTemplate>
                @* The row navigates on click and so does this link; stopping the click here keeps a link click to
                   one history entry, while the link keeps middle-click and open-in-new-tab. The origin chip never
                   gives way (only the identity link does), so a long display name is what clips rather than the
                   one thing on the row that says where the change came from. *@
                <span @onclick:stopPropagation="true" class="jim-one-line-list">
                    <span class="jim-one-line-list-value">
                        <MudLink Href="@IdentityHref(context.Item)">
                            @(context.Item.MetaverseObjectDisplayName ?? context.Item.MetaverseObjectId.ToString())
                        </MudLink>
                    </span>
                    <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small"
                             Color="@PendingPasswordChangeDisplay.OriginColour(context.Item.Origin)"
                             Class="ma-0" data-testid="jim-queue-origin">
                        @PendingPasswordChangeDisplay.OriginLabel(context.Item.Origin)
                    </MudChip>
                    @* Beside the kind chip, for a set or propagated change that is also a Connected System Object's
                       first password (#2160): cancelling it leaves that object without one. *@
                    @if (context.Item.CarriesFirstPassword)
                    {
                        <MudTooltip Arrow="true" Placement="Placement.Top">
                            <TooltipContent><TooltipText Text="@PendingPasswordChangeDisplay.FirstPasswordTooltip" /></TooltipContent>
                            <ChildContent>
                                <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary"
                                         Class="ma-0" data-testid="jim-queue-first-password">
                                    @PendingPasswordChangeDisplay.FirstPasswordLabel
                                </MudChip>
                            </ChildContent>
                        </MudTooltip>
                    }
                </span>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" HeaderStyle="width: 170px;">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@OperationsText.CompletedColConnectedSystem" Name="system" />
            </HeaderTemplate>
            <CellTemplate>
                <OneLineText Text="@context.Item.ConnectedSystemName" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@CommonText.ColumnStatus" Name="status" />
            </HeaderTemplate>
            <CellTemplate>
                @* The reason reads inline after the status, because "Parked" alone tells an administrator to do
                   something without saying what: the remedy is nearly always outside JIM, in a policy, a
                   permission or a Connector limitation, and the target's own words are what point at it.
                   Capped rather than left to the target's message, which is arbitrarily long and would otherwise
                   set this column's width and push the row actions off the side of the table. The full text stays
                   on the element's title. *@
                <div class="jim-column-cap">
                    <OneLineText Text="@PendingPasswordChangeDisplay.Status(context.Item)" Secondary="@PendingPasswordChangeDisplay.Detail(context.Item)" />
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" HeaderStyle="width: 100px;">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@OperationsText.PasswordsColAttempts" Name="attempts" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.AttemptCount.ToString("N0")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" HeaderStyle="width: 190px;">
            <HeaderTemplate>
                <MudTooltip Arrow="true" Placement="Placement.Top">
                    <TooltipContent>
                        <TooltipText Text="@OperationsText.PasswordsNextAttemptTooltip" />
                    </TooltipContent>
                    <ChildContent><VirtualisedSortHeader Title="@OperationsText.PasswordsColNextAttempt" Name="nextattempt" /></ChildContent>
                </MudTooltip>
            </HeaderTemplate>
            <CellTemplate>
                @* Held is checked before the retry time, because a switched-off system holds its changes
                   whatever their retry time says: a pass steps over the system without reaching them. *@
                @if (context.Item.IsHeld)
                {
                    <MudTooltip Arrow="true" Placement="Placement.Top">
                        <TooltipContent>
                            <TooltipText Text="@OperationsText.PasswordsHeldTooltip" />
                        </TooltipContent>
                        <ChildContent><span class="mud-text-secondary">@OperationsText.PasswordsHeld</span></ChildContent>
                    </MudTooltip>
                }
                else if (context.Item.Status == PendingPasswordChangeStatus.Delivering)
                {
                    @* Claimed by the Password Delivery Service (#1635): the attempt is happening, not due. *@
                    <span class="mud-text-secondary">@OperationsText.PasswordsDeliveringNow</span>
                }
                else if (context.Item.NextRetryAt.HasValue)
                {
                    @context.Item.NextRetryAt.Value.ToFriendlyDate()
                }
                else if (context.Item.Status == PendingPasswordChangeStatus.Pending)
                {
                    <span class="mud-text-secondary">@OperationsText.PasswordsDueNowLabel</span>
                }
                else
                {
                    <EmptyValue />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" HeaderStyle="width: 190px;">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@OperationsText.ScheduleExecQueued" Name="queued" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.CreatedAt.ToFriendlyDate()
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false" HeaderStyle="width: 100px;">
            <HeaderTemplate>
                <MudText Typo="Typo.button">@CommonText.ColumnActions</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @* The row navigates on click; these do not. *@
                <span @onclick:stopPropagation="true" class="jim-one-line-list">
                    @* Not offered while Delivering: a retry would only ask for the attempt the row is already
                       getting, and the repository declines it for the same reason. *@
                    @if (context.Item.Status is not (PendingPasswordChangeStatus.Expired or PendingPasswordChangeStatus.Delivering))
                    {
                        <MudTooltip Arrow="true" Placement="Placement.Top">
                            <TooltipContent>
                                <TooltipText Text="@RetryTooltip(context.Item)" />
                            </TooltipContent>
                            <ChildContent>
                                <MudIconButton Icon="@Icons.Material.Filled.Replay" Size="Size.Small" Disabled="@_busy"
                                               aria-label="@OperationsText.PasswordsRetryOneAria"
                                               OnClick="@(() => RetryOneAsync(context.Item))" />
                            </ChildContent>
                        </MudTooltip>
                    }
                    @* A change being delivered can still be cancelled: the deliverer's outcome write is guarded on
                       the row still being Delivering, so the cancellation stands unless the password lands first. *@
                    @if (context.Item.Status is PendingPasswordChangeStatus.Pending or PendingPasswordChangeStatus.Parked or PendingPasswordChangeStatus.Delivering)
                    {
                        <MudTooltip Arrow="true" Placement="Placement.Top">
                            <TooltipContent>
                                <TooltipText Text="@OperationsText.PasswordsCancelOneTooltip" />
                            </TooltipContent>
                            <ChildContent>
                                <MudIconButton Icon="@Icons.Material.Filled.CancelScheduleSend" Size="Size.Small" Disabled="@_busy"
                                               aria-label="@OperationsText.PasswordsCancelOneAria"
                                               OnClick="@(() => CancelOneAsync(context.Item))" />
                            </ChildContent>
                        </MudTooltip>
                    }
                </span>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@string.Format(CultureInfo.CurrentCulture, OperationsText.PasswordsNoSearchMatch, grid.SearchText)"
                             SecondaryText="@OperationsText.CompletedSearchHint"
                             ActionText="@CommonText.ClearSearch"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else if (HasFilter)
        {
            <TableEmptyState Icon="@Icons.Material.Filled.FilterAlt"
                             PrimaryText="@OperationsText.PasswordsNoFilterMatch"
                             SecondaryText="@OperationsText.PasswordsNoFilterHint"
                             ActionText="@OperationsText.CompletedClearFilters"
                             OnAction="ClearFiltersAsync" />
        }
        else
        {
            @* Empty is the healthy state here, and the message says so rather than reading as a fault. *@
            <TableEmptyState Icon="@Icons.Material.Filled.CheckCircleOutline"
                             PrimaryText="@OperationsText.PasswordsEmptyTitle"
                             SecondaryText="@OperationsText.PasswordsEmptyHint" />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private VirtualisedDataGrid<PendingPasswordChangeHeader>? _grid;
    private Dictionary<int, string> _connectedSystemNames = new();
    private PasswordQueueSummary _summary = new();

    /// <summary>
    /// Narrows the queue to one identity, so a link from that person's own page lands on their outstanding
    /// changes rather than on the whole queue for them to find themselves in. Read from the query string even
    /// though this is a tab rather than a page: the Operations route carries it
    /// (<c>/admin/operations?t=passwords&amp;metaverseObjectId=...</c>), and the tab strip preserves the other
    /// parameters when it writes its own.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "metaverseObjectId")]
    public Guid? MetaverseObjectIdFilter { get; set; }

    /// <summary>
    /// Pre-selects the Connected System filter, so a link from a system's own row lands on its queue. Only the
    /// starting value: unlike the identity filter it has a control on screen, and that control owns it from then on.
    /// </summary>
    [Parameter, SupplyParameterFromQuery(Name = "connectedSystemId")]
    public int? ConnectedSystemIdFilter { get; set; }

    private int? _connectedSystemId;
    private PendingPasswordChangeStatus? _status;
    private PasswordSetFailureReason? _failureReason;

    /// <summary>
    /// Guards the actions while one is in flight. A retry and a cancel over the same filter racing each other
    /// would leave an administrator unable to say which of the two outcomes a row ended up with.
    /// </summary>
    private bool _busy;

    /// <summary>
    /// The reasons a delivery attempt can fail. <see cref="PasswordSetFailureReason.None"/> is excluded: it is
    /// what a change that has never failed carries, so offering it as a filter would promise a set of rows that
    /// the failure-reason column is blank for anyway.
    /// </summary>
    private static readonly PasswordSetFailureReason[] FilterableFailureReasons =
    [
        PasswordSetFailureReason.Transient,
        PasswordSetFailureReason.ConfigurationFault,
        PasswordSetFailureReason.PolicyRejection,
        PasswordSetFailureReason.TargetObjectNotFound,
        PasswordSetFailureReason.UnsupportedOperation
    ];

    private bool HasFilter =>
        _connectedSystemId.HasValue || _status.HasValue || _failureReason.HasValue || MetaverseObjectIdFilter.HasValue;

    protected override async Task OnInitializedAsync()
    {
        _connectedSystemId = ConnectedSystemIdFilter;

        using var jim = JimFactory.Create();
        _connectedSystemNames = await jim.ConnectedSystems.GetConnectedSystemNamesAsync();
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        using var jim = JimFactory.Create();
        _summary = await jim.PasswordSynchronisation.GetQueueSummaryAsync();
    }

    /// <summary>
    /// The filter the grid is currently showing, which is also what the bulk actions act on. Built in one place
    /// so "retry everything shown" cannot drift from what the list is showing.
    /// </summary>
    private PendingPasswordChangeFilter CurrentFilter(string? searchText) => new()
    {
        ConnectedSystemId = _connectedSystemId,
        Status = _status,
        FailureReason = _failureReason,
        MetaverseObjectId = MetaverseObjectIdFilter,
        SearchText = searchText
    };

    private async Task<VirtualisedWindow<PendingPasswordChangeHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        using var jim = JimFactory.Create();
        var result = await jim.PasswordSynchronisation.GetPendingPasswordChangesAsync(
            CurrentFilter(request.SearchText),
            request.StartIndex,
            request.Count,
            request.SortBy,
            request.SortDescending,
            request.IncludeTotalCount);

        return new VirtualisedWindow<PendingPasswordChangeHeader>(result.Results, result.TotalResults);
    }

    private async Task OnConnectedSystemFilterChangedAsync(int? value)
    {
        _connectedSystemId = value;
        await RefreshAsync();
    }

    private async Task OnStatusFilterChangedAsync(PendingPasswordChangeStatus? value)
    {
        _status = value;
        await RefreshAsync();
    }

    private async Task OnFailureReasonFilterChangedAsync(PasswordSetFailureReason? value)
    {
        _failureReason = value;
        await RefreshAsync();
    }

    /// <summary>
    /// Drops the identity deep link and shows the whole queue. Its own action rather than part of the filter
    /// clear, because it is the one filter that arrives from a link rather than from a control on this page, so
    /// there is nothing on screen to unset.
    /// </summary>
    private async Task ClearIdentityFilterAsync()
    {
        MetaverseObjectIdFilter = null;
        ForgetDeepLink("metaverseObjectId");
        await RefreshAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _connectedSystemId = null;
        _status = null;
        _failureReason = null;
        MetaverseObjectIdFilter = null;
        ForgetDeepLink("metaverseObjectId", "connectedSystemId");
        await RefreshAsync();
    }

    /// <summary>
    /// Drops deep-link parameters from the URL as well as from this component. That matters here in a way it
    /// did not when the queue was a page of its own: the tab strip re-creates this component each time the reader
    /// comes back to the tab, and it reads the query string afresh, so a filter cleared only in memory would be
    /// back the next time they looked. Replaces the history entry rather than adding one, because "the same tab
    /// without the filter" is not somewhere a reader expects the back button to return them to.
    /// </summary>
    private void ForgetDeepLink(params string[] parameterNames)
    {
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(NavManager.Uri).Query);
        if (!parameterNames.Any(name => query[name] != null))
            return;

        var cleared = parameterNames.ToDictionary(name => name, _ => (object?)null);
        NavManager.NavigateTo(NavManager.GetUriWithQueryParameters(cleared), replace: true);
    }

    /// <summary>
    /// Re-reads the summary and the list. The filters change which rows match, so the totals have to be counted
    /// again and the reader's scroll position describes a match set that no longer exists.
    /// </summary>
    private async Task RefreshAsync()
    {
        await LoadSummaryAsync();

        if (_grid != null)
        {
            await _grid.ResetScrollAsync();
            await _grid.RefreshAsync(invalidateTotals: true);
        }
    }

    private async Task RetryOneAsync(PendingPasswordChangeHeader change)
    {
        // Named by identifier and nothing else: acting on the row the administrator clicked, even if the filters
        // have moved on since the window was read.
        await RunActionAsync(
            retry: true,
            filter: new PendingPasswordChangeFilter { Ids = [change.Id] },
            confirmation: null);
    }

    private async Task CancelOneAsync(PendingPasswordChangeHeader change)
    {
        await RunActionAsync(
            retry: false,
            filter: new PendingPasswordChangeFilter { Ids = [change.Id] },
            confirmation: PendingPasswordChangeDisplay.CancelConfirmation(change));
    }

    private async Task RetryShownAsync()
    {
        var count = _grid?.TotalItems ?? 0;
        await RunActionAsync(
            retry: true,
            filter: CurrentFilter(_grid?.SearchText),
            confirmation: string.Format(CultureInfo.CurrentCulture, OperationsText.PasswordsRetryShownConfirm, Describe(count)));
    }

    private async Task CancelShownAsync()
    {
        var count = _grid?.TotalItems ?? 0;
        await RunActionAsync(
            retry: false,
            filter: CurrentFilter(_grid?.SearchText),
            confirmation: string.Format(CultureInfo.CurrentCulture, OperationsText.PasswordsCancelShownConfirm, Describe(count)));
    }

    /// <summary>
    /// Runs a retry or a cancel and reports what it covered. Shared so the row actions and the bulk actions
    /// cannot report differently, and so the confirmation is the only thing that varies between them.
    /// </summary>
    private async Task RunActionAsync(bool retry, PendingPasswordChangeFilter filter, string? confirmation)
    {
        if (confirmation != null)
        {
            var confirmed = await DialogService.ShowMessageBoxAsync(
                retry ? OperationsText.PasswordsRetryTitle : OperationsText.PasswordsCancelTitle,
                confirmation,
                yesText: retry ? OperationsText.PasswordsRetryYes : OperationsText.PasswordsCancelDeliveryYes,
                cancelText: CommonText.Close);

            if (confirmed != true)
                return;
        }

        _busy = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateProvider.GetAuthenticationStateAsync());

            var affected = retry
                ? await jim.PasswordSynchronisation.RetryAsync(filter, user, null)
                : await jim.PasswordSynchronisation.CancelAsync(filter, user, null);

            // Zero is reported rather than passed over in silence. An administrator who acted and changed nothing
            // needs to know that happened; a page that says nothing leaves them believing it worked.
            Snackbar.Add(
                affected == 0
                    ? (retry
                        ? OperationsText.PasswordsNothingRetried
                        : OperationsText.PasswordsNothingCancelled)
                    : (retry
                        ? string.Format(CultureInfo.CurrentCulture, OperationsText.PasswordsAttemptedAgain, Describe(affected))
                        : string.Format(CultureInfo.CurrentCulture, OperationsText.PasswordsNotDelivered, Describe(affected))),
                affected == 0 ? Severity.Info : Severity.Success);
        }
        finally
        {
            _busy = false;
        }

        await RefreshAsync();
    }

    private void HandleRowClickedAsync(PendingPasswordChangeHeader change)
    {
        NavManager.NavigateTo(IdentityHref(change));
    }

    /// <summary>
    /// Where a row leads: the identity's own page, where the same change is visible against every one of their
    /// accounts. Falls back to the Metaverse search where the Object Type name did not come back, which is a
    /// broken row rather than a broken link.
    /// </summary>
    private static string IdentityHref(PendingPasswordChangeHeader change) =>
        string.IsNullOrWhiteSpace(change.MetaverseObjectTypePluralName)
            ? "/search"
            : Utilities.GetMetaverseObjectHref(change.MetaverseObjectId, change.MetaverseObjectTypePluralName);

    private static string Describe(int count) =>
        string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(count, OperationsText.PasswordsDescribeOne, OperationsText.PasswordsDescribeOther), count.ToString("N0", CultureInfo.CurrentCulture));

    /// <summary>
    /// Says what retrying this particular row will do. A waiting change is only pulled forward; a parked one is
    /// picked back up, which is worth saying plainly because the cause is usually still outside JIM.
    /// </summary>
    private static string RetryTooltip(PendingPasswordChangeHeader change) => change.Status switch
    {
        PendingPasswordChangeStatus.Pending =>
            OperationsText.PasswordsRetryPending,
        PendingPasswordChangeStatus.Cancelled =>
            OperationsText.PasswordsRetryCancelled,
        _ =>
            OperationsText.PasswordsRetryDefault
    };
}
