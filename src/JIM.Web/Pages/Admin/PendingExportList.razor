@page "/admin/connected-systems/{Id:int}/pending-exports"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Staging.DTOs
@using JIM.Models.Transactional
@using JIM.Models.Transactional.DTOs
@using JIM.Utilities
@using JIM.Web.Models
@using JIM.Web.Services
@using JIM.Web.Shared
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectorSpaceText.PexListPageTitle, _connectedSystemHeader?.Name)</PageTitle>
<MudText Typo="Typo.h3"><span>@ConnectorSpaceText.PexListHeadingLabel</span> <span class="mud-primary-text">@_connectedSystemHeader?.Name</span>
    <PageInfo Title="@ConnectorSpaceText.CsoPendingExportsTitle" DocsPage="configuration/connected-systems.md#pending-exports" Term="Term.PendingExport">
        @ConnectorSpaceText.PexListPageInfo
    </PageInfo>
</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

@if (_connectedSystemHeader != null)
{
    <MudPaper Elevation="0" Class="pa-4 mt-2" Outlined="true">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="4" Wrap="Wrap.Wrap" Class="jim-filter-row">
            <MudSelect T="PendingExportStatus" Label="@ConnectorSpaceText.PexFilterStatus" MultiSelection="true"
                       SelectedValues="_statusFilters" SelectedValuesChanged="OnStatusFiltersChanged"
                       MultiSelectionTextFunc="@GetFilterText"
                       Variant="Variant.Outlined" Clearable="true" Dense="true">
                <MudSelectItem T="PendingExportStatus" Value="@PendingExportStatus.Pending">@ConnectorSpaceText.PexStatusPending</MudSelectItem>
                <MudSelectItem T="PendingExportStatus" Value="@PendingExportStatus.Executing">@ConnectorSpaceText.PexStatusExecuting</MudSelectItem>
                <MudSelectItem T="PendingExportStatus" Value="@PendingExportStatus.ExportNotConfirmed">@ConnectorSpaceText.PexStatusExportNotConfirmed</MudSelectItem>
                <MudSelectItem T="PendingExportStatus" Value="@PendingExportStatus.Exported">@ConnectorSpaceText.PexStatusExported</MudSelectItem>
                <MudSelectItem T="PendingExportStatus" Value="@PendingExportStatus.Parked">@ConnectorSpaceText.PexStatusParked</MudSelectItem>
            </MudSelect>
            <MudSelect T="PendingExportChangeType" Label="@ConnectorSpaceText.PexFilterChangeType" MultiSelection="true"
                       SelectedValues="_changeTypeFilters" SelectedValuesChanged="OnChangeTypeFiltersChanged"
                       MultiSelectionTextFunc="@GetFilterText"
                       Variant="Variant.Outlined" Clearable="true" Dense="true">
                <MudSelectItem T="PendingExportChangeType" Value="@PendingExportChangeType.Create">@CommonText.Create</MudSelectItem>
                <MudSelectItem T="PendingExportChangeType" Value="@PendingExportChangeType.Update">@ConnectorSpaceText.PexChangeTypeUpdate</MudSelectItem>
                <MudSelectItem T="PendingExportChangeType" Value="@PendingExportChangeType.Delete">@CommonText.Delete</MudSelectItem>
            </MudSelect>
            @* A failing Pending Export is one whose last attempt failed (#2119). JIM attempts it again at every export
               run, so it stays Pending; this is how an administrator finds the ones to investigate. *@
            <MudSwitch T="bool" Value="_failingOnly" ValueChanged="OnFailingOnlyChanged" Color="Color.Error"
                       Label="@ConnectorSpaceText.PexFailingOnly" />
        </MudStack>
    </MudPaper>

    @* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count, density, the
       search box) lives in the shared grid; this page supplies the columns, the window loader, the Status and
       Change Type filters above and the empty states. *@
    <VirtualisedDataGrid @ref="_grid" T="PendingExportHeader"
                         ContainerId="pending-export-list"
                         DefaultSortBy="created"
                         DefaultSortDescending="true"
                         LoadWindow="LoadWindowAsync"
                         RowClicked="HandleRowClicked"
                         SingularName="@ConnectorSpaceText.PexTerm"
                         PluralName="@ConnectorSpaceText.CsoPendingExportsTitle"
                         SearchPlaceholder="@ConnectorSpaceText.PexListSearch">
        <Columns>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@ConnectorSpaceText.CsoColumnChangeType" Name="changetype" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetPendingExportChangeTypeColor(context.Item.ChangeType)">
                        @context.Item.ChangeType
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@CommonText.ColumnStatus" Name="status" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetPendingExportStatusColor(context.Item.Status)">
                        @context.Item.Status.ToString().SplitOnCapitalLetters()
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@ConnectorSpaceText.PexColumnSourceMvo" Name="sourcemvo" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.SourceMetaverseObjectId.HasValue)
                    {
                        var sourceMetaverseObjectId = context.Item.SourceMetaverseObjectId.Value;
                        var sourceName = context.Item.SourceMetaverseObjectDisplayName ?? sourceMetaverseObjectId.ToString();
                        @if (context.Item.SourceMetaverseObjectTypePluralName is { } sourceTypePluralName)
                        {
                            @* The row navigates on click and so does this link; stopping the click here keeps a link
                               click to one navigation while preserving middle-click and open-in-new-tab. *@
                            <span @onclick:stopPropagation="true">
                                <MudLink Href="@Utilities.GetMetaverseObjectHref(sourceMetaverseObjectId, sourceTypePluralName)">@sourceName</MudLink>
                            </span>
                        }
                        else
                        {
                            @sourceName
                        }
                    }
                    else
                    {
                        <EmptyValue />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@ConnectorSpaceText.PexColumnTargetCso" Name="targetobject" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.ConnectedSystemObjectId.HasValue)
                    {
                        var connectedSystemObjectId = context.Item.ConnectedSystemObjectId.Value;
                        <span @onclick:stopPropagation="true">
                            <MudLink Href="@($"/admin/connected-systems/{Id}/connector-space/{connectedSystemObjectId}")">
                                @(context.Item.TargetObjectIdentifier ?? connectedSystemObjectId.ToString())
                            </MudLink>
                        </span>
                    }
                    else
                    {
                        <span class="mud-text-secondary">@ConnectorSpaceText.PexNewObjectShort</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@ConnectorSpaceText.PexColumnChanges" Name="changes" />
                </HeaderTemplate>
                <CellTemplate>
                    @context.Item.AttributeChangeCount
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@CommonText.ColumnCreated" Name="created" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudTooltip Text="@context.Item.CreatedAt.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                        <span>@context.Item.CreatedAt.ToLocalTime().ToRelativeTime()</span>
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@ConnectorSpaceText.PexLabelFailedAttempts" Name="errors" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.ErrorCount > 0)
                    {
                        <MudChip T="string" Variant="Variant.Text" Color="Color.Error">
                            @context.Item.ErrorCount
                        </MudChip>
                    }
                    else
                    {
                        <span>0</span>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@ConnectorSpaceText.PexUnresolvedTitle" Name="references" />
                </HeaderTemplate>
                <CellTemplate>
                    @* How many reference changes this export could not write yet because their targets
                       have no resolvable object in the Connected System (#1398); the detail page explains
                       each owed reference and its reason. *@
                    @if (context.Item.UnresolvedReferenceCount > 0)
                    {
                        <MudTooltip Text="@ConnectorSpaceText.PexUnresolvedTooltip" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Warning">
                                @context.Item.UnresolvedReferenceCount
                            </MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <EmptyValue />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@ConnectorSpaceText.PexLabelFailingSince" Name="failingsince" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.FailingSince.HasValue)
                    {
                        var failingSince = context.Item.FailingSince.Value;
                        <MudTooltip Text="@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectorSpaceText.PexFailingSinceTooltip, failingSince.ToLocalTime().ToFriendlyDate())" Arrow="true" Placement="Placement.Top">
                            <span class="mud-error-text">@failingSince.ToLocalTime().ToRelativeTime()</span>
                        </MudTooltip>
                    }
                    else
                    {
                        <EmptyValue />
                    }
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <EmptyContent Context="grid">
            @* An empty list means one of three different things, and the message says which: a search that matched
               nothing, filters that matched nothing (each with the way out as the action), or genuinely no
               Pending Exports, which is the good state: everything has been exported. *@
            @if (!string.IsNullOrWhiteSpace(grid.SearchText))
            {
                <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                 PrimaryText="@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectorSpaceText.PexNoSearchMatch, grid.SearchText)"
                                 SecondaryText="@CommonText.TrySearchAgain"
                                 ActionText="@CommonText.ClearSearch"
                                 OnAction="@(() => grid.ClearSearchAsync())" />
            }
            else if (_failingOnly && !_statusFilters.Any() && !_changeTypeFilters.Any())
            {
                <TableEmptyState Icon="@Icons.Material.Filled.TaskAlt"
                                 PrimaryText="@ConnectorSpaceText.PexNoneFailing"
                                 SecondaryText="@ConnectorSpaceText.PexNoneFailingHint"
                                 ActionText="@ConnectorSpaceText.PexShowAll"
                                 OnAction="@(() => OnFailingOnlyChanged(false))" />
            }
            else if (_statusFilters.Any() || _changeTypeFilters.Any() || _failingOnly)
            {
                <TableEmptyState Icon="@Icons.Material.Filled.FilterAlt"
                                 PrimaryText="@ConnectorSpaceText.PexNoFilterMatch"
                                 SecondaryText="@ConnectorSpaceText.PexNoFilterMatchHint"
                                 ActionText="@ConnectorSpaceText.PexClearFilters"
                                 OnAction="ClearFiltersAsync" />
            }
            else
            {
                <TableEmptyState Icon="@Icons.Material.Filled.TaskAlt"
                                 PrimaryText="@ConnectorSpaceText.PexNoneYet"
                                 SecondaryText="@ConnectorSpaceText.PexNoneYetHint" />
            }
        </EmptyContent>
    </VirtualisedDataGrid>
}
else
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mt-5" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    /// <summary>
    /// Opens the list showing only failing Pending Exports, as the Connected System page's Failing Exports link does.
    /// </summary>
    [SupplyParameterFromQuery(Name = "failing")]
    public bool? FailingQuery { get; set; }

    private VirtualisedDataGrid<PendingExportHeader>? _grid;
    private bool _failingOnly;
    private ConnectedSystemHeader? _connectedSystemHeader;
    private IReadOnlyCollection<PendingExportStatus> _statusFilters = new HashSet<PendingExportStatus>();
    private IReadOnlyCollection<PendingExportChangeType> _changeTypeFilters = new HashSet<PendingExportChangeType>();
    private List<BreadcrumbItem> _breadcrumbs = null!;

    protected override async Task OnInitializedAsync()
    {
        _failingOnly = FailingQuery == true;

        using var jim = JimFactory.Create();
        _connectedSystemHeader = await jim.ConnectedSystems.GetConnectedSystemHeaderAsync(Id);
        if (_connectedSystemHeader == null)
        {
            NavManager.NavigateTo("../");
            return;
        }

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new(ConnectorSpaceText.DeletedHomeBreadcrumb, href: "/", icon: Icons.Material.Filled.Home),
            new(ConnectorSpaceText.DeletedAdministrationBreadcrumb, href: "/admin"),
            new(ConnectorSpaceText.CsoBreadcrumbConnectedSystems, href: "/admin/connected-systems/"),
            new(_connectedSystemHeader.Name, href: Utilities.GetConnectedSystemHref(_connectedSystemHeader)),
            new(ConnectorSpaceText.CsoPendingExportsTitle, href: null, disabled: true)
        };
    }

    private async Task<VirtualisedWindow<PendingExportHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        using var jim = JimFactory.Create();
        var result = await jim.ConnectedSystems.GetPendingExportHeadersRangeAsync(
            Id,
            request.StartIndex,
            request.Count,
            _statusFilters.Any() ? _statusFilters : null,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            includeTotalCount: request.IncludeTotalCount,
            failingOnly: _failingOnly,
            changeTypeFilters: _changeTypeFilters.Any() ? _changeTypeFilters : null);

        return new VirtualisedWindow<PendingExportHeader>(result.Results, result.TotalResults);
    }

    private string GetFilterText(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues == null || selectedValues.Count == 0)
            return ConnectorSpaceText.PexAll;

        if (selectedValues.Count == 1)
            return selectedValues[0].SplitOnCapitalLetters();

        return string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectorSpaceText.PexSelectedCount, selectedValues.Count);
    }

    /// <summary>
    /// Applies a Status filter change and reloads the grid. The filter changes which objects match, so the total
    /// (and the unfiltered baseline it anchors) must be re-counted, and the reader's scroll position describes a
    /// match set that no longer exists, so they are returned to the top.
    /// </summary>
    private async Task OnStatusFiltersChanged(IReadOnlyCollection<PendingExportStatus> newFilters)
    {
        _statusFilters = newFilters;

        if (_grid != null)
        {
            await _grid.ResetScrollAsync();
            await _grid.RefreshAsync(invalidateTotals: true);
        }
    }

    /// <summary>
    /// Applies a Change Type filter change and reloads the grid; re-counted and returned to the top for the same
    /// reason as a Status filter change.
    /// </summary>
    private async Task OnChangeTypeFiltersChanged(IReadOnlyCollection<PendingExportChangeType> newFilters)
    {
        _changeTypeFilters = newFilters;

        if (_grid != null)
        {
            await _grid.ResetScrollAsync();
            await _grid.RefreshAsync(invalidateTotals: true);
        }
    }

    /// <summary>
    /// Shows only failing Pending Exports, or all of them again, and reloads the grid; re-counted and returned to the
    /// top for the same reason as a Status filter change.
    /// </summary>
    private async Task OnFailingOnlyChanged(bool failingOnly)
    {
        _failingOnly = failingOnly;

        if (_grid != null)
        {
            await _grid.ResetScrollAsync();
            await _grid.RefreshAsync(invalidateTotals: true);
        }
    }

    private async Task ClearFiltersAsync()
    {
        _failingOnly = false;
        _changeTypeFilters = new HashSet<PendingExportChangeType>();
        await OnStatusFiltersChanged(new HashSet<PendingExportStatus>());
    }

    private void HandleRowClicked(PendingExportHeader item)
    {
        NavManager.NavigateTo($"/admin/connected-systems/{Id}/pending-exports/{item.Id}");
    }
}
