@* The causality Lineage view (#1495): the object graph as at most four columns (the source side's
   records, the Identity, the target side's records, and the trailing column for unplaceable hops),
   joined by labelled relationships and read source to Identity to target. Each object in a column
   encloses its own head and events, which is what lets a side hold several records without the
   reader losing where one record's story ends. This run's events render primary (accent ring and
   badge) around the shared event card, so tones, entity chips, attribute counts and the shared
   drawer keep working; earlier runs' events render as subdued chain cards carrying their run kind,
   timestamp and activity link. Chain endings close their object as quiet footers. Narrow viewports
   stack the columns vertically, per the Flow view's existing breakpoint. *@

<div class="ln-scroller">
    @if (Model.IsTruncatedByDepth)
    {
        <div class="ln-truncated">Some branches go further back than shown</div>
    }
    <div class="ln-canvas" style="grid-template-columns: @GridTemplateColumns">
        @for (var i = 0; i < Model.Columns.Count; i++)
        {
            var column = Model.Columns[i];
            @if (i > 0)
            {
                var join = Model.Joins[i - 1];
                @* A join with no relationship (the trailing column, or two records adjacent with no
                   Identity between them) is an empty gutter: an arrow would claim a relationship the
                   model does not state. *@
                <div class="ln-join" @key="@($"join-{i}")">
                    @if (join.Label != null)
                    {
                        <span class="ln-join-arrow" aria-hidden="true">&rarr;</span>
                        <span class="ln-join-label">@join.Label</span>
                    }
                </div>
            }
            <div class="ln-col" @key="column">
                @* Each object encloses its own events. A column is a side of the story, not one
                   object, so without the enclosure a reader could not tell where one record's
                   events ended and the next record's began. *@
                @foreach (var lineageObject in column.Objects)
                {
                    <div class="ln-object" @key="lineageObject">
                        <div class="ln-obj">
                            @if (column.Kind != CausalityLineageColumnKind.Unassigned)
                            {
                                <span class="glyph @(column.Kind == CausalityLineageColumnKind.Identity ? "idn" : "rec")"
                                      aria-hidden="true">@(column.Kind == CausalityLineageColumnKind.Identity ? "ID" : "R")</span>
                            }
                            @if (lineageObject.Href != null)
                            {
                                <a class="ln-obj-title" href="@lineageObject.Href">@GetObjectTitle(column, lineageObject)</a>
                            }
                            else
                            {
                                <span class="ln-obj-title">@GetObjectTitle(column, lineageObject)</span>
                            }
                            @if (GetObjectSub(column, lineageObject) is { } objectSub)
                            {
                                <span class="ln-obj-sub">@objectSub</span>
                            }
                        </div>
                        @* An object with no events of its own is its head alone (the Identity that
                           completes a create export's graph); an empty body would add padding under it
                           with nothing in it. *@
                        @if (lineageObject.Cards.Count > 0 || lineageObject.Endings.Count > 0)
                        {
                            <div class="ln-obj-body">
                                @foreach (var card in lineageObject.Cards)
                                {
                                    @if (card.Event is { } thisRunEvent)
                                    {
                                        @* The head names the object's system, so the card's own system
                                           chip would restate it; suppressed exactly as the Flow view's
                                           system groups did. *@
                                        <div class="ln-now" @key="card">
                                            @* The badge and the run's time pair up exactly as a chain
                                               card's run chip and time do, so every card on the panel
                                               says which run it belongs to and when. *@
                                            <div class="ln-when ln-now-when">
                                                <span class="ln-now-badge">This run</span>
                                                @if (Timestamp is { } timestamp)
                                                {
                                                    var timestampLocal = timestamp.ToLocalTime();
                                                    <span class="ln-time" title="@timestampLocal.ToFriendlyDate()">@timestampLocal.ToRelativeTime()</span>
                                                }
                                            </div>
                                            <CausalityEventCard Event="thisRunEvent" TechnicalNames="TechnicalNames"
                                                                HideSystemChip="true"
                                                                Selected="ReferenceEquals(SelectedEvent, thisRunEvent)"
                                                                OnSelect="ToggleSelectionAsync" />
                                        </div>
                                    }
                                    else if (card.Hop is { } hop)
                                    {
                                        <CausalityLineageChainCard Hop="hop" @key="card" />
                                    }
                                }
                                @foreach (var ending in lineageObject.Endings)
                                {
                                    <div class="ln-end" @key="ending">@ending.Text</div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// The lineage model to render.
    /// </summary>
    [Parameter, EditorRequired]
    public CausalityLineageModel Model { get; set; } = null!;

    /// <summary>
    /// When true, technical labels (MVO/CSO vocabulary) are emphasised and plain language demoted.
    /// </summary>
    [Parameter]
    public bool TechnicalNames { get; set; }

    /// <summary>
    /// When this run executed (UTC), shown beside each of its cards' "This run" badge. Null where the host
    /// does not know it, in which case those cards carry no time rather than the epoch.
    /// </summary>
    [Parameter]
    public DateTime? Timestamp { get; set; }

    /// <summary>
    /// The currently selected event (whose attribute detail the panel shows in the drawer); null
    /// when none. Two-way bindable so the panel owns the state.
    /// </summary>
    [Parameter]
    public CausalityEvent? SelectedEvent { get; set; }

    [Parameter]
    public EventCallback<CausalityEvent?> SelectedEventChanged { get; set; }

    /// <summary>
    /// The canvas grid: one flexible track per column with a fixed join track between each adjacent
    /// pair, so the joins render in the grid flow rather than being absolutely positioned. The track
    /// count is bounded by the column count (at most four), so the canvas no longer widens as a
    /// deployment gains Connected Systems.
    /// </summary>
    private string GridTemplateColumns
    {
        get
        {
            var parts = new List<string>();
            for (var i = 0; i < Model.Columns.Count; i++)
            {
                if (i > 0)
                    parts.Add("44px");
                parts.Add("minmax(230px, 1fr)");
            }

            return string.Join(" ", parts);
        }
    }

    private static string GetObjectTitle(CausalityLineageColumn column, CausalityLineageObject lineageObject)
    {
        return column.Kind == CausalityLineageColumnKind.Record && lineageObject.ObjectTypeName != null
            ? $"{lineageObject.ObjectTypeName}: {lineageObject.Title}"
            : lineageObject.Title;
    }

    /// <summary>
    /// The head's second line: which system a record lives in, or that the object is the Identity
    /// (with its Metaverse Object Type where known). The trailing unassigned column explains itself
    /// instead.
    /// </summary>
    private static string? GetObjectSub(CausalityLineageColumn column, CausalityLineageObject lineageObject)
    {
        return column.Kind switch
        {
            CausalityLineageColumnKind.Record =>
                lineageObject.SystemName != null ? $"record in {lineageObject.SystemName}" : null,
            CausalityLineageColumnKind.Identity => lineageObject.ObjectTypeName != null
                ? $"Identity · {lineageObject.ObjectTypeName}"
                : "Identity",
            _ => "causes this view could not place"
        };
    }

    private Task ToggleSelectionAsync(CausalityEvent causalityEvent)
    {
        var newValue = ReferenceEquals(SelectedEvent, causalityEvent) ? null : causalityEvent;
        return SelectedEventChanged.InvokeAsync(newValue);
    }
}
