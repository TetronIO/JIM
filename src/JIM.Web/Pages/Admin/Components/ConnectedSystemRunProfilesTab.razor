<MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Run Profiles define what operations can be performed on a
    Connector, i.e. import, export and synchronisation, with any required settings.</MudAlert>

    @* A Connected System's Run Profiles are a short configuration list held on the system already loaded by the
       page, so the grid's windows are sliced from it in memory rather than from a database range read. *@
    <VirtualisedDataGrid @ref="_grid" T="ConnectedSystemRunProfile"
                         ContainerId="connected-system-run-profile-list"
                         UrlParameterPrefix="rp-"
                         DefaultSortBy="name"
                         LoadWindow="LoadRunProfileWindowAsync"
                         SingularName="Run Profile"
                         PluralName="Run Profiles"
                         SearchPlaceholder="Search Run Profiles">
        <ToolBarExtras>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="HandleShowNewRunProfileDialogAsync">
                Create Run Profile
            </MudButton>
        </ToolBarExtras>
        <Columns>
            <TemplateColumn Title="Name" Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Name" Name="name" />
                </HeaderTemplate>
                <CellTemplate>
                    @context.Item.Name
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="Run Type" Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Run Type" Name="runtype" />
                </HeaderTemplate>
                <CellTemplate>
                    @context.Item.RunType.ToString().SplitOnCapitalLetters()
                    @if (context.Item.VerifyImportContentHashes)
                    {
                        <MudTooltip Text="Verification Mode is enabled: this Full Import performs no content-hash skips and diffs every object." Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Class="ms-2">Verification Mode</MudChip>
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
            @if (ConnectedSystem.ConnectorDefinition.SupportsPartitions)
            {
                <TemplateColumn Title="Partition" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Partition" Name="partition" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.Partition is { } partition)
                        {
                            <span class="jim-code-inline">@partition.Name</span>
                            @if (context.Item.TargetsADeselectedPartition())
                            {
                                <MudTooltip Text="This partition is no longer selected, so it is not managed by JIM and this Run Profile cannot run. Select the partition again on the Partitions &amp; Containers tab, or point this Run Profile at a selected partition."
                                            Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ms-2">Not selected</MudChip>
                                </MudTooltip>
                            }
                        }
                        else
                        {
                            <span>All selected</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
            }
            @if (ConnectedSystem.ConnectorDefinition.SupportsPaging)
            {
                <TemplateColumn Title="Page Size" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Page Size" Name="pagesize" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.PageSize
                    </CellTemplate>
                </TemplateColumn>
            }
            @if (ConnectedSystem.ConnectorDefinition.SupportsFilePaths)
            {
                <TemplateColumn Title="File Path" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="File Path" Name="filepath" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (!string.IsNullOrEmpty(context.Item.FilePath))
                        {
                            <span class="jim-code-inline">@context.Item.FilePath</span>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
            }
            <TemplateColumn Title="Actions" Sortable="false">
                <HeaderTemplate>
                    <MudText Typo="Typo.button">Actions</MudText>
                </HeaderTemplate>
                <CellTemplate>
                    <div class="d-flex justify-end">
                        <MudTooltip Text="Edit" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Variant="Variant.Filled"
                                           Size="Size.Small" OnClick="_ => HandleShowEditRunProfileDialogAsync(context.Item)" Class="me-2" />
                        </MudTooltip>
                        <MudTooltip Text="Delete" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Variant="Variant.Filled"
                                           Size="Size.Small" OnClick="_ => HandleRunProfileDeleteAsync(context.Item)" />
                        </MudTooltip>
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <EmptyContent Context="grid">
            @if (!string.IsNullOrWhiteSpace(grid.SearchText))
            {
                <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                 PrimaryText="@($"No Run Profiles match \"{grid.SearchText}\"")"
                                 SecondaryText="Try a different search term, or clear the search."
                                 ActionText="Clear Search"
                                 OnAction="@(() => grid.ClearSearchAsync())" />
            }
            else
            {
                <TableEmptyState Icon="@Icons.Material.Filled.PlayCircleOutline"
                                 PrimaryText="No Run Profiles yet"
                                 SecondaryText="Use the Create Run Profile button to define what this Connected System can be asked to do." />
            }
        </EmptyContent>
    </VirtualisedDataGrid>

    @* New Run Profile Dialog *@
    <MudDialog @bind-Visible="_newRunProfileDialogVisible" Options="_newRunProfileDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Add" Class="me-3" /> Create New Run Profile
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudForm @bind-IsValid="@IsNewRunProfileFormValid">
                <MudTextField T="string" @bind-Value="_newRunProfile.Name" Label="Name" Variant="Variant.Outlined"
                              Class="mt-3" Required="true" RequiredError="A name for the Run Profile is required" Immediate="true" />

                <MudSelect T="ConnectedSystemRunType" @bind-Value="_newRunProfile.RunType" Label="Run Type"
                           Variant="Variant.Outlined" AnchorOrigin="Origin.BottomLeft" Class="mt-5" Required="true"
                           RequiredError="A Run Profile type is required"
                           Validation="@(new Func<ConnectedSystemRunType, string?>(ValidateRunType))" Immediate="true">
                    <MudSelectItem Value="ConnectedSystemRunType.NotSet" Disabled="true">Select run type</MudSelectItem>
                    @foreach (ConnectedSystemRunType runType in Enum.GetValues(typeof(ConnectedSystemRunType)))
                    {
                        if (runType == ConnectedSystemRunType.NotSet)
                            continue;

                        var runTypeSupported = true;
                        switch (runType)
                        {
                            case ConnectedSystemRunType.Export when !ConnectedSystem.ConnectorDefinition.SupportsExport:
                            case ConnectedSystemRunType.DeltaImport when !ConnectedSystem.ConnectorDefinition.SupportsDeltaImport:
                            case ConnectedSystemRunType.FullImport when !ConnectedSystem.ConnectorDefinition.SupportsFullImport:
                                runTypeSupported = false;
                                break;
                            case ConnectedSystemRunType.FullSynchronisation:
                            case ConnectedSystemRunType.DeltaSynchronisation:
                                break;
                        }

                        <MudSelectItem Value="@runType" Disabled="@(!runTypeSupported)">
                            @runType.ToString().SplitOnCapitalLetters()
                            @if (!runTypeSupported)
                            {
                                <span> (not supported by the connector)</span>
                            }
                        </MudSelectItem>
                    }
                </MudSelect>

                @if (ConnectedSystem.ConnectorDefinition.SupportsFilePaths &&
                     IsImportOrExportRunType(_newRunProfile.RunType))
                {
                    <MudTextField T="string" @bind-Value="_newRunProfile.FilePath" Label="File Path" Variant="Variant.Outlined"
                                  Class="mt-3"
                                  HelperText="File-based connectors need the in-container path specifying, i.e. /connector-files/Users.csv" />
                }

                @if (IsImportRunType(_newRunProfile.RunType) && ConnectedSystem.ConnectorDefinition.SupportsPartitions && ConnectedSystem.Partitions != null)
                {
                    <MudSelect T="ConnectedSystemPartition" @bind-Value="_newRunProfile.Partition" Label="Partition"
                               Variant="Variant.Outlined" Class="mt-5" AnchorOrigin="Origin.BottomLeft" Clearable="true"
                               HelperText="Optional. Leave empty to import from all selected partitions.">
                        @foreach (var partition in ConnectedSystem.Partitions.Where(p => p.Selected))
                        {
                            <MudSelectItem Value="@partition" />
                        }
                    </MudSelect>
                }

                @if (IsImportRunType(_newRunProfile.RunType) && ConnectedSystem.ConnectorDefinition.SupportsPaging)
                {
                    <MudNumericField @bind-Value="_newRunProfile.PageSize" Label="Page Size" Variant="Variant.Outlined"
                                     Class="mt-3" Min="0" Step="100" Required="true" Immediate="true"
                                     RequiredError="How many items to process in one go when importing" />
                }

                @if (_newRunProfile.RunType == ConnectedSystemRunType.FullImport)
                {
                    <div class="d-flex align-center mt-3">
                        <MudCheckBox T="bool" @bind-Value="_newRunProfile.VerifyImportContentHashes" Label="Verification Mode" />
                        <MudTooltip Text="Runs the honest attribute diff on every object instead of skipping unchanged objects by content hash, and reports any disagreement between the stored hash and the diff as an error. Use temporarily to validate the content-hash skip optimisation; leave off for normal, faster Full Imports."
                                    Arrow="true" Placement="Placement.Top">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="ms-1 mud-text-secondary" />
                        </MudTooltip>
                    </div>
                }
            </MudForm>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _newRunProfileDialogVisible = false)" DropShadow="false">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
                       OnClick="HandleNewRunProfileFormSubmitAsync"
                       Disabled="@(!IsNewRunProfileFormValid || _newRunProfile.RunType == ConnectedSystemRunType.NotSet)">
                Create Run Profile
            </MudButton>
        </DialogActions>
    </MudDialog>

    @* Edit Run Profile Dialog *@
    <MudDialog @bind-Visible="_editRunProfileDialogVisible" Options="_newRunProfileDialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Class="me-3" /> Edit Run Profile
            </MudText>
        </TitleContent>
        <DialogContent>
            <MudForm @bind-IsValid="@_isEditRunProfileFormValid">
                <PrefilledFormValidator />
                <MudTextField T="string" @bind-Value="_editRunProfile.Name" Label="Name" Variant="Variant.Outlined"
                              Class="mt-3" Required="true" RequiredError="A name for the Run Profile is required" Immediate="true" />

                <MudTextField T="string" Value="@_editRunProfile.RunType.ToString().SplitOnCapitalLetters()" Label="Run Type"
                              Variant="Variant.Outlined" Class="mt-5" Disabled="true"
                              HelperText="The run type cannot be changed. Delete and recreate the profile to use a different type." />

                @if (ConnectedSystem.ConnectorDefinition.SupportsFilePaths &&
                     IsImportOrExportRunType(_editRunProfile.RunType))
                {
                    <MudTextField T="string" @bind-Value="_editRunProfile.FilePath" Label="File Path" Variant="Variant.Outlined"
                                  Class="mt-3"
                                  HelperText="File-based connectors need the in-container path specifying, i.e. /connector-files/Users.csv" />
                }

                @if (IsImportRunType(_editRunProfile.RunType) && ConnectedSystem.ConnectorDefinition.SupportsPartitions && ConnectedSystem.Partitions != null)
                {
                    <MudSelect T="ConnectedSystemPartition" @bind-Value="_editRunProfile.Partition" Label="Partition"
                               Variant="Variant.Outlined" Class="mt-5" AnchorOrigin="Origin.BottomLeft" Clearable="true"
                               HelperText="Optional. Leave empty to import from all selected partitions.">
                        @foreach (var partition in ConnectedSystem.Partitions.Where(p => p.Selected))
                        {
                            <MudSelectItem Value="@partition" />
                        }
                    </MudSelect>
                }

                @if (IsImportRunType(_editRunProfile.RunType) && ConnectedSystem.ConnectorDefinition.SupportsPaging)
                {
                    <MudNumericField @bind-Value="_editRunProfile.PageSize" Label="Page Size" Variant="Variant.Outlined"
                                     Class="mt-3" Min="0" Step="100" Required="true" Immediate="true"
                                     RequiredError="How many items to process in one go when importing" />
                }

                @if (_editRunProfile.RunType == ConnectedSystemRunType.FullImport)
                {
                    <div class="d-flex align-center mt-3">
                        <MudCheckBox T="bool" @bind-Value="_editRunProfile.VerifyImportContentHashes" Label="Verification Mode" />
                        <MudTooltip Text="Runs the honest attribute diff on every object instead of skipping unchanged objects by content hash, and reports any disagreement between the stored hash and the diff as an error. Use temporarily to validate the content-hash skip optimisation; leave off for normal, faster Full Imports."
                                    Arrow="true" Placement="Placement.Top">
                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="ms-1 mud-text-secondary" />
                        </MudTooltip>
                    </div>
                }
            </MudForm>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _editRunProfileDialogVisible = false)" DropShadow="false">Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
                       OnClick="HandleEditRunProfileFormSubmitAsync"
                       Disabled="@(!_isEditRunProfileFormValid)">
                Save Changes
            </MudButton>
        </DialogActions>
    </MudDialog>

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private VirtualisedDataGrid<ConnectedSystemRunProfile>? _grid;

    private bool IsNewRunProfileFormValid { get; set; }
    private ConnectedSystemRunProfile _newRunProfile = new() { RunType = ConnectedSystemRunType.NotSet };
    private readonly DialogOptions _newRunProfileDialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };
    private bool _newRunProfileDialogVisible;

    private bool _isEditRunProfileFormValid;
    private ConnectedSystemRunProfile _editRunProfile = new();
    private ConnectedSystemRunProfile? _editRunProfileOriginal;
    private bool _editRunProfileDialogVisible;

    /// <summary>
    /// Slices one window of Run Profiles from the collection held on the Connected System the page already loaded,
    /// applying the grid's search (name, run type and file path) and sort. A Connected System has a handful of Run
    /// Profiles, so this stays in memory rather than growing a database range read.
    /// </summary>
    private Task<VirtualisedWindow<ConnectedSystemRunProfile>> LoadRunProfileWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        IEnumerable<ConnectedSystemRunProfile> runProfiles = ConnectedSystem.RunProfiles ?? new List<ConnectedSystemRunProfile>();

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            runProfiles = runProfiles.Where(rp =>
                rp.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                rp.RunType.ToString().SplitOnCapitalLetters().Contains(search, StringComparison.OrdinalIgnoreCase) ||
                (rp.FilePath != null && rp.FilePath.Contains(search, StringComparison.OrdinalIgnoreCase)));
        }

        IOrderedEnumerable<ConnectedSystemRunProfile> Order<TKey>(Func<ConnectedSystemRunProfile, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? runProfiles.OrderByDescending(key, comparer) : runProfiles.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "runtype" => Order(rp => rp.RunType),
            "partition" => Order(rp => rp.Partition?.Name ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            "pagesize" => Order(rp => rp.PageSize),
            "filepath" => Order(rp => rp.FilePath ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            _ => Order(rp => rp.Name, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    /// <summary>
    /// Refreshes the grid over the Run Profile collection after it has been added to, edited or removed from. The
    /// totals are invalidated because the change may have altered how many Run Profiles exist or match the search.
    /// </summary>
    private async Task RefreshGridAsync()
    {
        if (_grid != null)
            await _grid.RefreshAsync(invalidateTotals: true);
    }

    private static bool IsImportRunType(ConnectedSystemRunType runType) =>
        runType is ConnectedSystemRunType.FullImport or ConnectedSystemRunType.DeltaImport;

    private static bool IsImportOrExportRunType(ConnectedSystemRunType runType) =>
        runType is ConnectedSystemRunType.FullImport or ConnectedSystemRunType.DeltaImport or ConnectedSystemRunType.Export;

    private string? ValidateRunType(ConnectedSystemRunType runType)
    {
        if (runType == ConnectedSystemRunType.NotSet)
            return "Please select a run type";

        return null;
    }

    private Task HandleShowNewRunProfileDialogAsync()
    {
        _newRunProfile = new ConnectedSystemRunProfile { RunType = ConnectedSystemRunType.NotSet };
        _newRunProfileDialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task HandleNewRunProfileFormSubmitAsync()
    {
        if (ConnectedSystem.RunProfiles == null)
            return;

        // Keep a reference to the partition for UI display after save
        // (the repository nulls the navigation property to avoid EF identity conflicts)
        var selectedPartition = _newRunProfile.Partition;

        var runProfile = new ConnectedSystemRunProfile
        {
            ConnectedSystemId = ConnectedSystem.Id,
            Name = _newRunProfile.Name,
            RunType = _newRunProfile.RunType,
            Partition = selectedPartition,
            PageSize = _newRunProfile.PageSize,
            FilePath = _newRunProfile.FilePath,
            VerifyImportContentHashes = _newRunProfile.RunType == ConnectedSystemRunType.FullImport && _newRunProfile.VerifyImportContentHashes
        };

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.ConnectedSystems.CreateConnectedSystemRunProfileAsync(runProfile, user);

            // Restore partition reference for UI display, then add to local collection
            runProfile.Partition = selectedPartition;
            ConnectedSystem.RunProfiles.Add(runProfile);

            Snackbar.Add("New Run Profile added.", Severity.Success);
            _newRunProfileDialogVisible = false;
            _newRunProfile = new ConnectedSystemRunProfile { RunType = ConnectedSystemRunType.NotSet };
            await RefreshGridAsync();
        }
        catch
        {
            Snackbar.Add("Failed to create Run Profile. Please try again.", Severity.Error);
        }
    }

    private Task HandleShowEditRunProfileDialogAsync(ConnectedSystemRunProfile runProfile)
    {
        _editRunProfileOriginal = runProfile;
        _editRunProfile = new ConnectedSystemRunProfile
        {
            Id = runProfile.Id,
            ConnectedSystemId = runProfile.ConnectedSystemId,
            Name = runProfile.Name,
            RunType = runProfile.RunType,
            PageSize = runProfile.PageSize,
            FilePath = runProfile.FilePath,
            Partition = runProfile.Partition,
            VerifyImportContentHashes = runProfile.VerifyImportContentHashes
        };
        _editRunProfileDialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task HandleEditRunProfileFormSubmitAsync()
    {
        if (_editRunProfileOriginal == null)
            return;

        var selectedPartition = _editRunProfile.Partition;

        _editRunProfileOriginal.Name = _editRunProfile.Name;
        _editRunProfileOriginal.PageSize = _editRunProfile.PageSize;
        _editRunProfileOriginal.FilePath = _editRunProfile.FilePath;
        _editRunProfileOriginal.Partition = selectedPartition;
        _editRunProfileOriginal.VerifyImportContentHashes = _editRunProfileOriginal.RunType == ConnectedSystemRunType.FullImport && _editRunProfile.VerifyImportContentHashes;

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.ConnectedSystems.UpdateConnectedSystemRunProfileAsync(_editRunProfileOriginal, user);

            _editRunProfileOriginal.Partition = selectedPartition;

            Snackbar.Add("Run Profile updated.", Severity.Success);
            _editRunProfileDialogVisible = false;
            await RefreshGridAsync();
        }
        catch
        {
            Snackbar.Add("Failed to update Run Profile. Please try again.", Severity.Error);
        }
    }

    private async Task HandleRunProfileDeleteAsync(ConnectedSystemRunProfile connectedSystemRunProfile)
    {
        if (ConnectedSystem.RunProfiles == null)
            return;

        var confirmationResult = await DialogService.ShowMessageBoxAsync(
            "Delete Run Profile",
            $"Are you sure you want to delete the Run Profile '{connectedSystemRunProfile.Name}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmationResult != true)
            return;

        ConnectedSystem.RunProfiles.Remove(connectedSystemRunProfile);

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.ConnectedSystems.DeleteConnectedSystemRunProfileAsync(connectedSystemRunProfile, user);

        Snackbar.Add("Run Profile removed.", Severity.Success);
        await RefreshGridAsync();
    }
}
