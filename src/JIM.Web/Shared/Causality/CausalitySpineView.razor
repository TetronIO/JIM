@* The causality Spine view (#1495): the object graph as columns (each record with its Connected
   System named beneath it, and the Identity), joined by labelled relationships, with every causally
   relevant event stacked on the column of the object it happened to. This run's events render
   primary (accent ring and badge) around the shared event card, so tones, entity chips, attribute
   counts and the shared drawer keep working; earlier runs' events render as subdued chain cards
   carrying their run kind, timestamp and activity link. Chain endings close their columns as quiet
   footers. Wide stories scroll horizontally inside the scroller; narrow viewports stack the columns
   vertically, per the Flow view's existing breakpoint. *@

<div class="sp-scroller">
    @if (Model.IsTruncatedByDepth)
    {
        <div class="sp-truncated">Some branches go further back than shown</div>
    }
    <div class="sp-canvas" style="grid-template-columns: @GridTemplateColumns">
        @for (var i = 0; i < Model.Columns.Count; i++)
        {
            var column = Model.Columns[i];
            @if (i > 0)
            {
                var join = Model.Joins[i - 1];
                <div class="sp-join" @key="@($"join-{i}")">
                    <span class="sp-join-arrow" aria-hidden="true">&rarr;</span>
                    @if (join.Label != null)
                    {
                        <span class="sp-join-label">@join.Label</span>
                    }
                </div>
            }
            <div class="sp-col" @key="column">
                <div class="sp-obj">
                    @if (column.Kind != CausalitySpineColumnKind.Unassigned)
                    {
                        <span class="glyph @(column.Kind == CausalitySpineColumnKind.Identity ? "idn" : "rec")"
                              aria-hidden="true">@(column.Kind == CausalitySpineColumnKind.Identity ? "ID" : "R")</span>
                    }
                    @if (column.Href != null)
                    {
                        <a class="sp-obj-title" href="@column.Href">@GetColumnTitle(column)</a>
                    }
                    else
                    {
                        <span class="sp-obj-title">@GetColumnTitle(column)</span>
                    }
                    @if (GetColumnSub(column) is { } columnSub)
                    {
                        <span class="sp-obj-sub">@columnSub</span>
                    }
                </div>
                @foreach (var card in column.Cards)
                {
                    @if (card.Event is { } thisRunEvent)
                    {
                        @* The head names the column's system, so the card's own system chip would
                           restate it; suppressed exactly as the Flow view's system groups do. *@
                        <div class="sp-now" @key="card">
                            <span class="sp-now-badge">This run</span>
                            <CausalityEventCard Event="thisRunEvent" TechnicalNames="TechnicalNames"
                                                HideSystemChip="true"
                                                Selected="ReferenceEquals(SelectedEvent, thisRunEvent)"
                                                OnSelect="ToggleSelectionAsync" />
                        </div>
                    }
                    else if (card.Hop is { } hop)
                    {
                        <CausalitySpineChainCard Hop="hop" @key="card" />
                    }
                }
                @foreach (var ending in column.Endings)
                {
                    <div class="sp-end" @key="ending">@ending.Text</div>
                }
            </div>
        }
    </div>
</div>

@code {
    /// <summary>
    /// The spine model to render.
    /// </summary>
    [Parameter, EditorRequired]
    public CausalitySpineModel Model { get; set; } = null!;

    /// <summary>
    /// When true, technical labels (MVO/CSO vocabulary) are emphasised and plain language demoted.
    /// </summary>
    [Parameter]
    public bool TechnicalNames { get; set; }

    /// <summary>
    /// The currently selected event (whose attribute detail the panel shows in the drawer); null
    /// when none. Two-way bindable so the panel owns the state.
    /// </summary>
    [Parameter]
    public CausalityEvent? SelectedEvent { get; set; }

    [Parameter]
    public EventCallback<CausalityEvent?> SelectedEventChanged { get; set; }

    /// <summary>
    /// The canvas grid: one flexible track per column with a fixed join track between each adjacent
    /// pair, so the joins render in the grid flow rather than being absolutely positioned.
    /// </summary>
    private string GridTemplateColumns
    {
        get
        {
            var parts = new List<string>();
            for (var i = 0; i < Model.Columns.Count; i++)
            {
                if (i > 0)
                    parts.Add("44px");
                parts.Add("minmax(230px, 1fr)");
            }

            return string.Join(" ", parts);
        }
    }

    private static string GetColumnTitle(CausalitySpineColumn column)
    {
        return column.Kind == CausalitySpineColumnKind.Record && column.ObjectTypeName != null
            ? $"{column.ObjectTypeName}: {column.Title}"
            : column.Title;
    }

    /// <summary>
    /// The head's second line: which system a record lives in, or that the column is the Identity
    /// (with its Metaverse Object Type where known). The trailing unassigned column explains itself
    /// instead.
    /// </summary>
    private static string? GetColumnSub(CausalitySpineColumn column)
    {
        return column.Kind switch
        {
            CausalitySpineColumnKind.Record => column.SystemName != null ? $"record in {column.SystemName}" : null,
            CausalitySpineColumnKind.Identity => column.ObjectTypeName != null
                ? $"Identity · {column.ObjectTypeName}"
                : "Identity",
            _ => "causes this view could not place"
        };
    }

    private Task ToggleSelectionAsync(CausalityEvent causalityEvent)
    {
        var newValue = ReferenceEquals(SelectedEvent, causalityEvent) ? null : causalityEvent;
        return SelectedEventChanged.InvokeAsync(newValue);
    }
}
