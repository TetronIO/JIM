@* One Object Type of the SQL Connector's Object Types document. Collapsed, it summarises itself; expanded, it asks
   only what JIM cannot work out from the database: where the objects come from, what identifies them, which
   columns reference other Object Types, which child tables hold multi-valued attributes, and what the Delta
   Import Mode needs. Every other column is discovered and typed on the Schema tab. *@
<MudPaper Outlined="true" Class="jim-sql-object-type-card mb-3" data-testid="jim-sql-object-type-card">
    <div class="jim-sql-object-type-card-header" role="button" tabindex="0" aria-expanded="@(Expanded ? "true" : "false")"
         @onclick="ToggleAsync" @onkeydown="OnHeaderKeyDownAsync" data-testid="jim-sql-object-type-card-header">
        <MudIcon Icon="@Icons.Material.Outlined.TableChart" Class="mr-3 mud-text-secondary" />
        <div class="jim-sql-object-type-card-title">
            <MudText Typo="Typo.h6" Inline="true">@(string.IsNullOrWhiteSpace(ObjectType.Name) ? "Unnamed Object Type" : ObjectType.Name)</MudText>
            @if (IsSelect || string.IsNullOrWhiteSpace(ObjectType.Table))
            {
                <MudText Inline="true" Class="mud-text-secondary ml-3">@SqlObjectTypesEditorModel.SourceOf(ObjectType)</MudText>
            }
            else
            {
                <code class="jim-code-inline ml-3">@SqlObjectTypesEditorModel.SourceOf(ObjectType)</code>
            }
        </div>
        @if (!Expanded)
        {
            <div class="jim-sql-object-type-card-chips">
                @foreach (var chip in SqlObjectTypesEditorModel.SummaryOf(ObjectType))
                {
                    <MudChip T="string" Variant="Variant.Text" Color="@ChipColour(chip.Kind)" Class="my-0">@chip.Text</MudChip>
                }
            </div>
        }
        <MudSpacer />
        @if (Problems.Count > 0)
        {
            <span class="jim-sql-object-type-card-problems mud-error-text" data-testid="jim-sql-object-type-problem-marker">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Class="mr-1" />
                @(Problems.Count == 1 ? "1 problem" : $"{Problems.Count} problems")
            </span>
        }
        <MudIcon Icon="@(Expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="ml-2" />
    </div>

    @if (Expanded)
    {
        <div class="jim-sql-object-type-card-body">
            @if (Problems.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" data-testid="jim-sql-object-type-problems">
                    @if (Problems.Count == 1)
                    {
                        @Problems[0]
                    }
                    else
                    {
                        <ul class="ml-4">
                            @foreach (var problem in Problems)
                            {
                                <li>@problem</li>
                            }
                        </ul>
                    }
                </MudAlert>
            }

            @* ─── Name and source ─── *@
            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    @* Commits on blur rather than per keystroke: renaming moves every reference to the Object Type
                       onto the new name, and doing that for each partial name typed could pass through another
                       Object Type's name on the way. *@
                    <MudTextField T="string" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Value="@ObjectType.Name" ValueChanged="OnNameChangedAsync"
                                  HelperText="What JIM calls this Object Type." data-testid="jim-sql-object-type-name" />
                </MudItem>
                @if (IsSelect)
                {
                    <MudItem xs="12" md="8">
                        <MudTextField T="string" Label="SELECT statement" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Lines="4" Class="jim-setting-text" spellcheck="false"
                                      Value="@ObjectType.Select" ValueChanged="OnSelectChangedAsync"
                                      HelperText="An Object Type read from a statement can be imported, but JIM cannot export to it." />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12" sm="6" md="3">
                        <SqlCatalogueNameField Label="Schema" Value="@ObjectType.Schema" Options="@SchemaOptions"
                                               ValueChanged="OnSchemaChangedAsync" TestId="jim-sql-object-type-schema" />
                    </MudItem>
                    <MudItem xs="12" sm="6" md="5">
                        <SqlCatalogueNameField Label="Table or view" Value="@ObjectType.Table" Options="@TableOptions(ObjectType.Schema)"
                                               ValueChanged="OnTableChangedAsync" TestId="jim-sql-object-type-table" />
                    </MudItem>
                }
            </MudGrid>
            <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1" OnClick="ToggleSourceKindAsync">
                @(IsSelect ? "Read from a table or view instead" : "Read from a SELECT statement instead")
            </MudButton>
            @if (_sourceMessage != null)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1" data-testid="jim-sql-object-type-source-message">@_sourceMessage</MudText>
            }

            @* ─── Anchor ─── *@
            <MudText Typo="Typo.subtitle1" Class="jim-sql-section-title mt-5">Anchor</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">The column or columns whose values identify a row, in key order.</MudText>
            <SqlAnchorColumnsField ObjectType="@ObjectType" ColumnOptions="@ColumnOptions" OnChanged="NotifyAsync" />
            @if (PrimaryKeyAnchor.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="jim-sql-inline-alert mt-3" data-testid="jim-sql-anchor-suggestion">
                    <div class="jim-sql-inline-alert-body">
                        <span class="jim-sql-inline-alert-text">
                            The table's primary key is <SqlColumnList Columns="@PrimaryKeyAnchor" />, which identifies each row.
                        </span>
                        <span class="jim-sql-inline-alert-actions">
                            <AlertButton Severity="Severity.Info" Size="Size.Small" OnClick="UsePrimaryKeyAsync">Use the primary key</AlertButton>
                        </span>
                    </div>
                </MudAlert>
            }

            @* ─── References ─── *@
            <MudText Typo="Typo.subtitle1" Class="jim-sql-section-title mt-5">References to other Object Types</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Columns whose values hold another object's anchor, such as a manager.</MudText>
            <SqlObjectTypeReferences ObjectType="@ObjectType" ObjectTypeNames="@ObjectTypeNames" ColumnOptions="@ColumnOptions"
                                     Suggestions="@Suggestions" OnAccept="AcceptAsync" OnDismiss="DismissAsync"
                                     OnAddObjectType="OnAddObjectType" OnChanged="NotifyAsync" />

            @* ─── Multi-valued attributes ─── *@
            <MudText Typo="Typo.subtitle1" Class="jim-sql-section-title mt-5">Multi-valued attributes</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Child tables holding one row per value, such as phone numbers or group members.</MudText>
            <SqlObjectTypeRelatedTables ObjectType="@ObjectType" ObjectTypeNames="@ObjectTypeNames" CatalogueObjects="@CatalogueObjects"
                                        LoadTable="@LoadTable" ShowWatermark="@(DeltaImportMode == SqlConnectorConstants.DeltaImportModeWatermarkColumn)"
                                        OnChanged="NotifyAsync" />

            @* ─── Delta Import ─── *@
            @if (DeltaImportMode == SqlConnectorConstants.DeltaImportModeWatermarkColumn)
            {
                <MudText Typo="Typo.subtitle1" Class="jim-sql-section-title mt-5">Delta Import</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    Delta Import Mode is Watermark Column: a Delta Import reads the rows whose watermark has moved on since the last import.
                </MudText>
                <SqlCatalogueNameField Label="Watermark column" Value="@ObjectType.WatermarkColumn" Options="@ColumnOptions"
                                       ValueChanged="@(v => SetAndNotifyAsync(() => ObjectType.WatermarkColumn = v))"
                                       HelperText="A last-modified timestamp or row version on the source." Class="jim-sql-wide-picker"
                                       TestId="jim-sql-watermark-column" />
            }
            else if (DeltaImportMode == SqlConnectorConstants.DeltaImportModeChangeLogTable)
            {
                <MudText Typo="Typo.subtitle1" Class="jim-sql-section-title mt-5">Delta Import</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                    Delta Import Mode is Change-Log Table: a Delta Import reads a table recording each change, deletions included.
                </MudText>
                <div data-testid="jim-sql-change-log">
                    @if (ObjectType.ChangeLog is not { } changeLog)
                    {
                        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add" OnClick="AddChangeLogAsync">Add change-log table</MudButton>
                    }
                    else
                    {
                        <MudGrid Spacing="2">
                            <MudItem xs="12" sm="5">
                                <SqlCatalogueNameField Label="Change-log schema" Value="@changeLog.Schema" Options="@SchemaOptions"
                                                       ValueChanged="@(v => SetAndNotifyAsync(() => changeLog.Schema = v))" />
                            </MudItem>
                            <MudItem xs="12" sm="7">
                                <SqlCatalogueNameField Label="Change-log table" Value="@changeLog.Table" Options="@TableOptions(changeLog.Schema)"
                                                       ValueChanged="OnChangeLogTableChangedAsync" />
                            </MudItem>
                            @for (var i = 0; i < AnchorColumns.Count; i++)
                            {
                                var position = i;
                                <MudItem xs="12" sm="6">
                                    <SqlCatalogueNameField Label="@($"Column holding {AnchorColumns[position]}")" Value="@ChangeLogAnchorAt(position)"
                                                           Options="@ChangeLogColumnOptions" ValueChanged="@(v => SetChangeLogAnchorAsync(position, v))" />
                                </MudItem>
                            }
                            <MudItem xs="12" sm="6">
                                <SqlCatalogueNameField Label="Sequence column" Value="@changeLog.SequenceColumn" Options="@ChangeLogColumnOptions"
                                                       ValueChanged="@(v => SetAndNotifyAsync(() => changeLog.SequenceColumn = v))"
                                                       HelperText="Orders the changes: a sequence number or timestamp." />
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <SqlCatalogueNameField Label="Change type column" Value="@changeLog.ChangeTypeColumn" Options="@ChangeLogColumnOptions"
                                                       ValueChanged="@(v => SetAndNotifyAsync(() => changeLog.ChangeTypeColumn = v))"
                                                       HelperText="Says whether a row records a creation, an update or a deletion." />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField T="string" Label="Created when" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Value="@JoinValues(changeLog.CreateValues)" ValueChanged="@(v => SetAndNotifyAsync(() => changeLog.CreateValues = SplitValues(v)))"
                                              HelperText="Values meaning created, separated by commas." />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField T="string" Label="Updated when" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Value="@JoinValues(changeLog.UpdateValues)" ValueChanged="@(v => SetAndNotifyAsync(() => changeLog.UpdateValues = SplitValues(v)))"
                                              HelperText="Values meaning updated." />
                            </MudItem>
                            <MudItem xs="12" sm="4">
                                <MudTextField T="string" Label="Deleted when" Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Value="@JoinValues(changeLog.DeleteValues)" ValueChanged="@(v => SetAndNotifyAsync(() => changeLog.DeleteValues = SplitValues(v)))"
                                              HelperText="Values meaning deleted." />
                            </MudItem>
                        </MudGrid>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1" OnClick="@(() => SetAndNotifyAsync(() => ObjectType.ChangeLog = null))">Remove change-log table</MudButton>
                    }
                </div>
            }

            @* ─── Footer ─── *@
            <div class="d-flex align-center flex-wrap gap-3 mt-6">
                @if (OtherColumnCount is int otherColumns and > 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary" data-testid="jim-sql-other-columns">
                        <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="mr-1" Style="vertical-align: text-bottom;" />
                        @(otherColumns == 1 ? "The other column is" : $"The other {otherColumns} columns are") discovered and typed automatically on the Schema tab.
                    </MudText>
                }
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete"
                           OnClick="@(() => OnRemove.InvokeAsync())" data-testid="jim-sql-object-type-remove">Remove Object Type</MudButton>
            </div>
        </div>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public SqlObjectTypesEditorModel Model { get; set; } = null!;

    /// <summary>The Object Type's position in the document.</summary>
    [Parameter, EditorRequired]
    public int Index { get; set; }

    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    /// <summary>The tables and views to choose from, or empty where the catalogue could not be read.</summary>
    [Parameter]
    public IReadOnlyList<ConnectorCatalogueObject> CatalogueObjects { get; set; } = [];

    /// <summary>Reads a table or view's columns and keys; null where there is no catalogue to read.</summary>
    [Parameter]
    public Func<string?, string, Task<ConnectedSystemCatalogueRead<ConnectorCatalogueObjectDetail>>>? LoadTable { get; set; }

    /// <summary>Describes a SELECT statement's columns; null where there is no catalogue to read.</summary>
    [Parameter]
    public Func<string, Task<ConnectedSystemCatalogueRead<ConnectorCatalogueObjectDetail>>>? DescribeStatement { get; set; }

    [Parameter]
    public string? DeltaImportMode { get; set; }

    /// <summary>Raised after every change to the document, so the editor can write it back to the setting.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter]
    public EventCallback<SqlObjectTypeSuggestion> OnAddObjectType { get; set; }

    private ConnectorCatalogueObjectDetail? _source;
    private string? _sourceMessage;
    private string? _loadedSourceKey;
    private ConnectorCatalogueObjectDetail? _changeLogTable;
    private string? _loadedChangeLogKey;

    private SqlObjectTypeDocument ObjectType => Model.ObjectTypes[Index];

    private bool IsSelect => ObjectType.Select != null;

    private IReadOnlyList<string> Problems => Model.ProblemsFor(Index);

    private List<string> AnchorColumns => (ObjectType.AnchorColumns ?? []).OfType<string>().ToList();

    private IReadOnlyList<string> PrimaryKeyAnchor => SqlObjectTypesEditorModel.PrimaryKeyAnchor(ObjectType, _source);

    private IReadOnlyList<SqlObjectTypeSuggestion> Suggestions => Model.SuggestionsFor(Index, _source);

    private int? OtherColumnCount => SqlObjectTypesEditorModel.OtherColumnCount(ObjectType, _source);

    private IEnumerable<string> ObjectTypeNames => Model.ObjectTypes.Select(o => o.Name).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> SchemaOptions => CatalogueObjects.Select(o => o.SchemaName).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase);

    private IEnumerable<string> ColumnOptions => _source?.Columns.Select(c => c.Name) ?? [];

    private IEnumerable<string> ChangeLogColumnOptions => _changeLogTable?.Columns.Select(c => c.Name) ?? [];

    private IEnumerable<string> TableOptions(string? schema) => CatalogueObjects
        .Where(o => string.IsNullOrWhiteSpace(schema) || string.Equals(o.SchemaName, schema, StringComparison.OrdinalIgnoreCase))
        .Select(o => o.Name)
        .Distinct(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnParametersSetAsync()
    {
        if (Expanded)
            await LoadSourceAsync();
    }

    /// <summary>
    /// Reads the source's columns and keys when the card is open and its source has changed since they were last
    /// read. Cards stay closed until asked for, so a document of many Object Types reads nothing up front.
    /// </summary>
    private async Task LoadSourceAsync()
    {
        // Which reader is in use is part of the key, so columns are read once one becomes available (the
        // catalogue finishes loading, or a Retry succeeds) without the source having changed.
        var readable = IsSelect ? DescribeStatement != null : LoadTable != null;
        var key = IsSelect ? $"S|{readable}|{ObjectType.Select}" : $"T|{readable}|{ObjectType.Schema}|{ObjectType.Table}";
        if (key == _loadedSourceKey)
            return;

        _loadedSourceKey = key;
        _source = null;
        _sourceMessage = null;

        if (IsSelect)
        {
            if (DescribeStatement == null || string.IsNullOrWhiteSpace(ObjectType.Select))
                return;

            var described = await DescribeStatement(ObjectType.Select);
            _source = described.Value;
            _sourceMessage = described.Failure != null ? $"The statement's columns could not be read, so type their names: {described.Failure}" : null;
        }
        else
        {
            if (LoadTable == null || string.IsNullOrWhiteSpace(ObjectType.Table))
                return;

            var read = await LoadTable(ObjectType.Schema, ObjectType.Table);
            _source = read.Value;
            _sourceMessage = read.Failure != null
                ? $"The table's columns could not be read, so type their names: {read.Failure}"
                : read.Value == null ? "The database account cannot see a table or view of that name. Check the name, the schema, and the account's permissions." : null;
        }

        await LoadChangeLogTableAsync();
    }

    private async Task LoadChangeLogTableAsync()
    {
        var changeLog = ObjectType.ChangeLog;
        var key = changeLog == null ? null : $"{LoadTable != null}|{changeLog.Schema}|{changeLog.Table}";
        if (key == _loadedChangeLogKey)
            return;

        _loadedChangeLogKey = key;
        _changeLogTable = null;
        if (LoadTable == null || changeLog == null || string.IsNullOrWhiteSpace(changeLog.Table))
            return;

        _changeLogTable = (await LoadTable(changeLog.Schema, changeLog.Table)).Value;
    }

    private Task ToggleAsync() => ExpandedChanged.InvokeAsync(!Expanded);

    private async Task OnHeaderKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            await ToggleAsync();
    }

    private async Task NotifyAsync()
    {
        Model.Revalidate();
        await OnChanged.InvokeAsync();
    }

    private async Task SetAndNotifyAsync(Action change)
    {
        change();
        await NotifyAsync();
    }

    private async Task OnNameChangedAsync(string? name)
    {
        Model.RenameObjectType(Index, name);
        await OnChanged.InvokeAsync();
    }

    private async Task OnSchemaChangedAsync(string? schema)
    {
        ObjectType.Schema = schema;
        await NotifyAsync();
        await LoadSourceAsync();
    }

    private async Task OnTableChangedAsync(string? table)
    {
        ObjectType.Table = table;

        // A name in exactly one schema is that schema's table; saying so keeps the document unambiguous.
        if (string.IsNullOrWhiteSpace(ObjectType.Schema) && table != null)
        {
            var matches = CatalogueObjects.Where(o => string.Equals(o.Name, table, StringComparison.OrdinalIgnoreCase)).ToList();
            if (matches.Count == 1)
                ObjectType.Schema = matches[0].SchemaName;
        }

        await NotifyAsync();
        await LoadSourceAsync();
    }

    private async Task OnSelectChangedAsync(string? statement)
    {
        ObjectType.Select = statement ?? string.Empty;
        await NotifyAsync();
        await LoadSourceAsync();
    }

    /// <summary>
    /// Switches between a table or view and a SELECT statement. The document holds exactly one of the two, so the
    /// other is cleared; an empty statement marks the choice until one is typed.
    /// </summary>
    private async Task ToggleSourceKindAsync()
    {
        if (IsSelect)
        {
            ObjectType.Select = null;
        }
        else
        {
            ObjectType.Select = string.Empty;
            ObjectType.Schema = null;
            ObjectType.Table = null;
        }

        await NotifyAsync();
        await LoadSourceAsync();
    }

    private async Task UsePrimaryKeyAsync()
    {
        ObjectType.AnchorColumns = [.. PrimaryKeyAnchor];
        await NotifyAsync();
    }

    private async Task AcceptAsync(SqlObjectTypeSuggestion suggestion)
    {
        Model.AcceptReference(Index, suggestion);
        await OnChanged.InvokeAsync();
    }

    private Task DismissAsync(SqlObjectTypeSuggestion suggestion)
    {
        Model.Dismiss(Index, suggestion);
        return Task.CompletedTask;
    }

    private async Task AddChangeLogAsync()
    {
        ObjectType.ChangeLog = new SqlChangeLogDocument { Schema = ObjectType.Schema };
        await NotifyAsync();
    }

    private async Task OnChangeLogTableChangedAsync(string? table)
    {
        if (ObjectType.ChangeLog is not { } changeLog)
            return;

        changeLog.Table = table;
        await NotifyAsync();
        await LoadChangeLogTableAsync();
    }

    private string? ChangeLogAnchorAt(int position) =>
        ObjectType.ChangeLog?.AnchorColumns is { } columns && position < columns.Count ? columns[position] : null;

    private async Task SetChangeLogAnchorAsync(int position, string? column)
    {
        if (ObjectType.ChangeLog is not { } changeLog)
            return;

        var columns = changeLog.AnchorColumns ??= [];
        while (columns.Count <= position)
            columns.Add(null);

        columns[position] = column;
        await NotifyAsync();
    }

    private static string? JoinValues(List<string?>? values) => values == null ? null : string.Join(", ", values);

    private static List<string?>? SplitValues(string? text)
    {
        var values = (text ?? string.Empty).Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        return values.Length == 0 ? null : [.. values];
    }

    private static Color ChipColour(SqlObjectTypeSummaryChipKind kind) => kind switch
    {
        SqlObjectTypeSummaryChipKind.Anchor => Color.Primary,
        SqlObjectTypeSummaryChipKind.Reference => Color.Secondary,
        _ => Color.Default
    };
}
