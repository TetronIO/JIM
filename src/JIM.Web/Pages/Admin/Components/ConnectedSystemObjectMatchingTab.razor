<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
    <div>
        <MudText Typo="Typo.body1">
            @if (ConnectedSystem.ObjectMatchingRuleMode == ObjectMatchingRuleMode.ConnectedSystem)
            {
                <text>Matching Rules are defined here per object type and shared across all Synchronisation Rules.</text>
            }
            else
            {
                <text>Matching Rules are configured on each individual Synchronisation Rule.</text>
            }
        </MudText>
    </div>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudText Class="mud-text-secondary">Simple</MudText>
        <MudSwitch T="bool"
                   Value="@(ConnectedSystem.ObjectMatchingRuleMode == ObjectMatchingRuleMode.SyncRule)"
                   ValueChanged="HandleObjectMatchingModeToggleAsync"
                   Color="Color.Primary" />
        <MudText Class="mud-text-secondary">Advanced</MudText>
    </MudStack>
</MudStack>

@if (ConnectedSystem.ObjectMatchingRuleMode == ObjectMatchingRuleMode.SyncRule)
{
    @* Advanced Mode - matching rules are on Synchronisation Rules *@
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
        In Advanced Mode, matching rules are configured on each individual Synchronisation Rule. This allows different
        matching logic for different scenarios.
    </MudAlert>
    <MudButton StartIcon="@Icons.Material.Filled.OpenInNew"
               Variant="Variant.Filled"
               Href="/admin/sync-rules"
               Color="Color.Primary"
               Class="mt-4"
               DropShadow="false">
        Go to Synchronisation Rules
    </MudButton>
}
else if (ConnectedSystem.ObjectTypes == null || ConnectedSystem.ObjectTypes.Count == 0)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
        No object types have been configured. Import the schema first to configure Object Matching Rules.
    </MudAlert>
}
else
{
    var selectedObjectTypes = ConnectedSystem.ObjectTypes.Where(ot => ot.Selected).ToList();

    @if (selectedObjectTypes.Count == 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            No object types have been selected. Select object types in the Schema tab first.
        </MudAlert>
    }
    else if (selectedObjectTypes.Count == 1)
    {
        @* Single object type - show directly without selection UI *@
        @RenderMatchingRulesForObjectType(selectedObjectTypes[0])
    }
    else
    {
        @* Multiple object types - use tabs for navigation *@
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="false" TabPanelsClass="pt-4" Outlined="true" @bind-ActivePanelIndex="_selectedMatchingRuleTabIndex">
            @foreach (var objectType in selectedObjectTypes)
            {
                <MudTabPanel Text="@objectType.Name" Tag="@objectType">
                    @RenderMatchingRulesForObjectType(objectType)
                </MudTabPanel>
            }
        </MudTabs>
    }
}

@* Mode Switch Dialog *@
<MudDialog @bind-Visible="_modeSwitchDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="mr-3 mb-n1" />
            Switch to @(_switchingToAdvancedMode ? "Advanced" : "Simple") Mode
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_switchingToAdvancedMode)
        {
            <MudText>
                Switching to <strong>Advanced Mode</strong> will allow you to configure different matching rules for each Synchronisation Rule.
            </MudText>
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                The current matching rules will be copied to all existing import Synchronisation Rules for this Connected System, giving you a starting point to customise.
            </MudAlert>
        }
        else
        {
            <MudText>
                Switching to <strong>Simple Mode</strong> will configure matching rules here, shared across all Synchronisation Rules.
            </MudText>
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
                <strong>Migration:</strong> Matching rules from Synchronisation Rules will be analysed and migrated to the object type level:
                <ul class="mt-2 mb-0">
                    <li>If all Synchronisation Rules have the same matching rules, they will be used directly.</li>
                    <li>If Synchronisation Rules have different matching rules, the most common configuration will be selected.</li>
                    <li>Matching rules will be cleared from all Synchronisation Rules after migration.</li>
                </ul>
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _modeSwitchDialogVisible = false)" DropShadow="false" Disabled="_modeSwitchInProgress">Cancel</MudButton>
        @* The switch changes which rules apply without editing a rule, so what it costs is only answerable by
           evaluating it. Offered rather than required: the switch destroys nothing by itself, and an administrator
           who has already reasoned it through should not be made to wait for an answer they have. *@
        <MudButton StartIcon="@Icons.Material.Filled.Preview"
                   DropShadow="false"
                   Disabled="@(_modeSwitchInProgress || _startingPreview)"
                   OnClick="PreviewModeSwitchAsync"
                   data-testid="jim-preview-matching-mode-switch">
            Preview Impact
        </MudButton>
        <MudButton
            Color="Color.Primary"
            Variant="Variant.Filled"
            DropShadow="false"
            OnClick="HandleModeSwitchConfirmedAsync"
            Disabled="_modeSwitchInProgress">
            @if (_modeSwitchInProgress)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">Switching...</span>
            }
            else
            {
                <text>Switch Mode</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@if (_previewActivityId.HasValue)
{
    <ConfigurationChangePreviewPanel ActivityId="@_previewActivityId.Value"
                                     Title="Preview: Object Matching Impact"
                                     OnClose="DiscardObjectMatchingPreview"
                                     Class="mt-6" />
}

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [Parameter, EditorRequired]
    public IList<MetaverseAttribute> MetaverseAttributes { get; set; } = null!;

    /// <summary>
    /// The Metaverse Object Types a Simple mode rule can search. Required rather than optional: a rule that names
    /// none has nowhere to look, so the matching engine skips it and the objects that should have joined project
    /// duplicate identities instead (#1458).
    /// </summary>
    [Parameter, EditorRequired]
    public IList<MetaverseObjectType> MetaverseObjectTypes { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // Object Matching Rules
    private int _selectedMatchingRuleTabIndex;
    private ConnectedSystemObjectTypeAttribute? _newMatchingRuleSourceAttribute;
    private MetaverseAttribute? _newMatchingRuleTargetAttribute;
    private MetaverseObjectType? _newMatchingRuleMetaverseObjectType;
    private bool _newMatchingRuleCaseSensitive = false;
    // Track the currently active object type for the matching rules form state
    private ConnectedSystemObjectType? _currentMatchingRuleObjectType;
    // One grid per Object Type, because a Connected System with several selected types renders one table per tab.
    // Keyed by Object Type id so a handler can refresh the grid belonging to the type it just changed.
    private readonly Dictionary<int, VirtualisedDataGrid<ObjectMatchingRule>> _matchingRuleGrids = new();
    // Configuration Change Preview (#1457). Object Matching Rules are saved as they are edited here, so the
    // preview is offered at the two points where a change is still only proposed: the rule being composed in the
    // add form, and the Simple/Advanced switch waiting in its dialog.
    private Guid? _previewActivityId;
    private bool _startingPreview;

    /// <summary>
    /// Forgets the preview, so the panel goes. Nothing here cites it afterwards: matching rules are saved as they
    /// are edited, so there is no later confirmation for it to inform. A preview still running finishes as an
    /// Activity, where it can still be read.
    /// </summary>
    private void DiscardObjectMatchingPreview() => _previewActivityId = null;

    // Mode switch dialog
    private readonly DialogOptions _dialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };
    private bool _modeSwitchDialogVisible;
    private bool _switchingToAdvancedMode;
    private bool _modeSwitchInProgress;

    /// <summary>
    /// Slices one window of an Object Type's Object Matching Rules, always in Order sequence. The order decides
    /// which rule is tried first, so it is the configuration itself rather than a presentation choice, and the
    /// grid's sort request is deliberately not honoured here. The rules live on the Object Type the page already
    /// loaded, so there is no database range read.
    /// </summary>
    private Task<VirtualisedWindow<ObjectMatchingRule>> LoadMatchingRuleWindowAsync(
        ConnectedSystemObjectType objectType, VirtualisedWindowRequest request, CancellationToken token)
    {
        IEnumerable<ObjectMatchingRule> rules = objectType.ObjectMatchingRules;

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            rules = rules.Where(r =>
                (r.Sources.FirstOrDefault()?.ConnectedSystemAttribute?.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (r.TargetMetaverseAttribute?.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        return Task.FromResult(rules.OrderBy(r => r.Order).ToWindow(request));
    }

    /// <summary>
    /// Refreshes the grid belonging to an Object Type after its rules have been added to, removed from or
    /// reordered. The totals are invalidated because the change may have altered how many rules there are.
    /// </summary>
    /// <summary>
    /// Previews the matching configuration as it would stand with the rule currently in the add form appended to
    /// this Object Type's rules.
    /// </summary>
    /// <remarks>
    /// The proposed rule is built unsaved, exactly as the form holds it, and takes the next Order because that is
    /// where adding it would put it. Order is not decoration: rules are evaluated in ascending order until one
    /// matches, so a rule appended last decides only the objects the rules above it do not already claim, and
    /// previewing it anywhere else would answer a question nobody asked.
    /// </remarks>
    private async Task PreviewProposedRuleAsync(ConnectedSystemObjectType objectType)
    {
        if (!CanAddMatchingRule)
            return;

        var existing = objectType.ObjectMatchingRules;
        var proposedRule = new ObjectMatchingRuleProposal(
            existing.Count == 0 ? 0 : existing.Max(rule => rule.Order) + 1,
            objectType.Id,
            null,
            _newMatchingRuleMetaverseObjectType!.Id,
            _newMatchingRuleTargetAttribute!.Id,
            _newMatchingRuleCaseSensitive,
            [new ObjectMatchingRuleSourceProposal(0, _newMatchingRuleSourceAttribute!.Id)]);

        var stored = await BuildStoredProposalAsync();
        await StartPreviewAsync(stored with { Rules = [.. stored.Rules, proposedRule] });
    }

    /// <summary>
    /// Previews the Simple to Advanced switch, or back: the same rules, evaluated from the other side.
    /// </summary>
    private async Task PreviewModeSwitchAsync()
    {
        var stored = await BuildStoredProposalAsync();
        await StartPreviewAsync(stored with
        {
            Mode = _switchingToAdvancedMode ? ObjectMatchingRuleMode.SyncRule : ObjectMatchingRuleMode.ConnectedSystem
        });
    }

    /// <summary>
    /// The matching configuration as it currently stands, read fresh so a proposal is never built against a page
    /// that has drifted from the database.
    /// </summary>
    private async Task<ObjectMatchingProposal> BuildStoredProposalAsync()
    {
        using var jim = JimFactory.Create();
        var objectTypes = await jim.ConnectedSystems.GetObjectTypesAsync(ConnectedSystem.Id);
        var syncRules = await jim.ConnectedSystems.GetSyncRulesAsync(ConnectedSystem.Id, false);
        return ObjectMatchingProposal.FromCurrentConfiguration(ConnectedSystem, objectTypes, syncRules);
    }

    private async Task StartPreviewAsync(ObjectMatchingProposal proposal)
    {
        if (_startingPreview)
            return;

        _startingPreview = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

            var activityId = await PreviewStarter.StartAsync(new ConfigurationChangePreviewRequest
            {
                Surface = ConfigurationChangePreviewSurface.ObjectMatching,
                TargetId = ConnectedSystem.Id,
                TargetName = ConnectedSystem.Name,
                ProposedConfiguration = proposal,
                InitiatedByType = ActivityInitiatorType.User,
                InitiatedById = user?.Id,
                InitiatedByName = user?.Name
            });

            // Null means the administrator declined the data-set size question, which is a decision not to preview.
            if (activityId == null)
                return;

            _previewActivityId = activityId;
        }
        catch (Exception ex) when (ex is System.Data.Common.DbException or InvalidOperationException)
        {
            _previewActivityId = null;
            Snackbar.Add($"Failed to start the preview: {ex.Message}", Severity.Error);
        }
        finally
        {
            _startingPreview = false;
        }
    }

    private async Task RefreshMatchingRuleGridAsync(ConnectedSystemObjectType objectType)
    {
        if (_matchingRuleGrids.TryGetValue(objectType.Id, out var grid))
            await grid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Whether the form describes a rule that could actually match. The Metaverse Object Type is as required as the
    /// two attributes: a rule missing it is stored happily and never matches (#1458).
    /// </summary>
    private bool CanAddMatchingRule =>
        _newMatchingRuleSourceAttribute != null
        && _newMatchingRuleTargetAttribute != null
        && _newMatchingRuleMetaverseObjectType != null;

    private async Task HandleAddMatchingRuleAsync(ConnectedSystemObjectType objectType)
    {
        if (!CanAddMatchingRule)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        // Calculate the next order value
        var nextOrder = objectType.ObjectMatchingRules.Count > 0
            ? objectType.ObjectMatchingRules.Max(r => r.Order) + 1
            : 0;

        var rule = new ObjectMatchingRule
        {
            Order = nextOrder,
            ConnectedSystemObjectTypeId = objectType.Id,
            ConnectedSystemObjectType = objectType,
            MetaverseObjectTypeId = _newMatchingRuleMetaverseObjectType!.Id,
            MetaverseObjectType = _newMatchingRuleMetaverseObjectType,
            TargetMetaverseAttributeId = _newMatchingRuleTargetAttribute!.Id,
            TargetMetaverseAttribute = _newMatchingRuleTargetAttribute,
            CaseSensitive = _newMatchingRuleCaseSensitive,
            Sources = new List<ObjectMatchingRuleSource>
            {
                new()
                {
                    Order = 0,
                    ConnectedSystemAttributeId = _newMatchingRuleSourceAttribute!.Id,
                    ConnectedSystemAttribute = _newMatchingRuleSourceAttribute
                }
            }
        };

        try
        {
            await jim.ConnectedSystems.CreateObjectMatchingRuleAsync(rule, user);

            // Add to the local list for immediate UI update
            objectType.ObjectMatchingRules.Add(rule);

            // Reset the form
            _newMatchingRuleSourceAttribute = null;
            _newMatchingRuleTargetAttribute = null;
            _newMatchingRuleMetaverseObjectType = null;
            _newMatchingRuleCaseSensitive = false;

            Snackbar.Add("Matching rule has been created.", Severity.Success);
            await RefreshMatchingRuleGridAsync(objectType);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to create matching rule for object type {ObjectTypeId}", objectType.Id);
            Snackbar.Add("Failed to create matching rule. Please try again or check the server logs for details.", Severity.Error);
        }
    }

    private async Task HandleDeleteMatchingRuleAsync(ObjectMatchingRule rule, ConnectedSystemObjectType objectType)
    {
        var confirmationResult = await DialogService.ShowMessageBoxAsync(
            "Delete Matching Rule",
            $"Are you sure you want to delete this matching rule? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmationResult != true)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        try
        {
            await jim.ConnectedSystems.DeleteObjectMatchingRuleAsync(rule, user);

            // Remove from the local list for immediate UI update
            objectType.ObjectMatchingRules.Remove(rule);

            Snackbar.Add("Matching rule has been deleted.", Severity.Success);
            await RefreshMatchingRuleGridAsync(objectType);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to delete matching rule {RuleId}", rule.Id);
            Snackbar.Add("Failed to delete matching rule. Please try again or check the server logs for details.", Severity.Error);
        }
    }

    private async Task HandleToggleMatchingRuleCaseSensitiveAsync(ObjectMatchingRule rule, bool caseSensitive)
    {
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        try
        {
            rule.CaseSensitive = caseSensitive;
            await jim.ConnectedSystems.UpdateObjectMatchingRuleAsync(rule, user);

            Snackbar.Add($"Matching rule is now {(caseSensitive ? "case-sensitive" : "case-insensitive")}.", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Revert the change on failure
            rule.CaseSensitive = !caseSensitive;
            Log.Error(ex, "Failed to update matching rule {RuleId}", rule.Id);
            Snackbar.Add("Failed to update matching rule. Please try again or check the server logs for details.", Severity.Error);
        }
    }

    private async Task HandleMoveMatchingRuleUpAsync(ObjectMatchingRule rule, ConnectedSystemObjectType objectType)
    {
        await SwapMatchingRuleOrderAsync(rule, -1, objectType);
    }

    private async Task HandleMoveMatchingRuleDownAsync(ObjectMatchingRule rule, ConnectedSystemObjectType objectType)
    {
        await SwapMatchingRuleOrderAsync(rule, 1, objectType);
    }

    private async Task SwapMatchingRuleOrderAsync(ObjectMatchingRule rule, int direction, ConnectedSystemObjectType objectType)
    {
        var rules = objectType.ObjectMatchingRules.OrderBy(r => r.Order).ToList();
        var currentIndex = rules.IndexOf(rule);
        var targetIndex = currentIndex + direction;

        if (targetIndex < 0 || targetIndex >= rules.Count)
            return;

        var targetRule = rules[targetIndex];

        // Swap the order values
        var tempOrder = rule.Order;
        rule.Order = targetRule.Order;
        targetRule.Order = tempOrder;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        try
        {
            // Update both rules
            await jim.ConnectedSystems.UpdateObjectMatchingRuleAsync(rule, user);
            await jim.ConnectedSystems.UpdateObjectMatchingRuleAsync(targetRule, user);

            // The rules are windowed in Order sequence, so a swap changes which rows the grid holds; without a
            // reload the two rules would keep their old positions on screen while the database has them swapped.
            await RefreshMatchingRuleGridAsync(objectType);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to reorder matching rules");
            Snackbar.Add("Failed to reorder matching rules. Please try again or check the server logs for details.", Severity.Error);
        }
    }

    private Task HandleObjectMatchingModeToggleAsync(bool advancedMode)
    {
        _switchingToAdvancedMode = advancedMode;
        _modeSwitchDialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task HandleModeSwitchConfirmedAsync()
    {
        _modeSwitchInProgress = true;
        StateHasChanged();

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var newMode = _switchingToAdvancedMode ? ObjectMatchingRuleMode.SyncRule : ObjectMatchingRuleMode.ConnectedSystem;

            var result = await jim.ConnectedSystems.SwitchObjectMatchingModeAsync(ConnectedSystem, newMode, user);

            if (!result.Success)
            {
                Snackbar.Add($"Failed to switch mode: {result.ErrorMessage}", Severity.Error);
                return;
            }

            if (_switchingToAdvancedMode)
            {
                Snackbar.Add($"Switched to Advanced Mode. Matching rules copied to {result.SyncRulesUpdated} Synchronisation Rule(s).", Severity.Success);
            }
            else
            {
                // Show success message
                var message = $"Switched to Simple Mode. Matching rules set on {result.ObjectTypesUpdated} object type(s).";
                Snackbar.Add(message, Severity.Success);

                // Show any warnings about diverging rules
                foreach (var warning in result.Warnings)
                {
                    Snackbar.Add(warning, Severity.Warning);
                }
            }

            _modeSwitchDialogVisible = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to switch object matching mode");
            Snackbar.Add("Failed to switch mode. Please try again or check the server logs for details.", Severity.Error);
        }
        finally
        {
            _modeSwitchInProgress = false;
            StateHasChanged();
        }
    }

    #region Object Matching Rules Render Fragment
    private RenderFragment RenderMatchingRulesForObjectType(ConnectedSystemObjectType objectType) => __builder =>
    {
        // Track the current object type for form operations
        _currentMatchingRuleObjectType = objectType;

        <MudPaper Outlined="true" Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Add Matching Rule</MudText>

            <MudGrid>
                <MudItem xs="12" md="5">
                    <MudSelect T="ConnectedSystemObjectTypeAttribute"
                               @bind-Value="_newMatchingRuleSourceAttribute"
                               Label="Connected System Attribute"
                               Variant="Variant.Outlined"
                               HelperText="The Connected System attribute to match from">
                        @foreach (var attr in objectType.Attributes.Where(a => a.Selected).OrderBy(a => a.Name))
                        {
                            <MudSelectItem Value="@attr">@attr.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2" Class="d-flex align-center justify-center">
                    <MudText Typo="Typo.h6">=</MudText>
                </MudItem>
                <MudItem xs="12" md="5">
                    <MudSelect T="MetaverseAttribute"
                               @bind-Value="_newMatchingRuleTargetAttribute"
                               Label="Metaverse Attribute"
                               Variant="Variant.Outlined"
                               ToStringFunc="@(a => a?.Name ?? string.Empty)"
                               HelperText="The Metaverse attribute to match against">
                        @if (MetaverseAttributes != null)
                        {
                            @foreach (var attr in MetaverseAttributes.OrderBy(a => a.Name))
                            {
                                <MudSelectItem Value="@attr">@attr.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    @* Where the rule looks. A Simple mode rule has no Synchronisation Rule to take this from, so
                       one that names no type searches nothing and silently matches nothing (#1458). *@
                    <MudSelect T="MetaverseObjectType"
                               @bind-Value="_newMatchingRuleMetaverseObjectType"
                               Label="Metaverse Object Type"
                               Variant="Variant.Outlined"
                               ToStringFunc="@(t => t?.Name ?? string.Empty)"
                               HelperText="The type of Metaverse Object this rule searches">
                        @if (MetaverseObjectTypes != null)
                        {
                            @foreach (var objectTypeOption in MetaverseObjectTypes.OrderBy(t => t.Name))
                            {
                                <MudSelectItem Value="@objectTypeOption">@objectTypeOption.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>

            <MudCheckBox T="bool" @bind-Value="_newMatchingRuleCaseSensitive"
                         Label="Case sensitive"
                         Color="Color.Primary"
                         Class="mt-3" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">
                When enabled (default), attribute values must match exactly including case. When disabled, "John" matches "JOHN".
            </MudText>

            <div class="mt-3">
                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               DropShadow="false"
                               Disabled="@(!CanAddMatchingRule)"
                               OnClick="() => HandleAddMatchingRuleAsync(objectType)">
                        Add Matching Rule
                    </MudButton>
                    @* Adding a rule takes effect on the next synchronisation, and what it does is invisible until
                       then: an account that joined nothing may now join an identity, or a different one from the
                       one it would have. The preview answers before the rule is saved. *@
                    <MudButton StartIcon="@Icons.Material.Filled.Preview"
                               DropShadow="false"
                               Disabled="@(!CanAddMatchingRule || _startingPreview)"
                               OnClick="() => PreviewProposedRuleAsync(objectType)"
                               data-testid="jim-preview-matching-rule">
                        Preview Impact
                    </MudButton>
                </MudStack>
            </div>
        </MudPaper>

        <MudText Typo="Typo.h6">Matching Rules for <span class="jim-title-accent">@objectType.Name</span></MudText>

        @* Rules already stored in an unworkable shape are named rather than quietly ignored. They were storable
           before the create path validated them (#1458), and the matching engine skips them without saying so, so
           an administrator looking at a full grid has no way to tell the working rules from the dead ones. *@
        var unworkableRules = objectType.ObjectMatchingRules
            .Select(rule => new { Rule = rule, Reason = rule.DescribeInvalidity() })
            .Where(candidate => candidate.Reason != null)
            .ToList();

        if (unworkableRules.Count > 0)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-2 mb-2"
                      data-testid="jim-matching-rules-unworkable">
                <strong>@unworkableRules.Count matching @(unworkableRules.Count == 1 ? "rule" : "rules") cannot match anything.</strong>
                Objects that should join an existing Metaverse Object will project a new one instead. Remove and
                recreate @(unworkableRules.Count == 1 ? "it" : "them"):
                <ul class="mt-2 mb-0">
                    @foreach (var unworkable in unworkableRules)
                    {
                        <li>Rule @(unworkable.Rule.Order + 1): @unworkable.Reason</li>
                    }
                </ul>
            </MudAlert>
        }

        @* Object Matching Rules are an ordered, short list held on the Object Type the page already loaded, so the
           grid's windows are sliced from it in memory. The columns carry no sort headers, deliberately: the order
           IS the configuration (it decides which rule is tried first, and the move up / move down buttons act on
           it), so a reader must never be looking at these rows in any other sequence. Each Object Type's grid gets
           its own container id and URL prefix, because a Connected System with several selected Object Types
           renders one of these per tab. *@
        <VirtualisedDataGrid @ref="_matchingRuleGrids[objectType.Id]" T="ObjectMatchingRule"
                             ContainerId="@($"object-matching-rules-{objectType.Id}")"
                             UrlParameterPrefix="@($"omr{objectType.Id}-")"
                             StateKey="@objectType.Id.ToString()"
                             DefaultSortBy="order"
                             LoadWindow="@((request, token) => LoadMatchingRuleWindowAsync(objectType, request, token))"
                             SingularName="Object Matching Rule"
                             PluralName="Object Matching Rules"
                             SearchPlaceholder="Search by attribute name">
            <Columns>
                <TemplateColumn Title="Connected System Attribute" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Connected System Attribute</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.Sources.FirstOrDefault()?.ConnectedSystemAttribute is { } sourceAttribute)
                        {
                            @sourceAttribute.Name
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Operator" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Operator</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        =
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Metaverse Attribute" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Metaverse Attribute</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.TargetMetaverseAttribute is { } targetAttribute)
                        {
                            @targetAttribute.Name
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Case Sensitive" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Case Sensitive</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudSwitch T="bool" Value="@context.Item.CaseSensitive"
                                   ValueChanged="@(value => HandleToggleMatchingRuleCaseSensitiveAsync(context.Item, value))"
                                   Color="Color.Primary" />
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Actions" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">Actions</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudTooltip Text="Move up" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           Disabled="@(context.Item.Order == 0)"
                                           OnClick="() => HandleMoveMatchingRuleUpAsync(context.Item, objectType)" />
                        </MudTooltip>
                        <MudTooltip Text="Move down" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                           Variant="Variant.Filled"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           Disabled="@(context.Item.Order == objectType.ObjectMatchingRules.Max(r => r.Order))"
                                           OnClick="() => HandleMoveMatchingRuleDownAsync(context.Item, objectType)" />
                        </MudTooltip>
                        <MudTooltip Text="Delete" Arrow="true" Placement="Placement.Top">
                            <MudIconButton
                                Icon="@Icons.Material.Filled.Delete"
                                Variant="Variant.Filled"
                                Size="Size.Small"
                                Color="Color.Error"
                                OnClick="() => HandleDeleteMatchingRuleAsync(context.Item, objectType)" />
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@($"No Object Matching Rules match \"{grid.SearchText}\"")"
                                     SecondaryText="Try a different search term, or clear the search."
                                     ActionText="Clear Search"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.Rule"
                                     PrimaryText="No Object Matching Rules configured"
                                     SecondaryText="Objects of this type will only match if they are manually joined. Use the Add Matching Rule panel above to define one." />
                }
            </EmptyContent>
        </VirtualisedDataGrid>
    };
    #endregion
}
