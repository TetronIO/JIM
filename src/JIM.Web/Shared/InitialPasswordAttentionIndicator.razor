@* Two chips, never one total. They ask for different things: parked work is fixed by correcting the Synchronisation
   Rule's password settings and saving, and expired work cannot be fixed there at all. Summing them would give a
   number with nothing to do about it. Renders nothing at all when there is nothing outstanding, matching
   ConfigurationDriftIndicator: silence is the reward for needing no action. *@
@if (Attention is { ParkedCount: > 0 })
{
    <MudTooltip Arrow="true" Placement="Placement.Top">
        <TooltipContent><TooltipText Text="@ParkedTooltip" /></TooltipContent>
        <ChildContent>
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Text"
                     Icon="@Icons.Material.Filled.PauseCircleOutline" Class="jim-stat-chip">
                @ParkedCount.ToString("N0")
            </MudChip>
        </ChildContent>
    </MudTooltip>
}
@if (Attention is { ExpiredCount: > 0 })
{
    <MudTooltip Arrow="true" Placement="Placement.Top">
        <TooltipContent><TooltipText Text="@ExpiredTooltip" /></TooltipContent>
        <ChildContent>
            <MudChip T="string" Color="Color.Error" Variant="Variant.Text"
                     Icon="@Icons.Material.Filled.HourglassDisabled" Class="jim-stat-chip">
                @ExpiredCount.ToString("N0")
            </MudChip>
        </ChildContent>
    </MudTooltip>
}

@code {
    /// <summary>
    /// The counts to render. Null (not yet loaded, or nothing outstanding) renders nothing, so a list does not
    /// flash an indicator before the answer is known.
    /// </summary>
    [Parameter]
    public InitialPasswordAttention? Attention { get; set; }

    /// <summary>
    /// What the counts belong to, woven into the tooltips where it reads better than "this one". A Synchronisation
    /// Rule's name, or a Connected System's.
    /// </summary>
    [Parameter]
    public string? SubjectName { get; set; }

    /// <summary>
    /// True when the counts belong to a Connected System rather than a Synchronisation Rule, which changes where
    /// the tooltip sends the administrator: the settings that caused the rejection live on the rule.
    /// </summary>
    [Parameter]
    public bool IsConnectedSystem { get; set; }

    // Captured into locals rather than dereferenced in markup: CodeQL does not follow the property-pattern guard
    // above into the expression, and the finding blocks the merge (see JIM.Web/CLAUDE.md).
    private int ParkedCount => Attention?.ParkedCount ?? 0;

    private int ExpiredCount => Attention?.ExpiredCount ?? 0;

    private string Subject => string.IsNullOrWhiteSpace(SubjectName)
        ? (IsConnectedSystem ? "this Connected System" : "this Synchronisation Rule")
        : SubjectName;

    private string ParkedTooltip
    {
        get
        {
            var accounts = ParkedCount == 1 ? "1 account is" : $"{ParkedCount:N0} accounts are";
            var where = IsConnectedSystem
                ? $"waiting on a change to the initial password settings of the Synchronisation Rules that provisioned them into {Subject}."
                : $"waiting on a change to {Subject}'s initial password settings.";

            return $"{accounts} {where} The target refused the password these settings produced, so JIM has stopped " +
                   "trying. Correcting the settings and saving releases them, and they are attempted again on the " +
                   "next export run.";
        }
    }

    private string ExpiredTooltip
    {
        get
        {
            var accounts = ExpiredCount == 1 ? "1 account was" : $"{ExpiredCount:N0} accounts were";
            var subject = IsConnectedSystem ? $" in {Subject}" : $" by {Subject}";

            return $"{accounts} provisioned{subject} and never given an initial password within its time to live. " +
                   "JIM has stopped trying; they need a password set by other means.";
        }
    }
}
