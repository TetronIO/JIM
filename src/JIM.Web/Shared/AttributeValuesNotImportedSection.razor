@* The values an import found on an object but could not read as their attributes' types (#2066): each value as
   received, what its attribute expected, and why it was refused, with where to put it right. On a Run Profile Execution
   Item's page in place of the bare error, whose message names the values but cannot lay them out. Always the item's
   error, so always red. *@

<MudPaper Outlined="true" Class="@PaperClass" data-testid="jim-attribute-values-not-imported">
    <div class="jim-attribute-values-not-imported-head">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" />
            <MudText Typo="Typo.h6">@MetaverseText.AvniTitle</MudText>
            <MudChip T="string" Variant="Variant.Text" Color="Color.Error" Class="ma-0">@Errors.Total.ToString("N0")</MudChip>
        </MudStack>
    </div>

    <div class="pa-4">
        <MudText Typo="Typo.body1" Class="mb-2">
            @string.Format(CultureInfo.CurrentCulture, MetaverseText.AvniCouldNotImport,
                PluralRules.Choose(Errors.Total, MetaverseText.AvniThisValue, MetaverseText.AvniTheseValues),
                PluralRules.Choose(AttributeCount, MetaverseText.AvniTheAttribute, MetaverseText.AvniEachAttribute))
            @MetaverseText.AvniFoundByIntro
        </MudText>

        <VirtualisedDataGrid T="ImportedAttributeValueError"
                             ContainerId="jim-attribute-values-not-imported-grid"
                             UrlParameterPrefix="av"
                             DefaultSortBy="reported"
                             LoadWindow="LoadWindowAsync"
                             ExpectedItemCount="@Errors.Values.Count"
                             MaxHeight="480px"
                             GridClass="mt-3"
                             SingularName="@MetaverseText.AvniValue"
                             PluralName="@MetaverseText.AvniValues"
                             SearchPlaceholder="@MetaverseText.AvniSearchPlaceholder">
            <Columns>
                <TemplateColumn T="ImportedAttributeValueError" Title="@MetaverseText.AvniAttribute" Sortable="false" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">@MetaverseText.AvniAttribute</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.AttributeName
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ImportedAttributeValueError" Title="@MetaverseText.AvniValueReceived" Sortable="false" HeaderClass="jim-nowrap" CellClass="jim-column-cap">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">@MetaverseText.AvniValueReceived</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.Value is { } value)
                        {
                            <span class="jim-one-line jim-text-code jim-attribute-value-unreadable" title="@value">@value</span>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ImportedAttributeValueError" Title="@MetaverseText.AvniExpected" Sortable="false" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">@MetaverseText.AvniExpected</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (AttributeValueErrorDisplay.Expected(context.Item.AttributeType) is { } expected)
                        {
                            @expected
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ImportedAttributeValueError" Title="@MetaverseText.AvniFoundBy" Sortable="false" HeaderClass="jim-nowrap" CellClass="jim-nowrap">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">@MetaverseText.AvniFoundBy</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @AttributeValueErrorDisplay.FoundBy(context.Item.Source)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn T="ImportedAttributeValueError" Title="@MetaverseText.AvniWhyNotImported" Sortable="false" HeaderClass="jim-fill-column" CellClass="jim-fill-column">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">@MetaverseText.AvniWhyNotImported</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        <OneLineText Text="@context.Item.Reason" />
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                 PrimaryText="@string.Format(CultureInfo.CurrentCulture, MetaverseText.AvniNoValuesMatch, grid.SearchText)"
                                 SecondaryText="@CommonText.TrySearchAgain"
                                 ActionText="@CommonText.ClearSearch"
                                 OnAction="@(() => grid.ClearSearchAsync())" />
            </EmptyContent>
        </VirtualisedDataGrid>

        @if (Errors.Total > Errors.Values.Count)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2" data-testid="jim-attribute-values-kept-note">
                @string.Format(CultureInfo.CurrentCulture, MetaverseText.AvniKeptNote, Errors.Values.Count.ToString("N0"), Errors.Total.ToString("N0"))
            </MudText>
        }

        <div class="jim-attribute-values-next-step mt-4">
            <MudIcon Icon="@Icons.Material.Outlined.Lightbulb" Class="mud-text-secondary" />
            <MudText Typo="Typo.body1">
                @((MarkupString)string.Format(CultureInfo.CurrentCulture, MetaverseText.AvniNextStep,
                    PluralRules.Choose(Errors.Total, MetaverseText.AvniTheValue, MetaverseText.AvniTheValues),
                    NextStepSourceHtml,
                    PluralRules.Choose(Errors.Total, MetaverseText.AvniTheValueIs, MetaverseText.AvniTheValuesAre)))
                @if (SchemaHref is { } schemaHref)
                {
                    <MudLink Href="@schemaHref" Class="ml-1" data-testid="jim-attribute-values-schema-link">@MetaverseText.AvniOpenSchema<span aria-hidden="true">&nbsp;&rarr;</span></MudLink>
                }
            </MudText>
        </div>
    </div>
</MudPaper>

@code {
    /// <summary>What the item recorded of the values the import could not import.</summary>
    [Parameter, EditorRequired]
    public ImportedAttributeValueErrors Errors { get; set; } = null!;

    /// <summary>Where in the Connected System the object was read from, where the Connector said.</summary>
    [Parameter]
    public string? SourceLocation { get; set; }

    /// <summary>The Connected System whose Schema tab the next step links to; null leaves the link out.</summary>
    [Parameter]
    public int? ConnectedSystemId { get; set; }

    /// <summary>The object's Object Type, which the Schema tab opens on; null opens it without choosing one.</summary>
    [Parameter]
    public string? ObjectTypeName { get; set; }

    /// <summary>The call site's spacing classes.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// The place the value was read from, in the next-step sentence: the Connected System's name when no location is
    /// known, otherwise the location in its own styled span. The location is HTML-encoded before it is inserted.
    /// </summary>
    private string NextStepSourceHtml => string.IsNullOrEmpty(SourceLocation)
        ? MetaverseText.AvniTheConnectedSystem
        : $"<span class=\"jim-text-code\" data-testid=\"jim-attribute-values-source\">{System.Net.WebUtility.HtmlEncode(SourceLocation)}</span>";

    private int AttributeCount => Errors.Values.Select(v => v.AttributeName).Distinct(StringComparer.OrdinalIgnoreCase).Count();

    private string? SchemaHref => ConnectedSystemId is { } connectedSystemId
        ? AttributeValueErrorDisplay.SchemaHref(connectedSystemId, ObjectTypeName)
        : null;

    private string PaperClass => string.IsNullOrEmpty(Class)
        ? "jim-attribute-values-not-imported"
        : $"jim-attribute-values-not-imported {Class}";

    private Task<VirtualisedWindow<ImportedAttributeValueError>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken cancellationToken) =>
        Task.FromResult(AttributeValueErrorDisplay.Matching(Errors.Values, request.SearchText).ToWindow(request));
}
