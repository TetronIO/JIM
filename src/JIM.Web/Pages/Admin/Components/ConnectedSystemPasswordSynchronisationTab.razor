@* Configuration first (what a returning administrator comes to change), then the channel check and the policy
   the system enforces, which are read-only and rendered by the panel below. The tab's own description is in the
   info button, per the portal's page-description rule. *@
<MudPaper Outlined="true" Class="pa-4">
    <div class="d-flex align-center">
        <MudText Typo="Typo.h6">@ConnectedSystemText.PwSyncHeading</MudText>
        <InfoPopover Title="@ConnectedSystemText.PwSyncHeading">
            @ConnectedSystemText.PwSyncInfo
        </InfoPopover>
    </div>

@if (_editor == null)
{
    <MudSkeleton Class="mt-3" Height="200px" />
}
else
{
    <MudSwitch T="bool" @bind-Value="_editor.Enabled" Color="Color.Primary" Class="mt-3"
               Label="@ConnectedSystemText.PwSyncDeliverSwitch" />

    <MudText Typo="Typo.body2" Class="mud-text-secondary ml-12" Style="margin-top: -8px;">
        @if (_editor.Enabled)
        {
            <text>
                @ConnectedSystemText.PwSyncEnabledNote
            </text>
        }
        else
        {
            <text>
                @ConnectedSystemText.PwSyncDisabledNote
            </text>
        }
    </MudText>

    @* Bound through a nullable so an unmade choice (stored as 0) shows as an empty field rather than as "0". *@
    <div data-testid="jim-password-sync-object-type">
        <MudSelect T="int?" @bind-Value="TargetObjectTypeId" Class="mt-6"
                   Label="@ConnectedSystemText.PwSyncObjectTypeLabel" Variant="Variant.Outlined" Required="true"
                   HelperText="@ConnectedSystemText.PwSyncObjectTypeHelp">
            @foreach (var objectType in SelectableObjectTypes())
            {
                <MudSelectItem T="int?" Value="@objectType.Id">@objectType.Name</MudSelectItem>
            }
        </MudSelect>
    </div>

    <MudText Typo="Typo.h6" Class="mt-8">@ConnectedSystemText.PwSyncDelivery</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary">
        @ConnectedSystemText.PwSyncDeliveryIntro
    </MudText>

    @* Class, not Style, sizes these: MudNumericField's Style lands on the inner input, and the .mud-input-control
       wrapper (flex: 1 1 auto) then grows to share the row, putting the two fields half a screen apart. *@
    <div class="d-flex gap-4 mt-4 flex-wrap">
        <MudNumericField T="int" @bind-Value="_editor.MaxRetries" Label="@ConnectedSystemText.PwSyncMaxAttempts"
                         Variant="Variant.Outlined" Min="0" Max="100" Class="jim-delivery-number"
                         HelperText="@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwSyncMaxAttemptsDefault, ConnectedSystemPasswordSynchronisation.DefaultMaxRetries)" />

        <MudNumericField T="int" @bind-Value="BackoffMinutes" Label="@ConnectedSystemText.PwSyncBackoffLabel"
                         Variant="Variant.Outlined" Min="0" Max="1440" Class="jim-delivery-number"
                         HelperText="@ConnectedSystemText.PwSyncBackoffHelp" />
    </div>

    @* Both of these are Connected System settings rather than Password Synchronisation ones, because they govern
       every password JIM sends here. Reported rather than edited, so there is one place each is set. *@
    <MudAlert Severity="Severity.Info" Class="mt-6">
        <MudText Typo="Typo.body2">
            @ConnectedSystemText.PwSyncWaitsBefore <strong>@FormatTimeToLive()</strong> @ConnectedSystemText.PwSyncWaitsAfter
        </MudText>
        <MudText Typo="Typo.body2" Class="mt-2">
            @if (ConnectedSystem.RequireSecureTransport)
            {
                <text>
                    @ConnectedSystemText.PwSyncSecureBefore <strong>@ConnectedSystemText.PwSyncSecureStrong</strong> @ConnectedSystemText.PwSyncSecureAfter
                </text>
            }
            else
            {
                <text>
                    @ConnectedSystemText.PwSyncPlainBefore <strong>@ConnectedSystemText.PwSyncPlainStrong</strong>@ConnectedSystemText.PwSyncPlainAfter
                </text>
            }
        </MudText>
        <MudText Typo="Typo.body2" Class="mt-2">
            @ConnectedSystemText.PwSyncChangeBefore <strong>@ConnectedSystemText.DetailTabSettings</strong> @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwSyncChangeAfter, ConnectedSystemText.SettingsTabPasswords)
        </MudText>
    </MudAlert>

    @if (_problems.Count > 0)
    {
        <MudAlert Severity="Severity.Error" Class="mt-6">
            <MudText Typo="Typo.body2"><strong>@ConnectedSystemText.PwSyncProblemsHeading</strong></MudText>
            <ul class="mt-1 mb-0">
                @foreach (var problem in _problems)
                {
                    <li><MudText Typo="Typo.body2">@problem</MudText></li>
                }
            </ul>
        </MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6"
               Disabled="@(_saving || !HasChanges())" OnClick="SaveAsync">
        @(_saving ? ConnectedSystemText.PwSyncSaving : CommonText.Save)
    </MudButton>
}
</MudPaper>

<ConnectedSystemPasswordPolicyPanel ConnectedSystem="ConnectedSystem" />

@code {
    [Parameter]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [Parameter]
    public EventCallback OnConnectedSystemChanged { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// The configuration being edited. A Connected System with none yet gets a fresh one here rather than on
    /// save, so the form has something to bind to and an administrator sees the defaults they are agreeing to.
    /// </summary>
    private ConnectedSystemPasswordSynchronisation? _editor;

    /// <summary>
    /// What was saved, for telling an edit from an untouched form. The editor mutates its instance in place, so
    /// without a copy taken up front there is nothing left to compare against.
    /// </summary>
    private ConnectedSystemPasswordSynchronisation? _asSaved;

    /// <summary>
    /// The Connected System instance this tab last bound to, so a page reload that hands over a freshly loaded
    /// instance rebinds rather than leaving the editor pointed at a stale one.
    /// </summary>
    private ConnectedSystem? _boundTo;

    private IReadOnlyList<string> _problems = [];
    private bool _saving;

    /// <summary>
    /// The stored id, with 0 (no choice made) presented as null so the select shows an empty field rather than
    /// the number. Writing null stores 0, which is what validation reads as "no Object Type chosen".
    /// </summary>
    private int? TargetObjectTypeId
    {
        get => _editor == null || _editor.TargetObjectTypeId == 0 ? null : _editor.TargetObjectTypeId;
        set
        {
            if (_editor != null)
                _editor.TargetObjectTypeId = value ?? 0;
        }
    }

    /// <summary>
    /// The backoff base in whole minutes. Bound rather than exposing a TimeSpan field, because a duration typed
    /// as text is a worse experience than a number with its unit in the label, and minutes is the granularity
    /// this setting is actually chosen in.
    /// </summary>
    private int BackoffMinutes
    {
        get => _editor == null ? 0 : (int)Math.Round(_editor.RetryBackoffBase.TotalMinutes);
        set
        {
            if (_editor != null)
                _editor.RetryBackoffBase = TimeSpan.FromMinutes(Math.Max(value, 0));
        }
    }

    protected override void OnParametersSet()
    {
        // Rebound whenever the page reloads the Connected System, so a save elsewhere on the page does not
        // leave this tab editing a stale instance.
        if (_editor != null && ReferenceEquals(_boundTo, ConnectedSystem))
            return;

        var stored = ConnectedSystem.PasswordSynchronisation;

        _editor = stored ?? new ConnectedSystemPasswordSynchronisation
        {
            ConnectedSystemId = ConnectedSystem.Id,
            TargetObjectTypeId = DefaultObjectTypeId()
        };

        _asSaved = _editor.SnapshotDeliverySettings();
        _boundTo = ConnectedSystem;
        _problems = [];
    }

    /// <summary>
    /// Only Object Types selected for synchronisation: an unselected type holds no Connected System Objects, so
    /// choosing it would queue passwords for accounts that never appear.
    /// </summary>
    private IEnumerable<ConnectedSystemObjectType> SelectableObjectTypes() =>
        (ConnectedSystem.ObjectTypes ?? []).Where(ot => ot.Selected).OrderBy(ot => ot.Name);

    /// <summary>
    /// Pre-selects the sole selected Object Type where there is only one, so the common case needs no choice.
    /// </summary>
    private int DefaultObjectTypeId()
    {
        var selected = SelectableObjectTypes().ToList();
        return selected.Count == 1 ? selected[0].Id : 0;
    }

    private string FormatTimeToLive()
    {
        var timeToLive = ConnectedSystem.EffectiveInitialPasswordTimeToLive;
        if (timeToLive.TotalDays >= 1)
        {
            var isOneDay = Math.Abs(timeToLive.TotalDays - 1) < 0.05;
            return string.Format(System.Globalization.CultureInfo.CurrentCulture, PluralRules.Choose(isOneDay ? 1 : 2, ConnectedSystemText.PwPanelDayOne, ConnectedSystemText.PwPanelDayOther),
                timeToLive.TotalDays.ToString("0.#", System.Globalization.CultureInfo.CurrentCulture));
        }

        return string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelHours, timeToLive.TotalHours.ToString("0.#", System.Globalization.CultureInfo.CurrentCulture));
    }

    private bool HasChanges() =>
        !ConnectedSystemPasswordSynchronisation.WouldDeliverTheSameAs(_editor, _asSaved);

    private async Task SaveAsync()
    {
        if (_editor == null || _saving)
            return;

        _saving = true;

        // The same assessment the REST API and PowerShell are gated on, so all three surfaces accept and refuse
        // exactly the same settings.
        _problems = _editor.Validate(ConnectedSystem);
        if (_problems.Count > 0)
        {
            _saving = false;
            return;
        }

        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
        if (cancelled)
        {
            _saving = false;
            return;
        }

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        ConnectedSystem.PasswordSynchronisation = _editor;
        await jim.ConnectedSystems.UpdateConnectedSystemAsync(ConnectedSystem, user, changeReason);

        _asSaved = _editor.SnapshotDeliverySettings();

        Snackbar.Add(_editor.Enabled
            ? ConnectedSystemText.PwSyncOnSnackbar
            : ConnectedSystemText.PwSyncSavedSnackbar, Severity.Success);

        _saving = false;
        await OnConnectedSystemChanged.InvokeAsync();
    }
}
