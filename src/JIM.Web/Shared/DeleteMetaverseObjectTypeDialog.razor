@using System.Globalization
@using JIM.Models.Core
@using JIM.Models.Core.DTOs
@using JIM.Utilities
@using JIM.Web.Models
@using JIM.Web.Services
@inject IJimApplicationFactory JimFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

@* Thin surface over the shared ConsequenceConfirmationDialog: this component owns evaluating the *@
@* deletion impact and performing the delete; the shared dialog owns presenting it and the consent *@
@* rules. See engineering/plans/done/CONFIGURATION_CHANGE_PREVIEW.md (Phase 2). *@

<ConsequenceConfirmationDialog Loading="@(_impact == null)"
                               LoadingText="@AdminText.DeleteEvaluatingImpact"
                               Blockers="@BuildBlockers()"
                               SafeMessage="@AdminText.DeleteObjectTypeSafe"
                               Consequences="@BuildConsequences()"
                               ConfirmationPhrase="@BuildConfirmationPhrase()"
                               ConfirmButtonText="@BuildConfirmButtonText()"
                               BusyText="@AdminText.DeleteBusy"
                               OnConfirmAsync="DeleteAsync" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// The Object Type to delete.
    /// </summary>
    [Parameter]
    public MetaverseObjectType ObjectType { get; set; } = null!;

    private ObjectTypeDeletionImpact? _impact;

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _impact = await jim.Metaverse.EvaluateObjectTypeDeletionAsync(ObjectType);
    }

    private IReadOnlyList<ConsequenceBlocker> BuildBlockers()
    {
        if (_impact == null)
            return [];

        var blockers = new List<ConsequenceBlocker>();

        if (_impact.BuiltIn)
        {
            blockers.Add(new ConsequenceBlocker
            {
                Headline = AdminText.DeleteObjectTypeBuiltInHeadline,
                Body = AdminText.DeleteObjectTypeBuiltInBody
            });
        }

        if (_impact.BlockedByObjects)
        {
            blockers.Add(new ConsequenceBlocker
            {
                Headline = string.Format(CultureInfo.CurrentCulture, AdminText.DeleteObjectTypeObjectsHeadline, _impact.MetaverseObjectCount.ToString("N0", CultureInfo.CurrentCulture)),
                Body = AdminText.DeleteObjectTypeObjectsBody,
                LinkHref = Utilities.GetMetaverseObjectListHref(ObjectType.PluralName),
                LinkText = AdminText.DeleteViewObjects
            });
        }

        if (_impact.BlockedBySynchronisationRules)
        {
            blockers.Add(new ConsequenceBlocker
            {
                Headline = string.Format(CultureInfo.CurrentCulture, AdminText.DeleteObjectTypeRulesHeadline, _impact.SynchronisationRules.Count),
                Items = _impact.SynchronisationRules.Select(rule => new ConsequenceItem
                {
                    Text = rule.Description,
                    Icon = Icons.Material.Filled.SyncAlt
                }).ToList(),
                Body = AdminText.DeleteObjectTypeRulesBody
            });
        }

        return blockers;
    }

    private ConsequenceGroup? BuildConsequences()
    {
        if (_impact == null || _impact.CascadeReferences.Count == 0)
            return null;

        return new ConsequenceGroup
        {
            Headline = string.Format(CultureInfo.CurrentCulture, AdminText.DeleteReferencesHeadline, _impact.CascadeReferences.Count),
            Note = AdminText.DeleteObjectTypeReferencesNote,
            Items = _impact.CascadeReferences.Select(reference => new ConsequenceItem
            {
                Text = DescribeReference(reference),
                Icon = ReferenceIcon(reference.Kind)
            }).ToList()
        };
    }

    // Cascade references require the typed confirmation; a clean delete does not.
    private string? BuildConfirmationPhrase() =>
        _impact is { CascadeReferences.Count: > 0 } ? _impact.ObjectTypeName : null;

    private string BuildConfirmButtonText()
    {
        if (_impact == null)
            return CommonText.Delete;

        return _impact.CascadeReferences.Count > 0
            ? string.Format(CultureInfo.CurrentCulture, AdminText.DeleteWithReferences, _impact.CascadeReferences.Count)
            : CommonText.Delete;
    }

    private static string ReferenceIcon(ObjectTypeReferenceKind kind) => kind switch
    {
        ObjectTypeReferenceKind.PredefinedSearch => Icons.Material.Filled.Search,
        ObjectTypeReferenceKind.ExampleDataTemplate => Icons.Material.Filled.Dataset,
        ObjectTypeReferenceKind.AttributeBinding => Icons.Material.Filled.Link,
        _ => Icons.Material.Filled.SyncAlt
    };

    private static string DescribeReference(ObjectTypeReference reference) => reference.Kind switch
    {
        ObjectTypeReferenceKind.PredefinedSearch => string.Format(CultureInfo.CurrentCulture, AdminText.DeleteReferencePredefinedSearch, reference.Description),
        ObjectTypeReferenceKind.ExampleDataTemplate => string.Format(CultureInfo.CurrentCulture, AdminText.DeleteReferenceExampleData, reference.Description),
        ObjectTypeReferenceKind.AttributeBinding => string.Format(CultureInfo.CurrentCulture, AdminText.DeleteReferenceAttributeBinding, reference.Description),
        _ => reference.Description
    };

    private async Task<bool> DeleteAsync()
    {
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, CommonText.Delete);
        if (cancelled)
            return false;

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var impact = await jim.Metaverse.DeleteMetaverseObjectTypeAsync(ObjectType, user, changeReason);
            if (!impact.Deleted)
            {
                Snackbar.Add(AdminText.DeleteObjectTypeFailedRefresh, Severity.Warning);
                return false;
            }

            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.DeleteObjectTypeSuccess, impact.ObjectTypeName), Severity.Success);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.DeleteObjectTypeFailed, ex.Message), Severity.Error);
            return false;
        }

        return true;
    }

    /// <summary>
    /// Opens the delete dialog for a Metaverse Object Type. Returns true when the type was deleted.
    /// </summary>
    public static async Task<bool> ShowAsync(IDialogService dialogService, MetaverseObjectType objectType)
    {
        var parameters = new DialogParameters<DeleteMetaverseObjectTypeDialog>
        {
            { x => x.ObjectType, objectType }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await dialogService.ShowAsync<DeleteMetaverseObjectTypeDialog>(string.Format(CultureInfo.CurrentCulture, AdminText.DeleteObjectTypeTitle, objectType.Name), parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: true };
    }
}
