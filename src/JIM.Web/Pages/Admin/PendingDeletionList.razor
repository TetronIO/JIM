<PageTitle>Pending Deletions</PageTitle>
<MudText Typo="Typo.h3">Pending Deletions</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    Metaverse Objects in the deletion pipeline. Includes identities being deprovisioned from Connected Systems
    and those awaiting automatic deletion after their grace period expires.
</MudText>

@* Summary cards *@
<MudGrid Class="mt-5">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Total Pending</MudText>
            <MudText Typo="Typo.h4">@_totalCount.ToString("N0")</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true" Style="border-left: 3px solid var(--mud-palette-warning);">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Deprovisioning</MudText>
            <MudTooltip Text="MVOs still connected to other systems, awaiting cascade deletion" Arrow="true" Placement="Placement.Top">
                <MudText Typo="Typo.h4" Color="@(_deprovisioningCount > 0 ? Color.Warning : Color.Default)">@_deprovisioningCount.ToString("N0")</MudText>
            </MudTooltip>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true" Style="border-left: 3px solid var(--mud-palette-info);">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Awaiting Grace Period</MudText>
            <MudTooltip Text="MVOs fully disconnected, waiting for grace period to expire" Arrow="true" Placement="Placement.Top">
                <MudText Typo="Typo.h4">@_awaitingGracePeriodCount.ToString("N0")</MudText>
            </MudTooltip>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Outlined="true" Style="border-left: 3px solid var(--mud-palette-error);">
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">Ready for Deletion</MudText>
            <MudTooltip Text="MVOs eligible for deletion (grace period expired, no connectors)" Arrow="true" Placement="Placement.Top">
                <MudText Typo="Typo.h4" Color="@(_readyForDeletionCount > 0 ? Color.Error : Color.Default)">@_readyForDeletionCount.ToString("N0")</MudText>
            </MudTooltip>
        </MudPaper>
    </MudItem>
</MudGrid>

@* Object type filter *@
<MudGrid Class="mt-5">
    <MudItem xs="6">
        <MudSelect T="int?" Label="Filter by Object Type" Value="_selectedObjectTypeId"
                   ValueChanged="OnObjectTypeFilterChanged"
                   Variant="Variant.Outlined" Clearable="true" Dense="true" Style="max-width: 350px;">
            @foreach (var objectType in _objectTypes)
            {
                <MudSelectItem T="int?" Value="@objectType.Id">@objectType.Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count, density, the
   search box) lives in the shared grid; this page supplies the columns, the window loader, the object type
   filter above and the empty states. *@
<VirtualisedDataGrid @ref="_grid" T="PendingDeletionItem"
                     ContainerId="pending-deletion-list"
                     DefaultSortBy="disconnected"
                     LoadWindow="LoadWindowAsync"
                     RowClicked="HandleRowClicked"
                     SingularName="Pending Deletion"
                     PluralName="Pending Deletions">
    <Columns>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Display Name" Name="displayname" />
            </HeaderTemplate>
            <CellTemplate>
                @* The row navigates on click and so does this link; stopping the click here keeps a link click
                   to one history entry, while the link keeps middle-click and open-in-new-tab. *@
                <span @onclick:stopPropagation="true">
                    <MudLink Href="@GetMvoDetailHref(context.Item)">
                        @(context.Item.DisplayName ?? context.Item.Id.ToString())
                    </MudLink>
                </span>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Type" Name="type" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.TypeName
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Status</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.ConnectorCount > 0)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Warning">
                        Deprovisioning
                    </MudChip>
                }
                else if (context.Item.DaysUntilDeletion.HasValue && context.Item.DaysUntilDeletion.Value > 0)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Info">
                        Grace Period
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Error">
                        Ready
                    </MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <MudTooltip Text="The Connected System whose disconnection triggered the scheduled deletion" Arrow="true" Placement="Placement.Top">
                    <MudText Typo="Typo.button">Triggered By</MudText>
                </MudTooltip>
            </HeaderTemplate>
            <CellTemplate>
                @if (string.IsNullOrEmpty(context.Item.TriggeredBySystemName))
                {
                    <EmptyValue />
                }
                else
                {
                    @context.Item.TriggeredBySystemName
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Disconnected" Name="disconnected" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.LastConnectorDisconnectedDate.ToFriendlyDate()
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Deletion Eligible" Name="eligible" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.DeletionEligibleDate.HasValue)
                {
                    if (context.Item.DaysUntilDeletion.HasValue)
                    {
                        var daysUntilDeletion = context.Item.DaysUntilDeletion.Value;
                        var deletionEligibleDate = context.Item.DeletionEligibleDate.Value;
                        if (daysUntilDeletion <= 0)
                        {
                            <MudTooltip Text="@deletionEligibleDate.ToString("g")" Arrow="true" Placement="Placement.Top">
                                <MudText Color="Color.Error">Overdue by @FormatDayCount(Math.Abs(daysUntilDeletion))</MudText>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="@deletionEligibleDate.ToString("g")" Arrow="true" Placement="Placement.Top">
                                <span>@FormatDayCount(daysUntilDeletion)</span>
                            </MudTooltip>
                        }
                    }
                }
                else
                {
                    <span class="mud-text-secondary">Immediate</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Connectors</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.ConnectorCount > 0)
                {
                    <MudTooltip Text="@($"{context.Item.ConnectorCount} connector(s) remaining - awaiting cascade deletion")" Arrow="true" Placement="Placement.Top">
                        <MudBadge Content="@context.Item.ConnectorCount.ToString()" Color="Color.Warning" Overlap="false">
                            <MudIcon Icon="@Icons.Material.Filled.Link" />
                        </MudBadge>
                    </MudTooltip>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.LinkOff" Class="mud-text-secondary" />
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @* An empty list means one of three things, and the message says which: a search that matched nothing,
           an Object Type filter nothing satisfies (each with the way out as the action), or no objects in the
           deletion pipeline at all. *@
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No Pending Deletions match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else if (_selectedObjectTypeId.HasValue)
        {
            <TableEmptyState Icon="@Icons.Material.Filled.FilterAlt"
                             PrimaryText="No Metaverse Objects of the selected type are pending deletion"
                             SecondaryText="Clear the Object Type filter to see every pending deletion."
                             ActionText="Clear Filter"
                             OnAction="ClearObjectTypeFilterAsync" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.AutoDelete"
                             PrimaryText="There are no Metaverse Objects pending deletion"
                             SecondaryText="Identities appear here when a disconnection schedules their automatic deletion." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private VirtualisedDataGrid<PendingDeletionItem>? _grid;
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private int? _selectedObjectTypeId;
    private List<MetaverseObjectType> _objectTypes = new();

    // Summary counts. Taken across the whole match set by the server, not derived from the rows on screen: the
    // list is virtualised and holds only a window of them, and even the paged predecessor of this page counted
    // no further than its first hundred objects, so every card but the total under-reported beyond that.
    private int _totalCount;
    private int _deprovisioningCount;
    private int _awaitingGracePeriodCount;
    private int _readyForDeletionCount;

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("Home", href: "/", icon: Icons.Material.Filled.Home),
            new("Administration", href: "/admin"),
            new("Pending Deletions", href: null, disabled: true)
        };

        // Load object types for filter
        using var jim = JimFactory.Create();
        _objectTypes = await jim.Metaverse.GetMetaverseObjectTypesAsync(false);

        // Load summary counts
        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        using var jim = JimFactory.Create();
        var summary = await jim.Metaverse.GetMetaverseObjectsPendingDeletionStateCountsAsync(_selectedObjectTypeId);

        _totalCount = summary.Total;
        _deprovisioningCount = summary.Deprovisioning;
        _awaitingGracePeriodCount = summary.AwaitingGracePeriod;
        _readyForDeletionCount = summary.ReadyForDeletion;
    }

    /// <summary>
    /// Loads one window of pending deletions for the grid, honouring its search, sort and count-skipping
    /// contract; the Object Type filter is page-owned and applied on top.
    /// </summary>
    private async Task<VirtualisedWindow<PendingDeletionItem>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        using var jim = JimFactory.Create();
        var result = await jim.Metaverse.GetMetaverseObjectsPendingDeletionRangeAsync(
            request.StartIndex,
            request.Count,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            _selectedObjectTypeId,
            includeTotalCount: request.IncludeTotalCount);

        // Convert to display items
        var now = DateTime.UtcNow;
        var items = result.Results.Select(mvo => new PendingDeletionItem
        {
            Id = mvo.Id,
            DisplayName = mvo.NameOrId,
            TypeName = mvo.Type?.Name ?? "Unknown",
            TypeId = mvo.Type?.Id ?? 0,
            TypePluralName = mvo.Type?.PluralName ?? "objects",
            LastConnectorDisconnectedDate = mvo.LastConnectorDisconnectedDate!.Value,
            DeletionEligibleDate = mvo.DeletionEligibleDate,
            DaysUntilDeletion = mvo.DeletionEligibleDate.HasValue
                ? (int)Math.Ceiling((mvo.DeletionEligibleDate.Value - now).TotalDays)
                : (int?)null,
            GracePeriod = mvo.Type?.DeletionGracePeriod,
            ConnectorCount = mvo.ConnectedSystemObjects?.Count ?? 0,
            TriggeredBySystemName = mvo.DeletionTriggeredBySystemName
        }).ToList();

        return new VirtualisedWindow<PendingDeletionItem>(items, result.TotalResults);
    }

    private async Task OnObjectTypeFilterChanged(int? newValue)
    {
        _selectedObjectTypeId = newValue;
        await LoadSummaryAsync();

        // The filter changes which objects match, so the totals must be re-counted, and the reader's scroll
        // position describes a match set that no longer exists.
        if (_grid != null)
        {
            await _grid.ResetScrollAsync();
            await _grid.RefreshAsync(invalidateTotals: true);
        }
    }

    /// <summary>
    /// The empty state's way out when the Object Type filter matched nothing: clears it and reloads.
    /// </summary>
    private async Task ClearObjectTypeFilterAsync()
    {
        await OnObjectTypeFilterChanged(null);
    }

    private void HandleRowClicked(PendingDeletionItem item)
    {
        NavManager.NavigateTo(GetMvoDetailHref(item));
    }

    private static string GetMvoDetailHref(PendingDeletionItem item)
    {
        return Utilities.GetMetaverseObjectHref(item.Id, item.TypePluralName);
    }

    /// <summary>
    /// Formats a day count with the correct singular or plural unit ("1 day", "3 days").
    /// </summary>
    private static string FormatDayCount(int days)
    {
        return days == 1 ? "1 day" : $"{days:N0} days";
    }

    // Local display model
    private class PendingDeletionItem
    {
        public Guid Id { get; set; }
        public string? DisplayName { get; set; }
        public string TypeName { get; set; } = null!;
        public int TypeId { get; set; }
        public string TypePluralName { get; set; } = null!;
        public DateTime LastConnectorDisconnectedDate { get; set; }
        public DateTime? DeletionEligibleDate { get; set; }
        public int? DaysUntilDeletion { get; set; }
        public TimeSpan? GracePeriod { get; set; }
        public int ConnectorCount { get; set; }

        /// <summary>
        /// The name of the Connected System whose disconnection triggered the scheduled deletion (#119).
        /// Null for deletions scheduled before trigger recording shipped.
        /// </summary>
        public string? TriggeredBySystemName { get; set; }
    }
}
