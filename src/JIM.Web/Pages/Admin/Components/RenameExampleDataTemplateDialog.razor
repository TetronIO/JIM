@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory
@inject IDialogService DialogService

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<MudDialog>
    <DialogContent>
        <MudTextField T="string" Label="Name" Variant="Variant.Outlined" Immediate="true" @bind-Value="_name" AutoFocus="true"
                      Error="@(_error != null)" ErrorText="@_error" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanSave())" OnClick="SaveAsync">Rename</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter, EditorRequired]
    public int TemplateId { get; set; }

    [Parameter, EditorRequired]
    public string CurrentName { get; set; } = string.Empty;

    private string? _name;
    private string? _error;
    private bool _saving;

    protected override void OnInitialized() => _name = CurrentName;

    private bool CanSave() => !_saving && !string.IsNullOrWhiteSpace(_name) && _name.Trim() != CurrentName;

    private async Task SaveAsync()
    {
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Rename");
        if (cancelled)
            return;

        _saving = true;
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        var name = _name!.Trim();

        // a rename writes the name alone and leaves the template's rows untouched.
        var result = await ExampleDataTemplateEditorSave.ApplyAsync(jim, TemplateId, template => template.Name = name,
            user, changeReason, replaceObjectTypes: false);
        _saving = false;

        if (!result.Succeeded)
        {
            _error = result.Error;
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));
    }

    /// <summary>Opens the dialog; true when the template was renamed.</summary>
    public static async Task<bool> ShowAsync(IDialogService dialogService, int templateId, string currentName)
    {
        var parameters = new DialogParameters<RenameExampleDataTemplateDialog>
        {
            { x => x.TemplateId, templateId },
            { x => x.CurrentName, currentName }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await dialogService.ShowAsync<RenameExampleDataTemplateDialog>("Rename Data Generation Template", parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: true };
    }
}
