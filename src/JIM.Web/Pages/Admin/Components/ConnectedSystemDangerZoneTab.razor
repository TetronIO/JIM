<MudPaper Class="pa-4 jim-paper-danger-zone">
    <MudText Typo="Typo.h6" Color="Color.Error">Delete Connected System</MudText>
    <MudText Class="mt-2">
        Permanently delete this Connected System and all its related data, including:
    </MudText>
    <ul class="mt-2 ml-4">
        <li>All Connected System Objects (CSOs)</li>
        <li>All Synchronisation Rules</li>
        <li>All Run Profiles</li>
        <li>All Partitions and Containers</li>
        <li>All Pending Exports</li>
    </ul>
    <MudText Class="mt-2">
        Metaverse Objects joined to this system's CSOs will be disconnected but not deleted.
    </MudText>

    @if (ConnectedSystem.Status == ConnectedSystemStatus.Deleting)
    {
        <MudText Class="mt-2">
            A deletion is already underway or stopped partway for this system. Deleting again offers the
            exits: Deprovision through synchronisation resumes the run, and Delete immediately and keep
            contributed data completes the deletion at once.
        </MudText>
    }

    @* Stays live for a fenced (Status = Deleting) system: the dialog's two modes become the retry and
       finish-immediately exits (#809), and the server refuses anything that cannot proceed. *@
    <MudButton
        Variant="Variant.Filled"
        Color="Color.Error"
        Class="mt-5"
        DropShadow="false"
        StartIcon="@Icons.Material.Filled.Delete"
        OnClick="HandleShowDeleteConfirmationAsync">
        Delete Connected System
    </MudButton>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    private async Task HandleShowDeleteConfirmationAsync()
    {
        // The dialog reports success for both an immediate deletion and a queued one; either way this
        // system's detail page is about to stop being meaningful, so return to the list.
        if (await DeleteConnectedSystemDialog.ShowAsync(DialogService, ConnectedSystem))
            NavManager.NavigateTo("/admin/connected-systems/");
    }
}
