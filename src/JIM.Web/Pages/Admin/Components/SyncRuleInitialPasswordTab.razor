<SyncRuleInitialPasswordSection Configuration="@InitialPasswordConfiguration"
                                DiscoveredPolicy="@DiscoveredPasswordPolicy"
                                SupportedExpiryBehaviours="@SupportedExpiryBehaviours"
                                Assessment="@InitialPasswordAssessment"
                                ConnectorName="@PasswordConnectorName"
                                ParkedReasons="@InitialPasswordParkedReasons"
                                WillReleaseParkedOnSave="@WillReleaseParkedInitialPasswordsOnSave"
                                StaticPasswordAssessment="@StaticPasswordAssessment"
                                OnStaticPasswordEntered="HandleStaticPasswordEnteredAsync"
                                OnChanged="HandleInitialPasswordChangedAsync" />

@code {
    [Parameter]
    public SyncRule SyncRule { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>
    /// What is wrong with the initial-password settings, raised so the page's save bar can list it and refuse to
    /// save. Empty means there is nothing to fix.
    /// <para>
    /// Raised rather than read, because the settings live behind this tab while the save bar belongs to the page,
    /// and the assessment needs the discovered policy and the application layer that only this tab loads.
    /// </para>
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyList<string>> OnInitialPasswordIssuesChanged { get; set; }

    /// <summary>
    /// The password policy JIM discovered on the Connected System, loaded once per Connected System selection.
    /// </summary>
    private ConnectedSystemPasswordPolicy? DiscoveredPasswordPolicy { get; set; }

    private IReadOnlyCollection<PasswordExpiryBehaviour> SupportedExpiryBehaviours { get; set; } = [];

    /// <summary>
    /// The Connector's name, for the section's prose. Resolved from the Connected System loaded here rather
    /// than from SyncRule.ConnectedSystem.ConnectorDefinition, which a Synchronisation Rule's include chain
    /// does not load: dereferencing it threw and took the whole tab down with it.
    /// </summary>
    private string PasswordConnectorName { get; set; } = "Connected System's";

    private PasswordGenerationAssessment? InitialPasswordAssessment { get; set; }

    /// <summary>
    /// What the static password an administrator has just typed contains. Null until one is typed, including on a
    /// saved rule that already has one: the stored password is never read back to be assessed.
    /// </summary>
    private SuppliedPasswordAssessment? StaticPasswordAssessment { get; set; }

    private int _passwordContextLoadedForConnectedSystemId;

    private SyncRule? _initialPasswordEditorBoundTo;
    private SyncRuleInitialPassword? _initialPasswordEditor;

    /// <summary>
    /// What the rule's initial-password settings were when this tab bound to it, so an edit can be recognised as
    /// one. The editor mutates its instance in place, so without a copy taken up front there is nothing left to
    /// compare against.
    /// </summary>
    private SyncRuleInitialPassword? _initialPasswordAsSaved;

    /// <summary>
    /// When the saved static password was last changed. Held separately because
    /// <see cref="SyncRuleInitialPassword.SnapshotDeliverySettings"/> deliberately omits it: it is a record of a
    /// change rather than an input to what gets delivered. Needed here so that clearing a half-typed entry puts
    /// the stamp back to what was saved rather than leaving it reading as changed.
    /// </summary>
    private DateTime? _staticPasswordSetAtAsSaved;

    /// <summary>
    /// What the target said about the accounts parked against this rule. Loaded once with the rest of the
    /// password context, not per keystroke: the answer only changes when a run attempts a delivery.
    /// </summary>
    private IReadOnlyList<InitialPasswordRejection>? InitialPasswordParkedReasons { get; set; }

    /// <summary>
    /// What the last assessment found wrong with the initial-password settings, and what was last raised to the
    /// page, so an unchanged answer is not raised again on every render.
    /// </summary>
    private IReadOnlyList<string> _initialPasswordIssues = [];
    private IReadOnlyList<string> _raisedInitialPasswordIssues = [];

    /// <summary>
    /// The issues worth stopping a save for.
    /// <para>
    /// Empty while this tab is hidden, which is the whole point: the tab is absent on a rule that provisions
    /// nothing, and blocking a save on settings the administrator cannot see, let alone correct, would be a trap
    /// with no way out. Settings left enabled on such a rule deliver nothing anyway, because nothing is ever
    /// provisioned for them to act on, and turning provisioning back on brings both the tab and this gate back
    /// with the settings intact.
    /// </para>
    /// </summary>
    private IReadOnlyList<string> InitialPasswordIssues =>
        SyncRule.Direction == SyncRuleDirection.Export && SyncRule.ProvisionToConnectedSystem == true
            ? _initialPasswordIssues
            : [];

    /// <summary>
    /// Whether saving would release the parked accounts, decided by the same comparison the save path itself
    /// uses, so the tab cannot promise a release that saving will not perform.
    /// </summary>
    private bool WillReleaseParkedInitialPasswordsOnSave =>
        InitialPasswordParkedReasons is { Count: > 0 } &&
        !SyncRuleInitialPassword.WouldDeliverTheSameAs(_initialPasswordAsSaved, SyncRule.InitialPassword);

    /// <summary>
    /// What the initial-password editor binds to: the rule's own configuration where it has one, otherwise a
    /// fresh one held aside.
    /// <para>
    /// Deliberately NOT attached to the Synchronisation Rule here. Attaching on read would give every
    /// provisioning rule an initial-password row, and a configuration change in its history, merely because
    /// somebody opened this tab. It is attached in <see cref="HandleInitialPasswordChangedAsync"/>, which only
    /// runs on a real edit.
    /// </para>
    /// </summary>
    private SyncRuleInitialPassword InitialPasswordConfiguration
    {
        get
        {
            if (!ReferenceEquals(_initialPasswordEditorBoundTo, SyncRule))
            {
                _initialPasswordEditorBoundTo = SyncRule;
                _initialPasswordEditor = SyncRule.InitialPassword ?? new SyncRuleInitialPassword { SyncRuleId = SyncRule.Id };

                // Taken from the rule's own configuration, not the editor's: a rule that has none is saved as
                // having none, and the editor's held-aside instance would wrongly read as the saved state.
                _initialPasswordAsSaved = SyncRule.InitialPassword?.SnapshotDeliverySettings();
                _staticPasswordSetAtAsSaved = SyncRule.InitialPassword?.StaticPasswordSetAt;
                StaticPasswordAssessment = null;
            }

            return _initialPasswordEditor!;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadPasswordContextAsync();
        await RaiseInitialPasswordIssuesAsync();
    }

    /// <summary>
    /// Tells the page what is wrong with the initial-password settings, and only when the answer has changed.
    /// Raising unconditionally would re-render the page on every parameter set, which re-renders this tab, which
    /// raises again.
    /// </summary>
    private async Task RaiseInitialPasswordIssuesAsync()
    {
        var issues = InitialPasswordIssues;
        if (_raisedInitialPasswordIssues.SequenceEqual(issues))
            return;

        _raisedInitialPasswordIssues = issues;
        await OnInitialPasswordIssuesChanged.InvokeAsync(issues);
    }

    /// <summary>
    /// Loads what the initial-password editor needs from the Connected System: the policy JIM discovered there,
    /// and what its Connector is able to apply once a password is set.
    /// <para>
    /// Keyed on the Connected System so that switching it on a new rule reloads, and so that ordinary edits to
    /// other fields do not re-query on every keystroke.
    /// </para>
    /// </summary>
    private async Task LoadPasswordContextAsync()
    {
        if (SyncRule.Direction != SyncRuleDirection.Export || SyncRule.ConnectedSystem == null)
            return;

        if (_passwordContextLoadedForConnectedSystemId == SyncRule.ConnectedSystem.Id)
            return;

        _passwordContextLoadedForConnectedSystemId = SyncRule.ConnectedSystem.Id;

        using var jim = JimFactory.Create();
        // Read explicitly rather than off SyncRule.ConnectedSystem.PasswordPolicy: the rule's include chain does
        // not carry it, and an unloaded navigation would look exactly like a target with no policy at all.
        DiscoveredPasswordPolicy = await jim.ConnectedSystems.GetPasswordPolicyAsync(SyncRule.ConnectedSystem.Id);
        SupportedExpiryBehaviours = await jim.ConnectedSystems.GetSupportedPasswordExpiryBehavioursAsync(SyncRule.ConnectedSystem.Id);

        var connectedSystem = await jim.ConnectedSystems.GetConnectedSystemCoreAsync(SyncRule.ConnectedSystem.Id);
        PasswordConnectorName = connectedSystem?.ConnectorDefinition?.Name ?? "Connected System's";

        // A rule being created has no id and therefore nothing parked against it yet.
        if (SyncRule.Id > 0)
            InitialPasswordParkedReasons = await jim.InitialPasswords.GetParkedReasonsAsync(SyncRule.Id);

        AssessInitialPassword(jim);
    }

    /// <summary>
    /// Works out what the current settings would produce, so an administrator sees a configuration the target
    /// would reject before it is saved rather than one account at a time afterwards.
    /// </summary>
    private void AssessInitialPassword(JimApplication jim)
    {
        // The editor's instance, not the rule's navigation: they are the same object once anything has been
        // edited, and before that the rule has none while the editor still has settings worth assessing.
        var configuration = InitialPasswordConfiguration;

        // A password typed for a source that has since been changed away from is not a problem anybody needs to
        // fix, and its alert is no longer on screen to explain a blocked save.
        if (configuration.Source != InitialPasswordSource.Static)
            StaticPasswordAssessment = null;

        // A static password is not generated, so there is no generator configuration to assess. Its own
        // assessment is made when one is typed, in HandleStaticPasswordEnteredAsync.
        if (!configuration.Enabled || configuration.Source == InitialPasswordSource.Static)
        {
            InitialPasswordAssessment = null;
        }
        else
        {
            var policy = configuration.Source == InitialPasswordSource.Custom
                ? configuration.CustomPolicy
                : jim.PasswordGenerator.DeriveFrom(DiscoveredPasswordPolicy);

            InitialPasswordAssessment = jim.PasswordGenerator.Assess(policy, DiscoveredPasswordPolicy);
        }

        // What the settings would produce is this tab's business; what is wrong with them is the save bar's.
        // Asked of the application layer rather than decided here, so the portal and the REST API cannot differ
        // on which settings are savable. A typed password the target would refuse supersedes the configuration's
        // own problems: it is the thing in front of the administrator, and it is why nothing was stored.
        _initialPasswordIssues = StaticPasswordAssessment is { IsUsable: false } supplied
            ? [.. supplied.Problems.Select(problem => $"Initial Password: {problem}")]
            : [.. jim.InitialPasswords.AssessConfiguration(configuration, DiscoveredPasswordPolicy)
                .Select(problem => $"Initial Password: {problem}")];
    }

    private async Task HandleInitialPasswordChangedAsync()
    {
        // Attached on the first real edit, so it becomes part of the graph the save persists. See the note on
        // InitialPasswordConfiguration for why this does not happen when the tab is merely opened.
        SyncRule.InitialPassword ??= InitialPasswordConfiguration;

        using (var jim = JimFactory.Create())
        {
            AssessInitialPassword(jim);
        }

        await RaiseInitialPasswordIssuesAsync();
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Takes the static password an administrator typed, encrypts it, and works out whether the target would
    /// accept it.
    /// <para>
    /// The plaintext gets no further than this method: it is encrypted through the application layer, which owns
    /// the one answer to what happens when credential protection is unreachable, and the assessment carries only
    /// the password's length and character categories.
    /// </para>
    /// <para>
    /// A null password means nothing usable has been typed (an empty field, or two fields that disagree), and
    /// puts the stored value back to what was saved. That is what makes an empty field mean "leave the stored
    /// password as it is" while stopping a password committed from a field since edited surviving on the model.
    /// </para>
    /// <para>
    /// A password the target would refuse is treated the same way: it is assessed before it is taken, and a
    /// refusal leaves the stored value exactly as it was. One static password goes to every account the rule
    /// provisions, so accepting one the target rejects would park all of them; the REST API refuses such a
    /// password outright, and this is the portal saying the same thing.
    /// </para>
    /// </summary>
    private async Task HandleStaticPasswordEnteredAsync(string? password)
    {
        SyncRule.InitialPassword ??= InitialPasswordConfiguration;
        var configuration = InitialPasswordConfiguration;

        using (var jim = JimFactory.Create())
        {
            StaticPasswordAssessment = string.IsNullOrEmpty(password)
                ? null
                : jim.PasswordGenerator.AssessSupplied(password, DiscoveredPasswordPolicy);

            if (StaticPasswordAssessment is { IsUsable: true })
            {
                configuration.StaticPasswordEncryptedValue = jim.InitialPasswords.ProtectStaticPassword(password!);
                configuration.StaticPasswordSetAt = DateTime.UtcNow;
            }
            else
            {
                configuration.StaticPasswordEncryptedValue = _initialPasswordAsSaved?.StaticPasswordEncryptedValue;
                configuration.StaticPasswordSetAt = _staticPasswordSetAtAsSaved;
            }

            AssessInitialPassword(jim);
        }

        await RaiseInitialPasswordIssuesAsync();
        await OnChanged.InvokeAsync();
    }
}
