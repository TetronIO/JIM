@using JIM.Models.Activities
@using JIM.Models.Activities.DTOs
@using JIM.Models.Sync
@using JIM.Web.Causality
@inject IUserPreferenceService PreferenceService

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

@* The causality visualisation panel for a Run Profile Execution Item. Owns the current view, the
   technical-names toggle, the Timeline's expanded event and the Spine's selected event (whose
   attribute detail renders in the shared bottom drawer); builds the causality and spine models and
   the summary once per (Item, Context, Chain) tuple and renders the summary band (whose head row
   carries the view switcher and technical-names toggle in its Actions slot), the active view and
   the drawer. Persisted view and technical-names preferences load on first render per the
   TableDensityToggle idiom; the Spine is the default, and a stored preference for an unknown or
   retired view (the old Flow and Graph keys included) falls back to it without being overwritten.
   The causal chain renders on the Spine itself (#1495); the separate Caused by list retired with
   the Flow and Graph views. *@

<div class="causality-panel">
    @if (Item.SyncOutcomes.Count == 0)
    {
        <div class="pa-4">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                Outcome tracking was not enabled when this activity was recorded.
                Only the operation type is available.
            </MudAlert>
        </div>
    }
    else if (_model != null && _summary != null)
    {
        <CausalitySummaryBand Summary="_summary" Context="Context" Timestamp="Timestamp" StatusTone="GetStatusTone()"
                              TechnicalNames="_technicalNames">
            <Actions>
                @if (AvailableViews.Count > 1)
                {
                    <div class="seg" role="group" aria-label="Causality view">
                        @foreach (var view in AvailableViews)
                        {
                            <button type="button" class="@(view == _view ? "on" : null)"
                                    aria-pressed="@(view == _view ? "true" : "false")"
                                    @onclick="() => SelectViewAsync(view)">@GetViewLabel(view)</button>
                        }
                    </div>
                }
                <button type="button" class="toggle-line @(_technicalNames ? "on" : null)"
                        aria-pressed="@(_technicalNames ? "true" : "false")"
                        @onclick="ToggleTechnicalNamesAsync">
                    <span class="track" aria-hidden="true"></span> Technical names
                </button>
            </Actions>
        </CausalitySummaryBand>

        <div class="canvas-wrap">
            @switch (_view)
            {
                case CausalityView.Spine when _spineModel is { } spineModel:
                    <CausalitySpineView Model="spineModel" TechnicalNames="_technicalNames"
                                        @bind-SelectedEvent="_selectedEvent" />
                    break;
                case CausalityView.Timeline:
                default:
                    <CausalityTimelineView Model="_model" TechnicalNames="_technicalNames"
                                           @bind-ExpandedEvent="_expandedEvent" />
                    break;
            }
        </div>

        @* ─── Bottom drawer: attribute detail for the Spine's selected event ─── *@
        @if (_view != CausalityView.Timeline && _selectedEvent is { } selectedEvent && selectedEvent.AttributeRows.Count > 0)
        {
            <div class="drawer">
                <div class="drawer-inner">
                    <div class="drawer-head">
                        <span class="drawer-title">@(_technicalNames ? selectedEvent.TechnicalLabel : selectedEvent.PlainLabel)</span>
                        <span class="drawer-sub">@GetDrawerSubtitle(selectedEvent)</span>
                        <button type="button" class="drawer-close" aria-label="Close detail"
                                @onclick="CloseDrawer">&#x2715;</button>
                    </div>
                    @* Keyed on the event so the detail's filter state resets when another card is selected *@
                    @* An event with a rows caption is naming what its rows are rather than counting changes,
                       so those rows carry no meaningful operation to show. *@
                    <CausalityAttributeDetail @key="selectedEvent" Rows="selectedEvent.AttributeRows"
                                              ShowOperations="@(selectedEvent.AttributeRowsCaption == null)" />
                </div>
            </div>
        }
    }
</div>

@code {
    /// <summary>
    /// The views currently implemented, in switcher order. A stored preference only takes effect
    /// when its view appears here.
    /// </summary>
    private static readonly IReadOnlyList<CausalityView> AvailableViews =
        [CausalityView.Spine, CausalityView.Timeline];

    /// <summary>
    /// The Run Profile Execution Item whose causality is visualised.
    /// </summary>
    [Parameter, EditorRequired]
    public ActivityRunProfileExecutionItem Item { get; set; } = null!;

    /// <summary>
    /// The page-level context (run, Connected System, record and Metaverse Object Type names) used
    /// for sentence composition and link building.
    /// </summary>
    [Parameter, EditorRequired]
    public CausalityPageContext Context { get; set; } = null!;

    /// <summary>
    /// The Pending Exports this item created that are still queued, or null when the host page did
    /// not resolve them (in which case every Pending Export link stays precise). Pending Export rows
    /// are deleted once exported, so this is what lets a link degrade to the target system's queue
    /// rather than 404. Pass the same instance across renders; a new set rebuilds the model and drops
    /// the expanded and selected event.
    /// </summary>
    [Parameter]
    public IReadOnlySet<Guid>? LivePendingExportIds { get; set; }

    /// <summary>
    /// The execution timestamp (UTC) shown in the summary band.
    /// </summary>
    [Parameter]
    public DateTime? Timestamp { get; set; }

    /// <summary>
    /// The upward causal walk for this item, or null when the host page did not resolve one. Owned by
    /// the page rather than fetched here: the panel is a rendering component with no data access of
    /// its own, and the walk is one query the page already has an application scope open for. Feeds
    /// the Spine's chain cards and the export decision captions (#1495).
    /// </summary>
    [Parameter]
    public CausalChain? Chain { get; set; }

    /// <summary>
    /// The decision-time Metaverse Object deletion policy recorded on the item, where one was captured. Supplies
    /// the synthetic "Identity not deleted" event, which is the one thing a Deletion Rule's decision leaves no
    /// outcome to render.
    /// </summary>
    [Parameter]
    public MvoDeletionPolicySnapshot? DeletionPolicySnapshot { get; set; }

    /// <summary>
    /// Whether the Run Profile behind this item was a Full or Delta Synchronisation. Only a Synchronisation
    /// evaluates a Deletion Rule, so only a Synchronisation can report that one declined.
    /// </summary>
    [Parameter]
    public bool IsSynchronisationRun { get; set; }

    private CausalityModel? _model;
    private CausalitySummary? _summary;
    private CausalitySpineModel? _spineModel;
    private CausalityView _view = CausalityView.Spine;
    private bool _technicalNames;
    private CausalityEvent? _expandedEvent;
    private CausalityEvent? _selectedEvent;
    private ActivityRunProfileExecutionItem? _builtItem;
    private CausalityPageContext? _builtContext;
    private IReadOnlySet<Guid>? _builtLivePendingExportIds;
    private CausalChain? _builtChain;

    protected override void OnParametersSet()
    {
        // Build once per (Item, Context, Chain) tuple; parent re-renders with unchanged values must
        // not discard the expanded/selected-event state by rebuilding the model. The chain is an
        // input (#1495): it supplies the export decision captions and the Spine's chain cards, and
        // the page resolves it after the first render, so its arrival must rebuild.
        if (ReferenceEquals(Item, _builtItem) && Equals(Context, _builtContext)
            && ReferenceEquals(LivePendingExportIds, _builtLivePendingExportIds)
            && ReferenceEquals(Chain, _builtChain))
            return;

        _builtItem = Item;
        _builtContext = Context;
        _builtLivePendingExportIds = LivePendingExportIds;
        _builtChain = Chain;
        _model = CausalityModelBuilder.Build(Item, Context, LivePendingExportIds,
            DeletionPolicySnapshot, IsSynchronisationRun, Chain);
        _summary = CausalitySummaryBuilder.Build(_model);
        _spineModel = CausalitySpineModelBuilder.Build(_model, Chain, Item.ObjectChangeType);
        _expandedEvent = null;
        _selectedEvent = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        // No try/catch needed: the preference service swallows JS interop unavailability internally
        var storedView = CausalityViewPreference.FromKey(await PreferenceService.GetCausalityViewAsync());
        var storedTechNames = await PreferenceService.GetCausalityTechNamesAsync();

        // A stored preference for an unknown or retired view keeps the default without overwriting
        // the stored value; the old Flow and Graph keys land here deliberately (#1495)
        if (storedView.HasValue && AvailableViews.Contains(storedView.Value))
            _view = storedView.Value;

        _technicalNames = storedTechNames == true;
        StateHasChanged();
    }

    private async Task SelectViewAsync(CausalityView view)
    {
        _view = view;
        _selectedEvent = null;
        await PreferenceService.SetCausalityViewAsync(CausalityViewPreference.ToKey(view));
    }

    private async Task ToggleTechnicalNamesAsync()
    {
        _technicalNames = !_technicalNames;
        await PreferenceService.SetCausalityTechNamesAsync(_technicalNames);
    }

    private void CloseDrawer()
    {
        _selectedEvent = null;
    }

    private static string GetDrawerSubtitle(CausalityEvent selectedEvent)
    {
        var count = selectedEvent.AttributeRows.Count;
        // A queued deprovision's rows identify the target rather than change it, so the drawer says what
        // they are rather than calling them changes; see CausalityEvent.AttributeRowsCaption.
        var subtitle = selectedEvent.AttributeRowsCaption
                       ?? $"{count} attribute change{(count == 1 ? "" : "s")}";
        return string.IsNullOrWhiteSpace(selectedEvent.SystemName)
            ? subtitle
            : $"{subtitle} · {selectedEvent.SystemName}";
    }

    private CausalityTone GetStatusTone()
    {
        return Item.ErrorType is not null and not ActivityRunProfileExecutionItemErrorType.NotSet
            ? CausalityTone.Error
            : CausalityTone.Success;
    }

    private static string GetViewLabel(CausalityView view)
    {
        return view switch
        {
            CausalityView.Spine => "Spine",
            _ => "Timeline"
        };
    }
}
