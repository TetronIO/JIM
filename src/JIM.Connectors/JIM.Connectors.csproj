<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="JIM.Worker.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <!-- Managed ADO.NET providers for the JIM SQL Connector. Approved via Third-Party Dependency
         Governance on 2026-07-31 and pinned exactly per engineering/DEPENDENCY_PINNING.md.
         Microsoft.Data.SqlClient.Extensions.Azure must never be added: cloud authentication is a
         non-goal for this Connector (see engineering/prd/doing/PRD_SQL_DATABASE_CONNECTOR.md). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <PackageReference Include="System.DirectoryServices.Protocols" Version="10.0.13" />
    <!-- Transitive override: Microsoft.Data.SqlClient 7.1.1 requires System.Security.Cryptography.Pkcs 9.0.18
         (and Oracle.ManagedDataAccess.Core 8.0.1), which have known high- and moderate-severity vulnerabilities
         (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7: CPU exhaustion in CMS parsing); fixed in 10.0.13. Remove when
         both providers reference a patched version themselves. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JIM.Models\JIM.Models.csproj" />
    <ProjectReference Include="..\JIM.Utilities\JIM.Utilities.csproj" />
    <ProjectReference Include="..\JIM.Scim\JIM.Scim.csproj" />
  </ItemGroup>
</Project>
