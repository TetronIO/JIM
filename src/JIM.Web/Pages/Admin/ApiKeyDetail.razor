@page "/admin/apikeys/{Id:guid}"
@attribute [Authorize(Roles = "Administrator")]
@using System.Globalization
@using JIM.Models.Activities
@using JIM.Models.Security
@using JIM.Models.Utility
@using JIM.Utilities
@using JIM.Web.Models
@using JIM.Web.Pages.Admin.Components
@using JIM.Web.Services
@using Humanizer
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@string.Format(CultureInfo.CurrentCulture, AdminText.ApiKeyDetailPageTitle, _apiKey?.Name)</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Api" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>@AdminText.ApiKeyHeading</span> <span class="mud-primary-text">@_apiKey?.Name</span>
    <PageInfo Title="@AdminText.ApiKeyNounSingular" DocsPage="configuration/api-keys.md">
        @AdminText.ApiKeyDetailPageInfo
    </PageInfo>
</MudText>
<div class="d-flex justify-space-between align-center">
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
    @if (_apiKey != null)
    {
        <AuditInfo Entity="@_apiKey" />
    }
</div>

@if (_apiKey != null)
{
    <NavigableMudTabs Class="mt-2" TabPanelsClass="pt-6">

        <MudTabPanel Text="@AdminText.ApiKeyDetailsTab">
            <MudPaper Class="pa-4" Outlined="true">
                <MudForm @bind-IsValid="_detailsFormValid">
                    <PrefilledFormValidator />
                    <MudTextField T="string" @bind-Value="_apiKey.Name" Label="@CommonText.FieldName" Required="true" RequiredError="@AdminText.ApiKeyNameRequired"
                        Immediate="true" Variant="Variant.Outlined" />
                    <MudTextField T="string" @bind-Value="_apiKey.Description" Label="@CommonText.FieldDescription" Required="false"
                        Lines="2" MaxLines="6" Sizing="InputSizing.Auto" Variant="Variant.Outlined" Class="mt-5" />
                </MudForm>
                @* mt-3: see ConnectedSystemDetailsTab, same in-panel button spacing *@
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_detailsFormValid)" Class="mt-3" OnClick="HandleSaveDetailsAsync" DropShadow="false">@CommonText.SaveChanges</MudButton>
            </MudPaper>

            <MudPaper Class="pa-4 mt-6" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-4">@AdminText.ApiKeyMetadata</MudText>
                <MudGrid Spacing="4">
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">@AdminText.ApiKeyIdLabel</MudText>
                        <MudText Class="jim-text-code">@_apiKey.Id</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">@AdminText.ApiKeyPrefixLabel</MudText><br />
                        <MudTooltip Text="@AdminText.ApiKeyPrefixTooltip" Arrow="true" Placement="Placement.Top">
                            <span class="jim-code-inline">@_apiKey.KeyPrefix...</span>
                        </MudTooltip>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">@AdminText.ApiKeyStatusLabel</MudText><br />
                        @if (_apiKey.IsEnabled)
                        {
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Success" Class="ml-0">@CommonText.Enabled</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Class="ml-0">@CommonText.Disabled</MudChip>
                        }
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">@AdminText.ApiKeyExpiresLabel</MudText>
                        @if (_apiKey.ExpiresAt.HasValue)
                        {
                            var expiresAt = _apiKey.ExpiresAt.Value;
                            @if (expiresAt < DateTime.UtcNow)
                            {
                                <br /><MudChip T="string" Variant="Variant.Text" Color="Color.Error" Class="ml-0">@string.Format(CultureInfo.CurrentCulture, AdminText.ApiKeyExpiredOn, expiresAt.ToLocalTime().ToFriendlyDate())</MudChip>
                            }
                            else
                            {
                                <MudText>@expiresAt.ToLocalTime().ToFriendlyDate()</MudText>
                            }
                        }
                        else
                        {
                            <MudText>@CommonText.Never</MudText>
                        }
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">@AdminText.ApiKeyLastUsedLabel</MudText>
                        @if (_apiKey.LastUsedAt.HasValue)
                        {
                            var lastUsedAt = _apiKey.LastUsedAt.Value;
                            <MudText>
                                @lastUsedAt.ToLocalTime().ToFriendlyDate()
                                @if (!string.IsNullOrEmpty(_apiKey.LastUsedFromIp))
                                {
                                    <span>@AdminText.ApiKeyFrom
                                        <MudTooltip Text="@AdminText.ApiKeyIpTooltip" Arrow="true" Placement="Placement.Top">
                                            <span class="jim-code-inline">@_apiKey.LastUsedFromIp</span>
                                        </MudTooltip>
                                    </span>
                                }
                            </MudText>
                        }
                        else
                        {
                            <MudText>@CommonText.Never</MudText>
                        }
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">@AdminText.ApiKeyRolesLabel</MudText><br />
                        @if (_apiKey.Roles.Count > 0)
                        {
                            @foreach (var role in _apiKey.Roles)
                            {
                                <MudChip T="string" Variant="Variant.Text" Color="Color.Info" Class="mr-1">@BuiltInDisplay.RoleName(role.Name, role.BuiltIn)</MudChip>
                            }
                        }
                        else
                        {
                            <MudText>@AdminText.ApiKeyNoRolesAssigned</MudText>
                        }
                    </MudItem>

                    @if (_apiKey.IsInfrastructureKey)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudText Typo="Typo.button" Class="mud-text-secondary">@AdminText.ApiKeyTypeLabel</MudText><br />
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Warning" Icon="@Icons.Material.Filled.Construction">@AdminText.ApiKeyInfrastructureKey</MudChip>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="@AdminText.ApiKeyActivityTab">
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                @AdminText.ApiKeyActivitiesIntro
            </MudText>

            @* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count, density
               and the search box) lives in the shared grid; this page supplies the columns, the window loader and
               the empty states. *@
            <VirtualisedDataGrid T="Activity"
                                 ContainerId="api-key-activity"
                                 StateKey="@Id.ToString()"
                                 DefaultSortBy="created"
                                 DefaultSortDescending="true"
                                 LoadWindow="LoadActivityWindowAsync"
                                 RowClicked="HandleRowClicked"
                                 SingularName="@AdminText.ApiKeyActivityNounSingular"
                                 PluralName="@AdminText.ApiKeyActivityNounPlural"
                                 SearchPlaceholder="@AdminText.ApiKeyActivitySearchPlaceholder">
                <Columns>
                    <TemplateColumn Title="@CommonText.ColumnType" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="@CommonText.ColumnType" Name="type" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @Helpers.GetActivityTargetTypeName(context.Item.TargetType)
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@AdminText.ApiKeyActivityTarget" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="@AdminText.ApiKeyActivityTarget" Name="target" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @(!string.IsNullOrEmpty(context.Item.TargetName) ? context.Item.TargetNameForDisplay() : AdminText.ApiKeyActivityNoName)
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@AdminText.ApiKeyActivityOperation" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="@AdminText.ApiKeyActivityOperation" Name="operation" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="string" Variant="Variant.Text"
                                Color="Helpers.GetActivityMudBlazorColorForOperation(context.Item.TargetOperationType)">
                                @context.Item.TargetOperationType.ForDisplay()
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@CommonText.ColumnCreated" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="@CommonText.ColumnCreated" Name="created" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                                <span>@context.Item.Created.ToLocalTime().ToRelativeTime()</span>
                            </MudTooltip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@CommonText.ColumnStatus" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="@CommonText.ColumnStatus" Name="status" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="string" Variant="Variant.Text"
                                Color="Helpers.GetActivityMudBlazorColorForStatus(context.Item.Status)">
                                @context.Item.Status.ForDisplay()
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn Title="@AdminText.ApiKeyActivityExecutionTime" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="@AdminText.ApiKeyActivityExecutionTime" Name="executiontime" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.ExecutionTime.HasValue)
                            {
                                var executionTime = context.Item.ExecutionTime.Value;
                                @executionTime.ToCasualString()
                            }
                            else
                            {
                                <EmptyValue />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <EmptyContent Context="grid">
                    @* A search that matched nothing has a way out to offer; an API Key that has never been used
                       has none, so it says what would put rows here instead. *@
                    @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                         PrimaryText="@string.Format(CultureInfo.CurrentCulture, AdminText.ApiKeyActivityEmptySearch, grid.SearchText)"
                                         SecondaryText="@CommonText.TrySearchAgain"
                                         ActionText="@CommonText.ClearSearch"
                                         OnAction="@(() => grid.ClearSearchAsync())" />
                    }
                    else
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.Api"
                                         PrimaryText="@AdminText.ApiKeyActivityEmptyNone"
                                         SecondaryText="@AdminText.ApiKeyActivityEmptyNoneHint" />
                    }
                </EmptyContent>
            </VirtualisedDataGrid>
        </MudTabPanel>

        <MudTabPanel Text="@AdminText.ApiKeyChangesTab" BadgeData="@(_changeCount > 0 ? _changeCount.ToString("N0") : null)" BadgeColor="Color.Primary">
            <ConfigurationChangesTab TargetType="ActivityTargetType.ApiKey" ObjectGuidId="Id" ObjectTypeLabel="@AdminText.ApiKeyNounSingular" />
        </MudTabPanel>

    </NavigableMudTabs>
}
else if (!_loading)
{
    <MudAlert Severity="Severity.Warning" Class="mt-5">
        @AdminText.ApiKeyNotFound
    </MudAlert>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private ApiKey? _apiKey;
    private bool _loading = true;
    private int _changeCount;
    private bool _detailsFormValid;

    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnParametersSetAsync()
    {
        using var jim = JimFactory.Create();
        _loading = true;
        _apiKey = await jim.Security.GetApiKeyAsync(Id);
        _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.ApiKey, Id, 1, 1)).TotalResults;
        _loading = false;

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
            new(LayoutText.NavAdministration, href: "/admin"),
            new(AdminText.ApiKeyPageTitle, href: "/admin/apikeys"),
            new(_apiKey?.Name ?? AdminText.ApiKeyDetailNotFound, href: null, disabled: true)
        };
    }

    private async Task HandleSaveDetailsAsync()
    {
        if (_apiKey == null)
            return;

        // offer an optional reason for the configuration change history; cancelling aborts the save
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
        if (cancelled)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.Security.UpdateApiKeyAsync(_apiKey, user, changeReason);
        Snackbar.Add(AdminText.ApiKeyUpdatedSuccess, Severity.Success);
    }

    /// <summary>
    /// Reads one window of the Activities this API Key initiated. The list is unbounded (an API Key in daily use
    /// accumulates one Activity per write), so it is read by offset and count rather than loaded and sliced, and
    /// the request's skip-the-count contract is passed straight through: a null total means "not counted", never
    /// that nothing matched.
    /// </summary>
    private async Task<VirtualisedWindow<Activity>> LoadActivityWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        if (_apiKey == null)
            return new VirtualisedWindow<Activity>([], request.IncludeTotalCount ? 0 : null);

        using var jim = JimFactory.Create();
        var result = await jim.Activities.GetActivitiesRangeAsync(
            request.StartIndex,
            request.Count,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            _apiKey.Id,
            includeTotalCount: request.IncludeTotalCount);

        return new VirtualisedWindow<Activity>(result.Results, result.TotalResults);
    }

    private void HandleRowClicked(Activity activity)
    {
        NavManager.NavigateTo($"/activity/{activity.Id}");
    }
}
