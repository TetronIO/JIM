@page "/admin/example-data/datasets"
@attribute [Authorize(Roles = "Administrator")]
@using System.Globalization
@using JIM.Models.ExampleData.DTOs
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@ExampleDataText.ExampleDataSets</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>@ExampleDataText.ExampleDataHeading</span> <span class="mud-primary-text">@ExampleDataText.DataSetsTitle</span>
    <PageInfo Title="@ExampleDataText.ExampleDataSets" DocsPage="configuration/example-data.md#example-data-sets">
        @ExampleDataText.DataSetListInfo
    </PageInfo>
</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

<SegmentedToggle TValue="string" Options="@SiblingPages.ExampleData" Value="@("datasets")"
                 AriaLabel="@ExampleDataText.TemplatesOrDataSets" Class="mt-3" />

@* ─── Data Sets ─── *@
@* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count) lives in the
   shared grid; this page loads the small configuration list once and windows it in memory. The page header
   already names the list, so there is no toolbar title and the count carries the nouns. *@
<VirtualisedDataGrid T="ExampleDataSetHeader"
                     ContainerId="example-data-set-list"
                     DefaultSortBy="name"
                     LoadWindow="LoadWindowAsync"
                     SingularName="@ExampleDataText.ExampleDataSet"
                     PluralName="@ExampleDataText.ExampleDataSets">
    <Columns>
        <TemplateColumn Title="@CommonText.ColumnName" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@CommonText.ColumnName" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                <MudLink Href="@("/admin/example-data/datasets/" + context.Item.Id)">@context.Item.Name</MudLink>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@ExampleDataText.BuiltIn" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@ExampleDataText.BuiltIn" Name="builtin" />
            </HeaderTemplate>
            <CellTemplate>
                @(context.Item.BuiltIn ? CommonText.Yes : CommonText.No)
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@ExampleDataText.CultureColumn" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@ExampleDataText.CultureColumn" Name="culture" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.Culture
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@ExampleDataText.Values" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@ExampleDataText.Values" Name="values" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.ValueCount.ToString("N0")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@CommonText.ColumnCreated" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@CommonText.ColumnCreated" Name="created" />
            </HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                    @context.Item.Created.ToLocalTime().ToRelativeTime()
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@string.Format(CultureInfo.CurrentCulture, ExampleDataText.NoDataSetsMatch, grid.SearchText)"
                             SecondaryText="@CommonText.TrySearchAgain"
                             ActionText="@CommonText.ClearSearch"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.Science"
                             PrimaryText="@ExampleDataText.NoDataSetsYet"
                             SecondaryText="@ExampleDataText.NoDataSetsYetHint" />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private List<ExampleDataSetHeader>? _datasets;
    private readonly List<BreadcrumbItem> _breadcrumbs = new List<BreadcrumbItem>
    {
        new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
        new(LayoutText.NavAdministration, href: "/admin"),
        new(ExampleDataText.ExampleData, href: "/admin/example-data/"),
        new(ExampleDataText.DataSetsTitle, href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _datasets = await jim.ExampleData.GetExampleDataSetHeadersAsync();
    }

    /// <summary>
    /// Windows the in-memory list for the grid: this is a small configuration list loaded whole on
    /// initialisation, so filtering and sorting happen here and the shared extension slices the window.
    /// </summary>
    private Task<VirtualisedWindow<ExampleDataSetHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        IEnumerable<ExampleDataSetHeader> datasets = _datasets ?? [];

        // Honour the grid's search against the same field the page's old search box filtered: the name.
        var searchText = request.SearchText;
        if (!string.IsNullOrWhiteSpace(searchText))
            datasets = datasets.Where(d => d.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));

        Func<ExampleDataSetHeader, object> sortKey = request.SortBy switch
        {
            "builtin" => d => d.BuiltIn,
            "culture" => d => d.Culture,
            "values" => d => d.ValueCount,
            "created" => d => d.Created,
            _ => d => d.Name
        };
        datasets = request.SortDescending ? datasets.OrderByDescending(sortKey) : datasets.OrderBy(sortKey);

        return Task.FromResult(datasets.ToWindow(request));
    }
}
