@* The SCIM requests behind one imported change (#124, D17): the resource's accepted writes that the import read.
   Shown in a change's details on a SCIM 2.0 Service Provider Connected System's objects. *@
<MudExpansionPanels Elevation="0" Class="mb-4">
    <MudExpansionPanel Text="@Title" Expanded="true">
        @if (!_loaded)
        {
            <MudSkeleton Height="48px" />
        }
        else if (_behind == null)
        {
            <MudText Class="mud-text-secondary">
                @ConnectedSystemText.ScimReqNoPoint
            </MudText>
        }
        else if (_behind.Entries.Count == 0)
        {
            <MudText Class="mud-text-secondary">@EmptyText</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Elevation="0" Hover="true">
                <thead>
                    <tr>
                        <th>@ConnectedSystemText.ScimReqColWhen</th>
                        <th>@ConnectedSystemText.ScimReqColRequest</th>
                        <th>@ConnectedSystemText.ScimReqColAttributes</th>
                        <th>@ConnectedSystemText.ScimReqColKey</th>
                        <th>@ConnectedSystemText.ScimReqColFrom</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _behind.Entries)
                    {
                        var occurred = entry.Occurred.ToLocalTime();
                        <tr @key="entry.Id">
                            <td>
                                <MudTooltip Text="@occurred.ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                                    @occurred.ToRelativeTime()
                                </MudTooltip>
                            </td>
                            <td>@entry.Operation.ForDisplay()</td>
                            <td>
                                @if (entry.ChangedAttributes.Count == 0 && entry.IgnoredAttributes.Count == 0)
                                {
                                    <EmptyValue />
                                }
                                else
                                {
                                    <span class="jim-text-code">@string.Join(", ", entry.ChangedAttributes)</span>
                                    @if (entry.IgnoredAttributes.Count > 0)
                                    {
                                        <MudTooltip Text="@ConnectedSystemText.ScimReqIgnoredTooltip"
                                                    Arrow="true" Placement="Placement.Top">
                                            <span class="mud-text-secondary ml-2">@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.ScimReqIgnored, string.Join(", ", entry.IgnoredAttributes))</span>
                                        </MudTooltip>
                                    }
                                }
                            </td>
                            <td>@(entry.ApiKeyName ?? ConnectedSystemText.ScimReqDeletedKey)</td>
                            <td>
                                @if (string.IsNullOrEmpty(entry.ClientAddress))
                                {
                                    <EmptyValue />
                                }
                                else
                                {
                                    <span class="jim-text-code">@entry.ClientAddress</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    /// <summary>
    /// The Connected System Object change to show the requests behind.
    /// </summary>
    [Parameter, EditorRequired]
    public Guid ChangeId { get; set; }

    private ScimRequestsBehindChange? _behind;
    private bool _loaded;
    private Guid? _loadedFor;

    private string Title => _behind is { Entries.Count: > 0 } behind
        ? string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.ScimReqTitleCount, behind.Entries.Count.ToString("N0", System.Globalization.CultureInfo.CurrentCulture))
        : ConnectedSystemText.ScimReqTitle;

    /// <summary>
    /// Why no requests are listed, naming what the import read so an administrator can tell an import that read
    /// nothing new from requests whose history has been cleared.
    /// </summary>
    private string EmptyText => _behind switch
    {
        { AfterSequence: { } after } behind when after >= behind.UpToSequence =>
            string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.ScimReqNoNew, after.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)),
        { AfterSequence: { } after } behind =>
            string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.ScimReqRangeCleared, (after + 1).ToString("N0", System.Globalization.CultureInfo.CurrentCulture), behind.UpToSequence.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)),
        { } behind =>
            string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.ScimReqUpToCleared, behind.UpToSequence.ToString("N0", System.Globalization.CultureInfo.CurrentCulture)),
        _ => string.Empty
    };

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ChangeId)
            return;
        _loadedFor = ChangeId;
        _loaded = false;

        using var jim = JimFactory.Create();
        _behind = await jim.Scim.GetRequestsBehindChangeAsync(ChangeId);
        _loaded = true;
    }
}
