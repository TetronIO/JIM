@* The causality attribute change detail: count-annotated operation filter chips (All/Set/Add/Remove) in the
   toolbar of a virtualised grid of attribute rows (operation badge, name with demoted type and plurality, value
   with the previous value struck through where applicable). Filtering is pure C# over the supplied rows; the
   filter state lives in this component and resets whenever it is recreated (e.g. a Timeline expander reopening).

   The rows are handed to this component whole, so a window is sliced from them in memory rather than read from
   the database. The search box, the count and the density toggle are the shared grid's; the bespoke filter input
   and "n of m" indicator this component used to carry are gone with them, so that every table in the portal
   narrows and counts itself the same way. *@

<VirtualisedDataGrid @ref="_grid" T="CausalityAttributeRow"
                     ContainerId="@($"causality-attributes-{_instanceId}")"
                     Embedded="true"
                     DefaultSortBy="@SourceOrderSort"
                     LoadWindow="LoadRowWindowAsync"
                     SearchPlaceholder="Filter attributes..."
                     SingularName="Attribute"
                     PluralName="Attributes">
    <ToolBarExtras>
        @if (ShowOperations)
        {
            <div class="filter-chips" role="group" aria-label="Filter by operation">
                <button type="button" class="@(_operationFilter == null ? "on" : null)"
                        aria-pressed="@(_operationFilter == null ? "true" : "false")"
                        @onclick="() => SetOperationFilterAsync(null)">All</button>
                @foreach (var (operation, count) in GetOperationCounts())
                {
                    <button type="button" class="@(_operationFilter == operation ? "on" : null)"
                            aria-pressed="@(_operationFilter == operation ? "true" : "false")"
                            @onclick="() => SetOperationFilterAsync(operation)">@operation · @count</button>
                }
            </div>
        }
    </ToolBarExtras>
    <Columns>
        @if (ShowOperations)
        {
            <TemplateColumn Title="Change" Sortable="false" HeaderClass="attr-col-shrink" CellClass="attr-col-shrink">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="Change" Name="change" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudChip T="string" Variant="Variant.Text" Color="@GetOperationColor(context.Item.Operation)" Class="ml-0">
                        @context.Item.Operation
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
        }
        <TemplateColumn Title="Attribute" Sortable="false" HeaderClass="attr-col-shrink" CellClass="attr-col-shrink">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Attribute" Name="attribute" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.Name
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@context.Item.TypeAndPlurality</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Value" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Value" Name="value" />
            </HeaderTemplate>
            <CellTemplate>
                @if (!string.IsNullOrEmpty(context.Item.PreviousValue))
                {
                    <span class="mud-text-secondary attr-previous-value">@context.Item.PreviousValue</span>
                }
                <TextValueDisplay Value="@context.Item.Value" />
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No attributes match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the filters."
                             ActionText="Clear Filters"
                             OnAction="@(() => ClearFiltersAsync(grid))" />
        }
        else if (_operationFilter.HasValue)
        {
            var operation = _operationFilter.Value;
            <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                             PrimaryText="@($"No attributes were {operation.ToString().ToLowerInvariant()}")"
                             SecondaryText="Choose All to see every attribute this event touched."
                             ActionText="Clear Filters"
                             OnAction="@(() => ClearFiltersAsync(grid))" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.List"
                             PrimaryText="This event carries no attribute values"
                             SecondaryText="Attribute values appear here when a change writes them, or when a Pending Export carries the values identifying its target." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    /// <summary>
    /// The normalised attribute change rows to display.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<CausalityAttributeRow> Rows { get; set; } = [];

    /// <summary>
    /// Whether the rows are attribute *changes*, and so carry a meaningful operation. Set false where they
    /// are values that identify an object rather than values being written to it: a queued deprovision
    /// carries the target's distinguished name so the Connector can find the entry, and reporting that as
    /// "Set" is the same claim the event's "Target identified by" caption exists to correct. The values
    /// themselves are always shown; only the operation column and its filter chips are suppressed.
    /// </summary>
    [Parameter]
    public bool ShowOperations { get; set; } = true;

    /// <summary>
    /// The sort key standing for "the order the rows were built in", which is the order that tells the story of
    /// the change; no header claims it, so the grid opens showing no sort arrow and reorders only when asked.
    /// </summary>
    private const string SourceOrderSort = "order";

    /// <summary>
    /// Distinguishes this instance's grid from its siblings'. The Timeline view renders one of these per event,
    /// so the grid's element id and URL parameters cannot be a constant without every instance sharing them.
    /// </summary>
    private static int _instanceCounter;

    private readonly string _instanceId =
        Interlocked.Increment(ref _instanceCounter).ToString(CultureInfo.InvariantCulture);

    private VirtualisedDataGrid<CausalityAttributeRow>? _grid;
    private CausalityAttributeOperation? _operationFilter;

    /// <summary>
    /// Slices one window from the rows this component was handed, applying the operation chip, the grid's search
    /// (attribute name or value) and the grid's sort. Nothing is read from the database: the whole set is already
    /// here, and it is one event's worth of attributes.
    /// </summary>
    private Task<VirtualisedWindow<CausalityAttributeRow>> LoadRowWindowAsync(
        VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<CausalityAttributeRow> rows = Rows;

        if (_operationFilter is { } operation)
            rows = rows.Where(r => r.Operation == operation);

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText.Trim();
            rows = rows.Where(r =>
                r.Name.Contains(search, StringComparison.OrdinalIgnoreCase)
                || (r.Value?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false));
        }

        IOrderedEnumerable<CausalityAttributeRow> Order<TKey>(Func<CausalityAttributeRow, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? rows.OrderByDescending(key, comparer) : rows.OrderBy(key, comparer);

        IEnumerable<CausalityAttributeRow> sorted = request.SortBy switch
        {
            "change" => Order(r => r.Operation).ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase),
            "attribute" => Order(r => r.Name, StringComparer.OrdinalIgnoreCase),
            "value" => Order(r => r.Value ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            // The order the rows were built in: the sequence that reads as the story of the change.
            _ => rows
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    /// <summary>
    /// The operations present in the rows, with how many rows each accounts for. Counted over every row rather
    /// than the filtered set, so the chips keep saying what choosing them would show.
    /// </summary>
    private List<(CausalityAttributeOperation Operation, int Count)> GetOperationCounts()
    {
        return new[] { CausalityAttributeOperation.Set, CausalityAttributeOperation.Add, CausalityAttributeOperation.Remove }
            .Select(operation => (Operation: operation, Count: Rows.Count(r => r.Operation == operation)))
            .Where(entry => entry.Count > 0)
            .ToList();
    }

    /// <summary>
    /// Applies an operation chip. The chip changes which rows match, so the grid must re-count as well as reload,
    /// and the reader's scroll position describes a set that no longer exists.
    /// </summary>
    private async Task SetOperationFilterAsync(CausalityAttributeOperation? operation)
    {
        _operationFilter = operation;

        if (_grid == null)
            return;

        await _grid.ResetScrollAsync();
        await _grid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// The way out offered by the empty states: drops the operation chip and the search together, since either
    /// can be what emptied the table and the reader should not have to work out which.
    /// </summary>
    private async Task ClearFiltersAsync(VirtualisedDataGrid<CausalityAttributeRow> grid)
    {
        _operationFilter = null;
        await grid.ClearSearchAsync();
        await grid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Chip colour per operation: Set is neutral (Info), Add and Remove are visually distinct
    /// (Success/Error) to preserve the semantics the previous bespoke CSS conveyed.
    /// </summary>
    private static Color GetOperationColor(CausalityAttributeOperation operation)
    {
        return operation switch
        {
            CausalityAttributeOperation.Add => Color.Success,
            CausalityAttributeOperation.Remove => Color.Error,
            _ => Color.Info
        };
    }
}
