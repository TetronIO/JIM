@* Who did something, resolved so a person links to their Metaverse Object under its own Object Type, and drawn by
   <InitiatorChip /> so it reads the same as an Activity's initiator everywhere else (#2066). *@
<InitiatorChip InitiatedByType="@PrincipalType"
                   InitiatedById="@PrincipalId"
                   InitiatedByName="@PrincipalName"
                   UserHref="@_mvoHref"
                   UserLookedUp="@(PrincipalType == ActivityInitiatorType.User)"
                   ScheduleName="@ScheduleName"
                   ScheduleExecutionId="@ScheduleExecutionId" />

@code {
    [Parameter] public ActivityInitiatorType PrincipalType { get; set; }
    [Parameter] public Guid? PrincipalId { get; set; }
    [Parameter] public string? PrincipalName { get; set; }

    /// <summary>The Schedule that produced the work, as named when it was recorded; null when none did.</summary>
    [Parameter] public string? ScheduleName { get; set; }

    /// <summary>The Schedule Execution that produced the work, which the Schedule's name links to.</summary>
    [Parameter] public Guid? ScheduleExecutionId { get; set; }

    private string? _mvoHref;

    protected override async Task OnParametersSetAsync()
    {
        _mvoHref = null;

        if (PrincipalType == ActivityInitiatorType.User && PrincipalId.HasValue)
        {
            using var jim = JimFactory.Create();
            var mvo = await jim.Metaverse.GetMetaverseObjectAsync(PrincipalId.Value);
            if (mvo?.Type != null)
            {
                _mvoHref = Utilities.GetMetaverseObjectHref(mvo.Id, mvo.Type.PluralName);
            }
        }
    }
}
