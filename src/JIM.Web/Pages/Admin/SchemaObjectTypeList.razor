<PageTitle>@AdminText.SchemaPageTitle</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Schema" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>@AdminText.SchemaHeading</span> <span class="mud-primary-text">@TabTitle</span>
    <PageInfo Title="@AdminText.SchemaPageTitle" DocsPage="configuration/metaverse.md" Term="Term.Metaverse">
        @AdminText.SchemaPageInfo
    </PageInfo>
</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

@* Each tab's blocks sit in a <SectionStack>, so the tab bar to the first block is one section gap (pt-6) and every
   gap below it is the stack's (engineering/DESIGN.md > Layout > Spacing, #3095). *@
<NavigableMudTabs @bind-ActivePanelIndex="_activeTabIndex" TabPanelsClass="pt-6" Class="mt-2">
    <MudTabPanel Text="@AdminText.SchemaTabObjectTypes" Icon="@Icons.Material.Filled.Category">
        <SectionStack>
        @* Same shared grid as the Attributes tab, but windowed in memory: Object Types are a small configuration
           list, loaded whole once, so search and sort are applied in the page rather than each becoming a
           database range read. The URL parameters are prefixed so this grid's state cannot collide with the
           Attributes grid's (unprefixed) q/sort/desc/row on the shared page URL. The tab already says "Object
           Types", so there is no toolbar title and the count carries the nouns. *@
        @* ─── Filters ─── *@
        @if (_metaverseObjectTypeHeaders is { Count: > 0 })
        {
            <MudStack Row="true" Spacing="3" Class="flex-wrap" AlignItems="AlignItems.End">
                <MudItem Class="flex-grow-1">
                    <MudSelect T="MetaverseObjectDeletionRule?" Label="@AdminText.SchemaDeletionRule" Variant="Variant.Outlined"
                               Dense="true" Clearable="true" Value="_deletionRuleFilter" ValueChanged="OnDeletionRuleFilterChangedAsync">
                        <MudSelectItem T="MetaverseObjectDeletionRule?" Value="MetaverseObjectDeletionRule.Manual">@AdminText.SchemaDeletionRuleManual</MudSelectItem>
                        <MudSelectItem T="MetaverseObjectDeletionRule?" Value="MetaverseObjectDeletionRule.WhenLastConnectorDisconnected">@AdminText.SchemaDeletionRuleAuto</MudSelectItem>
                        <MudSelectItem T="MetaverseObjectDeletionRule?" Value="MetaverseObjectDeletionRule.WhenAuthoritativeSourceDisconnected">@AdminText.SchemaDeletionRuleAuthoritativeSource</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem Class="flex-grow-1">
                    <MudSelect T="bool?" Label="@AdminText.SchemaPredefinedSearches" Variant="Variant.Outlined"
                               Dense="true" Clearable="true" Value="_predefinedSearchesFilter" ValueChanged="OnPredefinedSearchesFilterChangedAsync">
                        <MudSelectItem T="bool?" Value="true">@CommonText.Yes</MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">@CommonText.No</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem Class="flex-grow-1">
                    <MudSelect T="bool?" Label="@AdminText.SchemaBuiltIn" Variant="Variant.Outlined"
                               Dense="true" Clearable="true" Value="_objectTypeBuiltInFilter" ValueChanged="OnObjectTypeBuiltInFilterChangedAsync">
                        <MudSelectItem T="bool?" Value="true">@CommonText.Yes</MudSelectItem>
                        <MudSelectItem T="bool?" Value="false">@CommonText.No</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudStack>
        }
        <VirtualisedDataGrid @ref="_objectTypeGrid" T="MetaverseObjectTypeHeader"
                             ContainerId="metaverse-object-type-list"
                             UrlParameterPrefix="ot-"
                             DefaultSortBy="name"
                             LoadWindow="LoadObjectTypeWindowAsync"
                             SingularName="@AdminText.SchemaNounObjectTypeSingular"
                             PluralName="@AdminText.SchemaNounObjectTypePlural"
                             SearchPlaceholder="@AdminText.SchemaSearchByName">
            <ToolBarExtras>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           DropShadow="false" OnClick="OpenCreateObjectTypeDialogAsync">@AdminText.SchemaNewObjectType</MudButton>
            </ToolBarExtras>
            <Columns>
                <TemplateColumn Title="@CommonText.ColumnName" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@CommonText.ColumnName" Name="name" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudIcon Icon="@Helpers.ResolveObjectTypeIcon(context.Item.Icon)" Class="mr-1" Style="vertical-align: middle;" />
                        <MudLink Href="@("/admin/schema/object-types/"+context.Item.Id)">@context.Item.Name</MudLink>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@AdminText.SchemaTabAttributes" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@AdminText.SchemaTabAttributes" Name="attributes" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.AttributesCount
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@AdminText.SchemaDeletionRule" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@AdminText.SchemaDeletionRule" Name="deletionrule" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @{
                            var (label, color, icon) = GetDeletionRuleDisplay(context.Item.DeletionRule);
                        }
                        <MudTooltip Text="@GetDeletionRuleTooltip(context.Item)" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Variant="Variant.Text" Color="@color" Icon="@icon">@label</MudChip>
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@AdminText.SchemaPredefinedSearches" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@AdminText.SchemaPredefinedSearches" Name="predefinedsearches" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @(context.Item.HasPredefinedSearches ? CommonText.Yes : CommonText.No)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@AdminText.SchemaBuiltIn" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@AdminText.SchemaBuiltIn" Name="builtin" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @(context.Item.BuiltIn ? CommonText.Yes : CommonText.No)
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@CommonText.ColumnCreated" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@CommonText.ColumnCreated" Name="created" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                            @context.Item.Created.ToLocalTime().ToRelativeTime()
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Sortable="false">
                    <HeaderTemplate></HeaderTemplate>
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            @if (!context.Item.BuiltIn)
                            {
                                <MudTooltip Text="@AdminText.SchemaEditObjectType" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => OpenEditObjectTypeDialogAsync(context.Item))" />
                                </MudTooltip>
                                <MudTooltip Text="@AdminText.SchemaDeleteObjectType" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => OpenDeleteObjectTypeDialogAsync(context.Item))" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="@AdminText.SchemaBuiltInObjectTypeLocked" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Disabled="true" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="@AdminText.SchemaChangeHistory" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.History" Size="Size.Small" OnClick="@(() => ShowObjectTypeHistoryDialogAsync(context.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@string.Format(CultureInfo.CurrentCulture, AdminText.SchemaNoObjectTypesMatchSearch, grid.SearchText)"
                                     SecondaryText="@CommonText.TrySearchAgain"
                                     ActionText="@CommonText.ClearSearch"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else if (IsObjectTypeFilterActive)
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                                     PrimaryText="@AdminText.SchemaNoObjectTypesMatchFilters"
                                     SecondaryText="@AdminText.SchemaTryDifferentFilters"
                                     ActionText="@AdminText.SchemaClearFilters"
                                     OnAction="@(() => ClearObjectTypeFiltersAsync())" />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.Category"
                                     PrimaryText="@AdminText.SchemaNoObjectTypesYet"
                                     SecondaryText="@AdminText.SchemaUseNewObjectTypeButton" />
                }
            </EmptyContent>
        </VirtualisedDataGrid>
        </SectionStack>
    </MudTabPanel>
    <MudTabPanel Text="@AdminText.SchemaTabAttributes" Icon="@Icons.Material.Filled.ListAlt">
        <SectionStack>
        @* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count) lives in the
           shared grid; this tab supplies the columns, the window loader and the empty states. The tab itself already
           says "Attributes", so there is no toolbar title and the count carries the nouns. *@
        @* ─── Filters ─── *@
        <MudStack Row="true" Spacing="3" Class="flex-wrap" AlignItems="AlignItems.End">
            <MudItem Class="flex-grow-1">
                <MudSelect T="AttributeDataType?" Label="@CommonText.ColumnType" Variant="Variant.Outlined"
                           Dense="true" Clearable="true" Value="_attributeTypeFilter" ValueChanged="OnAttributeTypeFilterChangedAsync">
                    @foreach (var type in Enum.GetValues<AttributeDataType>().Where(t => t != AttributeDataType.NotSet))
                    {
                        <MudSelectItem T="AttributeDataType?" Value="@type">@type.ForDisplay()</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem Class="flex-grow-1">
                <MudSelect T="AttributePlurality?" Label="@AdminText.SchemaPlurality" Variant="Variant.Outlined"
                           Dense="true" Clearable="true" Value="_attributePluralityFilter" ValueChanged="OnAttributePluralityFilterChangedAsync">
                    <MudSelectItem T="AttributePlurality?" Value="AttributePlurality.SingleValued">@AdminText.SchemaSingleValued</MudSelectItem>
                    <MudSelectItem T="AttributePlurality?" Value="AttributePlurality.MultiValued">@AdminText.SchemaMultiValued</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem Class="flex-grow-1">
                <MudSelect T="bool?" Label="@AdminText.SchemaBuiltIn" Variant="Variant.Outlined"
                           Dense="true" Clearable="true" Value="_attributeBuiltInFilter" ValueChanged="OnAttributeBuiltInFilterChangedAsync">
                    <MudSelectItem T="bool?" Value="true">@CommonText.Yes</MudSelectItem>
                    <MudSelectItem T="bool?" Value="false">@CommonText.No</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem Class="flex-grow-1">
                <MudSelect T="int?" Label="@AdminText.SchemaObjectTypeFilter" Variant="Variant.Outlined"
                           Dense="true" Clearable="true" Value="_attributeObjectTypeFilter" ValueChanged="OnAttributeObjectTypeFilterChangedAsync">
                    @if (_metaverseObjectTypeHeaders != null)
                    {
                        @foreach (var objectType in _metaverseObjectTypeHeaders)
                        {
                            <MudSelectItem T="int?" Value="@objectType.Id">@objectType.Name</MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
        </MudStack>
        <VirtualisedDataGrid @ref="_attributeGrid" T="MetaverseAttributeHeader"
                             ContainerId="metaverse-attribute-list"
                             DefaultSortBy="name"
                             LoadWindow="LoadAttributeWindowAsync"
                             SingularName="@AdminText.SchemaNounAttributeSingular"
                             PluralName="@AdminText.SchemaNounAttributePlural"
                             SearchPlaceholder="@CommonText.Search">
            <ToolBarExtras>
                <MudButton StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" Variant="Variant.Filled"
                           DropShadow="false" OnClick="OpenCreateAttributeDialogAsync">@AdminText.SchemaNewAttribute</MudButton>
            </ToolBarExtras>
            <Columns>
                <TemplateColumn Title="@CommonText.ColumnName" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@CommonText.ColumnName" Name="name" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.Name
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@CommonText.ColumnType" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@CommonText.ColumnType" Name="type" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudChip T="string" Color="@Helpers.GetAttributeTypeChipColour(context.Item.Type)" Variant="Variant.Outlined">
                            @context.Item.Type.ForDisplay()
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@AdminText.SchemaPlurality" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@AdminText.SchemaPlurality" Name="plurality" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudChip T="string" Color="@Helpers.GetAttributePluralityChipColour(context.Item.AttributePlurality)" Variant="Variant.Text">
                            @(context.Item.AttributePlurality == AttributePlurality.SingleValued ? AdminText.SchemaSingleValued : AdminText.SchemaMultiValued)
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@AdminText.SchemaBuiltIn" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@AdminText.SchemaBuiltIn" Name="builtin" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.BuiltIn)
                        {
                            <MudTooltip Text="@AdminText.SchemaBuiltInAttribute" Arrow="true" Placement="Placement.Top">
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Class="mud-text-secondary" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.SchemaCustom</MudText>
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@CommonText.ColumnCreated" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="@CommonText.ColumnCreated" Name="created" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                            @context.Item.Created.ToLocalTime().ToRelativeTime()
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="@AdminText.SchemaObjectTypes" Sortable="false">
                    <HeaderTemplate>
                        <MudText Typo="Typo.button">@AdminText.SchemaObjectTypes</MudText>
                    </HeaderTemplate>
                    <CellTemplate>
                        @* A row in a virtualised grid is one line, so a chip per bound Object Type is a row that
                           grows with the attribute's bindings; up to four are shown and the rest open in a dialog,
                           which draws them with the same linked chips rather than flattening them to names. *@
                        @{
                            var boundTypes = context.Item.MetaverseObjectTypes?.ToList() ?? new List<KeyValuePair<int, string>>();
                        }
                        <OverflowList TItem="KeyValuePair<int, string>" Items="@boundTypes" Title="@AdminText.SchemaObjectTypes" MaxVisible="4">
                            <ItemTemplate Context="stub">
                                <MudChip T="string" Color="@_objectTypeChipColors.GetColor(stub.Value)" Variant="Variant.Filled"
                                         Href="@($"/admin/schema/object-types/{stub.Key}")">@stub.Value</MudChip>
                            </ItemTemplate>
                            <EmptyContent>
                                <MudTooltip Text="@AdminText.SchemaNotAssignedTooltip" Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.RemoveCircleOutline">@AdminText.SchemaNotAssigned</MudChip>
                                </MudTooltip>
                            </EmptyContent>
                        </OverflowList>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Sortable="false">
                    <HeaderTemplate></HeaderTemplate>
                    <CellTemplate>
                        <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                            @if (!context.Item.BuiltIn)
                            {
                                <MudTooltip Text="@AdminText.SchemaEditAttribute" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => OpenEditAttributeDialogAsync(context.Item))" />
                                </MudTooltip>
                                <MudTooltip Text="@AdminText.SchemaDeleteAttribute" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" OnClick="@(() => OpenDeleteAttributeDialogAsync(context.Item))" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="@AdminText.SchemaViewAttributeAndMappings" Arrow="true" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" OnClick="@(() => OpenViewAttributeDialogAsync(context.Item))" />
                                </MudTooltip>
                            }
                            <MudTooltip Text="@AdminText.SchemaChangeHistory" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.History" Size="Size.Small" OnClick="@(() => ShowAttributeHistoryDialogAsync(context.Item))" />
                            </MudTooltip>
                        </MudStack>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@string.Format(CultureInfo.CurrentCulture, AdminText.SchemaNoAttributesMatchSearch, grid.SearchText)"
                                     SecondaryText="@CommonText.TrySearchAgain"
                                     ActionText="@CommonText.ClearSearch"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else if (IsAttributeFilterActive)
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                                     PrimaryText="@AdminText.SchemaNoAttributesMatchFilters"
                                     SecondaryText="@AdminText.SchemaTryDifferentFilters"
                                     ActionText="@AdminText.SchemaClearFilters"
                                     OnAction="@(() => ClearAttributeFiltersAsync())" />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.ListAlt"
                                     PrimaryText="@AdminText.SchemaNoAttributesYet"
                                     SecondaryText="@AdminText.SchemaUseNewAttributeButton" />
                }
            </EmptyContent>
        </VirtualisedDataGrid>
        </SectionStack>
    </MudTabPanel>
    <MudTabPanel Text="@AdminText.SchemaTabDataFlow" Icon="@Icons.Material.Filled.SwapHoriz">
        <DataFlowTab />
    </MudTabPanel>
</NavigableMudTabs>

@code {
    private int _activeTabIndex;

    /// <summary>
    /// The active tab's name, appended to the page heading. Indexed rather than switched on a slug because the
    /// tab strip is the source of truth for the order.
    /// </summary>
    private string TabTitle => _activeTabIndex switch
    {
        0 => AdminText.SchemaTabObjectTypes,
        1 => AdminText.SchemaTabAttributes,
        _ => AdminText.SchemaTabDataFlow
    };
    private IList<MetaverseObjectTypeHeader>? _metaverseObjectTypeHeaders;
    private VirtualisedDataGrid<MetaverseObjectTypeHeader>? _objectTypeGrid;
    private VirtualisedDataGrid<MetaverseAttributeHeader>? _attributeGrid;
    private readonly TypeChipColorAssigner _objectTypeChipColors = new();

    private MetaverseObjectDeletionRule? _deletionRuleFilter;
    private bool? _predefinedSearchesFilter;
    private bool? _objectTypeBuiltInFilter;
    private bool IsObjectTypeFilterActive =>
        _deletionRuleFilter.HasValue || _predefinedSearchesFilter.HasValue || _objectTypeBuiltInFilter.HasValue;

    private AttributeDataType? _attributeTypeFilter;
    private AttributePlurality? _attributePluralityFilter;
    private bool? _attributeBuiltInFilter;
    private int? _attributeObjectTypeFilter;
    private bool IsAttributeFilterActive =>
        _attributeTypeFilter.HasValue || _attributePluralityFilter.HasValue || _attributeBuiltInFilter.HasValue || _attributeObjectTypeFilter.HasValue;

    private readonly List<BreadcrumbItem> _breadcrumbs = new List<BreadcrumbItem>
    {
        new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
        new(LayoutText.NavAdministration, href: "/admin"),
        new(AdminText.SchemaPageTitle, href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        // The /admin/schema/attributes route predates the tabs' ?t= slug sync and never actually selected the
        // Attributes tab: it rendered the page on its first tab, silently. Normalise it onto the slug mechanism
        // (preserving any other query parameters, such as the attribute grid's own state) so the deep link lands
        // where its name promises.
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (uri.AbsolutePath.EndsWith("/attributes", StringComparison.OrdinalIgnoreCase))
        {
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            query["t"] = "attributes";
            NavigationManager.NavigateTo($"/admin/schema?{query}", replace: true);
            return;
        }

        using var jim = JimFactory.Create();
        _metaverseObjectTypeHeaders = await jim.Metaverse.GetMetaverseObjectTypeHeadersAsync();
    }

    /// <summary>
    /// Windows the in-memory Object Type list for the grid: Metaverse Object Types are a small configuration
    /// list, loaded whole once, so search and sort are applied here rather than each becoming a database range
    /// read (unlike the Attributes tab, whose list is large enough to earn a server-side range read).
    /// </summary>
    private Task<VirtualisedWindow<MetaverseObjectTypeHeader>> LoadObjectTypeWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        var headers = _metaverseObjectTypeHeaders ?? new List<MetaverseObjectTypeHeader>();

        var filtered = headers.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(request.SearchText))
            filtered = filtered.Where(x => x.Name.Contains(request.SearchText, StringComparison.OrdinalIgnoreCase));
        // Each filter's value is copied to a local before the lambda closes over it. Nullable flow analysis does
        // not cross a lambda boundary, so CodeQL reads `_x.Value` inside one as an unguarded dereference however
        // airtight the HasValue above it is (the rule is in src/CLAUDE.md). It is also the more correct shape:
        // Where() defers, so a lambda closing over the field would read whatever the field holds at enumeration
        // rather than what it held when the filter was chosen.
        if (_deletionRuleFilter.HasValue)
        {
            var deletionRule = _deletionRuleFilter.Value;
            filtered = filtered.Where(x => x.DeletionRule == deletionRule);
        }
        if (_predefinedSearchesFilter.HasValue)
        {
            var hasPredefinedSearches = _predefinedSearchesFilter.Value;
            filtered = filtered.Where(x => x.HasPredefinedSearches == hasPredefinedSearches);
        }
        if (_objectTypeBuiltInFilter.HasValue)
        {
            var builtIn = _objectTypeBuiltInFilter.Value;
            filtered = filtered.Where(x => x.BuiltIn == builtIn);
        }

        Func<MetaverseObjectTypeHeader, object> sortKey = request.SortBy switch
        {
            "attributes" => x => x.AttributesCount,
            "deletionrule" => x => x.DeletionRule,
            "predefinedsearches" => x => x.HasPredefinedSearches,
            "builtin" => x => x.BuiltIn,
            "created" => x => x.Created,
            _ => x => x.Name
        };

        var sorted = request.SortDescending
            ? filtered.OrderByDescending(sortKey)
            : filtered.OrderBy(sortKey);

        return Task.FromResult(sorted.ToWindow(request));
    }

    private async Task<VirtualisedWindow<MetaverseAttributeHeader>> LoadAttributeWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        using var jim = JimFactory.Create();
        var result = await jim.Metaverse.GetMetaverseAttributeHeadersRangeAsync(
            request.StartIndex,
            request.Count,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            typeFilter: _attributeTypeFilter,
            pluralityFilter: _attributePluralityFilter,
            builtInFilter: _attributeBuiltInFilter,
            objectTypeId: _attributeObjectTypeFilter,
            includeTotalCount: request.IncludeTotalCount);

        return new VirtualisedWindow<MetaverseAttributeHeader>(result.Results, result.TotalResults);
    }

    private async Task OnDeletionRuleFilterChangedAsync(MetaverseObjectDeletionRule? value)
    {
        _deletionRuleFilter = value;
        await RefreshObjectTypeGridAfterFilterChangeAsync();
    }

    private async Task OnPredefinedSearchesFilterChangedAsync(bool? value)
    {
        _predefinedSearchesFilter = value;
        await RefreshObjectTypeGridAfterFilterChangeAsync();
    }

    private async Task OnObjectTypeBuiltInFilterChangedAsync(bool? value)
    {
        _objectTypeBuiltInFilter = value;
        await RefreshObjectTypeGridAfterFilterChangeAsync();
    }

    private async Task ClearObjectTypeFiltersAsync()
    {
        _deletionRuleFilter = null;
        _predefinedSearchesFilter = null;
        _objectTypeBuiltInFilter = null;
        await RefreshObjectTypeGridAfterFilterChangeAsync();
    }

    private async Task RefreshObjectTypeGridAfterFilterChangeAsync()
    {
        if (_objectTypeGrid == null)
            return;

        await _objectTypeGrid.ResetScrollAsync();
        await _objectTypeGrid.RefreshAsync(invalidateTotals: true);
    }

    private async Task OnAttributeTypeFilterChangedAsync(AttributeDataType? value)
    {
        _attributeTypeFilter = value;
        await RefreshAttributeGridAfterFilterChangeAsync();
    }

    private async Task OnAttributePluralityFilterChangedAsync(AttributePlurality? value)
    {
        _attributePluralityFilter = value;
        await RefreshAttributeGridAfterFilterChangeAsync();
    }

    private async Task OnAttributeBuiltInFilterChangedAsync(bool? value)
    {
        _attributeBuiltInFilter = value;
        await RefreshAttributeGridAfterFilterChangeAsync();
    }

    private async Task OnAttributeObjectTypeFilterChangedAsync(int? value)
    {
        _attributeObjectTypeFilter = value;
        await RefreshAttributeGridAfterFilterChangeAsync();
    }

    private async Task ClearAttributeFiltersAsync()
    {
        _attributeTypeFilter = null;
        _attributePluralityFilter = null;
        _attributeBuiltInFilter = null;
        _attributeObjectTypeFilter = null;
        await RefreshAttributeGridAfterFilterChangeAsync();
    }

    private async Task RefreshAttributeGridAfterFilterChangeAsync()
    {
        if (_attributeGrid == null)
            return;

        await _attributeGrid.ResetScrollAsync();
        await _attributeGrid.RefreshAsync(invalidateTotals: true);
    }

