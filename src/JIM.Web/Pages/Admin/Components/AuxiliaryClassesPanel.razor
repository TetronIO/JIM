@* Merging auxiliary classes only means something where JIM computes class membership, and an auxiliary class
   cannot itself be extended. Active Directory resolves its own auxiliary classes into each structural class, so
   it never reaches here. *@
@if (ObjectType.ManagesClassMembership() && !ObjectType.IsAuxiliary())
{
    @* mt-5 rather than the mt-6 in JIM.Web/CLAUDE.md: this panel sits between the Object Type's existing panels,
       which are all mt-5, and one panel out of rhythm reads as a mistake. *@
    <MudPaper Outlined="true" Class="pa-4 mt-5">
        <div class="d-flex align-center">
            <MudText Typo="Typo.h6">@SchemaText.AuxHeading</MudText>
            <InfoPopover Title="@SchemaText.AuxHeading">
                @SchemaText.AuxPanelInfo
                
                
            </InfoPopover>
        </div>

        @if (_offers.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">
                @string.Format(CultureInfo.CurrentCulture, SchemaText.AuxPanelNoneDefined, ConnectedSystem.Name)
            </MudAlert>
        }
        else
        {
            @* The composition, as one line: what the Object Type is, what is merged into it, and how to add more.
               The schema's other auxiliary classes are in the dialog, not listed here; on a real directory that
               list runs to eighty rows and buried Attribute Selection beneath it. *@
            <div class="d-flex align-center flex-wrap gap-2 mt-3" data-testid="jim-aux-composition">
                <span class="mud-text-secondary">@SchemaText.AuxMadeOf</span>
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">@ObjectType.Name</MudChip>
                @foreach (var offer in _offers.Where(offer => offer.Merged))
                {
                    <span class="mud-text-secondary">+</span>
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" @key="offer.ObjectType.Id"
                             OnClose="@(() => HandleMergeChangedAsync(offer, false))"
                             Disabled="_saving"
                             data-testid="jim-aux-merged">
                        @offer.ObjectType.Name
                    </MudChip>
                }
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Add"
                           Disabled="_saving" OnClick="OpenDialogAsync" data-testid="jim-aux-add">
                    @SchemaText.AuxAddClass
                </MudButton>
                <span class="mud-text-secondary ms-auto">
                    @string.Format(CultureInfo.CurrentCulture, SchemaText.AuxMergedCount, string.Format(CultureInfo.CurrentCulture, "{0:N0}", _offers.Count(offer => offer.Merged)), string.Format(CultureInfo.CurrentCulture, "{0:N0}", _offers.Count))
                </span>
            </div>

            @* ─── Discovery status ─── *@
            <div class="d-flex align-center flex-wrap gap-2 mt-3">
                @if (LatestDiscoveryRun == null)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@string.Format(CultureInfo.CurrentCulture, SchemaText.AuxPanelNotYetRead, ConnectedSystem.Name)</MudText>
                }
                else
                {
                    var latestRun = LatestDiscoveryRun;
                    <MudChip T="string" Color="@StatusColour(latestRun.Status)" Variant="Variant.Outlined">
                        @StatusText(latestRun.Status)
                    </MudChip>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@DescribeRun(latestRun)</MudText>
                    @if (latestRun.ActivityId.HasValue)
                    {
                        var activityId = latestRun.ActivityId.Value;
                        <MudLink Href="@($"/activity/{activityId}")" Typo="Typo.body2">@SchemaText.AuxViewActivity</MudLink>
                    }
                    @if (DiscoveryInProgress)
                    {
                        <MudButton Variant="Variant.Text" Disabled="_cancellingDiscovery"
                                   OnClick="HandleCancelDiscoveryAsync">
                            @CommonText.Cancel
                        </MudButton>
                    }
                }
            </div>
            @if (LatestDiscoveryRun?.Status == AuxiliaryClassDiscoveryStatus.Cancelled)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @SchemaText.AuxCancelledRunNote
                    
                </MudText>
            }
            @if (LatestDiscoveryRun is { Status: AuxiliaryClassDiscoveryStatus.Failed } failedRun && !string.IsNullOrEmpty(failedRun.ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">@failedRun.ErrorMessage</MudAlert>
            }
        }
    </MudPaper>
}

@* An auxiliary Object Type has no structural class of its own, so JIM cannot create one of its entries without
   being told what to write alongside it. *@
@if (ObjectType.ManagesClassMembership() && ObjectType.IsAuxiliary())
{
    <MudPaper Outlined="true" Class="pa-4 mt-5">
        <MudText Typo="Typo.h6" Class="mb-3">@SchemaText.AuxProvisioning</MudText>
        <MudText>
            @string.Format(CultureInfo.CurrentCulture, SchemaText.AuxCarrierIntro, ConnectedSystem.Name, ObjectType.Name)
            
        </MudText>
        <MudSelect
            T="int?"
            Label="@SchemaText.AuxCarrierLabel"
            Variant="Variant.Outlined"
            Class="mt-4"
            Style="max-width: 30rem;"
            Clearable="true"
            Disabled="_saving"
            Value="ObjectType.StructuralCarrierObjectTypeId"
            ValueChanged="HandleCarrierChangedAsync">
            @foreach (var candidate in _carrierCandidates)
            {
                <MudSelectItem T="int?" Value="candidate.Id">@candidate.Name</MudSelectItem>
            }
        </MudSelect>
        @if (ObjectType.StructuralCarrierObjectTypeId == null)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4">
                @string.Format(CultureInfo.CurrentCulture, SchemaText.AuxCarrierUnset, ObjectType.Name)
            </MudAlert>
        }
        else
        {
            var carrierName = _carrierCandidates.FirstOrDefault(c => c.Id == ObjectType.StructuralCarrierObjectTypeId)?.Name;
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                @string.Format(CultureInfo.CurrentCulture, SchemaText.AuxCarrierCreate, carrierName, ObjectType.Name)
            </MudText>
        }
    </MudPaper>
}

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [Parameter, EditorRequired]
    public ConnectedSystemObjectType ObjectType { get; set; } = null!;

    /// <summary>
    /// The Connected System's last auxiliary class discovery run, or null when none has been run. Supplied rather
    /// than fetched, so the panel renders without reaching the application layer; it is the host's to reload when
    /// <see cref="OnSchemaChanged"/> says something has changed.
    /// </summary>
    [Parameter]
    public AuxiliaryClassDiscoveryRun? LatestDiscoveryRun { get; set; }

    /// <summary>
    /// Raised after a change the host needs to reload the Connected System for: merging a class changes which
    /// attributes the Object Type has, and the attribute table is built from them; starting or cancelling a
    /// discovery run changes what this panel's own status strip should say.
    /// </summary>
    [Parameter]
    public EventCallback OnSchemaChanged { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private static readonly DialogOptions DialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Medium, CloseButton = true };

    private List<AuxiliaryClassOffer> _offers = [];
    private List<ConnectedSystemObjectType> _carrierCandidates = [];
    private bool _saving;
    private bool _cancellingDiscovery;

    private bool DiscoveryInProgress => LatestDiscoveryRun?.Status == AuxiliaryClassDiscoveryStatus.InProgress;

    protected override void OnParametersSet()
    {
        var objectTypes = ConnectedSystem.ObjectTypes ?? [];
        _offers = AuxiliaryClassOfferBuilder.Build(ObjectType, objectTypes, LatestDiscoveryRun);
        _carrierCandidates = AuxiliaryClassOfferBuilder.CarrierCandidates(objectTypes);
    }

    /// <summary>
    /// Opens the dialog that offers every auxiliary class in the schema. Anything it applied (a merge, or a
    /// discovery run started) comes back as a non-cancelled result, and the host reloads the Connected System.
    /// </summary>
    private async Task OpenDialogAsync()
    {
        var parameters = new DialogParameters<AuxiliaryClassesDialog>
        {
            { x => x.ConnectedSystem, ConnectedSystem },
            { x => x.ObjectType, ObjectType },
            { x => x.Offers, _offers },
            { x => x.LatestDiscoveryRun, LatestDiscoveryRun }
        };

        var dialog = await DialogService.ShowAsync<AuxiliaryClassesDialog>(string.Format(CultureInfo.CurrentCulture, SchemaText.AuxDialogTitle, ObjectType.Name), parameters, DialogOptions);
        var result = await dialog.Result;
        if (result is { Canceled: false })
            await OnSchemaChanged.InvokeAsync();
    }

    private async Task HandleMergeChangedAsync(AuxiliaryClassOffer offer, bool merged)
    {
        _saving = true;
        try
        {
            // The whole set, through the same validated path the REST API and PowerShell use, rather than a
            // per-class add or remove of its own.
            var wanted = _offers
                .Where(candidate => candidate.ObjectType.Id == offer.ObjectType.Id ? merged : candidate.Merged)
                .Select(candidate => candidate.ObjectType.Id);

            using var jim = JimFactory.Create();
            var result = await jim.ConnectedSystems.SetObjectTypeExtensionsAsync(ObjectType.Id, wanted);

            if (!result.Success)
            {
                Snackbar.Add(result.ErrorMessage ?? string.Format(CultureInfo.CurrentCulture, SchemaText.AuxOfferChangeFailed, offer.ObjectType.Name), Severity.Error);
                return;
            }

            Snackbar.Add(
                merged
                    ? string.Format(CultureInfo.CurrentCulture, SchemaText.AuxMergedMessage, offer.ObjectType.Name, ObjectType.Name)
                    : string.Format(CultureInfo.CurrentCulture, SchemaText.AuxUnmergedMessage, offer.ObjectType.Name, ObjectType.Name),
                Severity.Success);

            await OnSchemaChanged.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleCarrierChangedAsync(int? carrierObjectTypeId)
    {
        _saving = true;
        try
        {
            using var jim = JimFactory.Create();
            var result = await jim.ConnectedSystems.SetStructuralCarrierObjectTypeAsync(ObjectType.Id, carrierObjectTypeId);

            if (!result.Success)
            {
                Snackbar.Add(result.ErrorMessage ?? string.Format(CultureInfo.CurrentCulture, SchemaText.AuxCarrierChangeFailed, ObjectType.Name), Severity.Error);
                return;
            }

            // Keep the loaded graph in step so the select and its guidance reflect the save without a reload.
            ObjectType.StructuralCarrierObjectTypeId = carrierObjectTypeId;
            ObjectType.StructuralCarrierObjectType = _carrierCandidates.FirstOrDefault(c => c.Id == carrierObjectTypeId);

            Snackbar.Add(
                carrierObjectTypeId == null
                    ? string.Format(CultureInfo.CurrentCulture, SchemaText.AuxCarrierRemoved, ObjectType.Name)
                    : string.Format(CultureInfo.CurrentCulture, SchemaText.AuxCarrierSet, ObjectType.Name, ObjectType.StructuralCarrierObjectType?.Name),
                Severity.Success);

            await OnSchemaChanged.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleCancelDiscoveryAsync()
    {
        var activityId = LatestDiscoveryRun?.ActivityId;
        if (activityId == null)
            return;

        _cancellingDiscovery = true;
        try
        {
            using (var jim = JimFactory.Create())
            {
                var workerTask = await jim.Tasking.GetWorkerTaskByActivityIdAsync(activityId.Value);
                if (workerTask == null)
                {
                    Snackbar.Add(SchemaText.AuxRunFinished, Severity.Info);
                }
                else
                {
                    await jim.Tasking.RequestWorkerTaskCancellationAsync(workerTask.Id);
                    Snackbar.Add(SchemaText.AuxCancelRequested, Severity.Success);
                }
            }

            await OnSchemaChanged.InvokeAsync();
        }
        finally
        {
            _cancellingDiscovery = false;
        }
    }

    private static Color StatusColour(AuxiliaryClassDiscoveryStatus status) => status switch
    {
        AuxiliaryClassDiscoveryStatus.InProgress => Color.Info,
        AuxiliaryClassDiscoveryStatus.Complete => Color.Success,
        AuxiliaryClassDiscoveryStatus.Cancelled => Color.Warning,
        AuxiliaryClassDiscoveryStatus.Failed => Color.Error,
        _ => Color.Default
    };

    private static string StatusText(AuxiliaryClassDiscoveryStatus status) => status switch
    {
        AuxiliaryClassDiscoveryStatus.InProgress => SchemaText.AuxStatusRunning,
        AuxiliaryClassDiscoveryStatus.Complete => SchemaText.AuxStatusComplete,
        AuxiliaryClassDiscoveryStatus.Cancelled => SchemaText.AuxStatusCancelled,
        AuxiliaryClassDiscoveryStatus.Failed => SchemaText.AuxStatusFailed,
        _ => SchemaText.AuxStatusNotRun
    };

    private static string DescribeRun(AuxiliaryClassDiscoveryRun run)
    {
        var scope = run.Scope == AuxiliaryClassDiscoveryScope.QuickSample
            ? string.Format(CultureInfo.CurrentCulture, SchemaText.AuxRunQuickSample, string.Format(CultureInfo.CurrentCulture, "{0:N0}", run.SampleSizePerObjectType))
            : SchemaText.AuxFullScan;

        var when = run.Completed.HasValue
            ? run.Completed.Value.ToLocalTime().ToFriendlyDate()
            : string.Format(CultureInfo.CurrentCulture, SchemaText.AuxRunStarted, run.Started.ToLocalTime().ToRelativeTime());

        var who = string.IsNullOrEmpty(run.InitiatedByName) ? "" : string.Format(CultureInfo.CurrentCulture, SchemaText.AuxRunBy, run.InitiatedByName);

        return string.Format(CultureInfo.CurrentCulture, SchemaText.AuxRunSummaryBy, scope, when, who, string.Format(CultureInfo.CurrentCulture, "{0:N0}", run.EntriesRead));
    }
}
