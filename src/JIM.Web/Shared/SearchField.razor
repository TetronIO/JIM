@* The search box for every list, table and dialog that filters as the user types. Wraps MudTextField with the *@
@* magnifier adornment, Immediate="true" and a debounce, so the list narrows per keystroke without a query per *@
@* keystroke. Bind with @bind-Value, or pass Value + ValueChanged when the handler drives a server reload. *@
@* Immediate is deliberately NOT a parameter and unmatched attributes are deliberately NOT splatted: either would *@
@* let a call site reinstate blur-commit. See JIM.Web/CLAUDE.md > "Search and filter boxes". *@
<MudTextField T="string"
              Value="@Value"
              ValueChanged="@OnValueChangedAsync"
              Placeholder="@EffectivePlaceholder"
              Label="@Label"
              HelperText="@HelperText"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              IconSize="@IconSize"
              Clearable="@Clearable"
              Disabled="@Disabled"
              Immediate="true"
              DebounceInterval="@DebounceInterval"
              Variant="Variant.Outlined"
              Margin="@Margin"
              Class="@Class"
              Style="@Style"
              autocomplete="@Autocomplete" />

@code {
    /// <summary>
    /// The current search text. Two-way bindable via @bind-Value.
    /// </summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>
    /// Raised with the new text once the debounce interval has elapsed, not on every keystroke.
    /// </summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// Placeholder shown while the field is empty. Defaults to "Search" when neither a Placeholder nor a Label is given.
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Optional floating label. When set, no default placeholder is applied.
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Optional helper text below the field, for explaining what the search matches against.
    /// </summary>
    [Parameter]
    public string? HelperText { get; set; }

    /// <summary>
    /// Milliseconds to wait after the last keystroke before raising <see cref="ValueChanged"/>. Defaults to 300ms;
    /// raise it where the handler reloads from the server or database rather than filtering an in-memory list.
    /// </summary>
    [Parameter]
    public int DebounceInterval { get; set; } = 300;

    /// <summary>
    /// Whether to show the clear (x) affordance while the field has text. Defaults to true.
    /// </summary>
    [Parameter]
    public bool Clearable { get; set; } = true;

    /// <summary>
    /// Whether the field is disabled, for example while its list is still loading.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Field density. Defaults to <see cref="MudBlazor.Margin.Dense"/>, which suits a table toolbar; pass
    /// <see cref="MudBlazor.Margin.None"/> when the field sits in a form grid beside normal-density inputs.
    /// </summary>
    [Parameter]
    public Margin Margin { get; set; } = Margin.Dense;

    /// <summary>
    /// Size of the magnifier adornment. Defaults to <see cref="Size.Medium"/>.
    /// </summary>
    [Parameter]
    public Size IconSize { get; set; } = Size.Medium;

    /// <summary>
    /// Additional CSS classes for the field.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Inline styles for the field, typically a min-width so a long placeholder is not truncated.
    /// </summary>
    [Parameter]
    public string? Style { get; set; }

    /// <summary>
    /// Value for the input's HTML autocomplete attribute. Set it to a page-specific token to stop the browser
    /// offering its own autofill suggestions over the search box.
    /// </summary>
    [Parameter]
    public string? Autocomplete { get; set; }

    private string? EffectivePlaceholder => Placeholder ?? (string.IsNullOrEmpty(Label) ? "Search" : null);

    private async Task OnValueChangedAsync(string value)
    {
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }
}
