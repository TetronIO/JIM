<MudPaper Class="pa-4" Outlined="true">
    @* No @bind-IsValid: the save gate is the parent's model predicate (SyncRule.IsValid()), not form validity. *@
    <MudForm>
        <MudTextField Label="@CommonText.ColumnName" Required="true" RequiredError="@SyncRuleText.NameRequired" @bind-Value="SyncRule.Name"
                      @bind-Value:after="NotifyChangedAsync" Immediate="true" Variant="Variant.Outlined" />

        <MudTextField T="string" Label="@CommonText.ColumnDescription" @bind-Value="SyncRule.Description" @bind-Value:after="NotifyChangedAsync"
                      Sizing="InputSizing.Auto" Lines="2" MaxLines="12" MaxLength="1000" Variant="Variant.Outlined" Class="mt-5" />

        @* An existing rule's Connected System, direction and object types are stated by the page's identity
           strip beneath the breadcrumbs (Shared/SyncRuleIdentityStrip.razor), not here among the fields. *@
        @if (SyncRule.Id == 0)
        {
            @if (ConnectedSystemNames != null)
            {
                <MudSelect T="string" Label="@SyncRuleText.ConnectedSystemTerm" Placeholder="@SyncRuleText.SelectConnectedSystem" Required="true"
                           ValueChanged="HandleConnectedSystemSelectedAsync" AdornmentIcon="@Icons.Material.Filled.Power"
                           Adornment="Adornment.Start" Variant="Variant.Outlined" Class="mt-5">
                    @foreach (var (id, name) in ConnectedSystemNames.OrderBy(n => n.Value))
                    {
                        <MudSelectItem Value="@id.ToString()">@name</MudSelectItem>
                    }
                </MudSelect>
            }

            @if (SyncRule.ConnectedSystem != null)
            {
                <MudSelect T="string" Label="@SyncRuleText.DirectionLabel" Placeholder="@SyncRuleText.SelectDirection"
                           Required="true" ValueChanged="HandleSyncRuleDirectionSelection" Variant="Variant.Outlined" Class="mt-5">
                    @foreach (SyncRuleDirection direction in Enum.GetValues(typeof(SyncRuleDirection)))
                    {
                        if (direction != SyncRuleDirection.NotSet)
                        {
                            // does the connector definition support this direction?
                            var directionSupported = false;
                            if (direction == SyncRuleDirection.Export)
                            {
                                directionSupported = SyncRule.ConnectedSystem.ConnectorDefinition.SupportsExport;
                            }
                            else if (direction == SyncRuleDirection.Import)
                            {
                                directionSupported = SyncRule.ConnectedSystem.ConnectorDefinition.SupportsDeltaImport ||
                                SyncRule.ConnectedSystem.ConnectorDefinition.SupportsFullImport;
                            }

                            <MudSelectItem Disabled="!directionSupported" Value="@direction.ToString()">@DirectionName(direction)@(directionSupported ?
                                                "" : SyncRuleText.NotSupportedByConnector)</MudSelectItem>
                        }
                    }
                </MudSelect>
            }

            @if (SyncRule.ConnectedSystem != null && SyncRule.Direction != SyncRuleDirection.NotSet &&
                    MetaverseObjectTypes != null && SyncRule.ConnectedSystem is { ObjectTypes: not null })
            {
                @* The pickers read left to right in the direction the data flows, source first, as the identity strip
                   does once the rule is saved; the arrow always points at the destination. *@
                <MudGrid>
                    @(SyncRule.Direction == SyncRuleDirection.Export ? MetaverseObjectTypePicker : ConnectedSystemObjectTypePicker)
                    <MudItem xs="2" Class="d-flex align-center justify-center mt-5">
                        <MudTooltip Text="@(SyncRule.Direction == SyncRuleDirection.Export ? SyncRuleText.ExportsToConnectedSystem : SyncRuleText.ImportsToMetaverse)" Arrow="true" Placement="Placement.Top">
                            <MudIcon Size="Size.Large" Class="mud-text-secondary" Icon="@Icons.Material.Filled.KeyboardDoubleArrowRight" />
                        </MudTooltip>
                    </MudItem>
                    @(SyncRule.Direction == SyncRuleDirection.Export ? ConnectedSystemObjectTypePicker : MetaverseObjectTypePicker)
                </MudGrid>
            }
        }
    </MudForm>
    @if (SyncRule.Direction == SyncRuleDirection.Import)
    {
        <div class="d-flex align-center mt-5">
            <MudSwitch @bind-Value="@SyncRule.ProjectToMetaverse" @bind-Value:after="NotifyChangedAsync" Color="Color.Primary"
                       Label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.ProjectToMetaverseLabel, SyncRule.MetaverseObjectType?.PluralName ?? SyncRuleText.ObjectsFallback)" />
            <TermHint Term="Term.Projection" />
        </div>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">@SyncRuleText.ProjectHelp</MudText>
    }

    @if (SyncRule.Direction == SyncRuleDirection.Export)
    {
        @* Headed like the Deprovisioning group beneath it, so the two halves of an export rule's lifecycle read as
           a pair rather than as a stray switch above a titled group. *@
        <MudText Typo="Typo.h6" Class="mt-5">@SyncRuleText.ProvisioningHeading</MudText>
        @* The label pluralises the Object Type's name, never the stand-in used before one is chosen: that is
           already plural, and pluralising it again read "Provision objectses to the Connected System?". *@
        <MudSwitch Class="mt-1" @bind-Value="@SyncRule.ProvisionToConnectedSystem" @bind-Value:after="NotifyChangedAsync" Color="Color.Primary"
                   Label="@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.ProvisionToConnectedSystemLabel, SyncRule.ConnectedSystemObjectType?.Name.Pluralise() ?? SyncRuleText.ObjectsFallback)" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">@SyncRuleText.ProvisionHelp</MudText>

        <MudText Typo="Typo.h6" Class="mt-5">@SyncRuleText.DeprovisioningHeading</MudText>
        <MudRadioGroup T="OutboundDeprovisionAction" @bind-Value="@SyncRule.OutboundDeprovisionAction" @bind-Value:after="NotifyChangedAsync">
            <div class="mt-1">
                <MudRadio T="OutboundDeprovisionAction" Value="OutboundDeprovisionAction.Disconnect" Color="Color.Primary">@SyncRuleText.DeprovisionDisconnect</MudRadio>
                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">@SyncRuleText.DeprovisionDisconnectHelp</MudText>
            </div>
            @* Disable is offered only where the Connector can disable an account (#2085); the server refuses it otherwise too. *@
            @{
                var connector = SyncRule.ConnectedSystem?.ConnectorDefinition;
                var canDisable = connector?.SupportsDisable == true;
            }
            <div class="mt-2">
                <MudRadio T="OutboundDeprovisionAction" Value="OutboundDeprovisionAction.Disable" Color="Color.Primary"
                          Disabled="@(!canDisable)">@SyncRuleText.DeprovisionDisable</MudRadio>
                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">@SyncRuleText.DeprovisionDisableHelp@(canDisable || connector == null ? "" : string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.DeprovisionDisableUnsupported, connector.Name))</MudText>
            </div>
            <div class="mt-2">
                <MudRadio T="OutboundDeprovisionAction" Value="OutboundDeprovisionAction.Delete" Color="Color.Primary">@SyncRuleText.DeprovisionDelete</MudRadio>
                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">@SyncRuleText.DeprovisionDeleteHelp</MudText>
            </div>
        </MudRadioGroup>
    }
    <MudSwitch Class="mt-5" @bind-Value="@SyncRule.Enabled" @bind-Value:after="NotifyChangedAsync" Color="Color.Primary" Label="@SyncRuleText.EnabledQuestion" />
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">@SyncRuleText.RuleEnabledHelp</MudText>
    @* A rule disabled on the administrator's behalf records why (#1485); saving the rule enabled clears it. *@
    @if (!SyncRule.Enabled && !string.IsNullOrWhiteSpace(SyncRule.DisabledReason))
    {
        var disabledReason = SyncRule.DisabledReason;
        <MudAlert Severity="Severity.Warning" Class="mt-2 ms-12">
            @disabledReason
        </MudAlert>
    }
</MudPaper>

@* Advanced Options - Only show for Export rules *@
@if (SyncRule.Direction == SyncRuleDirection.Export)
{
    <MudExpansionPanels Elevation="0" Class="mt-5 jim-expansion-panel">
        <MudExpansionPanel Text="@SyncRuleText.AdvancedOptions">
            <TitleContent>
                <div class="d-flex align-center">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Class="me-2" />
                    <MudText Typo="Typo.subtitle1">@SyncRuleText.AdvancedOptions</MudText>
                </div>
            </TitleContent>
            <ChildContent>
                <div class="pa-2">
                    <MudSwitch @bind-Value="@SyncRule.EnforceState" @bind-Value:after="NotifyChangedAsync" Color="Color.Primary"
                               Label="@SyncRuleText.EnforceStateLabel" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1 ms-12">@SyncRuleText.EnforceStateHelp</MudText>
                </div>
            </ChildContent>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

@code {
    [Parameter]
    public SyncRule SyncRule { get; set; } = null!;

    [Parameter]
    public IReadOnlyDictionary<int, string>? ConnectedSystemNames { get; set; }

    [Parameter]
    public List<MetaverseObjectType>? MetaverseObjectTypes { get; set; }

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private async Task NotifyChangedAsync()
    {
        await OnChanged.InvokeAsync();
    }

    private async Task HandleConnectedSystemSelectedAsync(string connectedSystemId)
    {
        // convert to int and assign to the Synchronisation Rule
        var connectedSystemIdInt = int.Parse(connectedSystemId);
        using var jim = JimFactory.Create();
        var connectedSystem = await jim.ConnectedSystems.GetConnectedSystemAsync(connectedSystemIdInt);
        if (connectedSystem == null)
            return;

        SyncRule.ConnectedSystem = connectedSystem;
        await OnChanged.InvokeAsync();
    }

    private async Task HandleSyncRuleDirectionSelection(string syncRuleDirection)
    {
        var syncRuleDirectionEnum = (SyncRuleDirection)Enum.Parse(typeof(SyncRuleDirection), syncRuleDirection);
        SyncRule.Direction = syncRuleDirectionEnum;

        // reset provision/project choices
        SyncRule.ProvisionToConnectedSystem = false;
        SyncRule.ProjectToMetaverse = false;
        await OnChanged.InvokeAsync();
    }

    /// <summary>A direction as the picker names it. The enum's own name is never shown.</summary>
    private static string DirectionName(SyncRuleDirection direction) => direction switch
    {
        SyncRuleDirection.Import => SyncRuleText.DirectionImportName,
        SyncRuleDirection.Export => SyncRuleText.DirectionExportName,
        _ => direction.ToString()
    };

    // The Object Type pickers, ordered by the form in the direction the data flows. Both render only inside the form's
    // check that the Connected System, its Object Types and the Metaverse Object Types are loaded.
    private RenderFragment MetaverseObjectTypePicker =>
        @<MudItem xs="5">
            <MudSelect T="MetaverseObjectType" Label="@SyncRuleText.MetaverseObjectTypeLabel"
                       @bind-Value="@SyncRule.MetaverseObjectType" @bind-Value:after="NotifyChangedAsync" Required="true" Class="mt-5"
                       Variant="Variant.Outlined">
                @foreach (var mvObjectType in MetaverseObjectTypes!)
                {
                    <MudSelectItem Value="@mvObjectType">@mvObjectType.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>;

    private RenderFragment ConnectedSystemObjectTypePicker =>
        @<MudItem xs="5">
            <MudSelect T="ConnectedSystemObjectType" Label="@SyncRuleText.ConnectedSystemObjectTypeLabel"
                       @bind-Value="@SyncRule.ConnectedSystemObjectType" @bind-Value:after="NotifyChangedAsync" Required="true" Class="mt-5"
                       Variant="Variant.Outlined">
                @foreach (var csObjectType in SyncRule.ConnectedSystem!.ObjectTypes!.Where(ot => ot.Selected))
                {
                    <MudSelectItem Value="@csObjectType">@csObjectType.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>;
}
