scripts/
# The test tree is excluded from production image contexts, with two exceptions: the SCIM test
# service provider and the stand-in Microsoft Graph service (test infrastructure, never shipped) are
# built as containers for the integration suite and need their own sources plus lock files in the context.
test/
!test/JIM.TestScimServiceProvider/
!test/JIM.TestGraphService/
