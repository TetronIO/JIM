<MudAlert Severity="@PanelSeverity"
          Variant="Variant.Outlined"
          Icon="@Icons.Material.Filled.Preview"
          Class="mt-5 jim-alert-schema-refresh-preview">
    <MudText Typo="Typo.subtitle1" Class="mb-2">
        <strong>Schema Refresh Preview</strong>
    </MudText>

    @if (!Result.HasChanges)
    {
        <MudText Class="mb-2">
            Found <strong>@Result.TotalObjectTypes.ToString("N0")</strong> object type(s) with <strong>@Result.TotalAttributes.ToString("N0")</strong> attribute(s).
        </MudText>
        <MudText Color="Color.Success">No changes detected. The schema is up to date.</MudText>
        <MudButton data-testid="jim-close-schema-refresh"
                   Variant="Variant.Text"
                   Color="Color.Inherit"
                   DropShadow="false"
                   Class="mt-3"
                   OnClick="@(() => OnDiscard.InvokeAsync())">Close</MudButton>
    }
    else
    {
        <MudText Class="mb-2">
            The Connected System reported the changes below. <strong>Nothing has been applied yet</strong>; review them, then decide how to proceed.
        </MudText>

        @if (Result.DiscoveryWarnings.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2 mb-2">
                <strong>Discovery warnings:</strong> the Connector could not discover everything and worked around the gaps below. A partial read can make Object Types or Attributes appear removed when they are not; check these before applying.
                <ul class="mt-1 mb-0">
                    @foreach (var warning in Result.DiscoveryWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </MudAlert>
        }

        @if (Result.BlockedCredentialAttributeCount > 0)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2 mb-2">
                <strong>@Result.BlockedCredentialAttributeCount credential attribute(s) blocked:</strong>
                @(string.Join(", ", Result.BlockedCredentialAttributes.SelectMany(kvp => kvp.Value).Distinct())).
                These hold credential material and are never managed by JIM.
            </MudAlert>
        }

        @if (HasAdditions)
        {
            <MudText Typo="Typo.body1" Class="mt-3" Style="font-weight:600" Color="Color.Success">Additions: safe to apply</MudText>
            <SchemaChangeTable Result="Result" Section="SchemaChangeTable.SchemaChangeSection.Additions" />
        }

        @if (Result.HasRemovalsOrDefinitionChanges)
        {
            <MudText Typo="Typo.body1" Class="mt-4" Style="font-weight:600" Color="Color.Error">Destructive: review before proceeding</MudText>
            <SchemaChangeTable Result="Result" Section="SchemaChangeTable.SchemaChangeSection.Destructive" />

            @if (Dependents is { HasAny: true })
            {
                <MudText Typo="Typo.body1" Class="mt-3" Style="font-weight:600">Configuration that depends on these changes</MudText>
                <ul class="mt-1 mb-0">
                    @foreach (var rule in Dependents.InvalidatedSyncRules)
                    {
                        <li>
                            Synchronisation Rule <MudLink Href="@SyncRuleUrl(rule.SyncRuleId)" Target="_blank">@rule.SyncRuleName</MudLink>
                            is bound to Object Type <span class="jim-text-code">@rule.ObjectTypeName</span>, with @rule.MappingCount mapping(s).
                        </li>
                    }
                    @foreach (var mapping in Dependents.InvalidatedMappings)
                    {
                        <li>
                            Mapping <span class="jim-text-code">@mapping.Description</span> on
                            <MudLink Href="@SyncRuleUrl(mapping.SyncRuleId)" Target="_blank">@mapping.SyncRuleName</MudLink>@(mapping.ViaExpression ? " (read by its Expression)" : "").
                        </li>
                    }
                    @foreach (var matchingRule in Dependents.ReferencedObjectMatchingRules)
                    {
                        <li>Object Matching Rule on @matchingRule.Context: @matchingRule.Reason</li>
                    }
                </ul>
            }

            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                Object Types and Attributes the Connected System no longer reports are <strong>retained</strong> in JIM when you apply; nothing is deleted, but their values stop refreshing, and objects of a removed Object Type will be obsoleted by the next Full Import whether or not you apply. Attribute definition changes are applied, and a mapping validated against the old definition may no longer behave as intended.
            </MudAlert>
        }

        @if (Result.ActionRequired)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                <strong>Action Required:</strong> Some attributes that are no longer reported are still referenced by Synchronisation Rules.
                Please update your Synchronisation Rules to remove references to these attributes.
            </MudAlert>
        }

        <div class="d-flex mt-4 flex-wrap" style="gap: 8px">
            <MudButton data-testid="jim-discard-schema-refresh"
                       Variant="Variant.Text"
                       Color="Color.Inherit"
                       DropShadow="false"
                       Disabled="@Busy"
                       OnClick="HandleDiscardAsync">Cancel</MudButton>
            <MudSpacer />
            @if (Dependents is { HasAny: true })
            {
                <MudButton data-testid="jim-apply-disable-schema-refresh"
                           Variant="Variant.Outlined"
                           Color="Color.Warning"
                           DropShadow="false"
                           Disabled="@Busy"
                           OnClick="@(() => _disablePlanDialogVisible = true)">Apply &amp; Disable Dependents…</MudButton>
            }
            <MudButton data-testid="jim-apply-schema-refresh"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       DropShadow="false"
                       Disabled="@Busy"
                       OnClick="@(() => OnApply.InvokeAsync())">Apply Schema Changes</MudButton>
        </div>
    }
</MudAlert>

@* ─── Apply & Disable Dependents plan (#1485) ─── *@
<MudDialog @bind-Visible="_disablePlanDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Shield" Class="mr-3" /> Apply schema and disable dependents?
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-2">
            The new schema is recorded, and everything below is <strong>disabled</strong> with the stated reason so nothing runs against entries the Connected System no longer reports. No objects or values are touched. Re-enabling is a manual choice per rule or mapping.
        </MudText>
        @if (Dependents != null)
        {
            <ul class="mb-0">
                @foreach (var rule in Dependents.InvalidatedSyncRules)
                {
                    <li class="mb-1">
                        <strong><MudLink Href="@SyncRuleUrl(rule.SyncRuleId)" Target="_blank">@rule.SyncRuleName</MudLink></strong> disabled, with its @rule.MappingCount mapping(s).
                        <br /><span class="mud-text-secondary">@rule.Reason</span>
                    </li>
                }
                @foreach (var mapping in Dependents.InvalidatedMappings)
                {
                    <li class="mb-1">
                        Mapping <span class="jim-text-code">@mapping.Description</span> on <MudLink Href="@SyncRuleUrl(mapping.SyncRuleId)" Target="_blank">@mapping.SyncRuleName</MudLink> disabled.
                        <br /><span class="mud-text-secondary">@mapping.Reason</span>
                    </li>
                }
            </ul>
            @if (Dependents.ReferencedObjectMatchingRules.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2">
                    Object Matching has no disabled state, so these need your attention separately:
                    <ul class="mt-1 mb-0">
                        @foreach (var matchingRule in Dependents.ReferencedObjectMatchingRules)
                        {
                            <li>@matchingRule.Context: @matchingRule.Reason</li>
                        }
                    </ul>
                </MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton DropShadow="false" Variant="Variant.Text" OnClick="@(() => _disablePlanDialogVisible = false)" Class="ma-4">Back</MudButton>
        <MudButton data-testid="jim-confirm-apply-disable"
                   DropShadow="false"
                   Variant="Variant.Filled"
                   Color="Color.Warning"
                   Disabled="@Busy"
                   OnClick="HandleConfirmApplyWithDisablesAsync"
                   Class="ma-4">Apply &amp; Disable</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private bool _disablePlanDialogVisible;

    /// <summary>
    /// The refresh being previewed. Nothing it describes has been persisted.
    /// </summary>
    [Parameter, EditorRequired]
    public SchemaRefreshResult Result { get; set; } = null!;

    /// <summary>
    /// What the refresh's destructive changes invalidate: the dependents named on the review, and the plan the
    /// Apply &amp; Disable Dependents option commits (#1485). Null or empty hides that option.
    /// </summary>
    [Parameter]
    public SchemaRefreshDependents? Dependents { get; set; }

    /// <summary>
    /// Raised when the administrator chooses to persist the previewed refresh as-is.
    /// </summary>
    [Parameter]
    public EventCallback OnApply { get; set; }

    /// <summary>
    /// Raised when the administrator confirms applying the refresh with the dependents disabled.
    /// </summary>
    [Parameter]
    public EventCallback OnApplyWithDisables { get; set; }

    /// <summary>
    /// Raised when the administrator discards the previewed refresh (after confirmation, where discarding leaves
    /// JIM's schema adrift of the Connected System's).
    /// </summary>
    [Parameter]
    public EventCallback OnDiscard { get; set; }

    /// <summary>
    /// True while an apply is running, so the buttons cannot be pressed twice.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    private Severity PanelSeverity => Result.HasRemovalsOrDefinitionChanges ? Severity.Warning : Severity.Info;

    private bool HasAdditions =>
        Result.AddedObjectTypes.Count > 0 ||
        Result.UpdatedObjectTypes.Count > 0 ||
        Result.AddedAttributes.Values.Sum(v => v.Count) > 0;

    private static string SyncRuleUrl(int syncRuleId) => $"/admin/sync-rules/{syncRuleId}";

    private async Task HandleConfirmApplyWithDisablesAsync()
    {
        _disablePlanDialogVisible = false;
        await OnApplyWithDisables.InvokeAsync();
    }

    /// <summary>
    /// Additions discard for free (the next refresh finds them again). Removals and definition changes do not:
    /// cancelling does not preserve the status quo, so the administrator confirms with the concrete
    /// consequences in front of them.
    /// </summary>
    private async Task HandleDiscardAsync()
    {
        if (Result.HasRemovalsOrDefinitionChanges)
        {
            var options = new MessageBoxOptions
            {
                Title = "Cancel without applying?",
                MarkupMessage = (MarkupString)(
                    "Cancelling does not preserve the status quo. The next Full Import will find no objects of a removed Object Type and obsolete them regardless, " +
                    "and the source now sends redefined attributes in their new form, so mappings validated against the old definition may misbehave. " +
                    "You can re-run the refresh at any time to decide."),
                YesText = "Cancel Refresh",
                CancelText = "Keep Reviewing"
            };

            var confirmed = await DialogService.ShowMessageBoxAsync(options);
            if (confirmed != true)
                return;
        }

        await OnDiscard.InvokeAsync();
    }
}
