@* The Deletion Rules panel's warning about Connected Systems that project into the object type without being one of
   its selected authoritative sources (#1256). The host works out which systems from the edited selection, through
   DeletionSourceAdvisor, so the warning follows the checkboxes as they are ticked. Renders nothing when there are none. *@
@if (SystemNames.Count > 0)
{
    var names = DerivedFlowWording.JoinNames(SystemNames);
    var several = SystemNames.Count > 1;
    <MudAlert Severity="Severity.Warning" Class="mt-4" data-testid="jim-deletion-source-warning">
        <MudText Typo="Typo.body1"><strong>@(several
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DsWarnHeadingMany, SystemNames.Count)
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DsWarnHeadingSingle, names, ObjectTypeName))</strong></MudText>
        <MudText Typo="Typo.body2" Class="mt-2">
            @string.Format(System.Globalization.CultureInfo.CurrentCulture, several ? ConnectedSystemText.DsWarnBodyMany : ConnectedSystemText.DsWarnBodySingle, names, ObjectTypeName)
        </MudText>
        <ul class="mt-1 mb-0 pl-5">
            <li><MudText Typo="Typo.body2"><strong>@ConnectedSystemText.DsWarnNeverLabel</strong> @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DsWarnNeverBody, ObjectTypeName, names)</MudText></li>
            <li><MudText Typo="Typo.body2"><strong>@ConnectedSystemText.DsWarnDeletedLabel</strong> @string.Format(System.Globalization.CultureInfo.CurrentCulture, several ? ConnectedSystemText.DsWarnDeletedBodyMany : ConnectedSystemText.DsWarnDeletedBodySingle, ObjectTypeName, names)</MudText></li>
        </ul>
        @if (NoGracePeriod)
        {
            <MudText Typo="Typo.body2" Class="mt-2" data-testid="jim-deletion-source-no-grace">
                @ConnectedSystemText.DsWarnNoGrace
            </MudText>
        }
        <MudText Typo="Typo.body2" Class="mt-2">
            @(several ? ConnectedSystemText.DsWarnSelectMany : ConnectedSystemText.DsWarnSelectSingle)
        </MudText>
    </MudAlert>
}

@code {
    /// <summary>The projecting Connected Systems that are not selected authoritative sources, by name.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<string> SystemNames { get; set; } = [];

    /// <summary>The Metaverse Object Type the deletion settings belong to.</summary>
    [Parameter, EditorRequired]
    public string ObjectTypeName { get; set; } = string.Empty;

    /// <summary>
    /// True when the edited grace period is zero, so a deletion triggered by a stale source list would happen at once
    /// rather than waiting for an administrator to notice.
    /// </summary>
    [Parameter]
    public bool NoGracePeriod { get; set; }
}
