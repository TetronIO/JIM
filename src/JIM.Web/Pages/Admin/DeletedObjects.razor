@page "/admin/deleted-objects"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Core
@using JIM.Models.Staging
@using JIM.Models.Staging.DTOs
@using JIM.Models.Enums
@using Humanizer
@using JIM.Web.Services
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject IUserPreferenceService PreferenceService
@inject ISnackbar Snackbar

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Deleted Objects</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />Deleted Objects</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    When objects are deleted, their change history is preserved here for audit and compliance purposes.
    Click <strong>View</strong> to see the full history of changes made to an object before it was deleted.
</MudText>

<NavigableMudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="false" Outlined="true" TabPanelsClass="pa-0 mt-4" Class="mt-4" @bind-ActivePanelIndex="_activeTabIndex">
    <MudTabPanel Text="Deleted CSOs">
        <MudPaper Class="pa-5" Outlined="true">
            <!-- Filters -->
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?"
                               @bind-Value="_csoFilterConnectedSystemId"
                               Label="Connected System"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Clearable="true">
                        @if (_connectedSystems != null)
                        {
                            @foreach (var cs in _connectedSystems)
                            {
                                <MudSelectItem T="int?" Value="@cs.Id">@cs.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    @* search-convention: exempt - a criterion in the Connected System Object query form, submitted by Search alongside the system and date criteria. *@
                    <MudTextField @bind-Value="_csoSearchExternalId"
                                  Label="Search External ID"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="6" sm="3" md="3">
                    <MudDatePicker @bind-Date="_csoFromDate"
                                   Label="From Date"
                                   Variant="Variant.Outlined"
                                   Clearable="true" />
                </MudItem>
                <MudItem xs="6" sm="3" md="3">
                    <MudDatePicker @bind-Date="_csoToDate"
                                   Label="To Date"
                                   Variant="Variant.Outlined"
                                   Clearable="true" />
                </MudItem>
            </MudGrid>
            <div class="d-flex align-center gap-3 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchCsosAsync" DropShadow="false">
                    Search
                </MudButton>
            </div>
        </MudPaper>

        <!-- Results Table -->
        <MudTable Items="@_deletedCsoChanges" Hover="true" Breakpoint="Breakpoint.Sm" Outlined="true" Elevation="0"
                  Loading="@_csoLoading" Dense="true" CurrentPage="@(_csoPage - 1)" RowsPerPage="@_rowsPerPage" RowsPerPageChanged="OnRowsPerPageChanged" Class="mt-4">
            <HeaderContent>
                <MudTh Style="width: 1px;"></MudTh>
                <MudTh><MudText Typo="Typo.button">External ID</MudText></MudTh>
                <MudTh><MudText Typo="Typo.button">Display Name</MudText></MudTh>
                <MudTh><MudText Typo="Typo.button">Object Type</MudText></MudTh>
                <MudTh><MudText Typo="Typo.button">Connected System</MudText></MudTh>
                <MudTh><MudText Typo="Typo.button">Deleted</MudText></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudButton Variant="Variant.Outlined"

                               Color="Color.Primary"
                               OnClick="() => ViewCsoHistoryAsync(context)">
                        View
                    </MudButton>
                </MudTd>
                <MudTd DataLabel="External ID">
                    <span class="jim-text-code">@(context.DeletedObjectExternalId ?? "N/A")</span>
                </MudTd>
                <MudTd DataLabel="Display Name">
                    @(context.DeletedObjectDisplayName ?? "-")
                </MudTd>
                <MudTd DataLabel="Object Type">
                    @(context.DeletedObjectType?.Name ?? "Unknown")
                </MudTd>
                <MudTd DataLabel="Connected System">
                    @{
                        var csName = _connectedSystems?.FirstOrDefault(c => c.Id == context.ConnectedSystemId)?.Name ?? $"ID: {context.ConnectedSystemId}";
                    }
                    <MudLink Href="@($"/admin/connected-systems/{context.ConnectedSystemId}")">@csName</MudLink>
                </MudTd>
                <MudTd DataLabel="Deleted">
                    <MudTooltip Text="@context.ChangeTime.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                        @context.ChangeTime.ToLocalTime().Humanize()
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @* Only speak once a search has completed and its result is known to be empty. The fragment
                   renders while a search is in flight too, so an unguarded message would flash over rows
                   that are merely being replaced. The page searches on load, so results being null only
                   means the first search has not yet returned. *@
                @if (!_csoLoading && _deletedCsoChanges != null)
                {
                    @* An empty list means one of two things, and the message says which: a query that
                       matched nothing (with the way out as the action), or no deletions recorded at all. *@
                    @if (_csoLastSearchHadCriteria)
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                         PrimaryText="No deleted Connected System Objects match your query"
                                         SecondaryText="Adjust the criteria above and search again, or clear them to see all deletions."
                                         ActionText="Clear Criteria"
                                         OnAction="ClearCsoCriteriaAsync" />
                    }
                    else
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.AutoDelete"
                                         PrimaryText="No Connected System Object deletions recorded yet"
                                         SecondaryText="When Connected System Objects are deleted, their change history is preserved here." />
                    }
                }
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudTabPanel>

    <MudTabPanel Text="Deleted MVOs">
        <MudPaper Class="pa-5" Outlined="true">
            <!-- Filters -->
            <MudGrid>
                <MudItem xs="12" sm="6" md="3">
                    <MudSelect T="int?"
                               @bind-Value="_mvoFilterObjectTypeId"
                               Label="Object Type"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Clearable="true">
                        @if (_objectTypes != null)
                        {
                            @foreach (var ot in _objectTypes)
                            {
                                <MudSelectItem T="int?" Value="@ot.Id">@ot.Name</MudSelectItem>
                            }
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    @* search-convention: exempt - a criterion in the Metaverse Object query form, submitted by Search alongside the object type and date criteria. *@
                    <MudTextField @bind-Value="_mvoSearchDisplayName"
                                  Label="Search Display Name"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search" />
                </MudItem>
                <MudItem xs="6" sm="3" md="3">
                    <MudDatePicker @bind-Date="_mvoFromDate"
                                   Label="From Date"
                                   Variant="Variant.Outlined"
                                   Clearable="true" />
                </MudItem>
                <MudItem xs="6" sm="3" md="3">
                    <MudDatePicker @bind-Date="_mvoToDate"
                                   Label="To Date"
                                   Variant="Variant.Outlined"
                                   Clearable="true" />
                </MudItem>
            </MudGrid>
            <div class="d-flex align-center gap-3 mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SearchMvosAsync" DropShadow="false">
                    Search
                </MudButton>
            </div>
        </MudPaper>

        <!-- Results Table -->
        <MudTable Items="@_deletedMvoChanges" Hover="true" Breakpoint="Breakpoint.Sm" Outlined="true" Elevation="0"
                  Loading="@_mvoLoading" Dense="true" CurrentPage="@(_mvoPage - 1)" RowsPerPage="@_rowsPerPage" RowsPerPageChanged="OnRowsPerPageChanged" Class="mt-4">
            <HeaderContent>
                <MudTh Style="width: 1px;"></MudTh>
                <MudTh><MudText Typo="Typo.button">Display Name</MudText></MudTh>
                <MudTh><MudText Typo="Typo.button">Object Type</MudText></MudTh>
                <MudTh><MudText Typo="Typo.button">Deleted</MudText></MudTh>
                <MudTh><MudText Typo="Typo.button">Deleted By</MudText></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudButton Variant="Variant.Outlined"

                               Color="Color.Primary"
                               OnClick="() => ViewMvoHistoryAsync(context)">
                        View
                    </MudButton>
                </MudTd>
                <MudTd DataLabel="Display Name">
                    @(context.DeletedObjectDisplayName ?? "-")
                </MudTd>
                <MudTd DataLabel="Object Type">
                    @(context.DeletedObjectType?.Name ?? "Unknown")
                </MudTd>
                <MudTd DataLabel="Deleted">
                    <MudTooltip Text="@context.ChangeTime.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                        @context.ChangeTime.ToLocalTime().Humanize()
                    </MudTooltip>
                </MudTd>
                <MudTd DataLabel="Deleted By">
                    @if (!string.IsNullOrEmpty(context.InitiatedByName))
                    {
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Helpers.GetInitiatorIcon(context.InitiatedByType)" Class="mud-text-secondary" />
                            @if (context.InitiatedByType == JIM.Models.Activities.ActivityInitiatorType.ApiKey && context.InitiatedById.HasValue)
                            {
                                <MudLink Href="@($"/admin/apikeys/{context.InitiatedById}")">@context.InitiatedByName</MudLink>
                            }
                            else if (context.InitiatedByType == JIM.Models.Activities.ActivityInitiatorType.User && context.InitiatedById.HasValue)
                            {
                                <MudLink Href="@($"/users/{context.InitiatedById}")">@context.InitiatedByName</MudLink>
                            }
                            else
                            {
                                @context.InitiatedByName
                            }
                        </div>
                    }
                    else
                    {
                        <span class="mud-text-secondary">Unknown</span>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                @* Guarded as per the Connected System Object table above: only speak once the search has
                   completed and the result is known to be empty. *@
                @if (!_mvoLoading && _deletedMvoChanges != null)
                {
                    @if (_mvoLastSearchHadCriteria)
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                         PrimaryText="No deleted Metaverse Objects match your query"
                                         SecondaryText="Adjust the criteria above and search again, or clear them to see all deletions."
                                         ActionText="Clear Criteria"
                                         OnAction="ClearMvoCriteriaAsync" />
                    }
                    else
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.AutoDelete"
                                         PrimaryText="No Metaverse Object deletions recorded yet"
                                         SecondaryText="When Metaverse Objects are deleted, their change history is preserved here." />
                    }
                }
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </MudTabPanel>
</NavigableMudTabs>

<!-- CSO History Dialog -->
<MudDialog @bind-Visible="_csoHistoryDialogVisible" Options="_historyDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-3" />
            Change History: @(_selectedCsoChange?.DeletedObjectExternalId ?? "Deleted CSO")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_csoHistoryLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_selectedCsoHistory != null && _selectedCsoHistory.Any())
        {
            <ChangeHistoryTimeline Changes="@GetCsoHistoryAsChangeGroups()" />
        }
        else
        {
            @* Only reachable once the history load has completed and returned nothing. *@
            <TableEmptyState Icon="@Icons.Material.Filled.HistoryToggleOff"
                             PrimaryText="No change history available"
                             SecondaryText="No changes were recorded for this Connected System Object before it was deleted." />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            OnClick="() => _csoHistoryDialogVisible = false">Close</MudButton>
    </DialogActions>
</MudDialog>

<!-- MVO History Dialog -->
<MudDialog @bind-Visible="_mvoHistoryDialogVisible" Options="_historyDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-3" />
            Change History: @(_selectedMvoChange?.DeletedObjectDisplayName ?? "Deleted MVO")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_mvoHistoryLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_selectedMvoHistory != null && _selectedMvoHistory.Any())
        {
            <ChangeHistoryTimeline Changes="@GetMvoHistoryAsChangeGroups()" />
        }
        else
        {
            @* Only reachable once the history load has completed and returned nothing. *@
            <TableEmptyState Icon="@Icons.Material.Filled.HistoryToggleOff"
                             PrimaryText="No change history available"
                             SecondaryText="No changes were recorded for this Metaverse Object before it was deleted." />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            OnClick="() => _mvoHistoryDialogVisible = false">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// Deep link: the id a Metaverse Object had before it was deleted. Reached from a causality view, which
    /// names an Identity a run deleted and knows only that id. Opens the object's change history directly
    /// rather than leaving the reader to find it among every deletion JIM has recorded.
    /// </summary>
    [SupplyParameterFromQuery(Name = "mvo")]
    public Guid? DeepLinkDeletedMvoId { get; set; }

    /// <summary>
    /// Deep link: the id a Connected System Object had before it was deleted. The Connected System Object
    /// counterpart of <see cref="DeepLinkDeletedMvoId"/>.
    /// </summary>
    [SupplyParameterFromQuery(Name = "cso")]
    public Guid? DeepLinkDeletedCsoId { get; set; }

    private int _activeTabIndex;
    private int _rowsPerPage = 10;
    private bool _preferencesLoaded;
    private Guid? _openedDeepLinkMvoId;
    private Guid? _openedDeepLinkCsoId;

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Administration", href: "/admin"),
        new("Deleted Objects", href: null, disabled: true)
    };

    private readonly DialogOptions _historyDialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Large };

    // Reference data
    private List<ConnectedSystemHeader>? _connectedSystems;
    private List<MetaverseObjectType>? _objectTypes;

    // CSO tab state
    private int? _csoFilterConnectedSystemId;
    private string _csoSearchExternalId = "";
    private DateTime? _csoFromDate;
    private DateTime? _csoToDate;
    private List<ConnectedSystemObjectChange>? _deletedCsoChanges;
    private int _csoPage = 1;
    private bool _csoLoading;
    // Whether the last executed search carried any criteria; captured at search time so the empty state's
    // message cannot flip when the user edits the form without pressing Search.
    private bool _csoLastSearchHadCriteria;

    // MVO tab state
    private int? _mvoFilterObjectTypeId;
    private string _mvoSearchDisplayName = "";
    private DateTime? _mvoFromDate;
    private DateTime? _mvoToDate;
    private List<MetaverseObjectChange>? _deletedMvoChanges;
    private int _mvoPage = 1;
    private bool _mvoLoading;
    // See _csoLastSearchHadCriteria.
    private bool _mvoLastSearchHadCriteria;

    // CSO History dialog
    private bool _csoHistoryDialogVisible;
    private ConnectedSystemObjectChange? _selectedCsoChange;
    private List<ConnectedSystemObjectChange>? _selectedCsoHistory;
    private bool _csoHistoryLoading;

    // MVO History dialog
    private bool _mvoHistoryDialogVisible;
    private MetaverseObjectChange? _selectedMvoChange;
    private List<MetaverseObjectChange>? _selectedMvoHistory;
    private bool _mvoHistoryLoading;

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        // Load reference data
        var csHeaders = await jim.ConnectedSystems.GetConnectedSystemHeadersAsync();
        _connectedSystems = csHeaders?.ToList();

        var otHeaders = await jim.Metaverse.GetMetaverseObjectTypeHeadersAsync();
        _objectTypes = otHeaders?.Select(h => new MetaverseObjectType { Id = h.Id, Name = h.Name }).ToList();

        // Load initial data for both tabs (showing latest deleted objects by default)
        await SearchCsosAsync();
        await SearchMvosAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // Guarded on the id rather than on a bool: Blazor re-runs this for every parameter change, and the
        // dialog must not reopen itself after the user closes it, nor stay shut if they follow a second deep
        // link to a different object without leaving the page.
        if (DeepLinkDeletedMvoId is { } deletedMvoId && deletedMvoId != Guid.Empty && _openedDeepLinkMvoId != deletedMvoId)
        {
            _openedDeepLinkMvoId = deletedMvoId;
            await OpenDeletedMvoByObjectIdAsync(deletedMvoId);
        }

        if (DeepLinkDeletedCsoId is { } deletedCsoId && deletedCsoId != Guid.Empty && _openedDeepLinkCsoId != deletedCsoId)
        {
            _openedDeepLinkCsoId = deletedCsoId;
            await OpenDeletedCsoByObjectIdAsync(deletedCsoId);
        }
    }

    /// <summary>
    /// Resolves a deleted Connected System Object's id to its deletion record and opens the history dialog
    /// on it. The Connected System Object counterpart of <see cref="OpenDeletedMvoByObjectIdAsync"/>.
    /// </summary>
    private async Task OpenDeletedCsoByObjectIdAsync(Guid deletedConnectedSystemObjectId)
    {
        ConnectedSystemObjectChange? change;
        using (var jim = JimFactory.Create())
        {
            change = await jim.ConnectedSystems.GetDeletedCsoChangeAsync(deletedConnectedSystemObjectId);
        }

        if (change == null)
        {
            Snackbar.Add("No deletion record was found for that Connected System Object.", Severity.Info);
            return;
        }

        await ViewCsoHistoryAsync(change);
    }

    /// <summary>
    /// Resolves a deleted Metaverse Object's id to its deletion record and opens the history dialog on it.
    /// Where no record exists (the deletion predates change tracking being enabled), the page is left on the
    /// list rather than opening an empty dialog, so the reader can search for the object themselves.
    /// </summary>
    private async Task OpenDeletedMvoByObjectIdAsync(Guid deletedMetaverseObjectId)
    {
        MetaverseObjectChange? change;
        using (var jim = JimFactory.Create())
        {
            change = await jim.Metaverse.GetDeletedMvoChangeAsync(deletedMetaverseObjectId);
        }

        if (change == null)
        {
            Snackbar.Add("No deletion record was found for that Metaverse Object.", Severity.Info);
            return;
        }

        await ViewMvoHistoryAsync(change);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_preferencesLoaded)
        {
            try
            {
                var preferredSize = await PreferenceService.GetRowsPerPageAsync();
                _rowsPerPage = preferredSize;
                _preferencesLoaded = true;
                StateHasChanged();
            }
            catch
            {
                // JS interop not yet available, will retry on next render
            }
        }
    }

    private async Task OnRowsPerPageChanged(int newSize)
    {
        _rowsPerPage = newSize;
        await PreferenceService.SetRowsPerPageAsync(newSize);
    }

    private async Task SearchCsosAsync()
    {
        _csoLoading = true;
        _csoPage = 1;
        _csoLastSearchHadCriteria = _csoFilterConnectedSystemId.HasValue
            || !string.IsNullOrWhiteSpace(_csoSearchExternalId)
            || _csoFromDate.HasValue
            || _csoToDate.HasValue;
        StateHasChanged();

        try
        {
            using var jim = JimFactory.Create();
            var (items, _) = await jim.ConnectedSystems.GetDeletedCsoChangesAsync(
                connectedSystemId: _csoFilterConnectedSystemId,
                fromDate: _csoFromDate?.ToUniversalTime(),
                toDate: _csoToDate?.ToUniversalTime().AddDays(1), // Include the entire day
                externalIdSearch: string.IsNullOrWhiteSpace(_csoSearchExternalId) ? null : _csoSearchExternalId,
                page: 1,
                pageSize: 10000); // Load all for client-side pagination

            _deletedCsoChanges = items;
        }
        finally
        {
            _csoLoading = false;
        }
    }

    private async Task SearchMvosAsync()
    {
        _mvoLoading = true;
        _mvoPage = 1;
        _mvoLastSearchHadCriteria = _mvoFilterObjectTypeId.HasValue
            || !string.IsNullOrWhiteSpace(_mvoSearchDisplayName)
            || _mvoFromDate.HasValue
            || _mvoToDate.HasValue;
        StateHasChanged();

        try
        {
            using var jim = JimFactory.Create();
            var (items, _) = await jim.Metaverse.GetDeletedMvoChangesAsync(
                objectTypeId: _mvoFilterObjectTypeId,
                fromDate: _mvoFromDate?.ToUniversalTime(),
                toDate: _mvoToDate?.ToUniversalTime().AddDays(1),
                displayNameSearch: string.IsNullOrWhiteSpace(_mvoSearchDisplayName) ? null : _mvoSearchDisplayName,
                page: 1,
                pageSize: 10000); // Load all for client-side pagination

            _deletedMvoChanges = items;
        }
        finally
        {
            _mvoLoading = false;
        }
    }

    /// <summary>
    /// The empty state's way out when a query matched nothing: resets the Connected System Object
    /// criteria and re-runs the search, returning the table to the unfiltered list of deletions.
    /// </summary>
    private async Task ClearCsoCriteriaAsync()
    {
        _csoFilterConnectedSystemId = null;
        _csoSearchExternalId = "";
        _csoFromDate = null;
        _csoToDate = null;
        await SearchCsosAsync();
    }

    /// <summary>
    /// The Metaverse Object counterpart of <see cref="ClearCsoCriteriaAsync"/>.
    /// </summary>
    private async Task ClearMvoCriteriaAsync()
    {
        _mvoFilterObjectTypeId = null;
        _mvoSearchDisplayName = "";
        _mvoFromDate = null;
        _mvoToDate = null;
        await SearchMvosAsync();
    }

    private async Task ViewCsoHistoryAsync(ConnectedSystemObjectChange change)
    {
        _selectedCsoChange = change;
        _csoHistoryDialogVisible = true;
        _csoHistoryLoading = true;
        _selectedCsoHistory = null;
        StateHasChanged();

        try
        {
            using var jim = JimFactory.Create();
            _selectedCsoHistory = await jim.ConnectedSystems.GetDeletedCsoChangeHistoryAsync(change.Id);
        }
        finally
        {
            _csoHistoryLoading = false;
            StateHasChanged();
        }
    }

    private async Task ViewMvoHistoryAsync(MetaverseObjectChange change)
    {
        _selectedMvoChange = change;
        _mvoHistoryDialogVisible = true;
        _mvoHistoryLoading = true;
        _selectedMvoHistory = null;
        StateHasChanged();

        try
        {
            using var jim = JimFactory.Create();
            _selectedMvoHistory = await jim.Metaverse.GetDeletedMvoChangeHistoryAsync(change.Id);
        }
        finally
        {
            _mvoHistoryLoading = false;
            StateHasChanged();
        }
    }

    private List<ChangeHistoryTimeline.ChangeGroup> GetCsoHistoryAsChangeGroups()
    {
        if (_selectedCsoHistory == null)
            return new List<ChangeHistoryTimeline.ChangeGroup>();

        var csName = _connectedSystems?.FirstOrDefault(c => c.Id == _selectedCsoChange?.ConnectedSystemId)?.Name;

        return _selectedCsoHistory
            .OrderByDescending(c => c.ChangeTime)
            .Select(change => new ChangeHistoryTimeline.ChangeGroup
            {
                ChangeType = change.ChangeType,
                ChangeTime = change.ChangeTime,
                ChangeInitiatorType = MapInitiatorType(change.InitiatedByType),
                ChangeInitiatorName = change.InitiatedByName,
                ChangeInitiatorId = change.InitiatedById,
                ChangeMechanismType = MapRunTypeToMechanismType(change.ActivityRunProfileExecutionItem?.Activity?.ConnectedSystemRunType),
                RunProfileName = change.ActivityRunProfileExecutionItem?.Activity?.TargetName,
                ConnectedSystemId = change.ConnectedSystemId,
                ConnectedSystemName = csName,
                ActivityRunProfileExecutionItemId = change.ActivityRunProfileExecutionItemId,
                AttributeChanges = change.AttributeChanges
                    .OrderBy(ac => ac.AttributeName)
                    .SelectMany(ac => ac.ValueChanges.Select(vc => new ChangeHistoryTimeline.AttributeChange
                    {
                        AttributeName = ac.AttributeName,
                        ChangeType = vc.ValueChangeType,
                        Value = vc.ReferenceValue == null ? vc.ToString() : null,
                        ReferenceValue = vc.ReferenceValue != null ? new ChangeHistoryTimeline.ReferenceValueInfo
                        {
                            TypeName = vc.ReferenceValue.Type?.Name ?? "Unknown",
                            DisplayName = vc.ReferenceValue.NameOrId ?? vc.ReferenceValue.Id.ToString(),
                            Href = JIM.Utilities.Utilities.GetConnectedSystemObjectHref(vc.ReferenceValue)
                        } : null,
                        IsMultiValued = ac.Attribute?.AttributePlurality == AttributePlurality.MultiValued,
                        AttributeType = ac.AttributeType
                    }))
                    .ToList()
            })
            .ToList();
    }

    private List<ChangeHistoryTimeline.ChangeGroup> GetMvoHistoryAsChangeGroups()
    {
        if (_selectedMvoHistory == null)
            return new List<ChangeHistoryTimeline.ChangeGroup>();

        return _selectedMvoHistory
            .OrderByDescending(c => c.ChangeTime)
            .Select(change => new ChangeHistoryTimeline.ChangeGroup
            {
                ChangeType = change.ChangeType,
                ChangeTime = change.ChangeTime,
                ChangeInitiatorType = MapInitiatorType(change.InitiatedByType),
                ChangeInitiatorName = change.InitiatedByName,
                ChangeInitiatorId = change.InitiatedById,
                ChangeMechanismType = MapMvoChangeToMechanismType(change),
                RunProfileName = change.ActivityRunProfileExecutionItem?.Activity?.TargetName,
                ConnectedSystemId = change.ActivityRunProfileExecutionItem?.Activity?.ConnectedSystemId,
                ConnectedSystemName = change.ActivityRunProfileExecutionItem?.Activity?.TargetContext,
                SyncRuleId = change.SyncRuleId,
                SyncRuleName = change.SyncRuleName,
                ActivityRunProfileExecutionItemId = change.ActivityRunProfileExecutionItemId,
                // CSO context for Joined changes (from RPEI snapshot)
                CsoId = change.ActivityRunProfileExecutionItem?.ConnectedSystemObjectId,
                CsoExternalId = change.ActivityRunProfileExecutionItem?.ExternalIdSnapshot,
                AttributeChanges = change.AttributeChanges
                    .OrderBy(ac => ac.AttributeName)
                    .SelectMany(ac => ac.ValueChanges.Select(vc => new ChangeHistoryTimeline.AttributeChange
                    {
                        AttributeName = ac.AttributeName,
                        ChangeType = vc.ValueChangeType,
                        Value = vc.ReferenceValue == null ? vc.ToString() : null,
                        ReferenceValue = vc.ReferenceValue != null ? new ChangeHistoryTimeline.ReferenceValueInfo
                        {
                            TypeName = vc.ReferenceValue.Type?.Name ?? "Unknown",
                            DisplayName = vc.ReferenceValue.NameOrId ?? vc.ReferenceValue.Id.ToString(),
                            Href = $"/users/{vc.ReferenceValue.Id}"
                        } : null,
                        IsMultiValued = ac.Attribute?.AttributePlurality == AttributePlurality.MultiValued,
                        AttributeType = ac.AttributeType
                    }))
                    .ToList()
            })
            .ToList();
    }

    private static string MapInitiatorType(JIM.Models.Activities.ActivityInitiatorType initiatorType)
    {
        return initiatorType switch
        {
            JIM.Models.Activities.ActivityInitiatorType.User => "User",
            JIM.Models.Activities.ActivityInitiatorType.ApiKey => "ApiKey",
            _ => "Unknown"
        };
    }

    private static string MapRunTypeToMechanismType(ConnectedSystemRunType? runType)
    {
        return runType switch
        {
            ConnectedSystemRunType.FullImport or ConnectedSystemRunType.DeltaImport => "Import",
            ConnectedSystemRunType.FullSynchronisation or ConnectedSystemRunType.DeltaSynchronisation => "SynchronisationRule",
            ConnectedSystemRunType.Export => "Export",
            _ => "Import"
        };
    }

    private static string MapMvoChangeToMechanismType(MetaverseObjectChange change)
    {
        if (change.ChangeInitiatorType is MetaverseObjectChangeInitiatorType.ExampleData
            or MetaverseObjectChangeInitiatorType.User
            or MetaverseObjectChangeInitiatorType.WorkflowInstance
            or MetaverseObjectChangeInitiatorType.GroupMembershipRuleEvaluation
            or MetaverseObjectChangeInitiatorType.System)
        {
            return change.ChangeInitiatorType.ToString();
        }

        return change.ActivityRunProfileExecutionItem?.Activity?.ConnectedSystemRunType switch
        {
            ConnectedSystemRunType.FullImport or ConnectedSystemRunType.DeltaImport => "Import",
            ConnectedSystemRunType.FullSynchronisation or ConnectedSystemRunType.DeltaSynchronisation => "SynchronisationRule",
            ConnectedSystemRunType.Export => "Export",
            _ => "Import"
        };
    }
}
