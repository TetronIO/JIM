@* The Inspect view's contribution bar (#399): "Where this {Object Type} gets its values", a segmented bar   *@
@* showing each source's share of the object's attributes, and a legend that doubles as the source filter.     *@
@* When every attribute shares one origin the bar collapses to a single sentence (see the plan's Risks table). *@
@* The bar itself is decorative (aria-hidden); the legend buttons are the accessible control. *@

<div class="jim-contribution-bar-panel">
    <div class="d-flex align-baseline flex-wrap" style="gap: 8px;">
        <MudText Typo="Typo.h6">Where this @ObjectTypeName gets its values</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Provenance.Attributes.Count.ToString("N0") attributes</MudText>
    </div>

    @{ var groups = ValueOriginGrouping.BuildGroups(Provenance.Attributes); }
    @if (groups.Count <= 1)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
            All @Provenance.Attributes.Count.ToString("N0") values from @(groups.Count == 1 ? FullSourceLabel(groups[0].Group) : "Source not recorded")
        </MudText>
    }
    else
    {
        var total = Provenance.Attributes.Count;
        <div class="jim-contribution-bar" aria-hidden="true">
            @foreach (var (group, count) in groups)
            {
                var widthPercent = total == 0 ? 0 : count * 100.0 / total;
                <span class="jim-contribution-bar-segment" style="width: @(widthPercent.ToString(System.Globalization.CultureInfo.InvariantCulture))%; background: var(@ColourFor(group));" title="@($"{group.Label}: {count:N0}")"></span>
            }
        </div>

        <div class="jim-contribution-legend" role="group" aria-label="Filter attributes by source">
            @foreach (var (group, count) in groups)
            {
                var pressed = ActiveFilterKey == group.Key;
                <button type="button" class="jim-contribution-legend-item @(pressed ? "jim-contribution-legend-item-active" : null)"
                        aria-pressed="@(pressed ? "true" : "false")"
                        @onclick="@(() => ToggleFilterAsync(group.Key))">
                    <span class="jim-contribution-legend-swatch" style="background: var(@ColourFor(group));"></span>
                    <span>@group.Label</span>
                    <span class="mud-text-secondary">@count.ToString("N0")</span>
                </button>
            }
        </div>
    }
</div>

@code {
    /// <summary>The Metaverse Object's attribute origins, as loaded for the Inspect view.</summary>
    [Parameter, EditorRequired]
    public MetaverseObjectProvenance Provenance { get; set; } = null!;

    /// <summary>The Metaverse Object Type's name, for the heading ("Where this User gets its values").</summary>
    [Parameter, EditorRequired]
    public string ObjectTypeName { get; set; } = string.Empty;

    /// <summary>The currently active source filter's group key, or null when no filter is applied.</summary>
    [Parameter]
    public string? ActiveFilterKey { get; set; }

    /// <summary>
    /// Raised when a legend item is pressed: the group's key to filter to, or null when the active filter was
    /// pressed again (clearing it).
    /// </summary>
    [Parameter]
    public EventCallback<string?> OnFilterChanged { get; set; }

    private async Task ToggleFilterAsync(string key)
    {
        await OnFilterChanged.InvokeAsync(ActiveFilterKey == key ? null : key);
    }

    /// <summary>
    /// The single-source collapse sentence's label ("HR · HR Import"): unlike a legend item's compact
    /// <see cref="ValueOriginGrouping.Group.Label"/>, which elides the rule unless the same system contributes
    /// through more than one of them, the collapse sentence is the object's ONLY source and always names it in
    /// full, since there is nothing else on the bar for the rule name to disambiguate against.
    /// </summary>
    private static string FullSourceLabel(ValueOriginGrouping.Group group) => group.Kind switch
    {
        null => "Several sources",
        ValueOriginKind.SetByPerson => group.Label,
        ValueOriginKind.SynchronisationRule => group.SyncRuleDeleted
            ? $"{group.ConnectedSystemName} · rule deleted"
            : group.SyncRuleName != null
                ? $"{group.ConnectedSystemName} · {group.SyncRuleName}"
                : group.ConnectedSystemName ?? "Source not recorded",
        ValueOriginKind.GeneratedByJim => group.ConnectedSystemName == null
            ? "Generated by JIM"
            : group.SyncRuleName != null
                ? $"Generated by JIM · {group.ConnectedSystemName} · {group.SyncRuleName}"
                : $"Generated by JIM · {group.ConnectedSystemName}",
        _ => "Source not recorded"
    };

    /// <summary>
    /// A theme colour token for a source group. A Connected System keeps one colour on every object and across
    /// restarts, chosen from its id (never from a string hash: <c>string.GetHashCode()</c> is randomised per
    /// process). Values JIM generated take the primary colour and values a person set the secondary one, so those
    /// two never share a colour with a system. "Not recorded" and "several sources" take the same neutral,
    /// disabled-text token, since neither names a real source.
    /// </summary>
    private static readonly string[] SystemPaletteTokens =
    [
        "--mud-palette-info",
        "--mud-palette-tertiary",
        "--mud-palette-success",
        "--mud-palette-warning"
    ];

    private const string NeutralToken = "--mud-palette-text-disabled";

    private static string ColourFor(ValueOriginGrouping.Group group) => group.Kind switch
    {
        ValueOriginKind.GeneratedByJim => "--mud-palette-primary",
        ValueOriginKind.SetByPerson => "--mud-palette-secondary",
        ValueOriginKind.SynchronisationRule when group.ConnectedSystemId is { } systemId =>
            SystemPaletteTokens[Math.Abs(systemId % SystemPaletteTokens.Length)],
        _ => NeutralToken
    };
}
