@if (SettingValue.Setting.Type == ConnectedSystemSettingType.Heading)
{
    <MudText Typo="Typo.h6" Class="@CssClass">@SettingValue.Setting.Name</MudText>
}
else if (SettingValue.Setting.Type == ConnectedSystemSettingType.Divider)
{
    <MudDivider Class="my-4" />
}
else if (SettingValue.Setting.Type == ConnectedSystemSettingType.String && ShowDirectoryServerDiscovery)
{
    @* The one field the Discover action (issue #1167) fills in, as named by the Connector and matched by the
       parent, never by display text here. The field itself stays ordinary free text; only the administrator's
       own selection in the dialog ever writes to it. *@
    <div class="d-flex align-start @CssClass">
        <MudTextField T="string"
                      Label="@SettingValue.Setting.Name"
                      @bind-Value="SettingValue.StringValue"
                      @bind-Value:after="NotifyValueChangedAsync"
                      Immediate="@Immediate"
                      Required="@IsRequired"
                      RequiredError="@($"A {SettingValue.Setting.Name} is required")"
                      HelperText="@SettingValue.Setting.Description"
                      Variant="Variant.Outlined"
                      Class="flex-grow-1" />
        <MudTooltip Text="@($"Enter the connectivity settings above before discovering {DirectoryServerTerm}.")" Arrow="true" Placement="Placement.Top" Disabled="@DirectoryServerDiscoveryEnabled">
            <MudButton Variant="Variant.Filled" Class="ml-2 jim-field-action"
                       StartIcon="@Icons.Material.Filled.Search"
                       Disabled="@(!DirectoryServerDiscoveryEnabled)"
                       OnClick="OpenDirectoryServerDiscoveryDialogAsync"
                       data-testid="jim-discover-directory-servers">
                Discover...
            </MudButton>
        </MudTooltip>
    </div>
}
else if (SettingValue.Setting.Type == ConnectedSystemSettingType.String)
{
    <MudTextField T="string"
                  Label="@SettingValue.Setting.Name"
                  @bind-Value="SettingValue.StringValue"
                  @bind-Value:after="NotifyValueChangedAsync"
                  Immediate="@Immediate"
                  Required="@IsRequired"
                  RequiredError="@($"A {SettingValue.Setting.Name} is required")"
                  HelperText="@SettingValue.Setting.Description"
                  Variant="Variant.Outlined"
                  Class="@CssClass" />
}
else if (SettingValue.Setting.Type == ConnectedSystemSettingType.StringEncrypted)
{
    <MudTextField T="string"
                  Label="@SettingValue.Setting.Name"
                  @bind-Value="SettingValue.StringEncryptedValue"
                  @bind-Value:after="NotifyValueChangedAsync"
                  Immediate="@Immediate"
                  Required="@IsRequired"
                  RequiredError="@($"A {SettingValue.Setting.Name} is required")"
                  HelperText="@SettingValue.Setting.Description"
                  InputType="@(_passwordVisible ? InputType.Text : InputType.Password)"
                  Adornment="Adornment.End"
                  AdornmentIcon="@(_passwordVisible ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                  AdornmentAriaLabel="Toggle password visibility"
                  OnAdornmentClick="@(() => _passwordVisible = !_passwordVisible)"
                  Variant="Variant.Outlined"
                  Class="@CssClass" />
}
else if (SettingValue.Setting.Type == ConnectedSystemSettingType.Integer)
{
    <MudTextField T="int?"
                  Label="@SettingValue.Setting.Name"
                  @bind-Value="SettingValue.IntValue"
                  @bind-Value:after="NotifyValueChangedAsync"
                  Immediate="@Immediate"
                  Required="@IsRequired"
                  RequiredError="@($"A {SettingValue.Setting.Name} is required")"
                  HelperText="@SettingValue.Setting.Description"
                  InputType="InputType.Number"
                  Variant="Variant.Outlined"
                  Class="@CssClass" />
}
else if (SettingValue.Setting.Type == ConnectedSystemSettingType.CheckBox)
{
    <div class="@CssClass">
        <MudSwitch @bind-Value="SettingValue.CheckboxValue" @bind-Value:after="NotifyValueChangedAsync" Color="Color.Primary" Label="@SettingValue.Setting.Name" />
        @if (!string.IsNullOrEmpty(SettingValue.Setting.Description))
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary ml-12">@SettingValue.Setting.Description</MudText>
        }
    </div>
}
else if (SettingValue.Setting.Type == ConnectedSystemSettingType.Text)
{
    @* A multi-line document the administrator writes by hand (the SQL Connector's Object Types, for one), so
       the field is monospaced, grows with its content and does not spell-check what is code, not prose. *@
    <div class="@CssClass">
        <MudTextField T="string"
                      Label="@SettingValue.Setting.Name"
                      @bind-Value="SettingValue.StringValue"
                      @bind-Value:after="NotifyValueChangedAsync"
                      Immediate="@Immediate"
                      Required="@IsRequired"
                      RequiredError="@($"A {SettingValue.Setting.Name} is required")"
                      HelperText="@SettingValue.Setting.Description"
                      Lines="10"
                      Sizing="InputSizing.Auto"
                      MaxLines="30"
                      Variant="Variant.Outlined"
                      Class="jim-setting-text"
                      UserAttributes="@(new Dictionary<string, object?> { ["spellcheck"] = "false" })" />
        @SettingExample
    </div>
}
else if (SettingValue.Setting is { Type: ConnectedSystemSettingType.DropDown, DropDownValues: not null })
{
    <div class="@CssClass">
        <MudSelect @bind-Value="SettingValue.StringValue"
                   @bind-Value:after="NotifyValueChangedAsync"
                   HelperText="@SettingValue.Setting.Description"
                   Label="@SettingValue.Setting.Name"
                   Variant="Variant.Outlined"
                   Required="@SettingValue.Setting.Required"
                   RequiredError="@($"A {SettingValue.Setting.Name} is required")">
            @foreach (var dropDownValue in SettingValue.Setting.DropDownValues)
            {
                <MudSelectItem T="string" Value="@dropDownValue">@dropDownValue</MudSelectItem>
            }
        </MudSelect>
        @SettingExample
    </div>
}
else if (SettingValue.Setting.Type == ConnectedSystemSettingType.Label)
{
    <MudText Class="@CssClass">
        @SettingValue.Setting.Description
    </MudText>
}
else if (SettingValue.Setting.Type == ConnectedSystemSettingType.File)
{
    <MudTextField T="string"
                  Label="@SettingValue.Setting.Name"
                  @bind-Value="SettingValue.StringValue"
                  Required="@IsRequired"
                  RequiredError="@($"A {SettingValue.Setting.Name} is required")"
                  HelperText="@SettingValue.Setting.Description"
                  Variant="Variant.Outlined"
                  ReadOnly="true"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.FolderOpen"
                  OnAdornmentClick="OpenFileBrowserAsync"
                  Class="@CssClass" />
}
else
{
    <MudText Class="mt-b">Oops. Unknown setting type!</MudText>
}

@code {
    /// <summary>
    /// Renders a single Connected System setting value as the appropriate form field for its setting type.
    /// Used by ConnectedSystemSettingsTab for both standalone settings and required-group panels.
    /// </summary>
    [Parameter, EditorRequired]
    public ConnectedSystemSettingValue SettingValue { get; set; } = null!;

    /// <summary>
    /// CSS class applied to the field, used by the parent to control vertical spacing between settings.
    /// </summary>
    [Parameter]
    public string CssClass { get; set; } = string.Empty;

    /// <summary>
    /// Whether the field should be marked required. Computed by the parent via ConnectorSettingValidator so it reflects
    /// both statically-required settings and those made required by a satisfied RequiredWhen condition.
    /// </summary>
    [Parameter]
    public bool IsRequired { get; set; }

    /// <summary>
    /// Whether the Connected System is in export-only mode; affects the file browser dialog behaviour.
    /// </summary>
    [Parameter]
    public bool IsExportOnlyMode { get; set; }

    /// <summary>
    /// When true, text fields update their bound value on every keystroke rather than on blur.
    /// Used for required-group members so group feedback responds as the administrator types.
    /// </summary>
    [Parameter]
    public bool Immediate { get; set; }

    /// <summary>
    /// Raised after the administrator changes the setting's value, so the parent can refresh dependent UI state.
    /// </summary>
    [Parameter]
    public EventCallback ValueChanged { get; set; }

    /// <summary>
    /// Raised after a file is selected via the file browser dialog, so the parent can revalidate the form.
    /// </summary>
    [Parameter]
    public EventCallback FileSelected { get; set; }

    /// <summary>
    /// Whether this field is the one the Discover action (issue #1167) targets, and so should render a
    /// Discover... action beside it. The parent decides this by matching the setting's name against the target
    /// the Connected System's Connector names through <c>IConnectorDirectoryServers</c>; this component renders
    /// whatever it is told without knowing why.
    /// </summary>
    [Parameter]
    public bool ShowDirectoryServerDiscovery { get; set; }

    /// <summary>
    /// Whether the Discover... action is currently usable. The parent gates this on the Connected System's
    /// connectivity settings being populated, so an administrator cannot open the dialog before there is
    /// anything to connect with.
    /// </summary>
    [Parameter]
    public bool DirectoryServerDiscoveryEnabled { get; set; }

    /// <summary>
    /// The Connected System the Discover... action discovers servers for. Only meaningful when
    /// <see cref="ShowDirectoryServerDiscovery"/> is true.
    /// </summary>
    [Parameter]
    public int ConnectedSystemId { get; set; }

    /// <summary>
    /// Supplies the connectivity settings as they currently stand on screen when the Discover... action runs, so
    /// discovery looks at the endpoint the administrator is configuring rather than whatever was last saved.
    /// Invoked at click time to pick up the freshest values.
    /// </summary>
    [Parameter]
    public Func<IReadOnlyCollection<ConnectedSystemSettingValueDraft>>? DirectoryServerDiscoveryDraftSettings { get; set; }

    /// <summary>
    /// What the Connector calls the servers the Discover... action finds, plural and lower case (e.g. "domain
    /// controllers"), for the tooltip and the dialog. Only meaningful when <see cref="ShowDirectoryServerDiscovery"/>
    /// is true.
    /// </summary>
    [Parameter]
    public string? DirectoryServerTerm { get; set; }

    private bool _passwordVisible;

    /// <summary>
    /// The setting's Example, when the Connector supplies one: shown verbatim as a code block beneath the field,
    /// with a Copy action, so an administrator writing a document by hand has a complete one to start from.
    /// </summary>
    private RenderFragment SettingExample => __builder =>
    {
        var example = SettingValue.Setting.Example;
        if (string.IsNullOrWhiteSpace(example))
            return;

        <div class="jim-setting-example mt-2 mx-3" data-testid="jim-setting-example">
            <div class="d-flex align-center justify-space-between">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Example</MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="CopyExampleToClipboardAsync">Copy</MudButton>
            </div>
            <pre class="jim-code-block"><code>@((MarkupString)(IsJson(example) ? Helpers.HighlightJson(example) : System.Net.WebUtility.HtmlEncode(example)))</code></pre>
        </div>
    };

    private static bool IsJson(string value)
    {
        var trimmed = value.TrimStart();
        return trimmed.StartsWith('{') || trimmed.StartsWith('[');
    }

    private async Task CopyExampleToClipboardAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", SettingValue.Setting.Example);
            Snackbar.Add("Example copied to clipboard.", Severity.Info);
        }
        catch (JSException)
        {
            Snackbar.Add("Failed to copy to clipboard. Please copy manually.", Severity.Warning);
        }
        catch (JSDisconnectedException)
        {
            // The circuit has gone; there is nobody left to tell.
        }
    }

    private Task NotifyValueChangedAsync()
    {
        return ValueChanged.InvokeAsync();
    }

    private async Task OpenFileBrowserAsync()
    {
        var title = IsExportOnlyMode ? "Select Export Location" : "Select File";

        var parameters = new DialogParameters<FileBrowserDialog>
        {
            { x => x.Title, title },
            { x => x.AllowNewFilename, IsExportOnlyMode },
            { x => x.InitialPath, SettingValue.StringValue }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<FileBrowserDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string selectedPath })
        {
            SettingValue.StringValue = selectedPath;
            await ValueChanged.InvokeAsync();
            await FileSelected.InvokeAsync();
        }
    }

    /// <summary>
    /// Opens the Discover dialog and, only if the administrator selects a server,
    /// fills this field with their choice. The setting is intent and the pin JIM later records against it is
    /// fact (issue #1167): discovery only ever informs the administrator's decision here, it never writes to
    /// the field on its own, and cancelling or closing the dialog leaves the field exactly as it was.
    /// </summary>
    private async Task OpenDirectoryServerDiscoveryDialogAsync()
    {
        var selectedHostName = await DirectoryServerDiscoveryDialog.ShowAsync(DialogService, ConnectedSystemId, DirectoryServerTerm, DirectoryServerDiscoveryDraftSettings?.Invoke());
        if (string.IsNullOrEmpty(selectedHostName))
            return;

        SettingValue.StringValue = selectedHostName;
        await ValueChanged.InvokeAsync();
    }
}
