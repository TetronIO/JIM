<MudDialog>
    <DialogContent>
        <MudForm @bind-IsValid="_formValid">
            @if (_isEdit)
            {
                <PrefilledFormValidator />
            }
            <MudStack Spacing="4">
                @* ─── Name (live uniqueness) ─── *@
                <MudTextField @bind-Value="_name"
                              Label="@CommonText.FieldName"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@AdminText.AttrEditorNameRequired"
                              Immediate="true"
                              DebounceInterval="300"
                              OnDebounceIntervalElapsed="OnNameChangedAsync"
                              Error="_nameError != null"
                              ErrorText="@_nameError"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_checkingName ? Icons.Material.Filled.HourglassEmpty : (_nameError == null && !string.IsNullOrWhiteSpace(_name) ? Icons.Material.Filled.CheckCircle : null))"
                              AutoFocus="@(!ReadOnly)"
                              Disabled="@ReadOnly" />

                <div class="d-flex gap-4">
                    <MudSelect @bind-Value="_type" @bind-Value:after="OnTypeChanged" T="AttributeDataType" Label="@AdminText.AttrEditorDataType" Variant="Variant.Outlined"
                               Required="true" RequiredError="@AdminText.AttrEditorDataTypeRequired" Class="flex-grow-1"
                               Disabled="@(ReadOnly || TypeLocked)" HelperText="@TypeHelperText()">
                        @foreach (var type in _selectableTypes)
                        {
                            <MudSelectItem Value="type">@type.ForDisplay()</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect @bind-Value="_plurality" T="AttributePlurality" Label="@AdminText.SchemaPlurality" Variant="Variant.Outlined"
                               Required="true" Class="flex-grow-1" Disabled="@(ReadOnly || PluralityLocked)" HelperText="@PluralityHelperText()">
                        <MudSelectItem Value="AttributePlurality.SingleValued">@AdminText.AttrEditorSingleValued</MudSelectItem>
                        <MudSelectItem Value="AttributePlurality.MultiValued" Disabled="@(!AttributeDataTypeCapabilities.SupportsMultiValued(_type))">@AdminText.AttrEditorMultiValued</MudSelectItem>
                    </MudSelect>
                </div>

                @if (_plurality == AttributePlurality.MultiValued)
                {
                    <MudSelect @bind-Value="_renderingHint" T="AttributeRenderingHint" Label="@AdminText.AttrEditorRenderingHint" Variant="Variant.Outlined"
                               HelperText="@AdminText.AttrEditorRenderingHelper" Disabled="@ReadOnly">
                        <MudSelectItem Value="AttributeRenderingHint.Default">@AdminText.AttrEditorRenderDefault</MudSelectItem>
                        <MudSelectItem Value="AttributeRenderingHint.Table">@AdminText.AttrEditorRenderTable</MudSelectItem>
                        <MudSelectItem Value="AttributeRenderingHint.ChipSet">@AdminText.AttrEditorRenderChipSet</MudSelectItem>
                        <MudSelectItem Value="AttributeRenderingHint.List">@AdminText.AttrEditorRenderList</MudSelectItem>
                    </MudSelect>
                }

                @* ─── Create-time bindings (create only) ─── *@
                @if (!_isEdit)
                {
                    <MudSelect T="int" Label="@AdminText.AttrEditorAddToObjectTypes" Variant="Variant.Outlined"
                               MultiSelection="true" @bind-SelectedValues="_selectedObjectTypeIds"
                               MultiSelectionTextFunc="@(selected => string.Join(", ", selected.Select(s => int.TryParse(s, out var id) ? NameForObjectTypeId(id) : s)))"
                               HelperText="@AdminText.AttrEditorObjectTypesHelper">
                        @foreach (var objectType in _objectTypes)
                        {
                            <MudSelectItem T="int" Value="objectType.Id">@objectType.Name</MudSelectItem>
                        }
                    </MudSelect>
                }

                @* ─── Standard Mappings ─── *@
                <div>
                    <MudText Typo="Typo.subtitle2">@AdminText.AttrEditorStandardMappings</MudText>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @AdminText.AttrEditorStandardMappingsIntro
                        @if (ReadOnly)
                        {
                            <text> @AdminText.AttrEditorBuiltInMaintained</text>
                        }
                    </MudText>
                </div>

                @if (_mappings.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@AdminText.AttrEditorNoMappings</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true">
                        <thead>
                            <tr>
                                <th>@AdminText.AttrEditorColStandard</th>
                                <th>@AdminText.AttrEditorColCounterpart</th>
                                <th>@AdminText.AttrEditorColNotes</th>
                                @if (!ReadOnly)
                                {
                                    <th></th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mapping in _mappings)
                            {
                                <tr>
                                    <td>@StandardLabel(mapping.Standard)</td>
                                    <td>@mapping.CounterpartName</td>
                                    <td>
                                        @if (string.IsNullOrEmpty(mapping.Notes))
                                        {
                                            <EmptyValue />
                                        }
                                        else
                                        {
                                            @mapping.Notes
                                        }
                                    </td>
                                    @if (!ReadOnly)
                                    {
                                        <td>
                                            <div class="d-flex justify-end">
                                                <MudTooltip Text="@AdminText.AttrEditorEditMapping" Arrow="true" Placement="Placement.Top">
                                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Disabled="@(_editingMapping != null)"
                                                                   OnClick="@(() => EditMapping(mapping))" />
                                                </MudTooltip>
                                                <MudTooltip Text="@AdminText.AttrEditorRemoveMapping" Arrow="true" Placement="Placement.Top">
                                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Disabled="@(_editingMapping != null)"
                                                                   OnClick="@(() => RemoveMapping(mapping))" />
                                                </MudTooltip>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }

                @if (!ReadOnly && _editingMapping == null)
                {
                    <div>
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" OnClick="AddMapping">
                            @AdminText.AttrEditorAddMapping
                        </MudButton>
                    </div>
                }

                @if (_editingMapping != null)
                {
                    var editingMapping = _editingMapping;
                    <div class="d-flex gap-4">
                        <MudSelect @bind-Value="editingMapping.Standard" T="AttributeStandard" Label="@AdminText.AttrEditorColStandard" Variant="Variant.Outlined" Class="flex-grow-1">
                            @foreach (var standard in _selectableStandards)
                            {
                                <MudSelectItem Value="standard">@StandardLabel(standard)</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="editingMapping.CounterpartName" Label="@AdminText.AttrEditorColCounterpart" Variant="Variant.Outlined"
                                      Immediate="true" Class="flex-grow-1"
                                      HelperText="@AdminText.AttrEditorCounterpartHelper" />
                    </div>
                    <MudTextField @bind-Value="editingMapping.Notes" Label="@AdminText.AttrEditorNotesOptional" Variant="Variant.Outlined" Immediate="true" />
                    @if (MappingEditorError() is { } mappingError)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Error">@mappingError</MudText>
                    }
                    <div class="d-flex justify-end gap-2">
                        <MudButton OnClick="CancelMappingEdit">@CommonText.Cancel</MudButton>
                        <MudButton Variant="Variant.Filled" Disabled="@(!CanSaveMapping())" OnClick="SaveMapping">
                            @(_editingMappingIsNew ? CommonText.Add : AdminText.AttrEditorUpdate)
                        </MudButton>
                    </div>
                }
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        @if (ReadOnly)
        {
            <MudButton OnClick="Cancel">@CommonText.Close</MudButton>
        }
        else
        {
            <MudButton OnClick="Cancel">@CommonText.Cancel</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       Disabled="@(!CanSubmit())" OnClick="SubmitAsync">
                @(_isEdit ? CommonText.SaveChanges : AdminText.AttrEditorCreateButton)
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// The attribute being edited. Null opens the dialog in create mode.
    /// </summary>
    [Parameter]
    public MetaverseAttribute? Attribute { get; set; }

    /// <summary>
    /// When true the dialog is a read-only view: all fields are disabled and nothing can be saved.
    /// Used to inspect built-in attributes, whose definition and Standard Mappings are maintained by JIM.
    /// </summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    private bool _isEdit;
    private bool _formValid;

    private string _name = string.Empty;
    private AttributeDataType _type = AttributeDataType.Text;
    private AttributePlurality _plurality = AttributePlurality.SingleValued;
    private AttributeRenderingHint _renderingHint = AttributeRenderingHint.Default;
    private IReadOnlyCollection<int> _selectedObjectTypeIds = new HashSet<int>();

    private string? _nameError;
    private bool _checkingName;
    private int _valuesCount;

    // Original values (edit) to detect what actually changed.
    private string _originalName = string.Empty;
    private AttributeDataType _originalType;
    private AttributePlurality _originalPlurality;
    private AttributeRenderingHint _originalRenderingHint;

    private IList<MetaverseObjectType> _objectTypes = new List<MetaverseObjectType>();

    // Working copies of the attribute's Standard Mappings; mutations stay in memory until the dialog saves.
    private List<MetaverseAttributeStandardMapping> _mappings = new();
    private MetaverseAttributeStandardMapping? _editingMapping;
    private bool _editingMappingIsNew;
    private int _editingMappingIndex = -1;

    // NotSet is an internal sentinel, never selectable by an administrator.
    private readonly AttributeDataType[] _selectableTypes =
        Enum.GetValues<AttributeDataType>().Where(t => t != AttributeDataType.NotSet).ToArray();

    private readonly AttributeStandard[] _selectableStandards =
        Enum.GetValues<AttributeStandard>().Where(s => s != AttributeStandard.NotSet).ToArray();

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();

        if (Attribute != null)
        {
            _isEdit = true;
            _name = Attribute.Name;
            _type = Attribute.Type;
            _plurality = Attribute.AttributePlurality;
            _renderingHint = Attribute.RenderingHint;
            _originalName = Attribute.Name;
            _originalType = Attribute.Type;
            _originalPlurality = Attribute.AttributePlurality;
            _originalRenderingHint = Attribute.RenderingHint;
            _mappings = Attribute.StandardMappings
                .OrderBy(m => m.Standard).ThenBy(m => m.CounterpartName, StringComparer.Ordinal)
                .Select(m => new MetaverseAttributeStandardMapping { Standard = m.Standard, CounterpartName = m.CounterpartName, Notes = m.Notes })
                .ToList();

            if (!ReadOnly)
            {
                // Stored values decide which schema changes are allowed; see TypeLocked and PluralityLocked.
                var schemaImpact = await jim.Metaverse.EvaluateAttributeSchemaChangeAsync(Attribute, Attribute.Type, Attribute.AttributePlurality);
                _valuesCount = schemaImpact.TotalObjectsWithValues;
            }
        }
        else
        {
            var types = await jim.Metaverse.GetMetaverseObjectTypesAsync(false);
            _objectTypes = types?.OrderBy(t => t.Name).ToList() ?? new List<MetaverseObjectType>();
        }
    }

    /// <summary>
    /// The Boolean rule: a Boolean attribute holds one value, so choosing a type that cannot be multi-valued resets
    /// a multi-valued choice to single-valued (the Multi-valued option is disabled while it stays chosen).
    /// </summary>
    private void OnTypeChanged()
    {
        _plurality = AttributeDataTypeCapabilities.Constrain(_type, _plurality);
    }

    /// <summary>
    /// True when Metaverse Objects hold values for the attribute being edited. While they do, the only schema change
    /// JIM allows is a lossless widening: the same data type, single-valued to multi-valued.
    /// </summary>
    private bool HoldsValues => _isEdit && _valuesCount > 0;

    /// <summary>
    /// A data type change is never a widening, so stored values always lock the type.
    /// </summary>
    private bool TypeLocked => HoldsValues;

    /// <summary>
    /// Plurality stays open while values exist only where multi-valued would be a lossless widening of the attribute
    /// as saved, i.e. a single-valued attribute whose type can be multi-valued. Choosing single-valued again is simply
    /// no change.
    /// </summary>
    private bool PluralityLocked => HoldsValues &&
        (!AttributeDataTypeCapabilities.SupportsMultiValued(_originalType) ||
         !AttributeSchemaChangeImpact.IsLosslessWideningChange(_originalType, _originalPlurality, _originalType, AttributePlurality.MultiValued));

    private string ValuesHeldPhrase() => FormatCount(_valuesCount, AdminText.AttrEditorValuesHeldOne, AdminText.AttrEditorValuesHeldOther);

    private static string FormatCount(int count, string one, string other) =>
        string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(count, one, other), count.ToString("N0", CultureInfo.CurrentCulture));

    private string? TypeHelperText() => ReadOnly || !TypeLocked
        ? null
        : string.Format(CultureInfo.CurrentCulture, AdminText.AttrEditorTypeLocked, ValuesHeldPhrase());

    private string? PluralityHelperText()
    {
        if (ReadOnly)
            return null;

        if (!AttributeDataTypeCapabilities.SupportsMultiValued(_type))
            return AdminText.AttrEditorBooleanHelper;

        if (!HoldsValues)
            return null;

        return PluralityLocked
            ? string.Format(CultureInfo.CurrentCulture, AdminText.AttrEditorPluralityLocked, ValuesHeldPhrase())
            : AdminText.AttrEditorPluralityWiden;
    }

    private static string StandardLabel(AttributeStandard standard) => standard switch
    {
        AttributeStandard.Scim => "SCIM 2.0",
        AttributeStandard.Ldap => "LDAP/AD",
        AttributeStandard.Jim => "JIM",
        _ => standard.ForDisplay()
    };

    private string NameForObjectTypeId(int id) =>
        _objectTypes.FirstOrDefault(t => t.Id == id)?.Name ?? id.ToString();

    private async Task OnNameChangedAsync()
    {
        var trimmed = _name?.Trim() ?? string.Empty;
        if (string.IsNullOrEmpty(trimmed))
        {
            _nameError = null;
            return;
        }

        // No round-trip when the name is unchanged on an edit.
        if (_isEdit && string.Equals(trimmed, _originalName, StringComparison.OrdinalIgnoreCase))
        {
            _nameError = null;
            return;
        }

        _checkingName = true;
        StateHasChanged();
        try
        {
            using var jim = JimFactory.Create();
            var unique = await jim.Metaverse.IsMetaverseAttributeNameUniqueAsync(trimmed, Attribute?.Id);
            _nameError = unique
                ? null
                : string.Format(CultureInfo.CurrentCulture, AdminText.AttrEditorNameTaken, trimmed);
        }
        finally
        {
            _checkingName = false;
            StateHasChanged();
        }
    }

    private bool CanSubmit()
    {
        if (ReadOnly || !_formValid || _checkingName || _nameError != null || string.IsNullOrWhiteSpace(_name))
            return false;

        // A Standard Mapping row mid-edit must be applied or cancelled before the dialog can save.
        if (_editingMapping != null)
            return false;

        // On edit, require at least one actual change.
        if (_isEdit && !HasChanges())
            return false;

        return true;
    }

    private bool HasChanges() =>
        !string.Equals(_name.Trim(), _originalName, StringComparison.Ordinal) ||
        _type != _originalType ||
        _plurality != _originalPlurality ||
        _renderingHint != _originalRenderingHint ||
        MappingsChanged();

    private bool MappingsChanged()
    {
        var original = Attribute?.StandardMappings ?? new List<MetaverseAttributeStandardMapping>();
        if (original.Count != _mappings.Count)
            return true;

        return !_mappings.All(m => original.Any(o =>
            o.Standard == m.Standard &&
            string.Equals(o.CounterpartName, m.CounterpartName, StringComparison.Ordinal) &&
            string.Equals(o.Notes ?? string.Empty, m.Notes ?? string.Empty, StringComparison.Ordinal)));
    }

    private void AddMapping()
    {
        _editingMapping = new MetaverseAttributeStandardMapping { Standard = AttributeStandard.Scim, CounterpartName = string.Empty };
        _editingMappingIsNew = true;
        _editingMappingIndex = -1;
    }

    private void EditMapping(MetaverseAttributeStandardMapping mapping)
    {
        _editingMapping = new MetaverseAttributeStandardMapping { Standard = mapping.Standard, CounterpartName = mapping.CounterpartName, Notes = mapping.Notes };
        _editingMappingIsNew = false;
        _editingMappingIndex = _mappings.IndexOf(mapping);
    }

    private void RemoveMapping(MetaverseAttributeStandardMapping mapping) => _mappings.Remove(mapping);

    private void CancelMappingEdit()
    {
        _editingMapping = null;
        _editingMappingIndex = -1;
    }

    /// <summary>
    /// The single source of the row editor's blocking checks; <see cref="CanSaveMapping"/> gates the button on it.
    /// </summary>
    private string? MappingEditorError()
    {
        if (_editingMapping == null)
            return null;

        if (string.IsNullOrWhiteSpace(_editingMapping.CounterpartName))
            return null; // incomplete rather than wrong; the button stays disabled without shouting

        var trimmed = _editingMapping.CounterpartName.Trim();
        var duplicate = _mappings
            .Where((_, index) => index != _editingMappingIndex)
            .Any(m => m.Standard == _editingMapping.Standard && string.Equals(m.CounterpartName, trimmed, StringComparison.Ordinal));
        return duplicate ? string.Format(CultureInfo.CurrentCulture, AdminText.AttrEditorMappingDuplicate, StandardLabel(_editingMapping.Standard), trimmed) : null;
    }

    private bool CanSaveMapping() =>
        _editingMapping != null &&
        _editingMapping.Standard != AttributeStandard.NotSet &&
        !string.IsNullOrWhiteSpace(_editingMapping.CounterpartName) &&
        MappingEditorError() == null;

    private void SaveMapping()
    {
        if (_editingMapping == null || !CanSaveMapping())
            return;

        var saved = new MetaverseAttributeStandardMapping
        {
            Standard = _editingMapping.Standard,
            CounterpartName = _editingMapping.CounterpartName.Trim(),
            Notes = string.IsNullOrWhiteSpace(_editingMapping.Notes) ? null : _editingMapping.Notes.Trim()
        };

        if (_editingMappingIndex >= 0 && _editingMappingIndex < _mappings.Count)
            _mappings[_editingMappingIndex] = saved;
        else
            _mappings.Add(saved);

        CancelMappingEdit();
    }

    private async Task SubmitAsync()
    {
        using var jim = JimFactory.Create();

        if (_isEdit && !string.Equals(_name.Trim(), _originalName, StringComparison.OrdinalIgnoreCase))
        {
            // An Expression reading the attribute by name would read nothing after a rename, so the rename is refused;
            // checked before anything is saved, so a refused rename never leaves the dialog's other edits half-applied.
            var readers = await jim.Metaverse.GetMetaverseAttributeExpressionReadersAsync(Attribute!.Id, _originalName);
            if (readers.Count > 0)
            {
                Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.AttrEditorRenameBlocked, _originalName, string.Join("; ", readers.Select(r => r.Description))), Severity.Error);
                return;
            }
        }

        if (_isEdit)
        {
            // ask the administrator to acknowledge anything sync-affecting first (a type or plurality change reshapes
            // every Attribute Flow targeting this attribute); a rename or a Standard Mapping edit shows nothing.
            var preflight = await jim.ConfigurationChangePreflight.EvaluateMetaverseAttributeAsync(BuildProposedAttribute());
            if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                    AdminText.SchemaNounAttributeSingular, _name.Trim()))
                return;
        }

        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, _isEdit ? CommonText.Save : CommonText.Create);
        if (cancelled)
            return;

        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        var trimmedName = _name.Trim();

        try
        {
            if (_isEdit)
            {
                await ApplyEditAsync(jim, user, changeReason);
            }
            else
            {
                var attribute = new MetaverseAttribute
                {
                    Name = trimmedName,
                    Type = _type,
                    AttributePlurality = _plurality,
                    RenderingHint = _plurality == AttributePlurality.MultiValued ? _renderingHint : AttributeRenderingHint.Default,
                    Created = DateTime.UtcNow,
                    MetaverseObjectTypes = new List<MetaverseObjectType>()
                };
                await jim.Metaverse.CreateMetaverseAttributeAsync(attribute, user, changeReason);

                foreach (var objectTypeId in _selectedObjectTypeIds)
                    await jim.Metaverse.BindAttributeToObjectTypeAsync(attribute.Id, objectTypeId, user, changeReason);

                if (_mappings.Count > 0)
                    await jim.Metaverse.UpdateMetaverseAttributeStandardMappingsAsync(attribute.Id, _mappings, user, changeReason);

                Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.AttrEditorCreated, trimmedName), Severity.Success);
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.AttrEditorSaveFailed, ex.Message), Severity.Error);
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));
    }

    /// <summary>
    /// The attribute as this dialog is about to leave it, for the preflight to compare against its last captured
    /// snapshot. <see cref="ApplyEditAsync"/> gets there through several separate calls (schema, rename, rendering
    /// hint, Standard Mappings) rather than one entity save, so the proposed state has to be assembled here; the two
    /// must stay in step, and every field either one touches is set below.
    /// </summary>
    private MetaverseAttribute BuildProposedAttribute() => new()
    {
        Id = Attribute!.Id,
        Name = _name.Trim(),
        Type = _type,
        AttributePlurality = _plurality,
        BuiltIn = Attribute.BuiltIn,
        // Matches ApplyEditAsync, which only writes the rendering hint for a multi-valued attribute.
        RenderingHint = _plurality == AttributePlurality.MultiValued ? _renderingHint : Attribute.RenderingHint,
        // Object Type associations are not editable once an attribute exists, so they carry over untouched.
        MetaverseObjectTypes = Attribute.MetaverseObjectTypes,
        StandardMappings = _mappings
    };

    private async Task ApplyEditAsync(JimApplication jim, MetaverseObject user, string? changeReason)
    {
        var attributeId = Attribute!.Id;
        var trimmedName = _name.Trim();

        // Schema change (type / plurality) via the gated path.
        if (_type != _originalType || _plurality != _originalPlurality)
        {
            var impact = await jim.Metaverse.ChangeMetaverseAttributeSchemaAsync(attributeId, _type, _plurality, user, changeReason);
            if (!impact.Applied)
            {
                Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.AttrEditorSchemaRefused, impact.TotalObjectsWithValues.ToString("N0", CultureInfo.CurrentCulture)), Severity.Error);
                return;
            }
        }

        // Rename.
        if (!string.Equals(trimmedName, _originalName, StringComparison.Ordinal))
            await jim.Metaverse.RenameMetaverseAttributeAsync(attributeId, trimmedName, user, changeReason);

        // Rendering hint (multi-valued only).
        if (_plurality == AttributePlurality.MultiValued && _renderingHint != _originalRenderingHint)
        {
            var attribute = await jim.Metaverse.GetMetaverseAttributeAsync(attributeId);
            if (attribute != null)
            {
                attribute.RenderingHint = _renderingHint;
                await jim.Metaverse.UpdateMetaverseAttributeAsync(attribute, user, changeReason);
            }
        }

        // Standard Mappings (full replacement of the advisory metadata).
        if (MappingsChanged())
            await jim.Metaverse.UpdateMetaverseAttributeStandardMappingsAsync(attributeId, _mappings, user, changeReason);

        Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.AttrEditorSaved, trimmedName), Severity.Success);
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>
    /// Opens the create/edit dialog. Pass an attribute to edit, or null to create; pass readOnly to view an
    /// attribute (used for built-ins) without any editing affordances. Returns true when a change was saved.
    /// </summary>
    public static async Task<bool> ShowAsync(IDialogService dialogService, MetaverseAttribute? attribute = null, bool readOnly = false)
    {
        var parameters = new DialogParameters<MetaverseAttributeEditorDialog>
        {
            { x => x.Attribute, attribute },
            { x => x.ReadOnly, readOnly }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var title = attribute == null
            ? AdminText.SchemaNewAttribute
            : readOnly
                ? string.Format(CultureInfo.CurrentCulture, AdminText.AttrEditorViewTitle, attribute.Name)
                : string.Format(CultureInfo.CurrentCulture, AdminText.AttrEditorEditTitle, attribute.Name);
        var dialog = await dialogService.ShowAsync<MetaverseAttributeEditorDialog>(title, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: true };
    }
}
