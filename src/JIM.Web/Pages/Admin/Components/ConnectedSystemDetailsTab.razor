@using JIM.Models.Staging
@inject IJimApplicationFactory JimFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<MudPaper Class="pa-4" Outlined="true">
    @* Above the form rather than under it: what JIM knows about the target reads before what the administrator
       named it. Renders nothing when the Connector cannot detect facts about its target; see the component. *@
    <ConnectedSystemDetectedFacts Capabilities="_capabilities" />

    <MudForm @bind-IsValid="@IsDetailsFormValid" @bind-Errors="@DetailsFormErrors">
        <PrefilledFormValidator />
        <MudTextField T="string" Label="Connector" @bind-Value="ConnectedSystem.ConnectorDefinition.Name" Disabled="true" Variant="Variant.Outlined" />
        <MudTextField T="string" Label="Name" @bind-Value="ConnectedSystem.Name" Required="true" RequiredError="A name is required" Immediate="true" Variant="Variant.Outlined" Class="mt-5" />
        <MudTextField T="string" Label="Description" Required="false" @bind-Value="ConnectedSystem.Description" Lines="5" MaxLines="10" Sizing="InputSizing.Auto" Variant="Variant.Outlined" Class="mt-5" />
    </MudForm>
    @* mt-3 (+ the input control's own 4px bottom margin) gives a 16px gap, matching the panel's pa-4 padding below the button so it sits symmetrically inside the panel *@
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!IsDetailsFormValid)" Class="mt-3" OnClick="HandleValidDetailsSubmitAsync" DropShadow="false">Save Changes</MudButton>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool IsDetailsFormValid { get; set; }
    private string[] DetailsFormErrors { get; set; } = [];
    // Null means the Connector does not support capability detection and the strip is not rendered; an empty
    // list means it does but nothing has been detected yet, rendered as a single line saying so.
    private List<ConnectorCapability>? _capabilities;
    private int _capabilitiesLoadedForConnectedSystemId;

    protected override async Task OnParametersSetAsync()
    {
        if (ConnectedSystem.Id <= 0)
        {
            _capabilities = null;
            return;
        }

        // OnParametersSetAsync fires on every parent re-render; only reload when the Connected System changes.
        if (ConnectedSystem.Id == _capabilitiesLoadedForConnectedSystemId)
            return;

        using var jim = JimFactory.Create();
        _capabilities = await jim.ConnectedSystems.GetConnectedSystemDetectedCapabilitiesAsync(ConnectedSystem.Id);
        _capabilitiesLoadedForConnectedSystemId = ConnectedSystem.Id;
    }

    private async Task HandleValidDetailsSubmitAsync()
    {
        using var jim = JimFactory.Create();

        // ask the administrator to acknowledge anything sync-affecting they are about to save, before asking why they
        // are saving it. Every tab edits the one shared Connected System, so the preflight covers whatever they have
        // touched, not just this tab's fields; a cosmetic edit shows nothing at all.
        var preflight = await jim.ConfigurationChangePreflight.EvaluateConnectedSystemAsync(ConnectedSystem);
        if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                "Connected System", ConnectedSystem.Name))
            return;

        // offer an optional reason for the configuration change history; cancelling aborts the save
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
        if (cancelled)
            return;

        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.ConnectedSystems.UpdateConnectedSystemAsync(ConnectedSystem, user, changeReason);
        Snackbar.Add("Your details changes have been saved.", Severity.Success);
    }
}
