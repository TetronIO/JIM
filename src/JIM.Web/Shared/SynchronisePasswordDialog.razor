<MudDialog>
    <DialogContent>
        @if (_stage == Stage.Composing)
        {
            <MudText Class="mud-text-secondary mb-4">
                Records that @DisplayNameOrThisPerson's password has changed and delivers it to the
                @TargetSystemCount Connected System@(TargetSystemCount == 1 ? "" : "s") configured to receive
                synchronised passwords. Delivery is retried if a system is unavailable, so nothing is lost while one
                is down.
            </MudText>

            <MudTextField T="string" @bind-Value="_password" Label="New password" Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                          AdornmentAriaLabel="@(_showPassword ? "Hide the password" : "Show the password")"
                          Immediate="true"
                          data-testid="jim-sync-password-password"
                          HelperText="JIM holds this encrypted until it is delivered, and never shows it again." />

            <MudSelect T="PasswordExpiryBehaviour" @bind-Value="_expiryBehaviour" Class="mt-4"
                       Label="Once each system has it" Variant="Variant.Outlined">
                <MudSelectItem T="PasswordExpiryBehaviour" Value="PasswordExpiryBehaviour.ExpiresAccordingToTargetPolicy">
                    Expires according to each system's own policy
                </MudSelectItem>
                <MudSelectItem T="PasswordExpiryBehaviour" Value="PasswordExpiryBehaviour.RequireChangeAtNextSignIn">
                    Must be changed at next sign-in
                </MudSelectItem>
                <MudSelectItem T="PasswordExpiryBehaviour" Value="PasswordExpiryBehaviour.NeverExpires">
                    Never expires
                </MudSelectItem>
            </MudSelect>

            @* The default is deliberate and worth saying out loud: this password came from the person, so demanding
               they choose another one immediately would defeat the point of synchronising the one they just set. *@
            @if (_expiryBehaviour == PasswordExpiryBehaviour.RequireChangeAtNextSignIn)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
                    This asks every system to make @DisplayNameOrThisPerson choose a new password at next sign-in. If
                    they chose this one themselves, leave it on the system's own policy instead.
                </MudAlert>
            }
        }
        else
        {
            @* ─── Delivering: one row per Connected System, updated as each answers ─── *@
            @* The dialog stays open past queueing (#1635) because "queued" told an administrator nothing they
               could act on. The Password Delivery Service answers in about a second, so the rows below usually
               settle while the dialog is still being read; the wait is bounded, and a change that outlasts it is
               followed on the Passwords tab rather than here. *@
            <MudText Class="mud-text-secondary mb-4">
                @DeliveringSummary
            </MudText>

            <MudPaper Outlined="true" Class="pa-0 jim-password-results" data-testid="jim-sync-password-outcomes">
                @foreach (var target in _targets)
                {
                    var failed = PasswordChangeTargetDisplay.IsFailure(target.State);
                    <div @key="target.ConnectedSystemId"
                         class="jim-password-result jim-password-row @(failed ? "jim-password-result--failed" : "")"
                         data-testid="jim-sync-password-outcome" data-state="@target.State">
                        <MudIcon Icon="@PasswordChangeTargetDisplay.Icon(target.State)"
                                 Color="@PasswordChangeTargetDisplay.Colour(target.State)"
                                 Class="jim-password-result-icon" />
                        <div class="jim-password-result-body">
                            <MudText Typo="Typo.body2" Class="jim-password-system-name">@target.ConnectedSystemName</MudText>
                            <MudText Typo="Typo.body2" Class="@(failed ? "jim-password-result-reason" : "mud-text-secondary")">
                                @PasswordChangeTargetDisplay.Words(target)
                            </MudText>
                        </div>
                    </div>
                }
            </MudPaper>

            @if (_waitRanOut)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4" data-testid="jim-sync-password-still-delivering">
                    Still delivering. The change is safely queued and will be retried if a system is unavailable;
                    follow it on the <MudLink Href="@QueueHref">Passwords tab of Operations</MudLink>.
                </MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        @if (_stage == Stage.Composing)
        {
            <MudButton OnClick="Cancel" Disabled="@_queueing">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       Disabled="@(_queueing || string.IsNullOrWhiteSpace(_password))"
                       OnClick="QueueAsync" data-testid="jim-sync-password-submit">
                @(_queueing ? "Synchronising..." : "Synchronise Password")
            </MudButton>
        }
        else
        {
            @* Done rather than a disabled wait: the delivery does not need the dialog open to finish. *@
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                       OnClick="Done" data-testid="jim-sync-password-done">
                @if (_following)
                {
                    <MudProgressCircular Class="ms-n1" Indeterminate="true" Size="Size.Small" />
                    <span class="ms-2">Done</span>
                }
                else
                {
                    <span>Done</span>
                }
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// How often the rows are refreshed while the change is being followed. Each slice is one call to the waiter,
    /// which returns early the moment every target settles, so a change that lands in 800 ms is shown in 800 ms and
    /// one that takes longer is shown moving once a second.
    /// </summary>
    private static readonly TimeSpan FollowSlice = TimeSpan.FromSeconds(1);

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid MetaverseObjectId { get; set; }

    [Parameter]
    public string? DisplayName { get; set; }

    /// <summary>
    /// How many Connected Systems are enabled for Password Synchronisation, so the dialog can say where the
    /// password is going before it is typed rather than afterwards.
    /// </summary>
    [Parameter]
    public int TargetSystemCount { get; set; }

    /// <summary>
    /// How long the dialog follows delivery before handing over to the Passwords tab. Ten seconds is long enough
    /// for every target to answer under ordinary conditions and short enough that an administrator is never left
    /// watching a spinner for a directory that is down; a component test shortens it.
    /// </summary>
    [Parameter]
    public TimeSpan DeliveryWait { get; set; } = TimeSpan.FromSeconds(10);

    private enum Stage { Composing, Delivering }

    private Stage _stage = Stage.Composing;
    private string _password = string.Empty;
    private bool _showPassword;
    private bool _queueing;
    private bool _following;
    private bool _waitRanOut;
    private IReadOnlyList<PasswordChangeTargetOutcome> _targets = [];
    private readonly CancellationTokenSource _followCancellation = new();

    // Defaults to the target's own policy, which is right for a password the person chose. The other dialog,
    // where an administrator picks the password, defaults the other way for the same reason read in reverse.
    private PasswordExpiryBehaviour _expiryBehaviour = PasswordExpiryBehaviour.ExpiresAccordingToTargetPolicy;

    private string DisplayNameOrThisPerson => string.IsNullOrWhiteSpace(DisplayName) ? "this person" : DisplayName!;

    private string QueueHref => $"/admin/operations?t=passwords&metaverseObjectId={MetaverseObjectId}";

    /// <summary>
    /// The line above the rows: what is happening while the change is followed, and what happened once it is not.
    /// </summary>
    private string DeliveringSummary
    {
        get
        {
            var count = _targets.Count;
            var systems = $"{count} Connected System{(count == 1 ? "" : "s")}";
            if (_following)
                return $"Delivering {DisplayNameOrThisPerson}'s new password to {systems}. Each row updates as its system answers.";

            var set = _targets.Count(t => t.State == PasswordChangeTargetState.Set);
            if (set == count)
                return $"Password set on {systems}.";

            // Every other mix is spelt out by state, so a change that is held or parked everywhere is never
            // described as "on its way": nothing is, and saying so would promise a delivery nobody is making.
            var failed = _targets.Count(t => PasswordChangeTargetDisplay.IsFailure(t.State));
            var held = _targets.Count(t => t.State == PasswordChangeTargetState.Held);
            var retrying = _targets.Count(t => t.State == PasswordChangeTargetState.Retrying);
            var inFlight = _targets.Count(t => PasswordChangeTargetDisplay.IsInFlight(t.State));
            var parts = new List<string>();
            if (set > 0)
                parts.Add($"password set on {set}");
            if (failed > 0)
                parts.Add($"{failed} {(failed == 1 ? "needs" : "need")} attention below");
            if (held > 0)
                parts.Add($"{held} held until Password Synchronisation is switched on");
            if (retrying > 0)
                parts.Add($"{retrying} retrying");
            if (inFlight > 0)
                parts.Add($"{inFlight} still on {(inFlight == 1 ? "its" : "their")} way");
            return $"Of {systems}: {string.Join(", ", parts)}.";
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private void Done() => MudDialog.Close(DialogResult.Ok(true));

    private async Task QueueAsync()
    {
        if (string.IsNullOrWhiteSpace(_password) || _queueing)
            return;

        _queueing = true;
        PasswordQueueResult result;

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateProvider.GetAuthenticationStateAsync());

            result = await jim.PasswordSynchronisation.QueuePasswordChangeAsync(
                MetaverseObjectId, DisplayNameOrThisPerson, _password, _expiryBehaviour, user, CancellationToken.None);
        }
        finally
        {
            // The value exists for as long as the dialog needs it and no longer.
            _password = string.Empty;
            _queueing = false;
        }

        // Requirement 14: a change that reached nothing says so, rather than reporting success and leaving an
        // administrator believing a password propagated. There are no rows to follow, so the snackbar is the
        // whole answer and the dialog closes as it always did.
        if (result.NoTargets)
        {
            Snackbar.Add("No Connected System is configured for Password Synchronisation, so this password was not queued anywhere.", Severity.Warning);
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }

        // The rows start from what was queued, so the stage is never empty while the first read is in flight. A
        // system that is configured but switched off is Held from the outset: nothing will reach it until somebody
        // switches it on, and a row that read Queued would promise otherwise.
        _targets = result.Targets
            .OrderBy(t => t.ConnectedSystemName, StringComparer.OrdinalIgnoreCase)
            .Select(t => new PasswordChangeTargetOutcome
            {
                ConnectedSystemId = t.ConnectedSystemId,
                ConnectedSystemName = t.ConnectedSystemName,
                State = t.Enabled ? PasswordChangeTargetState.Queued : PasswordChangeTargetState.Held
            })
            .ToList();
        _stage = Stage.Delivering;
        _following = true;
        StateHasChanged();

        await FollowDeliveryAsync(result.ActivityId);
    }

    /// <summary>
    /// Follows the change in one-second slices until every target settles or <see cref="DeliveryWait"/> runs out,
    /// re-rendering after each slice so the rows move as their systems answer. Closing the dialog cancels it.
    /// </summary>
    private async Task FollowDeliveryAsync(Guid activityId)
    {
        var deadline = DateTime.UtcNow + DeliveryWait;
        var token = _followCancellation.Token;

        try
        {
            while (!token.IsCancellationRequested)
            {
                var remaining = deadline - DateTime.UtcNow;
                if (remaining <= TimeSpan.Zero)
                {
                    _waitRanOut = true;
                    break;
                }

                var slice = remaining < FollowSlice ? remaining : FollowSlice;
                var sliceStarted = DateTime.UtcNow;
                var outcomes = await OutcomeWaiter.WaitForOutcomesAsync(activityId, slice, token);
                if (outcomes != null)
                    _targets = outcomes.Targets;

                if (outcomes?.IsSettled == true)
                    break;

                StateHasChanged();

                // The waiter only answers early when the change has settled, so this is idle in practice; it is
                // here so that nothing answering faster than its slice can turn this loop into a busy one.
                var unused = slice - (DateTime.UtcNow - sliceStarted);
                if (unused > TimeSpan.Zero)
                    await Task.Delay(unused, token);
            }
        }
        catch (OperationCanceledException)
        {
            // The dialog was closed mid-wait; delivery carries on without it.
        }
        finally
        {
            _following = false;
        }
    }

    public void Dispose()
    {
        _followCancellation.Cancel();
        _followCancellation.Dispose();
    }
}
