<PageTitle>Trusted Certificates</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.EnhancedEncryption" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />Trusted Certificates</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    Manage trusted CA certificates used by connectors for secure communications (LDAPS, HTTPS, etc.).
    Certificates can be uploaded directly or referenced from the connector-files mount.
</MudText>

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the density toggle, the search box
   and the toolbar count) lives in the shared grid; this page loads the full list once (Trusted Certificates are
   a small configuration list) and slices windows from it in memory. *@
<VirtualisedDataGrid @ref="_grid" T="TrustedCertificate"
                     ContainerId="certificate-list"
                     DefaultSortBy="name"
                     LoadWindow="LoadCertificateWindowAsync"
                     SingularName="Trusted Certificate"
                     PluralName="Trusted Certificates">
    <ToolBarExtras>
        <MudButtonGroup Variant="Variant.Filled" Color="Color.Primary">
            <MudButton OnClick="ShowUploadDialog" StartIcon="@Icons.Material.Filled.Upload" DropShadow="false">Upload Certificate</MudButton>
            <MudButton OnClick="ShowFilePathDialog" StartIcon="@Icons.Material.Filled.Folder" DropShadow="false">Reference File Path</MudButton>
        </MudButtonGroup>
    </ToolBarExtras>
    <Columns>
        <TemplateColumn Title="Actions" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Actions</MudText>
            </HeaderTemplate>
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
                    <MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="_ => ShowDetailsDialog(context.Item)">View
                        Details</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="_ => ShowEditDialog(context.Item)">Edit
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.History" OnClick="_ => ShowHistoryDialogAsync(context.Item)">Change History
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="_ => HandleDeleteAsync(context.Item)">Delete
                    </MudMenuItem>
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Name" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Name" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.Name
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Subject" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Subject" Name="subject" />
            </HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="@context.Item.Subject" Arrow="true" Placement="Placement.Top">
                    @TruncateSubject(context.Item.Subject)
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Source" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Source" Name="source" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.SourceType == CertificateSourceType.Uploaded)
                {
                    <MudChip T="string" Color="Color.Info">Uploaded</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default">File Path</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Expires" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Expires" Name="expires" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.IsExpired)
                {
                    <MudChip T="string" Color="Color.Error">Expired</MudChip>
                }
                else if (context.Item.IsExpiringSoon)
                {
                    <MudChip T="string" Color="Color.Warning">@context.Item.DaysUntilExpiry days</MudChip>
                }
                else
                {
                    @context.Item.ValidTo.ToFriendlyDate()
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Status" Name="status" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.IsEnabled)
                {
                    <MudChip T="string" Color="Color.Success">Enabled</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default">Disabled</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No Trusted Certificates match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.EnhancedEncryption"
                             PrimaryText="No Trusted Certificates have been added yet"
                             SecondaryText="Use the Upload Certificate or Reference File Path buttons to add one." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@* Upload Certificate Dialog *@
<MudDialog @bind-Visible="_uploadDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-3" /> Upload Certificate
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_uploadName" Label="Name" Required="true"
            RequiredError="A name is required" Immediate="true" Variant="Variant.Outlined" Class="mt-3"
            HelperText="A friendly name for this certificate (e.g., 'Corp Root CA')" />
        <MudFileUpload T="IBrowserFile" FilesChanged="HandleFileSelected" Accept=".pem,.crt,.cer,.der">
            <CustomContent>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                    StartIcon="@Icons.Material.Filled.AttachFile" Class="mt-5"
                    OnClick="@context.OpenFilePickerAsync">
                    @(_uploadFile != null ? _uploadFile.Name : "Select Certificate File")
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            Supported formats: PEM (.pem, .crt) or DER (.cer, .der)
        </MudText>
        <MudTextField T="string" @bind-Value="_uploadNotes" Label="Notes" Lines="3" MaxLines="8" Sizing="InputSizing.Auto" Variant="Variant.Outlined"
            Class="mt-5" HelperText="Optional notes about this certificate" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _uploadDialogVisible = false" DropShadow="false">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            Disabled="@(string.IsNullOrWhiteSpace(_uploadName) || _uploadFile == null || _uploading)"
            OnClick="HandleUploadAsync">
            @if (_uploading)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">Uploading</span>
            }
            else
            {
                <text>Upload</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* File Path Dialog *@
<MudDialog @bind-Visible="_filePathDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Folder" Class="mr-3" /> Reference Certificate File
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_filePathName" Label="Name" Required="true"
            RequiredError="A name is required" Immediate="true" Variant="Variant.Outlined" Class="mt-3"
            HelperText="A friendly name for this certificate" />
        <MudTextField T="string" @bind-Value="_filePath" Label="File Path" Required="true"
            RequiredError="A file path is required" Immediate="true" Variant="Variant.Outlined" Class="mt-5"
            HelperText="Full path to the certificate file (e.g., /connector-files/certs/root-ca.pem)" />
        <MudTextField T="string" @bind-Value="_filePathNotes" Label="Notes" Lines="3" MaxLines="8" Sizing="InputSizing.Auto" Variant="Variant.Outlined"
            Class="mt-5" HelperText="Optional notes about this certificate" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _filePathDialogVisible = false" DropShadow="false">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            Disabled="@(string.IsNullOrWhiteSpace(_filePathName) || string.IsNullOrWhiteSpace(_filePath) || _addingFromPath)"
            OnClick="HandleAddFromPathAsync">
            @if (_addingFromPath)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">Adding</span>
            }
            else
            {
                <text>Add Certificate</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* Details Dialog *@
<MudDialog @bind-Visible="_detailsDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex justify-space-between align-center">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-3" /> Certificate Details
            </MudText>
            @if (_selectedCertificate != null)
            {
                <AuditInfo Entity="@_selectedCertificate" />
            }
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedCertificate != null)
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudField Label="Name" Variant="Variant.Outlined">@_selectedCertificate.Name</MudField>
                </MudItem>
                <MudItem xs="12">
                    <MudField Label="Subject" Variant="Variant.Outlined">@_selectedCertificate.Subject</MudField>
                </MudItem>
                <MudItem xs="12">
                    <MudField Label="Issuer" Variant="Variant.Outlined">@_selectedCertificate.Issuer</MudField>
                </MudItem>
                <MudItem xs="6">
                    <MudField Label="Valid From" Variant="Variant.Outlined">@_selectedCertificate.ValidFrom.ToFriendlyDate()
                    </MudField>
                </MudItem>
                <MudItem xs="6">
                    <MudField Label="Valid To" Variant="Variant.Outlined">@_selectedCertificate.ValidTo.ToFriendlyDate()
                    </MudField>
                </MudItem>
                <MudItem xs="12">
                    <MudField Label="Thumbprint" Variant="Variant.Outlined">@_selectedCertificate.Thumbprint</MudField>
                </MudItem>
                <MudItem xs="6">
                    <MudField Label="Serial Number" Variant="Variant.Outlined">@_selectedCertificate.SerialNumber</MudField>
                </MudItem>
                <MudItem xs="6">
                    <MudField Label="Source Type" Variant="Variant.Outlined">@_selectedCertificate.SourceType</MudField>
                </MudItem>
                @if (_selectedCertificate.SourceType == CertificateSourceType.FilePath)
                {
                    <MudItem xs="12">
                        <MudField Label="File Path" Variant="Variant.Outlined">@_selectedCertificate.FilePath</MudField>
                    </MudItem>
                }
                @if (!string.IsNullOrEmpty(_selectedCertificate.Notes))
                {
                    <MudItem xs="12">
                        <MudField Label="Notes" Variant="Variant.Outlined">@_selectedCertificate.Notes</MudField>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _detailsDialogVisible = false" DropShadow="false">Close</MudButton>
    </DialogActions>
</MudDialog>

@* Edit Dialog *@
<MudDialog @bind-Visible="_editDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" /> Edit Certificate
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_editName" Label="Name" Required="true" RequiredError="A name is required"
            Immediate="true" Variant="Variant.Outlined" Class="mt-3" />
        <MudTextField T="string" @bind-Value="_editNotes" Label="Notes" Lines="3" MaxLines="8" Sizing="InputSizing.Auto" Variant="Variant.Outlined"
            Class="mt-5" />
        <MudSwitch @bind-Value="_editEnabled" Color="Color.Primary" Label="Enabled" Class="mt-5" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editDialogVisible = false" DropShadow="false">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            Disabled="@(string.IsNullOrWhiteSpace(_editName) || _saving)" OnClick="HandleSaveEditAsync">
            @if (_saving)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">Saving</span>
            }
            else
            {
                <text>Save Changes</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<TrustedCertificate>? _certificates;
    private VirtualisedDataGrid<TrustedCertificate>? _grid;

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Administration", href: "/admin"),
        new("Certificates", href: null, disabled: true)
    };

    private readonly DialogOptions _dialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };

    // Upload dialog
    private bool _uploadDialogVisible;
    private string _uploadName = "";
    private IBrowserFile? _uploadFile;
    private string _uploadNotes = "";
    private bool _uploading;

    // File path dialog
    private bool _filePathDialogVisible;
    private string _filePathName = "";
    private string _filePath = "";
    private string _filePathNotes = "";
    private bool _addingFromPath;

    // Details dialog
    private bool _detailsDialogVisible;
    private TrustedCertificate? _selectedCertificate;

    // Edit dialog
    private bool _editDialogVisible;
    private TrustedCertificate? _editingCertificate;
    private string _editName = "";
    private string _editNotes = "";
    private bool _editEnabled;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await LoadCertificatesAsync();
    }

    private async Task LoadCertificatesAsync()
    {
        using var jim = JimFactory.Create();
        _certificates = await jim.Certificates.GetAllAsync();
    }

    /// <summary>
    /// Reloads the list from the database and refreshes the grid after any action that changes it (upload, add,
    /// edit, delete), so the rows and the toolbar count stay honest.
    /// </summary>
    private async Task ReloadListAsync()
    {
        await LoadCertificatesAsync();
        if (_grid != null)
            await _grid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Slices one window of Trusted Certificates from the in-memory list, applying the grid's search (name,
    /// subject, thumbprint; the same fields the old table filtered) and sort. Trusted Certificates are a small
    /// configuration list, so there is no repository range read; the full list is loaded once and windowed here.
    /// </summary>
    private Task<VirtualisedWindow<TrustedCertificate>> LoadCertificateWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<TrustedCertificate> certificates = _certificates ?? Enumerable.Empty<TrustedCertificate>();

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            certificates = certificates.Where(c =>
                c.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                c.Subject.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                c.Thumbprint.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        IOrderedEnumerable<TrustedCertificate> Order<TKey>(Func<TrustedCertificate, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? certificates.OrderByDescending(key, comparer) : certificates.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "subject" => Order(c => c.Subject, StringComparer.OrdinalIgnoreCase),
            "source" => Order(c => c.SourceType),
            "expires" => Order(c => c.ValidTo),
            "status" => Order(c => c.IsEnabled),
            _ => Order(c => c.Name, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    private static string TruncateSubject(string subject)
    {
        if (string.IsNullOrEmpty(subject))
            return subject;

        // Try to extract CN
        var cnIndex = subject.IndexOf("CN=", StringComparison.OrdinalIgnoreCase);
        if (cnIndex >= 0)
        {
            var cnEnd = subject.IndexOf(',', cnIndex);
            if (cnEnd < 0) cnEnd = subject.Length;
            var cn = subject.Substring(cnIndex + 3, cnEnd - cnIndex - 3);
            return cn.Length > 40 ? cn[..37] + "..." : cn;
        }

        return subject.Length > 40 ? subject[..37] + "..." : subject;
    }

    private void ShowUploadDialog()
    {
        _uploadName = "";
        _uploadFile = null;
        _uploadNotes = "";
        _uploadDialogVisible = true;
    }

    private void ShowFilePathDialog()
    {
        _filePathName = "";
        _filePath = "";
        _filePathNotes = "";
        _filePathDialogVisible = true;
    }

    private void ShowDetailsDialog(TrustedCertificate certificate)
    {
        _selectedCertificate = certificate;
        _detailsDialogVisible = true;
    }

    private void ShowEditDialog(TrustedCertificate certificate)
    {
        _editingCertificate = certificate;
        _editName = certificate.Name;
        _editNotes = certificate.Notes ?? "";
        _editEnabled = certificate.IsEnabled;
        _editDialogVisible = true;
    }

    private void HandleFileSelected(IBrowserFile file)
    {
        _uploadFile = file;
    }

    private async Task HandleUploadAsync()
    {
        if (_uploadFile == null || string.IsNullOrWhiteSpace(_uploadName))
            return;

        _uploading = true;
        StateHasChanged();

        try
        {
            // offer an optional reason for the configuration change history; cancelling aborts the upload
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Upload");
            if (cancelled)
                return;

            using var jim = JimFactory.Create();

            // Read file content
            using var stream = _uploadFile.OpenReadStream(maxAllowedSize: 1024 * 1024); // 1MB max
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var certificateData = ms.ToArray();

            // Get current user
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

            // Add certificate
            await jim.Certificates.AddFromDataAsync(_uploadName, certificateData, user, _uploadNotes, changeReason);

            Snackbar.Add("Certificate uploaded successfully.", Severity.Success);
            _uploadDialogVisible = false;
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to upload certificate: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task HandleAddFromPathAsync()
    {
        if (string.IsNullOrWhiteSpace(_filePathName) || string.IsNullOrWhiteSpace(_filePath))
            return;

        _addingFromPath = true;
        StateHasChanged();

        try
        {
            // offer an optional reason for the configuration change history; cancelling aborts the add
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Add");
            if (cancelled)
                return;

            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Certificates.AddFromFilePathAsync(_filePathName, _filePath, user, _filePathNotes, changeReason);

            Snackbar.Add("Certificate added successfully.", Severity.Success);
            _filePathDialogVisible = false;
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to add certificate: {ex.Message}", Severity.Error);
        }
        finally
        {
            _addingFromPath = false;
        }
    }

    private async Task HandleSaveEditAsync()
    {
        if (_editingCertificate == null || string.IsNullOrWhiteSpace(_editName))
            return;

        _saving = true;
        StateHasChanged();

        try
        {
            // offer an optional reason for the configuration change history; cancelling aborts the save
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
            if (cancelled)
                return;

            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Certificates.UpdateAsync(
            _editingCertificate.Id,
            user,
            _editName,
            _editNotes,
            _editEnabled,
            changeReason);

            Snackbar.Add("Certificate updated successfully.", Severity.Success);
            _editDialogVisible = false;
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update certificate: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ShowHistoryDialogAsync(TrustedCertificate certificate)
    {
        await ConfigurationChangeHistoryDialog.ShowAsync(DialogService, ActivityTargetType.TrustedCertificate,
            certificate.Id, "Trusted Certificate", certificate.Name);
    }

    private async Task HandleDeleteAsync(TrustedCertificate certificate)
    {
        var result = await DialogService.ShowMessageBoxAsync(
        "Delete Certificate",
        $"Are you sure you want to delete the certificate '{certificate.Name}'? This action cannot be undone.",
        yesText: "Delete",
        cancelText: "Cancel");

        if (result != true)
            return;

        // offer an optional reason for the configuration change history; cancelling aborts the delete
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Delete");
        if (cancelled)
            return;

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Certificates.DeleteAsync(certificate.Id, user, changeReason);

            Snackbar.Add("Certificate deleted successfully.", Severity.Success);
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to delete certificate: {ex.Message}", Severity.Error);
        }
    }
}
