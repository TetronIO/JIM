@using JIM.Models.Core
@using JIM.Models.Logic
@using JIM.Models.Staging
@using JIM.Models.Utility
@using JIM.Utilities
@using JIM.Application
@using JIM.Web.Models
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IJimApplicationFactory JimFactory

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<MudPaper Class="pa-4" Outlined="true">
    <div class="d-flex align-center justify-space-between">
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled"
            OnClick="HandleOpenAddAttributeFlowRuleDialogAsync" Color="Color.Default"
            Disabled="DisableAddAttributeFlowButton()" DropShadow="false">Add Attribute Flow</MudButton>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudTooltip Text="Table view" Arrow="true" Placement="Placement.Top">
                <MudIconButton Icon="@Icons.Material.Filled.TableRows"
                               Color="@(_attributeFlowTableView ? Color.Primary : Color.Default)"
                               OnClick="@(() => ToggleAttributeFlowViewAsync(true))" />
            </MudTooltip>
            <MudTooltip Text="Card view" Arrow="true" Placement="Placement.Top">
                <MudIconButton Icon="@Icons.Material.Filled.GridView"
                               Color="@(!_attributeFlowTableView ? Color.Primary : Color.Default)"
                               OnClick="@(() => ToggleAttributeFlowViewAsync(false))" />
            </MudTooltip>
        </MudStack>
    </div>

    @if (_attributeFlowTableView && SyncRule.AttributeFlowRules.Count > 0)
    {
        <MudStack Row="true" Spacing="6" Class="mt-3 mb-1 flex-wrap" AlignItems="AlignItems.Start">
            <div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Mapping Type:</MudText>
                <MudChipSet T="SyncRuleMappingSourcesType"
                            SelectionMode="SelectionMode.MultiSelection"
                            SelectedValues="_selectedMappingTypes"
                            SelectedValuesChanged="OnMappingTypeFilterChangedAsync">
                    @foreach (var type in GetAvailableMappingTypes())
                    {
                        <MudChip Value="@type.Key"
                                 Color="@(_selectedMappingTypes.Contains(type.Key) ? Color.Default : Helpers.GetMappingTypeChipColour(type.Key))"
                                 Variant="@(_selectedMappingTypes.Contains(type.Key) ? Variant.Filled : Variant.Outlined)"
                                 SelectedColor="@Helpers.GetMappingTypeChipColour(type.Key)">
                            @type.Key.ToString().SplitOnCapitalLetters()
                            <MudText Typo="Typo.caption" Class="ml-1">(@type.Value)</MudText>
                        </MudChip>
                    }
                </MudChipSet>
            </div>

            <div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Data Type:</MudText>
                <MudChipSet T="AttributeDataType"
                            SelectionMode="SelectionMode.MultiSelection"
                            SelectedValues="_selectedDataTypes"
                            SelectedValuesChanged="OnFlowDataTypeFilterChangedAsync">
                    @foreach (var type in GetAvailableFlowDataTypes())
                    {
                        <MudChip Value="@type.Key"
                                 Color="@(_selectedDataTypes.Contains(type.Key) ? Color.Default : Helpers.GetAttributeTypeChipColour(type.Key))"
                                 Variant="@(_selectedDataTypes.Contains(type.Key) ? Variant.Filled : Variant.Outlined)"
                                 SelectedColor="@Helpers.GetAttributeTypeChipColour(type.Key)">
                            @type.Key.ToString().SplitOnCapitalLetters()
                            <MudText Typo="Typo.caption" Class="ml-1">(@type.Value)</MudText>
                        </MudChip>
                    }
                </MudChipSet>
            </div>

            <div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Plurality:</MudText>
                <MudChipSet T="AttributePlurality"
                            SelectionMode="SelectionMode.MultiSelection"
                            SelectedValues="_selectedPluralities"
                            SelectedValuesChanged="OnFlowPluralityFilterChangedAsync">
                    @foreach (var plurality in GetAvailableFlowPluralities())
                    {
                        <MudChip Value="@plurality.Key"
                                 Color="@(_selectedPluralities.Contains(plurality.Key) ? Color.Default : Helpers.GetAttributePluralityChipColour(plurality.Key))"
                                 Variant="@(_selectedPluralities.Contains(plurality.Key) ? Variant.Filled : Variant.Outlined)"
                                 SelectedColor="@Helpers.GetAttributePluralityChipColour(plurality.Key)">
                            @(plurality.Key == AttributePlurality.SingleValued ? "Single-Valued" : "Multi-Valued")
                            <MudText Typo="Typo.caption" Class="ml-1">(@plurality.Value)</MudText>
                        </MudChip>
                    }
                </MudChipSet>
            </div>
        </MudStack>
    }

    @if (_attributeFlowTableView)
    {
        @* A Synchronisation Rule's Attribute Flows are held on the rule the page already loaded, so the grid's
           windows are sliced from that collection; the chip filters above it are the page's own, so changing one
           re-counts the match set (see RefreshFlowGridAsync). *@
        <VirtualisedDataGrid @ref="_flowGrid" T="SyncRuleMapping"
                             ContainerId="sync-rule-attribute-flow-list"
                             UrlParameterPrefix="af-"
                             DefaultSortBy="target"
                             LoadWindow="LoadAttributeFlowWindowAsync"
                             SingularName="Attribute Flow"
                             PluralName="Attribute Flows"
                             SearchPlaceholder="Search by attribute or expression">
            <Columns>
                <TemplateColumn Title="Type" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Type" Name="type" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudChip T="string" Variant="Variant.Text" Color="@Helpers.GetMappingTypeChipColour(context.Item.GetSourceType())">
                            @context.Item.GetSourceType().ToString().SplitOnCapitalLetters()
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Source" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Source" Name="source" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @* A row in a virtualised grid is one line, and a flow can join several sources, so the
                           first is shown and the rest open in a dialog drawn with the same chips. *@
                        <OverflowList TItem="SyncRuleMappingSource" Items="@context.Item.Sources.OrderBy(q => q.Order).ToList()" Title="Sources">
                            <ItemTemplate Context="source">
                                @if (SyncRule.Direction == SyncRuleDirection.Import && source.ConnectedSystemAttribute != null)
                                {
                                    var connectedSystemSource = source.ConnectedSystemAttribute;
                                    <AttributeChip Kind="AttributeChipKind.ConnectedSystem"
                                                   Name="@connectedSystemSource.Name"
                                                   Tooltip="@Helpers.DescribeAttribute(AttributeChipKind.ConnectedSystem, connectedSystemSource.Type, connectedSystemSource.AttributePlurality)" />
                                }
                                else if (SyncRule.Direction == SyncRuleDirection.Export && source.MetaverseAttribute != null)
                                {
                                    var metaverseSource = source.MetaverseAttribute;
                                    <AttributeChip Kind="AttributeChipKind.Metaverse"
                                                   Name="@metaverseSource.Name"
                                                   Tooltip="@Helpers.DescribeAttribute(AttributeChipKind.Metaverse, metaverseSource.Type, metaverseSource.AttributePlurality)" />
                                }
                                else if (!string.IsNullOrWhiteSpace(source.Expression))
                                {
                                    <AttributeChip Kind="AttributeChipKind.Expression" Expression="@source.Expression" />
                                }
                            </ItemTemplate>
                        </OverflowList>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Sortable="false">
                    <HeaderTemplate></HeaderTemplate>
                    <CellTemplate>
                        <MudText Class="mud-text-secondary">→</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Target" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Target" Name="target" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @* One line, and the attribute name is the part that gives way: the modifier chips beside
                           it qualify what the flow does, so they must never be what a long name pushes out. *@
                        <div class="jim-one-line-list">
                            @if (SyncRule.Direction == SyncRuleDirection.Import && context.Item.TargetMetaverseAttribute is { } metaverseTarget)
                            {
                                <span class="jim-one-line-list-value">
                                    <AttributeChip Kind="AttributeChipKind.Metaverse"
                                                   Name="@metaverseTarget.Name"
                                                   Tooltip="@Helpers.DescribeAttribute(AttributeChipKind.Metaverse, metaverseTarget.Type, metaverseTarget.AttributePlurality)" />
                                </span>
                            }
                            else if (SyncRule.Direction == SyncRuleDirection.Export && context.Item.TargetConnectedSystemAttribute is { } connectedSystemTarget)
                            {
                                <span class="jim-one-line-list-value">
                                    <AttributeChip Kind="AttributeChipKind.ConnectedSystem"
                                                   Name="@connectedSystemTarget.Name"
                                                   Tooltip="@Helpers.DescribeAttribute(AttributeChipKind.ConnectedSystem, connectedSystemTarget.Type, connectedSystemTarget.AttributePlurality)" />
                                </span>
                                @if (context.Item.InitialExportOnly)
                                {
                                    <MudTooltip Text="Initial Export Only: flows when JIM creates the object, then the attribute becomes unmanaged" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Variant="Variant.Text" Color="Color.Info">Initial Export Only</MudChip>
                                    </MudTooltip>
                                }
                                @if (connectedSystemTarget.Writability == AttributeWritability.WritableOnCreate)
                                {
                                    <MudTooltip Text="@Helpers.GetAttributeWritabilityDescription(AttributeWritability.WritableOnCreate)" Arrow="true" Placement="Placement.Top">
                                        <MudChip T="string" Variant="Variant.Text" Color="Color.Info">Set on creation only</MudChip>
                                    </MudTooltip>
                                }
                            }
                            @if (MappingIsMvaToSva(context.Item))
                            {
                                <MudTooltip Text="@MvaToSvaIndicatorTooltip" Arrow="true" Placement="Placement.Top">
                                    <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Color="Color.Inherit" Size="Size.Small" Class="ml-2 jim-mva-sva-indicator" />
                                </MudTooltip>
                            }
                        </div>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Created" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Created" Name="created" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                            <MudText Typo="Typo.body2">@context.Item.Created.ToLocalTime().ToRelativeTime()</MudText>
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Updated" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Updated" Name="updated" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.LastUpdated.HasValue)
                        {
                            var lastUpdated = context.Item.LastUpdated.Value;
                            <MudTooltip Text="@lastUpdated.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                                <MudText Typo="Typo.body2">@lastUpdated.ToLocalTime().ToRelativeTime()</MudText>
                            </MudTooltip>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Sortable="false">
                    <HeaderTemplate></HeaderTemplate>
                    <CellTemplate>
                        <div class="d-flex justify-end gap-2">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Variant="Variant.Filled" Color="Color.Primary"
                                Size="Size.Small" aria-label="edit"
                                OnClick="@(() => HandleEditAttributeFlowRuleAsync(context.Item))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Variant="Variant.Filled" Color="Color.Error"
                                Size="Size.Small" aria-label="delete"
                                OnClick="@(() => HandleAttributeFlowRuleDeleteClickAsync(context.Item))" />
                        </div>
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@($"No Attribute Flows match \"{grid.SearchText}\"")"
                                     SecondaryText="Try a different search term, or clear the search."
                                     ActionText="Clear Search"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else if (AnyAttributeFlowFilterIsActive)
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                                     PrimaryText="No Attribute Flows match these filters"
                                     SecondaryText="Clear a Mapping Type, Data Type or Plurality filter above to widen the list." />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.Map"
                                     PrimaryText="No Attribute Flows defined yet"
                                     SecondaryText="Use the Add Attribute Flow button to say which attribute values this Synchronisation Rule moves." />
                }
            </EmptyContent>
        </VirtualisedDataGrid>
    }
    else
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" Class="mt-5">
            @foreach (var attributeFlowRule in SyncRule.AttributeFlowRules)
            {
                <MudPaper Class="pa-3" Elevation="0" Outlined="true" Style="min-width: 200px;">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudText Typo="Typo.overline"><span class="mud-text-secondary">TYPE:</span>
                                @attributeFlowRule.GetSourceType().ToString().SplitOnCapitalLetters().ToUpper()</MudText>
                            @if (MappingIsMvaToSva(attributeFlowRule))
                            {
                                <MudTooltip Text="@MvaToSvaIndicatorTooltip" Arrow="true" Placement="Placement.Top">
                                    <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Color="Color.Inherit" Size="Size.Small" Class="jim-mva-sva-indicator" />
                                </MudTooltip>
                            }
                        </MudStack>
                        <div class="d-flex gap-2" style="flex-shrink: 0;">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Variant="Variant.Filled" Color="Color.Primary"
                                Size="Size.Small" aria-label="edit"
                                OnClick="@(() => HandleEditAttributeFlowRuleAsync(attributeFlowRule))" />
                            <MudIconButton Icon="@Icons.Material.Outlined.Delete" Variant="Variant.Filled" Color="Color.Error"
                                Size="Size.Small" aria-label="delete"
                                OnClick="@(() => HandleAttributeFlowRuleDeleteClickAsync(attributeFlowRule))" />
                        </div>
                    </MudStack>

                    @if (SyncRule.Direction == SyncRuleDirection.Import)
                    {
                        <div class="d-flex align-center flex-wrap">
                            <AttributeChip Kind="AttributeChipKind.Metaverse"
                                           Name="@attributeFlowRule.TargetMetaverseAttribute?.Name"
                                           Tooltip="@DescribeMetaverseAttribute(attributeFlowRule.TargetMetaverseAttribute)" />

                            <MudText Class="mud-text-secondary mx-1">→</MudText>

                            @foreach (var source in attributeFlowRule.Sources.OrderBy(q => q.Order))
                            {
                                if (source.ConnectedSystemAttribute != null)
                                {
                                    <AttributeChip Kind="AttributeChipKind.ConnectedSystem"
                                                   Name="@source.ConnectedSystemAttribute.Name"
                                                   Tooltip="@Helpers.DescribeAttribute(AttributeChipKind.ConnectedSystem, source.ConnectedSystemAttribute.Type, source.ConnectedSystemAttribute.AttributePlurality)" />
                                }
                                else if (!string.IsNullOrWhiteSpace(source.Expression))
                                {
                                    <AttributeChip Kind="AttributeChipKind.Expression" Expression="@source.Expression" />
                                }

                                <!-- some thought needs to be given to how we handle specifying constant values -->
                            }
                        </div>
                    }
                    else if (SyncRule.Direction == SyncRuleDirection.Export)
                    {
                        <div class="d-flex align-center flex-wrap">
                            @foreach (var source in attributeFlowRule.Sources.OrderBy(q => q.Order))
                            {
                                if (source.MetaverseAttribute != null)
                                {
                                    <AttributeChip Kind="AttributeChipKind.Metaverse"
                                                   Name="@source.MetaverseAttribute.Name"
                                                   Tooltip="@Helpers.DescribeAttribute(AttributeChipKind.Metaverse, source.MetaverseAttribute.Type, source.MetaverseAttribute.AttributePlurality)" />
                                }
                                else if (!string.IsNullOrWhiteSpace(source.Expression))
                                {
                                    <AttributeChip Kind="AttributeChipKind.Expression" Expression="@source.Expression" />
                                }

                                <!-- some thought needs to be given to how we handle specifying constant values -->
                            }

                            <MudText Class="mud-text-secondary mx-1">→</MudText>

                            <AttributeChip Kind="AttributeChipKind.ConnectedSystem"
                                           Name="@attributeFlowRule.TargetConnectedSystemAttribute?.Name"
                                           Tooltip="@DescribeConnectedSystemAttribute(attributeFlowRule.TargetConnectedSystemAttribute)" />

                            @if (attributeFlowRule.InitialExportOnly)
                            {
                                <MudTooltip Text="Initial Export Only: flows when JIM creates the object, then the attribute becomes unmanaged" Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Variant="Variant.Text" Color="Color.Info">Initial Export Only</MudChip>
                                </MudTooltip>
                            }
                            @if (attributeFlowRule.TargetConnectedSystemAttribute?.Writability == AttributeWritability.WritableOnCreate)
                            {
                                <MudTooltip Text="@Helpers.GetAttributeWritabilityDescription(AttributeWritability.WritableOnCreate)" Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Variant="Variant.Text" Color="Color.Info">Set on creation only</MudChip>
                                </MudTooltip>
                            }
                        </div>
                    }
                </MudPaper>
            }
        </MudStack>
    }
</MudPaper>

<MudDialog @bind-Visible="_addAttributeFlowRuleDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Map" Class="mr-3" /> @(_isEditingAttributeFlow ? "Edit Attribute Flow" : "Add Attribute Flow")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="string" Label="Source Type" Placeholder="Please select the type of source for this Attribute Flow"
            Required="true" Value="_attributeFlowMappingSourceType" ValueChanged="HandleSourceTypeChanged" Variant="Variant.Outlined">
            <MudSelectItem Value="@("Attribute")">Attribute</MudSelectItem>
            <MudSelectItem Value="@("Expression")">Expression</MudSelectItem>
        </MudSelect>

        @if (_attributeFlowMapping != null && _attributeFlowMappingSource != null && SyncRule.MetaverseObjectType !=
                null)
        {
            @switch (_attributeFlowMappingSourceType)
            {
                case "Attribute":
                    {
                        if (SyncRule.Direction == SyncRuleDirection.Import)
                        {
                            <MudSelect T="ConnectedSystemObjectTypeAttribute"
                                @bind-Value="_attributeFlowMappingSource.ConnectedSystemAttribute" Label="Connected System Attribute"
                                Placeholder="Please select the source Connected System attribute" Required="true" Class="mt-5"
                                Variant="Variant.Outlined">
                                @* Credential attributes are excluded entirely: they are handled by JIM's password channel, never by Attribute Flow *@
                                @foreach (var connectedSystemAttribute in SyncRule.ConnectedSystemObjectType!.Attributes.Where(q =>
                                            !CredentialAttributes.IsCredentialAttribute(q.Name)))
                                {
                                    <MudSelectItem Value="@connectedSystemAttribute">@connectedSystemAttribute.Name <span
                                            style="@($"color:{Colors.Gray.Darken1};")">(@connectedSystemAttribute.Type :
                                            @connectedSystemAttribute.AttributePlurality.ToString().SplitOnCapitalLetters())</span>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else if (SyncRule.Direction == SyncRuleDirection.Export)
                        {
                            <MudSelect T="MetaverseAttribute" @bind-Value="_attributeFlowMappingSource.MetaverseAttribute"
                                Label="Metaverse Attribute" Placeholder="Please select the source Metaverse attribute" Required="true"
                                Class="mt-5" Variant="Variant.Outlined" ToStringFunc="@MetaverseAttributeLabel">
                                @foreach (var metaverseAttribute in SyncRule.MetaverseObjectType.Attributes)
                                {
                                    <MudSelectItem Value="@metaverseAttribute">
                                        <div class="jim-flow-option">
                                            <span>@metaverseAttribute.Name <span
                                                style="@($"color:{Colors.Gray.Darken1};")">(@metaverseAttribute.Type :
                                                @metaverseAttribute.AttributePlurality.ToString().SplitOnCapitalLetters())</span></span>
                                            <span class="jim-flow-option-spacer"></span>
                                            <StandardMappingHintLabel Hints="_standardMappingHints.ForAttribute(metaverseAttribute.Id)"
                                                                      ShowStandard="_standardMappingHints.HasMixedStandards" />
                                        </div>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }
                        break;
                    }
                case "Expression":
                    <MudTextField T="string" @bind-Value="_attributeFlowMappingSource.Expression"
                        Label="Expression" Placeholder="e.g. IIF(mv[&quot;Active&quot;] == true, Upper(cs[&quot;Name&quot;]), null)"
                        Required="true" Class="mt-5" Variant="Variant.Outlined"
                        Lines="3" MaxLines="10" Sizing="InputSizing.Auto" Immediate="true" />

                    @* Expression tester (#1405): the Expression field is where an administrator finds out whether
                       their Expression does what they meant, and until now the answer only arrived from a
                       Synchronisation. Immediate="true" above is what lets the tester follow the text as it is typed. *@
                    <ExpressionTester Expression="@_attributeFlowMappingSource.Expression" />
                    break;
            }

            // user must have chosen the source attribute or entered an expression before being shown the target attribute controls
            if (_attributeFlowMappingSource.ConnectedSystemAttribute != null ||
            _attributeFlowMappingSource.MetaverseAttribute != null ||
            !string.IsNullOrWhiteSpace(_attributeFlowMappingSource.Expression))
            {
                @* ─── Standard Mapping hint (#1122) ─── *@
                var suggestions = GetStandardMappingSuggestions();
                @if (suggestions.Count > 0)
                {
                    var selectable = suggestions.Where(s => s.Status == StandardMappingSuggestionStatus.Available).ToList();
                    var unavailable = suggestions.Where(s => s.Status != StandardMappingSuggestionStatus.Available).ToList();

                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-5">
                        @if (selectable.Count > 0)
                        {
                            @GetStandardMappingSuggestionText(selectable)
                        }
                        @foreach (var blocked in unavailable)
                        {
                            <MudText Typo="Typo.body1" Class="@(selectable.Count > 0 ? "mt-2" : null)">
                                @GetUnavailableCorrespondenceText(blocked, selectable.Count > 0)
                            </MudText>
                        }
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                            Standard Mappings are guidance only; any attribute can be chosen, and they never affect what synchronisation flows.
                        </MudText>
                        @if (selectable.Count > 0)
                        {
                            <div class="d-flex flex-wrap gap-2 mt-3">
                                @foreach (var suggestion in selectable)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" DropShadow="false"
                                        OnClick="@(() => ApplyStandardMappingSuggestion(suggestion))">Use @suggestion.TargetName</MudButton>
                                }
                            </div>
                        }
                    </MudAlert>
                }

                <MudText Class="mt-5">Will flow to:</MudText>
                if (SyncRule.Direction == SyncRuleDirection.Import)
                {
                    <MudSelect T="MetaverseAttribute" @bind-Value="_attributeFlowMapping.TargetMetaverseAttribute"
                        Label="Metaverse Attribute" Placeholder="Please select the target Metaverse attribute" Required="true"
                        Class="mt-5" Variant="Variant.Outlined" ToStringFunc="@MetaverseAttributeLabel">
                        @foreach (var metaverseAttribute in AvailableTargetMetaverseAttributes())
                        {
                            <MudSelectItem Disabled="IsAttributeFlowTargetDisabled(metaverseAttribute)" Value="@metaverseAttribute">
                                <div class="jim-flow-option">
                                    <span>@metaverseAttribute.Name <span style="@($"color:{Colors.Gray.Darken1};")">(@metaverseAttribute.Type :
                                        @metaverseAttribute.AttributePlurality.ToString().SplitOnCapitalLetters())</span></span>
                                    @if (IsSuggested(suggestions, metaverseAttribute))
                                    {
                                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">Suggested</MudChip>
                                    }
                                    <span class="jim-flow-option-spacer"></span>
                                    <StandardMappingHintLabel Hints="_standardMappingHints.ForAttribute(metaverseAttribute.Id)"
                                                             Emphasised="IsSuggested(suggestions, metaverseAttribute)"
                                                             ShowStandard="_standardMappingHints.HasMixedStandards" />
                                </div>
                            </MudSelectItem>
                        }
                    </MudSelect>

                    @* ─── Attribute Priority context (#91, Surface 1: read-only; managed on the Object Type page) ─── *@
                    @* The target is captured by the pattern rather than dereferenced, so the markup never reads *@
                    @* through a nullable the analyser cannot see is guarded by the method above it. *@
                    @if (ShowAttributePriorityContext() && _attributeFlowMapping.TargetMetaverseAttribute is { } targetAttribute)
                    {
                        var alreadyContributes = MappingAlreadyContributesToSelectedAttribute();
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-5">
                            <MudText Typo="Typo.body1">
                                @if (alreadyContributes)
                                {
                                    @($"More than one Synchronisation Rule contributes {targetAttribute.Name}. Its priority order decides which value wins.")
                                }
                                else
                                {
                                    @($"{targetAttribute.Name} already has contributors. This mapping is added at the lowest priority and will not win resolution until it is promoted.")
                                }
                            </MudText>
                            <div class="mt-3">
                                <AttributePriorityList MetaverseObjectTypeId="SyncRule.MetaverseObjectTypeId"
                                                       MetaverseAttributeId="targetAttribute.Id"
                                                       MetaverseAttributeName="@targetAttribute.Name"
                                                       ReadOnly="true"
                                                       HighlightMappingId="@(alreadyContributes ? _attributeFlowMapping.Id : null)"
                                                       PendingContributorSystemName="@(alreadyContributes ? null : SyncRule.ConnectedSystem?.Name)"
                                                       PendingContributorNullIsValue="_attributeFlowMapping.NullIsValue" />
                            </div>
                            <MudText Typo="Typo.body2" Class="mt-3">
                                <MudLink Href="@($"/admin/schema/object-types/{SyncRule.MetaverseObjectTypeId}")" Target="_blank">
                                    Manage priority on the @(SyncRule.MetaverseObjectType?.Name ?? "Metaverse") Object Type page
                                </MudLink>
                            </MudText>
                        </MudAlert>
                    }

                    @* ─── Null is a value (#91) ─── *@
                    <MudCheckBox T="bool" Dense="true" Class="mt-5"
                        @bind-Value="_attributeFlowMapping.NullIsValue"
                        Label="Null is a value" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        When this Synchronisation Rule applies to a Connected System Object that is joined to a Metaverse Object, but contributes no value, treat that as an authoritative "no value": clear the Metaverse Object attribute value rather than falling back to a lower-priority contributor. A rule that results in no opinion (rule disabled, Connected System Object not joined, or out of scope) is skipped regardless.
                    </MudText>
                    @if (_attributeFlowMapping.NullIsValue)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                            Wherever this Synchronisation Rule wins priority, a blank in the Connected System now clears the Metaverse Object attribute value rather than leaving it alone. A truncated or empty import therefore clears the attribute across every object this rule covers.
                        </MudAlert>
                    }

                    @* ─── Inbound value processing (#843) ─── *@
                    @if (_attributeFlowMapping.TargetMetaverseAttribute?.Type == AttributeDataType.Text)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-5">Value processing</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                            Apply transforms to the imported text value before it flows to the Metaverse. By default, whitespace-only and empty values are treated as no value (they do not flow, and clear any existing value).
                        </MudText>
                        <MudCheckBox T="bool" Dense="true"
                            Value="HasProcessingFlag(InboundValueProcessing.TreatWhitespaceAsNoValue)"
                            ValueChanged="@((bool v) => SetProcessingFlag(InboundValueProcessing.TreatWhitespaceAsNoValue, v))"
                            Label="Treat whitespace as no value" />
                        <MudCheckBox T="bool" Dense="true"
                            Value="HasProcessingFlag(InboundValueProcessing.TrimWhitespace)"
                            ValueChanged="@((bool v) => SetProcessingFlag(InboundValueProcessing.TrimWhitespace, v))"
                            Label="Trim leading and trailing whitespace" />
                        <MudTooltip Arrow="true" Placement="Placement.Top" Inline="false"
                            Text="Reduces runs of consecutive whitespace inside the value to a single space; for example 'John···Smith' becomes 'John Smith' (each · is a space).">
                            <MudCheckBox T="bool" Dense="true"
                                Value="HasProcessingFlag(InboundValueProcessing.CollapseInternalWhitespace)"
                                ValueChanged="@((bool v) => SetProcessingFlag(InboundValueProcessing.CollapseInternalWhitespace, v))"
                                Label="Collapse internal whitespace" />
                        </MudTooltip>
                        <MudSelect T="InboundCaseNormalisation" @bind-Value="_attributeFlowMapping.CaseNormalisation"
                            Label="Case normalisation" Variant="Variant.Outlined" Class="mt-6">
                            <MudSelectItem Value="InboundCaseNormalisation.None">None</MudSelectItem>
                            <MudSelectItem Value="InboundCaseNormalisation.Upper">Upper case</MudSelectItem>
                            <MudSelectItem Value="InboundCaseNormalisation.Lower">Lower case</MudSelectItem>
                            <MudSelectItem Value="InboundCaseNormalisation.Title">Title case</MudSelectItem>
                        </MudSelect>
                    }
                }
                else if (SyncRule.Direction == SyncRuleDirection.Export)
                {
                    <MudSelect T="ConnectedSystemObjectTypeAttribute"
                        @bind-Value="_attributeFlowMapping.TargetConnectedSystemAttribute" Label="Connected System Attribute"
                        Placeholder="Please select the target Connected System attribute" Required="true" Class="mt-5"
                        Variant="Variant.Outlined">
                        @foreach (var connectedSystemAttribute in AvailableTargetConnectedSystemAttributes())
                        {
                            <MudSelectItem Disabled="IsAttributeFlowTargetDisabled(connectedSystemAttribute)"
                                Value="@connectedSystemAttribute">
                                <div class="jim-flow-option">
                                    <span>@connectedSystemAttribute.Name <span
                                        style="@($"color:{Colors.Gray.Darken1};")">(@connectedSystemAttribute.Type :
                                        @connectedSystemAttribute.AttributePlurality.ToString().SplitOnCapitalLetters())</span></span>
                                    @if (IsSuggested(suggestions, connectedSystemAttribute))
                                    {
                                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">Suggested</MudChip>
                                    }
                                    <span class="jim-flow-option-spacer"></span>
                                </div>
                            </MudSelectItem>
                        }
                    </MudSelect>

                    @* ─── Initial Export Only (#223) ─── *@
                    <MudCheckBox T="bool" Dense="true" Class="mt-5"
                        @bind-Value="_attributeFlowMapping.InitialExportOnly"
                        Label="Initial Export Only" />
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Only flow this attribute when JIM creates the object in the Connected System. Once provisioned, the attribute becomes unmanaged: Metaverse changes are not exported and Drift Correction leaves it alone, allowing the Connected System to own the value. Objects that join to pre-existing Connected System objects never receive the value.
                    </MudText>
                }

                @* ─── Multi-Valued to Single-Valued warning (#435) ─── *@
                @if (DialogMappingIsMvaToSva())
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-5">
                        @GetMvaToSvaWarningText()
                    </MudAlert>
                }
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton DropShadow="false" Variant="Variant.Filled" Color="Color.Default"
            OnClick="@(() => _addAttributeFlowRuleDialogVisible = false)" Class="me-2">Cancel</MudButton>
        <MudButton Disabled="DisableAddAttributeFlowMappingButton()" DropShadow="false" Variant="Variant.Filled"
            Color="Color.Primary" OnClick="HandleAddAttributeFlowMappingButtonClick">@(_isEditingAttributeFlow ? "Update Attribute Flow" : "Add Attribute Flow")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    /// <summary>
    /// Tooltip for a Metaverse Attribute that the markup reaches through a nullable navigation. Falls back to the
    /// chip's own default when the navigation is not loaded, rather than showing a tooltip asserting a data type
    /// nobody read.
    /// </summary>
    private static string? DescribeMetaverseAttribute(MetaverseAttribute? attribute) =>
        attribute == null ? null : Helpers.DescribeAttribute(AttributeChipKind.Metaverse, attribute.Type, attribute.AttributePlurality);

    /// <summary>
    /// The Connected System sibling of <see cref="DescribeMetaverseAttribute"/>.
    /// </summary>
    private static string? DescribeConnectedSystemAttribute(ConnectedSystemObjectTypeAttribute? attribute) =>
        attribute == null ? null : Helpers.DescribeAttribute(AttributeChipKind.ConnectedSystem, attribute.Type, attribute.AttributePlurality);

    [Parameter]
    public SyncRule SyncRule { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool _addAttributeFlowRuleDialogVisible;
    // Medium rather than the default Small: the dialog carries the attribute priority list (#91 Surface 1), whose
    // Connected System and Synchronisation Rule names wrap onto three lines each at 600px and are unreadable.
    private readonly DialogOptions _dialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Medium };

    // ─── Attribute Priority context (#91 Surface 1) ───

    /// <summary>Import contributor count per Metaverse attribute, so the dialog knows when priority is in play.</summary>
    private Dictionary<int, int> _attributeContributorCounts = new();

    /// <summary>The target this mapping had when the dialog opened; null for a new mapping.</summary>
    private int? _originalTargetMetaverseAttributeId;

    /// <summary>
    /// Loads the per-attribute import contributor counts for this rule's Metaverse Object Type. One aggregate,
    /// refreshed each time the dialog opens so it reflects mappings other rules have gained since the page loaded.
    /// Import rules only; priority is an inbound concern.
    /// </summary>
    private async Task LoadAttributeContributorCountsAsync()
    {
        if (SyncRule.Direction != SyncRuleDirection.Import || SyncRule.MetaverseObjectTypeId <= 0)
        {
            _attributeContributorCounts = new Dictionary<int, int>();
            return;
        }

        using var jim = JimFactory.Create();
        _attributeContributorCounts = await jim.ConnectedSystems.GetAttributeContributorCountsAsync(SyncRule.MetaverseObjectTypeId);
    }

    /// <summary>
    /// Whether the mapping being edited is already a persisted contributor to the attribute currently selected.
    /// False for a new mapping, and false once an existing mapping is retargeted, because it is then arriving at a
    /// list it is not yet part of.
    /// </summary>
    private bool MappingAlreadyContributesToSelectedAttribute()
    {
        var selected = _attributeFlowMapping?.TargetMetaverseAttribute?.Id;
        return _isEditingAttributeFlow && selected.HasValue && _originalTargetMetaverseAttributeId == selected.Value;
    }

    /// <summary>
    /// Whether to show the read-only priority context for the selected target attribute. It earns its space only
    /// when priority actually decides something: another Synchronisation Rule already contributes to the attribute.
    /// A mapping that is itself one of the counted contributors does not count towards that.
    /// </summary>
    private bool ShowAttributePriorityContext()
    {
        if (SyncRule.Direction != SyncRuleDirection.Import)
            return false;

        var selected = _attributeFlowMapping?.TargetMetaverseAttribute?.Id;
        if (!selected.HasValue)
            return false;

        var contributors = _attributeContributorCounts.GetValueOrDefault(selected.Value);
        return MappingAlreadyContributesToSelectedAttribute() ? contributors > 1 : contributors > 0;
    }
    private SyncRuleMapping? _attributeFlowMapping;
    private IReadOnlyCollection<SyncRuleMappingSourcesType> _selectedMappingTypes = new List<SyncRuleMappingSourcesType>();
    private IReadOnlyCollection<AttributeDataType> _selectedDataTypes = new List<AttributeDataType>();
    private IReadOnlyCollection<AttributePlurality> _selectedPluralities = new List<AttributePlurality>();
    private SyncRuleMappingSource? _attributeFlowMappingSource;
    private string? _attributeFlowMappingSourceType;
    private bool _attributeFlowTableView = true;
    private bool _isEditingAttributeFlow;
    private VirtualisedDataGrid<SyncRuleMapping>? _flowGrid;

    // Advisory Standard Mapping hints for the dialog's attribute pickers (#1122). Loaded when the dialog opens
    // and cached for as long as the rule keeps pointing at the same Connected System and Metaverse Object Type.
    private StandardMappingHints _standardMappingHints = StandardMappingHints.Empty;
    private (int ConnectedSystemId, int MetaverseObjectTypeId)? _loadedStandardMappingHintsKey;

    // Tooltip for the Multi-Valued to Single-Valued indicator in the Attribute Flow list (#435).
    private const string MvaToSvaIndicatorTooltip =
        "This mapping flows a Multi-Valued source to a Single-Valued target. Any object with more than one value will " +
        "not flow this attribute and will be recorded as an error; a single value flows normally.";

    protected override async Task OnInitializedAsync()
    {
        var storedView = await JS.InvokeAsync<string?>("localStorage.getItem", "attributeFlowView");
        _attributeFlowTableView = storedView != "cards";
    }

    private async Task ToggleAttributeFlowViewAsync(bool tableView)
    {
        _attributeFlowTableView = tableView;
        await JS.InvokeVoidAsync("localStorage.setItem", "attributeFlowView", tableView ? "table" : "cards");
    }

    private bool DisableAddAttributeFlowButton()
    {
        if (SyncRule.MetaverseObjectType == null)
            return true;

        if (SyncRule.ConnectedSystemObjectType == null)
            return true;

        return false;
    }

    private async Task HandleOpenAddAttributeFlowRuleDialogAsync()
    {
        _attributeFlowMapping = new SyncRuleMapping();
        _attributeFlowMappingSource = new SyncRuleMappingSource();
        _attributeFlowMapping.Sources.Add(_attributeFlowMappingSource);
        _attributeFlowMappingSourceType = null;
        _isEditingAttributeFlow = false;
        _originalTargetMetaverseAttributeId = null;
        await LoadStandardMappingHintsAsync();
        await LoadAttributeContributorCountsAsync();
        _addAttributeFlowRuleDialogVisible = true;
    }

    private async Task HandleEditAttributeFlowRuleAsync(SyncRuleMapping mapping)
    {
        await LoadStandardMappingHintsAsync();
        await LoadAttributeContributorCountsAsync();
        HandleEditAttributeFlowRule(mapping);
    }

    private void HandleEditAttributeFlowRule(SyncRuleMapping mapping)
    {
        _attributeFlowMapping = mapping;

        // Remember what this mapping targeted when the dialog opened. The priority context has to distinguish a
        // mapping that already sits in the attribute's list from one arriving at it, and the picker below mutates
        // the mapping in place, so the persisted target is unrecoverable from the mapping itself once it changes.
        _originalTargetMetaverseAttributeId = mapping.TargetMetaverseAttribute?.Id ?? mapping.TargetMetaverseAttributeId;
        _attributeFlowMappingSource = mapping.Sources.FirstOrDefault();

        var sourceType = mapping.GetSourceType();
        _attributeFlowMappingSourceType = sourceType switch
        {
            SyncRuleMappingSourcesType.ExpressionMapping => "Expression",
            SyncRuleMappingSourcesType.AttributeMapping => "Attribute",
            SyncRuleMappingSourcesType.AdvancedMapping => "Advanced",
            _ => null
        };

        _isEditingAttributeFlow = true;
        _addAttributeFlowRuleDialogVisible = true;
    }

    private void HandleSourceTypeChanged(string newSourceType)
    {
        _attributeFlowMappingSourceType = newSourceType;
        if (_attributeFlowMappingSource == null) return;

        // Clear previous source data when switching types
        _attributeFlowMappingSource.ConnectedSystemAttribute = null;
        _attributeFlowMappingSource.MetaverseAttribute = null;
        _attributeFlowMappingSource.Expression = null;
    }

    /// <summary>
    /// Loads the advisory Standard Mapping hints for the Connected System and Metaverse Object Type this
    /// Synchronisation Rule targets (#1122), on its own short-lived context: these are read-only display data
    /// and must stay clear of the tracked rule graph the editor saves. Cached until the rule is re-pointed,
    /// and a rule without both ends chosen yet simply has no hints.
    /// </summary>
    private async Task LoadStandardMappingHintsAsync()
    {
        // The FK scalar is only populated once the rule has been saved; while a new rule is being created the
        // chosen Connected System is on the navigation property alone, and hints should work there too.
        var connectedSystemId = SyncRule.ConnectedSystemId != 0 ? SyncRule.ConnectedSystemId : SyncRule.ConnectedSystem?.Id ?? 0;
        if (SyncRule.MetaverseObjectType == null || connectedSystemId == 0)
        {
            _standardMappingHints = StandardMappingHints.Empty;
            _loadedStandardMappingHintsKey = null;
            return;
        }

        var key = (connectedSystemId, SyncRule.MetaverseObjectType.Id);
        if (_loadedStandardMappingHintsKey == key)
            return;

        using var jim = JimFactory.Create();
        var connectedSystemStandard = await jim.ConnectedSystems.GetConnectedSystemSchemaStandardAsync(connectedSystemId);
        var mappings = await jim.Metaverse.GetStandardMappingsForObjectTypeAsync(SyncRule.MetaverseObjectType.Id);
        _standardMappingHints = StandardMappingHints.Build(mappings, connectedSystemStandard);
        _loadedStandardMappingHintsKey = key;
    }

    /// <summary>
    /// The Metaverse Attributes the target picker offers on an import rule: the Object Type's attributes, less
    /// those already targeted by another Attribute Flow. Shared with the suggestion logic so the editor cannot
    /// suggest something the picker does not list.
    /// </summary>
    private IEnumerable<MetaverseAttribute> AvailableTargetMetaverseAttributes() =>
        SyncRule.MetaverseObjectType!.Attributes.Where(q =>
            !SyncRule.AttributeFlowRules.Any(afr => afr != _attributeFlowMapping &&
                                                    afr.TargetMetaverseAttribute != null &&
                                                    afr.TargetMetaverseAttribute.Id == q.Id));

    /// <summary>
    /// The Connected System attributes the target picker offers on an export rule; the export-side sibling of
    /// <see cref="AvailableTargetMetaverseAttributes"/>.
    /// </summary>
    /// <summary>
    /// The Connected System attributes an Attribute Flow may target: everything not already taken by another
    /// flow on this rule, less anything holding credential material. Credential attributes are excluded
    /// entirely because they are written by JIM's password channel and must never travel through Attribute
    /// Flow; naming one through the REST API or PowerShell is rejected for the same reason.
    /// </summary>
    private IEnumerable<ConnectedSystemObjectTypeAttribute> AvailableTargetConnectedSystemAttributes() =>
        SyncRule.ConnectedSystemObjectType!.Attributes.Where(q =>
            !CredentialAttributes.IsCredentialAttribute(q.Name) &&
            !SyncRule.AttributeFlowRules.Any(afr => afr != _attributeFlowMapping &&
                                                    afr.TargetConnectedSystemAttribute != null &&
                                                    afr.TargetConnectedSystemAttribute.Id == q.Id));

    /// <summary>
    /// The targets the Standard Mappings say the chosen source attribute corresponds to (#1122). Empty for an
    /// Expression source (there is no attribute name to match on) and for a source attribute the standard says
    /// nothing about. More than one target can correspond to a name, in which case all of them are offered and
    /// none is chosen. A correspondence the editor cannot act on is returned too, carrying the reason: a
    /// standard that describes a correspondence JIM then says nothing about is worse than no hint at all,
    /// because the administrator is left looking for an attribute that is not in the list.
    /// </summary>
    private List<StandardMappingSuggestion> GetStandardMappingSuggestions()
    {
        if (_attributeFlowMappingSourceType != "Attribute" || !_standardMappingHints.HasHints)
            return [];

        if (SyncRule.Direction == SyncRuleDirection.Import)
        {
            var matches = _standardMappingHints.MatchesForAttributeName(_attributeFlowMappingSource?.ConnectedSystemAttribute?.Name);
            if (matches.Count == 0)
                return [];

            // Resolved against every attribute on the Object Type, not just the selectable ones, so a target
            // that is missing from the picker can be explained rather than quietly disappearing.
            return matches
                .Select(match => new { Match = match, Attribute = SyncRule.MetaverseObjectType!.Attributes.FirstOrDefault(a => a.Id == match.MetaverseAttributeId) })
                .Where(x => x.Attribute != null)
                .Select(x => new StandardMappingSuggestion
                {
                    Status = ClassifyTarget(x.Attribute!),
                    MetaverseAttribute = x.Attribute,
                    TargetName = x.Attribute!.Name,
                    StandardLabel = x.Match.StandardLabel,
                    CounterpartName = x.Match.CounterpartName,
                    Notes = x.Match.Notes
                })
                .ToList();
        }

        var sourceMetaverseAttribute = _attributeFlowMappingSource?.MetaverseAttribute;
        if (sourceMetaverseAttribute == null)
            return [];

        // On export the correspondence runs the other way: the chosen Metaverse Attribute's counterpart names
        // are the Connected System attribute names the standard says should receive it, so a correspondence
        // only stands where the system's schema actually has an attribute of that name.
        return _standardMappingHints.ForAttribute(sourceMetaverseAttribute.Id)
            .SelectMany(hint => SyncRule.ConnectedSystemObjectType!.Attributes
                .Where(candidate => string.Equals(candidate.Name, hint.CounterpartName, StringComparison.OrdinalIgnoreCase))
                .Select(candidate => new StandardMappingSuggestion
                {
                    Status = ClassifyTarget(candidate),
                    ConnectedSystemAttribute = candidate,
                    TargetName = candidate.Name,
                    StandardLabel = hint.StandardLabel,
                    CounterpartName = hint.CounterpartName,
                    Notes = hint.Notes
                }))
            .ToList();
    }

    /// <summary>
    /// Why a corresponding Metaverse Attribute is or is not selectable as this mapping's target. Defers to
    /// <see cref="IsAttributeFlowTargetDisabled(MetaverseAttribute)"/> for the type rule rather than restating
    /// it, so the explanation cannot drift from what the picker actually allows.
    /// </summary>
    private StandardMappingSuggestionStatus ClassifyTarget(MetaverseAttribute attribute)
    {
        if (SyncRule.AttributeFlowRules.Any(afr => afr != _attributeFlowMapping && afr.TargetMetaverseAttribute?.Id == attribute.Id))
            return StandardMappingSuggestionStatus.AlreadyTargeted;

        return IsAttributeFlowTargetDisabled(attribute) ? StandardMappingSuggestionStatus.TypeMismatch : StandardMappingSuggestionStatus.Available;
    }

    /// <summary>
    /// The export-side sibling of <see cref="ClassifyTarget(MetaverseAttribute)"/>. Read-only is tested first:
    /// it also disables the target, but "the system will not accept writes to this attribute" is a more useful
    /// thing to be told than "the types differ".
    /// </summary>
    private StandardMappingSuggestionStatus ClassifyTarget(ConnectedSystemObjectTypeAttribute attribute)
    {
        if (attribute.Writability == AttributeWritability.ReadOnly)
            return StandardMappingSuggestionStatus.ReadOnlyTarget;

        if (SyncRule.AttributeFlowRules.Any(afr => afr != _attributeFlowMapping && afr.TargetConnectedSystemAttribute?.Id == attribute.Id))
            return StandardMappingSuggestionStatus.AlreadyTargeted;

        return IsAttributeFlowTargetDisabled(attribute) ? StandardMappingSuggestionStatus.TypeMismatch : StandardMappingSuggestionStatus.Available;
    }

    private static bool IsSuggested(List<StandardMappingSuggestion> suggestions, MetaverseAttribute attribute) =>
        suggestions.Any(s => s.MetaverseAttribute != null && s.MetaverseAttribute.Id == attribute.Id);

    private static bool IsSuggested(List<StandardMappingSuggestion> suggestions, ConnectedSystemObjectTypeAttribute attribute) =>
        suggestions.Any(s => s.ConnectedSystemAttribute != null && s.ConnectedSystemAttribute.Id == attribute.Id);

    /// <summary>
    /// The sentence stating the correspondence the Standard Mappings describe (#1122). Attribute and counterpart
    /// names are rendered as inline code, so the result is raw markup; each name is HTML-encoded because it is
    /// Connected System or Metaverse schema data.
    /// </summary>
    private MarkupString GetStandardMappingSuggestionText(List<StandardMappingSuggestion> suggestions)
    {
        static string Code(string? name) => $"<code class=\"jim-code-inline\">{System.Net.WebUtility.HtmlEncode(name)}</code>";

        var first = suggestions[0];
        // The picker's compact "SCIM 2.0 · LDAP/AD" label does not read as prose; spell the conjunction out.
        var standard = System.Net.WebUtility.HtmlEncode(first.StandardLabel.Replace(" · ", " and ", StringComparison.Ordinal));
        var targets = string.Join(" and ", suggestions.Select(s => Code(s.TargetName)));
        var notes = string.Join(" ", suggestions
            .Select(s => s.Notes)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.Ordinal)
            .Select(System.Net.WebUtility.HtmlEncode));

        var sentence = SyncRule.Direction == SyncRuleDirection.Import
            ? $"In {standard}, {Code(first.CounterpartName)} corresponds to the Metaverse " +
              $"{(suggestions.Count == 1 ? "Attribute" : "Attributes")} {targets}."
            : $"In {standard}, {Code(_attributeFlowMappingSource?.MetaverseAttribute?.Name)} corresponds to " +
              $"{targets} in this Connected System.";

        return (MarkupString)(string.IsNullOrEmpty(notes) ? sentence : $"{sentence} {notes}");
    }

    /// <summary>
    /// The sentence for a correspondence the editor cannot act on: what the standard says, then why this
    /// mapping cannot express it, then the mapping's own note where it has one (which is usually where the
    /// conversion an Expression source would need is described). Raw markup, encoded as above.
    /// </summary>
    private MarkupString GetUnavailableCorrespondenceText(StandardMappingSuggestion suggestion, bool continuesFromSuggestion)
    {
        static string Code(string? name) => $"<code class=\"jim-code-inline\">{System.Net.WebUtility.HtmlEncode(name)}</code>";

        var standard = System.Net.WebUtility.HtmlEncode(suggestion.StandardLabel.Replace(" · ", " and ", StringComparison.Ordinal));
        var sourceName = SyncRule.Direction == SyncRuleDirection.Import
            ? _attributeFlowMappingSource?.ConnectedSystemAttribute?.Name
            : _attributeFlowMappingSource?.MetaverseAttribute?.Name;

        // Following a sentence that has already named the standard and the source, repeating both reads as boilerplate.
        var correspondence = continuesFromSuggestion
            ? $"It also corresponds to {Code(suggestion.TargetName)}, "
            : $"In {standard}, {Code(sourceName)} corresponds to {Code(suggestion.TargetName)}, ";
        var reason = suggestion.Status switch
        {
            StandardMappingSuggestionStatus.TypeMismatch =>
                "which holds a different data type, so the value cannot flow to it directly. An Expression source can convert it.",
            StandardMappingSuggestionStatus.AlreadyTargeted =>
                "which another Attribute Flow on this Synchronisation Rule already targets.",
            StandardMappingSuggestionStatus.ReadOnlyTarget =>
                "which this Connected System reports as read-only, so no Attribute Flow can write to it.",
            _ => "which is not available as a target."
        };

        var notes = string.IsNullOrWhiteSpace(suggestion.Notes) ? null : System.Net.WebUtility.HtmlEncode(suggestion.Notes.Trim());
        return (MarkupString)(notes == null ? correspondence + reason : $"{correspondence}{reason} {notes}");
    }

    /// <summary>
    /// Accepts a suggestion by setting it as the mapping's target; a convenience for a picker that can run to
    /// dozens of attributes, not an endorsement. The administrator can change the target afterwards as normal.
    /// </summary>
    private void ApplyStandardMappingSuggestion(StandardMappingSuggestion suggestion)
    {
        if (_attributeFlowMapping == null)
            return;

        if (SyncRule.Direction == SyncRuleDirection.Import)
            _attributeFlowMapping.TargetMetaverseAttribute = suggestion.MetaverseAttribute;
        else
            _attributeFlowMapping.TargetConnectedSystemAttribute = suggestion.ConnectedSystemAttribute;
    }

    /// <summary>
    /// Whether the inbound value-processing flag is set on the mapping being edited (#843).
    /// </summary>
    private bool HasProcessingFlag(InboundValueProcessing flag)
    {
        return _attributeFlowMapping != null && _attributeFlowMapping.InboundValueProcessing.HasFlag(flag);
    }

    /// <summary>
    /// Sets or clears an inbound value-processing flag on the mapping being edited (#843).
    /// </summary>
    private void SetProcessingFlag(InboundValueProcessing flag, bool enabled)
    {
        if (_attributeFlowMapping == null)
            return;

        if (enabled)
            _attributeFlowMapping.InboundValueProcessing |= flag;
        else
            _attributeFlowMapping.InboundValueProcessing &= ~flag;
    }

    /// <summary>
    /// Label for a Metaverse Attribute in the source/target selects, including its data type and plurality
    /// (for example "Account Name (Text : Single Valued)"), so the plurality is visible once selected. Matches
    /// the format shown for Connected System attributes.
    /// </summary>
    private static string MetaverseAttributeLabel(MetaverseAttribute? attribute)
        => attribute == null
            ? string.Empty
            : $"{attribute.Name} ({attribute.Type} : {attribute.AttributePlurality.ToString().SplitOnCapitalLetters()})";

    /// <summary>
    /// Whether the mapping currently being added or edited in the dialog flows a Multi-Valued source attribute
    /// to a Single-Valued target attribute (#435). Add and edit share this dialog, so this covers both. Only
    /// Attribute mappings are considered (an Expression's plurality is unknown at design time). On import,
    /// Reference sources are excluded because the runtime guard does not apply to them; on export, every data
    /// type is in scope.
    /// </summary>
    private bool DialogMappingIsMvaToSva()
    {
        if (_attributeFlowMappingSourceType != "Attribute" || _attributeFlowMapping == null || _attributeFlowMappingSource == null)
            return false;

        if (SyncRule.Direction == SyncRuleDirection.Import)
        {
            var source = _attributeFlowMappingSource.ConnectedSystemAttribute;
            var target = _attributeFlowMapping.TargetMetaverseAttribute;
            return source is { AttributePlurality: AttributePlurality.MultiValued } &&
                   source.Type != AttributeDataType.Reference &&
                   target is { AttributePlurality: AttributePlurality.SingleValued };
        }

        var exportSource = _attributeFlowMappingSource.MetaverseAttribute;
        var exportTarget = _attributeFlowMapping.TargetConnectedSystemAttribute;
        return exportSource is { AttributePlurality: AttributePlurality.MultiValued } &&
               exportTarget is { AttributePlurality: AttributePlurality.SingleValued };
    }

    /// <summary>
    /// The direction-specific warning shown when the mapping being added or edited is Multi-Valued to
    /// Single-Valued (#435). The attribute names are rendered as inline code, so the result is raw markup;
    /// each name is HTML-encoded because it is Connected System / Metaverse schema data.
    /// </summary>
    private MarkupString GetMvaToSvaWarningText()
    {
        static string Code(string? name) => $"<code class=\"jim-code-inline\">{System.Net.WebUtility.HtmlEncode(name)}</code>";

        if (SyncRule.Direction == SyncRuleDirection.Import)
        {
            var source = Code(_attributeFlowMappingSource?.ConnectedSystemAttribute?.Name);
            var target = Code(_attributeFlowMapping?.TargetMetaverseAttribute?.Name);
            return (MarkupString)(
                $"{source} is Multi-Valued but {target} is Single-Valued. If a synchronised object has more than one value, " +
                "no value will flow for this attribute and an error will be recorded against that object (a single value flows normally). " +
                "To always flow a value, target a Multi-Valued attribute or use an Expression to select one.");
        }

        var mvSource = Code(_attributeFlowMappingSource?.MetaverseAttribute?.Name);
        var csTarget = Code(_attributeFlowMapping?.TargetConnectedSystemAttribute?.Name);
        return (MarkupString)(
            $"{mvSource} is Multi-Valued but {csTarget} is Single-Valued. If an object has more than one value, " +
            "no value will be exported for this attribute and an error will be recorded against that object (a single value exports normally). " +
            "To always export a value, target a Multi-Valued attribute or use an Expression to select one.");
    }

    /// <summary>
    /// Whether an existing Attribute mapping flows a Multi-Valued source to a Single-Valued target (#435),
    /// used to flag the row/card in the Attribute Flow list.
    /// </summary>
    private bool MappingIsMvaToSva(SyncRuleMapping mapping)
    {
        if (mapping.GetSourceType() != SyncRuleMappingSourcesType.AttributeMapping)
            return false;

        var source = mapping.Sources.FirstOrDefault();
        if (source == null)
            return false;

        if (SyncRule.Direction == SyncRuleDirection.Import)
        {
            return source.ConnectedSystemAttribute is { AttributePlurality: AttributePlurality.MultiValued } csSource &&
                   csSource.Type != AttributeDataType.Reference &&
                   mapping.TargetMetaverseAttribute is { AttributePlurality: AttributePlurality.SingleValued };
        }

        return source.MetaverseAttribute is { AttributePlurality: AttributePlurality.MultiValued } &&
               mapping.TargetConnectedSystemAttribute is { AttributePlurality: AttributePlurality.SingleValued };
    }

    private bool DisableAddAttributeFlowMappingButton()
    {
        if (_attributeFlowMapping == null || _attributeFlowMappingSource == null || _attributeFlowMappingSourceType == null)
            return true;

        // Validate source is configured
        if (_attributeFlowMappingSourceType == "Attribute" &&
            _attributeFlowMappingSource.ConnectedSystemAttribute == null &&
            _attributeFlowMappingSource.MetaverseAttribute == null)
            return true;

        if (_attributeFlowMappingSourceType == "Expression" &&
            string.IsNullOrWhiteSpace(_attributeFlowMappingSource.Expression))
            return true;

        // Validate target is configured
        if (SyncRule.Direction == SyncRuleDirection.Import && _attributeFlowMapping.TargetMetaverseAttribute == null)
            return true;
        if (SyncRule.Direction == SyncRuleDirection.Export && _attributeFlowMapping.TargetConnectedSystemAttribute == null)
            return true;

        return false;
    }

    // import rules: the user can choose an invalid target attribute, depending on the makeup of the source attribute
    private bool IsAttributeFlowTargetDisabled(MetaverseAttribute targetMetaverseAttribute)
    {
        // Expression mappings can target any attribute (type compatibility is the user's responsibility)
        if (_attributeFlowMappingSourceType == "Expression")
            return false;

        if (_attributeFlowMappingSource?.ConnectedSystemAttribute == null)
            return true;

        if (targetMetaverseAttribute.Type != _attributeFlowMappingSource.ConnectedSystemAttribute.Type)
            return true;

        // Multi-valued to single-valued is permitted (#435) — the runtime selects the first value
        // and generates a warning RPEI so the administrator can verify correctness.

        return false;
    }

    // export rules: the user can choose an invalid target attribute, depending on the makeup of the source attribute
    private bool IsAttributeFlowTargetDisabled(ConnectedSystemObjectTypeAttribute targetConnectedSystemObjectTypeAttribute)
    {
        // read-only attributes cannot be targeted by export Attribute Flows
        if (targetConnectedSystemObjectTypeAttribute.Writability == AttributeWritability.ReadOnly)
            return true;

        // Expression mappings can target any writable attribute (type compatibility is the user's responsibility)
        if (_attributeFlowMappingSourceType == "Expression")
            return false;

        if (_attributeFlowMappingSource?.MetaverseAttribute == null)
            return true;

        if (targetConnectedSystemObjectTypeAttribute.Type != _attributeFlowMappingSource.MetaverseAttribute.Type)
            return true;

        // Multi-valued to single-valued is permitted (#435) — the runtime selects the first value
        // and generates a warning RPEI so the administrator can verify correctness.

        return false;
    }

    private async Task HandleAddAttributeFlowMappingButtonClick()
    {
        if (_attributeFlowMapping == null)
            return;

        // Only add to the list if this is a new mapping (not editing an existing one)
        if (!_isEditingAttributeFlow)
            SyncRule.AttributeFlowRules.Add(_attributeFlowMapping);

        // close the dialog and reset state
        _addAttributeFlowRuleDialogVisible = false;
        _attributeFlowMapping = null;
        _attributeFlowMappingSource = null;
        _isEditingAttributeFlow = false;
        await RefreshFlowGridAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task HandleAttributeFlowRuleDeleteClickAsync(SyncRuleMapping attributeFlowRule)
    {
        var confirmationResult = await DialogService.ShowMessageBoxAsync("Warning", "Are you sure you want to remove this Attribute Mapping?", yesText: "Remove!", cancelText: "Cancel");
        if (confirmationResult.HasValue && confirmationResult.Value)
        {
            SyncRule.AttributeFlowRules.Remove(attributeFlowRule);
            await RefreshFlowGridAsync();
            await OnChanged.InvokeAsync();
        }
    }

    /// <summary>
    /// Whether any of the page's own chip filters is narrowing the list. It tells the empty state apart from the
    /// "nothing configured yet" case, which has a different way out.
    /// </summary>
    private bool AnyAttributeFlowFilterIsActive =>
        _selectedMappingTypes.Count > 0 || _selectedDataTypes.Count > 0 || _selectedPluralities.Count > 0;

    /// <summary>
    /// Slices one window of the Synchronisation Rule's Attribute Flows, applying the page's chip filters, the
    /// grid's search (attribute names on either side, and expression text) and its sort. The flows are held on the
    /// rule the page already loaded, so there is no database range read.
    /// </summary>
    private Task<VirtualisedWindow<SyncRuleMapping>> LoadAttributeFlowWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        var flows = SyncRule.AttributeFlowRules.Where(FilterAttributeFlowRules);

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            flows = flows.Where(m =>
                GetSortableSourceName(m).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                GetSortableTargetName(m).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                m.Sources.Any(s => s.Expression != null && s.Expression.Contains(search, StringComparison.OrdinalIgnoreCase)));
        }

        IOrderedEnumerable<SyncRuleMapping> Order<TKey>(Func<SyncRuleMapping, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? flows.OrderByDescending(key, comparer) : flows.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "type" => Order(m => m.GetSourceType().ToString(), StringComparer.OrdinalIgnoreCase),
            "source" => Order(GetSortableSourceName, StringComparer.OrdinalIgnoreCase),
            "created" => Order(m => m.Created),
            "updated" => Order(m => m.LastUpdated ?? DateTime.MinValue),
            _ => Order(GetSortableTargetName, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    /// <summary>
    /// Reloads the grid after the set of Attribute Flows, or the filters over it, has changed. The totals are
    /// invalidated because the match set is a different one, and the reader is returned to the top because the
    /// position they held described rows that are no longer there.
    /// </summary>
    private async Task RefreshFlowGridAsync()
    {
        if (_flowGrid == null)
            return;

        await _flowGrid.ResetScrollAsync();
        await _flowGrid.RefreshAsync(invalidateTotals: true);
    }

    private bool FilterAttributeFlowRules(SyncRuleMapping mapping)
    {
        if (_selectedMappingTypes.Count > 0 && !_selectedMappingTypes.Contains(mapping.GetSourceType()))
            return false;

        AttributeDataType? dataType = SyncRule.Direction == SyncRuleDirection.Import
            ? mapping.TargetMetaverseAttribute?.Type
            : mapping.TargetConnectedSystemAttribute?.Type;

        AttributePlurality? plurality = SyncRule.Direction == SyncRuleDirection.Import
            ? mapping.TargetMetaverseAttribute?.AttributePlurality
            : mapping.TargetConnectedSystemAttribute?.AttributePlurality;

        if (_selectedDataTypes.Count > 0 && (dataType == null || !_selectedDataTypes.Contains(dataType.Value)))
            return false;

        if (_selectedPluralities.Count > 0 && (plurality == null || !_selectedPluralities.Contains(plurality.Value)))
            return false;

        return true;
    }

    private string GetSortableSourceName(SyncRuleMapping mapping)
    {
        var firstSource = mapping.Sources.OrderBy(s => s.Order).FirstOrDefault();
        if (firstSource == null) return string.Empty;

        if (SyncRule.Direction == SyncRuleDirection.Import && firstSource.ConnectedSystemAttribute != null)
            return firstSource.ConnectedSystemAttribute.Name;
        if (SyncRule.Direction == SyncRuleDirection.Export && firstSource.MetaverseAttribute != null)
            return firstSource.MetaverseAttribute.Name;
        if (!string.IsNullOrWhiteSpace(firstSource.Expression))
            return firstSource.Expression;

        return string.Empty;
    }

    private string GetSortableTargetName(SyncRuleMapping mapping)
    {
        if (SyncRule.Direction == SyncRuleDirection.Import)
            return mapping.TargetMetaverseAttribute?.Name ?? string.Empty;

        return mapping.TargetConnectedSystemAttribute?.Name ?? string.Empty;
    }

    private IEnumerable<KeyValuePair<SyncRuleMappingSourcesType, int>> GetAvailableMappingTypes()
    {
        return SyncRule.AttributeFlowRules
            .GroupBy(m => m.GetSourceType())
            .Select(g => new KeyValuePair<SyncRuleMappingSourcesType, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key.ToString());
    }

    private IEnumerable<KeyValuePair<AttributeDataType, int>> GetAvailableFlowDataTypes()
    {
        return SyncRule.AttributeFlowRules
            .Select(m => SyncRule.Direction == SyncRuleDirection.Import
                ? m.TargetMetaverseAttribute?.Type
                : m.TargetConnectedSystemAttribute?.Type)
            .Where(t => t.HasValue)
            .GroupBy(t => t!.Value)
            .Select(g => new KeyValuePair<AttributeDataType, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key.ToString());
    }

    private IEnumerable<KeyValuePair<AttributePlurality, int>> GetAvailableFlowPluralities()
    {
        return SyncRule.AttributeFlowRules
            .Select(m => SyncRule.Direction == SyncRuleDirection.Import
                ? m.TargetMetaverseAttribute?.AttributePlurality
                : m.TargetConnectedSystemAttribute?.AttributePlurality)
            .Where(p => p.HasValue)
            .GroupBy(p => p!.Value)
            .Select(g => new KeyValuePair<AttributePlurality, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key);
    }

    private async Task OnMappingTypeFilterChangedAsync(IReadOnlyCollection<SyncRuleMappingSourcesType> selected)
    {
        _selectedMappingTypes = selected;
        await RefreshFlowGridAsync();
    }

    private async Task OnFlowDataTypeFilterChangedAsync(IReadOnlyCollection<AttributeDataType> selected)
    {
        _selectedDataTypes = selected;
        await RefreshFlowGridAsync();
    }

    private async Task OnFlowPluralityFilterChangedAsync(IReadOnlyCollection<AttributePlurality> selected)
    {
        _selectedPluralities = selected;
        await RefreshFlowGridAsync();
    }
}
