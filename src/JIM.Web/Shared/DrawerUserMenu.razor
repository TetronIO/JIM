@if (_loaded)
{
    <div class="jim-user-menu @(!DrawerOpen ? "jim-user-menu-collapsed" : "")" @onclick="TogglePopover" @onclick:stopPropagation="true">
        @if (DrawerOpen)
        {
            <MudAvatar Color="Color.Primary" Size="Size.Small" Class="jim-user-avatar">@_initials</MudAvatar>
            <div class="jim-user-info">
                <MudText Typo="Typo.body2" Class="jim-user-name">@_displayName</MudText>
                @if (!string.IsNullOrEmpty(_preferredUsername))
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary jim-user-username">@_preferredUsername</MudText>
                }
            </div>
        }
        else
        {
            <MudTooltip Text="@_displayName" Arrow="true" Placement="Placement.Right">
                <MudAvatar Color="Color.Primary" Size="Size.Small" Class="jim-user-avatar">@_initials</MudAvatar>
            </MudTooltip>
        }
    </div>

    <MudPopover Open="@_popoverOpen" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter"
                Class="jim-user-popover">
        <MudPaper Outlined="true" Elevation="8" Class="jim-user-popover-paper pa-1">
            <MudList T="string" Dense="true" Class="py-0">
                <MudListItem OnClick="HandleToggleDarkMode">
                    <div class="d-flex align-center justify-space-between jim-user-menu-row">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@(IsDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.WbSunny)"
                                     Size="Size.Small" />
                            <MudText Typo="Typo.body2">@LayoutText.UserMenuDarkMode</MudText>
                        </div>
                        <MudSwitch T="bool" Value="@IsDarkMode" ReadOnly="true"
                                   Color="Color.Primary" Size="Size.Small" Class="ma-0 jim-user-menu-switch" />
                    </div>
                </MudListItem>
                @if (_languages.Count > 1)
                {
                    <MudDivider Class="my-1" />
                    <MudListItem OnClick="ToggleLanguages">
                        <div class="d-flex align-center justify-space-between gap-6 jim-user-menu-row">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" />
                                <MudText Typo="Typo.body2">@LayoutText.UserMenuLanguage</MudText>
                            </div>
                            <div class="d-flex align-center gap-1">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@_currentLanguage.NativeName</MudText>
                                <MudIcon Icon="@(_languagesOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                            </div>
                        </div>
                    </MudListItem>
                    @if (_languagesOpen)
                    {
                        @foreach (var language in _languages)
                        {
                            <MudListItem @key="language.CultureName" OnClick="@(() => SelectLanguage(language))" Class="jim-user-menu-language"
                                         lang="@language.CultureName">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@(language == _currentLanguage ? Icons.Material.Filled.Check : string.Empty)" Size="Size.Small" />
                                    <MudText Typo="Typo.body2">@LanguageLabel(language)</MudText>
                                </div>
                            </MudListItem>
                        }
                    }
                }
                @if (_isDevelopment)
                {
                    <MudDivider Class="my-1" />
                    <MudListItem OnClick="HandleViewClaims">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />
                            <MudText Typo="Typo.body2">@LayoutText.UserMenuViewClaims</MudText>
                        </div>
                    </MudListItem>
                }
                @if (_showSignOut)
                {
                    <MudDivider Class="my-1" />
                    <MudListItem OnClick="HandleSignOutAsync">
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" />
                            <MudText Typo="Typo.body2">@LayoutText.UserMenuSignOut</MudText>
                        </div>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudPopover>

    @if (_popoverOpen)
    {
        <MudOverlay Visible="true" OnClick="ClosePopover"
                    DarkBackground="false" LightBackground="false" />
    }
}

@code
{
    [Parameter]
    [EditorRequired]
    public bool DrawerOpen { get; set; }

    [Parameter]
    public bool IsDarkMode { get; set; }

    [Parameter]
    public EventCallback<bool> IsDarkModeChanged { get; set; }

    private bool _popoverOpen;
    private string? _displayName;
    private string? _preferredUsername;
    private string _initials = "?";
    private bool _showSignOut;
    private bool _isDevelopment;
    private bool _loaded;
    private bool _languagesOpen;
    private IReadOnlyList<UiLanguage> _languages = [];
    private UiLanguage _currentLanguage = UiLanguages.Default;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _displayName = user.FindFirstValue("name");
        _preferredUsername = user.FindFirstValue("preferred_username");
        _initials = GetInitials(_displayName);

        using var jim = JimFactory.Create();
        var settings = await jim.ServiceSettings.GetServiceSettingsAsync();
        _showSignOut = settings?.SSOEnableLogOut ?? true;

        _isDevelopment = Environment.IsDevelopment();

        // The languages this environment offers: released ones everywhere, unreleased ones in development builds.
        _languages = UiLanguages.Offered(includeUnreleased: _isDevelopment);
        _currentLanguage = UiLanguages.Current(CultureInfo.CurrentUICulture, includeUnreleased: _isDevelopment);

        _loaded = true;
    }

    private void TogglePopover()
    {
        _popoverOpen = !_popoverOpen;
    }

    private void ClosePopover()
    {
        _popoverOpen = false;
    }

    private async Task HandleToggleDarkMode()
    {
        await IsDarkModeChanged.InvokeAsync(!IsDarkMode);
    }

    private void ToggleLanguages()
    {
        _languagesOpen = !_languagesOpen;
    }

    /// <summary>
    /// A language's own name, marked as a preview where it is offered only because this is a development build.
    /// </summary>
    private static string LanguageLabel(UiLanguage language) =>
        language.IsReleased
            ? language.NativeName
            : string.Format(CultureInfo.CurrentCulture, LayoutText.LanguagePreview, language.NativeName);

    /// <summary>
    /// Stores the choice in the culture cookie and reloads the current page in it. A Blazor Server circuit runs in
    /// the culture it started with, so the page has to be loaded afresh for the new language to take effect.
    /// </summary>
    private void SelectLanguage(UiLanguage language)
    {
        ClosePopover();
        if (language == _currentLanguage)
            return;

        var currentPath = "/" + NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.NavigateTo(CultureSelection.SelectionUrl(language.CultureName, currentPath), forceLoad: true);
    }

    private void HandleViewClaims()
    {
        ClosePopover();
        NavigationManager.NavigateTo("/claims");
    }

    private async Task HandleSignOutAsync()
    {
        ClosePopover();

        var result = await DialogService.ShowMessageBoxAsync(
            LayoutText.SignOutDialogTitle,
            LayoutText.SignOutDialogMessage,
            yesText: LayoutText.SignOutDialogConfirm,
            cancelText: CommonText.Cancel);

        if (result.HasValue && result.Value)
        {
            NavigationManager.NavigateTo("/signout", forceLoad: true);
        }
    }

    private static string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{char.ToUpperInvariant(parts[0][0])}{char.ToUpperInvariant(parts[^1][0])}";

        return char.ToUpperInvariant(parts[0][0]).ToString();
    }
}
