@page "/admin/connected-systems/new"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Staging.DTOs
@using JIM.Models.Staging;
@using JIM.Web.Models;
@inject IJimApplicationFactory JimFactory
@inject IDialogService DialogService
@inject NavigationManager NavManager

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@ConnectedSystemText.CsCreatePageTitle</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>@ConnectedSystemText.CsCreateTitleLabel</span> <span class="mud-primary-text">@ConnectedSystemText.CsCreateNew</span>
    <PageInfo Title="@ConnectedSystemText.CsCreateInfoTitle" DocsPage="configuration/connected-systems.md">
        @ConnectedSystemText.CsCreateInfoBody
    </PageInfo>
</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

<MudPaper Class="pa-4 mt-2" Outlined="true">
    <MudForm @bind-IsValid="@_isFormValid" @bind-Errors="@_formErrors">
        <MudSelect T="string" Label="@ConnectedSystemText.CsCreateConnector" Placeholder="@ConnectedSystemText.CsCreateConnectorPlaceholder" Required="true"
                   @bind-Value="_model.ConnectorId" AdornmentIcon="@Icons.Material.Filled.Power" Adornment="Adornment.Start"
                   Variant="Variant.Outlined">
            @if (_connectorDefinitionHeaders != null)
            {
                foreach (var header in _connectorDefinitionHeaders)
                {
                    <MudSelectItem Value="@header.Id.ToString()">
                        @header.Name
                    </MudSelectItem>
                }
            }
        </MudSelect>
        <MudTextField Label="@CommonText.FieldName" Required="true" RequiredError="@ConnectedSystemText.ScimKeyNameRequired" @bind-Value="_model.Name"
                      Immediate="true" Variant="Variant.Outlined" />
        <MudTextField Label="@CommonText.FieldDescription" @bind-Value="_model.Description" Lines="5" MaxLines="10" Sizing="InputSizing.Auto" Variant="Variant.Outlined" />
    </MudForm>
</MudPaper>

<MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_isFormValid)" Class="mt-5"
           OnClick="HandleValidSubmit" DropShadow="false">@ConnectedSystemText.CsListCreate</MudButton>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private IList<ConnectorDefinitionHeader>? _connectorDefinitionHeaders;
    private readonly ConnectedSystemCreateViewModel _model = new();
    private bool _isFormValid;
    private string[] _formErrors = { };

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem(ConnectedSystemText.DetailBreadcrumbHome, href: "/", icon: Icons.Material.Filled.Home),
        new BreadcrumbItem(ConnectedSystemText.DetailBreadcrumbAdministration, href: "/admin"),
        new BreadcrumbItem(ConnectedSystemText.DetailBreadcrumbConnectedSystems, href: "/admin/connected-systems/"),
        new BreadcrumbItem(ConnectedSystemText.CsCreateNew, href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _connectorDefinitionHeaders = await jim.ConnectedSystems.GetConnectorDefinitionHeadersAsync();
    }

    private async Task HandleValidSubmit()
    {
        // offer an optional reason for the configuration change history; cancelling aborts the create
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, CommonText.Create);
        if (cancelled)
            return;

        using var jim = JimFactory.Create();
        var connectorDefinitionId = int.Parse(_model.ConnectorId);
        var connectorDefinition = await jim.ConnectedSystems.GetConnectorDefinitionAsync(connectorDefinitionId);
        if (connectorDefinition == null)
            return;

        var connectedSystem = new ConnectedSystem
        {
            Name = _model.Name,
            Description = _model.Description,
            ConnectorDefinitionId = connectorDefinitionId
        };

        // attribute the operation to the user
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.ConnectedSystems.CreateConnectedSystemAsync(connectedSystem, user, changeReason);
        NavManager.NavigateTo($"/admin/connected-systems/{connectedSystem.Id}");
    }
}
