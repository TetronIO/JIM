@* The Pending Export a Run Profile Execution Item created or failed on: its status, its staged attribute
   changes, and a link to the queue entry itself. Extracted from the item detail page when that page grew
   tabs (#1223); it is the whole content of the Pending Export tab, so the page no longer carries a second
   subject's markup inline. The opening sentence names which of the four situations the reader is in,
   because "staged for deletion", "awaiting export", "exported but unconfirmed" and "failed after retries"
   look identical in the table beneath and mean entirely different things. *@

<MudText Typo="Typo.body1" Class="mud-text-secondary mb-3">
    @if (PendingExport.ChangeType == PendingExportChangeType.Delete
         && ItemErrorType == ActivityRunProfileExecutionItemErrorType.NotSet)
    {
        <text>@ActivityText.ActivityPendingDelete</text>
    }
    else if (ItemObjectChangeType == ObjectChangeType.PendingExport
             && ItemErrorType == ActivityRunProfileExecutionItemErrorType.NotSet)
    {
        <text>@ActivityText.ActivityPendingAwaiting</text>
    }
    else if (ItemErrorType == ActivityRunProfileExecutionItemErrorType.ExportNotConfirmed)
    {
        <text>@ActivityText.ActivityPendingExportNotConfirmed</text>
    }
    else
    {
        <text>@ActivityText.ActivityPendingFailed</text>
    }
</MudText>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudGrid Spacing="3">
        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.button" Class="mud-text-secondary">@ActivityText.ActivityFieldConnectedSystem</MudText>
            <MudText>
                @if (PendingExport.ConnectedSystem != null)
                {
                    <MudLink Href="@($"/admin/connected-systems/{PendingExport.ConnectedSystemId}")">@PendingExport.ConnectedSystem.Name</MudLink>
                }
                else
                {
                    <EmptyValue />
                }
            </MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.button" Class="mud-text-secondary">@ActivityText.ActivityPendingChangeType</MudText><br />
            <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetPendingExportChangeTypeColor(PendingExport.ChangeType)"
                     Class="ml-0">
                @PendingExport.ChangeType
            </MudChip>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.button" Class="mud-text-secondary">@ActivityText.ActivityColumnStatus</MudText><br />
            <MudChip T="string" Variant="Variant.Text" Color="GetStatusColor(PendingExport.Status)" Class="ml-0">
                @PendingExport.Status.ForDisplay()
            </MudChip>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.button" Class="mud-text-secondary">@ActivityText.ActivityChipFailedAttempts</MudText>
            <MudText>
                @PendingExport.ErrorCount
                @if (PendingExport.FailingSince is { } failingSince)
                {
                    <MudTooltip Text="@string.Format(System.Globalization.CultureInfo.CurrentCulture, ActivityText.ActivityPendingFailingSince, failingSince.ToLocalTime().ToFriendlyDate())" Arrow="true" Placement="Placement.Top">
                        <MudChip T="string" Color="Color.Error" Class="ml-2">@ActivityText.ActivityPendingFailing</MudChip>
                    </MudTooltip>
                }
            </MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.button" Class="mud-text-secondary">@ActivityText.ActivityPendingLastAttempted</MudText>
            <MudText>
                @if (PendingExport.LastAttemptedAt is { } lastAttemptedAt)
                {
                    @lastAttemptedAt.ToLocalTime().ToRelativeTime()
                }
                else
                {
                    <EmptyValue />
                }
            </MudText>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudText Typo="Typo.button" Class="mud-text-secondary">@ActivityText.ActivityColumnCreated</MudText>
            <MudText>@PendingExport.CreatedAt.ToLocalTime().ToRelativeTime()</MudText>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (PendingExport.AttributeValueChanges.Count > 0)
{
    <MudText Typo="Typo.subtitle1" Class="mb-2">
        @string.Format(System.Globalization.CultureInfo.CurrentCulture, ActivityText.ActivityPendingAttributeChangesHeading, PendingExport.AttributeValueChanges.Count.ToString("N0", System.Globalization.CultureInfo.CurrentCulture))
    </MudText>
    <MudTable Items="@PendingExport.AttributeValueChanges" Hover="true" Dense="true" Outlined="true" Elevation="0"
              Class="mb-5">
        <HeaderContent>
            <MudTh Style="width: 1%; white-space: nowrap;">
                <MudText Typo="Typo.button">@ActivityText.ActivityColumnAttribute</MudText>
            </MudTh>
            <MudTh Style="width: 1%; white-space: nowrap;">
                <MudText Typo="Typo.button">@ActivityText.ActivityPendingChangeType</MudText>
            </MudTh>
            <MudTh Style="width: 1%; white-space: nowrap;">
                <MudText Typo="Typo.button">@ActivityText.ActivityColumnStatus</MudText>
            </MudTh>
            <MudTh>
                <MudText Typo="Typo.button">@ActivityText.ActivityColumnValue</MudText>
            </MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@ActivityText.ActivityColumnAttribute">
                <MudText Class="mud-text-secondary">@(context.Attribute?.Name ?? string.Format(System.Globalization.CultureInfo.CurrentCulture, ActivityText.ActivityPendingAttributeFallback, context.AttributeId))</MudText>
            </MudTd>
            <MudTd DataLabel="@ActivityText.ActivityPendingChangeType">
                <MudChip T="string" Variant="Variant.Text" Color="GetAttributeChangeTypeColor(context.ChangeType)"
                         Class="ml-0">
                    @context.ChangeType
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@ActivityText.ActivityColumnStatus">
                <MudChip T="string" Variant="Variant.Text" Color="GetAttributeStatusColor(context.Status)"
                         Class="ml-0">
                    @context.Status.ForDisplay()
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@ActivityText.ActivityColumnValue"><TextValueDisplay Value="@GetAttributeValue(context)" /></MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="pa-4">@ActivityText.ActivityPendingNoAttributeChanges</MudText>
        </NoRecordsContent>
    </MudTable>
}

@* Link to full Pending Export details *@
@if (ConnectedSystemId is { } connectedSystemId)
{
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.OpenInNew"
               Href="@($"/admin/connected-systems/{connectedSystemId}/pending-exports/{PendingExport.Id}")">
        @ActivityText.ActivityPendingViewDetails
    </MudButton>
}

@code {
    /// <summary>
    /// The Pending Export to describe.
    /// </summary>
    [Parameter, EditorRequired]
    public PendingExport PendingExport { get; set; } = null!;

    /// <summary>
    /// The execution item's error type, which decides which of the four opening sentences applies: the same
    /// Pending Export means "staged and waiting" on a clean item and "failed after retries" on a failed one.
    /// </summary>
    [Parameter]
    public ActivityRunProfileExecutionItemErrorType ItemErrorType { get; set; }

    /// <summary>
    /// The execution item's object change type; see <see cref="ItemErrorType"/>.
    /// </summary>
    [Parameter]
    public ObjectChangeType ItemObjectChangeType { get; set; }

    /// <summary>
    /// The Connected System the record belongs to, used to build the link to the queue entry itself. Null
    /// renders no link rather than a broken one, since Pending Export lookups are scoped by both ids.
    /// </summary>
    [Parameter]
    public int? ConnectedSystemId { get; set; }

    private static Color GetStatusColor(PendingExportStatus status)
    {
        return status switch
        {
            PendingExportStatus.Pending => Color.Default,
            PendingExportStatus.Executing => Color.Info,
            PendingExportStatus.Exported => Color.Success,
            PendingExportStatus.ExportNotConfirmed => Color.Warning,
            PendingExportStatus.Parked => Color.Warning,
            _ => Color.Default,
        };
    }

    private static Color GetAttributeChangeTypeColor(PendingExportAttributeChangeType changeType)
    {
        return changeType switch
        {
            PendingExportAttributeChangeType.Add => Color.Primary,
            PendingExportAttributeChangeType.Update => Color.Info,
            PendingExportAttributeChangeType.Remove => Color.Warning,
            PendingExportAttributeChangeType.RemoveAll => Color.Error,
            _ => Color.Default,
        };
    }

    private static Color GetAttributeStatusColor(PendingExportAttributeChangeStatus status)
    {
        return status switch
        {
            PendingExportAttributeChangeStatus.Pending => Color.Default,
            PendingExportAttributeChangeStatus.ExportedPendingConfirmation => Color.Info,
            PendingExportAttributeChangeStatus.ExportedNotConfirmed => Color.Warning,
            _ => Color.Default,
        };
    }

    private static string GetAttributeValue(PendingExportAttributeValueChange change) =>
        JIM.Web.Models.PendingExportValueDisplay.Text(change, localTime: true) ?? "[null]";
}
