@page "/activity/item/{Id:guid}"
@attribute [Authorize(Roles = "User")]
@using JIM.Models.Activities;
@using JIM.Models.Activities.DTOs
@using JIM.Models.Core
@using JIM.Models.Core.DTOs
@using JIM.Models.Enums;
@using JIM.Models.Staging
@using JIM.Models.Staging.DTOs
@using JIM.Models.Sync
@using JIM.Models.Transactional
@using JIM.Models.Utility
@using JIM.Utilities;
@using JIM.Web.Causality
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Item Details: @(_externalIdAttributeValue?.ToStringNoName() ??
        _activityRunProfileExecutionItem?.Id.ToString())</PageTitle>

    @if (_activityRunProfileExecutionItem != null)
    {
        @* Page Title - must come before breadcrumbs for consistency *@
        @* No status icon after the title: the title already says what happened ("Person Deletion Detected"),
           and the Operation field below states it again with its own icon. *@
        <MudText Typo="Typo.h3" Class="mb-2"><MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />@GetStatusTitle()
            <PageInfo Title="Execution Item" DocsPage="configuration/activity-execution-items.md">
                What one Run Profile run did to one object: what happened, what it went on to cause, and any error it met.
            </PageInfo>
        </MudText>
        <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0 mb-4"></MudBreadcrumbs>

        @* The item's own story (what it did, why, and what it changed) is one subject; the Pending Export
           it created or failed on is another, with its own status, retries and attribute table. Keeping
           both inline made the page a scroll rather than an answer, so each has its own tab. The Pending
           Export tab appears only where there is one. *@
        <NavigableMudTabs Class="mt-2" TabPanelsClass="pt-6">
        <MudTabPanel Text="Overview">

        @* Summary Section *@
        <MudText Typo="Typo.h6" Class="mb-2">
            Execution Summary
        </MudText>
        <MudText Typo="Typo.body1" Class="mud-text-secondary mb-3">
            @GetStatusDescription()
        </MudText>
        <MudPaper Class="pa-4 mb-5" Outlined="true">
            <MudGrid Spacing="4">
                @* Connected System - the system the Run Profile executed against *@
                @if (_runConnectedSystemHeader != null)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Connected System</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Storage" Class="mud-text-secondary" />
                            <MudLink Href="@Utilities.GetConnectedSystemHref(_runConnectedSystemHeader)">
                                @_runConnectedSystemHeader.Name
                            </MudLink>
                        </MudStack>
                    </MudItem>
                }

                @* Run Profile *@
                @if (_activity != null)
                {
                    var executedLocal = _activity.Executed.ToLocalTime();

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">@(IsHousekeepingContext() ? "Activity" : "Run Profile")</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Class="mud-text-secondary" />
                            <MudText>@_activity.TargetName</MudText>
                        </MudStack>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Executed</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Schedule" Class="mud-text-secondary" />
                            <MudText>@executedLocal.ToFriendlyDate() (@executedLocal.ToRelativeTime())</MudText>
                        </MudStack>
                    </MudItem>
                }

                @* Initiated By *@
                <MudItem xs="12" sm="6" md="4">
                    <MudText Typo="Typo.button" Class="mud-text-secondary">Initiated By</MudText>
                    @if (_activity != null)
                    {
                        <MudText>
                            <InitiatorChip InitiatedByType="@_activity.InitiatedByType"
                                               InitiatedById="@_activity.InitiatedById"
                                               InitiatedByName="@_activity.InitiatedByName"
                                               UserHref="@(_initiatorMetaverseObjectHeader != null ? Utilities.GetMetaverseObjectHref(_initiatorMetaverseObjectHeader) : null)"
                                               UserLookedUp="@(_activity.InitiatedByType == ActivityInitiatorType.User)"
                                               ScheduleName="@_activity.ScheduledByScheduleName"
                                               ScheduleExecutionId="@_activity.ScheduleExecutionId" />
                        </MudText>
                    }
                    else
                    {
                        <EmptyValue />
                    }
                </MudItem>

                @* Change Type - hide when NotSet with error (rejected imports don't have an operation) *@
                @if (!(_activityRunProfileExecutionItem.ObjectChangeType == ObjectChangeType.NotSet &&
                        _activityRunProfileExecutionItem.ErrorType != ActivityRunProfileExecutionItemErrorType.NotSet))
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Operation</MudText><br />
                        <MudTooltip Arrow="true" Placement="Placement.Top">
                            <TooltipContent>
                                <TooltipText Text="@Helpers.GetOperationDescription(_activityRunProfileExecutionItem.ObjectChangeType, IsSyncContext())" />
                            </TooltipContent>
                            <ChildContent>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="jim-explained">
                                    <MudIcon Icon="@GetStatusIcon()" Class="mud-text-secondary" />
                                    <MudText>@GetOperationDisplayText()</MudText>
                                </MudStack>
                            </ChildContent>
                        </MudTooltip>
                    </MudItem>
                }

                @* Connected System Object / External ID - label changes based on context *@
                <MudItem xs="12" sm="6" md="4">
                    <MudText Typo="Typo.button" Class="mud-text-secondary">@GetObjectFieldLabel()</MudText><br />
                    @if (_activityRunProfileExecutionItem.ConnectedSystemObject != null)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap">
                            @if (GetCsoChipName() != null)
                            {
                                <ObjectChip Kind="ObjectChipKind.ConnectedSystemObject"
                                            TypeName="@_activityRunProfileExecutionItem.ConnectedSystemObject.Type.Name"
                                            Name="@GetCsoChipName()"
                                            Tooltip="@GetCsoChipTooltip()"
                                            Href="@(Utilities.GetConnectedSystemObjectHref(_activityRunProfileExecutionItem.ConnectedSystemObject))" />
                            }
                            else
                            {
                                @* No display name or external ID to identify the record by yet, so the chip carries
                                   the type alone and the link stands beside it rather than wrapping it. *@
                                <ObjectChip Kind="ObjectChipKind.ConnectedSystemObject"
                                            TypeName="@_activityRunProfileExecutionItem.ConnectedSystemObject.Type.Name" />
                                <MudLink
                                    Href="@(Utilities.GetConnectedSystemObjectHref(_activityRunProfileExecutionItem.ConnectedSystemObject))">
                                    View Object
                                </MudLink>
                            }
                        </MudStack>
                    }
                    else if (_activityRunProfileExecutionItem.MetaverseObjectId.HasValue)
                    {
                        @* The item records a Metaverse Object rather than a Connected System Object (an export scope
                           review, #1971): link it while it exists, and say so once it has been deleted. *@
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap">
                            @if (_identityHeader != null)
                            {
                                <ObjectChip Kind="ObjectChipKind.MetaverseObject"
                                            TypeName="@_identityHeader.TypeName"
                                            Name="@_identityHeader.NameOrId"
                                            Href="@Utilities.GetMetaverseObjectHref(_identityHeader)" />
                            }
                            else
                            {
                                <ObjectChip Kind="ObjectChipKind.MetaverseObject"
                                            TypeName="@(_activityRunProfileExecutionItem.ObjectTypeSnapshot ?? "Object")"
                                            Name="@_activityRunProfileExecutionItem.DisplayNameSnapshot" />
                                <MudText Class="mud-text-secondary">(deleted)</MudText>
                            }
                        </MudStack>
                    }
                    else if (!string.IsNullOrEmpty(_activityRunProfileExecutionItem.ExternalIdSnapshot))
                    {
                        @* CSO doesn't exist but we have an external ID snapshot - differentiate between error (rejected) vs deleted *@
                        @if (RecordsRejection())
                        {
                            <MudTooltip Arrow="true" Placement="Placement.Top">
                                <TooltipContent>
                                    <TooltipText Text="@Helpers.GetExternalIdStatusDescription(ExternalIdStatus.Rejected)" />
                                </TooltipContent>
                                <ChildContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="jim-explained">
                                        <MudIcon Icon="@Helpers.GetExternalIdStatusIcon(ExternalIdStatus.Rejected)" Class="mud-text-secondary" />
                                        <MudText>Rejected: @_activityRunProfileExecutionItem.ExternalIdSnapshot</MudText>
                                    </MudStack>
                                </ChildContent>
                            </MudTooltip>
                        }
                        else if (!IsSyncContext() && _activityRunProfileExecutionItem.ObjectChangeType == ObjectChangeType.Deleted)
                        {
                            @* Import context: CSO detected as deleted but not yet removed *@
                            <MudTooltip Arrow="true" Placement="Placement.Top">
                                <TooltipContent>
                                    <TooltipText Text="@Helpers.GetExternalIdStatusDescription(ExternalIdStatus.PendingRemoval)" />
                                </TooltipContent>
                                <ChildContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="jim-explained">
                                        <MudIcon Icon="@Helpers.GetExternalIdStatusIcon(ExternalIdStatus.PendingRemoval)" Class="mud-text-secondary" />
                                        <MudText>Pending Removal: @_activityRunProfileExecutionItem.ExternalIdSnapshot</MudText>
                                    </MudStack>
                                </ChildContent>
                            </MudTooltip>
                        }
                        else
                        {
                            @* Sync context or disconnected: CSO has been deleted *@
                            <MudTooltip Arrow="true" Placement="Placement.Top">
                                <TooltipContent>
                                    <TooltipText Text="@Helpers.GetExternalIdStatusDescription(ExternalIdStatus.Deleted)" />
                                </TooltipContent>
                                <ChildContent>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="jim-explained">
                                        <MudIcon Icon="@Helpers.GetExternalIdStatusIcon(ExternalIdStatus.Deleted)" Class="mud-text-secondary" />
                                        <MudText>Deleted: @_activityRunProfileExecutionItem.ExternalIdSnapshot</MudText>
                                    </MudStack>
                                </ChildContent>
                            </MudTooltip>
                        }
                    }
                    else if (IsHousekeepingContext() && !string.IsNullOrEmpty(_activityRunProfileExecutionItem.DisplayNameSnapshot))
                    {
                        @* Housekeeping deletion: no CSO involved; show the deleted Metaverse Object's name *@
                        <MudText Class="mud-text-secondary">@_activityRunProfileExecutionItem.DisplayNameSnapshot (deleted)</MudText>
                    }
                    else
                    {
                        @* No CSO and no external ID snapshot - the object has been deleted *@
                        <MudText Class="mud-text-secondary">The Connected System Object has been deleted.</MudText>
                    }
                </MudItem>

                @* Where the Connector read the object from, such as a file and row (#2066), where it said. *@
                @if (!string.IsNullOrEmpty(_activityRunProfileExecutionItem.SourceLocation))
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.button" Class="mud-text-secondary">Source</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Outlined.Description" Class="mud-text-secondary" />
                            <MudText Class="jim-text-code">@_activityRunProfileExecutionItem.SourceLocation</MudText>
                        </MudStack>
                    </MudItem>
                }
            </MudGrid>
        </MudPaper>

        @* What a detected deletion means next. Forward-looking rather than causal: the run recorded that the
           record is gone from the source, and the Deletion Rule has not been evaluated yet. It sits at page
           level rather than inside a Deletion Rule section because it describes what a later Synchronisation
           will do, not what this run decided. *@
        @if (!IsSyncContext() && !IsHousekeepingContext()
             && _activityRunProfileExecutionItem.ObjectChangeType == ObjectChangeType.Deleted)
        {
            <MudAlert Severity="Severity.Info" Class="mb-5">
                <MudText Typo="Typo.body1">
                    The Connected System Object has been detected as deleted from the source system and marked for
                    removal. When a Full Synchronisation or Delta Synchronisation Run Profile is executed, JIM will
                    disconnect this object from the metaverse and evaluate the Deletion Rule for its Metaverse
                    Object Type.
                </MudText>
            </MudAlert>
        }

        @* Causality - shows what the run did to this object and what it caused *@
        @if (CausalityItemLoader.ShowsCausality(_activityRunProfileExecutionItem) && _causality is { } causality)
        {
            <MudText Typo="Typo.h6" Class="mb-2">
                Causality
            </MudText>
            <MudText Typo="Typo.body1" Class="mud-text-secondary mb-3">
                What happened during processing and the downstream consequences.
            </MudText>
            <div class="mb-5">
                <CausalityPanel Item="causality.Item"
                                Context="causality.Context"
                                LivePendingExportIds="causality.LivePendingExportIds"
                                Timestamp="causality.Timestamp"
                                Chain="causality.Chain"
                                ChangeValues="causality.ChangeValues"
                                DeletionPolicySnapshot="causality.DeletionPolicySnapshot"
                                IsSynchronisationRun="causality.IsSynchronisationRun"
                                ExplorerHref="@(_isAdministrator ? $"/causality/items/{causality.Item.Id}" : null)"
                                Consequences="_consequences"
                                ConsequencesLoading="_consequencesLoading"
                                OnCheckConsequencesAgain="CheckConsequencesAgainAsync"
                                LoadConsequenceMembers="LoadConsequenceMembersAsync"
                                LoadAttributeRows="LoadAttributeRowsAsync" />
            </div>

            @* The decision-time Deletion Rule (#119), as detail behind the outcome rather than as a titled
               section of its own. The causality panel above already says what happened to the Identity; this
               is the rule that decided it, which most readers never need to open. *@
            @if (_deletionPolicySnapshot != null)
            {
                @* `jim-expansion-panel` is the house treatment (border and the container radius token),
                   which is what makes this sit with the causality panel above it. MudBlazor's own
                   `Outlined` styles the inner panels rather than this container, so it produced no border
                   at all here and left the default 4px radius against the panel above's 10px. *@
                <MudExpansionPanels Class="mb-5 jim-expansion-panel" Elevation="0">
                    <MudExpansionPanel Text="Deletion Rule in force at the time">
                        <DeletionPolicySnapshotView Snapshot="_deletionPolicySnapshot"
                                                    ObjectTypeName="@_metaverseObjectType?.Name" />
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        }



        @* ─── What went wrong ─── *@
        @* Before what changed: an import's attribute table can run to thousands of rows, and an error below it was
           an error nobody scrolled to. An error is part of the item's own story, so it stays on this tab; the Pending
           Export it produced is a separate subject and has its own tab. *@
        @if (_activityRunProfileExecutionItem.ErrorType is { } errorType
             and not ActivityRunProfileExecutionItemErrorType.NotSet
             && _unresolvedReferenceTone != UnresolvedReferenceTone.Error
             && _attributeValueErrors == null)
        {
            <MudText Typo="Typo.h6" Class="mb-3">
                Error Details
            </MudText>

            <MudAlert Severity="Severity.Error" Class="mb-3 jim-alert-error">
                <MudText Typo="Typo.body1" Style="font-weight: 500;">
                    @Helpers.GetErrorTypeChipLabel(errorType)
                </MudText>
                @if (!string.IsNullOrEmpty(_activityRunProfileExecutionItem.ErrorMessage))
                {
                    <MudText Typo="Typo.body1" Class="mt-2">@_activityRunProfileExecutionItem.ErrorMessage</MudText>
                }
            </MudAlert>

            <MatchCandidatesPanel Candidates="@_matchCandidates" />

            <CollapsibleStackTrace StackTrace="@_activityRunProfileExecutionItem.ErrorStackTrace" />
        }

        @* Values the Connector could not read (#2066), laid out one per row, in place of the Error Details above. An
           item without them recorded (from before they were kept, or a Connector that reports a message alone) keeps
           its Error Details. *@
        @if (_attributeValueErrors is { } attributeValueErrors)
        {
            <AttributeValuesNotImportedSection Errors="@attributeValueErrors"
                                               SourceLocation="@_activityRunProfileExecutionItem.SourceLocation"
                                               ConnectedSystemId="@_connectedSystemHeader?.Id"
                                               ObjectTypeName="@(_activityRunProfileExecutionItem.ConnectedSystemObject?.Type?.Name ?? _activityRunProfileExecutionItem.ObjectTypeSnapshot)"
                                               Class="mb-5" />
        }

        @* References the import left unresolved (#959), listed with the likely cause of each. Red where the run
           counted them as the item's error, in place of the Error Details above; amber where it left them unresolved
           without doing so. Export items keep their Error Details: what an export could not resolve is a Metaverse
           reference, which this section does not describe. *@
        @if (_unresolvedReferenceTone != UnresolvedReferenceTone.None && _connectedSystemHeader != null)
        {
            <UnresolvedReferencesSection ConnectedSystemId="@_connectedSystemHeader.Id"
                                         ConnectedSystemObjectId="@_activityRunProfileExecutionItem.ConnectedSystemObjectId"
                                         IsRunContext="true"
                                         Tone="@_unresolvedReferenceTone"
                                         RunCount="@_activityRunProfileExecutionItem.UnresolvedReferenceCount"
                                         ItemErrorType="@_activityRunProfileExecutionItem.ErrorType"
                                         RecordedMessage="@_activityRunProfileExecutionItem.ErrorMessage"
                                         ObjectTypeName="@(_activityRunProfileExecutionItem.ConnectedSystemObject?.Type?.Name ?? _activityRunProfileExecutionItem.ObjectTypeSnapshot)"
                                         Class="mb-5" />
        }

                    @* Attribute Changes Section - hide when:
                       - deletions (no attribute changes to show)
                       - Causality Tree is present (it already renders attribute detail inline) *@
                    @if (_activityRunProfileExecutionItem.ConnectedSystemObjectChange != null
                    && _activityRunProfileExecutionItem.ObjectChangeType != ObjectChangeType.Deleted
                    && _activityRunProfileExecutionItem.SyncOutcomes.Count == 0)
                    {
                        <MudText Typo="Typo.h6" Class="mb-3">Attribute Changes</MudText>

                        <MudText Typo="Typo.body1" Class="mud-text-secondary mb-3">
                            @GetAttributeChangesDescription()
                        </MudText>

                        @* The change's values are read a window at a time (#2498), never with the item; the
                           scrolling, the search box, the count and the density all belong to the shared grid. Its URL parameters carry the ac- prefix so the two grids on
                           this page cannot overwrite each other's state. *@
                        <VirtualisedDataGrid T="FlattenedChange"
                                             ContainerId="rpei-attribute-changes"
                                             UrlParameterPrefix="ac-"
                                             StateKey="@Id.ToString()"
                                             DefaultSortBy="attribute"
                                             LoadWindow="LoadAttributeChangeWindowAsync"
                                             SingularName="Attribute Change"
                                             PluralName="Attribute Changes"
                                             SearchPlaceholder="Search attribute or value">
                            <Columns>
                                <TemplateColumn T="FlattenedChange" Title="Attribute" Sortable="false" CellClass="jim-nowrap">
                                    <HeaderTemplate>
                                        <VirtualisedSortHeader Title="Attribute" Name="attribute" />
                                    </HeaderTemplate>
                                    <CellTemplate>
                                        <MudText Class="mud-text-secondary">@context.Item.AttributeName</MudText>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn T="FlattenedChange" Title="Change" Sortable="false" CellClass="jim-nowrap">
                                    <HeaderTemplate>
                                        <VirtualisedSortHeader Title="Change" Name="change" />
                                    </HeaderTemplate>
                                    <CellTemplate>
                                        <MudChip T="string" Variant="Variant.Text"
                                                 Color="@Helpers.GetMudBlazorColorForValueChangeType(context.Item.ChangeType)" Class="ml-0">
                                            @context.Item.ChangeType
                                        </MudChip>
                                    </CellTemplate>
                                </TemplateColumn>
                                <TemplateColumn T="FlattenedChange" Title="Value" Sortable="false">
                                    <HeaderTemplate>
                                        <MudText Typo="Typo.button">Value</MudText>
                                    </HeaderTemplate>
                                    <CellTemplate>
                                        @if (context.Item.ReferenceValue is { } reference)
                                        {
                                            @* The CsoReferenceLink shape, from the change record's reference rather than the object *@
                                            <span class="jim-attr-reference">
                                                <MudChip T="string" Color="Color.Default" Class="mr-1">@reference.TypeName</MudChip>
                                                <MudLink Href="@Utilities.GetConnectedSystemObjectHref(reference.ConnectedSystemId, reference.Id)">
                                                    @(reference.DisplayName ?? reference.Id.ToString())
                                                </MudLink>
                                                @if (!string.IsNullOrEmpty(reference.SecondaryId))
                                                {
                                                    <span class="jim-attr-secondary-id mud-text-secondary jim-text-code ml-1">- @reference.SecondaryId</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <MudText>@context.Item.Value</MudText>
                                        }
                                    </CellTemplate>
                                </TemplateColumn>
                            </Columns>
                            <EmptyContent Context="grid">
                                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                                {
                                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                                     PrimaryText="@($"No Attribute Changes match \"{grid.SearchText}\"")"
                                                     SecondaryText="Try a different search term, or clear the search."
                                                     ActionText="Clear Search"
                                                     OnAction="@(() => grid.ClearSearchAsync())" />
                                }
                                else
                                {
                                    <TableEmptyState Icon="@Icons.Material.Filled.EditNote"
                                                     PrimaryText="No Attribute Changes were recorded"
                                                     SecondaryText="This operation changed no attribute values on the object." />
                                }
                            </EmptyContent>
                        </VirtualisedDataGrid>
                        }
else if (_activityRunProfileExecutionItem.ObjectChangeType == ObjectChangeType.NoChange)
                        {
                            <MudAlert Severity="Severity.Info" Class="mb-5">
                                <MudText Typo="Typo.body1">No Changes Required</MudText>
                                <MudText Typo="Typo.body1">
                                    @if (_activityRunProfileExecutionItem.NoChangeReason != null)
                                    {
                                        @_activityRunProfileExecutionItem.NoChangeReason.ToString()!.SplitOnCapitalLetters()
                                    }
                                    else
                                    {
                                        <text>The object was already up to date with no attribute changes needed.</text>
                                    }
                                </MudText>
                            </MudAlert>
                        }

        </MudTabPanel>

        @* Shown only where there is one: an empty tab invites a click that answers nothing. *@
        @if (_pendingExport != null)
        {
            <MudTabPanel Text="Pending Export">
                <ActivityItemPendingExportPanel PendingExport="_pendingExport"
                                                ItemErrorType="@(_activityRunProfileExecutionItem.ErrorType ?? ActivityRunProfileExecutionItemErrorType.NotSet)"
                                                ItemObjectChangeType="_activityRunProfileExecutionItem.ObjectChangeType"
                                                ConnectedSystemId="_connectedSystemHeader?.Id" />
            </MudTabPanel>
        }
        </NavigableMudTabs>
    }
    else
    {
        <MudProgressCircular Indeterminate="true" />
    }

@code {
    [Parameter]
    public Guid Id { get; set; }

    private ActivityRunProfileExecutionItem? _activityRunProfileExecutionItem;
    private Activity? _activity;
    private ConnectedSystemHeader? _connectedSystemHeader;
    private ConnectedSystemHeader? _runConnectedSystemHeader;
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private bool _fromOperations;
    private ConnectedSystemObjectAttributeValue? _externalIdAttributeValue;
    private PendingExport? _pendingExport;
    private MetaverseObjectType? _metaverseObjectType;

    // How the Unresolved References section presents itself (#959); None outside an import, and where the run left
    // every reference resolved.
    private UnresolvedReferenceTone _unresolvedReferenceTone;

    // The values the Connector could not read (#2066), or null where the item recorded none.
    private ImportedAttributeValueErrors? _attributeValueErrors;

    // The Identity this item acted on, looked up once by id (#1495); see CausalityItemLoader.
    private MetaverseObjectHeader? _identityHeader;
    private MetaverseObjectHeader? _initiatorMetaverseObjectHeader;

    // Everything the causality panel needs (#2100), read by the loader the Causality Explorer shares, so the panel
    // stays a rendering component with no data access of its own. The fields above that the page's own sections also
    // show are taken from it.
    private CausalityItemData? _causality;

    // The downward walk (#1811): what this item went on to cause. Read after the first render, so the panel never waits
    // on it, and read again only when the reader asks to check while a branch is waiting.
    private CausalConsequences? _consequences;
    private bool _consequencesLoading;
    private Guid? _consequencesReadFor;

    /// <summary>The objects an ambiguous match found (#2052); empty for any other item.</summary>
    private IReadOnlyList<MatchCandidateDetail> _matchCandidates = [];

    // Decision-time deletion policy snapshot (#119): the deletion rule context panels render from the facts
    // recorded when the decision was made, never from the object type's current configuration, so the
    // explanation stays accurate after an administrator edits the rule.
    private MvoDeletionPolicySnapshot? _deletionPolicySnapshot;


    /// <summary>
    /// Removes the "Eligible for deletion: ..." segment from a deletion outcome's detail message, for
    /// callers that already state the due date in their own sentence (#119). The segments are joined
    /// with ". ", and the due date is always last.
    /// </summary>
    private static string StripEligibleForDeletionSegment(string? detailMessage)
    {
        if (string.IsNullOrEmpty(detailMessage))
            return string.Empty;

        var index = detailMessage.IndexOf("Eligible for deletion:", StringComparison.Ordinal);
        return index < 0 ? detailMessage : detailMessage[..index].TrimEnd(' ', '.');
    }

    /// <summary>
    /// Helper record for flattened changes display in the table.
    /// </summary>
    private record FlattenedChange(
    string AttributeName,
    ValueChangeType ChangeType,
    string? Value,
    CsoChangeReferenceDto? ReferenceValue);

    /// <summary>
    /// The sort key standing for "the order the Pending Export staged them in". No column claims it, so the grid
    /// shows no sort arrow over an order the reader did not choose.
    /// </summary>
    private const string PendingExportSourceOrderSort = "order";

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    // Whether the reader is an Administrator, and so may follow "Open in explorer" to the Causality Explorer.
    private bool _isAdministrator;

    protected override async Task OnParametersSetAsync()
    {
        _isAdministrator = (await AuthenticationStateTask).User.IsInRole("Administrator");

        if (_consequencesReadFor != Id)
        {
            _consequences = null;
            _consequencesReadFor = null;
        }

        using var jim = JimFactory.Create();
        _causality = await CausalityItemLoader.LoadAsync(jim, Id);
        if (_causality == null)
        {
            _activityRunProfileExecutionItem = null;
            NavManager.NavigateTo("/activity");
            return;
        }

        _activityRunProfileExecutionItem = _causality.Item;
        _activity = _causality.Activity;
        _connectedSystemHeader = _causality.RecordConnectedSystem;
        _runConnectedSystemHeader = _causality.RunConnectedSystem;
        _externalIdAttributeValue = _causality.ExternalIdAttributeValue;
        _deletionPolicySnapshot = _causality.DeletionPolicySnapshot;
        _identityHeader = _causality.IdentityHeader;
        _metaverseObjectType = _causality.MetaverseObjectType;
        _unresolvedReferenceTone = IsImportContext()
            ? UnresolvedReferenceDisplay.ToneFor(_activityRunProfileExecutionItem.ErrorType, _activityRunProfileExecutionItem.UnresolvedReferenceCount)
            : UnresolvedReferenceTone.None;

        _attributeValueErrors = AttributeValueErrorDisplay.ForItem(_activityRunProfileExecutionItem.AttributeValueErrorsJson);

        if (_activity is { InitiatedByType: ActivityInitiatorType.User, InitiatedById: { } initiatedById })
            _initiatorMetaverseObjectHeader = await jim.Metaverse.GetMetaverseObjectHeaderAsync(initiatedById);

        // Determine navigation context from query parameter
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _fromOperations = string.Equals(query["from"], "operations", StringComparison.OrdinalIgnoreCase);

        var activityName = _activity?.DisplayName ?? "Activity Detail";
        var activityHref = $"/activity/{_activityRunProfileExecutionItem.ActivityId}{(_fromOperations ? "?from=operations" : "")}";

        _breadcrumbs = _fromOperations
            ? new List<BreadcrumbItem>
            {
                new("Home", href: "/", icon: Icons.Material.Filled.Home),
                new("Operations", href: "/admin/operations?t=activity"),
                new(activityName, href: activityHref),
                new("Item Details", href: null, disabled: true)
            }
            : new List<BreadcrumbItem>
            {
                new("Home", href: "/", icon: Icons.Material.Filled.Home),
                new("Activity", href: "/activity"),
                new(activityName, href: activityHref),
                new("Item Details", href: null, disabled: true)
            };

        // Load associated Pending Export for:
        // - Export-related errors (ExportNotConfirmed, ExportConfirmationFailed)
        // - PendingExport items surfaced during sync (informational, no error)
        if (_activityRunProfileExecutionItem.ErrorType is ActivityRunProfileExecutionItemErrorType.ExportNotConfirmed
            or ActivityRunProfileExecutionItemErrorType.ExportConfirmationFailed
            && _activityRunProfileExecutionItem.ConnectedSystemObjectId.HasValue)
        {
            _pendingExport = await jim.ConnectedSystems.GetPendingExportForObjectAsync(
                _activityRunProfileExecutionItem.ConnectedSystemObjectId.Value);
        }
        else if (_activityRunProfileExecutionItem.ObjectChangeType == ObjectChangeType.PendingExport)
        {
            if (_activityRunProfileExecutionItem.ConnectedSystemObjectId.HasValue)
                _pendingExport = await jim.ConnectedSystems.GetPendingExportForObjectAsync(
                    _activityRunProfileExecutionItem.ConnectedSystemObjectId.Value);
            else if (_activityRunProfileExecutionItem.PendingExportId.HasValue)
                _pendingExport = await jim.ConnectedSystems.GetPendingExportAsync(
                    _activityRunProfileExecutionItem.PendingExportId.Value);
        }

        _matchCandidates = ActivityRunProfileExecutionItemMatchCandidate.AreRecordedFor(_activityRunProfileExecutionItem.ErrorType)
            ? await jim.Activities.GetMatchCandidatesAsync(Id)
            : [];
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Every render, not only the first: the page is reused across navigations between items, and each item's walk
        // is read once, after its panel is already on screen.
        if (_activityRunProfileExecutionItem is not { } item || _consequencesReadFor == Id || _consequencesLoading
            || !CausalityItemLoader.ShowsCausality(item))
            return;

        await ReadConsequencesAsync();
    }

    /// <summary>
    /// Reads what this item went on to cause, a reading taken now: consequences can still be happening.
    /// </summary>
    private async Task ReadConsequencesAsync()
    {
        var itemId = Id;
        _consequencesLoading = true;
        StateHasChanged();
        try
        {
            using var jim = JimFactory.Create();
            var consequences = await jim.Activities.GetCausalConsequencesAsync(itemId);
            // A navigation to another item while this one was being read must not show this one's consequences there.
            if (itemId == Id)
            {
                _consequences = consequences;
                _consequencesReadFor = itemId;
            }
        }
        finally
        {
            _consequencesLoading = false;
            StateHasChanged();
        }
    }

    private Task CheckConsequencesAgainAsync()
    {
        _consequences = null;
        _consequencesReadFor = null;
        return ReadConsequencesAsync();
    }

    private async Task<JIM.Models.Utility.RangeResultSet<CausalityAttributeRow>> LoadAttributeRowsAsync(
        CausalityAttributeRowSource source, JIM.Models.Utility.ChangeValueRowQuery query)
    {
        using var jim = JimFactory.Create();
        return await CausalityAttributeRowReader.ReadAsync(jim, source, query);
    }

    private async Task<JIM.Models.Utility.PagedResultSet<CausalConsequenceMember>?> LoadConsequenceMembersAsync(string cohortKey, int page, string? search)
    {
        using var jim = JimFactory.Create();
        return await jim.Activities.GetCausalConsequenceCohortMembersAsync(Id, cohortKey, page,
            JIM.Application.Servers.ActivityServer.CausalConsequenceMemberPageSize, search);
    }

    /// <summary>
    /// Returns true if the parent activity is a sync Run Profile, indicating that
    /// ObjectChangeType.Deleted means "deletion processed" rather than "deletion detected".
    /// </summary>
    private bool IsSyncContext()
    {
        return _activity?.ConnectedSystemRunType is ConnectedSystemRunType.FullSynchronisation
        or ConnectedSystemRunType.DeltaSynchronisation;
    }

    /// <summary>
    /// Whether the parent activity is an import Run Profile, the only kind that records unresolved references on the
    /// Connected System Object it imported.
    /// </summary>
    private bool IsImportContext()
    {
        return _activity?.ConnectedSystemRunType is ConnectedSystemRunType.FullImport
            or ConnectedSystemRunType.DeltaImport;
    }

    /// <summary>
    /// Whether this item belongs to a Metaverse Object Housekeeping Activity (#1020). Housekeeping
    /// Deleted items are Metaverse Object deletions, not import-detected CSO deletions, so the
    /// narrative copy differs from the Run Profile import/sync phrasing.
    /// </summary>
    private bool IsHousekeepingContext()
    {
        return _activity?.TargetType == ActivityTargetType.MetaverseObjectHousekeeping;
    }

    // The operation's own icon, error or not (#2066): an object that was added shows "+" even when a value on it
    // failed. The outcome is the heading's and the error section's to tell; conflating the two made "+" read as "!".
    private string GetStatusIcon() => Helpers.GetOperationIcon(
        _activityRunProfileExecutionItem?.ObjectChangeType ?? ObjectChangeType.NotSet);

    private string GetStatusTitle()
    {
        if (_activityRunProfileExecutionItem?.ErrorType != ActivityRunProfileExecutionItemErrorType.NotSet)
            return GetErrorPhaseTitle();

        var typeName = GetObjectTypeName();
        var mvoTypeName = GetMetaverseObjectTypeName();

        return _activityRunProfileExecutionItem?.ObjectChangeType switch
        {
            // Import operations
            ObjectChangeType.Added => $"{typeName} Added to Connector Space",
            ObjectChangeType.Updated => $"{typeName} Updated",
            ObjectChangeType.Deleted => IsHousekeepingContext()
                ? $"Metaverse {typeName} Deleted"
                : IsSyncContext() ? "Source Deletion Processed" : $"{typeName} Deletion Detected",
            // Sync operations
            ObjectChangeType.Projected => $"Projected {typeName} to the Metaverse",
            ObjectChangeType.Joined => $"Joined {typeName} to Metaverse {mvoTypeName}",
            ObjectChangeType.AttributeFlow => $"{typeName} Attributes Flowed to Metaverse {mvoTypeName}",
            ObjectChangeType.Disconnected => $"Disconnected {typeName} from Metaverse",
            // Export operations
            ObjectChangeType.Exported => $"{typeName} Exported",
            ObjectChangeType.Deprovisioned => $"{typeName} Deprovisioned",
            // Other
            ObjectChangeType.NoChange => "No Changes",
            ObjectChangeType.ExportScopeReview => $"{typeName} Export Review",
            _ => "Synchronisation Complete"
        };
    }

    /// <summary>
    /// Returns the CSO object type name with the first letter capitalised, or "Object" as a fallback.
    /// </summary>
    private string GetObjectTypeName()
    {
        var name = _activityRunProfileExecutionItem?.ConnectedSystemObject?.Type?.Name
                   ?? _activityRunProfileExecutionItem?.ObjectTypeSnapshot;

        if (string.IsNullOrEmpty(name))
            return "Object";

        return char.ToUpperInvariant(name[0]) + name[1..];
    }

    /// <summary>
    /// Returns the Metaverse Object Type name (e.g., "User", "Group"), or "Object" as a fallback.
    /// </summary>
    private string GetMetaverseObjectTypeName()
    {
        return _metaverseObjectType?.Name ?? "Object";
    }

    /// <summary>
    /// Returns an appropriate error title based on the error type (import vs sync vs export phase).
    /// The mapping itself lives in Helpers so that a test can prove every error type is covered.
    /// </summary>
    private string GetErrorPhaseTitle()
    {
        return Helpers.GetErrorPhaseTitle(_activityRunProfileExecutionItem?.ErrorType);
    }

    /// <summary>
    /// The Execution Summary's Connected System Object chip name: the display name, or
    /// the external id where it has none, never both. Null when the record carries neither yet (a provisioned
    /// object before its first export), in which case the call site shows the type alone.
    /// </summary>
    private string? GetCsoChipName() => ObjectDescription.ChipName(
        _activityRunProfileExecutionItem?.ConnectedSystemObject?.Name, _externalIdAttributeValue?.ToStringNoName());

    /// <summary>
    /// The chip's tooltip: the external id, where distinct from the name the chip shows, and the record's own
    /// Connected System, which the chip text leaves out.
    /// </summary>
    private string GetCsoChipTooltip() => ObjectDescription.ForConnectedSystemObjectChipTooltip(
        _activityRunProfileExecutionItem?.ConnectedSystemObject?.Type.Name,
        _activityRunProfileExecutionItem?.ConnectedSystemObject?.Name,
        _externalIdAttributeValue?.ToStringNoName(),
        _connectedSystemHeader?.Name);

    /// <summary>
    /// Whether the item's error means the object was rejected rather than imported. An unresolved reference never
    /// rejects one (#959): the object is added or updated and only its references wait, so where it has since gone, it
    /// was deleted, not rejected.
    /// </summary>
    private bool RecordsRejection() =>
        _activityRunProfileExecutionItem?.ErrorType is { } errorType
        and not ActivityRunProfileExecutionItemErrorType.NotSet
        and not ActivityRunProfileExecutionItemErrorType.UnresolvedReference;

    /// <summary>
    /// Returns the appropriate label for the object field based on context.
    /// </summary>
    private string GetObjectFieldLabel()
    {
        // If CSO exists, show "Connected System Object"
        if (_activityRunProfileExecutionItem?.ConnectedSystemObject != null)
            return "Connected System Object";

        // An export scope review item records a Metaverse Object, not a CSO
        if (_activityRunProfileExecutionItem?.MetaverseObjectId.HasValue == true)
            return "Metaverse Object";

        // Housekeeping deletion items describe the deleted Metaverse Object, not a CSO
        if (IsHousekeepingContext()
            && _activityRunProfileExecutionItem?.ObjectChangeType == ObjectChangeType.Deleted
            && string.IsNullOrEmpty(_activityRunProfileExecutionItem.ExternalIdSnapshot))
            return "Metaverse Object";

        // If no CSO but has external ID snapshot
        if (!string.IsNullOrEmpty(_activityRunProfileExecutionItem?.ExternalIdSnapshot))
        {
            // If there's an error (rejected), show "External ID (from source data)" for clarity
            if (RecordsRejection())
                return "External ID (from source data)";

            return "External ID";
        }

        // Fallback
        return "Connected System Object";
    }

    private string GetStatusDescription()
    {
        // The Connected System Object's external ID is rendered as a separate chip immediately
        // below this summary line, so we deliberately omit it from the prose to avoid duplication.
        if (_unresolvedReferenceTone == UnresolvedReferenceTone.Error)
            return GetUnresolvedReferenceStatusDescription();

        if (_activityRunProfileExecutionItem?.ErrorType != ActivityRunProfileExecutionItemErrorType.NotSet)
        {
            // An item recording a Metaverse Object and no Connected System Object (matching before provisioning, #2052)
            // is about the Metaverse Object.
            return _activityRunProfileExecutionItem is { ConnectedSystemObjectId: null, MetaverseObjectId: not null }
                ? "An error occurred while synchronising the Metaverse Object."
                : "An error occurred while synchronising the Connected System Object.";
        }

        var description = GetOperationStatusDescription();
        return _unresolvedReferenceTone == UnresolvedReferenceTone.Warning
            ? $"{description} {GetUnresolvedReferenceClause()} could not be linked to Connected System Objects."
            : description;
    }

    /// <summary>
    /// The summary line for an import whose unresolved references are the item's error (#959): what the import did to
    /// the object, then what it could not do.
    /// </summary>
    private string GetUnresolvedReferenceStatusDescription()
    {
        var typeName = _activityRunProfileExecutionItem?.ConnectedSystemObject?.Type?.Name
                       ?? _activityRunProfileExecutionItem?.ObjectTypeSnapshot
                       ?? "object";
        var imported = _activityRunProfileExecutionItem?.ObjectChangeType switch
        {
            ObjectChangeType.Added => "was added to the Connector Space",
            ObjectChangeType.Updated => "was updated",
            _ => "was imported"
        };

        return $"The {typeName} {imported}, but {GetUnresolvedReferenceClause().ToLowerInvariant()} could not be linked to Connected System Objects.";
    }

    /// <summary>"3 of its references", or "Some of its references" for an item recorded before the count existed.</summary>
    private string GetUnresolvedReferenceClause() =>
        _activityRunProfileExecutionItem?.UnresolvedReferenceCount is { } count
            ? $"{count:N0} of its references"
            : "Some of its references";

    private string GetOperationStatusDescription()
    {
        return _activityRunProfileExecutionItem?.ObjectChangeType switch
        {
            // Import operations
            ObjectChangeType.Added => "A new Connected System Object was imported and added to the connector space.",
            ObjectChangeType.Updated => "The Connected System Object was updated with new attribute values.",
            ObjectChangeType.Deleted => IsHousekeepingContext()
                ? "The Metaverse Object's deletion grace period expired and the housekeeping process deleted it from the metaverse."
                : IsSyncContext()
                    ? "The Connected System Object was removed from the connector space after the source system deletion was confirmed."
                    : "The Connected System Object was detected as deleted from the source system and marked for removal.",
            // Sync operations
            ObjectChangeType.Projected => "A new Metaverse Object was created via projection from the Connected System Object.",
            ObjectChangeType.Joined => "The Connected System Object was joined to an existing Metaverse Object.",
            ObjectChangeType.AttributeFlow => "Attributes were flowed between the Connected System Object and metaverse.",
            ObjectChangeType.Disconnected => "The Connected System Object was disconnected from the metaverse. Join and metaverse deletion rules were evaluated.",
            // Export operations
            ObjectChangeType.Exported => "The Connected System Object was exported to the target system.",
            ObjectChangeType.Deprovisioned => "The Connected System Object was deprovisioned from the target system.",
            // Other
            ObjectChangeType.NoChange => "The Connected System Object was already up to date.",
            ObjectChangeType.ExportScopeReview => "This Metaverse Object was reviewed against the export Synchronisation Rules during this synchronisation, because an export rule changed or the object was created or changed outside synchronisation. The outcomes below show what the review did: provisioned it, deprovisioned it, or delivered values changed outside synchronisation.",
            _ => "Synchronisation completed for the Connected System Object."
        };
    }

    /// <summary>
    /// Returns a descriptive display text for the operation, clarifying what object type was affected.
    /// </summary>
    private string GetOperationDisplayText()
    {
        return _activityRunProfileExecutionItem?.ObjectChangeType switch
        {
            // Import operations - affect Connected System Objects
            ObjectChangeType.Added => "Connected System Object Added",
            ObjectChangeType.Updated => "Connected System Object Updated",
            ObjectChangeType.Deleted => IsHousekeepingContext()
                ? "Metaverse Object Deleted"
                : IsSyncContext() ? "Deletion Processed" : "Deletion Detected",
            // Sync operations
            ObjectChangeType.Projected => "Projected",
            ObjectChangeType.Joined => "Joined",
            ObjectChangeType.AttributeFlow => "Attribute Flow",
            ObjectChangeType.Disconnected => "Disconnected",
            // Export operations
            ObjectChangeType.Exported => "Exported",
            ObjectChangeType.Deprovisioned => "Deprovisioned",
            // Other
            ObjectChangeType.NoChange => "No Change",
            ObjectChangeType.ExportScopeReview => "Export Review",
            _ => _activityRunProfileExecutionItem?.ObjectChangeType.ToString()?.SplitOnCapitalLetters() ?? "Unknown"
        };
    }

    /// <summary>
    /// Reads one window of this item's attribute changes from the database (#2498): a change to a large group carries
    /// one value change per member, so they are never loaded with the item. Each value change is its own row, as
    /// recorded; search and sort run in the database.
    /// </summary>
    private async Task<VirtualisedWindow<FlattenedChange>> LoadAttributeChangeWindowAsync(
        VirtualisedWindowRequest request, CancellationToken cancellationToken)
    {
        if (_activityRunProfileExecutionItem?.ConnectedSystemObjectChange is not { } change)
            return new VirtualisedWindow<FlattenedChange>([], request.IncludeTotalCount ? 0 : null);

        using var jim = JimFactory.Create();
        var result = await jim.ConnectedSystems.GetCsoChangeValueRowsAsync(new ChangeValueRowQuery
        {
            ChangeIds = [change.Id],
            Normalise = false,
            SearchText = string.IsNullOrWhiteSpace(request.SearchText) ? null : request.SearchText.Trim(),
            Sort = request.SortBy == "change" ? ChangeValueRowSort.Operation : ChangeValueRowSort.Attribute,
            SortDescending = request.SortDescending,
            Offset = request.StartIndex,
            Count = request.Count,
            IncludeTotalCount = request.IncludeTotalCount
        });

        var rows = result.Results
            .Select(row => new FlattenedChange(
                row.AttributeName,
                row.Value.ValueChangeType,
                row.Value.ReferenceValue == null ? row.Value.ToDisplayString() : null,
                row.Value.ReferenceValue))
            .ToList();
        return new VirtualisedWindow<FlattenedChange>(rows, result.TotalResults);
    }

    /// <summary>
    /// Returns the appropriate description for the attribute changes section based on operation type.
    /// Import operations (Added/Updated/Deleted) affect Connected System Objects.
    /// Sync and export operations affect Metaverse Objects.
    /// </summary>
    private string GetAttributeChangesDescription()
    {
        return _activityRunProfileExecutionItem?.ObjectChangeType switch
        {
            // Import operations - changes are to Connected System Object attributes
            ObjectChangeType.Added or ObjectChangeType.Updated or ObjectChangeType.Deleted =>
            "The following Connected System Object attributes were modified during this import operation.",

            // Sync and export operations - changes flow to/from Metaverse Object
            _ => "The following Metaverse Object attributes were modified during this synchronisation operation."
        };
    }
}
