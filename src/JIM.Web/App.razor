<CascadingValue Name="InitialDrawerOpen" Value="InitialDrawerOpen" IsFixed="true">
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
             <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <UserNotAuthorised />
                </NotAuthorized>
                <Authorizing>
                    <h1>Authorization in progress</h1>
                    <p>Only visible while authorization is in progress.</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(MainLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
</CascadingValue>

@code {
    /// <summary>
    /// Whether the navigation drawer was open when the user last left it, read by the host page from the cookie
    /// MainLayout mirrors it into; null when there is none yet. MainLayout starts from it and still reads the saved
    /// preference once interactive, which remains the truth.
    /// </summary>
    [Parameter]
    public bool? InitialDrawerOpen { get; set; }
}
