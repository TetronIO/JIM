<MudPaper Outlined="true" Class="pa-4 mt-6">
    <MudText Typo="Typo.h6">Password Policy</MudText>
    <MudText Typo="Typo.body1" Class="mt-2">
        The password rules this Connected System enforces, read when the schema was last retrieved. JIM uses them to
        pre-fill the initial password settings on a Synchronisation Rule, so the rules do not have to be retyped.
    </MudText>

    @* ─── Discovered policy ─── *@
    @if (Policy is { HasAnyDiscoveredConstraint: true })
    {
        @* Captured so the markup below dereferences a local the compiler and CodeQL both know is non-null; a
           pattern guard on a property does not establish that for either of them. *@
        var policy = Policy;

        <MudSimpleTable Class="mt-4" Dense="false" Hover="false" Striped="true" Elevation="0">
            <tbody>
                <tr>
                    <td style="width: 40%;">Minimum length</td>
                    <td>
                        @if (policy.MinimumLength is { } minimumLength)
                        {
                            @($"{minimumLength} characters")
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </td>
                </tr>
                <tr>
                    <td>Complexity</td>
                    <td>
                        @if (policy.ComplexityRequired == true)
                        {
                            <text>Required</text>
                            @if (policy.RequiredCharacterClassCount is { } requiredClasses && RecognisedClassCount(policy) > 0)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    @($"A password must use at least {requiredClasses} of the {RecognisedClassCount(policy)} character categories: {DescribeCharacterClasses(policy)}.")
                                </MudText>
                            }
                        }
                        else if (policy.ComplexityRequired == false)
                        {
                            <text>Not required</text>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </td>
                </tr>
                <tr>
                    <td>Password history</td>
                    <td>
                        @if (policy.PasswordHistoryLength is { } historyLength)
                        {
                            @($"{historyLength} remembered")
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </td>
                </tr>
                <tr>
                    <td>Maximum password age</td>
                    <td>@FormatAge(policy.MaximumPasswordAge, "Passwords do not expire")</td>
                </tr>
                <tr>
                    <td>Minimum password age</td>
                    <td>@FormatAge(policy.MinimumPasswordAge, "A password can be changed straight away")</td>
                </tr>
            </tbody>
        </MudSimpleTable>

        @* A discovered policy is a floor. Say so where it is read, not only in the documentation. *@
        @if (policy.FineGrainedPolicySignal != FineGrainedPolicySignal.Absent)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-4">
                @if (policy.FineGrainedPolicySignal == FineGrainedPolicySignal.Present)
                {
                    <MudText>
                        This domain has Fine-Grained Password Policies, which apply stricter rules to some accounts. The
                        policy above is the domain-wide one, so an account governed by a Fine-Grained Policy may reject a
                        password that satisfies it.
                    </MudText>
                }
                else
                {
                    <MudText>
                        JIM could not establish whether this domain has Fine-Grained Password Policies, which would apply
                        stricter rules to some accounts. Reading them needs privileges the account JIM connects as should
                        not normally hold, and a directory returns nothing rather than an error when it refuses. Treat the
                        policy above as a minimum.
                    </MudText>
                }
            </MudAlert>
        }

        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-4">
            <MudTooltip Arrow="true" Placement="Placement.Top" Text="@policy.Discovered.ToLocalTime().ToFriendlyDate()">
                @($"Read from the Connected System {policy.Discovered.ToLocalTime().ToRelativeTime()}. Refresh the schema to read it again.")
            </MudTooltip>
        </MudText>
    }
    else
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
            <MudText>
                JIM has not read a password policy from this Connected System. Only Active Directory publishes one that a
                client can read; on any other directory the initial password settings have to be configured by hand on
                the Synchronisation Rule. Retrieve the schema to read the policy, if there is one.
            </MudText>
        </MudAlert>
    }

    @* ─── Password channel check ─── *@
    <MudDivider Class="mt-6" />
    <MudText Typo="Typo.h6" Class="mt-6">Password Channel</MudText>
    <MudText Typo="Typo.body1" Class="mt-2">
        Checks whether JIM would be able to set a password on this Connected System. Nothing is written and no password
        is set: there is no way to prove a password set works without performing one, so this establishes everything
        around it instead, which is where most failures occur.
    </MudText>

    @* Gated rather than validated on click: a Connected System whose connection settings are absent or invalid
       cannot be connected to, so there is nothing to check. The reason is stated beside the button rather than in a
       tooltip, because a disabled control fires no pointer events and so can never show one. *@
    @if (!CanRunPreflight)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
            <MudText>
                Complete this Connected System's connection settings first, on the Settings tab. JIM needs them to
                connect before it can check anything.
            </MudText>
        </MudAlert>
    }

    <MudButton
        Color="Color.Primary"
        Variant="Variant.Filled"
        OnClick="RunPreflightAsync"
        Class="mt-4"
        DropShadow="false"
        Disabled="@(_preflightRunning || !CanRunPreflight)">
        @if (_preflightRunning)
        {
            <MudProgressCircular Class="ms-n1" Indeterminate="true" />
            <span class="ms-2">Checking</span>
        }
        else
        {
            <text>Check Password Channel</text>
        }
    </MudButton>

    @if (_preflight != null)
    {
        @* Captured for the same reason as the policy above: markup should dereference a local, not a field the
           guard's null-state does not reliably carry into. *@
        var preflight = _preflight;

        <MudAlert Severity="@OutcomeSeverity(preflight.Outcome)" Variant="Variant.Outlined" Class="mt-4">
            <MudText><strong>@OutcomeSummary(preflight)</strong></MudText>
        </MudAlert>

        <MudList T="string" Class="mt-2">
            @foreach (var check in preflight.Checks)
            {
                <MudListItem T="string" Icon="@StateIcon(check.State)" IconColor="@StateColour(check.State)">
                    <MudText Typo="Typo.body1"><strong>@CheckName(check.Check)</strong></MudText>
                    <MudText Typo="Typo.body1">@check.Message</MudText>
                    @foreach (var detail in check.Details)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@detail</MudText>
                    }
                </MudListItem>
            }
        </MudList>

        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
            @($"Checked {preflight.Ran.ToLocalTime().ToRelativeTime()}. This reflects the Connected System at that moment only, and is not stored.")
        </MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    private ConnectedSystemPasswordPolicy? Policy => ConnectedSystem.PasswordPolicy;

    private bool _preflightRunning;
    private PasswordPreflightResult? _preflight;

    /// <summary>
    /// Whether there is anything to check. A preflight has to connect, so a Connected System with no settings, or
    /// with settings that do not validate, cannot be checked at all.
    /// </summary>
    private bool CanRunPreflight => ConnectedSystem.SettingValues.Count > 0 && ConnectedSystem.SettingValuesValid;

    private static int RecognisedClassCount(ConnectedSystemPasswordPolicy policy) =>
        Enum.GetValues<PasswordCharacterClasses>()
            .Count(c => c != PasswordCharacterClasses.None && policy.RecognisedCharacterClasses.HasFlag(c));

    private static string DescribeCharacterClasses(ConnectedSystemPasswordPolicy policy)
    {
        var names = new List<string>();
        if (policy.RecognisedCharacterClasses.HasFlag(PasswordCharacterClasses.Uppercase))
            names.Add("uppercase");
        if (policy.RecognisedCharacterClasses.HasFlag(PasswordCharacterClasses.Lowercase))
            names.Add("lowercase");
        if (policy.RecognisedCharacterClasses.HasFlag(PasswordCharacterClasses.Digit))
            names.Add("digits");
        if (policy.RecognisedCharacterClasses.HasFlag(PasswordCharacterClasses.Symbol))
            names.Add("symbols");
        if (policy.RecognisedCharacterClasses.HasFlag(PasswordCharacterClasses.OtherUnicodeLetter))
            names.Add("letters without case");

        return string.Join(", ", names);
    }

    /// <summary>
    /// Renders a duration in whole days where it divides cleanly, which every real policy value does. The
    /// no-limit case gets its own wording rather than a hyphen, because "no maximum age" and "JIM did not read
    /// one" mean different things to an administrator.
    /// </summary>
    private static string FormatAge(TimeSpan? age, string noLimitText)
    {
        if (age is not { } value)
            return noLimitText;

        if (value.TotalDays >= 1 && value.TotalDays % 1 == 0)
            return value.TotalDays == 1 ? "1 day" : $"{value.TotalDays:0} days";

        return value.TotalHours >= 1 ? $"{value.TotalHours:0.#} hours" : $"{value.TotalMinutes:0.#} minutes";
    }

    private async Task RunPreflightAsync()
    {
        _preflightRunning = true;
        _preflight = null;

        try
        {
            using var jim = JimFactory.Create();
            _preflight = await jim.ConnectedSystems.RunPasswordPreflightAsync(ConnectedSystem, CancellationToken.None);
        }
        catch (NotSupportedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (ArgumentException ex)
        {
            // Belt and braces behind the button gating above. A diagnostic that takes the whole page down when the
            // Connected System is half-configured is worse than no diagnostic, and this is precisely the state an
            // administrator is in when they reach for one.
            Log.Warning(ex, "RunPreflightAsync: Connected System {ConnectedSystemId} is not configured enough to check.", ConnectedSystem.Id);
            Snackbar.Add("This Connected System is not configured enough to check yet. Complete its settings first.", Severity.Warning);
        }
        finally
        {
            _preflightRunning = false;
        }
    }

    private static Severity OutcomeSeverity(PasswordPreflightOutcome outcome) => outcome switch
    {
        PasswordPreflightOutcome.Ready => Severity.Success,
        PasswordPreflightOutcome.ReadyWithWarnings => Severity.Warning,
        PasswordPreflightOutcome.Inconclusive => Severity.Info,
        _ => Severity.Error
    };

    private static string OutcomeSummary(PasswordPreflightResult result)
    {
        var target = string.IsNullOrEmpty(result.TargetDescription) ? "this Connected System" : result.TargetDescription;
        return result.Outcome switch
        {
            PasswordPreflightOutcome.Ready => $"Everything JIM can check about setting passwords on {target} looks right.",
            PasswordPreflightOutcome.ReadyWithWarnings => $"JIM can set passwords on {target}, but something below should be a deliberate choice.",
            PasswordPreflightOutcome.Inconclusive => $"JIM could not establish everything it needs to about {target}. Setting a password may still work.",
            _ => $"Setting passwords on {target} will not work until the problems below are addressed."
        };
    }

    private static string StateIcon(PasswordPreflightState state) => state switch
    {
        PasswordPreflightState.Passed => Icons.Material.Filled.CheckCircle,
        PasswordPreflightState.Warning => Icons.Material.Filled.Warning,
        PasswordPreflightState.Failed => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.Help
    };

    private static Color StateColour(PasswordPreflightState state) => state switch
    {
        PasswordPreflightState.Passed => Color.Success,
        PasswordPreflightState.Warning => Color.Warning,
        PasswordPreflightState.Failed => Color.Error,
        _ => Color.Info
    };

    private static string CheckName(PasswordPreflightCheck check) => check switch
    {
        PasswordPreflightCheck.Connection => "Connection",
        PasswordPreflightCheck.Encryption => "Encryption",
        PasswordPreflightCheck.PasswordMechanism => "Password mechanism",
        PasswordPreflightCheck.ResetRights => "Password reset rights",
        _ => "Password policy"
    };
}
