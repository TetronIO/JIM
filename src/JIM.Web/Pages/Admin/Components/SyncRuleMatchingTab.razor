<MudPaper Class="pa-4" Outlined="true">
    <div class="d-flex align-center">
        <MudText Typo="Typo.h6">Object Matching Rules</MudText>
        <TermHint Term="Term.ObjectMatchingRule" />
        <TermHint Term="Term.Join" />
    </div>
    @if (SyncRule.ConnectedSystem?.ObjectMatchingRuleMode == ObjectMatchingRuleMode.SyncRule)
    {
        <div class="d-flex justify-end">
            <MudTooltip Text="Matching rules are specific to this Synchronisation Rule." Arrow="true" Placement="Placement.Top">
                <MudChip T="string" Variant="Variant.Text" Text="Advanced Mode" Color="Color.Info" />
            </MudTooltip>
        </div>
    }

    @if (SyncRule.ConnectedSystem?.ObjectMatchingRuleMode == ObjectMatchingRuleMode.ConnectedSystem)
    {
        <MudAlert Severity="Severity.Info" Class="mt-3" Icon="@Icons.Material.Outlined.Info">
            <MudText>
                This Connected System uses <strong>Simple Mode</strong> for object matching. In Simple Mode, matching
                rules are defined once on the Connected System (per object type) and shared by every Synchronisation
                Rule that targets this system, so you do not have to repeat the same matching logic on each rule. As a
                result, this rule cannot define its own matching rules here.
            </MudText>
            <MudText Class="mt-2">
                Switch the Connected System to <strong>Advanced Mode</strong> if you need matching logic that is specific
                to an individual Synchronisation Rule.
            </MudText>
            <MudLink Href="@($"/admin/connected-systems/{SyncRule.ConnectedSystemId}?t=matching")"
                     Target="_blank" rel="noopener" Underline="Underline.Always" Class="d-inline-flex align-center mt-2">
                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Class="me-1" Style="vertical-align: middle;" />Configure Matching Rules
            </MudLink>
        </MudAlert>
    }
    else
    {
        @* Advanced Mode - matching rules are managed per Synchronisation Rule *@
        @if (SyncRule.Direction == SyncRuleDirection.Import)
        {
            <MudText Class="mt-3">
                Define rules to match Connected System Objects to Metaverse Objects. Use immutable attributes (e.g., employeeID, objectGUID).
                Multiple rules can be ordered; the first match wins. Objects are Joined when matched, Disconnected when not.
            </MudText>
        }
        else if (SyncRule.Direction == SyncRuleDirection.Export)
        {
            <MudText Class="mt-3">
                Define rules to match Metaverse Objects to Connected System Objects. Use immutable attributes (e.g., employeeID, objectGUID).
                Multiple rules can be ordered; the first match wins.
            </MudText>
        }

        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled"
            OnClick="HandleOpenAddMatchingRuleMappingDialog" Class="mt-5" DropShadow="false"
            Disabled="@(SyncRule.MetaverseObjectType == null || SyncRule.ConnectedSystemObjectType == null)">Add Matching
            Rule</MudButton>

        @foreach (var objectMatchingRule in SyncRule.ObjectMatchingRules.OrderBy(omr => omr.Order))
        {
            var source = objectMatchingRule.Sources.FirstOrDefault();
            <MudPaper Class="pa-4 mt-5" Outlined="true" @key="objectMatchingRule">
                <MudGrid Spacing="0">
                    <MudItem xs="6">
                        <MudText Typo="Typo.overline"><span class="mud-text-secondary">MATCH ON:</span>
                            @(string.IsNullOrWhiteSpace(source?.Expression) ? "ATTRIBUTE" : "EXPRESSION")</MudText>
                    </MudItem>
                    <MudItem xs="6" Class="d-flex align-center justify-end">
                        <MudText Typo="Typo.overline">POSITION: @(objectMatchingRule.Order + 1)</MudText>
                    </MudItem>
                    <MudItem xs="12" Class="d-flex align-center flex-wrap gap-2">
                        @* What the rule compares (#2052): a Connected System attribute's values, or an expression's
                           result, with the Metaverse attribute it is compared against. *@
                        @if (!string.IsNullOrWhiteSpace(source?.Expression))
                        {
                            <AttributeChip Kind="AttributeChipKind.Expression" Expression="@source.Expression" Class="ma-0" />
                        }
                        else if (source?.ConnectedSystemAttribute is { } sourceAttribute)
                        {
                            <AttributeChip Kind="AttributeChipKind.ConnectedSystem" Name="@sourceAttribute.Name" Class="ma-0" />
                        }
                        else
                        {
                            <EmptyValue />
                        }
                        <MudText Typo="Typo.body1" Class="mud-text-secondary">equals</MudText>
                        @if (objectMatchingRule.TargetMetaverseAttribute is { } targetAttribute)
                        {
                            <AttributeChip Kind="AttributeChipKind.Metaverse" Name="@targetAttribute.Name" Class="ma-0" />
                        }
                        else
                        {
                            <EmptyValue />
                        }
                        <MudSwitch T="bool" Value="@objectMatchingRule.CaseSensitive"
                            ValueChanged="@(value => HandleToggleMatchingRuleCaseSensitive(objectMatchingRule, value))"
                            Label="Case Sensitive" Color="Color.Primary" Class="ms-4" />
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" Variant="Variant.Filled" Color="Color.Default" Size="Size.Small"
                            Class="me-3" OnClick="@(() => HandleObjectMatchingRuleChangeOrder(objectMatchingRule, "up"))"
                            Disabled="@DisableObjectMatchingMappingRuleOrderButton(objectMatchingRule, "up")" />
                        <MudIconButton Icon="@Icons.Material.Outlined.ArrowDownward" Variant="Variant.Filled" Color="Color.Default" Size="Size.Small"
                            Class="me-3" OnClick="@(() => HandleObjectMatchingRuleChangeOrder(objectMatchingRule, "down"))"
                            Disabled="@DisableObjectMatchingMappingRuleOrderButton(objectMatchingRule, "down")" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small"
                            aria-label="delete" OnClick="@(() => HandleObjectMatchingRuleDeleteClickAsync(objectMatchingRule))">
                        </MudIconButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    }
</MudPaper>

<MudDialog @bind-Visible="_addMatchingRuleDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Map" Class="mr-3" /> Add Matching Rule
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (SyncRule.ConnectedSystemObjectType != null)
        {
            <ObjectMatchingRuleEditor Draft="_draft"
                                      ObjectType="SyncRule.ConnectedSystemObjectType"
                                      MetaverseAttributes="@(SyncRule.MetaverseObjectType?.Attributes ?? [])"
                                      LookupMetaverseObjectType="SyncRule.MetaverseObjectType"
                                      ConnectedSystemName="@SyncRule.ConnectedSystem?.Name"
                                      OnChanged="StateHasChanged" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton DropShadow="false"
            OnClick="@(() => _addMatchingRuleDialogVisible = false)" Class="me-2">Cancel</MudButton>
        <MudButton Disabled="@(!_draft.CanAdd(requireMetaverseObjectType: false))" DropShadow="false" Variant="Variant.Filled"
            Color="Color.Primary" OnClick="HandleAddMappingButtonClick">Add Matching Rule</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public SyncRule SyncRule { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool _addMatchingRuleDialogVisible;
    // Medium, as the Attribute Flow dialog is: the editor lays out source, "equals" and target side by side, and at
    // the default Small width an expression wraps mid-name.
    private readonly DialogOptions _dialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Medium };
    // The rule being composed in the Add Matching Rule dialog (#2052). Added to the Synchronisation Rule, which saves it
    // with everything else, so the Synchronisation Rule save is what refuses an unworkable one; the editor says why
    // first, and the button stays off until it is workable.
    private readonly ObjectMatchingRuleDraft _draft = new();

    private void HandleOpenAddMatchingRuleMappingDialog()
    {
        _draft.Reset();
        _addMatchingRuleDialogVisible = true;
    }

    private async Task HandleAddMappingButtonClick()
    {
        if (!_draft.CanAdd(requireMetaverseObjectType: false))
            return;

        var order = SyncRule.ObjectMatchingRules.Count == 0 ? 0 : SyncRule.ObjectMatchingRules.Max(q => q.Order) + 1;
        SyncRule.ObjectMatchingRules.Add(_draft.ToRule(order));

        _addMatchingRuleDialogVisible = false;
        _draft.Reset();
        await OnChanged.InvokeAsync();
    }

    private async Task HandleObjectMatchingRuleDeleteClickAsync(ObjectMatchingRule objectMatchingRule)
    {
        var confirmationResult = await DialogService.ShowMessageBoxAsync("Warning", "Are you sure you want to remove this Matching Rule?", yesText: "Remove!", cancelText: "Cancel");
        if (confirmationResult.HasValue && confirmationResult.Value)
        {
            SyncRule.ObjectMatchingRules.Remove(objectMatchingRule);

            // re-order the items
            var orderedItems = SyncRule.ObjectMatchingRules.OrderBy(q => q.Order).ToList();
            for (var i = 0; i < orderedItems.Count; i++)
                orderedItems[i].Order = i;

            await OnChanged.InvokeAsync();
        }
    }

    private async Task HandleToggleMatchingRuleCaseSensitive(ObjectMatchingRule rule, bool caseSensitive)
    {
        // Update the local value - changes will be saved when user saves the Synchronisation Rule
        rule.CaseSensitive = caseSensitive;
        Snackbar.Add($"Matching rule is now {(caseSensitive ? "case-sensitive" : "case-insensitive")}. Remember to save the Synchronisation Rule.", Severity.Info);
        await OnChanged.InvokeAsync();
    }

    private async Task HandleObjectMatchingRuleChangeOrder(ObjectMatchingRule objectMatchingRule, string direction)
    {
        // invalid scenarios
        if (SyncRule.ObjectMatchingRules.Count == 1)
            return;

        if (direction == "up")
        {
            // cannot promote the first item
            if (objectMatchingRule.Order == 0)
                return;

            var precedingItem = SyncRule.ObjectMatchingRules.Single(q => q.Order == (objectMatchingRule.Order - 1));
            precedingItem.Order++;
            objectMatchingRule.Order--;
        }
        else
        {
            // cannot demote the last item
            if (objectMatchingRule.Order == (SyncRule.ObjectMatchingRules.Count - 1))
                return;

            var followingItem = SyncRule.ObjectMatchingRules.Single(q => q.Order == (objectMatchingRule.Order + 1));
            followingItem.Order--;
            objectMatchingRule.Order++;
        }

        await OnChanged.InvokeAsync();
    }

    private bool DisableObjectMatchingMappingRuleOrderButton(ObjectMatchingRule objectMatchingRule, string direction)
    {
        switch (direction)
        {
            case "up" when objectMatchingRule.Order == 0:
            case "down" when objectMatchingRule.Order == SyncRule.ObjectMatchingRules.Max(q => q.Order):
                return true;
            default:
                return false;
        }
    }
}
