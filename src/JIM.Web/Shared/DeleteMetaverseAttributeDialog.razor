@using JIM.Models.Core
@using JIM.Models.Core.DTOs
@using JIM.Utilities
@using JIM.Web.Models
@using JIM.Web.Services
@inject IJimApplicationFactory JimFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Thin surface over the shared ConsequenceConfirmationDialog: this component owns evaluating the *@
@* deletion impact and performing the delete; the shared dialog owns presenting it and the consent *@
@* rules. See engineering/plans/doing/CONFIGURATION_CHANGE_PREVIEW.md (Phase 2). *@

<ConsequenceConfirmationDialog Loading="@(_impact == null)"
                               LoadingText="Evaluating deletion impact..."
                               Blockers="@BuildBlockers()"
                               SafeMessage="No object holds a value for this attribute. Safe to delete; no object data will be lost."
                               Consequences="@BuildConsequences()"
                               ConfirmationPhrase="@BuildConfirmationPhrase()"
                               ConfirmButtonText="@BuildConfirmButtonText()"
                               BusyText="Deleting..."
                               OnConfirmAsync="DeleteAsync" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// The attribute to delete.
    /// </summary>
    [Parameter]
    public MetaverseAttribute Attribute { get; set; } = null!;

    private AttributeDeletionImpact? _impact;

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _impact = await jim.Metaverse.EvaluateAttributeDeletionAsync(Attribute);
    }

    private IReadOnlyList<ConsequenceBlocker> BuildBlockers()
    {
        if (_impact == null)
            return [];

        var blockers = new List<ConsequenceBlocker>();

        if (_impact.BuiltIn)
        {
            blockers.Add(new ConsequenceBlocker
            {
                Headline = "This is a built-in attribute",
                Body = "Built-in attributes are part of JIM's own schema and cannot be deleted."
            });
        }

        if (_impact.BlockedByValues)
        {
            blockers.Add(new ConsequenceBlocker
            {
                Headline = $"{_impact.TotalObjectsWithValues:N0} object(s) have a value",
                Items = _impact.ObjectTypeValueCounts.Select(count => new ConsequenceItem
                {
                    Text = $"{count.MetaverseObjectTypeName}: {count.ObjectCount:N0} with a value",
                    Icon = Icons.Material.Filled.Person,
                    Href = Utilities.GetMetaverseObjectHasAttributeSearchHref(count.MetaverseObjectTypePluralName, _impact.AttributeName)
                }).ToList(),
                Body = "Clear these values first (stop the source flow and let it deprovision, or bulk-clear), then delete."
            });
        }

        return blockers;
    }

    private ConsequenceGroup? BuildConsequences()
    {
        if (_impact == null || _impact.References.Count == 0)
            return null;

        return new ConsequenceGroup
        {
            Headline = $"These {_impact.References.Count} reference(s) will also be removed",
            Items = _impact.References.Select(reference => new ConsequenceItem
            {
                Text = reference.Description,
                Icon = Icons.Material.Filled.Link
            }).ToList()
        };
    }

    // References present require the typed confirmation; unreferenced deletes do not.
    private string? BuildConfirmationPhrase() =>
        _impact is { References.Count: > 0 } ? _impact.AttributeName : null;

    private string BuildConfirmButtonText()
    {
        if (_impact == null)
            return "Delete";

        return _impact.References.Count > 0
            ? $"Delete + {_impact.References.Count} reference(s)"
            : "Delete";
    }

    private async Task<bool> DeleteAsync()
    {
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Delete");
        if (cancelled)
            return false;

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var impact = await jim.Metaverse.DeleteMetaverseAttributeWithCascadeAsync(Attribute, user, changeReason);
            if (!impact.Deleted)
            {
                Snackbar.Add("The attribute could not be deleted; it may now hold stored values. Refresh and try again.", Severity.Warning);
                return false;
            }

            Snackbar.Add($"Deleted attribute \"{impact.AttributeName}\".", Severity.Success);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add($"Failed to delete attribute: {ex.Message}", Severity.Error);
            return false;
        }

        return true;
    }

    /// <summary>
    /// Opens the delete dialog for a Metaverse Attribute. Returns true when the attribute was deleted.
    /// </summary>
    public static async Task<bool> ShowAsync(IDialogService dialogService, MetaverseAttribute attribute)
    {
        var parameters = new DialogParameters<DeleteMetaverseAttributeDialog>
        {
            { x => x.Attribute, attribute }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await dialogService.ShowAsync<DeleteMetaverseAttributeDialog>($"Delete \"{attribute.Name}\" Attribute", parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: true };
    }
}
