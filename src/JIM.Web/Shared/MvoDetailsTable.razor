@if (MetaverseObject != null)
{
    @* One row per attribute, through the same table as every other object's attributes, so the search, the sorts
       and the way a multi-valued attribute reads are the same here as on a Connected System Object. *@
    <AttributeTable TItem="MvoAttributeTableGroup"
                    Items="@_groups"
                    Matches="MatchesSearch"
                    Sort="SortGroups"
                    DefaultSortBy="attribute"
                    UrlParameterPrefix="attr-"
                    RowClassFunc="@((group, _) => group.TotalCount > 1 ? "jim-attr-row-mva" : string.Empty)">
        <HeaderContent>
            <MudTh Class="jim-attr-header-name"><VirtualisedSortHeader Title="Attribute" Name="attribute" /></MudTh>
            <MudTh Class="jim-attr-header-value"><VirtualisedSortHeader Title="Value" Name="value" /></MudTh>
            <MudTh Class="jim-attr-header-type"><VirtualisedSortHeader Title="Type" Name="type" /></MudTh>
            <MudTh Class="jim-attr-header-plurality"><VirtualisedSortHeader Title="Plurality" Name="plurality" /></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Class="jim-attr-name">
                <MudText Typo="Typo.body1" Class="mud-text-secondary">@context.AttributeName</MudText>
            </MudTd>
            <MudTd Class="jim-attr-value">
                @{ var group = context; }
                <AttributeValuesCell TValue="MetaverseObjectAttributeValue" Values="@group.Values" TotalCount="@group.TotalCount">
                    <ValueTemplate Context="attributeValue">
                        @RenderValue(attributeValue)
                    </ValueTemplate>
                    <OverflowContent>
                        <MvoMvaTable @key="group.AttributeName"
                                     ValueCount="@group.TotalCount"
                                     AttributeName="@group.AttributeName"
                                     MetaverseObjectId="@_metaverseObjectId"
                                     IsReferenceAttribute="@group.IsReference" />
                    </OverflowContent>
                </AttributeValuesCell>
                @* Unique Value Generation (#242, Phase 3, Work Package D2): a generated value only ever targets a
                   single-valued attribute, so the provenance chip only ever needs to consider a lone value
                   (approved mockup screen 04). *@
                @if (group.TotalCount == 1 && _generatedAssignmentsByAttribute.TryGetValue(group.AttributeName, out var assignment))
                {
                    <GeneratedValueProvenanceChip Assignment="assignment" Class="ml-2" />
                }
            </MudTd>
            <MudTd Class="jim-attr-type">
                <MudText Typo="Typo.body1" Class="mud-text-secondary">@context.Values[0].Attribute.Type</MudText>
            </MudTd>
            <MudTd Class="jim-attr-plurality">
                <MudText Typo="Typo.body1" Class="mud-text-secondary">@(context.IsMultiValued ? "Multi" : "Single")</MudText>
            </MudTd>
        </RowTemplate>
        <EmptyContent>
            <TableEmptyState Icon="@Icons.Material.Filled.ListAlt"
                             PrimaryText="This object has no attribute values" />
        </EmptyContent>
    </AttributeTable>
}

@* ─── Render Fragments ─── *@

@{
    RenderFragment RenderValue(MetaverseObjectAttributeValue attributeValue) => __builder =>
    {
        if (attributeValue.Attribute.Type == AttributeDataType.Text)
        {
            if (attributeValue.Attribute.Name == Constants.BuiltInAttributes.Email && !string.IsNullOrEmpty(attributeValue.StringValue))
            {
                <MudLink Href="@($"mailto:{attributeValue.StringValue}")" Class="jim-text-code">@attributeValue.StringValue</MudLink>
            }
            else
            {
                <TextValueDisplay Value="@attributeValue.StringValue" Class="jim-text-code" />
            }
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Number)
        {
            <span class="jim-text-code">@attributeValue.IntValue</span>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.LongNumber)
        {
            <span class="jim-text-code">@attributeValue.LongValue</span>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Decimal)
        {
            <span class="jim-text-code">@attributeValue.DecimalValue?.ToString(CultureInfo.InvariantCulture)</span>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.DateTime && attributeValue.DateTimeValue.HasValue)
        {
            <MudTooltip Text="@attributeValue.DateTimeValue.Value.ToString("O")">
                <ChildContent>
                    @attributeValue.DateTimeValue.Value.ToFriendlyDate()
                </ChildContent>
            </MudTooltip>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Guid)
        {
            <span class="jim-text-code">@attributeValue.GuidValue?.ToString()</span>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Boolean && attributeValue.BoolValue.HasValue)
        {
            @* Local capture: CodeQL does not read the HasValue guard above as establishing null-state
               for a dereference in markup (JIM.Web/CLAUDE.md, "Nullable dereference in Razor"). *@
            var boolValue = attributeValue.BoolValue.Value;
            <BooleanValue Value="@boolValue" />
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Binary && attributeValue.ByteValue != null)
        {
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@attributeValue.ByteValue.Length bytes</MudChip>
        }
        else if (attributeValue.Attribute.Type == AttributeDataType.Reference && attributeValue.ReferenceValue != null)
        {
            <MudChip T="string" Color="Color.Default">@attributeValue.ReferenceValue.Type?.Name</MudChip>
            <MudLink Href="@Utilities.GetMetaverseObjectHref(attributeValue.ReferenceValue)">
                @(attributeValue.ReferenceValue.NameOrId ?? attributeValue.ReferenceValue.Id.ToString())
            </MudLink>
        }
    };
}

@code {
    /// <summary>
    /// The Metaverse Object whose attributes to display in table format.
    /// </summary>
    [Parameter]
    public MetaverseObject MetaverseObject { get; set; } = null!;

    /// <summary>
    /// Per-attribute total value counts from the capped load.
    /// Used to show accurate totals when MVA values are capped.
    /// </summary>
    [Parameter]
    public Dictionary<string, int> AttributeValueTotalCounts { get; set; } = new();

    /// <summary>
    /// Generated-value assignments for the loaded Metaverse Object (Unique Value Generation, #242, Phase 3,
    /// Work Package D2), keyed by attribute name (see <see cref="GeneratedValuePreviewHelpers.IndexAssignmentsByAttribute"/>).
    /// Loaded once per Metaverse Object, not per row (<see cref="OnParametersSetAsync"/> guards on the id).
    /// </summary>
    private Dictionary<string, GeneratedValueAssignmentHeader> _generatedAssignmentsByAttribute = new();
    private Guid? _loadedGeneratedAssignmentsForMvoId;

    // Grouped once per parameter set rather than per search or sort, which only filter and order this list.
    private List<MvoAttributeTableGroup> _groups = new();
    private Guid _metaverseObjectId;

    protected override async Task OnParametersSetAsync()
    {
        if (MetaverseObject == null)
            return;

        _groups = GetGroupedAttributes();
        _metaverseObjectId = MetaverseObject.Id;

        if (MetaverseObject.Id == _loadedGeneratedAssignmentsForMvoId)
            return;

        using var jim = JimFactory.Create();
        var assignments = await jim.UniqueValues.GetAssignmentsForMetaverseObjectAsync(MetaverseObject.Id);
        _generatedAssignmentsByAttribute = GeneratedValuePreviewHelpers.IndexAssignmentsByAttribute(assignments);
        _loadedGeneratedAssignmentsForMvoId = MetaverseObject.Id;
    }

    /// <summary>
    /// One row of the table: an attribute and the values of it the object holds. Public so the component tests can
    /// read the table's rows by name.
    /// </summary>
    public record MvoAttributeTableGroup(
        string AttributeName,
        List<MetaverseObjectAttributeValue> Values,
        bool IsMultiValued,
        int TotalCount,
        bool IsReference);

    private List<MvoAttributeTableGroup> GetGroupedAttributes()
    {
        if (MetaverseObject?.AttributeValues == null)
            return new List<MvoAttributeTableGroup>();

        return MetaverseObject.AttributeValues
            .GroupBy(v => v.Attribute.Name)
            .Select(g =>
            {
                var values = g.ToList();
                var totalCount = AttributeValueTotalCounts.GetValueOrDefault(g.Key, values.Count);
                var isReference = values.Any(v => v.ReferenceValue != null);
                return new MvoAttributeTableGroup(
                    g.Key,
                    values,
                    g.First().Attribute.AttributePlurality == AttributePlurality.MultiValued,
                    totalCount,
                    isReference);
            })
            .ToList();
    }

    /// <summary>
    /// Whether an attribute matches the table's search: its name, or any of its loaded values.
    /// </summary>
    private static bool MatchesSearch(MvoAttributeTableGroup group, string search) =>
        group.AttributeName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
        group.Values.Any(v => GetSearchText(v).Contains(search, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Orders the attributes by one of the four sorts the table's headers offer.
    /// </summary>
    private static IEnumerable<MvoAttributeTableGroup> SortGroups(IEnumerable<MvoAttributeTableGroup> groups, string sortBy, bool descending)
    {
        IOrderedEnumerable<MvoAttributeTableGroup> Order<TKey>(Func<MvoAttributeTableGroup, TKey> key, IComparer<TKey>? comparer = null) =>
            descending ? groups.OrderByDescending(key, comparer) : groups.OrderBy(key, comparer);

        return sortBy switch
        {
            "value" => Order(g => GetSearchText(g.Values[0]), StringComparer.OrdinalIgnoreCase),
            "type" => Order(g => g.Values[0].Attribute.Type),
            "plurality" => Order(g => g.IsMultiValued),
            _ => Order(g => g.AttributeName, StringComparer.OrdinalIgnoreCase)
        };
    }

    /// <summary>
    /// A value as text, for searching and sorting: a reference by the name it is shown under, everything else as
    /// the value itself.
    /// </summary>
    private static string GetSearchText(MetaverseObjectAttributeValue value)
    {
        if (value.ReferenceValue != null)
            return value.ReferenceValue.NameOrId ?? value.ReferenceValue.Id.ToString();
        if (!string.IsNullOrEmpty(value.StringValue))
            return value.StringValue;
        if (value.DateTimeValue.HasValue)
            return value.DateTimeValue.Value.ToFriendlyDate();
        if (value.IntValue.HasValue)
            return value.IntValue.Value.ToString(CultureInfo.InvariantCulture);
        if (value.LongValue.HasValue)
            return value.LongValue.Value.ToString(CultureInfo.InvariantCulture);
        if (value.DecimalValue.HasValue)
            return value.DecimalValue.Value.ToString(CultureInfo.InvariantCulture);
        if (value.GuidValue.HasValue)
            return value.GuidValue.Value.ToString();
        if (value.BoolValue.HasValue)
            return value.BoolValue.Value ? "True" : "False";
        return string.Empty;
    }
}
