@using System.Globalization
@using JIM.Application.Expressions
@using JIM.Application.Interfaces
@using JIM.Models.Core
@using JIM.Models.Expressions
@using JIM.Models.Interfaces
@using JIM.Models.Logic
@using JIM.Web.Models
@inject IExpressionEvaluator ExpressionEvaluator
@inject IJimApplicationFactory JimFactory
@inject IDialogService DialogService

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

@* Tests an Attribute Flow as a Synchronisation would run it (#2055): typed inputs from the schema, several values for a
   multi-valued attribute, "No value" distinct from empty text, values loaded from a real object, and a trace of each
   step of the pipeline synchronisation runs. *@
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
    @SyncRuleText.FlowTestIntro
</MudText>

<SegmentedToggle TValue="bool" Options="_valueSourceOptions" Value="_fromObject" ValueChanged="SetFromObject"
                 AriaLabel="@SyncRuleText.FlowTestValueSourceAria" Dense="true" />

@if (_fromObject)
{
    <TestObjectPicker Kind="ObjectKind" ConnectedSystemId="SyncRule.ConnectedSystemId" ConnectedSystemObjectType="SyncRule.ConnectedSystemObjectType"
                      MetaverseObjectTypeId="SyncRule.MetaverseObjectType?.Id" Label="@ObjectSearchLabel" OnPicked="LoadObjectAsync" Class="mt-3" />
}

@if (_inputs.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
        @SyncRuleText.FlowTestNoInputs
    </MudText>
}
else
{
    <MudSimpleTable Dense="true" Outlined="true" Class="mt-3" Style="overflow-x: auto">
        <thead>
            <tr><th>@SyncRuleText.FlowTestColumnInput</th><th>@SyncRuleText.FlowTestColumnType</th><th>@SyncRuleText.FlowTestColumnValue</th><th>@SyncRuleText.FlowTestColumnNoValue</th></tr>
        </thead>
        <tbody>
            @foreach (var input in _inputs)
            {
                var descriptor = input;
                var accessor = descriptor.Accessor;
                var state = StateOf(accessor);
                <tr @key="accessor">
                    <td>
                        <AttributeChip Kind="@(descriptor.Source == ExpressionInputSource.Metaverse ? AttributeChipKind.Metaverse : AttributeChipKind.ConnectedSystem)"
                                       Name="@descriptor.AttributeName" />
                    </td>
                    <td class="mud-text-secondary">@DescribeType(descriptor)</td>
                    <td style="min-width: 16rem">
                        @if (descriptor is { Type: { } type, Plurality: { } plurality })
                        {
                            <TestInputValueEditor Label="@accessor" Type="type" Plurality="plurality" State="state" OnChanged="InputsChangedAsync" />
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@NotHeldExplanation(descriptor)</MudText>
                        }
                    </td>
                    <td>
                        @if (descriptor.InSchema)
                        {
                            <MudCheckBox T="bool" Value="state.NoValue" ValueChanged="@(v => SetNoValueAsync(state, v))" Dense="true"
                                         aria-label="@string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestNoValueAria, accessor)" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

<RunAsOfPicker Value="_asOf" ValueChanged="SetAsOf" Class="mt-3" />

@* The test runs as the Expression, the values and the Attribute Flow's settings change. A half-typed Expression is
   the normal state while typing, and the editor already marks it, so it is noted here quietly rather than alarmed. *@
@if (_parseError != null)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
        @(_errorPosition is { } position
            ? string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestIncompleteAt, _parseError, position)
            : string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestIncomplete, _parseError))
    </MudText>
}
else if (!Tried)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
        @SyncRuleText.FlowTestEnterValues
    </MudText>
}

@if (_result is { InputErrors.Count: > 0 } inputProblem)
{
    <MudAlert Severity="Severity.Error" Class="mt-3">
        @foreach (var inputError in inputProblem.InputErrorDetails)
        {
            <MudText Typo="Typo.body2">@inputError.Show()</MudText>
        }
    </MudAlert>
}

@if (_result is { Evaluation: { } evaluation } tested)
{
    var source = evaluation.Source;
    <MudPaper Outlined="true" Class="pa-3 mt-3">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@SyncRuleText.FlowTestHeading</MudText>
        <MudSimpleTable Dense="true" Elevation="0" Class="mt-1">
            <tbody>
                <tr>
                    <td class="mud-text-secondary" style="width: 13rem; vertical-align: top">@SyncRuleText.FlowTestStepExpressionReturned</td>
                    <td>
                        @switch (source.Outcome)
                        {
                            case ExpressionSourceOutcome.Result:
                                @foreach (var line in ExpressionDisplay.Lines(source.Result))
                                {
                                    <MudText Typo="Typo.body1" Class="jim-expression-output">@line</MudText>
                                }
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestResultType, source.Result!.GetType().Name)</MudText>
                                break;
                            case ExpressionSourceOutcome.NoValue when source.MissingInputs.Count == 0:
                                <EmptyValue />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@SyncRuleText.FlowTestNoValue</MudText>
                                break;
                            case ExpressionSourceOutcome.EvaluationFailed:
                                <MudText Typo="Typo.body2">@string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestFailed, source.EvaluationException?.ToDisplayText())</MudText>
                                break;
                            default:
                                <MudText Typo="Typo.body2">@string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestNotEvaluated, string.Join(", ", source.MissingInputs))</MudText>
                                break;
                        }
                    </td>
                </tr>
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">@SyncRuleText.FlowTestStepValueProcessing</td>
                    <td><MudText Typo="Typo.body2">@DescribeValueProcessing(tested, evaluation)</MudText></td>
                </tr>
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">@string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestStepConverted, _targetName)</td>
                    <td>
                        @if (evaluation.Outcome == AttributeFlowOutcome.Values)
                        {
                            @foreach (var line in evaluation.Values.Select(ExpressionDisplay.Line))
                            {
                                <MudText Typo="Typo.body1" Class="jim-expression-output">@line</MudText>
                            }
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@evaluation.TargetType.ForDisplay()</MudText>
                        }
                        else if (evaluation.ErrorReason == AttributeFlowErrorReason.ResultNotConvertible)
                        {
                            <MudText Typo="Typo.body2">@string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestNotConvertible, evaluation.Resolution?.UnconvertibleValue, evaluation.TargetType.ForDisplay())</MudText>
                        }
                        else if (evaluation.ErrorReason == AttributeFlowErrorReason.ResultMultiValued)
                        {
                            <MudText Typo="Typo.body2">@string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestMultiValuedResult, evaluation.Resolution?.ValueCount)</MudText>
                        }
                        else if (evaluation.Resolution != null && evaluation.Outcome == AttributeFlowOutcome.NoValue)
                        {
                            <EmptyValue />
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@SyncRuleText.FlowTestNothingToConvert</MudText>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">@SyncRuleText.FlowTestStepResult</td>
                    <td>
                        @if (evaluation.Outcome == AttributeFlowOutcome.Error)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">@AttributeFlowTester.DescribeMessage(evaluation, _targetName).Show()</MudAlert>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@AttributeFlowTester.DescribeMessage(evaluation, _targetName).Show()</MudText>
                        }
                    </td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    @if (tested.IfInputHasNoValue.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-3 mt-3">
            <MissingInputCaption Choice="@MissingInputBehaviourName" OnChange="OnChangeMissingInputBehaviour" />
            <MudSimpleTable Dense="true" Elevation="0" Class="mt-1">
                <tbody>
                    @foreach (var absentOutcome in tested.IfInputHasNoValue)
                    {
                        <tr @key="absentOutcome.Accessor">
                            <td style="width: 13rem; vertical-align: top"><code>@absentOutcome.Accessor</code></td>
                            <td style="width: 7rem; vertical-align: top">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0"
                                         Color="@OutcomeColour(absentOutcome.Evaluation.Outcome)">@OutcomeLabel(absentOutcome.Evaluation.Outcome)</MudChip>
                            </td>
                            <td><MudText Typo="Typo.body2">@AttributeFlowTester.DescribeMessage(absentOutcome.Evaluation, _targetName).Show()</MudText></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}

@if (_result is { GeneratedBase: { } generated } testedBase)
{
    var baseSource = generated.Source;
    <MudPaper Outlined="true" Class="pa-3 mt-3">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@SyncRuleText.FlowTestHeading</MudText>
        <MudSimpleTable Dense="true" Elevation="0" Class="mt-1">
            <tbody>
                <tr>
                    <td class="mud-text-secondary" style="width: 13rem; vertical-align: top">@SyncRuleText.FlowTestStepBaseExpressionReturned</td>
                    <td>
                        @switch (baseSource?.Outcome)
                        {
                            case ExpressionSourceOutcome.Result:
                                @foreach (var line in ExpressionDisplay.Lines(baseSource.Result))
                                {
                                    <MudText Typo="Typo.body1" Class="jim-expression-output">@line</MudText>
                                }
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestResultType, baseSource.Result!.GetType().Name)</MudText>
                                break;
                            case ExpressionSourceOutcome.NoValue when baseSource.MissingInputs.Count == 0:
                                <EmptyValue />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@SyncRuleText.FlowTestNoValue</MudText>
                                break;
                            case ExpressionSourceOutcome.EvaluationFailed:
                                <MudText Typo="Typo.body2">@string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestFailed, baseSource.EvaluationException?.ToDisplayText())</MudText>
                                break;
                            case null:
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">@SyncRuleText.FlowTestNoBaseExpression</MudText>
                                break;
                            default:
                                <MudText Typo="Typo.body2">@string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestNotEvaluated, string.Join(", ", baseSource.MissingInputs))</MudText>
                                break;
                        }
                    </td>
                </tr>
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">@SyncRuleText.FlowTestStepValueProcessing</td>
                    <td><MudText Typo="Typo.body2">@DescribeBaseValueProcessing(testedBase, generated)</MudText></td>
                </tr>
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">@SyncRuleText.FlowTestStepBaseForGeneration</td>
                    <td>
                        @if (generated.Outcome == GeneratedBaseOutcome.Base)
                        {
                            <MudText Typo="Typo.body1" Class="jim-expression-output" data-testid="generated-base">@generated.BaseValue</MudText>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </td>
                </tr>
                @if (GeneratedResult == null)
                {
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">@SyncRuleText.FlowTestStepResult</td>
                    <td>
                        @if (generated.Outcome == GeneratedBaseOutcome.Error)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">@AttributeFlowTester.DescribeGeneratedBaseMessage(generated, Mapping.Generation!, _targetName).Show()</MudAlert>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@AttributeFlowTester.DescribeGeneratedBaseMessage(generated, Mapping.Generation!, _targetName).Show()</MudText>
                        }
                    </td>
                </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    @GeneratedResult

    @if (testedBase.GeneratedBaseIfInputHasNoValue.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-3 mt-3">
            <MissingInputCaption Choice="@MissingInputBehaviourName" OnChange="OnChangeMissingInputBehaviour" />
            <MudSimpleTable Dense="true" Elevation="0" Class="mt-1">
                <tbody>
                    @foreach (var absentOutcome in testedBase.GeneratedBaseIfInputHasNoValue)
                    {
                        <tr @key="absentOutcome.Accessor">
                            <td style="width: 13rem; vertical-align: top"><code>@absentOutcome.Accessor</code></td>
                            <td style="width: 7rem; vertical-align: top">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0"
                                         Color="@BaseOutcomeColour(absentOutcome.GeneratedBase.Outcome)">@BaseOutcomeLabel(absentOutcome.GeneratedBase.Outcome)</MudChip>
                            </td>
                            <td><MudText Typo="Typo.body2">@AttributeFlowTester.DescribeGeneratedBaseMessage(absentOutcome.GeneratedBase, Mapping.Generation!, _targetName).Show()</MudText></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}

@if (Generating && _result?.GeneratedBase == null)
{
    @GeneratedResult
}

@* A saved Attribute Flow's test can be kept as a test case (#2055 Phase 4), which runs against the flow as saved. *@
@if (Draft is { } draft)
{
    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.FactCheck" Class="mt-2"
               OnClick="@(() => SaveAsTestCaseAsync(draft))" data-testid="jim-attribute-flow-test-save-as-case">@SyncRuleText.FlowTestSaveAsTestCase</MudButton>
}

@code {
    /// <summary>
    /// The Expression to test, as typed in the editor.
    /// </summary>
    [Parameter, EditorRequired]
    public string Expression { get; set; } = string.Empty;

    /// <summary>
    /// The Synchronisation Rule the Attribute Flow belongs to: its direction and object types type the inputs.
    /// </summary>
    [Parameter, EditorRequired]
    public SyncRule SyncRule { get; set; } = null!;

    /// <summary>
    /// The Attribute Flow being edited: its target attribute and value processing, read as they stand when the test runs.
    /// </summary>
    [Parameter, EditorRequired]
    public SyncRuleMapping Mapping { get; set; } = null!;

    /// <summary>
    /// The source being edited: its Missing Input Behaviour, read as it stands when the test runs.
    /// </summary>
    [Parameter, EditorRequired]
    public SyncRuleMappingSource Source { get; set; } = null!;

    /// <summary>
    /// Raised as the inputs are edited or loaded, with each input's value as text (its first value, or null for no
    /// value), keyed by accessor. The Generated Value editor's candidate preview evaluates against these same samples.
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyDictionary<string, string?>> SampleValuesChanged { get; set; }

    /// <summary>
    /// For a Generated Value, raised with the base the values tried give generation; null while nothing has been
    /// tried. The Generated Value editor works its candidates out from it.
    /// </summary>
    [Parameter]
    public EventCallback<GeneratedBaseEvaluation?> TriedBaseChanged { get; set; }

    /// <summary>
    /// For a Generated Value, what follows the base: the candidates worked out from it, in place of the trace's own
    /// closing sentence. Shown whether or not anything has been tried yet.
    /// </summary>
    [Parameter]
    public RenderFragment? GeneratedResult { get; set; }

    /// <summary>
    /// The Missing Input Behaviour as the form names it, shown with the "If an input has no value" table; null leaves the
    /// table's heading plain.
    /// </summary>
    [Parameter]
    public string? MissingInputBehaviourName { get; set; }

    /// <summary>Raised from the "If an input has no value" table's Change link, to take the administrator to the setting.</summary>
    [Parameter]
    public EventCallback OnChangeMissingInputBehaviour { get; set; }

    /// <summary>
    /// Whether the Attribute Flow generates its value: the test then stops at the base, as a Synchronisation does.
    /// </summary>
    private bool Generating => Mapping.Generation != null;

    /// <summary>
    /// Whether there is anything to show a result for: a value given for an input, or an Expression that reads none.
    /// Before that, a result would only report every input missing, which answers nothing the administrator asked.
    /// </summary>
    private bool Tried => _valuesGiven || _inputs.Count == 0;

    private static readonly IReadOnlyList<SegmentedToggleOption<bool>> _valueSourceOptions =
    [
        new(false, SyncRuleText.FlowTestSampleValues),
        new(true, SyncRuleText.FlowTestFromObject)
    ];

    private IReadOnlyList<AttributeFlowTestInputDescriptor> _inputs = [];
    private readonly Dictionary<string, TestInputState> _states = new(StringComparer.Ordinal);
    private DateTime? _asOf;
    private string? _resolvedFrom;
    private string _targetName = string.Empty;
    private bool _fromObject;
    private bool _valuesGiven;
    private string? _testedKey;
    private GeneratedBaseEvaluation? _reportedBase;
    private AttributeFlowTestResult? _result;
    private SyncRuleMappingSource? _testedSource;
    private DateTime _ranAtUtc;

    /// <summary>
    /// The test as a test case to save, with the values tested and today's result expected; null when there is
    /// nothing to save, or the Attribute Flow is not saved yet.
    /// </summary>
    private ConfigurationTestCase? Draft => _result == null
        ? null
        : ConfigurationTestCaseDrafts.FromAttributeFlowTest(Mapping, _testedSource,
            _inputs.Select(input => (input, StateOf(input.Accessor))).ToList(), _result, _asOf, _ranAtUtc);
    private string? _parseError;
    private int? _errorPosition;

    private bool Exporting => SyncRule.Direction == SyncRuleDirection.Export;

    private ObjectChipKind ObjectKind => Exporting ? ObjectChipKind.MetaverseObject : ObjectChipKind.ConnectedSystemObject;

    private string ObjectSearchLabel => Exporting
        ? string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestFindMetaverseObject,
            SyncRule.MetaverseObjectType?.Name ?? SyncRuleText.FlowTestMetaverseObjectFallback)
        : string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestFindConnectedSystemObject,
            SyncRule.ConnectedSystemObjectType?.Name ?? SyncRuleText.FlowTestConnectedSystemObjectFallback,
            SyncRule.ConnectedSystem?.Name ?? SyncRuleText.FlowTestConnectedSystemFallback);

    protected override async Task OnParametersSetAsync()
    {
        _targetName = (Exporting ? Mapping.TargetConnectedSystemAttribute?.Name : Mapping.TargetMetaverseAttribute?.Name) ?? SyncRuleText.FlowTestTargetFallback;

        // Inputs follow the Expression as it is edited; values entered for an input that is still read are kept.
        if (_resolvedFrom != Expression)
        {
            _resolvedFrom = Expression;
            _inputs = AttributeFlowTester.DescribeInputs(SyncRule, Expression);
        }

        // The settings are edited in place on the same Mapping and Source, so a change shows only in their values.
        if (TestedKey() != _testedKey)
            await RunTestAsync();
    }

    /// <summary>
    /// Everything the result depends on besides the inputs: the Expression and the Attribute Flow's settings that the
    /// pipeline reads.
    /// </summary>
    private string TestedKey() => string.Join('|', Expression, Source.MissingInputBehaviour,
        Mapping.TargetMetaverseAttribute?.Id, Mapping.TargetMetaverseAttribute?.Type,
        Mapping.TargetConnectedSystemAttribute?.Id, Mapping.TargetConnectedSystemAttribute?.Type,
        Mapping.InboundValueProcessing, Mapping.CaseNormalisation, Mapping.NullIsValue, Generating);

    private void ClearResult()
    {
        _result = null;
        _parseError = null;
        _errorPosition = null;
    }

    private TestInputState StateOf(string accessor)
    {
        if (!_states.TryGetValue(accessor, out var state))
            _states[accessor] = state = new TestInputState();
        return state;
    }

    private async Task SetNoValueAsync(TestInputState state, bool noValue)
    {
        state.NoValue = noValue;
        await InputsChangedAsync();
    }

    private async Task InputsChangedAsync()
    {
        _valuesGiven = true;
        await RunTestAsync();
        if (SampleValuesChanged.HasDelegate)
            await SampleValuesChanged.InvokeAsync(_inputs.ToDictionary(input => input.Accessor,
                input => StateOf(input.Accessor) is { NoValue: false, Values: [var first, ..] } ? first : null, StringComparer.Ordinal));
    }

    private async Task SetAsOf(DateTime? asOf)
    {
        _asOf = asOf;
        await RunTestAsync();
    }

    private void SetFromObject(bool fromObject) => _fromObject = fromObject;

    /// <summary>
    /// Fills the inputs from a real object (#2055): every value it holds for each attribute the Expression reads, as the
    /// text the inputs take, and "No value" for an attribute it holds none for. An import flow that reads mv[...] also
    /// takes those inputs from the Metaverse Object the Connected System Object is joined to.
    /// </summary>
    private async Task LoadObjectAsync(TestObjectPicker.PickedObject found)
    {
        using var jim = JimFactory.Create();
        var loaded = new List<AttributeFlowTestInput>();
        if (Exporting)
        {
            if (await jim.Metaverse.GetMetaverseObjectAsync(found.Id) is { } mvo)
                loaded.AddRange(AttributeFlowTester.InputsFromMetaverseObject(mvo, Expression));
        }
        else if (await jim.ConnectedSystems.GetConnectedSystemObjectAsync(SyncRule.ConnectedSystemId, found.Id) is { } cso)
        {
            loaded.AddRange(AttributeFlowTester.InputsFromConnectedSystemObject(cso, SyncRule.ConnectedSystemObjectType, Expression));
            if (cso.MetaverseObjectId is { } joinedId && await jim.Metaverse.GetMetaverseObjectAsync(joinedId) is { } joined)
                loaded.AddRange(AttributeFlowTester.InputsFromMetaverseObject(joined, Expression));
        }

        foreach (var input in loaded)
            StateOf(input.Accessor).Load(input.Values.Select(ToEditableText));

        await InputsChangedAsync();
    }

    /// <summary>
    /// A loaded value as text the input converts back to the same value: JIM's text form, and base64 for Binary.
    /// </summary>
    private static string ToEditableText(object value) => value switch
    {
        byte[] bytes => Convert.ToBase64String(bytes),
        _ => ExpressionText.TryFormat(value, out var text) ? text ?? string.Empty : value.ToString() ?? string.Empty
    };

    private async Task RunTestAsync()
    {
        _testedKey = TestedKey();
        RunTest();

        // Only a change is reported: the editor re-renders this panel on the report, which must not report again.
        var tried = _result?.GeneratedBase;
        if (TriedBaseChanged.HasDelegate && !SameBase(tried, _reportedBase))
        {
            _reportedBase = tried;
            await TriedBaseChanged.InvokeAsync(tried);
        }
    }

    private static bool SameBase(GeneratedBaseEvaluation? left, GeneratedBaseEvaluation? right) =>
        left?.Outcome == right?.Outcome && left?.BaseValue == right?.BaseValue && left?.ErrorReason == right?.ErrorReason;

    private void RunTest()
    {
        ClearResult();
        if (string.IsNullOrWhiteSpace(Expression))
            return;

        var validation = ExpressionEvaluator.Validate(Expression);
        if (!validation.IsValid)
        {
            _parseError = MessageDisplay.Show(validation.ErrorDetail, validation.ErrorMessage) ?? SyncRuleText.FlowTestParseFailed;
            _errorPosition = validation.ErrorPosition;
            return;
        }

        if (!Tried)
            return;

        var inputs = _inputs
            .Select(input => new AttributeFlowTestInput(input.Source, input.AttributeName, StateOf(input.Accessor).TestValues))
            .ToList();

        // The source as it stands in the editor, with the Expression as typed.
        var source = new SyncRuleMappingSource { Expression = Expression, MissingInputBehaviour = Source.MissingInputBehaviour };
        _testedSource = source;
        _ranAtUtc = DateTime.UtcNow;
        _result = AttributeFlowTester.Test(SyncRule, Mapping, source, inputs, ExpressionEvaluator, _asOf ?? _ranAtUtc);
    }

    private async Task SaveAsTestCaseAsync(ConfigurationTestCase draft) =>
        await ConfigurationTestCaseDialog.ShowAsync(DialogService, draft,
            string.Format(CultureInfo.CurrentCulture,
                Generating ? SyncRuleText.FlowTestSavedCaseGenerated : SyncRuleText.FlowTestSavedCaseFlow, _targetName),
            _inputs.Where(input => input is { Type: not null, Plurality: not null })
                .Select(input => new ConfigurationTestCaseDisplay.InputSlot(input.Source, input.AttributeName, input.Type!.Value, input.Plurality!.Value))
                .ToList());

    private static string DescribeType(AttributeFlowTestInputDescriptor input) => input.Type is { } type
        ? string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestTypeAndPlurality, type.ForDisplay(),
            input.Plurality == AttributePlurality.MultiValued ? SyncRuleText.FlowTestMultiValued : SyncRuleText.FlowTestSingleValued)
        : SyncRuleText.FlowTestNotAvailable;

    private string NotHeldExplanation(AttributeFlowTestInputDescriptor input) =>
        input.Source == ExpressionInputSource.ConnectedSystem && Exporting
            ? SyncRuleText.FlowTestNotHeldExport
            : string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestNotHeldNoAttribute,
                input.Source == ExpressionInputSource.ConnectedSystem ? SyncRule.ConnectedSystemObjectType?.Name : SyncRule.MetaverseObjectType?.Name);

    private static string DescribeValueProcessing(AttributeFlowTestResult tested, AttributeFlowEvaluation evaluation)
    {
        if (tested.ValueProcessing is not { } processing)
            return evaluation.Source.Outcome != ExpressionSourceOutcome.Result
                ? SyncRuleText.FlowTestNothingToProcess
                : SyncRuleText.FlowTestNotAppliedText;

        return DescribeProcessingSteps(processing);
    }

    private static string DescribeProcessingSteps(AttributeFlowValueProcessing processing)
    {
        if (processing.Steps.Count == 0)
            return SyncRuleText.FlowTestNoneSet;

        var steps = processing.Steps.Select(StepLabel).Aggregate((joined, next) =>
            string.Format(CultureInfo.CurrentCulture, SyncRuleText.FlowTestStepsThen, joined, next));
        return string.Format(CultureInfo.CurrentCulture,
            processing.Changed ? SyncRuleText.FlowTestProcessingChanged : SyncRuleText.FlowTestProcessingUnchanged, steps);
    }

    private static string DescribeBaseValueProcessing(AttributeFlowTestResult tested, GeneratedBaseEvaluation generated)
    {
        if (tested.ValueProcessing is not { } processing)
            return generated.UnprocessedBaseValue == null ? SyncRuleText.FlowTestNothingToProcess : SyncRuleText.FlowTestNotAppliedImport;

        return DescribeProcessingSteps(processing);
    }

    private static string BaseOutcomeLabel(GeneratedBaseOutcome outcome) => outcome switch
    {
        GeneratedBaseOutcome.Base => SyncRuleText.FlowTestBaseOutcomeBase,
        GeneratedBaseOutcome.Waits => SyncRuleText.FlowTestBaseOutcomeWaits,
        GeneratedBaseOutcome.NoBaseExpression => SyncRuleText.FlowTestBaseOutcomeTokenOnly,
        _ => SyncRuleText.FlowTestOutcomeError
    };

    private static Color BaseOutcomeColour(GeneratedBaseOutcome outcome) => outcome switch
    {
        GeneratedBaseOutcome.Base => Color.Success,
        GeneratedBaseOutcome.Error => Color.Error,
        _ => Color.Default
    };

    private static string StepLabel(AttributeFlowValueProcessingStep step) => step switch
    {
        AttributeFlowValueProcessingStep.TrimWhitespace => SyncRuleText.FlowTestStepTrim,
        AttributeFlowValueProcessingStep.CollapseInternalWhitespace => SyncRuleText.FlowTestStepCollapse,
        AttributeFlowValueProcessingStep.UpperCase => SyncRuleText.FlowTestStepUpper,
        AttributeFlowValueProcessingStep.LowerCase => SyncRuleText.FlowTestStepLower,
        AttributeFlowValueProcessingStep.TitleCase => SyncRuleText.FlowTestStepTitle,
        AttributeFlowValueProcessingStep.TreatWhitespaceAsNoValue => SyncRuleText.FlowTestStepWhitespaceNoValue,
        _ => step.ForDisplay()
    };

    private static string OutcomeLabel(AttributeFlowOutcome outcome) => outcome switch
    {
        AttributeFlowOutcome.Values => SyncRuleText.FlowTestOutcomeValues,
        AttributeFlowOutcome.NoValue => SyncRuleText.FlowTestOutcomeNoValue,
        _ => SyncRuleText.FlowTestOutcomeError
    };

    private static Color OutcomeColour(AttributeFlowOutcome outcome) => outcome switch
    {
        AttributeFlowOutcome.Values => Color.Success,
        AttributeFlowOutcome.NoValue => Color.Default,
        _ => Color.Error
    };
}
