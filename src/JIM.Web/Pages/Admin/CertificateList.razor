@page "/admin/certificates"
@attribute [Authorize(Roles = "Administrator")]
@using System.Globalization
@using JIM.Models.Activities
@using JIM.Models.Core
@using JIM.Models.Core.DTOs
@using JIM.Models.Security
@using JIM.Web
@using JIM.Web.Authentication
@using JIM.Web.Models
@using JIM.Web.Services
@implements IDisposable
@inject IJimApplicationFactory JimFactory
@inject TrustedCertificateChanges CertificateChanges
@inject IIdentityProviderTrustMonitor IdentityProviderTrust
@inject ISnackbar Snackbar
@inject IDialogService DialogService

