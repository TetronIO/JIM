@* Renders a single CSO attribute value with appropriate formatting based on type *@

@if (Value.ReferenceValue != null)
{
    <CsoReferenceLink ReferenceValue="@Value.ReferenceValue" />
}
else if (Value.UnresolvedReferenceValue != null)
{
    @* The cause chip (#959) wraps under the value when the cell is narrow, rather than splitting the value. *@
    <span class="jim-attr-unresolved jim-attr-unresolved-with-cause">
        <span class="jim-attr-unresolved">
            <MudIcon Icon="@Icons.Material.Filled.LinkOff" Class="mr-1" />
            <span class="mud-text-secondary jim-text-code">@Value.UnresolvedReferenceValue</span>
        </span>
        <UnresolvedReferenceCauseChip Diagnosis="@UnresolvedReferenceCauses?.For(Value)" />
    </span>
}
else if (Value.Attribute.Type == AttributeDataType.DateTime && Value.DateTimeValue.HasValue)
{
    <MudTooltip Text="@Value.DateTimeValue.Value.ToFriendlyAttributeDate()" Arrow="true" Placement="Placement.Top">
        <span>@Value.DateTimeValue.Value.ToRelativeTime()</span>
    </MudTooltip>
}
else if (Value.Attribute.Type == AttributeDataType.Boolean && Value.BoolValue.HasValue)
{
    @* Local capture: see "Nullable dereference in Razor" in JIM.Web/CLAUDE.md. *@
    var boolValue = Value.BoolValue.Value;
    <BooleanValue Value="@boolValue" />
}
else if (Value.Attribute.Type == AttributeDataType.Binary && Value.ByteValue != null)
{
    <span class="mud-text-secondary">[Binary: @Value.ByteValue.Length bytes]</span>
}
else if (Value.Attribute.Type == AttributeDataType.Text)
{
    <TextValueDisplay Value="@Value.StringValue" Class="jim-text-code" />
}
else
{
    <span class="jim-text-code">@Value.ToStringNoName()</span>
}

@code {
    [Parameter]
    public ConnectedSystemObjectAttributeValue Value { get; set; } = null!;

    /// <summary>The page's diagnoses, for the likely cause beside an unresolved reference (#959); absent elsewhere.</summary>
    [CascadingParameter]
    public UnresolvedReferenceCauses? UnresolvedReferenceCauses { get; set; }
}
