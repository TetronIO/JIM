@* alert-button: exempt - a decision panel rather than a notice: its buttons carry consequences of their own (a
   destructive Apply & Remove in red beside Apply & Disable Dependents and Cancel), which one severity colour would hide. *@
<MudAlert Severity="@PanelSeverity"
          Icon="@Icons.Material.Filled.Preview"
          Class="mb-5 jim-alert-schema-refresh-preview">
    <MudText Typo="Typo.subtitle1" Class="mb-2">
        <strong>@SchemaText.PreviewTitle</strong>
    </MudText>

    @if (!Result.HasChanges)
    {
        <MudText Class="mb-2">
            @((MarkupString)string.Format(CultureInfo.CurrentCulture, SchemaText.FoundSummary, string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(Result.TotalObjectTypes, SchemaText.ObjectTypeCountOne, SchemaText.ObjectTypeCountOther), Result.TotalObjectTypes.ToString("N0", CultureInfo.CurrentCulture)), string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(Result.TotalAttributes, SchemaText.AttributeCountOne, SchemaText.AttributeCountOther), Result.TotalAttributes.ToString("N0", CultureInfo.CurrentCulture))))
        </MudText>
        <MudText Color="Color.Success">@SchemaText.NoChangesDetected</MudText>
        <MudButton data-testid="jim-close-schema-refresh"
                   Variant="Variant.Text"
                   Color="Color.Inherit"
                   DropShadow="false"
                   Class="mt-3"
                   OnClick="@(() => OnDiscard.InvokeAsync())">@CommonText.Close</MudButton>
    }
    else
    {
        <MudText Class="mb-2">
            @((MarkupString)string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewIntro, Strong(SchemaText.PreviewNothingApplied)))
        </MudText>

        @if (Result.DiscoveryWarnings.Count > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2 mb-2">
                <strong>@SchemaText.DiscoveryWarningsLabel</strong> @SchemaText.PreviewDiscoveryText
                <ul class="mt-1 mb-0">
                    @foreach (var warning in Result.DiscoveryWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </MudAlert>
        }

        @if (Result.AttributesSelectedByConnector.Count > 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2 mb-2">
                <strong>@SchemaText.SelectedByConnector</strong>
                @(string.Join(", ", Result.AttributesSelectedByConnector.SelectMany(kvp => kvp.Value).Distinct())).
                @SchemaText.SelectedByConnectorExplain
            </MudAlert>
        }

        @if (Result.BlockedCredentialAttributeCount > 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-2 mb-2">
                <strong>@string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(Result.BlockedCredentialAttributeCount, SchemaText.CredentialAttributesBlockedOne, SchemaText.CredentialAttributesBlockedOther), Result.BlockedCredentialAttributeCount)</strong>
                @(string.Join(", ", Result.BlockedCredentialAttributes.SelectMany(kvp => kvp.Value).Distinct())).
                @SchemaText.PreviewCredentialExplain
            </MudAlert>
        }

        @if (HasAdditions)
        {
            <MudText Typo="Typo.body1" Class="mt-3" Style="font-weight:600" Color="Color.Success">@(HasRenames ? SchemaText.PreviewAdditionsRenames : SchemaText.PreviewAdditions)</MudText>
            <SchemaChangeTable Result="Result" Section="SchemaChangeTable.SchemaChangeSection.Additions" />
        }

        @if (Result.HasObjectTypeClassificationChanges)
        {
            @* Neither safe nor destructive (#2049): applying can move entries between selected Object Types at the next
               import, while cancelling keeps the classification matching reads, so it needs a warning but not the
               three-way decision. *@
            <MudText Typo="Typo.body1" Class="mt-4" Style="font-weight:600" Color="Color.Warning">@SchemaText.PreviewClassificationHeading</MudText>
            <SchemaChangeTable Result="Result" Section="SchemaChangeTable.SchemaChangeSection.Reclassified" />

            <MudAlert Severity="Severity.Warning" Class="mt-3" data-testid="jim-schema-refresh-reclassified-warning">
                @((MarkupString)string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewReclassifiedBody, Strong(SchemaText.PreviewReclassifiedWhich), Strong(SchemaText.PreviewObjectTypeChangedError), Strong(SchemaText.PreviewAllowObjectTypeChanges)))
                <MudLink Href="https://docs.junctional.io/configuration/connected-system-schema/#when-an-object-changes-object-type" Target="_blank">@SchemaText.PreviewLearnMore</MudLink>
            </MudAlert>
        }

        @if (Result.HasRemovalsOrDefinitionChanges)
        {
            <MudText Typo="Typo.body1" Class="mt-4" Style="font-weight:600" Color="Color.Error">@SchemaText.PreviewDestructiveHeading</MudText>
            <SchemaChangeTable Result="Result" Section="SchemaChangeTable.SchemaChangeSection.Destructive" />

            @if (Dependents is { HasAny: true })
            {
                <MudText Typo="Typo.body1" Class="mt-3" Style="font-weight:600">@SchemaText.PreviewDependentsHeading</MudText>
                <ul class="mt-1 mb-0">
                    @foreach (var rule in Dependents.InvalidatedSyncRules)
                    {
                        <li>
                            @SchemaText.PreviewSyncRuleWord <MudLink Href="@SyncRuleUrl(rule.SyncRuleId)" Target="_blank">@rule.SyncRuleName</MudLink>
                            @((MarkupString)string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewRuleBoundTo, Span(rule.ObjectTypeName), MappingCount(rule.MappingCount)))
                        </li>
                    }
                    @foreach (var mapping in Dependents.InvalidatedMappings)
                    {
                        <li>
                            @SchemaText.PreviewMappingWord <span class="jim-text-code">@mapping.Description</span> @SchemaText.PreviewOnWord
                            <MudLink Href="@SyncRuleUrl(mapping.SyncRuleId)" Target="_blank">@mapping.SyncRuleName</MudLink>@(mapping.ViaExpression ? SchemaText.PreviewViaExpression : "").
                        </li>
                    }
                    @foreach (var matchingRule in Dependents.ReferencedObjectMatchingRules)
                    {
                        <li>@string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewMatchingRule, matchingRule.Context, matchingRule.Reason)</li>
                    }
                    @foreach (var reader in Dependents.RemovedAttributeReaders)
                    {
                        <li>
                            @string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewReaderLine, reader.Description)
                            @if (Helpers.AttributeReaderHref(reader) is { } readerHref)
                            {
                                <MudLink Href="@readerHref" Target="_blank" Class="ml-1">@SchemaText.PreviewOpen</MudLink>
                            }
                        </li>
                    }
                </ul>
            }

            @if (Dependents is { RemovalRefused: true })
            {
                <MudAlert Severity="Severity.Info" Class="mt-3" data-testid="jim-schema-refresh-removal-refused">
                    @((MarkupString)string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewRemovalRefused, Strong(SchemaText.PreviewRemovalUnavailable), ReaderCount(Dependents.RemovedAttributeReaders.Count), System.Net.WebUtility.HtmlEncode(SchemaText.PreviewApplyDisableName)))
                </MudAlert>
            }

            <MudAlert Severity="Severity.Warning" Class="mt-3">
                @((MarkupString)string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewRetainedBody, Strong(SchemaText.PreviewRetainedWord)))
            </MudAlert>
        }

        @if (Result.ActionRequired)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3">
                <strong>@SchemaText.ActionRequiredLabel</strong>
                @SchemaText.PreviewActionRequiredText
            </MudAlert>
        }

        <div class="d-flex mt-4 flex-wrap" style="gap: 8px">
            <MudButton data-testid="jim-discard-schema-refresh"
                       Variant="Variant.Text"
                       Color="Color.Inherit"
                       DropShadow="false"
                       Disabled="@Busy"
                       OnClick="HandleDiscardAsync">@CommonText.Cancel</MudButton>
            <MudSpacer />
            @if (Result.HasRemovalsOrDefinitionChanges)
            {
                @* A destructive diff pauses on the three-way decision (#1485): Cancel, Apply & Disable
                   Dependents, or Apply & Remove. A plain apply that leaves invalidated configuration running
                   is deliberately not one of the choices. *@
                @if (Dependents is { HasAny: true })
                {
                    <MudButton data-testid="jim-apply-disable-schema-refresh"
                               Variant="Variant.Outlined"
                               Color="Color.Warning"
                               DropShadow="false"
                               Disabled="@Busy"
                               OnClick="@(() => _disablePlanDialogVisible = true)">@SchemaText.PreviewApplyDisableButton</MudButton>
                }
                <MudButton data-testid="jim-apply-remove-schema-refresh"
                           Variant="Variant.Outlined"
                           Color="Color.Error"
                           DropShadow="false"
                           Disabled="@(Busy || Dependents is { RemovalRefused: true })"
                           OnClick="@(() => _removePlanDialogVisible = true)">@SchemaText.PreviewApplyRemoveButton</MudButton>
            }
            else
            {
                <MudButton data-testid="jim-apply-schema-refresh"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           DropShadow="false"
                           Disabled="@Busy"
                           OnClick="@(() => OnApply.InvokeAsync())">@SchemaText.PreviewApplyButton</MudButton>
            }
        </div>
    }
</MudAlert>

@* ─── Apply & Disable Dependents plan (#1485) ─── *@
<MudDialog @bind-Visible="_disablePlanDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Shield" Class="mr-3" /> @SchemaText.PreviewDisableDialogTitle
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-2">
            @((MarkupString)string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewDisableIntro, Strong(SchemaText.PreviewDisabledWord)))
        </MudText>
        @if (Dependents != null)
        {
            <ul class="mb-0">
                @foreach (var rule in Dependents.InvalidatedSyncRules)
                {
                    <li class="mb-1">
                        <strong><MudLink Href="@SyncRuleUrl(rule.SyncRuleId)" Target="_blank">@rule.SyncRuleName</MudLink></strong> @string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewRuleDisabledSuffix, MappingCount(rule.MappingCount))
                        <br /><span class="mud-text-secondary">@rule.Reason</span>
                    </li>
                }
                @foreach (var mapping in Dependents.InvalidatedMappings)
                {
                    <li class="mb-1">
                        @SchemaText.PreviewMappingWord <span class="jim-text-code">@mapping.Description</span> @SchemaText.PreviewOnWord <MudLink Href="@SyncRuleUrl(mapping.SyncRuleId)" Target="_blank">@mapping.SyncRuleName</MudLink> @SchemaText.PreviewMappingDisabled
                        <br /><span class="mud-text-secondary">@mapping.Reason</span>
                    </li>
                }
            </ul>
            @if (Dependents.ReferencedObjectMatchingRules.Count > 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-2">
                    @SchemaText.PreviewMatchingNoDisabled
                    <ul class="mt-1 mb-0">
                        @foreach (var matchingRule in Dependents.ReferencedObjectMatchingRules)
                        {
                            <li>@string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewMatchingReason, matchingRule.Context, matchingRule.Reason)</li>
                        }
                    </ul>
                </MudAlert>
            }
        }
    </DialogContent>
    <DialogActions>
        <MudButton DropShadow="false" Variant="Variant.Text" OnClick="@(() => _disablePlanDialogVisible = false)" Class="ma-4">@SchemaText.PreviewBack</MudButton>
        <MudButton data-testid="jim-confirm-apply-disable"
                   DropShadow="false"
                   Variant="Variant.Filled"
                   Color="Color.Warning"
                   Disabled="@Busy"
                   OnClick="HandleConfirmApplyWithDisablesAsync"
                   Class="ma-4">@SchemaText.PreviewApplyDisableConfirm</MudButton>
    </DialogActions>
</MudDialog>

@* ─── Apply & Remove plan (#1485) ─── *@
<MudDialog @bind-Visible="_removePlanDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DeleteForever" Class="mr-3" /> @SchemaText.PreviewRemoveDialogTitle
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Error" Class="mb-3">
            <strong>@SchemaText.PreviewDeletesLead</strong> @SchemaText.PreviewDeletesBody
        </MudAlert>
        @if (Dependents is { HasAny: true })
        {
            <MudText Typo="Typo.body1" Style="font-weight:600">@SchemaText.PreviewConfigDeleted</MudText>
            <ul class="mt-1 mb-3">
                @foreach (var rule in Dependents.InvalidatedSyncRules)
                {
                    <li class="mb-1">
                        @SchemaText.PreviewSyncRuleWord <strong><MudLink Href="@SyncRuleUrl(rule.SyncRuleId)" Target="_blank">@rule.SyncRuleName</MudLink></strong> @string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewRuleDeletedSuffix, MappingCount(rule.MappingCount))
                        <br /><span class="mud-text-secondary">@rule.Reason</span>
                    </li>
                }
                @foreach (var mapping in Dependents.InvalidatedMappings)
                {
                    <li class="mb-1">
                        @SchemaText.PreviewMappingWord <span class="jim-text-code">@mapping.Description</span> @SchemaText.PreviewOnWord <MudLink Href="@SyncRuleUrl(mapping.SyncRuleId)" Target="_blank">@mapping.SyncRuleName</MudLink> @SchemaText.PreviewMappingDeleted
                        <br /><span class="mud-text-secondary">@mapping.Reason</span>
                    </li>
                }
            </ul>
        }
        @if (RemovalImpact != null && (RemovalImpact.RemovedObjectTypes.Count > 0 || RemovalImpact.RemovedAttributes.Count > 0))
        {
            <MudText Typo="Typo.body1" Style="font-weight:600">@SchemaText.PreviewDataRemoved</MudText>
            <ul class="mt-1 mb-2">
                @foreach (var type in RemovalImpact.RemovedObjectTypes)
                {
                    <li class="mb-1">
                        @((MarkupString)string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(type.ConnectedSystemObjectCount, SchemaText.PreviewObjectsObsoleteOne, SchemaText.PreviewObjectsObsoleteOther), Strong(type.ConnectedSystemObjectCount.ToString("N0", CultureInfo.CurrentCulture)), Span(type.ObjectTypeName)))
                    </li>
                }
                @foreach (var attributeImpact in RemovalImpact.RemovedAttributes)
                {
                    <li class="mb-1">
                        @((MarkupString)string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(attributeImpact.StoredValueCount, SchemaText.PreviewStoredValuesOne, SchemaText.PreviewStoredValuesOther), Strong(attributeImpact.StoredValueCount.ToString("N0", CultureInfo.CurrentCulture)), Span(attributeImpact.AttributeName), Span(attributeImpact.ObjectTypeName)))
                    </li>
                }
            </ul>
            <MudText Class="mb-2 mud-text-secondary">
                @SchemaText.PreviewObsoletedBody
            </MudText>
        }
        @if (Dependents is { ReferencedObjectMatchingRules.Count: > 0 })
        {
            <MudAlert Severity="Severity.Info" Class="mt-2">
                @SchemaText.PreviewMatchingNotDeleted
                <ul class="mt-1 mb-0">
                    @foreach (var matchingRule in Dependents.ReferencedObjectMatchingRules)
                    {
                        <li>@string.Format(CultureInfo.CurrentCulture, SchemaText.PreviewMatchingReason, matchingRule.Context, matchingRule.Reason)</li>
                    }
                </ul>
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton DropShadow="false" Variant="Variant.Text" OnClick="@(() => _removePlanDialogVisible = false)" Class="ma-4">@SchemaText.PreviewBack</MudButton>
        <MudButton data-testid="jim-confirm-apply-remove"
                   DropShadow="false"
                   Variant="Variant.Filled"
                   Color="Color.Error"
                   Disabled="@Busy"
                   OnClick="HandleConfirmApplyWithRemovalsAsync"
                   Class="ma-4">@SchemaText.PreviewApplyRemoveConfirm</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private bool _disablePlanDialogVisible;
    private bool _removePlanDialogVisible;

    /// <summary>
    /// The refresh being previewed. Nothing it describes has been persisted.
    /// </summary>
    [Parameter, EditorRequired]
    public SchemaRefreshResult Result { get; set; } = null!;

    /// <summary>
    /// What the refresh's destructive changes invalidate: the dependents named on the review, and the plan the
    /// Apply &amp; Disable Dependents option commits (#1485). Null or empty hides that option.
    /// </summary>
    [Parameter]
    public SchemaRefreshDependents? Dependents { get; set; }

    /// <summary>
    /// Raised when the administrator chooses to persist the previewed refresh as-is.
    /// </summary>
    [Parameter]
    public EventCallback OnApply { get; set; }

    /// <summary>
    /// Raised when the administrator confirms applying the refresh with the dependents disabled.
    /// </summary>
    [Parameter]
    public EventCallback OnApplyWithDisables { get; set; }

    /// <summary>
    /// What the "Apply and Remove" option would remove, counted before anything is committed (#1485). Shown in
    /// that option's plan dialog beside the configuration deletions.
    /// </summary>
    [Parameter]
    public SchemaRefreshRemovalImpact? RemovalImpact { get; set; }

    /// <summary>
    /// Raised when the administrator confirms applying the refresh with the dependents removed: configuration
    /// deleted and the data removal queued.
    /// </summary>
    [Parameter]
    public EventCallback OnApplyWithRemovals { get; set; }

    /// <summary>
    /// Raised when the administrator discards the previewed refresh (after confirmation, where discarding leaves
    /// JIM's schema adrift of the Connected System's).
    /// </summary>
    [Parameter]
    public EventCallback OnDiscard { get; set; }

    /// <summary>
    /// True while an apply is running, so the buttons cannot be pressed twice.
    /// </summary>
    [Parameter]
    public bool Busy { get; set; }

    private Severity PanelSeverity => Result.HasRemovalsOrDefinitionChanges || Result.HasObjectTypeClassificationChanges
        ? Severity.Warning
        : Severity.Info;

    private bool HasAdditions =>
        Result.AddedObjectTypes.Count > 0 ||
        Result.UpdatedObjectTypes.Count > 0 ||
        Result.RenamedObjectTypes.Count > 0 ||
        Result.RenamedAttributes.Values.Sum(v => v.Count) > 0 ||
        Result.ObjectTypesWithClassificationUpdates.Count > 0 ||
        Result.AddedAttributes.Values.Sum(v => v.Count) > 0;

    private bool HasRenames =>
        Result.RenamedObjectTypes.Count > 0 ||
        Result.RenamedAttributes.Values.Sum(v => v.Count) > 0;

    /// <summary>A phrase in emphasis, HTML-encoded: the text is a resource string, shown as markup.</summary>
    private static string Strong(string text) => $"<strong>{System.Net.WebUtility.HtmlEncode(text)}</strong>";

    /// <summary>A name in the portal's code style, HTML-encoded.</summary>
    private static string Span(string? text) => $"<span class=\"jim-text-code\">{System.Net.WebUtility.HtmlEncode(text)}</span>";

    private static string MappingCount(int count) =>
        string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(count, SchemaText.PreviewMappingsOne, SchemaText.PreviewMappingsOther), count);

    private static string ReaderCount(int count) =>
        string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(count, SchemaText.PreviewReaderCountOne, SchemaText.PreviewReaderCountOther), count);

    private static string SyncRuleUrl(int syncRuleId) => $"/admin/sync-rules/{syncRuleId}";

    private async Task HandleConfirmApplyWithDisablesAsync()
    {
        _disablePlanDialogVisible = false;
        await OnApplyWithDisables.InvokeAsync();
    }

    private async Task HandleConfirmApplyWithRemovalsAsync()
    {
        _removePlanDialogVisible = false;
        await OnApplyWithRemovals.InvokeAsync();
    }

    /// <summary>
    /// Additions discard for free (the next refresh finds them again), and so do Object Type classification changes
    /// (matching reads the classification JIM has stored, so cancelling keeps things as they are). Removals and
    /// definition changes do not: cancelling does not preserve the status quo, so the administrator confirms with
    /// the concrete consequences in front of them.
    /// </summary>
    private async Task HandleDiscardAsync()
    {
        if (Result.HasRemovalsOrDefinitionChanges)
        {
            var options = new MessageBoxOptions
            {
                Title = SchemaText.PreviewCancelTitle,
                MarkupMessage = (MarkupString)SchemaText.PreviewCancelBody,
                YesText = SchemaText.PreviewCancelRefresh,
                CancelText = SchemaText.PreviewKeepReviewing
            };

            var confirmed = await DialogService.ShowMessageBoxAsync(options);
            if (confirmed != true)
                return;
        }

        await OnDiscard.InvokeAsync();
    }
}
