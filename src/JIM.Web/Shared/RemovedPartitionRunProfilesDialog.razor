@* The choice a hierarchy refresh asks for when it would remove a partition that Run Profiles target (#2740). The   *@
@* refresh has saved nothing by the time this opens: disabling the Run Profiles applies it, and Cancel leaves both   *@
@* the hierarchy and the Run Profiles exactly as they were.                                                         *@

<MudDialog>
    <DialogContent>
        <MudText Class="mb-4">
            @string.Format(CultureInfo.CurrentCulture, SchemaText.RemovedPartitionIntro,
                PluralRules.Choose(PartitionCount, SchemaText.RemovedPartitionPartitionOne, SchemaText.RemovedPartitionPartitionOther),
                RunProfileCountText,
                PluralRules.Choose(RunProfiles.Count, SchemaText.RemovedPartitionTargetsOne, SchemaText.RemovedPartitionTargetsOther),
                PluralRules.Choose(PartitionCount, SchemaText.RemovedPartitionItOne, SchemaText.RemovedPartitionItOther),
                PluralRules.Choose(RunProfiles.Count, SchemaText.RemovedPartitionThatSingle, SchemaText.RemovedPartitionThoseOther))
        </MudText>

        <MudSimpleTable Dense="true" Outlined="true" Class="mb-4" data-testid="jim-removed-partition-run-profiles">
            <thead>
                <tr>
                    <th>@SchemaText.RunProfileHeader</th>
                    <th>@SchemaText.PartitionRemovedHeader</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var runProfile in RunProfiles)
                {
                    <tr @key="runProfile.RunProfileId">
                        <td>@runProfile.RunProfileName</td>
                        <td><span class="jim-code-inline">@runProfile.PartitionName</span></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @string.Format(CultureInfo.CurrentCulture, SchemaText.RemovedPartitionExplain, SchemaText.DisableRunProfiles, CommonText.Cancel)
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" data-testid="jim-removed-partition-run-profiles-cancel">@CommonText.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false" OnClick="Disable"
                   data-testid="jim-removed-partition-run-profiles-disable">@SchemaText.DisableRunProfiles</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The Run Profiles that target a partition the refresh would remove, each with that partition's name.
    /// </summary>
    [Parameter]
    public IReadOnlyList<HierarchyRefreshRunProfileItem> RunProfiles { get; set; } = [];

    private string RunProfileCountText => string.Format(CultureInfo.CurrentCulture,
        PluralRules.Choose(RunProfiles.Count, SchemaText.RemovedPartitionRunProfileCountOne, SchemaText.RemovedPartitionRunProfileCountOther), RunProfiles.Count);

    /// <summary>How many distinct partitions the listed Run Profiles target, which the explanation names as "it" or "them".</summary>
    private int PartitionCount => RunProfiles.Select(runProfile => runProfile.PartitionName).Distinct(StringComparer.OrdinalIgnoreCase).Count();

    private void Cancel() => MudDialog.Cancel();

    private void Disable() => MudDialog.Close(DialogResult.Ok(true));

    /// <summary>
    /// Asks whether to apply the refresh by disabling these Run Profiles. True to disable them; false to apply nothing.
    /// </summary>
    public static async Task<bool> ShowAsync(IDialogService dialogService, IReadOnlyList<HierarchyRefreshRunProfileItem> runProfiles)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<RemovedPartitionRunProfilesDialog> { { dialog => dialog.RunProfiles, runProfiles } };
        var dialog = await dialogService.ShowAsync<RemovedPartitionRunProfilesDialog>(SchemaText.RunProfilesTargetRemoved, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: true };
    }
}
