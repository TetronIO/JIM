<MudAlert Severity="ConnectedSystem.ObjectTypes is { Count: > 0 } ? Severity.Warning : Severity.Info" Variant="Variant.Outlined">
    @if (ConnectedSystem.ObjectTypes == null || ConnectedSystem.ObjectTypes.Count == 0)
    {
        <MudText>Retrieve the schema from the Connected System, to be able to select which object types and attributes you want to manage with JIM.</MudText>
    }
    else
    {
        <MudText>
            <strong>Refreshing the schema can result in data-loss</strong>. If object types or attributes are discovered to have been removed at the Connected System, then this
            will result in all references to them being removed from within JIM, i.e. Synchronisation Rules, Attribute Flow, attributes values and even entire objects will be
            deleted if object types are removed. Refresh with caution. Ensure the Connected System identity has the right permissions needed to retrieve the schema, and consider
            a database backup before proceeding.
        </MudText>
    }
    <MudButton
        Color="ConnectedSystem.ObjectTypes == null || ConnectedSystem.ObjectTypes.Count == 0 ? Color.Info : Color.Warning"
        Disabled="@(_schemaBeingRetrieved)"
        Variant="Variant.Filled"

        OnClick="HandleImportSchemaAsync"
        Class="mt-5"
        DropShadow="false">
        @if (ConnectedSystem.ObjectTypes == null || ConnectedSystem.ObjectTypes.Count == 0)
        {
            if (_schemaBeingRetrieved)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">Retrieving Schema</span>
            }
            else
            {
                <text>Retrieve Schema</text>
            }
        }
        else
        {
            if (_schemaBeingRetrieved)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">Refreshing Schema</span>
            }
            else
            {
                <text>Refresh Schema</text>
            }
        }
    </MudButton>
</MudAlert>

@if (_schemaRefreshResult != null)
{
    var result = _schemaRefreshResult;
    <MudAlert Severity="@(result.Success ? (result.HasChanges ? Severity.Info : Severity.Success) : Severity.Error)"
              Variant="Variant.Outlined"
              Icon="@(result.Success ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Error)"
              Class="mt-5 jim-alert-schema-refresh"
              ShowCloseIcon="true"
              CloseIconClicked="HandleCloseSchemaRefreshResult">
        <MudText Typo="Typo.subtitle1" Class="mb-2">
            <strong>Schema Refresh @(result.Success ? "Complete" : "Failed")</strong>
        </MudText>

        @if (result.Success)
        {
            <MudText Class="mb-2">
                Found <strong>@result.TotalObjectTypes.ToString("N0")</strong> object type(s) with <strong>@result.TotalAttributes.ToString("N0")</strong> attribute(s).
            </MudText>

            @if (result.BlockedCredentialAttributeCount > 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2 mb-2">
                    <strong>@result.BlockedCredentialAttributeCount credential attribute(s) blocked:</strong>
                    @(string.Join(", ", result.BlockedCredentialAttributes.SelectMany(kvp => kvp.Value).Distinct())).
                    These hold credential material and are never managed by JIM. Passwords are synchronised through JIM's dedicated password channel, which writes to the Connected System without ever reading the value back into the Metaverse.
                </MudAlert>
            }

            @if (result.DiscoveryWarnings.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2 mb-2">
                    <strong>Discovery warnings:</strong> the Connector could not discover everything and worked around the gaps below. Review them so a missing attribute can be traced to the Connected System rather than JIM.
                    <ul class="mt-1 mb-0">
                        @foreach (var warning in result.DiscoveryWarnings)
                        {
                            <li>@warning</li>
                        }
                    </ul>
                </MudAlert>
            }

            @if (!result.HasChanges)
            {
                <MudText Color="Color.Success">No changes detected. The schema is up to date.</MudText>
            }
            else
            {
                <MudSimpleTable Dense="true" Hover="true" Bordered="true" Elevation="0" Class="mt-2 jim-schema-change-table">
                    <thead>
                        <tr>
                            <th>Change Type</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (result.AddedObjectTypes.Count > 0)
                        {
                            <tr>
                                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Success" Class="me-1" /><span>Object Types Added</span></div></td>
                                <td class="jim-text-code">@string.Join(", ", result.AddedObjectTypes)</td>
                            </tr>
                        }
                        @if (result.RemovedObjectTypes.Count > 0)
                        {
                            <tr>
                                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Error" Class="me-1" /><span>Object Types Removed</span></div></td>
                                <td class="jim-text-code">@string.Join(", ", result.RemovedObjectTypes)</td>
                            </tr>
                        }
                        @if (result.UpdatedObjectTypes.Count > 0)
                        {
                            <tr>
                                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Update" Color="Color.Info" Class="me-1" /><span>Object Types Updated</span></div></td>
                                <td class="jim-text-code">@string.Join(", ", result.UpdatedObjectTypes)</td>
                            </tr>
                        }
                        @foreach (var kvp in result.AddedAttributes)
                        {
                            <tr>
                                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Success" Class="me-1" /><span>Attributes Added (@kvp.Key)</span></div></td>
                                <td class="jim-text-code">@string.Join(", ", kvp.Value)</td>
                            </tr>
                        }
                        @foreach (var kvp in result.RemovedAttributes)
                        {
                            <tr>
                                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Warning" Class="me-1" /><span>Attributes Removed (@kvp.Key)</span></div></td>
                                <td class="jim-text-code">@string.Join(", ", kvp.Value)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                @if (result.ActionRequired)
                {
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                        <strong>Action Required:</strong> Some attributes that were removed are still referenced by Synchronisation Rules.
                        Please update your Synchronisation Rules to remove references to these attributes.
                    </MudAlert>
                }
            }
        }
        else
        {
            <MudText Color="Color.Error">@result.ErrorMessage</MudText>
        }
    </MudAlert>
}

@* Only meaningful where the Connector can set passwords at all; on one that cannot, there is no policy to read and
   no channel to check. *@
@if (ConnectedSystem.ConnectorDefinition.SupportsPasswordSet)
{
    <ConnectedSystemPasswordPolicyPanel ConnectedSystem="ConnectedSystem" />
}

<MudDialog @bind-Visible="_editSchemaAttributeDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" /> Edit Schema Attribute: @_objectTypeAttributeBeingEdited?.Name
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (!_objectTypeAttributeBeingEditedIsEditable)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                This Connected System attribute cannot be edited as it is being referenced by either a Synchronisation Rule, or has values already populated.
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                This Connector supports changing the data type of a Connected System attribute. This might be because the data type
                was detected automatically, and might need adjusting if not right.
            </MudAlert>
        }

        <MudSelect
            T="string"
            Label="Please choose a data type"
            Required="true"
            Variant="Variant.Outlined"
            Class="mt-5"
            Disabled="!_objectTypeAttributeBeingEditedIsEditable"
            @bind-Value="_objectTypeAttributeBeingEditedText">
            @foreach (AttributeDataType type in Enum.GetValues(typeof(AttributeDataType)))
            {
                if (type != AttributeDataType.NotSet)
                {
                    <MudSelectItem Value="@type.ToString()"/>
                }
            }
        </MudSelect>

    </DialogContent>
    <DialogActions>
        <MudButton
            DropShadow="false"
            Variant="Variant.Text"
            OnClick="@(() => _editSchemaAttributeDialogVisible = false)"
            Class="ma-4">Cancel</MudButton>
        <MudButton
            Disabled="!_objectTypeAttributeBeingEditedIsEditable"
            DropShadow="false"
            Variant="Variant.Filled"
            Color="Color.Primary"
            OnClick="HandleEditAttributeDataTypeButtonClickAsync"
            Class="ma-4">Confirm Change</MudButton>
    </DialogActions>
</MudDialog>

@if (ConnectedSystem.ObjectTypes is { Count: > 0 })
{
    var selectedObjectTypes = GetSelectedObjectTypes();
    <div class="schema-tabs mt-6">
        <MudTabs Elevation="0"
                 Rounded="true"
                 Outlined="true"
                 Border="true"
                 ApplyEffectsToContainer="true"
                 TabPanelsClass="pa-4"
                 ActivePanelIndex="_activeSchemaTabIndex"
                 ActivePanelIndexChanged="OnSchemaTabChanged">

            @* ─── Object type discovery & selection ─── *@
            <MudTabPanel Icon="@Icons.Material.Filled.Tune" Text="Object Types">
                @{
                    var visibleObjectTypeCount = GetVisibleObjectTypes().Count();
                    var hiddenInternalCount = GetHiddenInternalObjectTypeCount();
                }
                <MudText Typo="Typo.subtitle1" Class="mb-1">Choose which object types JIM should manage</MudText>
                <MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
                    Each type you select gets its own tab above, where you choose the attributes to import or export. To maximise system performance, select only the types you actually need.
                </MudText>

                <MudGrid>
                    <MudItem xs="12" md="8">
                        <SearchField @bind-Value="_objectTypeSearchString"
                                     Label="Search object types"
                                     HelperText="Show only types whose name contains a specific value"
                                     IconSize="Size.Small"
                                     Margin="Margin.None" />
                    </MudItem>
                    <MudItem xs="12" md="4" Class="d-flex align-center justify-md-end">
                        <MudChipSet T="bool"
                                    SelectionMode="SelectionMode.SingleSelection"
                                    SelectedValue="_objectTypeSelectedFilter"
                                    SelectedValueChanged="@((bool val) => _objectTypeSelectedFilter = val)">
                            <MudChip Value="false"
                                     Color="Color.Default"
                                     Variant="@(!_objectTypeSelectedFilter ? Variant.Filled : Variant.Outlined)">
                                All (@visibleObjectTypeCount)
                            </MudChip>
                            <MudChip Value="true"
                                     Color="Color.Primary"
                                     Variant="@(_objectTypeSelectedFilter ? Variant.Filled : Variant.Outlined)">
                                Selected (@selectedObjectTypes.Count)
                            </MudChip>
                        </MudChipSet>
                    </MudItem>
                </MudGrid>

                @{
                    var discoveryObjectTypes = GetFilteredDiscoveryObjectTypes().ToList();
                }
                @if (discoveryObjectTypes.Count == 0)
                {
                    <MudText Class="mt-6 mb-2 mud-text-secondary" Align="Align.Center">No object types match the current filter.</MudText>
                }
                else
                {
                    <MudGrid Spacing="2" Class="mt-2">
                        @foreach (var objectType in discoveryObjectTypes)
                        {
                            var selectedAttributeCount = objectType.Attributes.Count(a => a.Selected);
                            var totalAttributeCount = objectType.Attributes.Count;
                            <MudItem xs="12" sm="6" md="4">
                                <MudPaper Outlined="true" Class="@(objectType.Selected ? "schema-type-card schema-type-card-selected" : "schema-type-card")">
                                    @* The whole card is the toggle target; the switch is presentational (read-only, no
                                       pointer events) so deselecting can be confirmed before anything actually changes. *@
                                    <div class="d-flex align-center pa-2 px-3" style="gap: 10px; cursor: pointer;"
                                         @onclick="@(() => HandleObjectTypeGridToggleAsync(objectType, !objectType.Selected))">
                                        <MudSwitch T="bool"
                                                   Value="@objectType.Selected"
                                                   Color="Color.Primary"
                                                   ReadOnly="true"
                                                   Style="pointer-events: none;" />
                                        <span class="flex-grow-1 text-truncate">@objectType.Name</span>
                                        <MudTooltip Text="@($"{selectedAttributeCount} of {totalAttributeCount} attributes selected")" Arrow="true" Placement="Placement.Top">
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@selectedAttributeCount / @totalAttributeCount</MudText>
                                        </MudTooltip>
                                    </div>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                    <MudText Typo="Typo.body1" Class="mt-4 mud-text-secondary d-block" Align="Align.Center">
                        Showing @discoveryObjectTypes.Count of @visibleObjectTypeCount object types
                    </MudText>
                }

                @* Internal object types are hidden rather than discarded, so the count and the way back are stated
                   plainly. Nothing here changes what was discovered or what is stored. *@
                @if (hiddenInternalCount > 0)
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mt-4">
                        <div class="d-flex align-center flex-wrap" style="gap: 8px;">
                            <span class="flex-grow-1">
                                @hiddenInternalCount internal object @(hiddenInternalCount == 1 ? "type is" : "types are") hidden.
                                These are classes the Connected System uses for its own configuration or operation.
                            </span>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Inherit"
                                       StartIcon="@Icons.Material.Filled.Visibility"
                                       OnClick="@(() => _showInternalObjectTypes = true)">
                                Show internal object types
                            </MudButton>
                        </div>
                    </MudAlert>
                }
                else if (_showInternalObjectTypes && AnyInternalObjectTypes())
                {
                    <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true" Class="mt-4">
                        <div class="d-flex align-center flex-wrap" style="gap: 8px;">
                            <span class="flex-grow-1">Internal object types are shown.</span>
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Inherit"
                                       StartIcon="@Icons.Material.Filled.VisibilityOff"
                                       OnClick="@(() => _showInternalObjectTypes = false)">
                                Hide internal object types
                            </MudButton>
                        </div>
                    </MudAlert>
                }
            </MudTabPanel>

            @* ─── One tab per selected object type ─── *@
            @foreach (var objectType in selectedObjectTypes)
            {
                <MudTabPanel Text="@objectType.Name">
                    <MudText Typo="Typo.h5"><span>Object Type:</span> <span class="mud-primary-text">@objectType.Name</span></MudText>
                    @if (_selectedObjectType != null)
                    {
        @* Captured inside the guard so the markup below never dereferences the nullable field directly (see the
           nullable-dereference rule in JIM.Web/CLAUDE.md). *@
        var selectedObjectType = _selectedObjectType;

        @if (ConnectedSystem.ConnectorDefinition.SupportsUserSelectedExternalId)
        {
            <MudPaper Outlined="true" Class="pa-4 mt-5">
                <MudText>This connector requires you to select the attribute that is used as the External ID. Please select one below.</MudText>
                <MudSelect
                    T="ConnectedSystemObjectTypeAttribute"
                    Label="External ID Attribute"
                    Variant="Variant.Outlined"
                    Class="mt-5"
                    Required="true"
                    RequiredError="You must select an attribute as the External ID."
                    Value="_selectedObjectType.Attributes.SingleOrDefault(q => q.IsExternalId)"
                    ValueChanged="HandleMakeExternalIdAsync">
                    @foreach (var objectTypeAttribute in _selectedObjectType.Attributes.Where(q => q.AttributePlurality == AttributePlurality.SingleValued))
                    {
                        <MudSelectItem Value="@objectTypeAttribute">@(objectTypeAttribute.Name)</MudSelectItem>
                    }
                </MudSelect>
            </MudPaper>
        }

        @if (ConnectedSystem.SupportsImportMode())
        {
            <MudPaper Outlined="true" Class="pa-4 mt-5">
                <MudText Typo="Typo.h6" Class="mb-3">Settings</MudText>
                <MudSwitch
                    @bind-Value="@_selectedObjectType.RemoveContributedAttributesOnObsoletion"
                    Color="@Color.Primary"
                    Label="Remove contributed attributes when source objects are deleted" />
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    When enabled, this will remove attribute values on joined Metaverse Objects contributed by this system, for this object type when the source object is deleted.
                </MudText>
            </MudPaper>
        }

        @* Renders nothing unless the Connected System hands class membership to JIM to compute, which is what makes
           merging an auxiliary class mean anything. *@
        <AuxiliaryClassesPanel
            ConnectedSystem="ConnectedSystem"
            ObjectType="selectedObjectType"
            LatestDiscoveryRun="LatestAuxiliaryClassDiscoveryRun"
            OnSchemaChanged="OnConnectedSystemChanged" />

        <MudPaper Outlined="true" Class="pa-4 mt-5">
            <MudText Typo="Typo.h6" Class="mb-3">Attribute Selection</MudText>
            <MudText>
                Select which attributes you would like JIM to import, or export for this object type. To maximise system performance, only select those you actually need.
            </MudText>

            @* Filtering by name is the grid's own search box, not a second one here: two boxes narrowing the same
               table is exactly the confusion the shared search convention exists to prevent. *@
            <MudGrid Class="mt-3">
                @if (_selectedObjectTypeHasClasses)
                {
                    <MudItem xs="6">
                        <MudSelect
                            T="string"
                            Label="Filter by class"
                            MultiSelection="true"
                            @bind-SelectedValues="AttributeClassFilterSelectedValues"
                            @bind-SelectedValues:after="OnSchemaClassFilterChangedAsync"
                            Variant="Variant.Outlined"
                            HelperText="Show only attributes with a particular class"
                            Adornment="Adornment.Start"
                            AdornmentIcon="@Icons.Material.Filled.FilterAlt"
                            IconSize="Size.Small">
                            @foreach (var className in _selectedObjectType.Attributes.Select(a => a.ClassName).Distinct().OrderBy(a => a))
                            {
                                <MudSelectItem T="string" Value="@className">@className</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }

                <MudItem xs="@(_selectedObjectTypeHasClasses ? 6 : 12)">
                    <MudTextField
                        T="string"
                        Label="Select attributes via CSV"
                        @bind-Value="_attributeSelectionCsv"
                        HelperText="Quick-select by comma-separated list, e.g. DisplayName,sAMAccountName"
                        InputType="InputType.Text"
                        Adornment="Adornment.End"
                        AdornmentIcon="@Icons.Material.Filled.Check"
                        OnAdornmentClick="HandleAttributeCsvSubmitAsync"
                        IconSize="Size.Small"
                        Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>

            <MudStack Row="true" Spacing="6" Class="mt-4 flex-wrap" AlignItems="AlignItems.Start">
                <div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Type:</MudText>
                    <MudChipSet T="AttributeDataType"
                                SelectionMode="SelectionMode.MultiSelection"
                                SelectedValues="_selectedSchemaTypes"
                                SelectedValuesChanged="OnSchemaTypeFilterChangedAsync">
                        @foreach (var type in GetAvailableSchemaTypes())
                        {
                            <MudChip Value="@type.Key"
                                     Color="Color.Primary"
                                     Variant="@(_selectedSchemaTypes.Contains(type.Key) ? Variant.Filled : Variant.Outlined)">
                                @type.Key.ToString().SplitOnCapitalLetters() (@type.Value)
                            </MudChip>
                        }
                    </MudChipSet>
                </div>

                <div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Plurality:</MudText>
                    <MudChipSet T="AttributePlurality"
                                SelectionMode="SelectionMode.MultiSelection"
                                SelectedValues="_selectedSchemaPluralites"
                                SelectedValuesChanged="OnSchemaPluralityFilterChangedAsync">
                        @foreach (var plurality in GetAvailableSchemaPluralites())
                        {
                            <MudChip Value="@plurality.Key"
                                     Color="Color.Info"
                                     Variant="@(_selectedSchemaPluralites.Contains(plurality.Key) ? Variant.Filled : Variant.Outlined)">
                                @(plurality.Key == AttributePlurality.SingleValued ? "Single-Valued" : "Multi-Valued") (@plurality.Value)
                            </MudChip>
                        }
                    </MudChipSet>
                </div>

                @if (_selectedObjectTypeHasConstrainedAttributes)
                {
                    <div>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Writability:</MudText>
                        <MudChipSet T="AttributeWritability"
                                    SelectionMode="SelectionMode.MultiSelection"
                                    SelectedValues="_selectedSchemaWritabilities"
                                    SelectedValuesChanged="OnSchemaWritabilityFilterChangedAsync">
                            @foreach (var writability in GetAvailableSchemaWritabilities())
                            {
                                <MudChip Value="@writability.Key"
                                         Color="@Helpers.GetAttributeWritabilityChipColour(writability.Key)"
                                         Variant="@(_selectedSchemaWritabilities.Contains(writability.Key) ? Variant.Filled : Variant.Outlined)">
                                    @Helpers.GetAttributeWritabilityLabel(writability.Key) (@writability.Value)
                                </MudChip>
                            }
                        </MudChipSet>
                    </div>
                }

                @{
                    var selectionCounts = GetSchemaSelectionCounts();
                }
                <div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Selection:</MudText>
                    <MudChipSet T="bool"
                                SelectionMode="SelectionMode.SingleSelection"
                                SelectedValue="_attributeSelectedFilter"
                                SelectedValueChanged="OnAttributeSelectedFilterChangedAsync">
                        <MudChip Value="false"
                                 Color="Color.Default"
                                 Variant="@(!_attributeSelectedFilter ? Variant.Filled : Variant.Outlined)">
                            All (@selectionCounts.allCount)
                        </MudChip>
                        <MudChip Value="true"
                                 Color="Color.Default"
                                 Variant="@(_attributeSelectedFilter ? Variant.Filled : Variant.Outlined)">
                            Selected Only (@selectionCounts.selectedCount)
                        </MudChip>
                    </MudChipSet>
                </div>
            </MudStack>
        </MudPaper>

        @* An Active Directory object type runs to several hundred attributes, which is what the infinite-scroll
           grid is for. The rows are the object type's own attribute objects, sliced in memory, so the selection
           switches still write straight through to what Save Changes persists. The chip filters above are the
           page's own, so changing one re-counts the match set (see RefreshAttributeGridAsync). *@
        <VirtualisedDataGrid @ref="_attributeGrid" T="ConnectedSystemObjectTypeAttribute"
                             ContainerId="@($"schema-attributes-{selectedObjectType.Id}")"
                             UrlParameterPrefix="@($"attr{selectedObjectType.Id}-")"
                             StateKey="@selectedObjectType.Id.ToString()"
                             DefaultSortBy="name"
                             LoadWindow="LoadAttributeWindowAsync"
                             SingularName="Attribute"
                             PluralName="Attributes"
                             SearchPlaceholder="Search by name">
            <Columns>
                <TemplateColumn Title="Selected" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Selected" Name="selected" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (CredentialAttributes.IsCredentialAttribute(context.Item.Name))
                        {
                            <MudTooltip Text="This attribute holds credential material and cannot be managed by JIM. Passwords are synchronised through JIM's dedicated password channel, which writes to the Connected System without ever reading the value back into the Metaverse; they never flow through an Attribute Flow." Arrow="true" Placement="Placement.Top">
                                <MudSwitch Value="false" Color="@Color.Primary" Disabled="true" />
                            </MudTooltip>
                        }
                        else if (context.Item.IsExternalId || context.Item.IsSecondaryExternalId)
                        {
                            <MudTooltip Text="This attribute cannot be unselected because it is the External ID or Secondary External ID. These attributes must remain selected for sync operations to function correctly." Arrow="true" Placement="Placement.Top">
                                <MudSwitch Value="@context.Item.Selected" Color="@Color.Primary" Disabled="true" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudSwitch @bind-Value="@context.Item.Selected" @bind-Value:after="OnAttributeSelectedChangedAsync" Color="@Color.Primary" />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="External ID" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="External ID" Name="externalid" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @if (context.Item.IsExternalId)
                        {
                            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">External ID</MudChip>
                        }
                        else if (context.Item.IsSecondaryExternalId)
                        {
                            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">Secondary ID</MudChip>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Name" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Name" Name="name" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.Name
                    </CellTemplate>
                </TemplateColumn>
                @* Hidden rather than omitted, here and on Writability and Description below: MudDataGrid orders its
                   columns by the order they register with it, not by their position in this markup, so a column
                   whose condition only becomes true after the grid has rendered (each of these three is derived
                   from the selected Object Type's attributes, and the selection changes under the reader) would
                   register last and render at the far right, whatever the markup says. *@
                <TemplateColumn Title="Class" Sortable="false" Hidden="@(!_selectedObjectTypeHasClasses)">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Class" Name="class" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @context.Item.ClassName
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Type" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Type" Name="type" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudChip T="string" Color="@Helpers.GetAttributeTypeChipColour(context.Item.Type)" Variant="Variant.Outlined">
                            @context.Item.Type.ToString().SplitOnCapitalLetters()
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Plurality" Sortable="false">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Plurality" Name="plurality" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudChip T="string" Color="@Helpers.GetAttributePluralityChipColour(context.Item.AttributePlurality)" Variant="Variant.Text">
                            @(context.Item.AttributePlurality == AttributePlurality.SingleValued ? "Single-Valued" : "Multi-Valued")
                        </MudChip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Writability" Sortable="false" Hidden="@(!_selectedObjectTypeHasConstrainedAttributes)">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Writability" Name="writability" />
                    </HeaderTemplate>
                    <CellTemplate>
                        <MudTooltip Text="@Helpers.GetAttributeWritabilityDescription(context.Item.Writability)" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string"
                                     Color="@Helpers.GetAttributeWritabilityChipColour(context.Item.Writability)"
                                     Variant="Variant.Outlined">
                                @Helpers.GetAttributeWritabilityLabel(context.Item.Writability)
                            </MudChip>
                        </MudTooltip>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Description" Sortable="false" Hidden="@(!_selectedObjectTypeHasDescriptions)">
                    <HeaderTemplate>
                        <VirtualisedSortHeader Title="Description" Name="description" />
                    </HeaderTemplate>
                    <CellTemplate>
                        @* Raw imported LDAP/SCIM text, so its length is the directory's business, not JIM's:
                           a row in a virtualised grid is one line, so it is clipped rather than wrapped, and
                           the whole description is on the cell's title. The class is used directly here
                           rather than through <OneLineText /> because the linkified RFC references are
                           markup. *@
                        @if (string.IsNullOrEmpty(context.Item.Description))
                        {
                            <EmptyValue />
                        }
                        else
                        {
                            var description = context.Item.Description;
                            <span class="jim-one-line" title="@description">@((MarkupString)Helpers.LinkifyRfcReferences(description))</span>
                        }
                    </CellTemplate>
                </TemplateColumn>
                @if (ConnectedSystem.ConnectorDefinition.SupportsUserSelectedAttributeTypes)
                {
                    <TemplateColumn Title="Action" Sortable="false">
                        <HeaderTemplate>
                            <MudText Typo="Typo.button">Action</MudText>
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudButton
                                DropShadow="false"
                                Color="Color.Primary"
                                Variant="Variant.Outlined"
                                Size="Size.Small"
                                OnClick="() => HandleShowEditAttributeDialogAsync(context.Item)"
                                StartIcon="@Icons.Material.Filled.Edit">
                                Edit
                            </MudButton>
                        </CellTemplate>
                    </TemplateColumn>
                }
            </Columns>
            <EmptyContent Context="grid">
                @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                     PrimaryText="@($"No attributes match \"{grid.SearchText}\"")"
                                     SecondaryText="Try a different search term, or clear the search."
                                     ActionText="Clear Search"
                                     OnAction="@(() => grid.ClearSearchAsync())" />
                }
                else if (_attributeSelectedFilter)
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                                     PrimaryText="No attributes are selected for this object type"
                                     SecondaryText="Choose All above to see everything the Connected System reported, then select the attributes JIM should manage." />
                }
                else if (AnySchemaFilterIsActive)
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                                     PrimaryText="No attributes match these filters"
                                     SecondaryText="Clear a class, type, plurality or writability filter above to widen the list." />
                }
                else
                {
                    <TableEmptyState Icon="@Icons.Material.Filled.ListAlt"
                                     PrimaryText="No attributes were discovered for this object type"
                                     SecondaryText="Retrieve the schema again once the Connected System reports attributes for it." />
                }
            </EmptyContent>
        </VirtualisedDataGrid>
                    }
                </MudTabPanel>
            }
        </MudTabs>
    </div>

    <MudButton
        Color="Color.Primary"
        Variant="Variant.Filled"
        OnClick="HandleObjectTypesAndAttributeSelectionSubmitAsync"
        Class="mt-6"
        DropShadow="false"
        Disabled="DisableSaveSchemaButton()">Save Changes</MudButton>
}

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    /// <summary>
    /// The Connected System's last auxiliary class discovery run, or null when none has been run. Supplied by the
    /// page rather than fetched here: the tab renders one Auxiliary Classes panel per Object Type, and the run
    /// belongs to the whole Connected System.
    /// </summary>
    [Parameter]
    public AuxiliaryClassDiscoveryRun? LatestAuxiliaryClassDiscoveryRun { get; set; }

    [Parameter]
    public EventCallback OnConnectedSystemChanged { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private bool _schemaBeingRetrieved;
    private SchemaRefreshResult? _schemaRefreshResult;
    private ConnectedSystemObjectType? _selectedObjectType;
    private int _activeSchemaTabIndex;
    private string _objectTypeSearchString = "";
    private bool _objectTypeSelectedFilter;

    // Object types the Connected System classified as internal are held back until asked for. Not persisted as a
    // user preference: it is a per-visit "let me look at the plumbing", not a standing choice about every system.
    private bool _showInternalObjectTypes;
    private bool _selectedObjectTypeHasClasses;
    private bool _selectedObjectTypeHasDescriptions;
    private bool _selectedObjectTypeHasConstrainedAttributes;
    private IReadOnlyCollection<AttributeWritability> _selectedSchemaWritabilities = new List<AttributeWritability>();
    private string _schemaSearchString = "";
    private IReadOnlyCollection<string> AttributeClassFilterSelectedValues { get; set; } = new HashSet<string>();
    private bool _attributeSelectedFilter;
    private string? _attributeSelectionCsv;
    private IReadOnlyCollection<AttributeDataType> _selectedSchemaTypes = new List<AttributeDataType>();
    private IReadOnlyCollection<AttributePlurality> _selectedSchemaPluralites = new List<AttributePlurality>();
    private VirtualisedDataGrid<ConnectedSystemObjectTypeAttribute>? _attributeGrid;

    // Set when the active object type has been rebound onto a freshly loaded Connected System graph; consumed in
    // OnAfterRenderAsync, because the reload must run against the grid the new render produced.
    private bool _attributeGridReloadPending;

    private readonly DialogOptions _dialogOptions = new() { FullWidth = true };
    private bool _editSchemaAttributeDialogVisible;
    private ConnectedSystemObjectTypeAttribute? _objectTypeAttributeBeingEdited;
    private string? _objectTypeAttributeBeingEditedText;
    private bool _objectTypeAttributeBeingEditedIsEditable;

    private const string ObjectTypeQueryParameterName = "ot";
    private bool _objectTypeDeepLinkApplied;

    protected override void OnParametersSet()
    {
        // The ConnectedSystem parameter is replaced wholesale on reload (e.g. after a schema refresh or save),
        // so a previously-resolved _selectedObjectType can become a stale, detached instance. Rebind it to the
        // matching type in the fresh collection (by Id, to preserve the active selection), then fall back to the
        // first selected type (which is how a single auto-selected type surfaces after import).
        var previousObjectType = _selectedObjectType;
        if (_selectedObjectType != null)
            _selectedObjectType = ConnectedSystem.ObjectTypes?.FirstOrDefault(ot => ot.Id == _selectedObjectType.Id);
        _selectedObjectType ??= ConnectedSystem.ObjectTypes?.FirstOrDefault(q => q.Selected);

        // The object type's id is unchanged across that rebind, so the grid has no way of knowing its rows now
        // point at attribute objects from a graph that has been thrown away; toggling a switch on one of them
        // would write to an instance nothing saves. Reload once the new render is in the DOM.
        if (!ReferenceEquals(previousObjectType, _selectedObjectType))
            _attributeGridReloadPending = true;

        // Deep-link support: "?t=schema&ot=jimPerson" selects that object type's sub-tab on first load. Applied
        // once only, so it never overrides the admin's own subsequent tab clicks after a schema refresh or save
        // reloads ConnectedSystem.
        if (!_objectTypeDeepLinkApplied && ConnectedSystem.ObjectTypes != null)
        {
            ApplyObjectTypeDeepLink();
            _objectTypeDeepLinkApplied = true;
        }

        if (_selectedObjectType != null)
        {
            _selectedObjectTypeHasClasses = _selectedObjectType.Attributes.Any(q => q.ClassName != null);
            _selectedObjectTypeHasDescriptions = _selectedObjectType.Attributes.Any(q => q.Description != null);
            _selectedObjectTypeHasConstrainedAttributes = _selectedObjectType.Attributes.Any(q => q.Writability != AttributeWritability.Writable);
        }
    }

    /// <summary>
    /// Selects the sub-tab for the object type named by the "ot" query string parameter (e.g.
    /// "?t=schema&amp;ot=jimPerson"), matched case-insensitively against Connected System Object Type names. No-op
    /// when the parameter is absent, or names a type that is not (yet) selected for JIM to manage.
    /// </summary>
    private void ApplyObjectTypeDeepLink()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var objectTypeName = query[ObjectTypeQueryParameterName];
        if (string.IsNullOrEmpty(objectTypeName))
            return;

        var selected = GetSelectedObjectTypes();
        var index = selected.FindIndex(ot => ot.Name.Equals(objectTypeName, StringComparison.OrdinalIgnoreCase));
        if (index < 0)
            return;

        _selectedObjectType = selected[index];
        _activeSchemaTabIndex = index + 1;
    }

    /// <summary>
    /// Keeps the "ot" query string parameter in sync with the active object type sub-tab, so the URL is always a
    /// shareable deep link back to the currently viewed type. Mirrors NavigableMudTabs' own "t" parameter handling,
    /// preserving every other query parameter (notably "t=schema", set by the parent tab strip).
    /// </summary>
    private void UpdateObjectTypeQueryString()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var baseUri = uri.GetLeftPart(UriPartial.Path);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        if (_selectedObjectType == null)
            query.Remove(ObjectTypeQueryParameterName);
        else
            query[ObjectTypeQueryParameterName] = _selectedObjectType.Name;

        var qs = query.ToString();
        var newUrl = string.IsNullOrEmpty(qs) ? baseUri : $"{baseUri}?{qs}";
        NavManager.NavigateTo(newUrl, new NavigationOptions { ReplaceHistoryEntry = false });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_attributeGridReloadPending)
            return;

        _attributeGridReloadPending = false;
        await RefreshAttributeGridAsync();
    }

    /// <summary>
    /// Slices one window of the active object type's attributes, applying the page's chip filters, the grid's
    /// search (attribute name, which is what the tab's own name filter used to do) and its sort. The attributes
    /// belong to the Connected System the page already loaded, so there is no database range read: the switches in
    /// the Selected column write straight through to the objects Save Changes persists.
    /// </summary>
    private Task<VirtualisedWindow<ConnectedSystemObjectTypeAttribute>> LoadAttributeWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        // The chip counts beside the filters are contextual: they describe the attributes remaining under every
        // other filter, search included. The search now lives in the grid, so its text is mirrored back here and
        // the tab re-rendered, or the counts would describe a wider set than the rows underneath them.
        var searchText = request.SearchText ?? string.Empty;
        var searchChanged = !string.Equals(_schemaSearchString, searchText, StringComparison.Ordinal);
        _schemaSearchString = searchText;

        var attributes = (_selectedObjectType?.Attributes ?? new List<ConnectedSystemObjectTypeAttribute>())
            .Where(SchemaFilterFuncHandler);

        IOrderedEnumerable<ConnectedSystemObjectTypeAttribute> Order<TKey>(Func<ConnectedSystemObjectTypeAttribute, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? attributes.OrderByDescending(key, comparer) : attributes.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "selected" => Order(a => a.Selected),
            "externalid" => Order(a => a.IsExternalId),
            "class" => Order(a => a.ClassName ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            "type" => Order(a => a.Type),
            "plurality" => Order(a => a.AttributePlurality),
            "writability" => Order(a => a.Writability),
            "description" => Order(a => a.Description ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            _ => Order(a => a.Name, StringComparer.OrdinalIgnoreCase)
        };

        var window = sorted.ToWindow(request);

        if (searchChanged)
            StateHasChanged();

        return Task.FromResult(window);
    }

    /// <summary>
    /// Whether any of the page's own chip filters is narrowing the attribute list, so the empty state can tell
    /// "nothing matches what you chose" apart from "this object type has no attributes".
    /// </summary>
    private bool AnySchemaFilterIsActive =>
        AttributeClassFilterSelectedValues.Count > 0 || _selectedSchemaTypes.Count > 0 ||
        _selectedSchemaPluralites.Count > 0 || _selectedSchemaWritabilities.Count > 0;

    /// <summary>
    /// Reloads the attribute grid after the page's own filters, or the attributes themselves, have changed. The
    /// totals are invalidated because the match set is a different one, and the reader is returned to the top
    /// because the position they held described rows that may no longer be there.
    /// </summary>
    private async Task RefreshAttributeGridAsync()
    {
        if (_attributeGrid == null)
            return;

        await _attributeGrid.ResetScrollAsync();
        await _attributeGrid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Handles a selection switch being toggled. Selecting changes which rows match only while the Selected Only
    /// filter is on, which is the one case that needs the window re-fetching; otherwise the row simply re-renders
    /// where it is, and reloading would throw the reader's scroll position away for nothing.
    /// </summary>
    private async Task OnAttributeSelectedChangedAsync()
    {
        if (_attributeSelectedFilter)
            await RefreshAttributeGridAsync();
    }

    private async Task HandleImportSchemaAsync()
    {
        // attribute the import to the user
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        _schemaBeingRetrieved = true;
        _schemaRefreshResult = null; // Clear any previous result
        StateHasChanged();
        await Task.Delay(1);

        try
        {
            _schemaRefreshResult = await jim.ConnectedSystems.ImportConnectedSystemSchemaAsync(ConnectedSystem, user);

            // A single, newly-discovered object type is auto-selected and persisted server-side (see
            // ImportConnectedSystemSchemaAsync); the reload below surfaces it, and OnParametersSet binds it as
            // the active object type so the admin lands straight on attribute selection.
            await OnConnectedSystemChanged.InvokeAsync();
        }
        catch (CsvParsingException ex)
        {
            await ShowCsvErrorDialogAsync(ex);
            _schemaRefreshResult = SchemaRefreshResult.Failed(ex.Message);
        }
        catch (Exception ex)
        {
            Log.Error(ex, "Failed to import schema for Connected System {SystemId}", ConnectedSystem.Id);
            _schemaRefreshResult = SchemaRefreshResult.Failed(ex.Message);
        }
        finally
        {
            _schemaBeingRetrieved = false;
            StateHasChanged();
            await Task.Delay(1);
        }
    }

    private void HandleCloseSchemaRefreshResult()
    {
        _schemaRefreshResult = null;
        StateHasChanged();
    }

    private void HandleSelectedObjectTypeClick(ConnectedSystemObjectType connectedSystemObjectType, bool isObjectTypeChecked)
    {
        // actuate the state change
        connectedSystemObjectType.Selected = isObjectTypeChecked;

        // now cascade
        // if only one type is selected, make that the selected object type
        // if none are selected, clear selected object type
        // if the selected type is being de-selected, null the selected type
        if (ConnectedSystem.ObjectTypes != null && ConnectedSystem.ObjectTypes.Count(q => q.Selected) == 1)
            _selectedObjectType = ConnectedSystem.ObjectTypes.Single(q => q.Selected);
        else if (ConnectedSystem.ObjectTypes == null || ConnectedSystem.ObjectTypes.Count(q => q.Selected) == 0)
            _selectedObjectType = null;
        else if (_selectedObjectType != null && _selectedObjectType.Id == connectedSystemObjectType.Id && !isObjectTypeChecked)
            _selectedObjectType = null;

        // some parts of the UI only make sense if the attributes have classes
        _selectedObjectTypeHasClasses = connectedSystemObjectType.Attributes.Any(q => q.ClassName != null);
        _selectedObjectTypeHasDescriptions = connectedSystemObjectType.Attributes.Any(q => q.Description != null);
    }

    /// <summary>
    /// The selected object types, ordered by name. This is the ordering used to render the per-type sub-tabs, so the
    /// tab at index N+1 corresponds to GetSelectedObjectTypes()[N] (index 0 is the "Object Types" discovery tab).
    /// </summary>
    private List<ConnectedSystemObjectType> GetSelectedObjectTypes() =>
        ConnectedSystem.ObjectTypes?.Where(ot => ot.Selected).OrderBy(ot => ot.Name).ToList() ?? new List<ConnectedSystemObjectType>();

    /// <summary>
    /// The object types the discovery grid will consider before the administrator's own search and All / Selected
    /// filter narrow it further: everything the Connected System reported, less the ones it classified as internal.
    /// </summary>
    /// <remarks>
    /// A directory publishes its own configuration and operational classes in the same schema as the classes an
    /// administrator manages; on a stock OpenLDAP those account for well over a third of what is discovered. Hiding
    /// them is presentation only: they are still imported, still stored, and one click away.
    /// <para>
    /// A Selected object type is never hidden, whatever its classification. An administrator who has deliberately
    /// chosen to manage a class must always be able to see that they have.
    /// </para>
    /// </remarks>
    private IEnumerable<ConnectedSystemObjectType> GetVisibleObjectTypes()
    {
        var objectTypes = ConnectedSystem.ObjectTypes?.AsEnumerable() ?? Enumerable.Empty<ConnectedSystemObjectType>();
        return _showInternalObjectTypes ? objectTypes : objectTypes.Where(ot => ot.Selected || !ot.IsInternal());
    }

    /// <summary>
    /// How many internal object types the current view is holding back, which is what the disclosure below the grid
    /// reports. Zero while internal types are being shown.
    /// </summary>
    private int GetHiddenInternalObjectTypeCount()
    {
        return _showInternalObjectTypes
            ? 0
            : ConnectedSystem.ObjectTypes?.Count(ot => !ot.Selected && ot.IsInternal()) ?? 0;
    }

    /// <summary>
    /// Whether the Connected System reported any internal object types at all. Distinguishes "none are hidden
    /// because they are being shown" from "none are hidden because there are none", so the way back is only offered
    /// where there is something to go back to.
    /// </summary>
    private bool AnyInternalObjectTypes()
    {
        return ConnectedSystem.ObjectTypes?.Any(ot => ot.IsInternal()) ?? false;
    }

    /// <summary>
    /// The object types shown in the discovery grid, after applying the name search and the All / Selected filter.
    /// Selected types are ordered first so the current selection stays visible as the list is filtered.
    /// </summary>
    private IEnumerable<ConnectedSystemObjectType> GetFilteredDiscoveryObjectTypes()
    {
        var objectTypes = GetVisibleObjectTypes();

        if (_objectTypeSelectedFilter)
            objectTypes = objectTypes.Where(ot => ot.Selected);

        if (!string.IsNullOrWhiteSpace(_objectTypeSearchString))
            objectTypes = objectTypes.Where(ot => ot.Name.Contains(_objectTypeSearchString.Trim(), StringComparison.OrdinalIgnoreCase));

        return objectTypes.OrderByDescending(ot => ot.Selected).ThenBy(ot => ot.Name);
    }

    /// <summary>
    /// Keeps the active sub-tab and the active object type in sync. Index 0 is the "Object Types" discovery tab (no
    /// active object type); indexes 1..n map onto the per-type sub-tabs in GetSelectedObjectTypes() order.
    /// </summary>
    private void OnSchemaTabChanged(int index)
    {
        _activeSchemaTabIndex = index;

        var selected = GetSelectedObjectTypes();
        _selectedObjectType = index >= 1 && index - 1 < selected.Count ? selected[index - 1] : null;
        RecomputeSelectedObjectTypeFlags();
        UpdateObjectTypeQueryString();
    }

    /// <summary>
    /// Recomputes the flags that drive which optional columns and controls the attribute table shows, for the
    /// currently active object type. No-op when no object type is active (the discovery tab).
    /// </summary>
    private void RecomputeSelectedObjectTypeFlags()
    {
        if (_selectedObjectType == null)
            return;

        _selectedObjectTypeHasClasses = _selectedObjectType.Attributes.Any(q => q.ClassName != null);
        _selectedObjectTypeHasDescriptions = _selectedObjectType.Attributes.Any(q => q.Description != null);
        _selectedObjectTypeHasConstrainedAttributes = _selectedObjectType.Attributes.Any(q => q.Writability != AttributeWritability.Writable);
    }

    /// <summary>
    /// Handles toggling an object type's selection from the discovery grid. Selecting is immediate; deselecting is
    /// confirmed first, because removing a type discards its attribute selection and configuration, which can
    /// represent significant effort. The grid switch is read-only/presentational, so nothing changes until this
    /// runs: cancelling simply leaves the type selected.
    /// </summary>
    private async Task HandleObjectTypeGridToggleAsync(ConnectedSystemObjectType connectedSystemObjectType, bool isSelected)
    {
        if (isSelected)
        {
            HandleSelectedObjectTypeClick(connectedSystemObjectType, true);
            return;
        }

        if (!await ConfirmObjectTypeRemovalAsync(connectedSystemObjectType))
            return;

        HandleSelectedObjectTypeClick(connectedSystemObjectType, false);
    }

    /// <summary>
    /// Asks the admin to confirm removing an object type from those JIM manages, spelling out that the type's
    /// attribute selection and configuration will be discarded. Returns true only if they confirm.
    /// </summary>
    private async Task<bool> ConfirmObjectTypeRemovalAsync(ConnectedSystemObjectType connectedSystemObjectType)
    {
        // HTML-encode the name: it is interpolated into a MarkupString, which bypasses Razor's auto-encoding.
        var encodedName = System.Net.WebUtility.HtmlEncode(connectedSystemObjectType.Name);
        var options = new MessageBoxOptions
        {
            Title = "Remove object type?",
            MarkupMessage = (MarkupString)$"Remove <code class=\"jim-code-inline\">{encodedName}</code> from the object types JIM manages? This clears its attribute selection and configuration for this Connected System. You can add it again later, but you will need to reconfigure it.",
            YesText = "Remove",
            CancelText = "Cancel"
        };

        var confirmed = await DialogService.ShowMessageBoxAsync(options);
        return confirmed == true;
    }

    private async Task HandleMakeExternalIdAsync(ConnectedSystemObjectTypeAttribute selectedAttribute)
    {
        if (_selectedObjectType == null)
        {
            Log.Error($"Schema Tab > HandleMakeExternalIdAsync: {nameof(_selectedObjectType)} is null!");
            return;
        }

        // make sure there's not already an attribute marked as the external id
        foreach (var attribute in _selectedObjectType.Attributes.Where(a => a.IsExternalId))
            attribute.IsExternalId = false;

        // mark the intended attribute as the external id, and select it
        selectedAttribute.IsExternalId = true;
        selectedAttribute.Selected = true;
        Log.Verbose($"Schema Tab > HandleMakeExternalIdAsync: Set attribute id {selectedAttribute} as the external id.");

        // two rows changed (the old External ID lost the marker, the new one gained it and became selected), and
        // either can be outside the window on screen, so the grid re-reads rather than being left partly stale.
        await RefreshAttributeGridAsync();
    }

    private async Task HandleObjectTypesAndAttributeSelectionSubmitAsync()
    {
        // attribute the update to the user
        using var jim = JimFactory.Create();

        // deselecting an Object Type obsoletes every Connected System Object imported from it, and deprovisions
        // whatever they are joined to. Until now that saved silently; ask the administrator to acknowledge it first.
        var preflight = await jim.ConfigurationChangePreflight.EvaluateConnectedSystemAsync(ConnectedSystem);
        if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                "Connected System", ConnectedSystem.Name))
            return;

        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.ConnectedSystems.UpdateConnectedSystemSchemaAsync(ConnectedSystem, user);
        Snackbar.Add("Your attribute changes have been saved.", Severity.Success);

        await OnConnectedSystemChanged.InvokeAsync();
    }

    private bool SchemaFilterFuncHandler(ConnectedSystemObjectTypeAttribute element) =>
        SchemaFilterFunc(element, _schemaSearchString, AttributeClassFilterSelectedValues, _attributeSelectedFilter, _selectedSchemaTypes, _selectedSchemaPluralites, _selectedSchemaWritabilities);

    private static bool SchemaFilterFunc(
        ConnectedSystemObjectTypeAttribute element,
        string searchString,
        IReadOnlyCollection<string> attributeClassFilterSelectedValues,
        bool attributeSelectedFilter,
        IReadOnlyCollection<AttributeDataType> selectedTypes,
        IReadOnlyCollection<AttributePlurality> selectedPluralites,
        IReadOnlyCollection<AttributeWritability> selectedWritabilities)
    {
        // All filters must pass (AND logic)
        var classHashset = (HashSet<string>)attributeClassFilterSelectedValues;

        // Filter by "show only selected" checkbox
        if (attributeSelectedFilter && !element.Selected)
            return false;

        // Filter by name search string
        if (!string.IsNullOrEmpty(searchString) && !element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return false;

        // Filter by class selection
        if (classHashset.Count > 0 && !classHashset.Any(q => q == element.ClassName))
            return false;

        // Filter by type selection
        if (selectedTypes.Count > 0 && !selectedTypes.Contains(element.Type))
            return false;

        // Filter by plurality selection
        if (selectedPluralites.Count > 0 && !selectedPluralites.Contains(element.AttributePlurality))
            return false;

        // Filter by writability selection
        if (selectedWritabilities.Count > 0 && !selectedWritabilities.Contains(element.Writability))
            return false;

        return true;
    }

    private async Task OnSchemaTypeFilterChangedAsync(IReadOnlyCollection<AttributeDataType> selectedTypes)
    {
        _selectedSchemaTypes = selectedTypes;
        await RefreshAttributeGridAsync();
    }

    private async Task OnSchemaPluralityFilterChangedAsync(IReadOnlyCollection<AttributePlurality> selectedPluralites)
    {
        _selectedSchemaPluralites = selectedPluralites;
        await RefreshAttributeGridAsync();
    }

    private async Task OnSchemaClassFilterChangedAsync()
    {
        await RefreshAttributeGridAsync();
    }

    private async Task OnAttributeSelectedFilterChangedAsync(bool selectedOnly)
    {
        _attributeSelectedFilter = selectedOnly;
        await RefreshAttributeGridAsync();
    }

    private IEnumerable<KeyValuePair<AttributeDataType, int>> GetAvailableSchemaTypes()
    {
        if (_selectedObjectType == null)
            return Enumerable.Empty<KeyValuePair<AttributeDataType, int>>();

        // Apply all filters EXCEPT type filter to get contextual counts
        var filteredAttributes = _selectedObjectType.Attributes
            .Where(a => SchemaFilterFunc(a, _schemaSearchString, AttributeClassFilterSelectedValues, _attributeSelectedFilter,
                new List<AttributeDataType>(), _selectedSchemaPluralites, _selectedSchemaWritabilities));

        return filteredAttributes
            .GroupBy(a => a.Type)
            .Select(g => new KeyValuePair<AttributeDataType, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key.ToString());
    }

    private IEnumerable<KeyValuePair<AttributePlurality, int>> GetAvailableSchemaPluralites()
    {
        if (_selectedObjectType == null)
            return Enumerable.Empty<KeyValuePair<AttributePlurality, int>>();

        // Apply all filters EXCEPT plurality filter to get contextual counts
        var filteredAttributes = _selectedObjectType.Attributes
            .Where(a => SchemaFilterFunc(a, _schemaSearchString, AttributeClassFilterSelectedValues, _attributeSelectedFilter,
                _selectedSchemaTypes, new List<AttributePlurality>(), _selectedSchemaWritabilities));

        return filteredAttributes
            .GroupBy(a => a.AttributePlurality)
            .Select(g => new KeyValuePair<AttributePlurality, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key);
    }

    private IEnumerable<KeyValuePair<AttributeWritability, int>> GetAvailableSchemaWritabilities()
    {
        if (_selectedObjectType == null)
            return Enumerable.Empty<KeyValuePair<AttributeWritability, int>>();

        // Apply all filters EXCEPT writability filter to get contextual counts
        var filteredAttributes = _selectedObjectType.Attributes
            .Where(a => SchemaFilterFunc(a, _schemaSearchString, AttributeClassFilterSelectedValues, _attributeSelectedFilter,
                _selectedSchemaTypes, _selectedSchemaPluralites, new List<AttributeWritability>()));

        return filteredAttributes
            .GroupBy(a => a.Writability)
            .Select(g => new KeyValuePair<AttributeWritability, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key);
    }

    private async Task OnSchemaWritabilityFilterChangedAsync(IReadOnlyCollection<AttributeWritability> selectedWritabilities)
    {
        _selectedSchemaWritabilities = selectedWritabilities;
        await RefreshAttributeGridAsync();
    }

    private (int allCount, int selectedCount) GetSchemaSelectionCounts()
    {
        if (_selectedObjectType == null)
            return (0, 0);

        // Apply all filters EXCEPT selection filter to get contextual counts
        var filteredAttributes = _selectedObjectType.Attributes
            .Where(a => SchemaFilterFunc(a, _schemaSearchString, AttributeClassFilterSelectedValues, false,
                _selectedSchemaTypes, _selectedSchemaPluralites, _selectedSchemaWritabilities))
            .ToList();

        return (filteredAttributes.Count, filteredAttributes.Count(a => a.Selected));
    }

    private async Task HandleAttributeCsvSubmitAsync()
    {
        if (_selectedObjectType == null)
        {
            Console.WriteLine($"{nameof(HandleAttributeCsvSubmitAsync)}: connectedSystem was null");
            return;
        }

        if (string.IsNullOrEmpty(_attributeSelectionCsv))
        {
            Console.WriteLine($"{nameof(HandleAttributeCsvSubmitAsync)}: attributeSelectionCsv is null or empty");
            return;
        }

        // clear the other filters, so the attributes just selected are all visible. The name search belongs to the
        // grid now, so it is cleared through the grid (which also reloads the window).
        ((HashSet<string>)AttributeClassFilterSelectedValues).Clear();
        if (_attributeGrid != null)
            await _attributeGrid.ClearSearchAsync();

        // convert the csv to a list, trim the entries, and resolve each to an attribute on the object type
        var matchedAttributes = _attributeSelectionCsv.Split(',')
            .Select(name => _selectedObjectType.Attributes.SingleOrDefault(a => a.Name.Equals(name.Trim(), StringComparison.OrdinalIgnoreCase)))
            .Where(a => a != null)
            .Select(a => a!)
            .ToList();

        // credential attributes are skipped: this path bypasses the table's disabled switch, so it needs its own guard
        var skippedCredentialAttributes = matchedAttributes
            .Where(a => CredentialAttributes.IsCredentialAttribute(a.Name))
            .Select(a => a.Name)
            .ToList();

        foreach (var attribute in matchedAttributes.Where(a => !CredentialAttributes.IsCredentialAttribute(a.Name)))
            attribute.Selected = true;

        // filter by selected
        _attributeSelectedFilter = true;

        // clear the attribute csv text box
        _attributeSelectionCsv = null;

        await RefreshAttributeGridAsync();

        // all done, let the user know
        Snackbar.Add("Attributes selected.", Severity.Success);

        if (skippedCredentialAttributes.Count > 0)
            Snackbar.Add($"Skipped {string.Join(", ", skippedCredentialAttributes)}: credential attributes cannot be managed by JIM. Passwords are synchronised through JIM's dedicated password channel, not through Attribute Flow.", Severity.Warning);
    }

    private bool DisableSelectedSchemaObjectType(ConnectedSystemObjectType connectedSystemObjectType)
    {
        if (_selectedObjectType == null)
            return false;

        if (connectedSystemObjectType.Id.Equals(_selectedObjectType.Id))
            return true; // BOTH IDS ARE 0 WHEN THEY'RE DIFFERENT TYPES! HOW?! - BECAUSE THEY HAVEN'T BEEN PERSISTED YET!

        return false;
    }

    /// <summary>
    /// Determines whether the Save Schema changes button should be disabled or not.
    /// </summary>
    private bool DisableSaveSchemaButton()
    {
        // must select at least one object type
        // all selected object types must have an external id selected

        if (ConnectedSystem.ObjectTypes == null)
            return true;

        var objectTypesSelected = ConnectedSystem.ObjectTypes.Any(ot => ot.Selected);
        var externalIdsSet = ConnectedSystem.ObjectTypes.Where(ot => ot.Selected).All(ot => ot.Attributes.Any(a => a.IsExternalId));

        return !objectTypesSelected || !externalIdsSet;
    }

    private async Task HandleShowEditAttributeDialogAsync(ConnectedSystemObjectTypeAttribute connectedSystemObjectTypeAttribute)
    {
        // can the Connected System attribute be edited? are there any references to it?
        using var jim = JimFactory.Create();
        _objectTypeAttributeBeingEditedIsEditable = !await jim.ConnectedSystems.IsObjectTypeAttributeBeingReferencedAsync(connectedSystemObjectTypeAttribute);
        _objectTypeAttributeBeingEdited = connectedSystemObjectTypeAttribute;
        _objectTypeAttributeBeingEditedText = connectedSystemObjectTypeAttribute.Type.ToString();
        _editSchemaAttributeDialogVisible = true;
    }

    private async Task HandleEditAttributeDataTypeButtonClickAsync()
    {
        if (_objectTypeAttributeBeingEdited == null)
            return;

        if (_objectTypeAttributeBeingEditedText == null)
            return;

        _objectTypeAttributeBeingEdited.Type = (AttributeDataType)Enum.Parse(typeof(AttributeDataType), _objectTypeAttributeBeingEditedText);

        // Marks the type as the administrator's rather than the Connector's, so the next schema refresh
        // leaves it alone instead of silently restoring what discovery inferred (#1354).
        _objectTypeAttributeBeingEdited.TypeSetByAdministrator = true;

        _editSchemaAttributeDialogVisible = false;

        // the Type chip filters are contextual and the row may no longer match the chosen ones, so the window is
        // re-read rather than left showing an attribute under a type it no longer has.
        await RefreshAttributeGridAsync();

        // all done, let the user know
        Snackbar.Add("Attribute data type updated. Save your changes to apply it.", Severity.Success);
    }

    private async Task ShowCsvErrorDialogAsync(CsvParsingException ex)
    {
        var parameters = new DialogParameters<CsvErrorDialog>
        {
            { x => x.ErrorMessage, ex.Message },
            { x => x.RowNumber, ex.RowNumber },
            { x => x.ColumnInfo, ex.ColumnInfo },
            { x => x.RawData, ex.RawRow },
            { x => x.Suggestion, ex.Suggestion }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        await DialogService.ShowAsync<CsvErrorDialog>("CSV Parsing Error", parameters, options);
    }
}
