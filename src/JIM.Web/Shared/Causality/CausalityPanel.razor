@* The causality visualisation panel for a Run Profile Execution Item. Owns the current view, the
   Timeline's expanded event and the Lineage's selected event (whose attribute detail renders in the
   shared bottom drawer); builds the causality and lineage models and the summary once per
   (Item, Context, Chain) tuple and renders the summary band (whose head row carries the view switcher
   in its Actions slot), the active view and the drawer. The persisted view preference loads on first
   render per the TableDensityToggle idiom; the Lineage is the default, and a stored preference for an
   unknown or retired view (the old Flow and Graph keys included) falls back to it without being
   overwritten. Every event is named once, in the portal's own vocabulary: JIM does not rename its
   product nouns, and it does not carry a second, more technical name beside them either. The causal
   chain renders on the Lineage itself (#1495); the separate Caused by list retired with the Flow and
   Graph views. *@

<div class="causality-panel @(_model?.IsSpeculative == true ? "speculative" : null)">
    @* An export held for a decision about a generated value (#242, release 4) records nothing because nothing was
       exported: it is not missing tracking, and its band says why it is held. *@
    @if (Item != null && Item.SyncOutcomes.Count == 0 && Item.ErrorType != ActivityRunProfileExecutionItemErrorType.GeneratedValueCollisionUnresolved)
    {
        <div class="pa-4">
            <MudAlert Severity="Severity.Info">
                Outcome tracking was not enabled when this activity was recorded.
                Only the operation type is available.
            </MudAlert>
        </div>
    }
    else if (_model != null && _summary != null)
    {
        @if (_model.IsSpeculative)
        {
            <div class="preview-band">
                <span class="preview-pill">Preview</span>
                <span class="preview-text">
                    <strong>Nothing has been changed.</strong>
                    @if ((Context.CsoConnectedSystemName ?? Context.ConnectedSystemName) is { } previewSystemName)
                    {
                        <text>&#32;What a Full Synchronisation of @previewSystemName would do to this object now.</text>
                    }
                    else
                    {
                        <text>&#32;What every enabled export Synchronisation Rule would do with this Metaverse Object as it stands now.</text>
                    }
                </span>
                @if (OnClose.HasDelegate)
                {
                    <button type="button" class="preview-close" aria-label="Close preview" @onclick="OnClose">&#x2715;</button>
                }
            </div>
        }
        @if (!LineageOnly)
        {
            <CausalitySummaryBand Summary="_summary" Context="Context" Timestamp="Timestamp" StatusTone="GetStatusTone()"
                                  IsSpeculative="_model.IsSpeculative"
                                  AfterThisRunPills="_lineageModel?.Consequences?.Pills"
                                  OnAfterThisRunSelected="AfterThisRunSelected">
                <Actions>
                    @if (ExplorerHref != null)
                    {
                        <MudButton Variant="Variant.Filled" DropShadow="false"
                                   StartIcon="@Icons.Material.Filled.Hub" Href="@ExplorerHref"
                                   Class="jim-causality-open-explorer">Open in explorer</MudButton>
                    }
                    @if (AvailableViews.Count > 1)
                    {
                        <SegmentedToggle TValue="CausalityView" Options="ViewOptions" Value="_view" ValueChanged="SelectViewAsync"
                                         AriaLabel="Causality view" Class="seg" />
                    }
                </Actions>
            </CausalitySummaryBand>
        }

        <div class="canvas-wrap">
            @switch (_view)
            {
                case CausalityView.Lineage when _lineageModel is { } lineageModel:
                    <CausalityLineageView Model="lineageModel"
                                        Timestamp="Timestamp" @bind-SelectedEvent="_selectedEvent"
                                        ConsequencesLoading="ConsequencesLoading"
                                        OnCheckAgain="OnCheckConsequencesAgain"
                                        LoadConsequenceMembers="LoadConsequenceMembers" />
                    break;
                case CausalityView.Table when _tableModel is { } tableModel:
                    <CausalityTableView Model="tableModel" OnViewAllAttributeChanges="ViewAllAttributeChanges" />
                    break;
                case CausalityView.Timeline:
                default:
                    <CausalityTimelineView Model="_model" LoadAttributeRows="LoadAttributeRows"
                                           @bind-ExpandedEvent="_expandedEvent" />
                    break;
            }
        </div>

        @* ─── Bottom drawer: attribute detail for the Lineage's selected event ─── *@
        @if (_view != CausalityView.Timeline && _selectedEvent is { } selectedEvent && selectedEvent.AttributeRowCount > 0)
        {
            <div class="drawer">
                <div class="drawer-inner">
                    <div class="drawer-head">
                        <span class="drawer-title">@selectedEvent.Label</span>
                        <span class="drawer-sub">@GetDrawerSubtitle(selectedEvent)</span>
                        <button type="button" class="drawer-close" aria-label="Close detail"
                                @onclick="CloseDrawer">&#x2715;</button>
                    </div>
                    @* Keyed on the event so the detail's filter state resets when another card is selected *@
                    @* An event with a rows caption is naming what its rows are rather than counting changes,
                       so those rows carry no meaningful operation to show. *@
                    <CausalityAttributeDetail @key="selectedEvent" Rows="selectedEvent.AttributeRows"
                                              Source="selectedEvent.AttributeRowSource"
                                              Summary="selectedEvent.AttributeRowSummary"
                                              LoadAttributeRows="LoadAttributeRows"
                                              ShowOperations="@(selectedEvent.AttributeRowsCaption == null)" />
                </div>
            </div>
        }
    }
</div>

@code {
    /// <summary>
    /// The views implemented for a recorded item, in switcher order. A stored preference only takes
    /// effect when its view appears here.
    /// </summary>
    private static readonly IReadOnlyList<CausalityView> RecordedViews =
        [CausalityView.Lineage, CausalityView.Timeline, CausalityView.Table];

    /// <summary>
    /// A speculative model offers Timeline and Table, never Lineage (#1519): <see cref="CausalityLineageModelBuilder.Build"/>
    /// needs a recorded item's <c>ObjectChangeType</c> to decide which side of the join the page's own
    /// record sits on, which a Sync Preview has no equivalent of. Rather than guess at one and risk
    /// drawing the join backwards (#1528 was exactly this class of bug), the Lineage is not offered at
    /// all for a preview; the Timeline and Table (#1519 Phase 3) need no such fact and render the tree
    /// directly.
    /// </summary>
    private static readonly IReadOnlyList<CausalityView> SpeculativeViews = [CausalityView.Timeline, CausalityView.Table];

    /// <summary>
    /// The Lineage alone, for the Causality Explorer (#2100); see <see cref="LineageOnly"/>.
    /// </summary>
    private static readonly IReadOnlyList<CausalityView> LineageOnlyViews = [CausalityView.Lineage];

    private IReadOnlyList<CausalityView> AvailableViews => _model?.IsSpeculative == true
        ? SpeculativeViews
        : LineageOnly ? LineageOnlyViews : RecordedViews;

    private IReadOnlyList<SegmentedToggleOption<CausalityView>> ViewOptions =>
        AvailableViews.Select(view => new SegmentedToggleOption<CausalityView>(view, GetViewLabel(view))).ToList();

    /// <summary>
    /// The Run Profile Execution Item whose causality is visualised. Required for the recorded path;
    /// leave unset when <see cref="PreviewResult"/> is supplied instead.
    /// </summary>
    [Parameter]
    public ActivityRunProfileExecutionItem? Item { get; set; }

    /// <summary>
    /// A Sync Preview result to render speculatively (#1519, D-S1) instead of a recorded
    /// <see cref="Item"/>. When set, the panel builds its model via
    /// <see cref="CausalityModelBuilder.BuildSpeculative"/>, shows the "Preview" band, offers Timeline
    /// only (see <see cref="SpeculativeViews"/>), and every label reads in the conditional mood.
    /// </summary>
    [Parameter]
    public SyncPreviewResult? PreviewResult { get; set; }

    /// <summary>
    /// Raised when the preview band's close button is clicked. No-op (button hidden) when the host
    /// does not wire a handler; used by the Connected System Object and Metaverse Object detail pages
    /// to dismiss the inline panel after a Sync Preview.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// The page-level context (run, Connected System, record and Metaverse Object Type names) used
    /// for sentence composition and link building.
    /// </summary>
    [Parameter, EditorRequired]
    public CausalityPageContext Context { get; set; } = null!;

    /// <summary>
    /// The Pending Exports this item created that are still queued, or null when the host page did
    /// not resolve them (in which case every Pending Export link stays precise). Pending Export rows
    /// are deleted once exported, so this is what lets a link degrade to the target system's queue
    /// rather than 404. Pass the same instance across renders; a new set rebuilds the model and drops
    /// the expanded and selected event.
    /// </summary>
    [Parameter]
    public IReadOnlySet<Guid>? LivePendingExportIds { get; set; }

    /// <summary>
    /// The execution timestamp (UTC) shown in the summary band.
    /// </summary>
    [Parameter]
    public DateTime? Timestamp { get; set; }

    /// <summary>
    /// The upward causal walk for this item, or null when the host page did not resolve one. Owned by
    /// the page rather than fetched here: the panel is a rendering component with no data access of
    /// its own, and the walk is one query the page already has an application scope open for. Feeds
    /// the Lineage's chain cards and the export decision captions (#1495).
    /// </summary>
    [Parameter]
    public CausalChain? Chain { get; set; }

    /// <summary>
    /// The item's change values (#2498): each change record's summary and the rows of the small ones; see
    /// <see cref="CausalityModelBuilder.Build"/>. Null for none, as with a hand-built item.
    /// </summary>
    [Parameter]
    public CausalityChangeValues? ChangeValues { get; set; }

    /// <summary>
    /// Reads a window of an event's attribute rows where there were too many to carry (#2498); supplied by the host,
    /// as <see cref="LoadConsequenceMembers"/> is, so the panel has no data access of its own.
    /// </summary>
    [Parameter]
    public Func<CausalityAttributeRowSource, JIM.Models.Utility.ChangeValueRowQuery, Task<JIM.Models.Utility.RangeResultSet<CausalityAttributeRow>>>? LoadAttributeRows { get; set; }

    /// <summary>
    /// The decision-time Metaverse Object deletion policy recorded on the item, where one was captured. Supplies
    /// the synthetic "Metaverse Object not deleted" event, which is the one thing a Deletion Rule's decision leaves no
    /// outcome to render.
    /// </summary>
    [Parameter]
    public MvoDeletionPolicySnapshot? DeletionPolicySnapshot { get; set; }

    /// <summary>
    /// Whether the Run Profile behind this item was a Full or Delta Synchronisation. Only a Synchronisation
    /// evaluates a Deletion Rule, so only a Synchronisation can report that one declined.
    /// </summary>
    [Parameter]
    public bool IsSynchronisationRun { get; set; }

    /// <summary>
    /// What the item went on to cause (#1811), or null while the page has not read it. Owned by the page for the same
    /// reason as <see cref="Chain"/>; it arrives after the first render, and its arrival rebuilds only the Lineage, so a
    /// card the reader has already selected stays selected.
    /// </summary>
    [Parameter]
    public CausalConsequences? Consequences { get; set; }

    /// <summary>
    /// The item's follow-ups (#2668): work it set in motion that finishes after its run, shown in its own record's After
    /// this run section. Null or empty shows none.
    /// </summary>
    [Parameter]
    public IReadOnlyList<JIM.Web.Models.ExecutionItemFollowUpDisplay>? FollowUps { get; set; }

    /// <summary>
    /// Whether the page is still reading <see cref="Consequences"/>.
    /// </summary>
    [Parameter]
    public bool ConsequencesLoading { get; set; }

    /// <summary>
    /// Raised by the Lineage footer's Check again, which reads the consequences afresh.
    /// </summary>
    [Parameter]
    public EventCallback OnCheckConsequencesAgain { get; set; }

    /// <summary>
    /// Pages a consequence cohort's members, by cohort key, page from 1, and find-box text.
    /// </summary>
    [Parameter]
    public Func<string, int, string?, Task<JIM.Models.Utility.PagedResultSet<CausalConsequenceMember>?>>? LoadConsequenceMembers { get; set; }

    /// <summary>
    /// Shows the Lineage alone, as the Causality Explorer does (#2100): no summary band, since the explorer's own header
    /// says what is in view, and no view switcher, since the Timeline and Table stay on the item page.
    /// </summary>
    [Parameter]
    public bool LineageOnly { get; set; }

    /// <summary>
    /// The Causality Explorer's address for this item (#2100), where the host offers to follow its Lineage there in place;
    /// null where it does not, as the explorer itself does not.
    /// </summary>
    [Parameter]
    public string? ExplorerHref { get; set; }

    private CausalityModel? _model;
    private CausalitySummary? _summary;
    private CausalityLineageModel? _lineageModel;
    private CausalityTableModel? _tableModel;
    private CausalityView _view = CausalityView.Lineage;
    private CausalityEvent? _expandedEvent;
    private CausalityEvent? _selectedEvent;
    private ActivityRunProfileExecutionItem? _builtItem;
    private SyncPreviewResult? _builtPreviewResult;
    private CausalityPageContext? _builtContext;
    private IReadOnlySet<Guid>? _builtLivePendingExportIds;
    private CausalChain? _builtChain;
    private CausalityChangeValues? _builtChangeValues;
    private CausalConsequences? _builtConsequences;

    protected override void OnParametersSet()
    {
        // The consequences arrive on their own, after the first render (#1811): only the Lineage depends on them, so their
        // arrival rebuilds the Lineage alone and keeps whatever the reader has expanded or selected.
        if (!ReferenceEquals(Consequences, _builtConsequences)
            && ReferenceEquals(Item, _builtItem) && ReferenceEquals(PreviewResult, _builtPreviewResult)
            && Equals(Context, _builtContext)
            && ReferenceEquals(LivePendingExportIds, _builtLivePendingExportIds)
            && ReferenceEquals(Chain, _builtChain)
            && ReferenceEquals(ChangeValues, _builtChangeValues))
        {
            _builtConsequences = Consequences;
            if (Item != null && _model != null && PreviewResult == null)
                _lineageModel = CausalityLineageModelBuilder.Build(_model, Chain, Item.ObjectChangeType, Consequences, FollowUps);
            return;
        }

        // Build once per (Item, PreviewResult, Context, Chain) tuple; parent re-renders with unchanged
        // values must not discard the expanded/selected-event state by rebuilding the model. The chain
        // is an input (#1495): it supplies the export decision captions and the Lineage's chain cards,
        // and the page resolves it after the first render, so its arrival must rebuild.
        if (ReferenceEquals(Item, _builtItem) && ReferenceEquals(PreviewResult, _builtPreviewResult)
            && Equals(Context, _builtContext)
            && ReferenceEquals(LivePendingExportIds, _builtLivePendingExportIds)
            && ReferenceEquals(Chain, _builtChain)
            && ReferenceEquals(ChangeValues, _builtChangeValues))
            return;

        _builtItem = Item;
        _builtPreviewResult = PreviewResult;
        _builtContext = Context;
        _builtLivePendingExportIds = LivePendingExportIds;
        _builtChain = Chain;
        _builtChangeValues = ChangeValues;
        _builtConsequences = Consequences;

        if (PreviewResult != null)
        {
            _model = CausalityModelBuilder.BuildSpeculative(PreviewResult, Context);
            _summary = CausalitySummaryBuilder.Build(_model);
            // No chain, no Lineage: see SpeculativeViews' doc comment.
            _lineageModel = null;
            _tableModel = CausalityTableModelBuilder.Build(_model);
            _view = CausalityView.Timeline;
        }
        else if (Item != null)
        {
            _model = CausalityModelBuilder.Build(Item, Context, LivePendingExportIds,
                DeletionPolicySnapshot, IsSynchronisationRun, Chain, ChangeValues);
            _summary = CausalitySummaryBuilder.Build(_model);
            _lineageModel = CausalityLineageModelBuilder.Build(_model, Chain, Item.ObjectChangeType, Consequences, FollowUps);
            _tableModel = CausalityTableModelBuilder.Build(_model);
        }
        else
        {
            _model = null;
            _summary = null;
            _lineageModel = null;
            _tableModel = null;
        }

        _expandedEvent = null;
        _selectedEvent = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The explorer shows the Lineage whatever the reader last chose on an item page, and leaves that choice alone.
        if (!firstRender || LineageOnly)
            return;

        // No try/catch needed: the preference service swallows JS interop unavailability internally
        var storedView = CausalityViewPreference.FromKey(await PreferenceService.GetCausalityViewAsync());

        // A stored preference for an unknown or retired view keeps the default without overwriting
        // the stored value; the old Flow and Graph keys land here deliberately (#1495)
        if (storedView.HasValue && AvailableViews.Contains(storedView.Value))
            _view = storedView.Value;

        StateHasChanged();
    }

    private async Task SelectViewAsync(CausalityView view)
    {
        _view = view;
        _selectedEvent = null;
        await PreferenceService.SetCausalityViewAsync(CausalityViewPreference.ToKey(view));
    }

    /// <summary>
    /// Choosing an After this run pill opens the Lineage, the one view that shows consequences; once it is showing, the
    /// pills have nowhere further to go and are left unclickable.
    /// </summary>
    private EventCallback AfterThisRunSelected => _view != CausalityView.Lineage
        ? EventCallback.Factory.Create(this, SelectLineageAsync)
        : default;

    private Task SelectLineageAsync()
    {
        return SelectViewAsync(CausalityView.Lineage);
    }

    private void CloseDrawer()
    {
        _selectedEvent = null;
    }

    /// <summary>
    /// Opens the drawer on an event the Table view summarised because it has too many attribute rows to list (#2498).
    /// </summary>
    private void ViewAllAttributeChanges(CausalityEvent causalityEvent) => _selectedEvent = causalityEvent;

    private static string GetDrawerSubtitle(CausalityEvent selectedEvent)
    {
        var count = selectedEvent.AttributeRowCount;
        // A queued deprovision's rows identify the target rather than change it, so the drawer says what
        // they are rather than calling them changes; see CausalityEvent.AttributeRowsCaption.
        var subtitle = selectedEvent.AttributeRowsCaption
                       ?? $"{count.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)} attribute change{(count == 1 ? "" : "s")}";
        return string.IsNullOrWhiteSpace(selectedEvent.SystemName)
            ? subtitle
            : $"{subtitle} · {selectedEvent.SystemName}";
    }

    private CausalityTone GetStatusTone()
    {
        // A preview has no run status to report (nothing executed); Info is the panel's neutral tone
        // for "informational, not a verdict on success or failure".
        if (Item == null)
            return CausalityTone.Info;

        return Item.ErrorType is not null and not ActivityRunProfileExecutionItemErrorType.NotSet
            ? CausalityTone.Error
            : CausalityTone.Success;
    }

    private static string GetViewLabel(CausalityView view)
    {
        return view switch
        {
            CausalityView.Lineage => "Lineage",
            CausalityView.Table => "Table",
            _ => "Timeline"
        };
    }
}
