<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ba9a8545-3a24-4788-aa51-57fa313964fa</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..\..</DockerfileContext>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- AV0029 / AV0030 are Asp.Versioning analyser rules (shipped transitively from 10.2.0) that
         steer applications onto the library's own OpenAPI integration:
         AddApiVersioning().AddOpenApi() plus MapOpenApi().WithDocumentPerVersion(). JIM deliberately
         drives the native ASP.NET Core OpenAPI pipeline instead, because it needs document
         transformers for the OAuth2 and API key security schemes, a raised serialiser MaxDepth for
         the DTO graph, static document serving in production and response caching in development;
         none of which the per-version integration exposes. The API serves a single version, so the
         per-version document generation those rules ask for would add no documents. Revisit if JIM
         ever publishes a second API version. AV0029 also fires inside generated source, so it can
         only be suppressed at project level, not with a pragma. -->
    <NoWarn>$(NoWarn);1591;1587;AV0029;AV0030</NoWarn>

    <!-- Pin the ASP.NET Core shared framework version explicitly. Without this,
         Microsoft.NET.Sdk.Web + RestorePackagesWithLockFile resolves the implicit
         "Microsoft.AspNetCore.App.Internal.Assets" lock file entry to whichever
         ASP.NET Core runtime patch happens to be installed on the machine that
         performs the restore, which floats between the devcontainer's pinned SDK
         (10.0.203 -> runtime 10.0.7) and the production Dockerfiles' pinned SDK
         (10.0-noble digest -> runtime 10.0.9), breaking locked-mode restore
         non-deterministically. Pinning to the exact version shipped by the
         production base images (src/JIM.Web/Dockerfile) makes it deterministic.
         Keep in sync with the ASP.NET Core runtime version bundled by the pinned
         mcr.microsoft.com/dotnet/aspnet and dotnet/sdk digests whenever either is
         bumped (see engineering/DEPENDENCY_PINNING.md). -->
    <RuntimeFrameworkVersion>10.0.11</RuntimeFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Asp.Versioning.Mvc" Version="10.2.1" />
    <PackageReference Include="Asp.Versioning.Mvc.ApiExplorer" Version="10.2.1" />
    <PackageReference Include="Humanizer.Core" Version="3.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <!-- Direct pin to override the vulnerable Microsoft.OpenApi 2.0.0 pulled in transitively by
         Microsoft.AspNetCore.OpenApi 10.0.9. 2.7.5 is the first patched release for GHSA-v5pm-xwqc-g5wc
         ("Circular schema references may terminate OpenAPI parsing", high). Remove once the parent
         package references a patched version. -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.20" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JIM.Application\JIM.Application.csproj" />
    <ProjectReference Include="..\JIM.Models\JIM.Models.csproj" />
    <ProjectReference Include="..\JIM.PostgresData\JIM.PostgresData.csproj" />
    <ProjectReference Include="..\JIM.Utilities\JIM.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="MudBlazor" />
  </ItemGroup>
</Project>
