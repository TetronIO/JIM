@page "/admin/example-data"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.Activities
@using JIM.Models.ExampleData.DTOs
@using JIM.Web.Models
@using JIM.Web.Pages.Admin.Components
@inject IJimApplicationFactory JimFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager NavManager

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Example Data Templates</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>Example Data:</span> <span class="mud-primary-text">Templates</span>
    <PageInfo Title="Example Data Templates" DocsPage="configuration/example-data.md#templates">
        You can quickly populate JIM with example data, as a way to demo, or prototype new features without needing to fully configure JIM with Connected Systems, Synchronisation Rules and wait for data to be imported and synchronised. Templates define example data to be created in JIM. They consist of one or more object types, with data sets being used to generate values for the object attributes.
    </PageInfo>
</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

<SegmentedToggle TValue="string" Options="@SiblingPages.ExampleData" Value="@("templates")"
                 AriaLabel="Templates or Data Sets" Class="mt-3" />

@* ─── Templates ─── *@
@* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count) lives in the
   shared grid; this page loads the small configuration list once and windows it in memory. The page header
   already names the list, so there is no toolbar title and the count carries the nouns. *@
<VirtualisedDataGrid @ref="_grid" T="ExampleDataTemplateHeader"
                     ContainerId="example-data-template-list"
                     DefaultSortBy="name"
                     LoadWindow="LoadWindowAsync"
                     SingularName="Example Data Template"
                     PluralName="Example Data Templates">
    <ToolBarExtras>
        <MudButton OnClick="CreateAsync" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                   DropShadow="false">New Template</MudButton>
    </ToolBarExtras>
    <Columns>
        <TemplateColumn Title="Name" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Name" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                <MudLink Href="@("/admin/example-data/templates/" + context.Item.Id)">@context.Item.Name</MudLink>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Built-in?" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Built-in?" Name="builtin" />
            </HeaderTemplate>
            <CellTemplate>
                @(context.Item.BuiltIn ? "Yes" : "No")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Created" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Created" Name="created" />
            </HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                    @context.Item.Created.ToLocalTime().ToRelativeTime()
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Actions</MudText>
            </HeaderTemplate>
            <CellTemplate>
                <div class="d-flex justify-end gap-2">
                    <MudTooltip Text="Duplicate" Arrow="true" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Variant="Variant.Filled" Size="Size.Small"
                                       aria-label="@($"Duplicate {context.Item.Name}")" OnClick="_ => DuplicateAsync(context.Item)" />
                    </MudTooltip>
                    <MudTooltip Text="@(context.Item.BuiltIn ? "Built-in templates cannot be deleted" : "Delete")" Arrow="true" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Variant="Variant.Filled" Size="Size.Small" Color="Color.Error"
                                       aria-label="@($"Delete {context.Item.Name}")" Disabled="@context.Item.BuiltIn"
                                       OnClick="_ => DeleteAsync(context.Item)" />
                    </MudTooltip>
                </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No Example Data Templates match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.Science"
                             PrimaryText="No Example Data Templates yet"
                             SecondaryText="Templates define the example data that can be created in JIM."
                             ActionText="New Template"
                             OnAction="CreateAsync" />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<ExampleDataTemplateHeader>? _templates;
    private VirtualisedDataGrid<ExampleDataTemplateHeader>? _grid;

    private readonly List<BreadcrumbItem> _breadcrumbs = new List<BreadcrumbItem>
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Administration", href: "/admin"),
        new("Example Data", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _templates = await jim.ExampleData.GetTemplateHeadersAsync();
    }

    private async Task CreateAsync()
    {
        var newId = await NewExampleDataTemplateDialog.ShowAsync(DialogService);
        if (newId.HasValue)
            NavManager.NavigateTo($"/admin/example-data/templates/{newId.Value}");
    }

    private async Task DuplicateAsync(ExampleDataTemplateHeader template)
    {
        var newId = await NewExampleDataTemplateDialog.ShowAsync(DialogService, copyOf: template);
        if (newId.HasValue)
            NavManager.NavigateTo($"/admin/example-data/templates/{newId.Value}");
    }

    private async Task DeleteAsync(ExampleDataTemplateHeader template)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Data Generation Template?",
            $"\"{template.Name}\" will be deleted. Metaverse Objects already generated from it are not affected.",
            yesText: "Delete",
            cancelText: "Cancel");
        if (confirmed != true)
            return;

        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Delete");
        if (cancelled)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.ExampleData.DeleteTemplateAsync(template.Id, ActivityInitiatorType.User, user.Id, user.NameOrId, changeReason);
        Snackbar.Add($"Deleted \"{template.Name}\".", Severity.Success);

        _templates = await jim.ExampleData.GetTemplateHeadersAsync();
        if (_grid != null)
            await _grid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Windows the in-memory list for the grid: this is a small configuration list loaded whole on
    /// initialisation, so filtering and sorting happen here and the shared extension slices the window.
    /// </summary>
    private Task<VirtualisedWindow<ExampleDataTemplateHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        IEnumerable<ExampleDataTemplateHeader> templates = _templates ?? [];

        // The old table had no search box, so the grid's search is honoured against the obvious display
        // field: the name.
        var searchText = request.SearchText;
        if (!string.IsNullOrWhiteSpace(searchText))
            templates = templates.Where(t => t.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) == true);

        Func<ExampleDataTemplateHeader, object> sortKey = request.SortBy switch
        {
            "builtin" => t => t.BuiltIn,
            "created" => t => t.Created,
            _ => t => t.Name ?? string.Empty
        };
        templates = request.SortDescending ? templates.OrderByDescending(sortKey) : templates.OrderBy(sortKey);

        return Task.FromResult(templates.ToWindow(request));
    }
}
