@code {
    private bool _dataLoaded;
    private int _userCount;
    private int _groupCount;
    private string? _userIcon;
    private string? _groupIcon;
    private int _connectedSystemCount;
    private int _syncRuleCount;
    private List<Schedule> _schedules = new();
    private GettingStartedChecklist _checklist = new(false, false, false, false);

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        // Load object type counts
        var userType = await jim.Metaverse.GetMetaverseObjectTypeAsync(Constants.BuiltInObjectTypes.User, includeChildObjects: false);
        var groupType = await jim.Metaverse.GetMetaverseObjectTypeAsync(Constants.BuiltInObjectTypes.Group, includeChildObjects: false);
        _userCount = userType != null ? await jim.Metaverse.GetMetaverseObjectOfTypeCountAsync(userType) : 0;
        _groupCount = groupType != null ? await jim.Metaverse.GetMetaverseObjectOfTypeCountAsync(groupType) : 0;
        _userIcon = userType?.Icon;
        _groupIcon = groupType?.Icon;

        // Load Connected System and Synchronisation Rule counts
        _connectedSystemCount = jim.ConnectedSystems.GetConnectedSystemCount();
        var syncRuleHeaders = await jim.ConnectedSystems.GetSyncRuleHeadersAsync();
        _syncRuleCount = syncRuleHeaders.Count;

        // Load schedules
        _schedules = await jim.Scheduler.GetAllSchedulesAsync();

        // Evaluate the Getting Started checklist. A synchronisation counts as run whether an administrator
        // executed a Run Profile by hand or a Schedule fired it; keying only on Schedules leaves the step
        // permanently outstanding on a system that is demonstrably synchronising.
        _checklist = GettingStartedChecklist.Evaluate(
            connectedSystemCount: _connectedSystemCount,
            syncRuleCount: _syncRuleCount,
            scheduleCount: _schedules.Count,
            anyScheduleHasRun: _schedules.Any(s => s.LastRunTime.HasValue),
            anyRunProfileExecuted: await jim.Activities.HasAnyRunProfileExecutionAsync());

        _dataLoaded = true;
    }

    /// <summary>
    /// Slices one window of Schedules from the list the page already loaded, applying the grid's search (name)
    /// and sort. Schedules are a small configuration list, so there is no database range read here.
    /// </summary>
    private Task<VirtualisedWindow<Schedule>> LoadScheduleWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<Schedule> schedules = _schedules;

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            schedules = schedules.Where(s => s.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        // The trigger column reads as a sentence rather than as a stored value, so it sorts by the same text the
        // reader sees; sorting by TriggerType alone would put "Every 5 min" and "Weekdays at 6:00 AM" in an order
        // nothing on screen explains.
        Func<Schedule, object> sortKey = request.SortBy switch
        {
            "trigger" => s => ScheduleTriggerDisplay.Describe(s),
            "lastrun" => s => s.LastRunTime ?? DateTime.MinValue,
            "nextrun" => s => s.NextRunTime ?? DateTime.MinValue,
            "status" => s => s.IsEnabled,
            _ => s => s.Name
        };

        var sorted = request.SortDescending
            ? schedules.OrderByDescending(sortKey)
            : schedules.OrderBy(sortKey);

        return Task.FromResult(sorted.ToWindow(request));
    }

    private void HandleScheduleRowClicked(Schedule schedule) => GoToSchedules();

    private void GoToSchedules() => NavManager.NavigateTo("/admin/operations?t=schedules");
}
