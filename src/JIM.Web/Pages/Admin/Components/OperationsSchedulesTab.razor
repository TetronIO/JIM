@* The infinite-scroll machinery (URL state, scroll restore, window loading, the density toggle, the search box
   and the toolbar count) lives in the shared grid; this tab supplies the columns, the window loader and the
   empty states. The URL parameters are prefixed so this grid's state cannot collide with the History tab's on
   the shared Operations page URL. *@
<VirtualisedDataGrid @ref="_grid" T="ScheduleHeader"
                     ContainerId="operations-schedules"
                     UrlParameterPrefix="s-"
                     DefaultSortBy="name"
                     LoadWindow="LoadScheduleWindowAsync"
                     RowClicked="HandleRowClicked"
                     SingularName="Schedule"
                     PluralName="Schedules"
                     SearchPlaceholder="Search by name or description">
    <ToolBarExtras>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="HandleCreateScheduleAsync">
            New Schedule
        </MudButton>
    </ToolBarExtras>
    <Columns>
        <TemplateColumn T="ScheduleHeader" Title="Name" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Name" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                @{ var schedule = context.Item; }
                @* One line: a virtualised row is a fixed height, so a description stacked under the name is
                   clipped on the Schedules that have one and leaves dead space on the Schedules that do not.
                   The name holds its width and the description is what gives way. *@
                <div class="jim-attr-single-line">
                    <MudText Typo="Typo.body1">@schedule.Name</MudText>
                    @if (!string.IsNullOrEmpty(schedule.Description))
                    {
                        <MudTooltip Text="@schedule.Description" Arrow="true" Placement="Placement.Top" RootClass="jim-attr-single-line-value">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary jim-attr-single-line-value">@schedule.Description</MudText>
                        </MudTooltip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ScheduleHeader" Title="Steps" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Steps</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @{ var schedule = context.Item; }
                <MudChip T="string" Variant="Variant.Text" Color="Color.Default">
                    @schedule.StepCount step@(schedule.StepCount != 1 ? "s" : "")
                </MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ScheduleHeader" Title="Trigger" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Trigger</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @{ var schedule = context.Item; }
                @if (schedule.TriggerType == ScheduleTriggerType.Cron)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Info"
                             Icon="@Icons.Material.Filled.Schedule">
                        @GetScheduleDescription(schedule)
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Default"
                             Icon="@Icons.Material.Filled.TouchApp">
                        Manual
                    </MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ScheduleHeader" Title="Next Run" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Next Run" Name="nextruntime" />
            </HeaderTemplate>
            <CellTemplate>
                @{ var schedule = context.Item; }
                @if (schedule.NextRunTime.HasValue && schedule.IsEnabled && schedule.TriggerType == ScheduleTriggerType.Cron)
                {
                    var nextRunTime = schedule.NextRunTime.Value;
                    <MudTooltip Text="@nextRunTime.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                        <MudText Typo="Typo.body1">@nextRunTime.ToLocalTime().ToRelativeTime()</MudText>
                    </MudTooltip>
                }
                else
                {
                    <EmptyValue />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ScheduleHeader" Title="Last Run" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Last Run" Name="lastruntime" />
            </HeaderTemplate>
            <CellTemplate>
                @{ var schedule = context.Item; }
                @* One line: the outcome sits beside the timestamp rather than under it, because a virtualised
                   row is a fixed height and a stacked chip is clipped on exactly the rows that have run. *@
                <div class="jim-attr-single-line">
                    @if (schedule.LastRunTime.HasValue)
                    {
                        var lastRunTime = schedule.LastRunTime.Value;
                        <MudTooltip Text="@lastRunTime.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                            <MudText Typo="Typo.body1">@lastRunTime.ToLocalTime().ToRelativeTime()</MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudText Typo="Typo.body1" Class="mud-text-disabled">Never</MudText>
                    }
                    @* When it last ran is only half the story: a Schedule failing every night looks identical to a
                       healthy one without its outcome. A failed run also says which step it stopped on. *@
                    @if (schedule.LastExecutionStatus.HasValue)
                    {
                        var lastExecutionStatus = schedule.LastExecutionStatus.Value;
                        <MudChip T="string" Variant="Variant.Text" Class="ma-0 jim-attr-single-line-value"
                                 Color="Helpers.GetScheduleExecutionMudBlazorColorForStatus(lastExecutionStatus)">
                            @GetLastOutcomeLabel(schedule)
                        </MudChip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ScheduleHeader" Title="Status" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Status" Name="status" />
            </HeaderTemplate>
            <CellTemplate>
                @{ var schedule = context.Item; }
                @if (schedule.IsEnabled)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Success">
                        Enabled
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Default">
                        Disabled
                    </MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn T="ScheduleHeader" Title="Actions" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Actions</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @{ var schedule = context.Item; }
                <div @onclick:stopPropagation="true">
                    <MudStack Row="true" Spacing="1" Justify="Justify.FlexEnd">
                        <MudTooltip Text="Show this Schedule's executions" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small"
                                           OnClick="@(() => OpenExecutionsDialog(schedule))" />
                        </MudTooltip>
                        @if (schedule.IsEnabled)
                        {
                            <MudTooltip Text="Disable" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Pause" Size="Size.Small"
                                               OnClick="@(() => HandleToggleEnabledAsync(schedule))" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Enable" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small"
                                               OnClick="@(() => HandleToggleEnabledAsync(schedule))" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="Run Now" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => HandleRunNowAsync(schedule))"
                                           Disabled="@(schedule.StepCount == 0)" />
                        </MudTooltip>
                        @if (schedule.BuiltIn)
                        {
                            <MudTooltip Text="Built-in schedule; cannot be deleted" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Disabled="true" />
                            </MudTooltip>
                        }
                        else
                        {
                            <MudTooltip Text="Delete" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(() => HandleDeleteAsync(schedule))" />
                            </MudTooltip>
                        }
                    </MudStack>
                </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No Schedules match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Outlined.Schedule"
                             PrimaryText="No Schedules have been created yet"
                             SecondaryText="A Schedule runs a sequence of Run Profiles on a trigger you choose, or on demand."
                             ActionText="Create Your First Schedule"
                             OnAction="HandleCreateScheduleAsync" />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@* ─── Schedule Executions ─── *@
@* A Schedule's executions are unbounded, and a virtualised grid's rows are a fixed height, so they cannot be
   an expandable row inside the Schedules grid: the virtualiser sizes its scroll area from that fixed height and
   a row that grows to hold a table puts every row below it in the wrong place. They open in a dialog instead,
   where the grid is embedded (no density toggle of its own, no URL state to collide with the page's) and given
   an explicit height ceiling, because a dialog has no relationship with the page footer the grid would
   otherwise measure against. The list is the Schedule's whole history rather than a fixed five most recent. *@
<MudDialog @bind-Visible="_executionsDialogVisible" Options="_executionsDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-3" />
            @(_executionsSchedule?.Name ?? "Schedule")
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (_executionsSchedule != null)
        {
            var executionsScheduleId = _executionsSchedule.Id;
            <VirtualisedDataGrid T="ScheduleExecution"
                                 ContainerId="schedule-executions"
                                 Embedded="true"
                                 MaxHeight="420px"
                                 StateKey="@executionsScheduleId.ToString()"
                                 DefaultSortBy="queuedAt"
                                 DefaultSortDescending="true"
                                 LoadWindow="LoadExecutionWindowAsync"
                                 SingularName="Schedule Execution"
                                 PluralName="Schedule Executions"
                                 SearchPlaceholder="Search by initiator">
                <Columns>
                    <TemplateColumn T="ScheduleExecution" Title="Started" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Started" Name="startedAt" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.StartedAt.HasValue)
                            {
                                var startedAt = context.Item.StartedAt.Value;
                                <MudTooltip Text="@startedAt.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                                    <span>@startedAt.ToLocalTime().ToRelativeTime()</span>
                                </MudTooltip>
                            }
                            else
                            {
                                <EmptyValue />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="ScheduleExecution" Title="Outcome" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Outcome" Name="status" />
                        </HeaderTemplate>
                        <CellTemplate>
                            <MudChip T="string" Variant="Variant.Text" Class="ml-0"
                                     Color="Helpers.GetScheduleExecutionMudBlazorColorForStatus(context.Item.Status)">
                                @context.Item.Status.ToString().SplitOnCapitalLetters()
                            </MudChip>
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="ScheduleExecution" Title="Duration" Sortable="false">
                        <HeaderTemplate>
                            <VirtualisedSortHeader Title="Duration" Name="completedAt" />
                        </HeaderTemplate>
                        <CellTemplate>
                            @{ var duration = GetExecutionDuration(context.Item); }
                            @if (duration.HasValue)
                            {
                                var durationValue = duration.Value;
                                <span>@durationValue.ToAbbreviatedString()</span>
                            }
                            else
                            {
                                <EmptyValue />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="ScheduleExecution" Title="Steps" Sortable="false">
                        <HeaderTemplate>
                            <MudText Typo="Typo.button">Steps</MudText>
                        </HeaderTemplate>
                        <CellTemplate>
                            @if (context.Item.TotalSteps > 0)
                            {
                                <span>@(Math.Min(context.Item.CurrentStepIndex + 1, context.Item.TotalSteps)) of @context.Item.TotalSteps</span>
                            }
                            else
                            {
                                <EmptyValue />
                            }
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="ScheduleExecution" Title="Initiated By" Sortable="false">
                        <HeaderTemplate>
                            <MudText Typo="Typo.button">Initiated By</MudText>
                        </HeaderTemplate>
                        <CellTemplate>
                            <AuditPrincipalLink PrincipalType="context.Item.InitiatedByType"
                                                PrincipalId="context.Item.InitiatedById"
                                                PrincipalName="@context.Item.InitiatedByName" />
                        </CellTemplate>
                    </TemplateColumn>
                    <TemplateColumn T="ScheduleExecution" Sortable="false">
                        <HeaderTemplate></HeaderTemplate>
                        <CellTemplate>
                            <MudLink Href="@($"/admin/operations/schedule-executions/{context.Item.Id}")">View Schedule Execution</MudLink>
                        </CellTemplate>
                    </TemplateColumn>
                </Columns>
                <EmptyContent Context="grid">
                    @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                    {
                        <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                         PrimaryText="@($"No Schedule Executions match \"{grid.SearchText}\"")"
                                         SecondaryText="Try a different search term, or clear the search."
                                         ActionText="Clear Search"
                                         OnAction="@(() => grid.ClearSearchAsync())" />
                    }
                    else
                    {
                        <TableEmptyState Icon="@Icons.Material.Outlined.Schedule"
                                         PrimaryText="This Schedule has not run yet"
                                         SecondaryText="Executions appear here once the Schedule's trigger fires, or once it is run with the Run Now action." />
                    }
                </EmptyContent>
            </VirtualisedDataGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _executionsDialogVisible = false)" DropShadow="false">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private VirtualisedDataGrid<ScheduleHeader>? _grid;

    // The Schedule whose executions the dialog is showing. Held as the header rather than the id alone so the
    // dialog title can name it without a second read.
    private ScheduleHeader? _executionsSchedule;
    private bool _executionsDialogVisible;

    private readonly DialogOptions _executionsDialogOptions = new()
    {
        MaxWidth = MaxWidth.Large,
        FullWidth = true,
        CloseOnEscapeKey = true
    };

    /// <summary>
    /// Loads one window of Schedule headers, honouring the request's skip-the-count contract. Schedules are read
    /// through a repository range read rather than loaded whole and sliced: the paged reader they used to share
    /// caps a page at 100, so an installation with more Schedules than that would silently lose the rest.
    /// </summary>
    private async Task<VirtualisedWindow<ScheduleHeader>> LoadScheduleWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        using var jim = JimFactory.Create();
        var result = await jim.Scheduler.GetScheduleHeadersRangeAsync(
            request.StartIndex,
            request.Count,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            request.IncludeTotalCount);

        return new VirtualisedWindow<ScheduleHeader>(result.Results, result.TotalResults);
    }

    /// <summary>
    /// Loads one window of the open Schedule's executions. Executions are unbounded (a Schedule running every
    /// fifteen minutes accumulates thousands a month), so this is a repository range read, and the total is only
    /// counted when the grid asks for it.
    /// </summary>
    private async Task<VirtualisedWindow<ScheduleExecution>> LoadExecutionWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        var scheduleId = _executionsSchedule?.Id;
        if (scheduleId == null)
            return new VirtualisedWindow<ScheduleExecution>([], request.IncludeTotalCount ? 0 : null);

        using var jim = JimFactory.Create();
        var result = await jim.Scheduler.GetScheduleExecutionsRangeAsync(
            scheduleId,
            request.StartIndex,
            request.Count,
            request.SearchText,
            request.SortBy,
            request.SortDescending,
            request.IncludeTotalCount);

        return new VirtualisedWindow<ScheduleExecution>(result.Results, result.TotalResults);
    }

    /// <summary>
    /// Re-reads the Schedules grid after a write. The totals are invalidated because creating or deleting a
    /// Schedule changes how many there are, and the toolbar count would otherwise keep the old figure.
    /// </summary>
    private async Task RefreshSchedulesAsync()
    {
        if (_grid != null)
            await _grid.RefreshAsync(invalidateTotals: true);
    }

    private void OpenExecutionsDialog(ScheduleHeader header)
    {
        _executionsSchedule = header;
        _executionsDialogVisible = true;
    }

    /// <summary>
    /// How long an execution took: the elapsed time so far while it is still running, and the total once it has
    /// finished. Null until it has started.
    /// </summary>
    private static TimeSpan? GetExecutionDuration(ScheduleExecution execution)
    {
        if (!execution.StartedAt.HasValue)
            return null;

        var startedAt = execution.StartedAt.Value;
        return execution.CompletedAt.HasValue ? execution.CompletedAt.Value - startedAt : DateTime.UtcNow - startedAt;
    }

    /// <summary>
    /// The label for the last execution's outcome chip. A failed run names the step it stopped on, which saves the
    /// administrator a click through to the Schedule Execution; the stored step index is 0-based and is shown
    /// 1-based, clamped to the total in case the execution failed after advancing past its last step.
    /// </summary>
    private static string GetLastOutcomeLabel(ScheduleHeader header)
    {
        if (!header.LastExecutionStatus.HasValue)
            return string.Empty;

        var status = header.LastExecutionStatus.Value;
        if (status != ScheduleExecutionStatus.Failed)
            return status.ToString().SplitOnCapitalLetters();

        if (!header.LastExecutionCurrentStepIndex.HasValue || !header.LastExecutionTotalSteps.HasValue)
            return "Failed";

        var totalSteps = header.LastExecutionTotalSteps.Value;
        if (totalSteps < 1)
            return "Failed";

        var stepNumber = Math.Min(header.LastExecutionCurrentStepIndex.Value + 1, totalSteps);
        return $"Failed on step {stepNumber}";
    }

    private async Task HandleRowClicked(ScheduleHeader header)
    {
        await OpenScheduleEditorAsync(header.Id);
    }

    private async Task HandleCreateScheduleAsync()
    {
        await OpenScheduleEditorAsync(null);
    }

    private async Task OpenScheduleEditorAsync(Guid? scheduleId)
    {
        var parameters = new DialogParameters<ScheduleEditorDialog>
        {
            { x => x.ScheduleId, scheduleId }
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseOnEscapeKey = true,
            NoHeader = false
        };

        var dialog = await DialogService.ShowAsync<ScheduleEditorDialog>(
            scheduleId.HasValue ? "Edit Schedule" : "New Schedule",
            parameters,
            options);

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await RefreshSchedulesAsync();
        }
    }

    private async Task HandleToggleEnabledAsync(ScheduleHeader header)
    {
        using var jim = JimFactory.Create();

        // The table holds lightweight projections, so the Schedule itself is re-loaded before it is mutated and
        // handed to the update path; a DTO is not something the repository can persist.
        var schedule = await jim.Scheduler.GetScheduleAsync(header.Id);
        if (schedule == null)
        {
            Snackbar.Add($"Schedule '{header.Name}' no longer exists.", Severity.Warning);
            await RefreshSchedulesAsync();
            return;
        }

        schedule.IsEnabled = !schedule.IsEnabled;

        // Update audit info
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        schedule.LastUpdated = DateTime.UtcNow;
        schedule.LastUpdatedByType = ActivityInitiatorType.User;
        schedule.LastUpdatedById = user.Id;
        schedule.LastUpdatedByName = user.NameOrId;

        await jim.Scheduler.UpdateScheduleAsync(schedule, ActivityInitiatorType.User, user.Id, user.NameOrId);

        var action = schedule.IsEnabled ? "enabled" : "disabled";
        Snackbar.Add($"Schedule '{schedule.Name}' has been {action}.", Severity.Success);

        await RefreshSchedulesAsync();
    }

    private async Task HandleRunNowAsync(ScheduleHeader header)
    {
        if (header.StepCount == 0)
        {
            Snackbar.Add("Cannot run a schedule with no steps.", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Run Schedule Now",
            $"Are you sure you want to run '{header.Name}' now? This will queue all steps for execution.",
            yesText: "Run Now",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        // Load schedule with steps for execution
        var scheduleWithSteps = await jim.Scheduler.GetScheduleWithStepsAsync(header.Id);
        if (scheduleWithSteps == null)
        {
            Snackbar.Add("Schedule not found.", Severity.Error);
            return;
        }

        var execution = await jim.Scheduler.StartScheduleExecutionAsync(
            scheduleWithSteps,
            ActivityInitiatorType.User,
            user.Id,
            user.NameOrId);

        if (execution != null)
        {
            Snackbar.Add($"Schedule '{header.Name}' has been queued for execution.", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Failed to start schedule '{header.Name}'. It may have no steps.", Severity.Warning);
        }

        await RefreshSchedulesAsync();
    }

    private async Task HandleDeleteAsync(ScheduleHeader header)
    {
        // Built-in schedules cannot be deleted (the delete affordance is already locked for them; this is the
        // defence-in-depth guard so the application layer never throws into the circuit).
        if (header.BuiltIn)
        {
            Snackbar.Add($"The built-in schedule '{header.Name}' cannot be deleted.", Severity.Warning);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Schedule",
            $"Are you sure you want to delete '{header.Name}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        // offer an optional reason for the configuration change history; cancelling aborts the delete
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Delete");
        if (cancelled)
            return;

        using var jim = JimFactory.Create();

        // As with the enable/disable handler above, the delete path needs the Schedule entity, not the projection.
        var schedule = await jim.Scheduler.GetScheduleAsync(header.Id);
        if (schedule == null)
        {
            Snackbar.Add($"Schedule '{header.Name}' no longer exists.", Severity.Warning);
            await RefreshSchedulesAsync();
            return;
        }

        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.Scheduler.DeleteScheduleAsync(schedule, ActivityInitiatorType.User, user.Id, user.NameOrId, changeReason);
        Snackbar.Add($"Schedule '{schedule.Name}' has been deleted.", Severity.Success);
        await RefreshSchedulesAsync();
    }

    /// <summary>
    /// Gets a concise human-readable description of a schedule using its pattern metadata.
    /// </summary>
    private static string GetScheduleDescription(ScheduleHeader schedule)
    {
        if (schedule.TriggerType != ScheduleTriggerType.Cron)
            return "Manual";

        // Use pattern metadata for concise descriptions
        var dayDesc = GetDayDescriptionFromSchedule(schedule.DaysOfWeek);

        switch (schedule.PatternType)
        {
            case SchedulePatternType.Interval:
                var unit = schedule.IntervalUnit == ScheduleIntervalUnit.Hours ? "hr" : "min";
                var intervalDesc = $"Every {schedule.IntervalValue ?? 1} {unit}";

                if (!string.IsNullOrEmpty(schedule.IntervalWindowStart) &&
                    !string.IsNullOrEmpty(schedule.IntervalWindowEnd))
                {
                    var start = FormatTimeString(schedule.IntervalWindowStart);
                    var end = FormatTimeString(schedule.IntervalWindowEnd);
                    return $"{dayDesc}, {intervalDesc} ({start}-{end})";
                }
                return $"{dayDesc}, {intervalDesc}";

            case SchedulePatternType.SpecificTimes:
                if (!string.IsNullOrEmpty(schedule.RunTimes))
                {
                    var times = schedule.RunTimes.Split(',', StringSplitOptions.RemoveEmptyEntries);
                    if (times.Length == 1)
                    {
                        return $"{dayDesc} at {FormatTimeString(times[0].Trim())}";
                    }
                    if (times.Length <= 3)
                    {
                        var timeList = string.Join(", ", times.Select(t => FormatTimeString(t.Trim())));
                        return $"{dayDesc} at {timeList}";
                    }
                    // Many times - summarise
                    return $"{dayDesc}, {times.Length} times/day";
                }
                break;

            case SchedulePatternType.Custom:
                // Fall back to cron parsing for custom expressions
                return GetCronDescription(schedule.CronExpression);
        }

        // Fallback to cron parsing if pattern metadata isn't available
        return GetCronDescription(schedule.CronExpression);
    }

    /// <summary>
    /// Gets day description from DaysOfWeek string (e.g., "1,2,3,4,5").
    /// </summary>
    private static string GetDayDescriptionFromSchedule(string? daysOfWeek)
    {
        if (string.IsNullOrEmpty(daysOfWeek))
            return "Daily";

        var days = daysOfWeek.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Where(d => int.TryParse(d.Trim(), out _))
            .Select(d => int.Parse(d.Trim()))
            .OrderBy(d => d)
            .ToList();

        if (days.Count == 0 || days.Count == 7)
            return "Daily";
        if (days.SequenceEqual(new[] { 1, 2, 3, 4, 5 }))
            return "Weekdays";
        if (days.SequenceEqual(new[] { 0, 6 }))
            return "Weekends";

        // For 6 days, show which day is excluded
        if (days.Count == 6)
        {
            var missing = Enumerable.Range(0, 7).Except(days).First();
            var missingName = missing switch
            {
                0 => "Sun", 1 => "Mon", 2 => "Tue", 3 => "Wed",
                4 => "Thu", 5 => "Fri", 6 => "Sat", _ => "?"
            };
            return $"Daily exc. {missingName}";
        }

        // Short list of days
        var dayNames = days.Select(d => d switch
        {
            0 => "Sun", 1 => "Mon", 2 => "Tue", 3 => "Wed",
            4 => "Thu", 5 => "Fri", 6 => "Sat", _ => "?"
        });
        return string.Join(", ", dayNames);
    }

    /// <summary>
    /// Formats a time string (HH:mm) to AM/PM format.
    /// </summary>
    private static string FormatTimeString(string timeStr)
    {
        if (TimeSpan.TryParse(timeStr.Trim(), out var time))
        {
            var hour = time.Hours;
            var minute = time.Minutes;
            var period = hour >= 12 ? "pm" : "am";
            var displayHour = hour > 12 ? hour - 12 : (hour == 0 ? 12 : hour);
            return minute == 0 ? $"{displayHour}{period}" : $"{displayHour}:{minute:D2}{period}";
        }
        return timeStr;
    }

    /// <summary>
    /// Converts a cron expression to a human-readable description.
    /// </summary>
    private static string GetCronDescription(string? cronExpression)
    {
        if (string.IsNullOrWhiteSpace(cronExpression))
            return "Not configured";

        // Parse common patterns for display
        var parts = cronExpression.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 5)
            return cronExpression;

        var minute = parts[0];
        var hour = parts[1];
        var dayOfMonth = parts[2];
        var month = parts[3];
        var dayOfWeek = parts[4];

        // Get day description
        var dayDesc = GetDayDescription(dayOfWeek);

        // Handle multiple specific hours (e.g., "0 9,12,15,18 * * 1-5")
        if (dayOfMonth == "*" && month == "*" && hour.Contains(',') && !hour.Contains('/'))
        {
            var hours = hour.Split(',')
                .Where(h => int.TryParse(h.Trim(), out _))
                .Select(h => int.Parse(h.Trim()))
                .ToList();

            if (hours.Count > 0)
            {
                var timeList = string.Join(", ", hours.Select(h => FormatHour(h, int.TryParse(minute, out var m) ? m : 0)));
                return $"{dayDesc} at {timeList}";
            }
        }

        // Daily at specific time
        if (dayOfMonth == "*" && month == "*" && dayOfWeek == "*")
        {
            if (hour.StartsWith("*/"))
            {
                var interval = hour[2..];
                return $"Every {interval} hours";
            }
            return $"Daily at {FormatTime(hour, minute)}";
        }

        // Single time schedules with day restrictions
        if (dayOfMonth == "*" && month == "*" && int.TryParse(hour, out _))
        {
            return $"{dayDesc} at {FormatTime(hour, minute)}";
        }

        // Hourly
        if (hour == "*" && dayOfMonth == "*" && month == "*")
        {
            var hourlyDesc = minute == "0" ? "Hourly" : $"Hourly at :{minute.PadLeft(2, '0')}";
            if (dayOfWeek != "*")
                return $"{dayDesc}, {hourlyDesc.ToLower()}";
            return hourlyDesc;
        }

        // Every N minutes
        if (minute.StartsWith("*/") && hour == "*")
        {
            var interval = minute[2..];
            var minDesc = $"Every {interval} minutes";
            if (dayOfWeek != "*")
                return $"{dayDesc}, every {interval} min";
            return minDesc;
        }

        // Every N hours
        if (hour.StartsWith("*/") && minute == "0")
        {
            var interval = hour[2..];
            var hourDesc = $"Every {interval} hours";
            if (dayOfWeek != "*")
                return $"{dayDesc}, every {interval} hrs";
            return hourDesc;
        }

        // Default: show abbreviated cron
        return cronExpression;
    }

    private static string GetDayDescription(string dayOfWeek)
    {
        if (dayOfWeek == "*")
            return "Daily";
        if (dayOfWeek == "1-5" || dayOfWeek == "MON-FRI")
            return "Weekdays";
        if (dayOfWeek == "0,6" || dayOfWeek == "SAT,SUN")
            return "Weekends";

        // Try to parse as comma-separated days
        var dayNumbers = dayOfWeek.Split(',')
            .Where(d => int.TryParse(d.Trim(), out _))
            .Select(d => int.Parse(d.Trim()))
            .ToList();

        if (dayNumbers.Count > 0)
        {
            if (dayNumbers.Count == 7)
                return "Daily";
            if (dayNumbers.OrderBy(d => d).SequenceEqual(new[] { 1, 2, 3, 4, 5 }))
                return "Weekdays";
            if (dayNumbers.OrderBy(d => d).SequenceEqual(new[] { 0, 6 }))
                return "Weekends";

            var dayNames = dayNumbers.Select(d => d switch
            {
                0 => "Sun",
                1 => "Mon",
                2 => "Tue",
                3 => "Wed",
                4 => "Thu",
                5 => "Fri",
                6 => "Sat",
                _ => "?"
            });
            return string.Join(", ", dayNames);
        }

        return dayOfWeek;
    }

    private static string FormatTime(string hour, string minute)
    {
        if (!int.TryParse(hour, out var h) || !int.TryParse(minute, out var m))
            return $"{hour}:{minute}";

        return FormatHour(h, m);
    }

    private static string FormatHour(int hour, int minute)
    {
        var period = hour >= 12 ? "PM" : "AM";
        var displayHour = hour > 12 ? hour - 12 : (hour == 0 ? 12 : hour);
        return $"{displayHour}:{minute:D2} {period}";
    }
}
