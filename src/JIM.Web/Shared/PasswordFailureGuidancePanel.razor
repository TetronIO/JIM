@* Remediation guidance for a password JIM could not set (issue #1172).                                  *@
@*                                                                                                       *@
@* Folded away until it is asked for. An administrator reading three results wants three sentences, not  *@
@* three paragraphs, and the target's own words are frequently all they need; guidance that cannot be    *@
@* folded away is guidance that gets scrolled past, and it pushes the retry action off the screen.       *@
@*                                                                                                       *@
@* The words themselves live on PasswordFailureGuidance rather than here, so the panel that shows parked *@
@* provisioning passwords meets the same advice rather than a second copy of it that drifts.             *@

@if (_guidance != null)
{
    <MudButton Variant="Variant.Text" Size="Size.Small" DropShadow="false" Color="Color.Primary"
               Class="jim-password-guidance-toggle"
               EndIcon="@(Expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
               OnClick="Toggle" data-testid="jim-password-guidance-toggle">
        @(Expanded ? "Hide guidance" : "How to fix this")
    </MudButton>

    @if (Expanded)
    {
        @* An Info alert, because that is what this is: advice, sitting inside a row that has just been       *@
        @* washed in the error colour. Its own tint and rule separate it from that wash without competing     *@
        @* with it, and it inherits the house alert treatment rather than a bespoke panel imitating one.      *@
        @*                                                                                                    *@
        @* One prose size throughout, and two text colours: the headline leads, everything else is body.      *@
        @* This panel previously ran three sizes and four colours in the space of six lines, with the         *@
        @* headline the smallest and faintest thing in it, which is the wrong way round for the line that     *@
        @* names what went wrong.                                                                             *@
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true"
                  Class="jim-password-guidance" data-testid="jim-password-guidance">
            @* No mud-text-secondary here: the panel sets the secondary colour once and everything in it       *@
            @* inherits, so the summary and the bullets under it cannot end up at two different weights of the *@
            @* same grey. That class also carries opacity: 0.8, which the inherited colour does not, so the    *@
            @* two read differently even when the computed colour matches.                                     *@
            <MudText Typo="Typo.body2" Class="jim-password-guidance-headline">@_guidance.Headline</MudText>
            <MudText Typo="Typo.body2">@_guidance.Summary</MudText>

            <ul class="jim-password-guidance-checks">
                @foreach (var check in _guidance.Checks)
                {
                    <li><MudText Typo="Typo.body2">@check</MudText></li>
                }
            </ul>

            @* Offered only where the password itself was refused: replacing it on the one system that      *@
            @* failed would leave the person with two different passwords, which is the outcome setting one *@
            @* password across their accounts exists to prevent. The button says what it will rewrite.      *@
            @if (_guidance.Verdict == PasswordRetryVerdict.RetryWithADifferentPassword && AccountCount > 1)
            {
                <div>
                    @* Filled, in the alert's own severity colour: the pattern the Schema tab's alert already *@
                    @* uses, and the exception the alert rule in JIM.Web/CLAUDE.md names for a button that    *@
                    @* is the point of the alert rather than an aside within it. Outlined-and-inherit left    *@
                    @* both actions here looking like disabled chrome.                                        *@
                    <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false"
                               Color="Color.Info"
                               StartIcon="@Icons.Material.Filled.Casino" OnClick="OnRegenerateForAll"
                               data-testid="jim-password-guidance-regenerate">
                        New password for all @AccountCount accounts
                    </MudButton>
                    <MudText Typo="Typo.caption" Class="d-block mt-1">
                        Rewrites the accounts that already took the password, so this person keeps one.
                        Retrying this Connected System alone would leave them with two.
                    </MudText>
                </div>
            }

            @* Where the repair happens, as a button rather than a bare link: it is the one thing in this *@
            @* panel that takes the administrator somewhere, and it should look like it.                  *@
            @if (ConnectedSystemId.HasValue && _guidance.ConnectedSystemTab != null)
            {
                var connectedSystemId = ConnectedSystemId.Value;
                <div>
                    @* Filled in the alert's colour, matching the button above. This is the only affordance   *@
                    @* in four of the five failure reasons, so it is the panel's action rather than an aside. *@
                    <MudButton Variant="Variant.Filled" Size="Size.Small" DropShadow="false"
                               Color="Color.Info" Class="jim-password-guidance-link"
                               Href="@($"/admin/connected-systems/{connectedSystemId}/?t={_guidance.ConnectedSystemTab}")"
                               StartIcon="@Icons.Material.Filled.OpenInNew"
                               data-testid="jim-password-guidance-link">
                        @ConnectedSystemName &rsaquo; @_guidance.ConnectedSystemTabLabel
                    </MudButton>
                </div>
            }

            @* The verdict's colour lives in its dot, not its text. The sentence beside it already says what *@
            @* the colour would say, so the dot is a second, redundant cue rather than the only one, and the *@
            @* panel keeps to two text colours.                                                              *@
            <MudText Typo="Typo.body2" Class="@($"jim-password-guidance-verdict {VerdictModifier}")"
                     data-testid="jim-password-guidance-verdict">
                @DescribeVerdict(_guidance.Verdict)
            </MudText>
        </MudAlert>
    }
}

@code {
    /// <summary>
    /// Why the password could not be set. <see cref="PasswordSetFailureReason.None"/> renders nothing, so a
    /// caller can put this beside every result without branching on success.
    /// </summary>
    [Parameter]
    public PasswordSetFailureReason FailureReason { get; set; } = PasswordSetFailureReason.None;

    /// <summary>
    /// The Connected System that refused, for the deep link to where the repair happens.
    /// </summary>
    [Parameter]
    public int? ConnectedSystemId { get; set; }

    [Parameter]
    public string? ConnectedSystemName { get; set; }

    /// <summary>
    /// How many accounts the password was being set on. Governs whether the "new password for all of them"
    /// escape hatch is offered: with one account there is nothing to keep aligned, so plain retry covers it.
    /// </summary>
    [Parameter]
    public int AccountCount { get; set; } = 1;

    /// <summary>
    /// Raised when the administrator asks for a fresh password across every account. The caller owns
    /// generating it and running the fan-out again; this component only decides when to offer that.
    /// </summary>
    [Parameter]
    public EventCallback OnRegenerateForAll { get; set; }

    /// <summary>
    /// Whether the guidance is open. Collapsed on first render, and each panel is independent of its
    /// neighbours: opening one result's guidance must not open every other result's too.
    /// </summary>
    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public EventCallback<bool> ExpandedChanged { get; set; }

    private PasswordFailureGuidance? _guidance;

    protected override void OnParametersSet()
    {
        _guidance = FailureReason == PasswordSetFailureReason.None
            ? null
            : PasswordFailureGuidance.For(FailureReason);
    }

    private async Task Toggle()
    {
        Expanded = !Expanded;
        await ExpandedChanged.InvokeAsync(Expanded);
    }

    /// <summary>
    /// Which colour the verdict's dot takes. A modifier rather than MudBlazor's <c>mud-*-text</c> classes,
    /// which would colour the sentence as well as the dot and put a third colour into a six-line panel.
    /// </summary>
    private string VerdictModifier => _guidance?.Verdict switch
    {
        PasswordRetryVerdict.RetryWithADifferentPassword or PasswordRetryVerdict.RetryUnchanged => "jim-password-guidance-verdict--retry",
        PasswordRetryVerdict.NeedsSomebodyElse => "jim-password-guidance-verdict--somebody-else",
        _ => "jim-password-guidance-verdict--never"
    };

    private static string DescribeVerdict(PasswordRetryVerdict verdict) => verdict switch
    {
        PasswordRetryVerdict.RetryWithADifferentPassword => "Worth retrying with a different password",
        PasswordRetryVerdict.RetryUnchanged => "Worth retrying unchanged",
        PasswordRetryVerdict.NeedsSomebodyElse => "Nothing changes until somebody grants the right",
        PasswordRetryVerdict.NeverHelps => "Retrying will never help",
        _ => string.Empty
    };
}
