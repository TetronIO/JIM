<PageTitle>@(MetaverseObject == null ? "Loading…" : $"{MetaverseObjectType?.Name}: {_displayName}")</PageTitle>

<LoadingGate IsLoading="@(MetaverseObject == null)">
    <Loading>
        <MvoDetailSkeleton />
    </Loading>
    <LongLoadMessage>
        <MudAlert Severity="Severity.Info">
            Still loading. Large objects can take a few seconds to retrieve.
        </MudAlert>
    </LongLoadMessage>
    <Loaded>
<MudText Typo="Typo.h3"><MudIcon Icon="@Helpers.ResolveObjectTypeIcon(MetaverseObjectType?.Icon)" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>@MetaverseObjectType?.Name:</span> <span class="mud-primary-text">@_displayName</span></MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>


@if (MetaverseObject != null)
{
    <NavigableMudTabs ActivePanelIndex="_activeTabIndex" ActivePanelIndexChanged="OnActiveTabIndexChanged"
                      ActivePanelSlugChanged="OnActiveTabSlugChangedAsync" Class="mt-2" TabPanelsClass="pt-5">
        <Header Context="headerContext">
            @if (_activeTabIndex == 0)
            {
                <MudSpacer />
                <MudButtonGroup OverrideStyles="false" Class="my-auto me-2">
                    <MudButton Variant="@(_detailViewMode == "form" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ViewModule"
                               OnClick="@(() => OnDetailViewModeChangedAsync("form"))">Form</MudButton>
                    <MudButton Variant="@(_detailViewMode == "tabs" ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Tab"
                               OnClick="@(() => OnDetailViewModeChangedAsync("tabs"))">Tabs</MudButton>
                    <MudTooltip Text="Attributes with their sources and history" Arrow="true" Placement="Placement.Top">
                        <MudButton Variant="@(_detailViewMode == "table" ? Variant.Filled : Variant.Outlined)"
                                   Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.ManageSearch"
                                   OnClick="@(() => OnDetailViewModeChangedAsync("table"))">Inspect</MudButton>
                    </MudTooltip>
                </MudButtonGroup>
            }
        </Header>
        <ChildContent>
        <MudTabPanel Text="Details" Icon="@Icons.Material.Filled.Info">
            @if (_detailViewMode == "table")
            {
                <MvoDetailsTable MetaverseObject="MetaverseObject" ObjectTypeName="@(MetaverseObjectType?.Name ?? "object")"
                                 AttributeValueTotalCounts="_attributeValueTotalCounts"
                                 Provenance="_object.Provenance" ProvenanceLoading="_object.ProvenanceLoading"
                                 GroupBy="@_inspectGroupBy" OnGroupByChanged="OnInspectGroupByChangedAsync"
                                 ContributionFilterKey="@_object.ContributionFilterKey" OnContributionFilterChanged="OnContributionFilterChangedAsync"
                                 SelectedAttributeId="_object.SelectedAttributeId" OnAttributeSelected="OnAttributeSelectedAsync"
                                 SelectedAttributeProvenance="_object.SelectedAttributeProvenance" AttributeInspectorLoading="_object.AttributeInspectorLoading"
                                 OnCloseInspector="OnCloseInspectorAsync" OnOpenInTimeline="OpenAttributeInTimelineAsync" />
            }
            else if (_detailViewMode == "tabs")
            {
                <MvoDetailsTabs MetaverseObject="MetaverseObject" ObjectTypeId="MetaverseObjectType!.Id" AttributeValueTotalCounts="_attributeValueTotalCounts" />
            }
            else
            {
                <MvoDetailsPanel MetaverseObject="MetaverseObject" ObjectTypeId="MetaverseObjectType!.Id" AttributeValueTotalCounts="_attributeValueTotalCounts" />
            }
        </MudTabPanel>

        <MudTabPanel Text="Changes" Icon="@Icons.Material.Filled.History" BadgeData="@GetChangeBadge()" BadgeColor="Color.Primary">
            <div>
                @if (_object.ChangeHistoryLoading && _object.ChangeHistoryRows.Count == 0)
                {
                    <div class="d-flex justify-center pa-4">
                        <MudProgressCircular Indeterminate="true" />
                    </div>
                }
                else if (_object.ChangeCount == 0 && _object.Retirements.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No change history recorded for this object.</MudAlert>
                }
                else
                {
                    <ChangeHistoryTimeline Changes="@_object.ChangeHistoryRows"
                                           Retirements="@_object.Retirements"
                                           HistoryComplete="@(_object.ChangeHistoryRows.Count >= _object.ChangeHistoryTotal)" />
                    @if (_object.ChangeHistoryRows.Count < _object.ChangeHistoryTotal)
                    {
                        <div class="d-flex justify-center mt-3">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Secondary"
                                       Disabled="@_object.ChangeHistoryLoading"
                                       OnClick="LoadMoreChangeHistoryAsync">
                                @if (_object.ChangeHistoryLoading)
                                {
                                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="me-2" />
                                }
                                Load more (@($"{_object.ChangeHistoryTotal - _object.ChangeHistoryRows.Count:N0}") remaining)
                            </MudButton>
                        </div>
                    }
                }
            </div>
        </MudTabPanel>

        <MudTabPanel Text="Properties" Icon="@Icons.Material.Filled.Assignment">
            <MudPaper Class="pa-4" Outlined="true">
                <MudGrid Spacing="4">
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Id</MudText>
                        <br />
                        <MudTooltip Text="Click to copy">
                            <ChildContent>
                                <MudText Typo="Typo.body1" Style="cursor: pointer; word-break: break-all;" @onclick="@(() => CopyToClipboardAsync(MetaverseObject.Id.ToString()))">
                                    @MetaverseObject.Id
                                </MudText>
                            </ChildContent>
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Created</MudText>
                        <br />
                        <MudTooltip Text="@MetaverseObject.Created.ToString("O")">
                            <ChildContent>
                                <MudText Typo="Typo.body1">@MetaverseObject.Created.ToFriendlyDate()</MudText>
                            </ChildContent>
                        </MudTooltip>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Created By</MudText>
                        <br />
                        @if (_object.CreatedByHref != null)
                        {
                            <MudLink Typo="Typo.body1" Href="@_object.CreatedByHref">@_object.CreatedByName</MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body1">@(_object.CreatedByName ?? "—")</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Last Updated</MudText>
                        @if (MetaverseObject.LastUpdated.HasValue)
                        {
                            <MudTooltip Text="@MetaverseObject.LastUpdated.Value.ToString("O")">
                                <ChildContent>
                                    <MudText Typo="Typo.body1">@MetaverseObject.LastUpdated.Value.ToFriendlyDate()</MudText>
                                </ChildContent>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudText Typo="Typo.body1">—</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Last Updated By</MudText>
                        <br />
                        @if (_object.LastUpdatedByHref != null)
                        {
                            <MudLink Typo="Typo.body1" Href="@_object.LastUpdatedByHref">@_object.LastUpdatedByName</MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body1">@(_object.LastUpdatedByName ?? "—")</MudText>
                        }
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Status</MudText>
                        <MudText Typo="Typo.body1">@MetaverseObject.Status</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="4">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Origin</MudText>
                        <MudText Typo="Typo.body1">@MetaverseObject.Origin</MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        </MudTabPanel>

        @* ─── Connections ─── *@
        @* Every Connected System Object joined to this Metaverse Object, its role in synchronisation, its  *@
        @* derived State and a per-row Preview Sync, plus Preview Exports: the export-only preview of it as it stands  *@
        @* (#1519, D-S6). Which systems hold data about someone is not something every signed-in user may *@
        @* see about every other person, so the tab carries its own Administrator gate, as Password does.  *@
        <AuthorizeView Roles="Administrator" Context="connectionsAuth">
            <MudTabPanel Text="Connections" Icon="@Icons.Material.Filled.Hub" BadgeColor="Color.Primary"
                         BadgeData="@(_object.ConnectorCount > 0 ? _object.ConnectorCount.ToString("N0") : null)">
                <div>
                    <MetaverseObjectConnectionsTable IsLoading="_object.ConnectionsLoading" IsLoaded="_object.ConnectionsLoaded"
                                                      Connections="_object.Connections" PreviewLoading="_object.ConnectionPreviewLoading"
                                                      OnPreview="PreviewConnectionAsync" />

                    @if (_object.ConnectionPreviewResult != null)
                    {
                        <div class="mt-6">
                            <SyncPreviewPanel PreviewResult="_object.ConnectionPreviewResult" Context="_object.ConnectionPreviewContext!" OnClose="CloseConnectionPreview" />
                        </div>
                    }

                    @* The secondary preview: what putting this Metaverse Object's current state to every enabled
                       export Synchronisation Rule would do, with no inbound step (#1519, D-S6). Below the
                       per-object table because the table's Preview Sync is the primary preview; this one answers
                       a narrower question, and lives on this tab because it is this object's synchronisation tab. *@
                    <MudPaper Class="pa-4 mt-6" Outlined="true">
                        <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="4" data-testid="jim-mvo-action-preview-outbound">
                            <MudIcon Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Class="mt-1" />
                            <MudStack Spacing="1" Class="flex-grow-1">
                                <MudText Typo="Typo.h6">Preview Exports</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    What JIM would export for this Metaverse Object as it stands: where it would be
                                    provisioned, updated or deprovisioned under each enabled export Synchronisation Rule.
                                    Nothing is imported first.
                                    @if (_object.Connections.Count > 0)
                                    {
                                        <text>To preview synchronising one of its connections, use that row's Preview Sync.</text>
                                    }
                                </MudText>
                            </MudStack>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" DropShadow="false"
                                       Disabled="@_object.OutboundPreviewLoading"
                                       OnClick="PreviewOutboundAsync"
                                       data-testid="jim-mvo-preview-outbound">
                                @(_object.OutboundPreviewLoading ? "Previewing…" : "Preview")
                            </MudButton>
                        </MudStack>
                    </MudPaper>

                    @if (_object.OutboundPreviewResult != null)
                    {
                        <div class="mt-6">
                            <SyncPreviewPanel PreviewResult="_object.OutboundPreviewResult" Context="BuildOutboundPreviewContext()" OnClose="CloseOutboundPreview" />
                        </div>
                    }
                </div>
            </MudTabPanel>
        </AuthorizeView>

        @* ─── Password ─── *@
        @* Both a report and an action: what this person's password did on each of their systems, and the one    *@
        @* operation that sets it (#1635). Neither is something every signed-in user may see or do to every other *@
        @* person (the history says where somebody has accounts; the set is a reset primitive), and this page is  *@
        @* visible to every signed-in user, so the whole tab carries an Administrator gate rather than inheriting *@
        @* the page's (issue #1172). Badged red with the changes nothing will move without a person: parked plus *@
        @* expired, the same count the Passwords tab of Operations carries per person.                            *@
        <AuthorizeView Roles="Administrator" Context="passwordAuth">
            <MudTabPanel Text="Password" Icon="@Icons.Material.Filled.Key" BadgeColor="Color.Error"
                         BadgeData="@(_object.PasswordAttentionCount > 0 ? _object.PasswordAttentionCount.ToString("N0") : null)">
                <MetaverseObjectPasswordPanel MetaverseObjectId="@(MetaverseObject?.Id ?? Guid.Empty)"
                                              MetaverseObjectTypeName="@(MetaverseObjectType?.Name ?? "Metaverse Object")"
                                              Events="@_object.PasswordEvents"
                                              QueuedChanges="@_object.QueuedPasswordChanges"
                                              Accounts="@_object.PasswordAccounts"
                                              Loading="@(!_object.PasswordTabLoaded)"
                                              Busy="@_object.PasswordActionRunning"
                                              OnSetPassword="OpenSetPasswordDialogAsync"
                                              OnRetry="RetryPasswordChangeAsync"
                                              OnStopTrying="StopPasswordChangeAsync" />
            </MudTabPanel>
        </AuthorizeView>
        </ChildContent>
    </NavigableMudTabs>
}
    </Loaded>
</LoadingGate>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = null!;

    /// <summary>
    /// The slug NavigableMudTabs gives the Password tab: its text, lower-cased. Keyed on the slug rather than the
    /// panel index because the tab is gated on the Administrator role, so its index differs between readers.
    /// </summary>
    private const string PasswordTabSlug = "password";

    /// <summary>
    /// The slug NavigableMudTabs gives the Connections tab (#1519): its text, lower-cased.
    /// </summary>
    private const string ConnectionsTabSlug = "connections";

    /// <summary>
    /// The slug NavigableMudTabs gives the Changes tab: its text, lower-cased.
    /// </summary>
    private const string ChangesTabSlug = "changes";

    // Everything this page holds about the object it is showing, replaced (never cleared) when the reader moves to
    // another object; see MetaverseObjectViewState for why. The Changes, Connections and Password tabs load their
    // data when first opened rather than with the page: reads most visits never need, on a page every signed-in
    // user opens. Their badge counts are the exception, read with the page, because a badge that only appears once
    // its tab is opened is not a badge.
    private MetaverseObjectViewState _object = new(Guid.Empty);

    // The tab the reader is on, so moving to another object on the same tab can load that tab for the new object:
    // NavigableMudTabs only reports a change of tab, and the tab has not changed.
    private string? _activeTabSlug;

    /// <summary>
    /// Whether the reader may see another person's password history. The tab's own markup is gated the same
    /// way; this is the same decision made in code so the reads behind it are not run for readers who cannot.
    /// </summary>
    private async Task<bool> IsAdministratorAsync()
    {
        var state = await AuthenticationStateTask;
        return state.User.IsInRole("Administrator");
    }

    /// <summary>
    /// How many password changes the tab shows. Recent history, not an archive: the Activities list is where
    /// the whole record lives, and the tab links to the queue for what is still outstanding.
    /// </summary>
    private const int PasswordEventsShown = 10;

    /// <summary>
    /// How many outstanding queued changes the tab lists. Bounded by how many Connected Systems this person has
    /// an account in, so this is a guard against an absurd deployment rather than a page size.
    /// </summary>
    private const int MaximumQueuedChangesShown = 50;

    /// <summary>
    /// This person's outstanding queue rows, and from them the tab's badge: the rows nothing will move without a
    /// person (parked plus expired).
    /// <para>
    /// The count is not asked for: the list is bounded by how many Connected Systems this person has an account
    /// in, and counting it would be a second query to learn a number nothing on screen shows.
    /// </para>
    /// </summary>
    private static async Task LoadQueuedPasswordChangesAsync(JimApplication jim, MetaverseObjectViewState state)
    {
        var queued = await jim.PasswordSynchronisation.GetPendingPasswordChangesAsync(
            new PendingPasswordChangeFilter { MetaverseObjectId = state.ObjectId },
            startIndex: 0,
            count: MaximumQueuedChangesShown,
            sortBy: "queued",
            sortDescending: false,
            includeTotalCount: false);
        state.QueuedPasswordChanges = queued.Results;
        state.PasswordAttentionCount = state.QueuedPasswordChanges.Count(c =>
            c.Status is PendingPasswordChangeStatus.Parked or PendingPasswordChangeStatus.Expired);
    }

    /// <summary>
    /// Loads everything the Password tab shows: the history, the queue rows (again, so the tab is current even
    /// after a change made from the dialog) and the accounts behind the coverage line.
    /// <para>
    /// Two sources for the first two, deliberately. The queue row is deleted the moment a password arrives, so
    /// the queue alone would show this person's failures and none of their successes; the Activities are the
    /// durable record.
    /// </para>
    /// </summary>
    private async Task LoadPasswordTabAsync()
    {
        var state = _object;
        if (MetaverseObject == null || state.PasswordTabLoading)
            return;

        state.PasswordTabLoading = true;
        try
        {
            using var jim = JimFactory.Create();
            state.PasswordEvents = await jim.PasswordSynchronisation.GetEventsForMetaverseObjectAsync(state.ObjectId, PasswordEventsShown);
            await LoadQueuedPasswordChangesAsync(jim, state);
            state.PasswordAccounts = await jim.ConnectedSystems.GetAccountsForPasswordSetAsync(state.ObjectId);
            state.PasswordTabLoaded = true;
        }
        finally
        {
            state.PasswordTabLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Opens the set-password dialog over this person's accounts (issues #1172, #1635).
    /// <para>
    /// Nothing is preselected. Somebody resetting a forgotten password in one Connected System must not
    /// silently reset the others; Select all is one click for the case where that is what is wanted.
    /// </para>
    /// <para>
    /// Generation, the set and the stop are passed in as delegates rather than letting the dialog reach the
    /// application layer, so the dialog stays a piece of user interface with no knowledge of who is signed in or
    /// how JIM talks to a Connected System, and so the password it holds never travels further than those calls.
    /// </para>
    /// </summary>
    private async Task OpenSetPasswordDialogAsync()
    {
        if (MetaverseObject == null)
            return;

        // The dialog acts on the person it was opened for, whatever the page goes on to show behind it.
        var state = _object;
        var displayName = _displayName ?? state.ObjectId.ToString();
        var parameters = new DialogParameters<SetPasswordDialog>
        {
            { x => x.Accounts, state.PasswordAccounts },
            { x => x.MetaverseObjectId, state.ObjectId },
            { x => x.AllowSelection, true },
            { x => x.Reconcile, ReconcilePasswordPolicies },
            { x => x.GeneratePassword, GeneratePassword },
            { x => x.SetPassword, submission => SetPasswordAsync(state.ObjectId, displayName, submission) },
            { x => x.StopTrying, connectedSystemId => CancelPasswordChangeAsync(state.ObjectId, connectedSystemId) }
        };

        // The name only when there is one: an object with no display name would otherwise be titled with a
        // dangling colon.
        var title = string.IsNullOrWhiteSpace(_displayName) ? "Set Password" : $"Set Password: {_displayName}";
        var dialog = await DialogService.ShowAsync<SetPasswordDialog>(title, parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true });

        // A change was queued, so the history and the queue rows behind this tab have moved on.
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: true })
            await ReloadPasswordTabIfShownAsync(state);
    }

    /// <summary>
    /// Works out one set of generator settings that satisfies every selected Connected System, so a password
    /// generated for several accounts is not simply the first system's rules applied to all of them.
    /// </summary>
    private PasswordPolicyReconciliation ReconcilePasswordPolicies(IReadOnlyList<MetaverseObjectAccount> accounts)
    {
        using var jim = JimFactory.Create();
        return jim.PasswordGenerator.Reconcile(accounts
            .Select(a => new PasswordPolicyForSystem { ConnectedSystemName = a.ConnectedSystemName, Policy = a.DiscoveredPolicy })
            .ToList());
    }

    private string GeneratePassword(PasswordGenerationPolicy policy)
    {
        using var jim = JimFactory.Create();
        return jim.PasswordGenerator.Generate(policy);
    }

    /// <summary>
    /// The one password operation (#1635), aimed at the accounts the administrator ticked.
    /// </summary>
    private async Task<PasswordQueueResult> SetPasswordAsync(Guid metaverseObjectId, string displayName, PasswordSetSubmission submission)
    {
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

        return await jim.PasswordSynchronisation.SetPasswordAsync(new SetPasswordRequest
        {
            MetaverseObjectId = metaverseObjectId,
            DisplayName = displayName,
            Password = submission.Password,
            Targets = submission.Targets,
            ExpiryBehaviour = submission.ExpiryBehaviour,
            EnableAccount = submission.EnableAccount,
            InitiatedBy = user
        }, CancellationToken.None);
    }

    /// <summary>
    /// Retries this person's parked change on one Connected System, from the tab's attention strip or its queue
    /// table. Zero is reported rather than passed over in silence: an administrator who acted and changed nothing
    /// needs to know that happened.
    /// </summary>
    private async Task RetryPasswordChangeAsync(int connectedSystemId)
    {
        var state = _object;
        if (MetaverseObject == null || state.PasswordActionRunning)
            return;

        state.PasswordActionRunning = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var retried = await jim.PasswordSynchronisation.RetryAsync(
                new PendingPasswordChangeFilter { MetaverseObjectId = state.ObjectId, ConnectedSystemId = connectedSystemId },
                user, null);

            Snackbar.Add(
                retried == 0 ? "Nothing was retried; the change is no longer on the queue." : "The password change will be attempted again.",
                retried == 0 ? Severity.Info : Severity.Success);
        }
        finally
        {
            state.PasswordActionRunning = false;
        }

        await ReloadPasswordTabIfShownAsync(state);
    }

    /// <summary>
    /// Stops JIM retrying this person's change on one Connected System, from the tab's queue table.
    /// </summary>
    private async Task StopPasswordChangeAsync(int connectedSystemId)
    {
        var state = _object;
        if (MetaverseObject == null || state.PasswordActionRunning)
            return;

        state.PasswordActionRunning = true;
        try
        {
            var cancelled = await CancelPasswordChangeAsync(state.ObjectId, connectedSystemId);
            Snackbar.Add(
                cancelled == 0 ? "Nothing was stopped; the change is no longer on the queue." : "The password change will not be delivered.",
                cancelled == 0 ? Severity.Info : Severity.Success);
        }
        finally
        {
            state.PasswordActionRunning = false;
        }

        await ReloadPasswordTabIfShownAsync(state);
    }

    /// <summary>
    /// Re-reads the Password tab after an action changed what it shows, provided the reader is still on the person
    /// the action was for; if they have moved on, that person's tab is read afresh whenever it is next shown.
    /// </summary>
    private async Task ReloadPasswordTabIfShownAsync(MetaverseObjectViewState state)
    {
        if (state == _object)
            await LoadPasswordTabAsync();
    }

    /// <summary>
    /// Cancels this person's queued change on one Connected System, attributed to the signed-in administrator.
    /// Shared by the tab's Stop trying action and the dialog's.
    /// </summary>
    private async Task<int> CancelPasswordChangeAsync(Guid metaverseObjectId, int connectedSystemId)
    {
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        return await jim.PasswordSynchronisation.CancelAsync(
            new PendingPasswordChangeFilter { MetaverseObjectId = metaverseObjectId, ConnectedSystemId = connectedSystemId },
            user, null);
    }

    [Parameter]
    public string TypeNameUrlParam { get; set; } = null!;
    [Parameter]
    public Guid IdParam { get; set; }
    private MetaverseObject? MetaverseObject { get; set; }
    private MetaverseObjectType? MetaverseObjectType { get; set; }
    private string? _displayName;
    private int _activeTabIndex = 0;
    private string _detailViewMode = "form";
    private Dictionary<string, int> _attributeValueTotalCounts = new();
    private List<BreadcrumbItem> _breadcrumbs = null!;

    // The Changes tab pages its rows via Load more.
    private const int ChangeHistoryPageSize = 50;

    // The Inspect view's Group by choice (#399). The reader's, not the object's, so it survives moving between
    // objects; the provenance it groups is loaded by this page (the Inspect table's host) rather than by
    // MvoDetailsTable itself, so that component stays a presentational renderer of parameters, testable in bUnit
    // without the application layer.
    private string _inspectGroupBy = "none";

    protected override async Task OnParametersSetAsync()
    {
        // If ?c= is present, force tabs view (overrides saved preference); ?view=inspect does the same for
        // Inspect, checked after so it wins when a link carries both (it never should, but a link is only ever
        // written by JIM's own code, per the Inspect discoverability links in #399).
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (query["c"] != null)
        {
            _detailViewMode = "tabs";
        }
        else
        {
            // Load user's preferred detail view mode (form, tabs, or table)
            try
            {
                var savedMode = await UserPreferences.GetMvoDetailViewModeAsync();
                if (savedMode != null)
                    _detailViewMode = savedMode;
            }
            catch
            {
                // JS interop not yet available; keep default
            }
        }
        if (query["view"] == "inspect")
            _detailViewMode = "table";

        // ?group=none|source|category deep-links the Inspect view's grouping; otherwise fall back to the
        // saved preference, defaulting to "none".
        var groupParam = query["group"];
        if (groupParam is "none" or "source" or "category")
        {
            _inspectGroupBy = groupParam;
        }
        else
        {
            try
            {
                _inspectGroupBy = await UserPreferences.GetMvoInspectGroupByAsync() ?? "none";
            }
            catch (InvalidOperationException)
            {
                // JS interop not yet available; keep default
            }
        }

        // ?attr={attributeId} opens that attribute's inspector once the object has loaded, below.
        int? pendingInspectAttributeId = int.TryParse(query["attr"], out var parsedAttributeId) ? parsedAttributeId : null;

        using var jim = JimFactory.Create();
        var pluralName = Helpers.ConvertFromUrlParam(TypeNameUrlParam);
        MetaverseObjectType = await jim.Metaverse.GetMetaverseObjectTypeByPluralNameAsync(pluralName, false);
        if (MetaverseObjectType == null)
        {
            NavManager.NavigateTo("/");
            return;
        }

        // Load MVO with capped MVA values for efficient rendering
        var detailResult = await jim.Metaverse.GetMetaverseObjectDetailAsync(IdParam, MvoAttributeLoadStrategy.CappedMva);
        if (detailResult == null)
        {
            NavManager.NavigateTo("/");
            return;
        }

        MetaverseObject = detailResult.MetaverseObject;
        _attributeValueTotalCounts = detailResult.AttributeValueTotalCounts;
        _displayName = MetaverseObject.NameOrId;

        // A navigation from one person to another reuses this component: what was loaded about, or opened on, the
        // previous object goes with its state, and any load still running for it lands there rather than here.
        var objectChanged = _object.ObjectId != MetaverseObject.Id;
        if (objectChanged)
            _object = new MetaverseObjectViewState(MetaverseObject.Id);
        var state = _object;

        state.ChangeCount = detailResult.ChangeCount;
        state.ConnectorCount = detailResult.ConnectorCount;
        if (detailResult.EarliestChangeInitiator != null)
        {
            state.CreatedByName = detailResult.EarliestChangeInitiator.InitiatedByName;
            state.CreatedByHref = GetInitiatorHref(detailResult.EarliestChangeInitiator.InitiatedByType, detailResult.EarliestChangeInitiator.InitiatedById);
        }
        if (detailResult.LatestChangeInitiator != null)
        {
            state.LastUpdatedByName = detailResult.LatestChangeInitiator.InitiatedByName;
            state.LastUpdatedByHref = GetInitiatorHref(detailResult.LatestChangeInitiator.InitiatedByType, detailResult.LatestChangeInitiator.InitiatedById);
        }
        state.Retirements = await jim.UniqueValues.GetRetiredValuesForObjectAsync(state.ObjectId);

        // Only the Password tab's badge is read with the page; the rest of the tab loads on its first activation
        // (see LoadTabAsync). One bounded read, and only for the readers who can see the tab.
        if (await IsAdministratorAsync())
            await LoadQueuedPasswordChangesAsync(jim, state);

        if (MetaverseObject.NameOrId != null)
            _breadcrumbs = new List<BreadcrumbItem>
            {
                new("Home", href: "/", icon: Icons.Material.Filled.Home),
                new(MetaverseObjectType.PluralName, href: $"/t/{MetaverseObjectType.PluralName.ToLower()}"),
                new(MetaverseObjectType.Name, href: null, disabled: true)
            };

        // Load the Inspect view's provenance only when it is actually shown (#399); Form and Tabs never need it.
        if (_detailViewMode == "table")
        {
            await EnsureProvenanceLoadedAsync();
            if (pendingInspectAttributeId.HasValue)
                await OpenAttributeInspectorAsync(pendingInspectAttributeId.Value);
        }

        // Arriving at another object on the tab the reader is already on (a link or history entry carrying the same
        // ?t=) changes no tab, so the tabs report nothing; the tab is loaded for the new object here instead.
        if (objectChanged)
            await LoadTabAsync(_activeTabSlug);
    }

    private async Task OnDetailViewModeChangedAsync(string mode)
    {
        _detailViewMode = mode;
        await UserPreferences.SetMvoDetailViewModeAsync(_detailViewMode);

        if (mode == "table")
        {
            await EnsureProvenanceLoadedAsync();
        }
        else
        {
            // Leaving Inspect: its state belongs to that view only, so a later switch back starts clean rather
            // than reopening whatever attribute or filter happened to be active last time.
            _object.SelectedAttributeId = null;
            _object.SelectedAttributeProvenance = null;
            _object.ContributionFilterKey = null;
        }

        // Clean up the one-shot ?c=/?view= entry triggers, and, once Inspect is left, its ?attr=/?group= state.
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var changed = false;
        if (mode != "tabs" && query["c"] != null)
        {
            query.Remove("c");
            changed = true;
        }
        if (query["view"] != null)
        {
            query.Remove("view");
            changed = true;
        }
        if (mode != "table")
        {
            if (query["attr"] != null) { query.Remove("attr"); changed = true; }
            if (query["group"] != null) { query.Remove("group"); changed = true; }
        }
        if (changed)
            NavigateReplacingQuery(uri, query);
    }

    /// <summary>
    /// Loads this Metaverse Object's attribute provenance (#399) once per object, for the Inspect view's
    /// contribution bar and Source column, with its generated-value assignments (#242) for the table's value
    /// cells. A no-op once already loaded (or loading) for the current object.
    /// </summary>
    private async Task EnsureProvenanceLoadedAsync()
    {
        var state = _object;
        if (MetaverseObject == null || state.ProvenanceLoaded)
            return;

        state.ProvenanceLoaded = true;
        state.ProvenanceLoading = true;
        StateHasChanged();
        try
        {
            using var jim = JimFactory.Create();
            state.Provenance = await jim.Metaverse.GetMetaverseObjectProvenanceAsync(state.ObjectId);
        }
        finally
        {
            state.ProvenanceLoading = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Loads one attribute's full provenance (#399) for the attribute inspector side panel, opening it.
    /// </summary>
    private async Task OpenAttributeInspectorAsync(int attributeId)
    {
        var state = _object;
        if (MetaverseObject == null)
            return;

        state.SelectedAttributeId = attributeId;
        state.SelectedAttributeProvenance = null;
        state.AttributeInspectorLoading = true;
        StateHasChanged();
        try
        {
            using var jim = JimFactory.Create();
            state.SelectedAttributeProvenance = await jim.Metaverse.GetMetaverseAttributeProvenanceAsync(state.ObjectId, attributeId);
        }
        finally
        {
            state.AttributeInspectorLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnAttributeSelectedAsync(int attributeId)
    {
        await OpenAttributeInspectorAsync(attributeId);
        UpdateQueryString(("attr", attributeId.ToString()));
    }

    private Task OnCloseInspectorAsync()
    {
        _object.SelectedAttributeId = null;
        _object.SelectedAttributeProvenance = null;
        UpdateQueryString(("attr", null));
        return Task.CompletedTask;
    }

    private async Task OnInspectGroupByChangedAsync(string groupBy)
    {
        _inspectGroupBy = groupBy;
        await UserPreferences.SetMvoInspectGroupByAsync(groupBy);
        UpdateQueryString(("group", groupBy == "none" ? null : groupBy));
    }

    private Task OnContributionFilterChangedAsync(string? key)
    {
        _object.ContributionFilterKey = key;
        return Task.CompletedTask;
    }

    /// <summary>
    /// "Open in Timeline" from the attribute inspector: closes it and switches to the Changes tab, reusing the
    /// same lazy-load path a manual click on that tab uses. It does not filter the Timeline to the attribute;
    /// <c>ChangeHistoryTimeline</c> owns its own search box for that (#399 leaves that component alone).
    /// </summary>
    private async Task OpenAttributeInTimelineAsync()
    {
        _object.SelectedAttributeId = null;
        _object.SelectedAttributeProvenance = null;
        UpdateQueryString(("attr", null));
        _activeTabIndex = 1;
        _activeTabSlug = ChangesTabSlug;
        await LoadTabAsync(ChangesTabSlug);
    }

    /// <summary>Applies one or more query-string changes (null value removes the key) via a history-replacing navigation.</summary>
    private void UpdateQueryString(params (string Key, string? Value)[] updates)
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        foreach (var (key, value) in updates)
        {
            if (value == null)
                query.Remove(key);
            else
                query[key] = value;
        }
        NavigateReplacingQuery(uri, query);
    }

    private void NavigateReplacingQuery(Uri uri, System.Collections.Specialized.NameValueCollection query)
    {
        var baseUri = uri.GetLeftPart(UriPartial.Path);
        var qs = query.ToString();
        var newUrl = string.IsNullOrEmpty(qs) ? baseUri : $"{baseUri}?{qs}";
        NavManager.NavigateTo(newUrl, new NavigationOptions { ReplaceHistoryEntry = true });
    }

    private string GetChangeBadge()
    {
        return (_object.ChangeCount + _object.Retirements.Count).ToString("N0");
    }

    private void OnActiveTabIndexChanged(int newIndex)
    {
        _activeTabIndex = newIndex;
    }

    private async Task LoadConnectionsAsync()
    {
        var state = _object;
        if (MetaverseObject == null)
            return;

        state.ConnectionsLoading = true;
        StateHasChanged();
        try
        {
            using var jim = JimFactory.Create();
            state.Connections = await jim.Metaverse.GetMetaverseObjectConnectionsAsync(state.ObjectId);
            state.ConnectionsLoaded = true;
            state.ConnectorCount = state.Connections.Count; // the badge agrees with the table once the table has loaded
        }
        finally
        {
            state.ConnectionsLoading = false;
            StateHasChanged();
        }
    }

    private async Task PreviewConnectionAsync(MetaverseObjectConnection connection)
    {
        var state = _object;
        state.ConnectionPreviewLoading = true;
        StateHasChanged();
        try
        {
            using var jim = JimFactory.Create();
            state.ConnectionPreviewResult = await jim.SyncPreview.PreviewSyncForCsoAsync(connection.ConnectedSystemId, connection.ConnectedSystemObjectId);
            state.ConnectionPreviewContext = new CausalityPageContext(
                ConnectedSystemId: connection.ConnectedSystemId,
                ConnectedSystemName: connection.ConnectedSystemName,
                RunProfileName: "Full Synchronisation",
                CsoId: connection.ConnectedSystemObjectId,
                CsoConnectedSystemId: connection.ConnectedSystemId,
                CsoConnectedSystemName: connection.ConnectedSystemName,
                CsoDisplayName: connection.DisplayName,
                CsoExternalId: null,
                CsoObjectTypeName: connection.ObjectTypeName,
                MvoTypeName: MetaverseObjectType?.Name,
                MvoTypePluralName: MetaverseObjectType?.PluralName);
            if (state.ConnectionPreviewResult.HasBlockingErrors)
                Snackbar.Add("The Sync Preview could not complete; see the details below.", Severity.Warning);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add($"The Sync Preview failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            state.ConnectionPreviewLoading = false;
            StateHasChanged();
        }
    }

    private void CloseConnectionPreview()
    {
        _object.ConnectionPreviewResult = null;
        _object.ConnectionPreviewContext = null;
    }

    /// <summary>
    /// Evaluates this Metaverse Object's current state against every enabled export Synchronisation Rule
    /// (#1519, D-S6): the secondary preview on the Connections tab. No inbound step, unlike the Connections
    /// tab's per-object preview above.
    /// </summary>
