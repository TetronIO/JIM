@* Composes one Object Matching Rule (#2052), for the Connected System's Matching tab (simple mode) and a
   Synchronisation Rule's (advanced mode) alike. The rule compares a Connected System attribute, or an expression over
   the Connected System Object, with a Metaverse attribute, for equality and nothing else. The host owns what happens
   to the finished draft (saving it, or adding it to a Synchronisation Rule) and gates its own buttons on
   Draft.CanAdd; this keeps Draft.Problem current, so a rule the save would refuse says why before anyone asks. *@

<div class="d-flex align-center flex-wrap gap-3">
    <MudText Typo="Typo.button" Class="mud-text-secondary">Match on</MudText>
    <SegmentedToggle TValue="ObjectMatchingRuleSourceKind" Options="SourceKindOptions" Value="@Draft.SourceKind"
                     ValueChanged="SetSourceKindAsync" AriaLabel="Match on" TestId="jim-matching-rule-source-kind" />
</div>

@* One geometry for both kinds of source, so switching between them swaps the left cell and nothing else: the
   Metaverse attribute stays where the eye left it. *@
<MudGrid Class="mt-1">
    <MudItem xs="12" md="5">
        @if (Draft.SourceKind == ObjectMatchingRuleSourceKind.Attribute)
        {
            @* Credential attributes are left out: JIM never imports them, so there would be no value to match on. *@
            <MudSelect T="ConnectedSystemObjectTypeAttribute" Value="@Draft.SourceAttribute" ValueChanged="SetSourceAttributeAsync"
                       Label="Connected System Attribute" Variant="Variant.Outlined"
                       ToStringFunc="@(a => a?.Name ?? string.Empty)"
                       HelperText="Every value it holds is looked up">
                @foreach (var csAttribute in SelectableAttributes)
                {
                    <MudSelectItem Value="@csAttribute">
                        @csAttribute.Name <span class="mud-text-secondary">(@csAttribute.Type)</span>
                    </MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <ExpressionEditor @ref="_expressionEditor" @bind-Value="Draft.Expression" @bind-Value:after="OnDraftChangedAsync"
                              Id="object-matching-rule-expression" Label="Expression" Required="true"
                              Placeholder="@ExpressionPlaceholder" HelperText="@ExpressionHelperText" />
            <div class="mt-1">
                <InsertAttributeMenu MetaverseAttributes="null"
                                     ConnectedSystemAttributes="SelectableAttributes"
                                     ConnectedSystemName="@ConnectedSystemName"
                                     Direction="SyncRuleDirection.Import"
                                     OnInsert="InsertIntoExpressionAsync" />
            </div>
        }
    </MudItem>
    @* Aligned to the inputs' row, not centred on the cell: an expression's cell grows with its helper text and the
       Insert attribute menu, and centring would leave "equals" hanging below both fields. *@
    <MudItem xs="12" md="2" Class="d-flex justify-center">
        <MudText Typo="Typo.body1" Class="mud-text-secondary jim-matching-rule-equals">equals</MudText>
    </MudItem>
    <MudItem xs="12" md="5">
        @TargetAttributeSelect
    </MudItem>
</MudGrid>

@if (MetaverseObjectTypes != null)
{
    @* Where the rule looks. A simple mode rule has no Synchronisation Rule to take this from, so one that names no
       type searches nothing and silently matches nothing (#1458). *@
    <MudGrid Class="mt-1">
        <MudItem xs="12" md="5">
            <MudSelect T="MetaverseObjectType" Value="@Draft.MetaverseObjectType" ValueChanged="SetMetaverseObjectTypeAsync"
                       Label="Metaverse Object Type" Variant="Variant.Outlined"
                       ToStringFunc="@(t => t?.Name ?? string.Empty)"
                       HelperText="The type of Metaverse Object this rule searches">
                @foreach (var objectTypeOption in MetaverseObjectTypes.OrderBy(t => t.Name))
                {
                    <MudSelectItem Value="@objectTypeOption">@objectTypeOption.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>
}

<MudCheckBox T="bool" Value="@Draft.CaseSensitive" ValueChanged="SetCaseSensitiveAsync"
             Label="Case sensitive" Color="Color.Primary" Class="mt-3" />
<MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
    Follows the source: on when the source attribute's values are case-exact, otherwise off, so "John" matches "JOHN". Turn it on only when this system treats identifiers differing only in case as different objects.
</MudText>

@if (Draft.Problem != null)
{
    <MudAlert Severity="Severity.Warning" Class="mt-3" data-testid="jim-matching-rule-problem">@Draft.Problem</MudAlert>
}

@* ─── Try it: what the rule would compare for an object holding these values ─── *@
@if (Draft.IsComplete && Draft.Problem == null)
{
    <MudText Typo="Typo.subtitle2" Class="mt-5">Try it</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
        Give a value for each attribute the rule reads and see what it would match on, worked out exactly as a
        synchronisation would. Leave a value empty to see what happens to an object that has none.
    </MudText>
    <MudGrid Spacing="2">
        @foreach (var input in TryItInputs)
        {
            var attributeName = input.AttributeName;
            <MudItem xs="12" sm="6" @key="attributeName">
                <MudTextField T="string" Label="@input.Accessor" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" Value="@_samples.GetValueOrDefault(attributeName)"
                              ValueChanged="@(value => SetSample(attributeName, value))" />
            </MudItem>
        }
    </MudGrid>
    <div class="mt-3" data-testid="jim-matching-rule-try-it">
        <MudButton Variant="Variant.Outlined" OnClick="TryIt">Try it</MudButton>
    </div>

    @if (_tryItResult is { } result)
    {
        <div class="mt-3" data-testid="jim-matching-rule-try-it-result">
            @switch (result.Kind)
            {
                case MatchValueResolutionKind.Values:
                    <MudPaper Outlined="true" Class="pa-3">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Would match on</MudText>
                        @foreach (var matchValue in result.Values)
                        {
                            <MudText Typo="Typo.body1" Class="jim-expression-output">@Convert.ToString(matchValue, CultureInfo.InvariantCulture)</MudText>
                        }
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Type: @result.ValueType</MudText>
                    </MudPaper>
                    break;
                case MatchValueResolutionKind.NoValue:
                    <MudAlert Severity="Severity.Info">
                        No value to match on, so this rule would be skipped for an object like this and the next rule tried.
                    </MudAlert>
                    break;
                default:
                    <MudAlert Severity="Severity.Error">
                        An object like this would stop with an Object Matching Rule Failed error, neither joined nor
                        projected: @result.FailureMessage
                    </MudAlert>
                    break;
            }
        </div>
    }
}

@code {
    /// <summary>The rule being composed. Edited in place; <see cref="OnChanged"/> is raised after each edit.</summary>
    [Parameter, EditorRequired]
    public ObjectMatchingRuleDraft Draft { get; set; } = null!;

    /// <summary>The Connected System Object Type the rule reads, with its attributes.</summary>
    [Parameter, EditorRequired]
    public ConnectedSystemObjectType ObjectType { get; set; } = null!;

    /// <summary>The Metaverse attributes the rule can compare with. Those of a type matching cannot compare are listed but disabled.</summary>
    [Parameter]
    public IEnumerable<MetaverseAttribute> MetaverseAttributes { get; set; } = [];

    /// <summary>
    /// The Metaverse Object Types a simple mode rule can search. Null in advanced mode, where the Synchronisation Rule
    /// supplies the type, so the editor does not ask.
    /// </summary>
    [Parameter]
    public IEnumerable<MetaverseObjectType>? MetaverseObjectTypes { get; set; }

    /// <summary>The Connected System's name, for the Insert attribute menu.</summary>
    [Parameter]
    public string? ConnectedSystemName { get; set; }

    /// <summary>Raised after each edit, so the host's gated buttons follow the draft.</summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    private static readonly IReadOnlyList<SegmentedToggleOption<ObjectMatchingRuleSourceKind>> SourceKindOptions =
    [
        new(ObjectMatchingRuleSourceKind.Attribute, "Attribute", "jim-matching-rule-source-attribute",
            Tooltip: "Match on the values a Connected System attribute holds"),
        new(ObjectMatchingRuleSourceKind.Expression, "Expression", "jim-matching-rule-source-expression",
            Tooltip: "Match on a value worked out from the Connected System Object, for identifiers that differ in format between systems")
    ];

    private const string ExpressionPlaceholder = "e.g. \"E\" + Trim(cs[\"employeeId\"])";
    private const string ExpressionHelperText =
        "Reads the Connected System Object only, as cs[\"attributeName\"]. Its result is converted to the Metaverse attribute's type.";

    private ExpressionEditor? _expressionEditor;
    private ObjectMatchingRuleValidator? _validator;
    private readonly Dictionary<string, string?> _samples = new(StringComparer.OrdinalIgnoreCase);
    private MatchValueResolution? _tryItResult;

    /// <summary>The attributes a rule can read: those JIM imports, never a credential.</summary>
    private IReadOnlyList<ConnectedSystemObjectTypeAttribute> SelectableAttributes =>
    [
        .. ObjectType.Attributes
            .Where(a => a.Selected && !CredentialAttributes.IsCredentialAttribute(a.Name))
            .OrderBy(a => a.Name)
    ];

    /// <summary>The attributes Try it asks a value for: the one the rule reads, or each one its expression reads.</summary>
    private IReadOnlyList<ExpressionInput> TryItInputs => Draft.SourceKind == ObjectMatchingRuleSourceKind.Expression
        ? [.. ExpressionInputResolver.Resolve(Draft.Expression).Where(input => input.Source == ExpressionInputSource.ConnectedSystem)]
        : Draft.SourceAttribute is { } sourceAttribute
            ? [new ExpressionInput(ExpressionInputSource.ConnectedSystem, sourceAttribute.Name)]
            : [];

    private RenderFragment TargetAttributeSelect => __builder =>
    {
        <MudSelect T="MetaverseAttribute" Value="@Draft.TargetAttribute" ValueChanged="SetTargetAttributeAsync"
                   Label="Metaverse Attribute" Variant="Variant.Outlined"
                   ToStringFunc="@(a => a?.Name ?? string.Empty)"
                   HelperText="The Metaverse attribute the value is compared with">
            @foreach (var mvAttribute in MetaverseAttributes.OrderBy(a => a.Name))
            {
                var matchable = ObjectMatchingRule.IsMatchableType(mvAttribute.Type);
                <MudSelectItem Value="@mvAttribute" Disabled="@(!matchable)">
                    @mvAttribute.Name <span class="mud-text-secondary">(@mvAttribute.Type@(matchable ? "" : ", cannot be matched on"))</span>
                </MudSelectItem>
            }
        </MudSelect>
    };

    protected override void OnParametersSet()
    {
        _validator ??= new ObjectMatchingRuleValidator(ExpressionEvaluator);
        RefreshProblem();
    }

    private Task SetSourceKindAsync(ObjectMatchingRuleSourceKind kind)
    {
        Draft.SourceKind = kind;
        return OnDraftChangedAsync();
    }

    private Task SetSourceAttributeAsync(ConnectedSystemObjectTypeAttribute? attribute)
    {
        Draft.SourceAttribute = attribute;
        return OnDraftChangedAsync();
    }

    private Task SetTargetAttributeAsync(MetaverseAttribute? attribute)
    {
        Draft.TargetAttribute = attribute;
        return OnDraftChangedAsync();
    }

    private Task SetMetaverseObjectTypeAsync(MetaverseObjectType? objectType)
    {
        Draft.MetaverseObjectType = objectType;
        return OnDraftChangedAsync();
    }

    private Task SetCaseSensitiveAsync(bool caseSensitive)
    {
        Draft.CaseSensitive = caseSensitive;
        return OnDraftChangedAsync();
    }

    private Task InsertIntoExpressionAsync(string accessor) =>
        _expressionEditor?.InsertAtCursorAsync(accessor) ?? Task.CompletedTask;

    private async Task OnDraftChangedAsync()
    {
        // An answer belongs to the rule that produced it; kept beside a changed rule it would answer a question
        // nobody asked.
        _tryItResult = null;
        RefreshProblem();
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Judges the draft as the save would, once it names what it compares. An incomplete draft is not a problem, only
    /// unfinished, and saying otherwise while it is being filled in would be noise.
    /// </summary>
    private void RefreshProblem() =>
        Draft.Problem = Draft.IsComplete && Draft.TargetAttribute is { } target && _validator != null
            ? _validator.DescribeProblem(Draft.ToRule(0), ObjectType, target)
            : null;

    private void SetSample(string attributeName, string? value)
    {
        _samples[attributeName] = value;
        _tryItResult = null;
    }

    private void TryIt()
    {
        if (!Draft.IsComplete || Draft.Problem != null)
            return;

        using var jim = JimFactory.Create();
        var samples = TryItInputs.ToDictionary(
            input => input.AttributeName,
            input => _samples.GetValueOrDefault(input.AttributeName),
            StringComparer.OrdinalIgnoreCase);
        _tryItResult = jim.ObjectMatching.ResolveSampleMatchValues(Draft.ToRule(0), ObjectType, samples);
    }
}
