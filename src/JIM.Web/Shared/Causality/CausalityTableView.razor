@* The causality Table view (#1519 Phase 3): a left navigation of every object the causality events
   touched (severity dot, name, subtitle, row-count pill), grouped by role in the chain, with
   "Everything" first; and a grid of the selected object's rows, filterable by change kind and
   sortable by column. Values render in the app's shared code face so old and new line up; a removed
   value's Current reading is struck through, and a row whose outcome is destructive or constructive
   colours its would-be text with the same tone the Timeline and Lineage already use for that event.
   Selecting Everything adds a leading Object column so a row's owner is never ambiguous. *@

<div class="tv" @ref="_panelRef">
    <nav class="tv-nav" aria-label="Objects touched">
        @RenderNavButton(EverythingObject)
        @if (SourceObject is { } source)
        {
            <div class="tv-group-caption">Object being synchronised</div>
            @RenderNavButton(source)
        }
        @if (IdentityObject is { } identity)
        {
            <div class="tv-group-caption">Metaverse Object</div>
            @RenderNavButton(identity)
        }
        @if (DownstreamObjects.Count > 0)
        {
            <div class="tv-group-caption">Downstream objects</div>
            @foreach (var downstream in DownstreamObjects)
            {
                @RenderNavButton(downstream)
            }
        }
    </nav>

    @* Drag-resizes the nav column; JS owns the live width (a per-pixel round trip through Blazor would
       lag), holding it as the --tv-nav-width custom property on the panel div above. Nothing here is
       persisted: a reload always returns to the 240px default the grid's var() fallback names. *@
    <div class="tv-resize-handle" role="separator" aria-orientation="vertical"
         aria-label="Resize the objects list" tabindex="0"
         @ref="_resizeHandleRef" @onkeydown="OnResizeHandleKeyDownAsync"></div>

    <div class="tv-main">
        <div class="tv-title-row">
            <div class="tv-title">
                <span class="tv-title-name">@SelectedObject.DisplayName</span>
                @if (!string.IsNullOrWhiteSpace(SelectedObject.Subtitle))
                {
                    <span class="tv-type-chip">@SelectedObject.Subtitle</span>
                }
            </div>
            <div class="filter-chips" role="group" aria-label="Filter by change">
                @foreach (var filter in Filters)
                {
                    <button type="button" class="@(filter == _filter ? "on" : null)"
                            aria-pressed="@(filter == _filter ? "true" : "false")"
                            @onclick="() => SetFilter(filter)">@GetFilterLabel(filter)</button>
                }
            </div>
        </div>

        <div class="tv-scroller">
            <table class="tg" @ref="_tableRef">
                @* One <col> per rendered column, following the Object column's own IsEverythingSelected
                   condition, so jimTableViewColumnResizer's snapshot-on-first-drag always maps one <col>
                   to one <th> (#1519 Table view fix 10). *@
                <colgroup>
                    @if (IsEverythingSelected)
                    {
                        <col />
                    }
                    <col />
                    <col />
                    <col />
                    <col />
                    <col />
                    <col />
                </colgroup>
                <thead>
                    <tr>
                        @if (IsEverythingSelected)
                        {
                            <th>@RenderHeader(0, "object", "Object")</th>
                        }
                        <th>@RenderHeader(ColumnIndex(0), "change", "Change")</th>
                        <th>@RenderHeader(ColumnIndex(1), "attribute", "Attribute")</th>
                        <th>@RenderHeader(ColumnIndex(2), "current", Model.CurrentHeading)</th>
                        <th>@RenderHeader(ColumnIndex(3), "wouldbe", Model.NextHeading)</th>
                        <th>@RenderHeader(ColumnIndex(4), "via", "Synchronisation Rule")</th>
                        <th>@RenderHeader(ColumnIndex(5), "outcome", "Outcome")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in VisibleRows)
                    {
                        <tr>
                            @if (IsEverythingSelected)
                            {
                                <td>@RenderObjectCell(row.ObjectKey)</td>
                            }
                            <td>
                                <span class="tv-kind" style="--tone: @CausalityToneCss.CssVar(row.Tone)">@row.ChangeKindLabel</span>
                            </td>
                            <td title="@EmptyToNull(row.Attribute)"><TextValueDisplay Value="@row.Attribute" /></td>
                            <td class="jim-text-code @(IsRemoval(row) ? "tv-removed" : null)" title="@EmptyToNull(row.Current)">
                                <TextValueDisplay Value="@row.Current" />
                            </td>
                            <td class="jim-text-code" style="@GetWouldBeStyle(row)" title="@EmptyToNull(row.WouldBe)">
                                <TextValueDisplay Value="@row.WouldBe" />
                            </td>
                            <td>@RenderSyncRuleCell(row)</td>
                            <td title="@GetOutcomeTitle(row)">
                                @row.OutcomeLabel
                                @if (!string.IsNullOrWhiteSpace(row.OutcomeDetail))
                                {
                                    <div class="tv-outcome-detail">@row.OutcomeDetail</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (VisibleRows.Count == 0)
            {
                <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                                 PrimaryText="No rows match this filter"
                                 SecondaryText="Choose All to see every change this object carries." />
            }
        </div>
    </div>
</div>

@code {
    private static readonly CausalityTableFilter[] Filters =
    [
        CausalityTableFilter.All, CausalityTableFilter.ScopeAndJoin, CausalityTableFilter.AttributeChanges,
        CausalityTableFilter.ObjectChanges, CausalityTableFilter.Destructive
    ];

    /// <summary>
    /// The Table view's model, built by <see cref="CausalityTableModelBuilder.Build"/>.
    /// </summary>
    [Parameter, EditorRequired]
    public CausalityTableModel Model { get; set; } = null!;

    /// <summary>
    /// The nav column never shrinks below this width, whichever way it is resized (drag or arrow keys).
    /// </summary>
    private const int MinNavWidthPx = 180;

    /// <summary>
    /// The nav column never grows past this fraction of the panel's own width, so the grid it shares the
    /// row with always keeps a usable share.
    /// </summary>
    private const double MaxNavWidthFraction = 0.5;

    /// <summary>
    /// How far Left/Right moves a drag handle (the nav's or a column's) per key press.
    /// </summary>
    private const int WidthNudgePx = 16;

    /// <summary>
    /// A table column never shrinks below this width, whichever way it is resized (drag or arrow keys).
    /// There is no maximum: unlike the nav column, a column has nothing else in the row to starve.
    /// </summary>
    private const int MinColumnWidthPx = 64;

    private string _selectedKey = string.Empty;
    private CausalityTableFilter _filter = CausalityTableFilter.All;
    private string _sortColumn = string.Empty;
    private bool _sortDescending;
    private CausalityTableModel? _builtFor;

    private ElementReference _panelRef;
    private ElementReference _resizeHandleRef;
    private ElementReference _tableRef;
    private bool _resizerAttached;
    private bool _columnResizerAttached;

    /// <summary>
    /// Whether the last render carried the Object column, so <see cref="OnAfterRenderAsync"/> can spot
    /// the one transition that invalidates any snapshotted column widths: the Everything selection
    /// gaining or losing that leading column when the selection switches between Everything and a
    /// single object. Null before the first render, so no reset fires on it.
    /// </summary>
    private bool? _lastRenderHadObjectColumn;

    protected override void OnParametersSet()
    {
        // A new model (a different Item/PreviewResult on the host panel) resets the selection and
        // filter; the same model instance re-rendering (e.g. the technical-names toggle) must not.
        if (ReferenceEquals(Model, _builtFor))
            return;

        _builtFor = Model;
        _selectedKey = EverythingObject.Key;
        _filter = CausalityTableFilter.All;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _resizerAttached = await InvokeInteropAsync<bool>(
                "jimTableViewResizer.attach", _resizeHandleRef, _panelRef, MinNavWidthPx, MaxNavWidthFraction);
            _columnResizerAttached = await InvokeInteropAsync<bool>(
                "jimTableViewColumnResizer.attach", _tableRef, MinColumnWidthPx);
        }

        // The column set only ever changes shape by gaining or losing the Object column, whether that is
        // the user switching the nav selection or a new Model resetting it back to Everything; either way
        // any widths jimTableViewColumnResizer snapshotted belong to the previous column set and must not
        // be carried onto columns they no longer describe.
        if (_lastRenderHadObjectColumn is { } hadObjectColumn && hadObjectColumn != IsEverythingSelected)
        {
            await InvokeInteropAsync<object>("jimTableViewColumnResizer.reset", _tableRef);
        }
        _lastRenderHadObjectColumn = IsEverythingSelected;
    }

    private async Task OnResizeHandleKeyDownAsync(KeyboardEventArgs e)
    {
        var delta = e.Key switch
        {
            "ArrowLeft" => -WidthNudgePx,
            "ArrowRight" => WidthNudgePx,
            _ => 0
        };
        if (delta == 0)
            return;

        await InvokeInteropAsync<object>("jimTableViewResizer.nudge", _panelRef, delta, MinNavWidthPx, MaxNavWidthFraction);
    }

    private async Task OnColumnGripKeyDownAsync(KeyboardEventArgs e, int columnIndex)
    {
        var delta = e.Key switch
        {
            "ArrowLeft" => -WidthNudgePx,
            "ArrowRight" => WidthNudgePx,
            _ => 0
        };
        if (delta == 0)
            return;

        await InvokeInteropAsync<object>("jimTableViewColumnResizer.nudge", _tableRef, columnIndex, delta, MinColumnWidthPx);
    }

    /// <summary>
    /// Calls into JS, treating "interop not ready yet" and "circuit already gone" as a quiet no-op rather
    /// than an error: both are reachable here, since this component talks to JavaScript from
    /// <see cref="OnAfterRenderAsync"/>, from a keyboard handler, and from disposal.
    /// </summary>
    private async Task<TResult?> InvokeInteropAsync<TResult>(string identifier, params object?[] args)
    {
        try
        {
            return await JS.InvokeAsync<TResult>(identifier, args);
        }
        catch (JSDisconnectedException)
        {
            return default;
        }
        catch (InvalidOperationException)
        {
            return default;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_resizerAttached)
            await InvokeInteropAsync<object>("jimTableViewResizer.detach", _resizeHandleRef);
        if (_columnResizerAttached)
            await InvokeInteropAsync<object>("jimTableViewColumnResizer.detach", _tableRef);
    }

    /// <summary>
    /// Maps a column's position counting from Change (0) to its actual rendered index, which shifts by
    /// one whenever the leading Object column is present.
    /// </summary>
    private int ColumnIndex(int indexExcludingObjectColumn) =>
        IsEverythingSelected ? indexExcludingObjectColumn + 1 : indexExcludingObjectColumn;

    private CausalityTableObject EverythingObject =>
        Model.Objects.First(o => o.Role == CausalityTableObjectRole.Everything);

    private CausalityTableObject? SourceObject =>
        Model.Objects.FirstOrDefault(o => o.Role == CausalityTableObjectRole.Source);

    private CausalityTableObject? IdentityObject =>
        Model.Objects.FirstOrDefault(o => o.Role == CausalityTableObjectRole.Identity);

    private List<CausalityTableObject> DownstreamObjects =>
        Model.Objects.Where(o => o.Role == CausalityTableObjectRole.Downstream).ToList();

    private CausalityTableObject SelectedObject =>
        Model.Objects.FirstOrDefault(o => o.Key == _selectedKey) ?? EverythingObject;

    private bool IsEverythingSelected => SelectedObject.Role == CausalityTableObjectRole.Everything;

    private List<CausalityTableRow> VisibleRows
    {
        get
        {
            IEnumerable<CausalityTableRow> rows = IsEverythingSelected
                ? Model.Rows
                : Model.Rows.Where(r => r.ObjectKey == SelectedObject.Key);

            rows = rows.Where(r => CausalityTableFilters.Matches(r, _filter));

            return Sort(rows).ToList();
        }
    }

    private IEnumerable<CausalityTableRow> Sort(IEnumerable<CausalityTableRow> rows)
    {
        IOrderedEnumerable<CausalityTableRow> Order<TKey>(Func<CausalityTableRow, TKey> key, IComparer<TKey>? comparer = null) =>
            _sortDescending ? rows.OrderByDescending(key, comparer) : rows.OrderBy(key, comparer);

        return _sortColumn switch
        {
            "object" => Order(r => GetObjectDisplayName(r.ObjectKey), StringComparer.OrdinalIgnoreCase),
            "change" => Order(r => r.ChangeKindLabel, StringComparer.OrdinalIgnoreCase),
            "attribute" => Order(r => r.Attribute, StringComparer.OrdinalIgnoreCase),
            "current" => Order(r => r.Current ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            "wouldbe" => Order(r => r.WouldBe ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            "via" => Order(r => r.Via ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            "outcome" => Order(r => r.OutcomeLabel, StringComparer.OrdinalIgnoreCase),
            // The order the model built the rows in: object-level rows first, then attribute rows.
            _ => rows
        };
    }

    private RenderFragment RenderNavButton(CausalityTableObject obj) => __builder =>
    {
        var selected = obj.Key == SelectedObject.Key;
        <button type="button" class="tv-nav-btn @(selected ? "on" : null)"
                aria-pressed="@(selected ? "true" : "false")"
                @onclick="() => SelectObject(obj.Key)">
            <span class="tv-dot" style="--tone: @CausalityToneCss.CssVar(obj.Tone)" aria-hidden="true"></span>
            <span class="tv-nav-text">
                <span class="tv-nav-name" title="@obj.DisplayName">@obj.DisplayName</span>
                @if (!string.IsNullOrWhiteSpace(obj.Subtitle) && obj.Role != CausalityTableObjectRole.Everything)
                {
                    <span class="tv-nav-sub">@obj.Subtitle</span>
                }
            </span>
            <span class="tv-count-pill">@obj.RowCount</span>
        </button>
    };

    /// <summary>
    /// A header cell's contents: the sort button, then its own drag-resize grip (a sibling, not nested
    /// inside the button, so the grip's hit target is independent of it). <paramref name="index"/> is
    /// the column's rendered position, passed straight to the JS column resizer so it can address the
    /// matching &lt;col&gt; without needing to search the header row itself.
    /// </summary>
    private RenderFragment RenderHeader(int index, string column, string title) => __builder =>
    {
        var active = _sortColumn == column;
        <button type="button" class="tv-sort @(active ? "on" : null)" @onclick="() => ToggleSort(column)">
            @title
            @if (active)
            {
                <MudIcon Icon="@(_sortDescending ? Icons.Material.Filled.ArrowDownward : Icons.Material.Filled.ArrowUpward)"
                         Size="Size.Small" aria-hidden="true" />
            }
        </button>
        <span class="tv-col-grip" role="separator" aria-orientation="vertical"
              aria-label="@($"Resize the {title} column")" tabindex="0"
              @onkeydown="e => OnColumnGripKeyDownAsync(e, index)"></span>
    };

    private void SelectObject(string key)
    {
        _selectedKey = key;
    }

    private void SetFilter(CausalityTableFilter filter)
    {
        _filter = filter;
    }

    /// <summary>
    /// Cycles a header through ascending -> descending -> off (the model's own causal order), so a
    /// sorted grid always has a way back rather than being stuck re-sorted forever. Choosing a different
    /// column always starts it ascending, matching the click a reader expects from a column they have
    /// not sorted by yet.
    /// </summary>
    private void ToggleSort(string column)
    {
        if (_sortColumn != column)
        {
            _sortColumn = column;
            _sortDescending = false;
            return;
        }

        if (!_sortDescending)
        {
            _sortDescending = true;
        }
        else
        {
            _sortColumn = string.Empty;
            _sortDescending = false;
        }
    }

    private CausalityTableObject? GetObjectForKey(string objectKey) =>
        Model.Objects.FirstOrDefault(o => o.Key == objectKey);

    private string GetObjectDisplayName(string objectKey) =>
        GetObjectForKey(objectKey)?.DisplayName ?? objectKey;

    /// <summary>
    /// The Everything mode Object column's cell: a link to the object's own detail page where the
    /// causality events resolved one (a Provisioned outcome's own record), plain text otherwise.
    /// </summary>
    private RenderFragment RenderObjectCell(string objectKey) => __builder =>
    {
        var obj = GetObjectForKey(objectKey);
        var displayName = obj?.DisplayName ?? objectKey;
        if (obj?.Href is { } href)
        {
            <a class="ln-link" href="@href" title="@displayName">@displayName</a>
        }
        else
        {
            <span title="@displayName">@displayName</span>
        }
    };

    /// <summary>
    /// The Synchronisation Rule column's cell: a link to the rule when the row names one, the reasoning
    /// text plainly otherwise (Deletion Rule / out-of-scope text carries no rule to link).
    /// </summary>
    private RenderFragment RenderSyncRuleCell(CausalityTableRow row) => __builder =>
    {
        if (row.SyncRuleId is { } syncRuleId)
        {
            <a class="ln-link" href="@($"/admin/sync-rules/{syncRuleId}")">@row.Via</a>
        }
        else
        {
            <TextValueDisplay Value="@row.Via" />
        }
    };

    /// <summary>
    /// A row whose value was removed with nothing replacing it: the current reading is struck through
    /// rather than paired with an empty would-be cell.
    /// </summary>
    private static bool IsRemoval(CausalityTableRow row) =>
        !string.IsNullOrEmpty(row.Current) && string.IsNullOrEmpty(row.WouldBe);

    /// <summary>
    /// Colours the would-be cell for a destructive (Error) or constructive (Success) outcome, matching
    /// the tone the Timeline and Lineage already show for the same event; every other tone keeps the
    /// grid's default text colour so the page is not painted end to end. Never applied to an empty cell:
    /// every non-attribute row carries a tone but no WouldBe text of its own any more (#1519 Table view
    /// fix 7), and colouring the empty-value placeholder would read as a stray coloured dash.
    /// </summary>
    private static string? GetWouldBeStyle(CausalityTableRow row) =>
        row.Tone is CausalityTone.Error or CausalityTone.Success && !string.IsNullOrEmpty(row.WouldBe)
            ? $"color: {CausalityToneCss.TextCssVar(row.Tone)}"
            : null;

    /// <summary>
    /// A cell's full value as its <c>title</c>, so a value cropped by <c>tv-cols-fixed</c>'s ellipsis is
    /// still readable on hover; null (no attribute rendered) rather than an empty tooltip for a blank cell.
    /// </summary>
    private static string? EmptyToNull(string? value) => string.IsNullOrWhiteSpace(value) ? null : value;

    /// <summary>
    /// The Outcome cell's title: the label as shown, plus the detail line beneath it when there is one,
    /// joined the same way a sentence would read it.
    /// </summary>
    private static string GetOutcomeTitle(CausalityTableRow row)
    {
        return string.IsNullOrWhiteSpace(row.OutcomeDetail) ? row.OutcomeLabel : $"{row.OutcomeLabel}: {row.OutcomeDetail}";
    }

    private static string GetFilterLabel(CausalityTableFilter filter) => filter switch
    {
        CausalityTableFilter.ScopeAndJoin => "Scope & Join",
        CausalityTableFilter.AttributeChanges => "Attribute changes",
        CausalityTableFilter.ObjectChanges => "Object changes",
        CausalityTableFilter.Destructive => "Destructive",
        _ => "All"
    };
}
