@* What a run set in motion, and where it stands now (#2021, Phase 6): one line per kind of work, a bar of its states and
   their counts. The run's own status stays as it ended; this panel changes as the work is delivered. *@
@if (Lines.Count > 0)
{
    <MudPaper Class="@($"pa-4 {Class}")" Outlined="true" data-testid="jim-run-follow-up">
        <MudText Typo="Typo.h6" Class="mb-2">Follow-up</MudText>
        @foreach (var line in Lines)
        {
            <div class="jim-follow-up-summary-row">
                <MudIcon Icon="@Icon(line.Kind)" Class="jim-follow-up-icon" aria-hidden="true" />
                <span class="jim-follow-up-summary-title">@line.Title</span>
                <span class="jim-follow-up-bar" aria-hidden="true">
                    @foreach (var state in line.States)
                    {
                        <i class="@($"jim-follow-up-bar--{state.Modifier}")" style="@($"width: {Share(state.Count, line.Total)}%")"></i>
                    }
                </span>
                <span class="jim-follow-up-summary-states">
                    @foreach (var state in line.States)
                    {
                        <span class="@($"jim-status-pill jim-status-pill--{state.Modifier}")">
                            <span class="jim-status-dot"></span>@state.Count.ToString("N0") @state.Label
                        </span>
                    }
                </span>
            </div>
        }
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
            The run's own result stays as it ended. These change as the work is delivered; each export item's Follow-up says why.
        </MudText>
    </MudPaper>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<FollowUpSummaryLine> Lines { get; set; } = [];

    [Parameter]
    public string? Class { get; set; }

    private static string Icon(ActivityTargetType kind) => kind == ActivityTargetType.PasswordSynchronisation
        ? Icons.Material.Filled.Key
        : Icons.Material.Filled.Email;

    private static string Share(int count, int total) =>
        (total == 0 ? 0 : count * 100d / total).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
}
