<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Exchange (and other Windows) Remote PowerShell from Linux: a WinRM transport and Kerberos authentication beneath
    PowerShell's own remoting engine (System.Management.Automation), through its public custom transport API.
    This library must never reference JIM.*; a test in Tetron.PowerShellRemoting.Tests enforces it, so the library can
    later be split out on its own (#2021).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tetron.PowerShellRemoting</RootNamespace>
    <!-- GSSAPI interop passes IOV buffer arrays and pinned spans to libgssapi_krb5. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tetron.PowerShellRemoting.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- PowerShell's own remoting engine (PSRP, runspaces, serialisation), hosted beneath a WinRM transport this
         library supplies through PowerShell's public custom transport API. Approved via Third-Party Dependency
         Governance on 2026-10-30 (#2021); its major version follows .NET's (7.6 is .NET 10). -->
    <PackageReference Include="System.Management.Automation" Version="7.6.7" />
    <!-- Transitive override: System.Management.Automation 7.6.7 requires System.Security.Cryptography.Pkcs 10.0.5,
         which has known high- and moderate-severity vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7);
         fixed in 10.0.13. JIM.Connectors pins the same version for the same reason. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

</Project>
