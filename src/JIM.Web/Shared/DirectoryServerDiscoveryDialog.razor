@using JIM.Models.Staging
@using JIM.Web.Services
@inject IJimApplicationFactory JimFactory

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

@*
    Lists the servers JIM discovers in a Connected System's directory for one setting, so an administrator can pick
    one instead of having to already know a hostname. Selecting a row fills the field the dialog was opened from on
    the settings page; nothing here writes anything on its own. The wording uses the Connector's own term for those
    servers (the LDAP Connector's are domain controllers, or Exchange servers), and names the forest it searched where
    the Connector can tell, so an empty result says where nothing was found. Failures (an unreachable directory,
    refused credentials) render inside the dialog with a Retry action rather than crashing the page.
*@

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" data-testid="jim-directory-server-discovery-title">@Title(ServerTerm, _forestName)</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="4">
                <MudProgressCircular Indeterminate="true" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Discovering @(ServerTerm)...</MudText>
            </MudStack>
        }
        else if (_errorMessage != null)
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }
        else if (_directoryServers is { Count: 0 })
        {
            <MudAlert Severity="Severity.Info" data-testid="jim-directory-server-discovery-empty">
                JIM did not find any @(ServerTerm) in @(_forestName is { } forest ? $"the {forest} forest" : "this directory").
            </MudAlert>
        }
        else if (_directoryServers != null)
        {
            <MudSimpleTable Dense="true" Hover="true" Elevation="0" Outlined="true">
                <thead>
                    <tr>
                        <th>FQDN</th>
                        <th>Site</th>
                        @if (_showVersion)
                        {
                            <th>Version</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var directoryServer in _directoryServers)
                    {
                        <tr class="jim-directory-server-row" @onclick="@(() => Select(directoryServer))">
                            <td>@directoryServer.HostName</td>
                            <td>
                                @if (string.IsNullOrEmpty(directoryServer.Site))
                                {
                                    <EmptyValue />
                                }
                                else
                                {
                                    @directoryServer.Site
                                }
                            </td>
                            @if (_showVersion)
                            {
                                <td>
                                    @if (string.IsNullOrEmpty(directoryServer.Version))
                                    {
                                        <EmptyValue />
                                    }
                                    else
                                    {
                                        @directoryServer.Version
                                    }
                                </td>
                            }
                            <td class="text-right">
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => Select(directoryServer))">
                                    Select
                                </MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </DialogContent>
    <DialogActions>
        @if (_errorMessage != null)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" OnClick="LoadAsync" data-testid="jim-directory-server-discovery-retry">Retry</MudButton>
        }
        <MudButton OnClick="Cancel" DropShadow="false" data-testid="jim-directory-server-discovery-close">Close</MudButton>
    </DialogActions>
</MudDialog>

<style>
    .jim-directory-server-row {
        cursor: pointer;
    }
</style>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The Connected System whose directory to discover servers in.
    /// </summary>
    [Parameter, EditorRequired]
    public int ConnectedSystemId { get; set; }

    /// <summary>
    /// The setting the servers are for, and which the selected one fills; null for the Connector's first discovery.
    /// </summary>
    [Parameter]
    public string? TargetSettingName { get; set; }

    /// <summary>
    /// What the Connector calls the servers it discovers, plural and lower case (e.g. "domain controllers").
    /// </summary>
    [Parameter]
    public string ServerTerm { get; set; } = DefaultServerTerm;

    private const string DefaultServerTerm = "directory servers";

    /// <summary>
    /// Connectivity settings entered on screen but not yet saved, applied over the saved ones so an
    /// administrator configuring a system can discover before saving (encrypted settings always come from the
    /// saved values), mirroring the server certificate read action.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<ConnectedSystemSettingValueDraft>? DraftSettingValues { get; set; }

    private bool _loading = true;
    private string? _errorMessage;
    private List<ConnectorDirectoryServer>? _directoryServers;
    private string? _forestName;

    // A Version column only when a server has one: domain controllers have none, Exchange servers do.
    private bool _showVersion => _directoryServers?.Any(server => !string.IsNullOrEmpty(server.Version)) == true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        _directoryServers = null;
        StateHasChanged();

        try
        {
            using var jim = JimFactory.Create();
            var discovered = await jim.ConnectedSystems.GetConnectedSystemDirectoryServersAsync(ConnectedSystemId, TargetSettingName, DraftSettingValues);
            _forestName = discovered.ForestName;
            _directoryServers = discovered.Servers;
        }
        // Dialog boundary: any discovery failure (an unreachable directory, refused credentials, a directory
        // the Connector cannot discover servers in) must render inside the dialog rather than crash the page, so every failure
        // reason is shown the same way, with the same Retry action, regardless of its cause. Cancellation is
        // excluded so a tearing-down circuit propagates rather than rendering as a discovery failure.
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
            // The title, which names the forest once discovery has, is drawn by the dialog's frame rather than this
            // component, so the frame is asked to draw again too.
            MudDialog.StateHasChanged();
        }
    }

    private void Select(ConnectorDirectoryServer directoryServer) => MudDialog.Close(DialogResult.Ok(directoryServer.HostName));

    private void Cancel() => MudDialog.Cancel();

    /// <summary>
    /// "Discover Domain Controllers" from "domain controllers": the term reads in lower case mid-sentence and in
    /// title case as the dialog's title. Words already carrying capitals (an acronym) are left as they are. Once the
    /// discovery has named the forest it searched, the title says which ("Discover Exchange Servers in panoply.local").
    /// </summary>
    private static string Title(string serverTerm, string? forestName = null)
    {
        var title = $"Discover {System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(serverTerm)}";
        return forestName == null ? title : $"{title} in {forestName}";
    }

    /// <summary>
    /// Opens the dialog and returns the selected server's FQDN, or null when the administrator closed the dialog
    /// without selecting one.
    /// </summary>
    public static async Task<string?> ShowAsync(IDialogService dialogService, int connectedSystemId, string? targetSettingName, string? serverTerm,
        IReadOnlyCollection<ConnectedSystemSettingValueDraft>? draftSettingValues = null)
    {
        var term = string.IsNullOrWhiteSpace(serverTerm) ? DefaultServerTerm : serverTerm;
        var parameters = new DialogParameters<DirectoryServerDiscoveryDialog>
        {
            { x => x.ConnectedSystemId, connectedSystemId },
            { x => x.TargetSettingName, targetSettingName },
            { x => x.ServerTerm, term },
            { x => x.DraftSettingValues, draftSettingValues }
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseOnEscapeKey = true
        };

        var dialog = await dialogService.ShowAsync<DirectoryServerDiscoveryDialog>(Title(term), parameters, options);
        var result = await dialog.Result;

        return result is null or { Canceled: true } ? null : result.Data as string;
    }
}
