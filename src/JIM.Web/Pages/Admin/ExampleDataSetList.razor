@page "/admin/example-data/datasets"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Models.ExampleData.DTOs
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>Example Data Sets</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>Example Data:</span> <span class="mud-primary-text">Data Sets</span></MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

<MudButtonGroup Class="mt-3" OverrideStyles="false">
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/admin/example-data">Templates</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary">Data Sets</MudButton>
</MudButtonGroup>

<MudText Typo="Typo.subtitle1" Class="mud-text-secondary mt-5">
    You can quickly populate JIM with example data, as a way to demo, or prototype new features without needing to fully
    configure JIM with Connected Systems, Synchronisation Rules and wait for data to be imported and synchronised etc.
</MudText>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary mt-2">
    Example datasets provide the raw values that are used to construct example data in Example Data Templates.
</MudText>

@* ─── Data Sets ─── *@
@* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count) lives in the
   shared grid; this page loads the small configuration list once and windows it in memory. The page header
   already names the list, so there is no toolbar title and the count carries the nouns. *@
<VirtualisedDataGrid T="ExampleDataSetHeader"
                     ContainerId="example-data-set-list"
                     DefaultSortBy="name"
                     LoadWindow="LoadWindowAsync"
                     SingularName="Example Data Set"
                     PluralName="Example Data Sets">
    <Columns>
        <TemplateColumn Title="Name" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Name" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                <MudLink Href="@("/admin/example-data/datasets/" + context.Item.Id)">@context.Item.Name</MudLink>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Built-in?" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Built-in?" Name="builtin" />
            </HeaderTemplate>
            <CellTemplate>
                @(context.Item.BuiltIn ? "Yes" : "No")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Culture" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Culture" Name="culture" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.Culture
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Values" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Values" Name="values" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.ValueCount.ToString("N0")
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Created" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Created" Name="created" />
            </HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                    @context.Item.Created.ToLocalTime().ToRelativeTime()
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No Example Data Sets match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.Science"
                             PrimaryText="No Example Data Sets yet"
                             SecondaryText="Example Data Sets provide the raw values used to construct example data in Example Data Templates." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private List<ExampleDataSetHeader>? _datasets;
    private readonly List<BreadcrumbItem> _breadcrumbs = new List<BreadcrumbItem>
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Administration", href: "/admin"),
        new("Example Data", href: "/admin/example-data/"),
        new("Data Sets", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _datasets = await jim.ExampleData.GetExampleDataSetHeadersAsync();
    }

    /// <summary>
    /// Windows the in-memory list for the grid: this is a small configuration list loaded whole on
    /// initialisation, so filtering and sorting happen here and the shared extension slices the window.
    /// </summary>
    private Task<VirtualisedWindow<ExampleDataSetHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        IEnumerable<ExampleDataSetHeader> datasets = _datasets ?? [];

        // Honour the grid's search against the same field the page's old search box filtered: the name.
        var searchText = request.SearchText;
        if (!string.IsNullOrWhiteSpace(searchText))
            datasets = datasets.Where(d => d.Name.Contains(searchText, StringComparison.OrdinalIgnoreCase));

        Func<ExampleDataSetHeader, object> sortKey = request.SortBy switch
        {
            "builtin" => d => d.BuiltIn,
            "culture" => d => d.Culture,
            "values" => d => d.ValueCount,
            "created" => d => d.Created,
            _ => d => d.Name
        };
        datasets = request.SortDescending ? datasets.OrderByDescending(sortKey) : datasets.OrderBy(sortKey);

        return Task.FromResult(datasets.ToWindow(request));
    }
}
