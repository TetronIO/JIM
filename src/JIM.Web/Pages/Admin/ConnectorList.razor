@page "/admin/connected-systems/connectors"
@attribute [Authorize(Roles = "Administrator")]
@using System.Globalization
@using JIM.Models.Staging.DTOs
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@ConnectorText.Connectors</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Power" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />@ConnectorText.Connectors
    <PageInfo Title="@ConnectorText.Connectors" DocsPage="connectors/index.md">
        @ConnectorText.ListPageInfo
    </PageInfo>
</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

<SegmentedToggle TValue="string" Options="@SiblingPages.ConnectedSystems" Value="@("connectors")"
                 AriaLabel="@ConnectorText.SiblingPagesAriaLabel" Class="mt-3" />

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the toolbar count, the search box)
   lives in the shared grid; this page loads the small configuration list once and windows it in memory. *@
<VirtualisedDataGrid T="ConnectorDefinitionHeader"
                     ContainerId="connector-list"
                     DefaultSortBy="name"
                     LoadWindow="LoadWindowAsync"
                     SingularName="@ConnectorText.Connector"
                     PluralName="@ConnectorText.Connectors">
    <Columns>
        <TemplateColumn Title="@CommonText.ColumnName" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@CommonText.ColumnName" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                <span class="jim-nowrap"><MudLink Href="@("/admin/connected-systems/connectors/"+context.Item.Id)">@context.Item.Name</MudLink></span>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@ConnectorText.ColumnDescription" Sortable="false" HeaderClass="jim-fill-column" CellClass="jim-fill-column">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@ConnectorText.ColumnDescription" Name="description" />
            </HeaderTemplate>
            <CellTemplate>
                @* A row in a virtualised grid is one line, so a long description is clipped rather than wrapped;
                   it is available in full on hover, and on the Connector's own page. *@
                <OneLineText Text="@context.Item.Description" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@ConnectorText.ColumnBuiltIn" Sortable="false" HeaderClass="jim-nowrap" HeaderStyle="width: 90px;">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@ConnectorText.ColumnBuiltIn" Name="builtin" />
            </HeaderTemplate>
            <CellTemplate>
                @(context.Item.BuiltIn ? ConnectorText.Yes : ConnectorText.No)
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@ConnectorText.ColumnInUse" Sortable="false" HeaderClass="jim-nowrap" HeaderStyle="width: 90px;">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@ConnectorText.ColumnInUse" Name="inuse" />
            </HeaderTemplate>
            <CellTemplate>
                @(context.Item.InUse ? ConnectorText.Yes : ConnectorText.No)
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@ConnectorText.ColumnVersion" Sortable="false" HeaderClass="jim-nowrap" HeaderStyle="width: 110px;">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@ConnectorText.ColumnVersion" Name="versions" />
            </HeaderTemplate>
            <CellTemplate>
                @if (string.IsNullOrEmpty(context.Item.Versions))
                {
                    <EmptyValue />
                }
                else
                {
                    @context.Item.Versions
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@string.Format(CultureInfo.CurrentCulture, ConnectorText.NoConnectorsMatch, grid.SearchText)"
                             SecondaryText="@CommonText.TrySearchAgain"
                             ActionText="@CommonText.ClearSearch"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.Power"
                             PrimaryText="@ConnectorText.NoConnectorsInstalled"
                             SecondaryText="@ConnectorText.NoConnectorsInstalledHint" />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private Task? _loading;
    private IList<ConnectorDefinitionHeader>? _headers;

    private readonly List<BreadcrumbItem> _breadcrumbs = new List<BreadcrumbItem>
    {
        new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
        new(LayoutText.NavAdministration, href: "/admin"),
        new(LayoutText.NavConnectedSystems, href: "/admin/connected-systems/"),
        new(ConnectorText.Connectors, href: null, disabled: true),
    };

    protected override async Task OnInitializedAsync()
    {
        await EnsureLoadedAsync();
    }

    /// <summary>
    /// Loads the Connector list once. The grid's window loader also calls this because the grid can request its
    /// first window before this page's initialisation has completed, so a caller arriving mid-load waits on the load
    /// already running rather than starting another.
    /// </summary>
    private Task EnsureLoadedAsync() => _loading ??= LoadAsync();

    private async Task LoadAsync()
    {
        using var jim = JimFactory.Create();
        _headers = await jim.ConnectedSystems.GetConnectorDefinitionHeadersAsync();
    }

    /// <summary>
    /// Windows the in-memory list for the grid: a small configuration list is loaded whole, then searched, sorted
    /// and sliced here rather than growing a database range read.
    /// </summary>
    private async Task<VirtualisedWindow<ConnectorDefinitionHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        await EnsureLoadedAsync();

        IEnumerable<ConnectorDefinitionHeader> filtered = _headers!;
        if (!string.IsNullOrWhiteSpace(request.SearchText))
            filtered = filtered.Where(c => c.Name.Contains(request.SearchText, StringComparison.OrdinalIgnoreCase));

        filtered = request.SortBy switch
        {
            "description" => request.SortDescending
                ? filtered.OrderByDescending(c => c.Description ?? string.Empty)
                : filtered.OrderBy(c => c.Description ?? string.Empty),
            "builtin" => request.SortDescending
                ? filtered.OrderByDescending(c => c.BuiltIn)
                : filtered.OrderBy(c => c.BuiltIn),
            "inuse" => request.SortDescending
                ? filtered.OrderByDescending(c => c.InUse)
                : filtered.OrderBy(c => c.InUse),
            "versions" => request.SortDescending
                ? filtered.OrderByDescending(c => c.Versions ?? string.Empty)
                : filtered.OrderBy(c => c.Versions ?? string.Empty),
            _ => request.SortDescending
                ? filtered.OrderByDescending(c => c.Name)
                : filtered.OrderBy(c => c.Name)
        };

        return filtered.ToWindow(request);
    }
}
