@* Two panels on the Passwords tab, in the order an administrator meets them: the check they run before relying
   on this system for passwords, then the rules the system enforces. Configuration of Password Synchronisation sits
   above both, on the tab itself. What each panel is for is said from its info button, not a paragraph. *@

@* ─── Password channel check ─── *@
<MudPaper Outlined="true" Class="pa-4 mt-6" data-testid="jim-password-channel-panel">
    <div class="d-flex align-center">
        <MudText Typo="Typo.h6">@ConnectedSystemText.PwPanelChannelHeading</MudText>
        <InfoPopover Title="@ConnectedSystemText.PwPanelChannelHeading">
            @ConnectedSystemText.PwPanelChannelInfo
        </InfoPopover>
    </div>

    @* Gated rather than validated on click: a Connected System whose connection settings are absent or invalid
       cannot be connected to, so there is nothing to check. The reason is stated beside the button rather than in a
       tooltip, because a disabled control fires no pointer events and so can never show one. *@
    @if (!CanRunPreflight)
    {
        <MudAlert Severity="Severity.Info" Class="mt-4">
            <MudText>
                @ConnectedSystemText.PwPanelSettingsFirst
            </MudText>
        </MudAlert>
    }

    @* Outlined, not filled: a read-only check that stores nothing is not the panel's primary action. *@
    <MudButton
        Variant="Variant.Filled"
        OnClick="RunPreflightAsync"
        Class="mt-4"
        DropShadow="false"
        Disabled="@(_preflightRunning || !CanRunPreflight)">
        @if (_preflightRunning)
        {
            <MudProgressCircular Class="ms-n1" Indeterminate="true" />
            <span class="ms-2">@ConnectedSystemText.PwPanelChecking</span>
        }
        else
        {
            <text>@ConnectedSystemText.PwPanelCheckButton</text>
        }
    </MudButton>

    @if (_preflight != null)
    {
        @* Captured for the same reason as the policy above: markup should dereference a local, not a field the
           guard's null-state does not reliably carry into. *@
        var preflight = _preflight;

        <MudAlert Severity="@OutcomeSeverity(preflight.Outcome)" Class="mt-4">
            <MudText><strong>@OutcomeSummary(preflight)</strong></MudText>
        </MudAlert>

        <MudList T="string" Class="mt-2">
            @foreach (var check in preflight.Checks)
            {
                <MudListItem T="string" Icon="@StateIcon(check.State)" IconColor="@StateColour(check.State)">
                    <MudText Typo="Typo.body1"><strong>@CheckName(check.Check)</strong></MudText>
                    <MudText Typo="Typo.body1">@check.Message</MudText>
                    @foreach (var detail in check.Details)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">@detail</MudText>
                    }
                </MudListItem>
            }
        </MudList>

        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
            @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelReadAt, preflight.Ran.ToLocalTime().ToRelativeTime())
        </MudText>
    }
</MudPaper>

@* ─── Discovered policy ─── *@
<MudPaper Outlined="true" Class="pa-4 mt-6" data-testid="jim-password-policy-panel">
    <div class="d-flex align-center">
        <MudText Typo="Typo.h6">@ConnectedSystemText.PwPanelPolicyHeading</MudText>
        <InfoPopover Title="@ConnectedSystemText.PwPanelPolicyHeading">
            @ConnectedSystemText.PwPanelPolicyInfo
        </InfoPopover>
    </div>
    @if (Policy is { HasAnyDiscoveredConstraint: true })
    {
        @* Captured so the markup below dereferences a local the compiler and CodeQL both know is non-null; a
           pattern guard on a property does not establish that for either of them. *@
        var policy = Policy;

        @* jim-kv-table shrinks the label column to its content, so the value column has the room *@
        <MudSimpleTable Class="mt-4 jim-kv-table" Dense="false" Hover="false" Striped="true" Elevation="0">
            <tbody>
                <tr>
                    <td>@ConnectedSystemText.PwPanelMinimumLength</td>
                    <td>
                        @if (policy.MinimumLength is { } minimumLength)
                        {
                            @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelCharacters, minimumLength)
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </td>
                </tr>
                <tr>
                    <td>@ConnectedSystemText.PwPanelComplexity</td>
                    <td>
                        @if (policy.ComplexityRequired == true)
                        {
                            <text>@ConnectedSystemText.PwPanelRequired</text>
                            @if (policy.RequiredCharacterClassCount is { } requiredClasses && RecognisedClassCount(policy) > 0)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelComplexityDetail, requiredClasses, RecognisedClassCount(policy), DescribeCharacterClasses(policy))
                                </MudText>
                            }
                        }
                        else if (policy.ComplexityRequired == false)
                        {
                            <text>@ConnectedSystemText.PwPanelNotRequired</text>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </td>
                </tr>
                <tr>
                    <td>@ConnectedSystemText.PwPanelHistory</td>
                    <td>
                        @if (policy.PasswordHistoryLength is { } historyLength)
                        {
                            @string.Format(System.Globalization.CultureInfo.CurrentCulture, PluralRules.Choose(historyLength, ConnectedSystemText.PwPanelRememberedOne, ConnectedSystemText.PwPanelRememberedOther), historyLength)
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </td>
                </tr>
                <tr>
                    <td>@ConnectedSystemText.PwPanelMaxAge</td>
                    <td>@FormatAge(policy.MaximumPasswordAge, ConnectedSystemText.PwPanelNoMaxAge)</td>
                </tr>
                <tr>
                    <td>@ConnectedSystemText.PwPanelMinAge</td>
                    <td>@FormatAge(policy.MinimumPasswordAge, ConnectedSystemText.PwPanelNoMinAge)</td>
                </tr>
            </tbody>
        </MudSimpleTable>

        @* A directory can check what it never publishes (a password-quality module, a dictionary check). Said
           under the rules it does publish, so a refusal of a password that satisfies them is expected rather
           than taken as JIM having read them wrong. *@
        @if (policy.FurtherChecksApply)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2" data-testid="jim-password-policy-further-checks">
                @ConnectedSystemText.PwPanelFurtherChecks
            </MudText>
        }

        @* A discovered policy is a floor. Say so where it is read, not only in the documentation. The panel does
           not know which directory this is, so the mechanisms are named rather than one of them presumed. *@
        @if (policy.PolicyOverrideSignal != PolicyOverrideSignal.Absent)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-4" data-testid="jim-password-policy-override">
                @if (policy.PolicyOverrideSignal == PolicyOverrideSignal.Present)
                {
                    <MudText>
                        @((MarkupString)string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelOverridePresent, "pwdPolicySubentry"))
                    </MudText>
                }
                else
                {
                    <MudText>
                        @((MarkupString)string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelOverrideUnknown, "pwdPolicySubentry"))
                    </MudText>
                }
            </MudAlert>
        }
    }
    else
    {
        @* Why nothing is shown decides what the administrator does next: retrieve the schema, grant a right,
           configure a policy on the directory, or nothing at all. The panel cannot know which directory this is
           (the Connector's persisted data is opaque to it by design), so the wording follows the recorded
           outcome alone and names no directory. *@
        <MudAlert Severity="@DiscoveryOutcomeSeverity(Policy?.DiscoveryOutcome)" Class="mt-4" data-testid="jim-password-policy-outcome">
            <MudText>
                @switch (Policy?.DiscoveryOutcome)
                {
                    case PasswordPolicyDiscoveryOutcome.NotPublished:
                        <text>
                            @ConnectedSystemText.PwPanelOutcomeNotPublished
                        </text>
                        break;
                    case PasswordPolicyDiscoveryOutcome.ConfigurationNotReadable:
                        <text>
                            @ConnectedSystemText.PwPanelOutcomeUnreadable
                        </text>
                        break;
                    case PasswordPolicyDiscoveryOutcome.NoPolicyConfigured:
                        <text>
                            @ConnectedSystemText.PwPanelOutcomeNoPolicy
                        </text>
                        break;
                    default:
                        <text>
                            @ConnectedSystemText.PwPanelOutcomeNotRead
                        </text>
                        break;
                }
            </MudText>
        </MudAlert>
    }

    @* Every row is a read attempt at a moment in time, including one that read nothing: an administrator who has
       since granted a right or loaded an overlay needs to know whether JIM has looked again. *@
    @if (Policy is { } readPolicy)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-4">
            <MudTooltip Arrow="true" Placement="Placement.Top" Text="@readPolicy.Discovered.ToLocalTime().ToFriendlyDate()">
                @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelReadFrom, readPolicy.Discovered.ToLocalTime().ToRelativeTime())
            </MudTooltip>
        </MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    private ConnectedSystemPasswordPolicy? Policy => ConnectedSystem.PasswordPolicy;

    private bool _preflightRunning;
    private PasswordPreflightResult? _preflight;

    /// <summary>
    /// Whether there is anything to check. A preflight has to connect, so a Connected System with no settings, or
    /// with settings that do not validate, cannot be checked at all.
    /// </summary>
    private bool CanRunPreflight => ConnectedSystem.SettingValues.Count > 0 && ConnectedSystem.SettingValuesValid;

    /// <summary>
    /// A refused read is the one outcome with something to fix, so it is the one that warns; the others are
    /// facts about the directory that an administrator can only take note of.
    /// </summary>
    private static Severity DiscoveryOutcomeSeverity(PasswordPolicyDiscoveryOutcome? outcome) =>
        outcome == PasswordPolicyDiscoveryOutcome.ConfigurationNotReadable ? Severity.Warning : Severity.Info;

    private static int RecognisedClassCount(ConnectedSystemPasswordPolicy policy) =>
        Enum.GetValues<PasswordCharacterClasses>()
            .Count(c => c != PasswordCharacterClasses.None && policy.RecognisedCharacterClasses.HasFlag(c));

    private static string DescribeCharacterClasses(ConnectedSystemPasswordPolicy policy)
    {
        var names = new List<string>();
        if (policy.RecognisedCharacterClasses.HasFlag(PasswordCharacterClasses.Uppercase))
            names.Add(ConnectedSystemText.PwPanelCategoryUppercase);
        if (policy.RecognisedCharacterClasses.HasFlag(PasswordCharacterClasses.Lowercase))
            names.Add(ConnectedSystemText.PwPanelCategoryLowercase);
        if (policy.RecognisedCharacterClasses.HasFlag(PasswordCharacterClasses.Digit))
            names.Add(ConnectedSystemText.PwPanelCategoryDigits);
        if (policy.RecognisedCharacterClasses.HasFlag(PasswordCharacterClasses.Symbol))
            names.Add(ConnectedSystemText.PwPanelCategorySymbols);
        if (policy.RecognisedCharacterClasses.HasFlag(PasswordCharacterClasses.OtherUnicodeLetter))
            names.Add(ConnectedSystemText.PwPanelCategoryLettersWithoutCase);

        return string.Join(", ", names);
    }

    /// <summary>
    /// Renders a duration in whole days where it divides cleanly, which every real policy value does. The
    /// no-limit case gets its own wording rather than a hyphen, because "no maximum age" and "JIM did not read
    /// one" mean different things to an administrator.
    /// </summary>
    private static string FormatAge(TimeSpan? age, string noLimitText)
    {
        if (age is not { } value)
            return noLimitText;

        // Whole days are detected on ticks rather than on TotalDays, which is a double: comparing one for
        // equality, or taking its remainder, is the kind of thing that works until a value arrives that cannot
        // be represented exactly.
        if (value.Ticks >= TimeSpan.TicksPerDay && value.Ticks % TimeSpan.TicksPerDay == 0)
        {
            var days = value.Ticks / TimeSpan.TicksPerDay;
            return string.Format(System.Globalization.CultureInfo.CurrentCulture, PluralRules.Choose(days, ConnectedSystemText.PwPanelDayOne, ConnectedSystemText.PwPanelDayOther), days);
        }

        return value.TotalHours >= 1
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelHours, value.TotalHours.ToString("0.#", System.Globalization.CultureInfo.CurrentCulture))
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelMinutes, value.TotalMinutes.ToString("0.#", System.Globalization.CultureInfo.CurrentCulture));
    }

    private async Task RunPreflightAsync()
    {
        _preflightRunning = true;
        _preflight = null;

        try
        {
            using var jim = JimFactory.Create();
            _preflight = await jim.ConnectedSystems.RunPasswordPreflightAsync(ConnectedSystem, CancellationToken.None);
        }
        catch (NotSupportedException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        catch (ArgumentException ex)
        {
            // Belt and braces behind the button gating above. A diagnostic that takes the whole page down when the
            // Connected System is half-configured is worse than no diagnostic, and this is precisely the state an
            // administrator is in when they reach for one.
            Log.Warning(ex, "RunPreflightAsync: Connected System {ConnectedSystemId} is not configured enough to check.", ConnectedSystem.Id);
            Snackbar.Add(ConnectedSystemText.PwPanelNotConfigured, Severity.Warning);
        }
        finally
        {
            _preflightRunning = false;
        }
    }

    private static Severity OutcomeSeverity(PasswordPreflightOutcome outcome) => outcome switch
    {
        PasswordPreflightOutcome.Ready => Severity.Success,
        PasswordPreflightOutcome.ReadyWithWarnings => Severity.Warning,
        PasswordPreflightOutcome.Inconclusive => Severity.Info,
        _ => Severity.Error
    };

    private static string OutcomeSummary(PasswordPreflightResult result)
    {
        var target = string.IsNullOrEmpty(result.TargetDescription) ? ConnectedSystemText.PwPanelThisSystem : result.TargetDescription;
        return result.Outcome switch
        {
            PasswordPreflightOutcome.Ready => string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelOutcomeReady, target),
            PasswordPreflightOutcome.ReadyWithWarnings => string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelOutcomeReadyWarnings, target),
            PasswordPreflightOutcome.Inconclusive => string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelOutcomeInconclusive, target),
            _ => string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.PwPanelOutcomeFailed, target)
        };
    }

    private static string StateIcon(PasswordPreflightState state) => state switch
    {
        PasswordPreflightState.Passed => Icons.Material.Filled.CheckCircle,
        PasswordPreflightState.Warning => Icons.Material.Filled.Warning,
        PasswordPreflightState.Failed => Icons.Material.Filled.Error,
        _ => Icons.Material.Filled.Help
    };

    private static Color StateColour(PasswordPreflightState state) => state switch
    {
        PasswordPreflightState.Passed => Color.Success,
        PasswordPreflightState.Warning => Color.Warning,
        PasswordPreflightState.Failed => Color.Error,
        _ => Color.Info
    };

    private static string CheckName(PasswordPreflightCheck check) => check switch
    {
        PasswordPreflightCheck.Connection => ConnectedSystemText.PwPanelCheckConnection,
        PasswordPreflightCheck.Encryption => ConnectedSystemText.PwPanelCheckEncryption,
        PasswordPreflightCheck.PasswordMechanism => ConnectedSystemText.PwPanelCheckMechanism,
        PasswordPreflightCheck.ResetRights => ConnectedSystemText.PwPanelCheckResetRights,
        _ => ConnectedSystemText.PwPanelCheckPolicy
    };
}
