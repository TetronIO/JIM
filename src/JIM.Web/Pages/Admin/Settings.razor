<PageTitle>Service Settings</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.DisplaySettings" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />Service Settings</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
<MudText Typo="Typo.subtitle1" Class="mud-text-secondary">
    Configure service-wide settings. Read-only settings are defined by environment variables and cannot be modified here.
</MudText>

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the density toggle, the search box
   and the toolbar count) lives in the shared grid. Service Settings are a small configuration list, loaded whole
   once, so the window is sliced from memory rather than becoming a database range read. The Category that used to
   be a collapsible group header is now a sortable column: grouping is computed over the rows a grid is holding,
   and a virtualised grid holds one window, so a group header would describe the window rather than the list. *@
<VirtualisedDataGrid @ref="_grid" T="ServiceSetting"
                     ContainerId="service-setting-list"
                     DefaultSortBy="category"
                     LoadWindow="LoadSettingWindowAsync"
                     SingularName="Service Setting"
                     PluralName="Service Settings"
                     SearchPlaceholder="Search settings"
                     RowClassFunc="RowClass">
    <ToolBarExtras>
        <MudCheckBox @bind-Value="_showConfigurableOnly" @bind-Value:after="OnFilterChangedAsync" Label="Show configurable only" Color="Color.Primary" Class="mr-4" />
        <MudCheckBox @bind-Value="_showOverriddenOnly" @bind-Value:after="OnFilterChangedAsync" Label="Show overridden only" Color="Color.Primary" />
    </ToolBarExtras>
    <Columns>
        <TemplateColumn Title="Category" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Category" Name="category" />
            </HeaderTemplate>
            <CellTemplate>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@GetCategoryDisplayName(context.Item.Category.ToString())</MudText>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Setting" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Setting" Name="setting" />
            </HeaderTemplate>
            <CellTemplate>
                @* A row in a virtualised grid is one line, and a MudText renders a paragraph, so the description
                   under the name was a second line and a second row height. It reads inline after the name
                   instead, low-lighted, with both available in full on hover. *@
                <OneLineText Text="@context.Item.DisplayName" Secondary="@context.Item.Description" />
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Value" Sortable="false" CellClass="jim-nowrap">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Value</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @* Controls sit to the left of the value so values stay left-aligned regardless of their length. *@
                @if (context.Item.ValueType == ServiceSettingValueType.StringEncrypted)
                {
                    var encryptedKey = context.Item.Key;
                    @if (_revealedSecrets.Contains(encryptedKey) && _decryptedCache.TryGetValue(encryptedKey, out var decrypted))
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.VisibilityOff" Variant="Variant.Filled" Size="Size.Small" Class="me-2" OnClick="() => HideSecret(encryptedKey)" />
                        <span class="jim-text-code">@(decrypted.Value ?? "(not set)")</span>
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Outlined.Visibility" Variant="Variant.Filled" Size="Size.Small" Class="me-2" OnClick="() => RevealSecretAsync(encryptedKey)" />
                        <span class="jim-text-code">********</span>
                    }
                }
                else if (context.Item.ValueType == ServiceSettingValueType.Guid)
                {
                    var guidValue = context.Item.GetEffectiveValue();
                    @if (!string.IsNullOrEmpty(guidValue))
                    {
                        <MudTooltip Text="Copy to clipboard" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Variant="Variant.Filled" Size="Size.Small" Class="me-2"
                                           OnClick="() => CopyToClipboardAsync(guidValue)" />
                        </MudTooltip>
                    }
                    <span class="jim-text-code">@(guidValue ?? "(not set)")</span>
                }
                else
                {
                    <span class="jim-text-code">@(context.Item.GetEffectiveValue() ?? "(not set)")</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Status" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Status" Name="status" />
            </HeaderTemplate>
            <CellTemplate>
                @* Each status gets its own colour so the column scans at a glance: grey locked, blue modified, green default. *@
                @if (context.Item.IsReadOnly)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Icon="@Icons.Material.Filled.Lock">Read-only</MudChip>
                }
                else if (context.Item.IsOverridden)
                {
                    <MudTooltip Arrow="true" Placement="Placement.Top">
                        <TooltipContent>
                            @if (context.Item.LastUpdated.HasValue)
                            {
                                var lastUpdated = context.Item.LastUpdated.Value.ToLocalTime();
                                <MudText Typo="Typo.caption">Modified @lastUpdated.ToFriendlyDate()</MudText>
                                @if (context.Item.LastUpdatedByName != null)
                                {
                                    <MudText Typo="Typo.caption">by @context.Item.LastUpdatedByName</MudText>
                                }
                            }
                        </TooltipContent>
                        <ChildContent>
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Primary" Icon="@Icons.Material.Filled.Edit">Modified</MudChip>
                        </ChildContent>
                    </MudTooltip>
                }
                else
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Success" Icon="@Icons.Material.Filled.Check">Default</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Actions" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">Actions</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @{
                    var setting = context.Item;
                }
                <div class="d-flex justify-end gap-2">
                    @if (!setting.IsReadOnly)
                    {
                        <MudTooltip Text="Edit" Arrow="true" Placement="Placement.Top">
                            <MudIconButton Icon="@Icons.Material.Outlined.Edit" Variant="Variant.Filled" Size="Size.Small" OnClick="_ => ShowEditDialog(setting)" />
                        </MudTooltip>
                        @if (setting.IsOverridden)
                        {
                            <MudTooltip Text="Revert to Default" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.RestartAlt" Variant="Variant.Filled" Size="Size.Small" OnClick="_ => HandleRevertAsync(setting)" />
                            </MudTooltip>
                        }
                    }
                    <MudTooltip Text="Change history" Arrow="true" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.Outlined.History" Variant="Variant.Filled" Size="Size.Small" OnClick="_ => ShowHistoryDialogAsync(setting)" />
                    </MudTooltip>
                </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No Service Settings match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else if (_showConfigurableOnly || _showOverriddenOnly)
        {
            <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                             PrimaryText="No Service Settings match the filters"
                             SecondaryText="Clear the filters above to see every setting, including the read-only ones defined by environment variables."
                             ActionText="Clear Filters"
                             OnAction="ClearFiltersAsync" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.DisplaySettings"
                             PrimaryText="No Service Settings are available"
                             SecondaryText="Service Settings are seeded when JIM starts; if none are listed, the service has not finished initialising." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private List<ServiceSetting> _settings = new();
    private bool _showConfigurableOnly;
    private bool _showOverriddenOnly;
    private HashSet<string> _revealedSecrets = new();
    private Dictionary<string, (string? Value, bool Error)> _decryptedCache = new();
    private VirtualisedDataGrid<ServiceSetting>? _grid;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // Allows deep-linking to a setting, e.g. from an Activity's Target link: /admin/settings?search=Some+Setting
    [SupplyParameterFromQuery(Name = "search")]
    [Parameter]
    public string? Search { get; set; }

    private readonly List<BreadcrumbItem> _breadcrumbs =
    [
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Administration", href: "/admin"),
        new("Service Settings", href: null, disabled: true)
    ];

    protected override async Task OnInitializedAsync()
    {
        // The ?search= deep link predates the grid, which owns its own search under ?q=. Normalise it onto the
        // grid's parameter (preserving anything else in the query) so a link from an Activity's Target still
        // lands on the setting it names, rather than on an unfiltered list.
        if (!string.IsNullOrWhiteSpace(Search))
        {
            var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
            var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
            query.Remove("search");
            query["q"] = Search;
            NavManager.NavigateTo($"/admin/settings?{query}", replace: true);
            return;
        }

        await LoadSettingsAsync();
    }

    private async Task LoadSettingsAsync()
    {
        using var jim = JimFactory.Create();
        _settings = await jim.ServiceSettings.GetAllSettingsAsync();
        _decryptedCache.Clear();
        _revealedSecrets.Clear();
    }

    /// <summary>
    /// Reloads the settings from the database and refreshes the grid over them, after an edit or a revert. The
    /// totals are invalidated because a revert can change which settings match the "overridden only" filter.
    /// </summary>
    private async Task ReloadListAsync()
    {
        await LoadSettingsAsync();
        if (_grid != null)
            await _grid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Slices one window of Service Settings from the in-memory list, applying the page's own two filters, the
    /// grid's search (display name, description and key; the same fields the old table filtered) and its sort.
    /// </summary>
    private Task<VirtualisedWindow<ServiceSetting>> LoadSettingWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        var settings = _settings
            .Where(s => !_showConfigurableOnly || !s.IsReadOnly)
            .Where(s => !_showOverriddenOnly || (s.IsOverridden && !s.IsReadOnly));

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            settings = settings.Where(s =>
                s.DisplayName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                s.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) == true ||
                s.Key.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        // Category leads by default and breaks to the display name within it, so the list reads in the same order
        // the collapsible category groups used to put it in.
        var sorted = request.SortBy switch
        {
            "setting" => Order(settings, s => s.DisplayName, request.SortDescending),
            "status" => Order(settings, StatusRank, request.SortDescending).ThenBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase),
            _ => Order(settings, s => GetCategoryDisplayName(s.Category.ToString()), request.SortDescending)
                .ThenBy(s => s.DisplayName, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    private static IOrderedEnumerable<ServiceSetting> Order(IEnumerable<ServiceSetting> source, Func<ServiceSetting, string> key, bool descending) =>
        descending
            ? source.OrderByDescending(key, StringComparer.OrdinalIgnoreCase)
            : source.OrderBy(key, StringComparer.OrdinalIgnoreCase);

    private static IOrderedEnumerable<ServiceSetting> Order(IEnumerable<ServiceSetting> source, Func<ServiceSetting, int> key, bool descending) =>
        descending ? source.OrderByDescending(key) : source.OrderBy(key);

    /// <summary>
    /// Orders the Status column by how much a reader cares: what has been changed from its default first, then
    /// what could be changed, then what is locked by an environment variable. Sorting by the underlying booleans
    /// would order the column by nothing the reader can see.
    /// </summary>
    private static int StatusRank(ServiceSetting setting) => setting.IsReadOnly ? 2 : setting.IsOverridden ? 0 : 1;

    /// <summary>
    /// Re-runs the window under the page's own filters. The match set is different, so the total (and the
    /// unfiltered baseline the toolbar count compares against) has to be counted again, and the reader's scroll
    /// position describes rows that are no longer there.
    /// </summary>
    private async Task OnFilterChangedAsync()
    {
        if (_grid == null)
            return;

        await _grid.ResetScrollAsync();
        await _grid.RefreshAsync(invalidateTotals: true);
    }

    private async Task ClearFiltersAsync()
    {
        _showConfigurableOnly = false;
        _showOverriddenOnly = false;
        await OnFilterChangedAsync();
    }

    /// <summary>
    /// Low-lights a setting whose value is fixed by an environment variable, so the rows that cannot be edited
    /// read as such before the reader reaches the Status column.
    /// </summary>
    private static string? RowClass(ServiceSetting setting, int _) => setting.IsReadOnly ? "jim-readonly-row" : null;

    private static string GetCategoryDisplayName(object? categoryValue)
    {
        var categoryString = categoryValue?.ToString();
        return categoryString switch
        {
            "SSO" => "Single Sign-On (SSO)",
            "Synchronisation" => "Synchronisation",
            "Maintenance" => "Maintenance",
            "History" => "History",
            "Security" => "Security",
            "Instance" => "Instance",
            _ => categoryString ?? "Unknown"
        };
    }

    private async Task RevealSecretAsync(string key)
    {
        var setting = _settings.FirstOrDefault(s => s.Key == key);
        if (setting == null)
            return;

        var result = GetDecryptedValue(setting);
        if (result.Error)
        {
            await DialogService.ShowMessageBoxAsync(
                "Decryption Failed",
                "Unable to decrypt this value. The encryption key may have changed or been deleted (e.g. after a environment reset). Edit and re-save this setting to re-encrypt it with the current key.",
                yesText: "OK");
            return;
        }

        _decryptedCache[key] = result;
        _revealedSecrets.Add(key);
        await RefreshRowsAsync();
    }

    private async Task HideSecret(string key)
    {
        _revealedSecrets.Remove(key);
        _decryptedCache.Remove(key);
        await RefreshRowsAsync();
    }

    /// <summary>
    /// Re-renders the rows the grid is holding, without re-counting. Revealing or hiding a secret changes what one
    /// cell shows and nothing about which settings match, and the grid caches its rows, so a page re-render alone
    /// is not enough to repaint them.
    /// </summary>
    private async Task RefreshRowsAsync()
    {
        if (_grid != null)
            await _grid.RefreshAsync();
    }

    private (string? Value, bool Error) GetDecryptedValue(ServiceSetting setting)
    {
        var effectiveValue = setting.GetEffectiveValue();
        if (string.IsNullOrEmpty(effectiveValue))
            return (null, false);

        try
        {
            return (CredentialProtection.Unprotect(effectiveValue), false);
        }
        catch (System.Security.Cryptography.CryptographicException)
        {
            return (null, true);
        }
    }

    /// <summary>
    /// The setting as it will be stored, for the preflight to compare against its last captured snapshot. Only the
    /// value moves; the update and revert paths change nothing else, and IsOverridden is derived from the value. A
    /// StringEncrypted setting is stored encrypted but snapshotted as a keyed hash of its *decrypted* value, so
    /// passing the plaintext here is not just harmless but exact: retyping the same secret correctly reports no change.
    /// </summary>
    private static ServiceSetting WithValue(ServiceSetting setting, string? value) => new()
    {
        Key = setting.Key,
        DisplayName = setting.DisplayName,
        Category = setting.Category,
        ValueType = setting.ValueType,
        DefaultValue = setting.DefaultValue,
        Value = value
    };

    private async Task ShowEditDialog(ServiceSetting setting)
    {
        var parameters = new DialogParameters<EditSettingDialog>
        {
            { x => x.Setting, setting }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EditSettingDialog>($"Edit {setting.DisplayName}", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string newValue })
        {
            try
            {
                using var jim = JimFactory.Create();

                // nearly every Service Setting is operational and saves in silence; the ones that steer
                // synchronisation are acknowledged first.
                var preflight = await jim.ConfigurationChangePreflight.EvaluateServiceSettingAsync(WithValue(setting, newValue));
                if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                        "Service Setting", setting.DisplayName))
                    return;

                // offer an optional reason for the configuration change history; cancelling aborts the save
                var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
                if (cancelled)
                    return;

                var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
                await jim.ServiceSettings.UpdateSettingValueAsync(setting.Key, newValue, user, changeReason);
                await ReloadListAsync();
                Snackbar.Add($"Setting '{setting.DisplayName}' updated.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to update setting: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task HandleRevertAsync(ServiceSetting setting)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Revert to Default",
            $"Are you sure you want to revert '{setting.DisplayName}' to its default value?",
            yesText: "Revert", cancelText: "Cancel");

        if (confirm == true)
        {
            try
            {
                using var jim = JimFactory.Create();

                // a revert is a value change like any other; whether it needs acknowledging depends on the setting.
                // A null value is the setting's own way of saying "use the default", matching what the revert stores.
                var preflight = await jim.ConfigurationChangePreflight.EvaluateServiceSettingAsync(WithValue(setting, null));
                if (!await ConfigurationChangeAcknowledgementDialog.ConfirmAsync(DialogService, preflight,
                        "Service Setting", setting.DisplayName))
                    return;

                // offer an optional reason for the configuration change history; cancelling aborts the revert
                var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Revert");
                if (cancelled)
                    return;

                var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
                await jim.ServiceSettings.RevertSettingToDefaultAsync(setting.Key, user, changeReason);
                await ReloadListAsync();
                Snackbar.Add($"Setting '{setting.DisplayName}' reverted to default.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to revert setting: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task ShowHistoryDialogAsync(ServiceSetting setting)
    {
        await ConfigurationChangeHistoryDialog.ShowAsync(DialogService, ActivityTargetType.ServiceSetting,
            setting.Key, "Service Setting", setting.DisplayName);
    }

    private async Task CopyToClipboardAsync(string value)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", value);
            Snackbar.Add("Copied to clipboard.", Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add("Failed to copy to clipboard.", Severity.Error);
        }
    }
}
