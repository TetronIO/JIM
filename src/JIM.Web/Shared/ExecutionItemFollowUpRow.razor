@* One follow-up of an execution item (#2668): what the work is, where it stands, the sentence beneath, and a link to its
   Activity. The item page's Follow-up section lists these; the object timeline shows one beneath its export's row. *@
<div class="jim-follow-up-row" data-testid="jim-follow-up" data-state="@FollowUp.StateLabel">
    <MudIcon Icon="@Icon" Class="jim-follow-up-icon" aria-hidden="true" />
    <div class="jim-follow-up-what">
        <div class="jim-follow-up-title">
            <span>@FollowUp.Title</span>
            <span class="@($"jim-status-pill jim-status-pill--{FollowUp.PillModifier}")">
                <span class="jim-status-dot"></span>@FollowUp.StateLabel
            </span>
        </div>
        @if (!string.IsNullOrWhiteSpace(FollowUp.Detail))
        {
            <div class="jim-follow-up-detail">@FollowUp.Detail</div>
        }
    </div>
    <div class="jim-follow-up-link d-flex align-center" style="gap: 0.5rem;">
        @if (FollowUp.RetryableChangeId is { } changeId)
        {
            <ExchangeChangeRetryButton ChangeId="changeId" Retrying="FollowUp.RetryableChangeIsRetrying" OnRetried="OnRetried" />
        }
        <MudLink Href="@FollowUp.ActivityHref">View Activity</MudLink>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ExecutionItemFollowUpDisplay FollowUp { get; set; } = null!;

    /// <summary>Raised after a retry offered on this follow-up has run, so the host can re-read where it stands.</summary>
    [Parameter]
    public EventCallback OnRetried { get; set; }

    private string Icon => FollowUp.Kind switch
    {
        JIM.Models.Activities.ActivityTargetType.PasswordSynchronisation => Icons.Material.Filled.Key,
        JIM.Models.Activities.ActivityTargetType.ExchangeRecipient => Icons.Material.Filled.Email,
        _ => Icons.Material.Filled.SubdirectoryArrowRight
    };
}
