<PageTitle>Pending Export Detail</PageTitle>

@if (_pendingExport != null)
{
    <MudText Typo="Typo.h3">
        <span>Pending Export:</span>
        <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetPendingExportChangeTypeColor(_pendingExport.ChangeType)" Class="ml-2">
            @_pendingExport.ChangeType
        </MudChip>
    </MudText>
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard Outlined="true" Elevation="0">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Details</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudSimpleTable Hover="true" Dense="true" Elevation="0" Class="jim-detail-table">
                        <tbody>
                            <tr>
                                <td><strong>ID</strong></td>
                                <td>@_pendingExport.Id</td>
                            </tr>
                            <tr>
                                <td><strong>Status</strong></td>
                                <td>
                                    <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetPendingExportStatusColor(_pendingExport.Status)">
                                        @_pendingExport.Status.ToString().SplitOnCapitalLetters()
                                    </MudChip>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Change Type</strong></td>
                                <td>
                                    <MudChip T="string" Variant="Variant.Text" Color="Helpers.GetPendingExportChangeTypeColor(_pendingExport.ChangeType)">
                                        @_pendingExport.ChangeType
                                    </MudChip>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Connected System</strong></td>
                                <td>
                                    <MudLink Typo="Typo.body1" Href="@Utilities.GetConnectedSystemHref(_connectedSystemHeader!)">
                                        @_pendingExport.ConnectedSystem.Name
                                    </MudLink>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Created</strong></td>
                                <td>
                                    <MudTooltip Text="@_pendingExport.CreatedAt.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                                        <MudText>@_pendingExport.CreatedAt.ToLocalTime().ToRelativeTime()</MudText>
                                    </MudTooltip>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Has Unresolved References</strong></td>
                                <td>
                                    @if (_pendingExport.HasUnresolvedReferences)
                                    {
                                        <MudChip T="string" Variant="Variant.Text" Color="Color.Warning">Yes</MudChip>
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.body1">No</MudText>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="6">
            <MudCard Outlined="true" Elevation="0">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Related Objects</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudSimpleTable Hover="true" Dense="true" Elevation="0" Class="jim-detail-table">
                        <tbody>
                            <tr>
                                <td><strong>Target CSO</strong></td>
                                <td>
                                    @if (_pendingExport.ConnectedSystemObject != null)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudLink Href="@($"/admin/connected-systems/{ConnectedSystemId}/connector-space/{_pendingExport.ConnectedSystemObject.Id}")"
                                                     Underline="Underline.None" Class="jim-chip-link"
                                                     Style="margin: 0;">
                                                <MudChip T="string" Color="Color.Default"
                                                         Style="margin: 0;">
                                                    <AvatarContent>
                                                        <MudAvatar Color="Color.Secondary">CS</MudAvatar>
                                                    </AvatarContent>
                                                    <ChildContent>
                                                        <b class="jim-cs-chip-prefix">@_pendingExport.ConnectedSystemObject.Type.Name:</b>&nbsp;@GetCsoDisplayName()
                                                    </ChildContent>
                                                </MudChip>
                                            </MudLink>
                                        </MudStack>
                                    }
                                    else
                                    {
                                        <span class="mud-text-secondary">New object (will be created)</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Source MVO</strong></td>
                                <td>
                                    @if (_pendingExport.SourceMetaverseObject != null)
                                    {
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                            <MudLink Href="@Utilities.GetMetaverseObjectHref(_pendingExport.SourceMetaverseObject)"
                                                     Underline="Underline.None" Class="jim-chip-link"
                                                     Style="margin: 0;">
                                                <MudChip T="string" Color="Color.Default"
                                                         Style="margin: 0;">
                                                    <AvatarContent>
                                                        <MudAvatar Color="Color.Primary">MV</MudAvatar>
                                                    </AvatarContent>
                                                    <ChildContent>
                                                        <b class="jim-mv-chip-prefix">@_pendingExport.SourceMetaverseObject.Type.Name:</b>&nbsp;@GetMvoDisplayName()
                                                    </ChildContent>
                                                </MudChip>
                                            </MudLink>
                                        </MudStack>
                                    }
                                    else if (_pendingExport.SourceMetaverseObjectId.HasValue)
                                    {
                                        <span>@_pendingExport.SourceMetaverseObjectId</span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </MudSimpleTable>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @if (_pendingExport.ErrorCount > 0 || !string.IsNullOrEmpty(_pendingExport.LastErrorMessage))
        {
            <MudItem xs="12">
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-0" Style="align-items: flex-start;">
                    <MudText Typo="Typo.h6" Class="mb-3" Style="line-height: 1.5rem;">Error Information</MudText>
                    <MudSimpleTable Hover="true" Dense="true" Elevation="0" Style="background: transparent;">
                        <tbody>
                            <tr>
                                <td style="width: 200px;"><strong>Error Count</strong></td>
                                <td>
                                    <MudChip T="string" Variant="Variant.Text" Color="Color.Error">
                                        @_pendingExport.ErrorCount / @_pendingExport.MaxRetries
                                    </MudChip>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Last Attempted</strong></td>
                                <td>@(_pendingExport.LastAttemptedAt?.ToFriendlyDate() ?? "-")</td>
                            </tr>
                            @* Next Retry is hidden until event-based sync is implemented
                            <tr>
                                <td><strong>Next Retry</strong></td>
                                <td>@(_pendingExport.NextRetryAt?.ToFriendlyDate() ?? "-")</td>
                            </tr>
                            *@
                            @if (!string.IsNullOrEmpty(_pendingExport.LastErrorMessage))
                            {
                                <tr>
                                    <td><strong>Error Message</strong></td>
                                    <td>
                                        <pre style="white-space: pre-wrap; word-wrap: break-word; margin: 0;">@_pendingExport.LastErrorMessage</pre>
                                    </td>
                                </tr>
                            }
                            @if (!string.IsNullOrEmpty(_pendingExport.LastErrorStackTrace))
                            {
                                <tr>
                                    <td><strong>Stack Trace</strong></td>
                                    <td>
                                        <CollapsibleStackTrace StackTrace="@_pendingExport.LastErrorStackTrace" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                </MudAlert>
            </MudItem>
        }

        <MudItem xs="12">
            @if (_pendingExport.AttributeValueChanges.Count > 0)
            {
                @* One row per attribute, as before. The changes came back with the rest of the page (capped per
                   multi-valued attribute, with the "+n more" dialog for the remainder), so windows are sliced
                   from that list in memory rather than costing a database read per scroll. *@
                <VirtualisedDataGrid T="AttributeChangeGroup"
                                     ContainerId="pending-export-attribute-changes"
                                     StateKey="@Id.ToString()"
                                     DefaultSortBy="attribute"
                                     LoadWindow="LoadAttributeChangeWindowAsync"
                                     SearchPlaceholder="Search attribute name or value"
                                     SingularName="Attribute"
                                     PluralName="Attributes">
                    <ToolBarExtras>
                        <MudText Typo="Typo.h6">Attribute Changes</MudText>
                        @* Bare number: the title beside it already names the objects (JIM.Web/CLAUDE.md
                           convention). It counts the changes; the grid's own count on the right counts the rows,
                           which are attributes, and a multi-valued attribute is one row carrying many changes. *@
                        <TableObjectCount Count="@_attributeChangeTotalCounts.Values.Sum()" Class="ml-2" />
                    </ToolBarExtras>
                    <Columns>
                        <TemplateColumn Title="Attribute" Sortable="false" HeaderClass="jim-attr-header-name">
                            <HeaderTemplate>
                                <VirtualisedSortHeader Title="Attribute" Name="attribute" />
                            </HeaderTemplate>
                            <CellTemplate>
                                <MudText Typo="Typo.body1" Class="mud-text-secondary">@context.Item.AttributeName</MudText>
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Change Type" Sortable="false">
                            <HeaderTemplate>
                                <MudText Typo="Typo.button">Change Type</MudText>
                            </HeaderTemplate>
                            <CellTemplate>
                                @if (context.Item.Values.Count == 1)
                                {
                                    <MudChip T="string" Variant="Variant.Text" Color="GetAttributeChangeTypeColor(context.Item.Values[0].ChangeType)">
                                        @context.Item.Values[0].ChangeType
                                    </MudChip>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body1" Class="mud-text-secondary">@context.Item.Values.Count changes</MudText>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Status" Sortable="false">
                            <HeaderTemplate>
                                <MudText Typo="Typo.button">Status</MudText>
                            </HeaderTemplate>
                            <CellTemplate>
                                @if (context.Item.Values.Count == 1)
                                {
                                    <MudChip T="string" Variant="Variant.Text" Color="GetAttributeChangeStatusColor(context.Item.Values[0].Status)">
                                        @context.Item.Values[0].Status.ToString().SplitOnCapitalLetters()
                                    </MudChip>
                                }
                            </CellTemplate>
                        </TemplateColumn>
                        <TemplateColumn Title="Value" Sortable="false" HeaderClass="jim-attr-header-value" CellClass="jim-attr-value">
                            <HeaderTemplate>
                                <MudText Typo="Typo.button">Value</MudText>
                            </HeaderTemplate>
                            <CellTemplate>
                                @* A row in a virtualised table is one line: the virtualiser positions every row
                                   from one fixed ItemSize, so a cell that stacks its queued changes puts
                                   everything below it at an offset nothing on the page agrees with. An attribute
                                   carrying several changes therefore shows the first and sends the rest to a
                                   dialog, which holds a virtualised grid of them so none is out of reach. *@
                                @{ var group = context.Item; }
                                <div class="jim-one-line-list">
                                    <span class="jim-one-line-list-value">@GetAttributeValue(group.Values[0])</span>
                                    @if (group.TotalCount > 1)
                                    {
                                        <MudButton Variant="Variant.Outlined" Class="jim-attr-expand-btn"
                                                   OnClick="@(() => OpenMvaDialogAsync(group.AttributeName, group.TotalCount))">
                                            +@((group.TotalCount - 1).ToString("N0")) more
                                        </MudButton>
                                    }
                                </div>
                            </CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <EmptyContent Context="grid">
                        @* A search that matched nothing has a way out to offer; a Pending Export carrying no
                           attribute changes is a different situation, and says what would put rows here. *@
                        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
                        {
                            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                             PrimaryText="@($"No attributes match \"{grid.SearchText}\"")"
                                             SecondaryText="Try a different search term, or clear the search."
                                             ActionText="Clear Search"
                                             OnAction="@(() => grid.ClearSearchAsync())" />
                        }
                        else
                        {
                            <TableEmptyState Icon="@Icons.Material.Filled.PublishedWithChanges"
                                             PrimaryText="No attribute changes"
                                             SecondaryText="Attribute changes appear here when a Synchronisation Rule flows a value to this Connected System Object." />
                        }
                    </EmptyContent>
                </VirtualisedDataGrid>
            }
            else
            {
                <MudPaper Outlined="true" Class="pa-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Attribute Changes (0)</MudText>
                    <MudText Class="mud-text-secondary">
                        @if (_pendingExport.ChangeType == PendingExportChangeType.Delete)
                        {
                            <text>No attribute changes (object will be deleted).</text>
                        }
                        else
                        {
                            <text>No attribute changes recorded.</text>
                        }
                    </MudText>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}
else if (_notFound)
{
    @* A Pending Export is deleted the moment it is exported, so a link to one is only good while it
       is still queued. Saying "not found" implies something is wrong; almost always nothing is, the
       change simply reached its Connected System. Name the likely reasons rather than leave the
       reader wondering whether they have hit a bug. *@
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
        This Pending Export is no longer queued. It has either been exported to the Connected System,
        or been superseded by a later change to the same Connected System Object. Pending Exports are
        removed once they are no longer waiting to be applied, so links to an individual one stop
        resolving after its export runs.
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="@($"/admin/connected-systems/{ConnectedSystemId}/pending-exports")" Class="mt-4">
        Back to List
    </MudButton>
}
else
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mt-5" />
}

@code {
    [Parameter]
    public int ConnectedSystemId { get; set; }

    [Parameter]
    public Guid Id { get; set; }

    private PendingExport? _pendingExport;
    private ConnectedSystemHeader? _connectedSystemHeader;
    private Dictionary<string, int> _attributeChangeTotalCounts = new();
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private bool _notFound;
    private List<AttributeChangeGroup> _attributeChangeGroups = new();

    protected override async Task OnParametersSetAsync()
    {
        using var jim = JimFactory.Create();
        _connectedSystemHeader = await jim.ConnectedSystems.GetConnectedSystemHeaderAsync(ConnectedSystemId);
        if (_connectedSystemHeader == null)
        {
            NavManager.NavigateTo("/admin/connected-systems/");
            return;
        }

        var detailResult = await jim.ConnectedSystems.GetPendingExportDetailAsync(Id);
        _pendingExport = detailResult?.PendingExport;
        _attributeChangeTotalCounts = detailResult?.AttributeChangeTotalCounts ?? new();
        if (_pendingExport == null)
        {
            _notFound = true;
            _breadcrumbs = new List<BreadcrumbItem>
            {
                new("Home", href: "/", icon: Icons.Material.Filled.Home),
                new("Administration", href: "/admin"),
                new("Connected Systems", href: "/admin/connected-systems/"),
                new(_connectedSystemHeader.Name, href: Utilities.GetConnectedSystemHref(_connectedSystemHeader)),
                new("Pending Exports", href: $"/admin/connected-systems/{ConnectedSystemId}/pending-exports"),
                new("Not Found", href: null, disabled: true)
            };
            return;
        }

        // Grouped once here rather than per window read: the grid slices its windows from this list, and
        // re-grouping every change on every scroll would do the same work again for no new information.
        _attributeChangeGroups = GetGroupedChanges();

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("Home", href: "/", icon: Icons.Material.Filled.Home),
            new("Connected Systems", href: "/admin/connected-systems/"),
            new(_connectedSystemHeader.Name, href: Utilities.GetConnectedSystemHref(_connectedSystemHeader)),
            new("Pending Exports", href: $"/admin/connected-systems/{ConnectedSystemId}/pending-exports"),
            new(_pendingExport.ChangeType.ToString(), href: null, disabled: true)
        };
    }

    private string GetCsoDisplayName()
    {
        if (_pendingExport?.ConnectedSystemObject == null)
            return "Unknown";

        return _pendingExport.ConnectedSystemObject.NameOrId
            ?? _pendingExport.ConnectedSystemObject.Id.ToString();
    }

    private string GetMvoDisplayName()
    {
        if (_pendingExport?.SourceMetaverseObject == null)
            return _pendingExport?.SourceMetaverseObjectId?.ToString() ?? "Unknown";

        // Use the built-in DisplayName property which looks up the displayname attribute
        return _pendingExport.SourceMetaverseObject.NameOrId
            ?? _pendingExport.SourceMetaverseObject.Id.ToString();
    }

    private string GetAttributeValue(PendingExportAttributeValueChange change)
    {
        if (!string.IsNullOrEmpty(change.UnresolvedReferenceValue))
            return $"[Unresolved Reference: {change.UnresolvedReferenceValue}]";

        if (change.StringValue != null)
            return change.StringValue;

        if (change.DateTimeValue.HasValue)
            return change.DateTimeValue.Value.ToFriendlyDate();

        if (change.IntValue.HasValue)
            return change.IntValue.Value.ToString();

        if (change.ByteValue != null)
            return $"[Binary data: {change.ByteValue.Length} bytes]";

        return "[null]";
    }

    private static MudBlazor.Color GetAttributeChangeTypeColor(PendingExportAttributeChangeType changeType)
    {
        return changeType switch
        {
            PendingExportAttributeChangeType.Add => MudBlazor.Color.Primary,
            PendingExportAttributeChangeType.Update => MudBlazor.Color.Info,
            PendingExportAttributeChangeType.Remove => MudBlazor.Color.Warning,
            PendingExportAttributeChangeType.RemoveAll => MudBlazor.Color.Error,
            _ => MudBlazor.Color.Default,
        };
    }

    private static MudBlazor.Color GetAttributeChangeStatusColor(PendingExportAttributeChangeStatus status)
    {
        return status switch
        {
            PendingExportAttributeChangeStatus.Pending => MudBlazor.Color.Default,
            PendingExportAttributeChangeStatus.ExportedPendingConfirmation => MudBlazor.Color.Info,
            PendingExportAttributeChangeStatus.ExportedNotConfirmed => MudBlazor.Color.Warning,
            PendingExportAttributeChangeStatus.Failed => MudBlazor.Color.Error,
            _ => MudBlazor.Color.Default,
        };
    }

    private List<AttributeChangeGroup> GetGroupedChanges()
    {
        if (_pendingExport == null)
            return new List<AttributeChangeGroup>();

        return _pendingExport.AttributeValueChanges
            .GroupBy(v => v.Attribute?.Name ?? $"Attribute {v.AttributeId}")
            .Select(g => new AttributeChangeGroup(
                g.Key,
                g.ToList(),
                _attributeChangeTotalCounts.GetValueOrDefault(g.Key, g.Count())))
            .OrderBy(g => g.AttributeName)
            .ToList();
    }

    private async Task OpenMvaDialogAsync(string attributeName, int totalCount)
    {
        var parameters = new DialogParameters<PendingExportMvaDialog>
        {
            { x => x.AttributeName, attributeName },
            { x => x.PendingExportId, Id },
            { x => x.TotalCount, totalCount }
        };

        var options = new DialogOptions
        {
            CloseButton = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        await DialogService.ShowAsync<PendingExportMvaDialog>(attributeName, parameters, options);
    }

    /// <summary>
    /// Slices one window of attributes from the list the page already holds, applying the grid's search over the
    /// attribute's name and its loaded values (the same two fields the paged table's filter matched on) and the
    /// attribute-name sort. The count is only taken when the request asks for it, so a null total means "not
    /// counted" rather than "nothing matched".
    /// </summary>
    private Task<VirtualisedWindow<AttributeChangeGroup>> LoadAttributeChangeWindowAsync(
        VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<AttributeChangeGroup> groups = _attributeChangeGroups;

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            groups = groups.Where(g =>
                g.AttributeName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                g.Values.Any(v => GetAttributeValue(v).Contains(search, StringComparison.OrdinalIgnoreCase)));
        }

        var sorted = request.SortDescending
            ? groups.OrderByDescending(g => g.AttributeName, StringComparer.OrdinalIgnoreCase)
            : groups.OrderBy(g => g.AttributeName, StringComparer.OrdinalIgnoreCase);

        return Task.FromResult(sorted.ToWindow(request));
    }

    /// <summary>
    /// One row of the attribute changes grid: an attribute and the queued changes to it this Pending Export
    /// carries. Public so the grid's window loader can be exercised by name from the component tests.
    /// </summary>
    public record AttributeChangeGroup(
        string AttributeName,
        List<PendingExportAttributeValueChange> Values,
        int TotalCount);
}
