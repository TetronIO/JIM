@using JIM.Models.Core
@using JIM.Models.Core.DTOs
@using JIM.Utilities
@using JIM.Web.Models
@using JIM.Web.Services
@inject IJimApplicationFactory JimFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Thin surface over the shared ConsequenceConfirmationDialog: this component owns evaluating the *@
@* deletion impact and performing the delete; the shared dialog owns presenting it and the consent *@
@* rules. See engineering/plans/doing/CONFIGURATION_CHANGE_PREVIEW.md (Phase 2). *@

<ConsequenceConfirmationDialog Loading="@(_impact == null)"
                               LoadingText="Evaluating deletion impact..."
                               Blockers="@BuildBlockers()"
                               SafeMessage="No Metaverse Objects of this type exist and no Synchronisation Rule targets it. Safe to delete."
                               Consequences="@BuildConsequences()"
                               ConfirmationPhrase="@BuildConfirmationPhrase()"
                               ConfirmButtonText="@BuildConfirmButtonText()"
                               BusyText="Deleting..."
                               OnConfirmAsync="DeleteAsync" />

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    /// <summary>
    /// The Object Type to delete.
    /// </summary>
    [Parameter]
    public MetaverseObjectType ObjectType { get; set; } = null!;

    private ObjectTypeDeletionImpact? _impact;

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _impact = await jim.Metaverse.EvaluateObjectTypeDeletionAsync(ObjectType);
    }

    private IReadOnlyList<ConsequenceBlocker> BuildBlockers()
    {
        if (_impact == null)
            return [];

        var blockers = new List<ConsequenceBlocker>();

        if (_impact.BuiltIn)
        {
            blockers.Add(new ConsequenceBlocker
            {
                Headline = "This is a built-in Metaverse Object Type",
                Body = "Built-in Object Types are part of JIM's own schema and cannot be deleted."
            });
        }

        if (_impact.BlockedByObjects)
        {
            blockers.Add(new ConsequenceBlocker
            {
                Headline = $"{_impact.MetaverseObjectCount:N0} Metaverse Object(s) of this type exist",
                Body = "A type cannot be deleted while Metaverse Objects of it exist. Delete those objects first (stop the source flows and let them deprovision, or delete them manually), then delete the type.",
                LinkHref = Utilities.GetMetaverseObjectListHref(ObjectType.PluralName),
                LinkText = "View these Metaverse Objects"
            });
        }

        if (_impact.BlockedBySynchronisationRules)
        {
            blockers.Add(new ConsequenceBlocker
            {
                Headline = $"{_impact.SynchronisationRules.Count} Synchronisation Rule(s) target this type",
                Items = _impact.SynchronisationRules.Select(rule => new ConsequenceItem
                {
                    Text = rule.Description,
                    Icon = Icons.Material.Filled.SyncAlt
                }).ToList(),
                Body = "Remove these Synchronisation Rules first; deleting the type would otherwise remove the whole rule."
            });
        }

        return blockers;
    }

    private ConsequenceGroup? BuildConsequences()
    {
        if (_impact == null || _impact.CascadeReferences.Count == 0)
            return null;

        return new ConsequenceGroup
        {
            Headline = $"These {_impact.CascadeReferences.Count} reference(s) will also be removed",
            Note = "Bound attributes themselves are kept; only their bindings to this type are removed.",
            Items = _impact.CascadeReferences.Select(reference => new ConsequenceItem
            {
                Text = DescribeReference(reference),
                Icon = ReferenceIcon(reference.Kind)
            }).ToList()
        };
    }

    // Cascade references require the typed confirmation; a clean delete does not.
    private string? BuildConfirmationPhrase() =>
        _impact is { CascadeReferences.Count: > 0 } ? _impact.ObjectTypeName : null;

    private string BuildConfirmButtonText()
    {
        if (_impact == null)
            return "Delete";

        return _impact.CascadeReferences.Count > 0
            ? $"Delete + {_impact.CascadeReferences.Count} reference(s)"
            : "Delete";
    }

    private static string ReferenceIcon(ObjectTypeReferenceKind kind) => kind switch
    {
        ObjectTypeReferenceKind.PredefinedSearch => Icons.Material.Filled.Search,
        ObjectTypeReferenceKind.ExampleDataTemplate => Icons.Material.Filled.Dataset,
        ObjectTypeReferenceKind.AttributeBinding => Icons.Material.Filled.Link,
        _ => Icons.Material.Filled.SyncAlt
    };

    private static string DescribeReference(ObjectTypeReference reference) => reference.Kind switch
    {
        ObjectTypeReferenceKind.PredefinedSearch => $"Predefined Search: {reference.Description}",
        ObjectTypeReferenceKind.ExampleDataTemplate => $"Example Data Template: {reference.Description}",
        ObjectTypeReferenceKind.AttributeBinding => $"Attribute binding: {reference.Description}",
        _ => reference.Description
    };

    private async Task<bool> DeleteAsync()
    {
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, "Delete");
        if (cancelled)
            return false;

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var impact = await jim.Metaverse.DeleteMetaverseObjectTypeAsync(ObjectType, user, changeReason);
            if (!impact.Deleted)
            {
                Snackbar.Add("The Object Type could not be deleted; its state may have changed. Refresh and try again.", Severity.Warning);
                return false;
            }

            Snackbar.Add($"Deleted Object Type \"{impact.ObjectTypeName}\".", Severity.Success);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add($"Failed to delete Object Type: {ex.Message}", Severity.Error);
            return false;
        }

        return true;
    }

    /// <summary>
    /// Opens the delete dialog for a Metaverse Object Type. Returns true when the type was deleted.
    /// </summary>
    public static async Task<bool> ShowAsync(IDialogService dialogService, MetaverseObjectType objectType)
    {
        var parameters = new DialogParameters<DeleteMetaverseObjectTypeDialog>
        {
            { x => x.ObjectType, objectType }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await dialogService.ShowAsync<DeleteMetaverseObjectTypeDialog>($"Delete \"{objectType.Name}\" Object Type", parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: true };
    }
}
