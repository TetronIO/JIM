@* Where a Connected System stands on Password Synchronisation, and how much of its queued work is waiting on a
   person (#1119, requirement 26). Shaped after InitialPasswordAttentionIndicator so the two read as one idea on
   the same list, with one deliberate difference: this one shows a state chip as well as the counts, because
   "off" is itself something an administrator needs to see. A system with Password Synchronisation switched off
   keeps accumulating changes; silence would read as "nothing to see" when it means "a backlog is building". *@
@if (State is PasswordSynchronisationState.Enabled or PasswordSynchronisationState.Disabled)
{
    <MudTooltip Arrow="true" Placement="Placement.Top">
        <TooltipContent><TooltipText Text="@StateTooltip" /></TooltipContent>
        <ChildContent>
            <MudChip T="string" Color="@(State == PasswordSynchronisationState.Enabled ? Color.Info : Color.Default)"
                     Variant="Variant.Text" Icon="@Icons.Material.Filled.Password" Class="jim-stat-chip">
                @(State == PasswordSynchronisationState.Enabled ? "Password Sync" : "Password Sync off")
            </MudChip>
        </ChildContent>
    </MudTooltip>
}
@* The counts are shown whatever the state, including on a system the Connector can no longer deliver to. A
   Connector Definition can lose SupportsPasswordSet on upgrade while a queue it once accepted is still sitting
   there, and hiding that would leave outstanding work nothing on the page mentions. *@
@if (ParkedCount > 0)
{
    <MudTooltip Arrow="true" Placement="Placement.Top">
        <TooltipContent><TooltipText Text="@ParkedTooltip" /></TooltipContent>
        <ChildContent>
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Text"
                     Icon="@Icons.Material.Filled.PauseCircleOutline" Class="jim-stat-chip">
                @ParkedCount.ToString("N0")
            </MudChip>
        </ChildContent>
    </MudTooltip>
}
@if (ExpiredCount > 0)
{
    <MudTooltip Arrow="true" Placement="Placement.Top">
        <TooltipContent><TooltipText Text="@ExpiredTooltip" /></TooltipContent>
        <ChildContent>
            <MudChip T="string" Color="Color.Error" Variant="Variant.Text"
                     Icon="@Icons.Material.Filled.HourglassDisabled" Class="jim-stat-chip">
                @ExpiredCount.ToString("N0")
            </MudChip>
        </ChildContent>
    </MudTooltip>
}

@code {
    /// <summary>
    /// Where the Connected System stands. Null (not yet loaded) renders nothing, so a list does not flash an
    /// indicator before the answer is known.
    /// </summary>
    [Parameter]
    public PasswordSynchronisationState? State { get; set; }

    /// <summary>
    /// How much of this system's queued password work is waiting on a person. Null or all-zero renders no counts:
    /// silence is the reward for needing no action, matching the configuration drift indicator.
    /// </summary>
    [Parameter]
    public PasswordQueueAttention? Attention { get; set; }

    /// <summary>
    /// The Connected System's name, woven into the tooltips where it reads better than "this one".
    /// </summary>
    [Parameter]
    public string? ConnectedSystemName { get; set; }

    // Captured into locals rather than dereferenced in markup: CodeQL does not follow the property-pattern guard
    // into the expression, and the finding blocks the merge (see JIM.Web/CLAUDE.md).
    private int ParkedCount => Attention?.ParkedCount ?? 0;

    private int ExpiredCount => Attention?.ExpiredCount ?? 0;

    private string Subject => string.IsNullOrWhiteSpace(ConnectedSystemName) ? "this Connected System" : ConnectedSystemName;

    private string StateTooltip => State == PasswordSynchronisationState.Enabled
        ? $"{Subject} receives synchronised password changes. Each one is queued and delivered on its own clock, with retries, so the system being unavailable delays a password rather than losing it."
        : $"Password Synchronisation is configured for {Subject} but switched off. Changes still accumulate for it and are delivered when it is switched back on; they are not discarded in the meantime.";

    private string ParkedTooltip
    {
        get
        {
            var changes = ParkedCount == 1 ? "1 queued password change is" : $"{ParkedCount:N0} queued password changes are";

            return $"{changes} parked for {Subject}. The target refused them, or they ran out of attempts, so JIM has " +
                   "stopped trying. Deal with the reason on the Password Synchronisation page, then retry them from there.";
        }
    }

    private string ExpiredTooltip
    {
        get
        {
            var changes = ExpiredCount == 1 ? "1 queued password change" : $"{ExpiredCount:N0} queued password changes";

            return $"{changes} for {Subject} outlived the time to live and can no longer be delivered. Those people's " +
                   "passwords on that system are out of step with the rest, and JIM will not close the gap on its own.";
        }
    }
}
