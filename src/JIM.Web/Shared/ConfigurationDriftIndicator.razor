@* Renders nothing at all when the configuration is settled and nothing is waiting: silence is the reward for a system
   that needs no action. Tracking being switched off is deliberately not rendered here either. It is a single global
   condition, so repeating it on every row of a list states the same fact many times over; the hosting page says it once
   instead.

   Changes awaiting the next synchronisation (#2615) are a state of their own, beside the drift chip rather than inside
   it: they never count as drift, because an ordinary Delta or Full Synchronisation applies them, so the two are
   different asks (wait for the next run; run a Full Synchronisation). A system can have both. *@
@if (Status != null && (Status.HasPendingChanges || Status.NeverFullySynchronised))
{
    <MudTooltip Text="@TooltipText" Arrow="true" Placement="Placement.Top">
        <MudChip T="string" Color="@ChipColour" Variant="Variant.Text" Icon="@ChipIcon" Class="jim-stat-chip">
            @ChipLabel
        </MudChip>
    </MudTooltip>
}

@if (Status is { HasChangesAwaitingSynchronisation: true })
{
    <MudTooltip Text="@AwaitingTooltipText" Arrow="true" Placement="Placement.Top">
        <MudChip T="string" Color="Color.Info" Variant="Variant.Text" Icon="@Icons.Material.Filled.PendingActions" Class="jim-stat-chip"
                 data-testid="jim-awaiting-synchronisation-chip">
            @AwaitingChangeCount.ToString("N0")
        </MudChip>
    </MudTooltip>
}

@code {
    /// <summary>
    /// The drift status to render. Null (not yet loaded) renders nothing, so a list does not flash an indicator
    /// before the answer is known.
    /// </summary>
    [Parameter]
    public ConfigurationDriftStatus? Status { get; set; }

    /// <summary>
    /// The name of the Connected System, woven into the tooltip where it reads better than "this Connected System".
    /// </summary>
    [Parameter]
    public string? ConnectedSystemName { get; set; }

    private Color ChipColour => Status switch
    {
        null or { NeverFullySynchronised: true } => Color.Default,
        { HighestChangeClass: ConfigurationChangeClass.Destructive } => Color.Error,
        _ => Color.Warning
    };

    private string ChipIcon => Status switch
    {
        null or { NeverFullySynchronised: true } => Icons.Material.Outlined.NotStarted,
        { HighestChangeClass: ConfigurationChangeClass.Destructive } => Icons.Material.Filled.Warning,
        _ => Icons.Material.Filled.Sync
    };

    // The never-synchronised chip is icon-only: the words "Never synchronised" were the widest thing in the
    // Connected Systems list's Stats column, and at a laptop width they took the room from the Description
    // column beside it. The state is said in full by the tooltip, as it is for the count chips around it.
    private string ChipLabel => Status switch
    {
        null or { NeverFullySynchronised: true } => string.Empty,
        _ => Status.ChangeCount.ToString("N0")
    };

    private string TooltipText
    {
        get
        {
            if (Status == null)
                return string.Empty;

            var subject = string.IsNullOrWhiteSpace(ConnectedSystemName) ? SharedText.DriftThisConnectedSystem : ConnectedSystemName;

            if (Status.NeverFullySynchronised)
                return string.Format(CultureInfo.CurrentCulture, SharedText.DriftNeverFullySynchronised, subject);

            var changes = string.Format(CultureInfo.CurrentCulture,
                PluralRules.Choose(Status.ChangeCount, SharedText.DriftChangesOne, SharedText.DriftChangesOther),
                Status.ChangeCount.ToString("N0", CultureInfo.CurrentCulture));

            // The value is hoisted out of the conditional rather than dereferenced inside it: nullable flow analysis
            // is not something CodeQL follows reliably through a guard here (see the Razor and lambda rules in
            // src/CLAUDE.md), and the local costs nothing.
            var lastFullSync = Status.LastFullSynchronisation;
            var lastFullSyncText = lastFullSync.HasValue ? lastFullSync.Value.ToLocalTime().ToFriendlyDate() : null;

            if (Status.HighestChangeClass == ConfigurationChangeClass.Destructive)
            {
                return lastFullSyncText != null
                    ? string.Format(CultureInfo.CurrentCulture, SharedText.DriftDestructiveSince, changes, lastFullSyncText)
                    : string.Format(CultureInfo.CurrentCulture, SharedText.DriftDestructiveSinceNoDate, changes);
            }

            return lastFullSyncText != null
                ? string.Format(CultureInfo.CurrentCulture,
                    PluralRules.Choose(Status.ChangeCount, SharedText.DriftApplySinceOne, SharedText.DriftApplySinceOther), changes, lastFullSyncText)
                : string.Format(CultureInfo.CurrentCulture,
                    PluralRules.Choose(Status.ChangeCount, SharedText.DriftApplySinceNoDateOne, SharedText.DriftApplySinceNoDateOther), changes);
        }
    }

    // The saved changes waiting for the next synchronisation, across every Object Type that has any.
    private int AwaitingChangeCount => Status?.AwaitingSynchronisation.Sum(awaiting => awaiting.ChangeCount) ?? 0;

    private string AwaitingTooltipText
    {
        get
        {
            if (Status == null)
                return string.Empty;

            var subject = string.IsNullOrWhiteSpace(ConnectedSystemName) ? SharedText.DriftThisConnectedSystemMidSentence : ConnectedSystemName;
            var typeNames = Status.AwaitingSynchronisation.Select(awaiting => awaiting.ObjectTypeName).ToList();
            var count = AwaitingChangeCount;
            var countText = count.ToString("N0", CultureInfo.CurrentCulture);

            if (typeNames.Count == 1)
            {
                return count == 1
                    ? string.Format(CultureInfo.CurrentCulture, SharedText.DriftAwaitingOneChangeOneType, subject, typeNames[0])
                    : string.Format(CultureInfo.CurrentCulture, SharedText.DriftAwaitingManyChangesOneType, countText, subject, typeNames[0]);
            }

            var allButLast = string.Join(", ", typeNames.Take(typeNames.Count - 1));
            return count == 1
                ? string.Format(CultureInfo.CurrentCulture, SharedText.DriftAwaitingOneChangeSeveralTypes, subject, allButLast, typeNames[^1])
                : string.Format(CultureInfo.CurrentCulture, SharedText.DriftAwaitingManyChangesSeveralTypes, countText, subject, allButLast, typeNames[^1]);
        }
    }
}
