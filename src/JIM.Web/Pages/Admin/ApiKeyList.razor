<PageTitle>@AdminText.ApiKeyPageTitle</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Api" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />@AdminText.ApiKeyPageTitle
    <PageInfo Title="@AdminText.ApiKeyPageTitle" DocsPage="configuration/api-keys.md">
        @AdminText.ApiKeyPageInfo
    </PageInfo>
</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the density toggle, the search box
   and the toolbar count) lives in the shared grid; this page loads the full list once (API keys are a small
   configuration list) and slices windows from it in memory. *@
<VirtualisedDataGrid GridClass="mt-2" @ref="_grid" T="ApiKey"
                     ContainerId="api-key-list"
                     DefaultSortBy="name"
                     LoadWindow="LoadApiKeyWindowAsync"
                     SingularName="@AdminText.ApiKeyNounSingular"
                     PluralName="@AdminText.ApiKeyNounPlural">
    <ToolBarExtras>
        <MudButton OnClick="ShowCreateDialog" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
                   DropShadow="false">@AdminText.ApiKeyCreateButton</MudButton>
    </ToolBarExtras>
    <Columns>
        <TemplateColumn Title="@CommonText.ColumnName" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@CommonText.ColumnName" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                <div class="d-flex align-center gap-2">
                    <MudLink Href="@($"/admin/apikeys/{context.Item.Id}")">@context.Item.Name</MudLink>
                    @if (context.Item.IsInfrastructureKey)
                    {
                        <MudTooltip Text="@AdminText.ApiKeyInfrastructureTooltip" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Warning" Icon="@Icons.Material.Filled.Construction">@AdminText.ApiKeyInfrastructure</MudChip>
                        </MudTooltip>
                    }
                    @if (context.Item.ScopeConnectedSystemId is { } scopedTo)
                    {
                        <MudTooltip Text="@AdminText.ApiKeyScopedTooltip" Arrow="true" Placement="Placement.Top">
                            <MudLink Href="@($"/admin/connected-systems/{scopedTo}?t=scim")">
                                <MudChip T="string" Variant="Variant.Text" Color="Color.Info" Icon="@Icons.Material.Filled.Link">SCIM</MudChip>
                            </MudLink>
                        </MudTooltip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AdminText.ApiKeyPrefix" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@AdminText.ApiKeyPrefix" Name="prefix" />
            </HeaderTemplate>
            <CellTemplate>
                <span class="jim-text-code">@context.Item.KeyPrefix...</span>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AdminText.ApiKeyRoles" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">@AdminText.ApiKeyRoles</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @* A row in a virtualised grid is one line, so a chip per role is a row that grows with the key's
                   roles; the first is shown and the rest open in a dialog. *@
                <OverflowList TItem="Role" Items="@context.Item.Roles" Title="@AdminText.ApiKeyRoles">
                    <ItemTemplate Context="role">
                        <MudChip T="string" Variant="Variant.Text" Color="Color.Info" Class="mr-1">@role.Name</MudChip>
                    </ItemTemplate>
                    <EmptyContent>
                        <span class="mud-text-secondary">@AdminText.ApiKeyNoRoles</span>
                    </EmptyContent>
                </OverflowList>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AdminText.ApiKeyLastUsed" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@AdminText.ApiKeyLastUsed" Name="lastused" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.LastUsedAt.HasValue)
                {
                    var lastUsed = context.Item.LastUsedAt.Value.ToLocalTime();
                    <MudTooltip Text="@string.Format(CultureInfo.CurrentCulture, AdminText.ApiKeyLastUsedTooltip, lastUsed.ToFriendlyDate(), context.Item.LastUsedFromIp ?? CommonText.Unknown)" Arrow="true" Placement="Placement.Top">
                        @lastUsed.ToRelativeTime()
                    </MudTooltip>
                }
                else
                {
                    <span class="mud-text-secondary">@CommonText.Never</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AdminText.ApiKeyExpires" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@AdminText.ApiKeyExpires" Name="expires" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.ExpiresAt.HasValue)
                {
                    var expiresAt = context.Item.ExpiresAt.Value;
                    @if (expiresAt < DateTime.UtcNow)
                    {
                        <MudTooltip Text="@expiresAt.ToLocalTime().ToFriendlyDate()"
                            Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Error">@AdminText.CertificateExpired</MudChip>
                        </MudTooltip>
                    }
                    else if (expiresAt < DateTime.UtcNow.AddDays(7))
                    {
                        <MudTooltip Text="@expiresAt.ToLocalTime().ToFriendlyDate()"
                            Arrow="true" Placement="Placement.Top">
                            <MudChip T="string" Variant="Variant.Text" Color="Color.Warning">@((expiresAt - DateTime.UtcNow).Humanize(precision: 2, culture: CultureInfo.CurrentCulture, minUnit: Humanizer.TimeUnit.Minute))</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudTooltip Text="@expiresAt.ToLocalTime().ToFriendlyDate()"
                            Arrow="true" Placement="Placement.Top">
                            @expiresAt.ToLocalTime().ToFriendlyDate()
                        </MudTooltip>
                    }
                }
                else
                {
                    <span class="mud-text-secondary">@CommonText.Never</span>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@CommonText.ColumnStatus" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@CommonText.ColumnStatus" Name="status" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.IsEnabled)
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Success">@CommonText.Enabled</MudChip>
                }
                else
                {
                    <MudChip T="string" Variant="Variant.Text" Color="Color.Default">@CommonText.Disabled</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@CommonText.ColumnActions" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">@CommonText.ColumnActions</MudText>
            </HeaderTemplate>
            <CellTemplate>
                <div class="d-flex justify-end gap-2">
                    @* A SCIM key has no Roles and must expire, which this dialog cannot respect; it is edited on its
                       Connected System's SCIM tab instead. *@
                    <MudTooltip Text="@(context.Item.ScopeConnectedSystemId.HasValue ? AdminText.ApiKeyEditOnScimTab : CommonText.Edit)" Arrow="true" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Variant="Variant.Filled" Size="Size.Small"
                                       Disabled="@context.Item.ScopeConnectedSystemId.HasValue" OnClick="_ => ShowEditDialog(context.Item)" />
                    </MudTooltip>
                    <MudTooltip Text="@CommonText.Delete" Arrow="true" Placement="Placement.Top">
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Variant="Variant.Filled" Size="Size.Small" Color="Color.Error" OnClick="_ => HandleDeleteAsync(context.Item)" />
                    </MudTooltip>
                </div>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@string.Format(CultureInfo.CurrentCulture, AdminText.ApiKeyEmptySearch, grid.SearchText)"
                             SecondaryText="@CommonText.TrySearchAgain"
                             ActionText="@CommonText.ClearSearch"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.Api"
                             PrimaryText="@AdminText.ApiKeyEmptyNone"
                             SecondaryText="@AdminText.ApiKeyEmptyNoneHint" />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@* Create API Key Dialog *@
<MudDialog @bind-Visible="_createDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Key" Class="mr-3" /> @AdminText.ApiKeyCreateButton
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_createName" Label="@CommonText.FieldName" Required="true"
            RequiredError="@AdminText.ApiKeyNameRequired" Immediate="true" Variant="Variant.Outlined" Class="mt-3"
            HelperText="@AdminText.ApiKeyNameHelper" />
        <MudTextField T="string" @bind-Value="_createDescription" Label="@CommonText.FieldDescription" Lines="2" MaxLines="6" Sizing="InputSizing.Auto"
            Variant="Variant.Outlined" Class="mt-4" HelperText="@AdminText.ApiKeyDescriptionHelper" />
        <MudText Typo="Typo.subtitle2" Class="mt-5 mb-2">@AdminText.ApiKeyRoles</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
            @AdminText.ApiKeyRolesHint
        </MudText>
        @foreach (var role in _availableRoles)
        {
            <MudCheckBox T="bool" Value="@_createSelectedRoleIds.Contains(role.Id)"
                ValueChanged="@(value => ToggleRole(role.Id, value))" Label="@role.Name" Class="ml-n2" />
        }
        <MudDatePicker @bind-Date="_createExpiresAt" Label="@AdminText.ApiKeyExpiresOptional" Variant="Variant.Outlined" Class="mt-4"
            HelperText="@AdminText.ApiKeyNoExpiryHint" Clearable="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _createDialogVisible = false" DropShadow="false">@CommonText.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            Disabled="@(string.IsNullOrWhiteSpace(_createName) || _creating)" OnClick="HandleCreateAsync">
            @if (_creating)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">@AdminText.ApiKeyCreating</span>
            }
            else
            {
                <text>@CommonText.Create</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* Created Key Dialog (shows full key once) *@
<MudDialog @bind-Visible="_createdKeyDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-3" /> @AdminText.ApiKeyCreatedTitle
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            @AdminText.ApiKeyCopyNowWarning
        </MudAlert>
        <MudTextField T="string" Value="@_createdFullKey" Label="@AdminText.ApiKeyNounSingular" ReadOnly="true" Variant="Variant.Outlined"
            Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
            OnAdornmentClick="CopyKeyToClipboard" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            @AdminText.ApiKeyBearerHint
        </MudText>
        <MudText Typo="Typo.body2" Class="mt-4">
            <strong>@AdminText.ApiKeyExampleUsage</strong>
        </MudText>
        <pre class="jim-code-block mt-2"><code>@((MarkupString)Helpers.HighlightShell(ExampleCurlCommand, ShellLanguage.Bash))</code></pre>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            OnClick="() => _createdKeyDialogVisible = false">@AdminText.ApiKeyDone</MudButton>
    </DialogActions>
</MudDialog>

@* Edit API Key Dialog *@
<MudDialog @bind-Visible="_editDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" /> @AdminText.ApiKeyEditTitle
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_editName" Label="@CommonText.FieldName" Required="true" RequiredError="@AdminText.ApiKeyNameRequired"
            Immediate="true" Variant="Variant.Outlined" Class="mt-3" />
        <MudTextField T="string" @bind-Value="_editDescription" Label="@CommonText.FieldDescription" Lines="2" MaxLines="6" Sizing="InputSizing.Auto" Variant="Variant.Outlined"
            Class="mt-4" />
        <MudText Typo="Typo.subtitle2" Class="mt-5 mb-2">@AdminText.ApiKeyRoles</MudText>
        @foreach (var role in _availableRoles)
        {
            <MudCheckBox T="bool" Value="@_editSelectedRoleIds.Contains(role.Id)"
                ValueChanged="@(value => ToggleEditRole(role.Id, value))" Label="@role.Name" Class="ml-n2" />
        }
        <MudDatePicker @bind-Date="_editExpiresAt" Label="@AdminText.ApiKeyExpiresOptional" Variant="Variant.Outlined" Class="mt-4"
            HelperText="@AdminText.ApiKeyNoExpiryHint" Clearable="true" />
        <MudSwitch @bind-Value="_editEnabled" Color="Color.Primary" Label="@CommonText.Enabled" Class="mt-4" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editDialogVisible = false" DropShadow="false">@CommonText.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            Disabled="@(string.IsNullOrWhiteSpace(_editName) || _saving)" OnClick="HandleSaveEditAsync">
            @if (_saving)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">@AdminText.CertificateSaving</span>
            }
            else
            {
                <text>@CommonText.SaveChanges</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<ApiKey>? _apiKeys;
    private List<Role> _availableRoles = new();
    private VirtualisedDataGrid<ApiKey>? _grid;

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
        new(LayoutText.NavAdministration, href: "/admin"),
        new(AdminText.ApiKeyPageTitle, href: null, disabled: true)
    };

    private readonly DialogOptions _dialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };

    // Create dialog
    private bool _createDialogVisible;
    private string _createName = "";
    private string _createDescription = "";
    private List<int> _createSelectedRoleIds = new();
    private DateTime? _createExpiresAt;
    private bool _creating;

    // Created key dialog
    private bool _createdKeyDialogVisible;
    private string _createdFullKey = "";

    // The example request shown (syntax-highlighted) in the created-key dialog. '\' before the
    // newline is a bash line continuation.
    private string ExampleCurlCommand =>
        $"curl -H \"Authorization: Bearer {_createdFullKey}\" \\\n  https://your-jim-server/api/v1/metaverse/objects";

    // Edit dialog
    private bool _editDialogVisible;
    private ApiKey? _editingKey;
    private string _editName = "";
    private string _editDescription = "";
    private List<int> _editSelectedRoleIds = new();
    private DateTime? _editExpiresAt;
    private bool _editEnabled;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        using var jim = JimFactory.Create();
        _apiKeys = await jim.Security.GetApiKeysAsync();
        _availableRoles = await jim.Security.GetRolesAsync();
    }

    /// <summary>
    /// Reloads the list from the database and refreshes the grid after any action that changes it (create, edit,
    /// delete), so the rows and the toolbar count stay honest.
    /// </summary>
    private async Task ReloadListAsync()
    {
        await LoadDataAsync();
        if (_grid != null)
            await _grid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Slices one window of API keys from the in-memory list, applying the grid's search (name, key prefix,
    /// description; the same fields the old table filtered) and sort. API keys are a small configuration list,
    /// so there is no repository range read; the full list is loaded once and windowed here.
    /// </summary>
    private Task<VirtualisedWindow<ApiKey>> LoadApiKeyWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<ApiKey> keys = _apiKeys ?? Enumerable.Empty<ApiKey>();

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            keys = keys.Where(k =>
                k.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                k.KeyPrefix.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                k.Description?.Contains(search, StringComparison.OrdinalIgnoreCase) == true);
        }

        IOrderedEnumerable<ApiKey> Order<TKey>(Func<ApiKey, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? keys.OrderByDescending(key, comparer) : keys.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "prefix" => Order(k => k.KeyPrefix, StringComparer.OrdinalIgnoreCase),
            "lastused" => Order(k => k.LastUsedAt ?? DateTime.MinValue),
            "expires" => Order(k => k.ExpiresAt ?? DateTime.MaxValue),
            "status" => Order(k => k.IsEnabled),
            _ => Order(k => k.Name, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    private void ShowCreateDialog()
    {
        _createName = "";
        _createDescription = "";
        _createSelectedRoleIds = new List<int>();
        _createExpiresAt = null;
        _createDialogVisible = true;
    }

    private void ToggleRole(int roleId, bool selected)
    {
        if (selected && !_createSelectedRoleIds.Contains(roleId))
            _createSelectedRoleIds.Add(roleId);
        else if (!selected)
            _createSelectedRoleIds.Remove(roleId);
    }

    private void ToggleEditRole(int roleId, bool selected)
    {
        if (selected && !_editSelectedRoleIds.Contains(roleId))
            _editSelectedRoleIds.Add(roleId);
        else if (!selected)
            _editSelectedRoleIds.Remove(roleId);
    }

    private async Task HandleCreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_createName))
            return;

        _creating = true;
        StateHasChanged();

        try
        {
            // offer an optional reason for the configuration change history; cancelling aborts the create
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, CommonText.Create);
            if (cancelled)
                return;

            // Generate the API key
            var (fullKey, keyPrefix) = ApiKeyMaterial.Generate();
            var keyHash = ApiKeyMaterial.Hash(fullKey);

            // Get the roles
            var roles = _availableRoles.Where(r => _createSelectedRoleIds.Contains(r.Id)).ToList();

            // Create the API key entity
            var apiKey = new ApiKey
            {
                Id = Guid.NewGuid(),
                Name = _createName,
                Description = string.IsNullOrWhiteSpace(_createDescription) ? null : _createDescription,
                KeyHash = keyHash,
                KeyPrefix = keyPrefix,
                ExpiresAt = _createExpiresAt?.ToUniversalTime(),
                Roles = roles
            };

            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Security.CreateApiKeyAsync(apiKey, user, changeReason);

            Snackbar.Add(AdminText.ApiKeyCreatedSuccess, Severity.Success);
            _createDialogVisible = false;

            // Show the created key dialog
            _createdFullKey = fullKey;
            _createdKeyDialogVisible = true;

            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.ApiKeyCreateFailed, ex.Message), Severity.Error);
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task CopyKeyToClipboard()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _createdFullKey);
            Snackbar.Add(AdminText.ApiKeyCopiedSuccess, Severity.Info);
        }
        catch
        {
            Snackbar.Add(AdminText.ApiKeyCopyFailed, Severity.Warning);
        }
    }

    private void ShowEditDialog(ApiKey apiKey)
    {
        _editingKey = apiKey;
        _editName = apiKey.Name;
        _editDescription = apiKey.Description ?? "";
        _editSelectedRoleIds = apiKey.Roles.Select(r => r.Id).ToList();
        _editExpiresAt = apiKey.ExpiresAt?.ToLocalTime();
        _editEnabled = apiKey.IsEnabled;
        _editDialogVisible = true;
    }

    private async Task HandleSaveEditAsync()
    {
        if (_editingKey == null || string.IsNullOrWhiteSpace(_editName))
            return;

        _saving = true;
        StateHasChanged();

        try
        {
            // offer an optional reason for the configuration change history; cancelling aborts the save
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
            if (cancelled)
                return;

            // Create a new ApiKey object with updated values to avoid EF tracking issues
            // The repository will fetch the actual entity and update it
            var updatedKey = new ApiKey
            {
                Id = _editingKey.Id,
                Name = _editName,
                Description = string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription,
                ExpiresAt = _editExpiresAt?.ToUniversalTime(),
                IsEnabled = _editEnabled,
                // Create stub Role objects with just IDs - the repository will fetch the real ones
                Roles = _editSelectedRoleIds.Select(id => new Role { Id = id }).ToList()
            };

            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Security.UpdateApiKeyAsync(updatedKey, user, changeReason);

            Snackbar.Add(AdminText.ApiKeyUpdatedSuccess, Severity.Success);
            _editDialogVisible = false;
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.ApiKeyUpdateFailed, ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleDeleteAsync(ApiKey apiKey)
    {
        var result = await DialogService.ShowMessageBoxAsync(
        AdminText.ApiKeyDeleteTitle,
        string.Format(CultureInfo.CurrentCulture, AdminText.ApiKeyDeleteMessage, apiKey.Name),
        yesText: CommonText.Delete,
        cancelText: CommonText.Cancel);

        if (result != true)
            return;

        // offer an optional reason for the configuration change history; cancelling aborts the delete
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, CommonText.Delete);
        if (cancelled)
            return;

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Security.DeleteApiKeyAsync(apiKey.Id, user, changeReason);

            Snackbar.Add(AdminText.ApiKeyDeletedSuccess, Severity.Success);
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.ApiKeyDeleteFailed, ex.Message), Severity.Error);
        }
    }
}
