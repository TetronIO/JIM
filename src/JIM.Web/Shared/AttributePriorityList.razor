@* Shared ordered contributor list for an attribute's priority (#91, Surface 2 management home; Surface 1 renders *@
@* it read-only). Highest priority first. Drag to reorder; the whole list renumbers. "Null is a value" is per row. *@

<div class="apt-priority-list">
@if (_loading)
{
    <div class="d-flex justify-center pa-4">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
    </div>
}
else if (_contributors.Count == 0 && string.IsNullOrEmpty(PendingContributorSystemName))
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
        This attribute has no import contributors, so it has no priority to manage.
    </MudAlert>
}
else
{
    @* Column headers, aligned with the item rows below. *@
    <div class="d-flex align-center px-2 py-1 mud-text-secondary" style="font-weight: 500;">
        @if (!ReadOnly)
        {
            <div style="width: 40px;"></div>
        }
        <div style="width: 64px;">Priority</div>
        <div style="flex: 1 1 0;">Connected System</div>
        <div style="flex: 1 1 0;">Synchronisation Rule</div>
        <div style="width: 150px;">
            <MudTooltip Text="When set, if this Synchronisation Rule is connected and in scope but supplies no value, it asserts no value (no fall-through to a lower-priority contributor)." Arrow="true" Placement="Placement.Top">
                Null is a value
            </MudTooltip>
        </div>
    </div>

    @if (ReadOnly)
    {
        <div class="apt-list-frame rounded">
            @for (var i = 0; i < _contributors.Count; i++)
            {
                var contributor = _contributors[i];
                var isThisMapping = HighlightMappingId.HasValue && contributor.MappingId == HighlightMappingId.Value;
                <div class="apt-row d-flex align-center px-2 py-2 @(contributor.SyncRuleEnabled ? null : "mud-text-disabled") @(isThisMapping ? "apt-row-current" : null)">
                    <div style="width: 64px;">@(i + 1)</div>
                    <div style="flex: 1 1 0;">
                        @if (string.IsNullOrEmpty(contributor.ConnectedSystemName))
                        {
                            <EmptyValue />
                        }
                        else
                        {
                            @contributor.ConnectedSystemName
                        }
                    </div>
                    <div style="flex: 1 1 0;">
                        @contributor.SyncRuleName
                        @if (isThisMapping)
                        {
                            <span class="mud-text-secondary ml-1">(this mapping)</span>
                        }
                        @if (!contributor.SyncRuleEnabled)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ml-2">Disabled</MudChip>
                        }
                    </div>
                    <div style="width: 150px;">
                        <MudIcon Icon="@(contributor.NullIsValue ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                 Class="mud-text-secondary" />
                    </div>
                </div>
            }

            @* The mapping being created does not exist yet, so it is drawn as a synthetic bottom row: new import *@
            @* mappings persist at the safe-addition default, which is the bottom of the attribute's list. *@
            @if (!string.IsNullOrEmpty(PendingContributorSystemName))
            {
                <div class="apt-row apt-row-current d-flex align-center px-2 py-2">
                    <div style="width: 64px;">@(_contributors.Count + 1)</div>
                    <div style="flex: 1 1 0;">@PendingContributorSystemName</div>
                    <div style="flex: 1 1 0;" class="mud-text-secondary">this mapping, once saved</div>
                    <div style="width: 150px;">
                        <MudIcon Icon="@(PendingContributorNullIsValue ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                 Class="mud-text-secondary" />
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <MudDropContainer T="AttributePriorityContributorDto" @ref="_dropContainer" Items="_contributors"
                          ItemsSelector="@((item, dropzone) => true)" ItemDropped="OnItemDropped"
                          Class="apt-list-frame rounded">
            <ChildContent>
                <MudDropZone T="AttributePriorityContributorDto" AllowReorder="true" Class="pa-0"
                             ItemDraggingClass="apt-row-dragging" />
            </ChildContent>
            <ItemRenderer>
                <div class="apt-row d-flex align-center px-2 py-2 @(context.SyncRuleEnabled ? null : "mud-text-disabled")">
                    <div class="apt-drag-handle" style="width: 40px;">
                        <MudTooltip Text="Drag to reorder" Arrow="true" Placement="Placement.Top">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Class="mud-text-secondary" />
                        </MudTooltip>
                    </div>
                    <div style="width: 64px;">@(_contributors.IndexOf(context) + 1)</div>
                    <div style="flex: 1 1 0;">
                        @if (string.IsNullOrEmpty(context.ConnectedSystemName))
                        {
                            <EmptyValue />
                        }
                        else
                        {
                            @context.ConnectedSystemName
                        }
                    </div>
                    <div style="flex: 1 1 0;">
                        @context.SyncRuleName
                        @if (!context.SyncRuleEnabled)
                        {
                            <MudTooltip Text="This Synchronisation Rule is disabled. It holds its position but never contributes during synchronisation." Arrow="true" Placement="Placement.Top">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default" Class="ml-2">Disabled</MudChip>
                            </MudTooltip>
                        }
                    </div>
                    @* Stop a mousedown on the checkbox from starting a row drag, so toggling never begins a reorder. *@
                    <div style="width: 150px;" @onmousedown:stopPropagation="true">
                        <MudCheckBox T="bool" Value="context.NullIsValue"
                                     ValueChanged="@(v => OnNullIsValueChanged(context, v))"
                                     Dense="true" />
                    </div>
                </div>
            </ItemRenderer>
        </MudDropContainer>

        <div class="d-flex align-center gap-2 mt-3">
            @if (_dirty)
            {
                <MudText Typo="Typo.body2" Color="Color.Warning" Class="mr-2">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-1" />Unsaved changes
                </MudText>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!_dirty || _saving)"
                       StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">Save order</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="@(!_dirty || _saving)"
                       OnClick="ResetAsync">Reset</MudButton>
        </div>
    }
}
</div>

@code {
    [Parameter, EditorRequired] public int MetaverseObjectTypeId { get; set; }
    [Parameter, EditorRequired] public int MetaverseAttributeId { get; set; }

    /// <summary>The attribute name, used in save confirmation and messages.</summary>
    [Parameter] public string? MetaverseAttributeName { get; set; }

    /// <summary>Render the list read-only (Surface 1). No reordering, no "Null is a value" editing, no Save.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>
    /// The Connected System of a mapping that is being created but is not yet persisted (Surface 1). When set, a
    /// synthetic row is drawn at the bottom of the list showing where the mapping will land once saved. Read-only
    /// mode only; there is nothing to reorder until it exists.
    /// </summary>
    [Parameter] public string? PendingContributorSystemName { get; set; }

    /// <summary>"Null is a value" as currently set on the unsaved mapping, shown on its synthetic row.</summary>
    [Parameter] public bool PendingContributorNullIsValue { get; set; }

    /// <summary>
    /// An existing mapping to mark as "this mapping" in the list (Surface 1, editing a mapping that is already a
    /// contributor). Distinct from <see cref="PendingContributorSystemName"/>, which is for one that does not exist yet.
    /// </summary>
    [Parameter] public int? HighlightMappingId { get; set; }

    /// <summary>Raised after a successful save, so a host can refresh dependent state (e.g. a contributor badge).</summary>
    [Parameter] public EventCallback OnSaved { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private MudDropContainer<AttributePriorityContributorDto>? _dropContainer;
    private List<AttributePriorityContributorDto> _contributors = new();

    // Snapshot of the loaded order (mapping id + null-is-value), so dirty state and Reset compare against persisted truth.
    private List<(int MappingId, bool NullIsValue)> _original = new();
    private bool _loading = true;
    private bool _saving;
    private bool _dirty;

    // Which (object type, attribute) pair the loaded list belongs to, so a re-render does not re-fetch it.
    private int _loadedMetaverseObjectTypeId;
    private int _loadedMetaverseAttributeId;
    private bool _hasLoaded;

    protected override async Task OnParametersSetAsync()
    {
        // Reload only when the list's subject actually changes. Surface 1 hosts this inside a mapping dialog that
        // re-renders as the administrator types, and reloading on every render would both re-query needlessly and,
        // on Surface 2, discard a reorder in progress.
        if (_hasLoaded && _loadedMetaverseObjectTypeId == MetaverseObjectTypeId && _loadedMetaverseAttributeId == MetaverseAttributeId)
            return;

        _loadedMetaverseObjectTypeId = MetaverseObjectTypeId;
        _loadedMetaverseAttributeId = MetaverseAttributeId;
        _hasLoaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        using var jim = JimFactory.Create();
        var mappings = await jim.ConnectedSystems.GetAttributePriorityOrderAsync(MetaverseObjectTypeId, MetaverseAttributeId);
        _contributors = mappings.Select(AttributePriorityContributorDto.FromEntity).ToList();
        _original = _contributors.Select(c => (c.MappingId, c.NullIsValue)).ToList();
        _dirty = false;
        _loading = false;
        _dropContainer?.Refresh();
    }

    // A drag-drop reorder within the single zone. IndexInZone is the target slot; move the item there and renumber.
    private void OnItemDropped(MudItemDropInfo<AttributePriorityContributorDto> dropInfo)
    {
        var item = dropInfo.Item;
        if (item == null)
            return;

        var newIndex = Math.Clamp(dropInfo.IndexInZone, 0, _contributors.Count - 1);
        _contributors.Remove(item);
        _contributors.Insert(newIndex, item);
        RecomputeDirty();
        _dropContainer?.Refresh();
    }

    private void OnNullIsValueChanged(AttributePriorityContributorDto contributor, bool value)
    {
        contributor.NullIsValue = value;
        RecomputeDirty();
    }

    // Dirty when the current order or any "Null is a value" flag diverges from the loaded snapshot.
    private void RecomputeDirty()
    {
        var current = _contributors.Select(c => (c.MappingId, c.NullIsValue)).ToList();
        _dirty = !current.SequenceEqual(_original);
    }

    private async Task ResetAsync()
    {
        await LoadAsync();
    }

    /// <summary>
    /// Asks the administrator to acknowledge a priority reorder before it saves, through the same shared
    /// <see cref="ConsequenceConfirmationDialog"/> every other sync-affecting save uses, so this reads as one feature
    /// rather than a page with its own conventions. The copy stays specific: a generic diff of the reordered mapping
    /// rows could not name the Connected Systems that have to be synchronised, and that is the part an administrator
    /// new to JIM will not work out on their own. See engineering/plans/doing/CONFIGURATION_CHANGE_PREVIEW.md (Phase 2).
    /// </summary>
    private async Task<bool> ConfirmPriorityChangeAsync()
    {
        var attributeName = string.IsNullOrWhiteSpace(MetaverseAttributeName) ? "this attribute" : MetaverseAttributeName;

        // Name the Connected Systems the admin must synchronise to apply the new order: the (enabled)
        // contributors to this attribute. A newbie will not otherwise know where to run the synchronisation.
        var contributingSystems = _contributors
            .Where(c => c.SyncRuleEnabled)
            .Select(c => c.ConnectedSystemName)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            // Null-state does not flow through Where, so the compiler still sees string? here.
            .Select(n => n!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
            .ToList();

        var consequences = new ConsequenceGroup
        {
            Headline = $"Priority changes for {attributeName} take effect as the contributing systems next synchronise",
            Note = "Existing Metaverse Objects keep their current values until then. To apply the new order to them, " +
                   "run a Full Synchronisation Run Profile (in any order) on:",
            Items = contributingSystems.Count > 0
                ? contributingSystems.Select(name => new ConsequenceItem { Text = name }).ToList()
                : [new ConsequenceItem { Text = "each Connected System that contributes this attribute" }]
        };

        var parameters = new DialogParameters<ConsequenceConfirmationDialog>
        {
            { x => x.Consequences, consequences },
            { x => x.Warnings, new[] { "A Delta Synchronisation only re-resolves recently-changed objects, so it will not apply the new order to everything." } },
            { x => x.ConfirmButtonText, "Apply" },
            { x => x.BusyText, "Applying..." },
            { x => x.ConfirmButtonColour, Color.Warning }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<ConsequenceConfirmationDialog>("Apply priority changes?", parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false };
    }

    private async Task SaveAsync()
    {
        if (!_dirty || _saving)
            return;

        if (!await ConfirmPriorityChangeAsync())
            return;

        _saving = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var ordered = _contributors.Select(c => (c.MappingId, c.NullIsValue)).ToList();
            var result = await jim.ConnectedSystems.SetAttributePriorityOrderAsync(MetaverseObjectTypeId, MetaverseAttributeId, ordered, user);

            _contributors = result.Select(AttributePriorityContributorDto.FromEntity).ToList();
            _original = _contributors.Select(c => (c.MappingId, c.NullIsValue)).ToList();
            _dirty = false;
            Snackbar.Add("Attribute priority order saved.", Severity.Success);
            await OnSaved.InvokeAsync();
            _dropContainer?.Refresh();
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or System.Data.Common.DbException or ObjectDisposedException)
        {
            Snackbar.Add($"Failed to save attribute priority order: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
