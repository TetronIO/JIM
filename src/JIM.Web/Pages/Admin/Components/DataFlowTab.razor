@* The system-wide view of every attribute data flow in both directions (#1199). Pure discovery: nothing is edited *@
@* here, rows link to the surface that owns the change. *@

<MudText Typo="Typo.body1" Class="mud-text-secondary">
    Every attribute data flow configured across all Connected Systems, in both directions. Use it to answer "where
    does this attribute's value come from, and what writes it out?" without opening each Synchronisation Rule.
</MudText>

@* ─── Filters ─── *@
@* Direction sits with the other filters and behaves like them (cleared means both), but it does more than filter: *@
@* Inbound and Outbound carry different settings, so choosing one lets the table drop the columns that do not apply *@
@* to it and name the one that does, instead of a catch-all header over two unrelated concepts. *@
<MudStack Row="true" Spacing="3" Class="mt-6 flex-wrap" AlignItems="AlignItems.Center">
    <MudItem Class="flex-grow-1">
        <MudSelect T="SyncRuleDirection?" Label="Direction" Variant="Variant.Outlined" Dense="true" Clearable="true"
                   Value="_direction" ValueChanged="OnDirectionChangedAsync">
            <MudSelectItem T="SyncRuleDirection?" Value="@(SyncRuleDirection.Import)">Inbound</MudSelectItem>
            <MudSelectItem T="SyncRuleDirection?" Value="@(SyncRuleDirection.Export)">Outbound</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1">
        <MudSelect T="int?" Label="Connected System" Variant="Variant.Outlined" Dense="true" Clearable="true"
                   Value="_connectedSystemId" ValueChanged="OnConnectedSystemChangedAsync">
            @foreach (var option in _connectedSystemOptions)
            {
                <MudSelectItem T="int?" Value="@option.Key" @key="option.Key">@option.Value</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1">
        <MudSelect T="int?" Label="Metaverse Object Type" Variant="Variant.Outlined" Dense="true" Clearable="true"
                   Value="_metaverseObjectTypeId" ValueChanged="OnMetaverseObjectTypeChangedAsync">
            @foreach (var option in _metaverseObjectTypeOptions)
            {
                <MudSelectItem T="int?" Value="@option.Key" @key="option.Key">@option.Value</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem Class="flex-grow-1">
        <MudSelect T="int?" Label="Metaverse Attribute" Variant="Variant.Outlined" Dense="true" Clearable="true"
                   Value="_metaverseAttributeId" ValueChanged="OnMetaverseAttributeChangedAsync">
            @foreach (var option in _metaverseAttributeOptions)
            {
                <MudSelectItem T="int?" Value="@option.Key" @key="option.Key">@option.Value</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem>
        <MudTooltip Text="Show only Inbound flows whose Metaverse Attribute is fed by more than one Synchronisation Rule. This is a normal arrangement; it is simply where the priority order decides which value wins." Arrow="true" Placement="Placement.Top">
            <MudSwitch T="bool" Value="_multipleContributorsOnly" ValueChanged="OnMultipleContributorsOnlyChangedAsync" Color="Color.Primary">Multiple contributors</MudSwitch>
        </MudTooltip>
    </MudItem>
</MudStack>

@* Search scope lives here rather than as helper text under the toolbar box, which would overflow the toolbar's *@
@* fixed height and sit on the header row beneath it. *@
<MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
    Search matches Synchronisation Rules, Connected Systems, object types, attribute names on either side, and
    expression text. The attribute filters cannot match a flow whose relevant side is an expression, because an
    expression's attribute references live in its text; search finds those.
</MudText>

@* Columns are anchored to sides, not to source and target: those two swap sides between directions, so a Source
   column would mean the Connected System on one row and the Metaverse on the next, and no column could be learned.
   The Connected System block is always on the left and the Metaverse block always on the right; only the arrow
   between them changes with direction. Each heading names its own side in full, because the virtualised grid has a
   single header row: the band that used to name each side spanned several columns, which a data grid's one heading
   per column cannot express, so the qualification moved into the headings themselves. *@
<VirtualisedDataGrid @ref="_grid" T="DataFlowHeader"
                     ContainerId="data-flow-list"
                     UrlParameterPrefix="df-"
                     DefaultSortBy="system"
                     LoadWindow="LoadFlowWindowAsync"
                     SingularName="Data Flow"
                     PluralName="Data Flows"
                     SearchPlaceholder="Search data flows">
    <Columns>
        <TemplateColumn Title="Connected System" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Connected System" Name="system" />
            </HeaderTemplate>
            <CellTemplate>
                <MudLink Href="@($"/admin/connected-systems/{context.Item.ConnectedSystemId}")">@context.Item.ConnectedSystemName</MudLink>
            </CellTemplate>
        </TemplateColumn>
        @* Object type names are verbatim schema identifiers, not prose, so they take the inline code style
           wherever JIM shows them (see SyncRuleScopeTab, which does the same for both sides). *@
        <TemplateColumn Title="Connected System Object Type" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Connected System Object Type" Name="csobjecttype" />
            </HeaderTemplate>
            <CellTemplate>
                <code class="jim-code-inline">@context.Item.ConnectedSystemObjectTypeName</code>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Connected System Attribute" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Connected System Attribute" Name="csattribute" />
            </HeaderTemplate>
            <CellTemplate>
                @* A row in a virtualised grid is one line, and a flow can have several sources, so the sources
                   show their first and open the rest in a dialog drawn with the same chips. *@
                @if (context.Item.Direction == SyncRuleDirection.Import)
                {
                    <OverflowList TItem="DataFlowSource" Items="@context.Item.Sources.OrderBy(s => s.Order).ToList()" Title="Sources">
                        <ItemTemplate Context="source">
                            <AttributeChip Kind="@SourceKind(source)"
                                           Name="@source.DisplayName"
                                           Expression="@source.Expression" />
                        </ItemTemplate>
                    </OverflowList>
                }
                else
                {
                    <AttributeChip Kind="AttributeChipKind.ConnectedSystem"
                                   Name="@context.Item.TargetConnectedSystemAttributeName"
                                   Href="@DataFlowDisplay.TargetHref(context.Item)" />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Sortable="false">
            <HeaderTemplate></HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="@($"{DataFlowDisplay.DirectionLabel(context.Item.Direction)}: the value moves this way")" Arrow="true" Placement="Placement.Top">
                    <span class="mud-text-secondary">@DataFlowDisplay.DirectionArrow(context.Item.Direction)</span>
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Metaverse Object Type" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Metaverse Object Type" Name="mvobjecttype" />
            </HeaderTemplate>
            <CellTemplate>
                <code class="jim-code-inline">@context.Item.MetaverseObjectTypeName</code>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Metaverse Attribute" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Metaverse Attribute" Name="mvattribute" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.Direction == SyncRuleDirection.Import)
                {
                    <AttributeChip Kind="AttributeChipKind.Metaverse"
                                   Name="@context.Item.TargetMetaverseAttributeName"
                                   Href="@DataFlowDisplay.TargetHref(context.Item)" />
                }
                else
                {
                    <OverflowList TItem="DataFlowSource" Items="@context.Item.Sources.OrderBy(s => s.Order).ToList()" Title="Sources">
                        <ItemTemplate Context="source">
                            <AttributeChip Kind="@SourceKind(source)"
                                           Name="@source.DisplayName"
                                           Expression="@source.Expression" />
                        </ItemTemplate>
                    </OverflowList>
                }
            </CellTemplate>
        </TemplateColumn>
        @if (ShowPriorityColumn)
        {
            <TemplateColumn Title="Priority" Sortable="false">
                <HeaderTemplate>
                    <MudTooltip Text="Where an Inbound flow sits in the order of everything contributing to the same Metaverse Attribute, 1 being highest. It only decides anything where more than one Synchronisation Rule contributes, which is what the emphasised rows are." Arrow="true" Placement="Placement.Top">
                        <VirtualisedSortHeader Title="Priority" Name="priority" />
                    </MudTooltip>
                </HeaderTemplate>
                <CellTemplate>
                    @{
                        var priorityLabel = DataFlowDisplay.PriorityLabel(context.Item);
                        var isHighestPriorityContributor = DataFlowDisplay.IsHighestPriorityContributor(context.Item);
                    }
                    @if (priorityLabel == null)
                    {
                        <EmptyValue />
                    }
                    else
                    {
                        <MudTooltip Text="@DataFlowDisplay.PriorityTooltip(context.Item)" Arrow="true" Placement="Placement.Top">
                            <MudChip T="string"
                                     Variant="@(isHighestPriorityContributor ? Variant.Filled : Variant.Outlined)"
                                     Color="@(isHighestPriorityContributor ? Color.Primary : Color.Default)">@priorityLabel</MudChip>
                        </MudTooltip>
                    }
                </CellTemplate>
            </TemplateColumn>
        }
        <TemplateColumn Title="@OptionsColumnHeader" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">@OptionsColumnHeader</MudText>
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.NullIsValue == true)
                {
                    <MudTooltip Text="This contribution asserts 'no value' authoritatively, so an empty value here wins rather than falling through to the next contributor." Arrow="true" Placement="Placement.Top">
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">Null is a value</MudChip>
                    </MudTooltip>
                }
                else if (context.Item.EnforceState == true)
                {
                    <MudTooltip Text="Drift Correction is on for this rule: a value changed in the Connected System is corrected back to the Metaverse's value." Arrow="true" Placement="Placement.Top">
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Secondary">Enforce State</MudChip>
                    </MudTooltip>
                }
                else
                {
                    <EmptyValue />
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="Synchronisation Rule" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="Synchronisation Rule" Name="rule" />
            </HeaderTemplate>
            <CellTemplate>
                <MudLink Href="@DataFlowDisplay.RuleHref(context.Item)">@context.Item.SyncRuleName</MudLink>
                @if (!context.Item.SyncRuleEnabled)
                {
                    <MudTooltip Text="This Synchronisation Rule is disabled, so this flow is configured but moves no data." Arrow="true" Placement="Placement.Top">
                        <MudChip T="string" Variant="Variant.Text" Color="Color.Default" Icon="@Icons.Material.Filled.PauseCircleOutline">Disabled</MudChip>
                    </MudTooltip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@($"No data flows match \"{grid.SearchText}\"")"
                             SecondaryText="Try a different search term, or clear the search."
                             ActionText="Clear Search"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else if (AnyFilterIsActive)
        {
            <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                             PrimaryText="No data flows match these filters"
                             SecondaryText="Clear one of the filters above to widen the list." />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SwapHoriz"
                             PrimaryText="No data flows are configured"
                             SecondaryText="Add Attribute Flows to a Synchronisation Rule and they will appear here." />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    private IList<DataFlowHeader> _flows = new List<DataFlowHeader>();
    private VirtualisedDataGrid<DataFlowHeader>? _grid;

    // Whether _flows still describes the current filters and search. Every filter is evaluated server-side, so a
    // filter change invalidates the cached set rather than being applied over it here.
    private bool _flowsMatchCurrentQuery;

    // Filter state. Held as fields rather than in a DataFlowQuery so each control can bind to one of them; the
    // query is rebuilt per load, which keeps the portal's filters and the REST endpoint's identical by construction.
    private SyncRuleDirection? _direction;
    private int? _connectedSystemId;
    private int? _metaverseObjectTypeId;
    private int? _metaverseAttributeId;
    private bool _multipleContributorsOnly;
    private string? _search;

    // Built once from the unfiltered set, so choosing a filter never removes options from the other drop-downs.
    // Derived from the flows themselves rather than from the schema, so the lists only offer values that would
    // actually match something.
    private IReadOnlyList<KeyValuePair<int, string>> _connectedSystemOptions = [];
    private IReadOnlyList<KeyValuePair<int, string>> _metaverseObjectTypeOptions = [];
    private IReadOnlyList<KeyValuePair<int, string>> _metaverseAttributeOptions = [];

    protected override async Task OnInitializedAsync()
    {
        // The unfiltered set is loaded here rather than waiting for the grid's first window, because the filter
        // drop-downs are built from it: the page's own controls must be populated by the time they first render.
        await LoadAsync(buildOptions: true);
    }

    /// <summary>
    /// Loads the flows matching the current filters. Every filter is evaluated server-side, including the free-text
    /// search: doing it client-side would mean maintaining a second definition of what "matches" means, which would
    /// drift from the REST endpoint's the first time either changed.
    /// </summary>
    private async Task LoadAsync(bool buildOptions = false)
    {
        using var jim = JimFactory.Create();
        var flows = await jim.ConnectedSystems.GetDataFlowsAsync(BuildQuery());

        if (buildOptions)
            BuildFilterOptions(flows);

        _flows = flows;
        _flowsMatchCurrentQuery = true;
    }

    /// <summary>
    /// Slices one window of the loaded flows, re-querying first where the grid's search has moved on from the set
    /// in hand. The window itself is in memory (the query returns the whole match set), but the matching is still
    /// the server's, for the reason given on <see cref="LoadAsync"/>; only the sort is applied here, because it
    /// reorders a set the server has already decided.
    /// </summary>
    private async Task<VirtualisedWindow<DataFlowHeader>> LoadFlowWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        if (!_flowsMatchCurrentQuery || !string.Equals(_search, request.SearchText, StringComparison.Ordinal))
        {
            _search = request.SearchText;
            await LoadAsync();
        }

        IEnumerable<DataFlowHeader> flows = _flows;

        IOrderedEnumerable<DataFlowHeader> Order<TKey>(Func<DataFlowHeader, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? flows.OrderByDescending(key, comparer) : flows.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "csobjecttype" => Order(f => f.ConnectedSystemObjectTypeName, StringComparer.OrdinalIgnoreCase),
            "csattribute" => Order(DataFlowDisplay.ConnectedSystemSideName, StringComparer.OrdinalIgnoreCase),
            "mvobjecttype" => Order(f => f.MetaverseObjectTypeName, StringComparer.OrdinalIgnoreCase),
            "mvattribute" => Order(DataFlowDisplay.MetaverseSideName, StringComparer.OrdinalIgnoreCase),
            "priority" => Order(f => f.Priority ?? int.MaxValue),
            "rule" => Order(f => f.SyncRuleName, StringComparer.OrdinalIgnoreCase),
            _ => Order(f => f.ConnectedSystemName, StringComparer.OrdinalIgnoreCase)
        };

        return sorted.ToWindow(request);
    }

    /// <summary>
    /// Invalidates the loaded set after one of the page's own filters has changed, and sends the grid back to the
    /// top to re-count and re-window it: the old total and scroll position describe a match set that is gone.
    /// </summary>
    private async Task ApplyFilterChangeAsync()
    {
        _flowsMatchCurrentQuery = false;

        if (_grid == null)
            return;

        await _grid.ResetScrollAsync();
        await _grid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Whether any of the page's own filters is narrowing the list, so the empty state can tell "nothing matches
    /// what you chose" apart from "there are no data flows at all".
    /// </summary>
    private bool AnyFilterIsActive =>
        _direction.HasValue || _connectedSystemId.HasValue || _metaverseObjectTypeId.HasValue ||
        _metaverseAttributeId.HasValue || _multipleContributorsOnly;

    /// <summary>
    /// Whether the Priority column applies to what is on screen. Priority orders competing contributions into the
    /// Metaverse, so an Outbound-only view would show a column of dashes; dropping it says the same thing without
    /// spending a column on it. The "Both" view keeps it, because half its rows do have one.
    /// </summary>
    private bool ShowPriorityColumn => _direction != SyncRuleDirection.Export;

    /// <summary>
    /// The direction-appropriate name for the settings column. With a direction chosen, only one setting can appear
    /// in it, so it is named outright rather than hidden behind a catch-all heading.
    /// </summary>
    private string OptionsColumnHeader => _direction switch
    {
        SyncRuleDirection.Import => "Null is a value",
        SyncRuleDirection.Export => "Enforce State",
        _ => "Options"
    };

    /// <summary>
    /// Which side of the Metaverse a source sits on, read from the source itself rather than from the flow's
    /// direction: the two always agree, and taking it from the data means a malformed row cannot be mislabelled
    /// as belonging to the side its direction implies.
    /// </summary>
    private static AttributeChipKind SourceKind(DataFlowSource source)
    {
        if (source.IsExpression)
            return AttributeChipKind.Expression;

        return source.MetaverseAttributeId.HasValue ? AttributeChipKind.Metaverse : AttributeChipKind.ConnectedSystem;
    }

    private DataFlowQuery BuildQuery() => new()
    {
        Direction = _direction,
        ConnectedSystemId = _connectedSystemId,
        MetaverseObjectTypeId = _metaverseObjectTypeId,
        MetaverseAttributeId = _metaverseAttributeId,
        MultipleContributorsOnly = _multipleContributorsOnly,
        Search = string.IsNullOrWhiteSpace(_search) ? null : _search
    };

    private void BuildFilterOptions(IEnumerable<DataFlowHeader> flows)
    {
        var systems = new Dictionary<int, string>();
        var objectTypes = new Dictionary<int, string>();
        var attributes = new Dictionary<int, string>();

        foreach (var flow in flows)
        {
            systems[flow.ConnectedSystemId] = flow.ConnectedSystemName;
            objectTypes[flow.MetaverseObjectTypeId] = flow.MetaverseObjectTypeName;

            // A Metaverse Attribute is a flow's target inbound and one of its sources outbound, so both sides have
            // to be collected for the filter to offer every attribute that participates in any flow.
            // Captured by the pattern rather than dereferenced after it: a nullable's null-state does not survive a
            // property pattern for the analyser's purposes, and binding in the pattern removes the .Value entirely.
            if (flow is { TargetMetaverseAttributeId: int targetId, TargetMetaverseAttributeName: string targetName })
                attributes[targetId] = targetName;

            // Filtered in the sequence rather than guarded in the body, per the CodeQL shapes in src/CLAUDE.md.
            // Null-state does not flow through Where, hence the null-forgiving operators on an already-proven guard.
            foreach (var source in flow.Sources.Where(s => s is { MetaverseAttributeId: not null, MetaverseAttributeName: not null }))
            {
                var sourceId = source.MetaverseAttributeId!.Value;
                attributes[sourceId] = source.MetaverseAttributeName!;
            }
        }

        _connectedSystemOptions = systems.OrderBy(o => o.Value).ToList();
        _metaverseObjectTypeOptions = objectTypes.OrderBy(o => o.Value).ToList();
        _metaverseAttributeOptions = attributes.OrderBy(o => o.Value).ToList();
    }

    private async Task OnDirectionChangedAsync(SyncRuleDirection? direction)
    {
        _direction = direction;
        await ApplyFilterChangeAsync();
    }

    private async Task OnConnectedSystemChangedAsync(int? connectedSystemId)
    {
        _connectedSystemId = connectedSystemId;
        await ApplyFilterChangeAsync();
    }

    private async Task OnMetaverseObjectTypeChangedAsync(int? metaverseObjectTypeId)
    {
        _metaverseObjectTypeId = metaverseObjectTypeId;
        await ApplyFilterChangeAsync();
    }

    private async Task OnMetaverseAttributeChangedAsync(int? metaverseAttributeId)
    {
        _metaverseAttributeId = metaverseAttributeId;
        await ApplyFilterChangeAsync();
    }

    private async Task OnMultipleContributorsOnlyChangedAsync(bool multipleContributorsOnly)
    {
        _multipleContributorsOnly = multipleContributorsOnly;
        await ApplyFilterChangeAsync();
    }
}
