@* Tests an Attribute Flow as a Synchronisation would run it (#2055): typed inputs from the schema, several values for a
   multi-valued attribute, "No value" distinct from empty text, values loaded from a real object, and a trace of each
   step of the pipeline synchronisation runs. *@
@if (Generating)
{
    <MudText Typo="Typo.subtitle2" Class="mt-5">Test the base expression</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
        Give each attribute the base expression reads a value, or load them from an object, and see the base a
        Synchronisation would generate @_targetName from: each value is read as its attribute's type, and the result goes
        through this Attribute Flow's Missing Input Behaviour and value processing. The test stops there, because which
        value is free is decided when a Synchronisation runs.
    </MudText>
}
else
{
    <MudText Typo="Typo.subtitle2" Class="mt-5">Test this Attribute Flow</MudText>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
        Give each attribute the Expression reads a value, or load them from an object, and see what a Synchronisation would
        do: each value is read as its attribute's type, and the result goes through this Attribute Flow's Missing Input
        Behaviour, value processing and conversion to @_targetName.
    </MudText>
}

<SegmentedToggle TValue="bool" Options="_valueSourceOptions" Value="_fromObject" ValueChanged="SetFromObject"
                 AriaLabel="Where the values come from" Dense="true" />

@if (_fromObject)
{
    <TestObjectPicker Kind="ObjectKind" ConnectedSystemId="SyncRule.ConnectedSystemId" ConnectedSystemObjectType="SyncRule.ConnectedSystemObjectType"
                      MetaverseObjectTypeId="SyncRule.MetaverseObjectType?.Id" Label="@ObjectSearchLabel" OnPicked="LoadObjectAsync" Class="mt-3" />
}

@if (_inputs.Count == 0)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
        This Expression reads no attributes, so it produces the same value for every object. Run the test to see it.
    </MudText>
}
else
{
    <MudSimpleTable Dense="true" Outlined="true" Class="mt-3" Style="overflow-x: auto">
        <thead>
            <tr><th>Input</th><th>Type</th><th>Value</th><th>No value</th></tr>
        </thead>
        <tbody>
            @foreach (var input in _inputs)
            {
                var descriptor = input;
                var accessor = descriptor.Accessor;
                var state = StateOf(accessor);
                <tr @key="accessor">
                    <td>
                        <AttributeChip Kind="@(descriptor.Source == ExpressionInputSource.Metaverse ? AttributeChipKind.Metaverse : AttributeChipKind.ConnectedSystem)"
                                       Name="@descriptor.AttributeName" />
                    </td>
                    <td class="mud-text-secondary">@DescribeType(descriptor)</td>
                    <td style="min-width: 16rem">
                        @if (descriptor is { Type: { } type, Plurality: { } plurality })
                        {
                            <TestInputValueEditor Label="@accessor" Type="type" Plurality="plurality" State="state" OnChanged="InputsChangedAsync" />
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@NotHeldExplanation(descriptor)</MudText>
                        }
                    </td>
                    <td>
                        @if (descriptor.InSchema)
                        {
                            <MudCheckBox T="bool" Value="state.NoValue" ValueChanged="@(v => SetNoValueAsync(state, v))" Dense="true"
                                         aria-label="@($"{accessor} has no value")" />
                        }
                    </td>
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

<RunAsOfPicker Value="_asOf" ValueChanged="SetAsOf" Class="mt-3" />

<MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-3" OnClick="RunTest">Run test</MudButton>

@if (_parseError != null)
{
    <MudAlert Severity="Severity.Error" Class="mt-3">
        @_parseError
        @if (_errorPosition.HasValue)
        {
            var position = _errorPosition.Value;
            <MudText Typo="Typo.caption" Class="mud-text-secondary">Position @position</MudText>
        }
    </MudAlert>
}

@if (_result is { InputErrors.Count: > 0 } inputProblem)
{
    <MudAlert Severity="Severity.Error" Class="mt-3">
        @foreach (var inputError in inputProblem.InputErrors)
        {
            <MudText Typo="Typo.body2">@inputError</MudText>
        }
    </MudAlert>
}

@if (_result is { Evaluation: { } evaluation } tested)
{
    var source = evaluation.Source;
    <MudPaper Outlined="true" Class="pa-3 mt-3">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">What a Synchronisation would do</MudText>
        <MudSimpleTable Dense="true" Elevation="0" Class="mt-1">
            <tbody>
                <tr>
                    <td class="mud-text-secondary" style="width: 13rem; vertical-align: top">1. Expression returned</td>
                    <td>
                        @switch (source.Outcome)
                        {
                            case ExpressionSourceOutcome.Result:
                                @foreach (var line in ExpressionText.ToDisplayLines(source.Result))
                                {
                                    <MudText Typo="Typo.body1" Class="jim-expression-output">@line</MudText>
                                }
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Type: @source.Result!.GetType().Name</MudText>
                                break;
                            case ExpressionSourceOutcome.NoValue when source.MissingInputs.Count == 0:
                                <EmptyValue />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">No value</MudText>
                                break;
                            case ExpressionSourceOutcome.EvaluationFailed:
                                <MudText Typo="Typo.body2">Failed: @source.EvaluationException?.Message</MudText>
                                break;
                            default:
                                <MudText Typo="Typo.body2">Not evaluated: no value for @string.Join(", ", source.MissingInputs)</MudText>
                                break;
                        }
                    </td>
                </tr>
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">2. Value processing</td>
                    <td><MudText Typo="Typo.body2">@DescribeValueProcessing(tested, evaluation)</MudText></td>
                </tr>
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">3. Converted for @_targetName</td>
                    <td>
                        @if (evaluation.Outcome == AttributeFlowOutcome.Values)
                        {
                            @foreach (var line in evaluation.Values.Select(ExpressionText.Describe))
                            {
                                <MudText Typo="Typo.body1" Class="jim-expression-output">@line</MudText>
                            }
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@evaluation.TargetType</MudText>
                        }
                        else if (evaluation.ErrorReason == AttributeFlowErrorReason.ResultNotConvertible)
                        {
                            <MudText Typo="Typo.body2">'@evaluation.Resolution?.UnconvertibleValue' is not a @evaluation.TargetType value</MudText>
                        }
                        else if (evaluation.ErrorReason == AttributeFlowErrorReason.ResultMultiValued)
                        {
                            <MudText Typo="Typo.body2">@evaluation.Resolution?.ValueCount values, for an attribute that holds one</MudText>
                        }
                        else if (evaluation.Resolution != null && evaluation.Outcome == AttributeFlowOutcome.NoValue)
                        {
                            <EmptyValue />
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">Nothing to convert</MudText>
                        }
                    </td>
                </tr>
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">4. Result</td>
                    <td>
                        @if (evaluation.Outcome == AttributeFlowOutcome.Error)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">@AttributeFlowTester.Describe(evaluation, _targetName)</MudAlert>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@AttributeFlowTester.Describe(evaluation, _targetName)</MudText>
                        }
                    </td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    @if (tested.IfInputHasNoValue.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-3 mt-3">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">If an input has no value</MudText>
            <MudSimpleTable Dense="true" Elevation="0" Class="mt-1">
                <tbody>
                    @foreach (var absentOutcome in tested.IfInputHasNoValue)
                    {
                        <tr @key="absentOutcome.Accessor">
                            <td style="width: 13rem; vertical-align: top"><code>@absentOutcome.Accessor</code></td>
                            <td style="width: 7rem; vertical-align: top">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0"
                                         Color="@OutcomeColour(absentOutcome.Evaluation.Outcome)">@OutcomeLabel(absentOutcome.Evaluation.Outcome)</MudChip>
                            </td>
                            <td><MudText Typo="Typo.body2">@AttributeFlowTester.Describe(absentOutcome.Evaluation, _targetName)</MudText></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}

@if (_result is { GeneratedBase: { } generated } testedBase)
{
    var baseSource = generated.Source;
    <MudPaper Outlined="true" Class="pa-3 mt-3">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">What a Synchronisation would do</MudText>
        <MudSimpleTable Dense="true" Elevation="0" Class="mt-1">
            <tbody>
                <tr>
                    <td class="mud-text-secondary" style="width: 13rem; vertical-align: top">1. Base expression returned</td>
                    <td>
                        @switch (baseSource?.Outcome)
                        {
                            case ExpressionSourceOutcome.Result:
                                @foreach (var line in ExpressionText.ToDisplayLines(baseSource.Result))
                                {
                                    <MudText Typo="Typo.body1" Class="jim-expression-output">@line</MudText>
                                }
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Type: @baseSource.Result!.GetType().Name</MudText>
                                break;
                            case ExpressionSourceOutcome.NoValue when baseSource.MissingInputs.Count == 0:
                                <EmptyValue />
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">No value</MudText>
                                break;
                            case ExpressionSourceOutcome.EvaluationFailed:
                                <MudText Typo="Typo.body2">Failed: @baseSource.EvaluationException?.Message</MudText>
                                break;
                            case null:
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">No base expression</MudText>
                                break;
                            default:
                                <MudText Typo="Typo.body2">Not evaluated: no value for @string.Join(", ", baseSource.MissingInputs)</MudText>
                                break;
                        }
                    </td>
                </tr>
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">2. Value processing</td>
                    <td><MudText Typo="Typo.body2">@DescribeBaseValueProcessing(testedBase, generated)</MudText></td>
                </tr>
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">3. Base for generation</td>
                    <td>
                        @if (generated.Outcome == GeneratedBaseOutcome.Base)
                        {
                            <MudText Typo="Typo.body1" Class="jim-expression-output" data-testid="generated-base">@generated.BaseValue</MudText>
                        }
                        else
                        {
                            <EmptyValue />
                        }
                    </td>
                </tr>
                <tr>
                    <td class="mud-text-secondary" style="vertical-align: top">4. Result</td>
                    <td>
                        @if (generated.Outcome == GeneratedBaseOutcome.Error)
                        {
                            <MudAlert Severity="Severity.Error" Dense="true">@AttributeFlowTester.DescribeGeneratedBase(generated, Mapping.Generation!, _targetName)</MudAlert>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@AttributeFlowTester.DescribeGeneratedBase(generated, Mapping.Generation!, _targetName)</MudText>
                        }
                    </td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    @if (testedBase.GeneratedBaseIfInputHasNoValue.Count > 0)
    {
        <MudPaper Outlined="true" Class="pa-3 mt-3">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">If an input has no value</MudText>
            <MudSimpleTable Dense="true" Elevation="0" Class="mt-1">
                <tbody>
                    @foreach (var absentOutcome in testedBase.GeneratedBaseIfInputHasNoValue)
                    {
                        <tr @key="absentOutcome.Accessor">
                            <td style="width: 13rem; vertical-align: top"><code>@absentOutcome.Accessor</code></td>
                            <td style="width: 7rem; vertical-align: top">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0"
                                         Color="@BaseOutcomeColour(absentOutcome.GeneratedBase.Outcome)">@BaseOutcomeLabel(absentOutcome.GeneratedBase.Outcome)</MudChip>
                            </td>
                            <td><MudText Typo="Typo.body2">@AttributeFlowTester.DescribeGeneratedBase(absentOutcome.GeneratedBase, Mapping.Generation!, _targetName)</MudText></td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }
}

@* A saved Attribute Flow's test can be kept as a test case (#2055 Phase 4), which runs against the flow as saved. *@
@if (Draft is { } draft)
{
    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Outlined.FactCheck" Class="mt-2"
               OnClick="@(() => SaveAsTestCaseAsync(draft))" data-testid="jim-attribute-flow-test-save-as-case">Save as test case</MudButton>
}

@code {
    /// <summary>
    /// The Expression to test, as typed in the editor.
    /// </summary>
    [Parameter, EditorRequired]
    public string Expression { get; set; } = string.Empty;

    /// <summary>
    /// The Synchronisation Rule the Attribute Flow belongs to: its direction and object types type the inputs.
    /// </summary>
    [Parameter, EditorRequired]
    public SyncRule SyncRule { get; set; } = null!;

    /// <summary>
    /// The Attribute Flow being edited: its target attribute and value processing, read as they stand when the test runs.
    /// </summary>
    [Parameter, EditorRequired]
    public SyncRuleMapping Mapping { get; set; } = null!;

    /// <summary>
    /// The source being edited: its Missing Input Behaviour, read as it stands when the test runs.
    /// </summary>
    [Parameter, EditorRequired]
    public SyncRuleMappingSource Source { get; set; } = null!;

    /// <summary>
    /// Raised as the inputs are edited or loaded, with each input's value as text (its first value, or null for no
    /// value), keyed by accessor. The Generated Value editor's candidate preview evaluates against these same samples.
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyDictionary<string, string?>> SampleValuesChanged { get; set; }

    /// <summary>
    /// Whether the Attribute Flow generates its value: the test then stops at the base, as a Synchronisation does.
    /// </summary>
    private bool Generating => Mapping.Generation != null;

    private static readonly IReadOnlyList<SegmentedToggleOption<bool>> _valueSourceOptions =
    [
        new(false, "Sample values"),
        new(true, "From an object")
    ];

    private IReadOnlyList<AttributeFlowTestInputDescriptor> _inputs = [];
    private readonly Dictionary<string, TestInputState> _states = new(StringComparer.Ordinal);
    private DateTime? _asOf;
    private string? _resolvedFrom;
    private string _targetName = string.Empty;
    private bool _fromObject;
    private AttributeFlowTestResult? _result;
    private SyncRuleMappingSource? _testedSource;
    private DateTime _ranAtUtc;

    /// <summary>
    /// The test as a test case to save, with the values tested and today's result expected; null when there is
    /// nothing to save, or the Attribute Flow is not saved yet.
    /// </summary>
    private ConfigurationTestCase? Draft => _result == null
        ? null
        : ConfigurationTestCaseDrafts.FromAttributeFlowTest(Mapping, _testedSource,
            _inputs.Select(input => (input, StateOf(input.Accessor))).ToList(), _result, _asOf, _ranAtUtc);
    private string? _parseError;
    private int? _errorPosition;

    private bool Exporting => SyncRule.Direction == SyncRuleDirection.Export;

    private ObjectChipKind ObjectKind => Exporting ? ObjectChipKind.MetaverseObject : ObjectChipKind.ConnectedSystemObject;

    private string ObjectSearchLabel => Exporting
        ? $"Find a {SyncRule.MetaverseObjectType?.Name ?? "Metaverse Object"}"
        : $"Find a {SyncRule.ConnectedSystemObjectType?.Name ?? "Connected System Object"} in {SyncRule.ConnectedSystem?.Name ?? "the Connected System"}";

    protected override void OnParametersSet()
    {
        _targetName = (Exporting ? Mapping.TargetConnectedSystemAttribute?.Name : Mapping.TargetMetaverseAttribute?.Name) ?? "the target";

        // Inputs follow the Expression as it is edited; values entered for an input that is still read are kept.
        if (_resolvedFrom == Expression)
            return;

        _resolvedFrom = Expression;
        _inputs = AttributeFlowTester.DescribeInputs(SyncRule, Expression);
        ClearResult();
    }

    private void ClearResult()
    {
        _result = null;
        _parseError = null;
        _errorPosition = null;
    }

    private TestInputState StateOf(string accessor)
    {
        if (!_states.TryGetValue(accessor, out var state))
            _states[accessor] = state = new TestInputState();
        return state;
    }

    private async Task SetNoValueAsync(TestInputState state, bool noValue)
    {
        state.NoValue = noValue;
        await InputsChangedAsync();
    }

    private async Task InputsChangedAsync()
    {
        ClearResult();
        if (SampleValuesChanged.HasDelegate)
            await SampleValuesChanged.InvokeAsync(_inputs.ToDictionary(input => input.Accessor,
                input => StateOf(input.Accessor) is { NoValue: false, Values: [var first, ..] } ? first : null, StringComparer.Ordinal));
    }

    private void SetAsOf(DateTime? asOf)
    {
        _asOf = asOf;
        ClearResult();
    }

    private void SetFromObject(bool fromObject) => _fromObject = fromObject;

    /// <summary>
    /// Fills the inputs from a real object (#2055): every value it holds for each attribute the Expression reads, as the
    /// text the inputs take, and "No value" for an attribute it holds none for. An import flow that reads mv[...] also
    /// takes those inputs from the Metaverse Object the Connected System Object is joined to.
    /// </summary>
    private async Task LoadObjectAsync(TestObjectPicker.PickedObject found)
    {
        using var jim = JimFactory.Create();
        var loaded = new List<AttributeFlowTestInput>();
        if (Exporting)
        {
            if (await jim.Metaverse.GetMetaverseObjectAsync(found.Id) is { } mvo)
                loaded.AddRange(AttributeFlowTester.InputsFromMetaverseObject(mvo, Expression));
        }
        else if (await jim.ConnectedSystems.GetConnectedSystemObjectAsync(SyncRule.ConnectedSystemId, found.Id) is { } cso)
        {
            loaded.AddRange(AttributeFlowTester.InputsFromConnectedSystemObject(cso, SyncRule.ConnectedSystemObjectType, Expression));
            if (cso.MetaverseObjectId is { } joinedId && await jim.Metaverse.GetMetaverseObjectAsync(joinedId) is { } joined)
                loaded.AddRange(AttributeFlowTester.InputsFromMetaverseObject(joined, Expression));
        }

        foreach (var input in loaded)
            StateOf(input.Accessor).Load(input.Values.Select(ToEditableText));

        await InputsChangedAsync();
    }

    /// <summary>
    /// A loaded value as text the input converts back to the same value: JIM's text form, and base64 for Binary.
    /// </summary>
    private static string ToEditableText(object value) => value switch
    {
        byte[] bytes => Convert.ToBase64String(bytes),
        _ => ExpressionText.TryFormat(value, out var text) ? text ?? string.Empty : value.ToString() ?? string.Empty
    };

    private void RunTest()
    {
        ClearResult();
        if (string.IsNullOrWhiteSpace(Expression))
            return;

        var validation = ExpressionEvaluator.Validate(Expression);
        if (!validation.IsValid)
        {
            _parseError = validation.ErrorMessage ?? "The Expression could not be parsed.";
            _errorPosition = validation.ErrorPosition;
            return;
        }

        var inputs = _inputs
            .Select(input => new AttributeFlowTestInput(input.Source, input.AttributeName, StateOf(input.Accessor).TestValues))
            .ToList();

        // The source as it stands in the editor, with the Expression as typed.
        var source = new SyncRuleMappingSource { Expression = Expression, MissingInputBehaviour = Source.MissingInputBehaviour };
        _testedSource = source;
        _ranAtUtc = DateTime.UtcNow;
        _result = AttributeFlowTester.Test(SyncRule, Mapping, source, inputs, ExpressionEvaluator, _asOf ?? _ranAtUtc);
    }

    private async Task SaveAsTestCaseAsync(ConfigurationTestCase draft) =>
        await ConfigurationTestCaseDialog.ShowAsync(DialogService, draft,
            $"{(Generating ? "Generated Value for" : "Attribute Flow to")} {_targetName}, run against the Attribute Flow as saved",
            _inputs.Where(input => input is { Type: not null, Plurality: not null })
                .Select(input => new ConfigurationTestCaseDisplay.InputSlot(input.Source, input.AttributeName, input.Type!.Value, input.Plurality!.Value))
                .ToList());

    private static string DescribeType(AttributeFlowTestInputDescriptor input) => input.Type is { } type
        ? $"{type} · {(input.Plurality == AttributePlurality.MultiValued ? "multi-valued" : "single-valued")}"
        : "Not available";

    private string NotHeldExplanation(AttributeFlowTestInputDescriptor input) =>
        input.Source == ExpressionInputSource.ConnectedSystem && Exporting
            ? "An export Attribute Flow reads only the Metaverse Object, so this input never has a value."
            : $"'{(input.Source == ExpressionInputSource.ConnectedSystem ? SyncRule.ConnectedSystemObjectType?.Name : SyncRule.MetaverseObjectType?.Name)}' has no attribute of this name, so this input never has a value.";

    private static string DescribeValueProcessing(AttributeFlowTestResult tested, AttributeFlowEvaluation evaluation)
    {
        if (tested.ValueProcessing is not { } processing)
            return evaluation.Source.Outcome != ExpressionSourceOutcome.Result
                ? "Nothing to process"
                : "Not applied: value processing applies to Text attributes on import only";

        if (processing.Steps.Count == 0)
            return "None set";

        var steps = string.Join(", then ", processing.Steps.Select(StepLabel));
        return $"{steps}: {(processing.Changed ? "changed the value" : "unchanged")}";
    }

    private static string DescribeBaseValueProcessing(AttributeFlowTestResult tested, GeneratedBaseEvaluation generated)
    {
        if (tested.ValueProcessing is not { } processing)
            return generated.UnprocessedBaseValue == null ? "Nothing to process" : "Not applied: value processing applies on import only";

        if (processing.Steps.Count == 0)
            return "None set";

        var steps = string.Join(", then ", processing.Steps.Select(StepLabel));
        return $"{steps}: {(processing.Changed ? "changed the value" : "unchanged")}";
    }

    private static string BaseOutcomeLabel(GeneratedBaseOutcome outcome) => outcome switch
    {
        GeneratedBaseOutcome.Base => "Base",
        GeneratedBaseOutcome.Waits => "Waits",
        GeneratedBaseOutcome.NoBaseExpression => "Token only",
        _ => "Error"
    };

    private static Color BaseOutcomeColour(GeneratedBaseOutcome outcome) => outcome switch
    {
        GeneratedBaseOutcome.Base => Color.Success,
        GeneratedBaseOutcome.Error => Color.Error,
        _ => Color.Default
    };

    private static string StepLabel(AttributeFlowValueProcessingStep step) => step switch
    {
        AttributeFlowValueProcessingStep.TrimWhitespace => "Trim leading and trailing whitespace",
        AttributeFlowValueProcessingStep.CollapseInternalWhitespace => "Collapse internal whitespace",
        AttributeFlowValueProcessingStep.UpperCase => "Upper case",
        AttributeFlowValueProcessingStep.LowerCase => "Lower case",
        AttributeFlowValueProcessingStep.TitleCase => "Title case",
        AttributeFlowValueProcessingStep.TreatWhitespaceAsNoValue => "Treat whitespace as no value",
        _ => step.ToString()
    };

    private static string OutcomeLabel(AttributeFlowOutcome outcome) => outcome switch
    {
        AttributeFlowOutcome.Values => "Values",
        AttributeFlowOutcome.NoValue => "No value",
        _ => "Error"
    };

    private static Color OutcomeColour(AttributeFlowOutcome outcome) => outcome switch
    {
        AttributeFlowOutcome.Values => Color.Success,
        AttributeFlowOutcome.NoValue => Color.Default,
        _ => Color.Error
    };
}
