@* The Inspect view's attribute inspector (#399): everything about one attribute on one Metaverse Object, *@
@* rendered beside the Inspect table rather than over it (see MvoDetailsTable, which owns the flex layout).    *@
@* Presentational: takes the already-loaded MetaverseAttributeProvenance and renders it. *@

<MudPaper Outlined="true" Class="pa-4 jim-attribute-inspector">
    <div class="d-flex justify-space-between align-start">
        <div>
            <MudText Typo="Typo.h6">@Provenance.AttributeName</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @Provenance.AttributeType · @(Provenance.AttributePlurality == AttributePlurality.MultiValued ? "Multi" : "Single")
            </MudText>
        </div>
        <MudTooltip Text="Close" Arrow="true" Placement="Placement.Top">
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => OnClose.InvokeAsync())" />
        </MudTooltip>
    </div>

    @* ─── Current value and origin ─── *@
    <div class="mt-4">
        @if (Provenance.CurrentValues.Count == 0)
        {
            <EmptyValue />
        }
        else
        {
            @foreach (var value in Provenance.CurrentValues)
            {
                <div class="jim-text-code mb-1">
                    @if (string.IsNullOrEmpty(value.DisplayValue))
                    {
                        <EmptyValue />
                    }
                    else if (value.ReferenceMetaverseObjectId.HasValue)
                    {
                        <ObjectChip Kind="ObjectChipKind.MetaverseObject" TypeName="@value.ReferenceTypeName" Name="@value.DisplayValue"
                                    Href="@Utilities.GetMetaverseObjectHref(value.ReferenceMetaverseObjectId.Value, value.ReferenceTypeName ?? string.Empty)" Class="ma-0" />
                    }
                    else
                    {
                        @value.DisplayValue
                    }
                </div>
            }
            @if (Provenance.CurrentValueTotalCount > Provenance.CurrentValues.Count)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    +@((Provenance.CurrentValueTotalCount - Provenance.CurrentValues.Count).ToString("N0")) more
                </MudText>
            }
        }

        <div class="jim-one-line mt-2">
            @{ var primaryOrigin = Provenance.CurrentValues.FirstOrDefault()?.Origin ?? ValueOrigin.NotRecorded; }
            @if (primaryOrigin.Kind == ValueOriginKind.NotRecorded)
            {
                <span class="mud-text-disabled">Source not recorded</span>
            }
            else
            {
                <span>Set by</span>
                <ValueOriginChip Origin="@primaryOrigin" />
                @if (ContributingConnectedSystemObject != null)
                {
                    <span>from</span>
                    <ObjectChip Kind="ObjectChipKind.ConnectedSystemObject"
                                TypeName="@ContributingConnectedSystemObject.TypeName"
                                Name="@ObjectDescription.ChipName(ContributingConnectedSystemObject.DisplayName, ContributingConnectedSystemObject.ExternalId)"
                                Href="@CsoHref" Class="ma-0" />
                }
                @if (Provenance.LastSet != null)
                {
                    <span>,</span>
                    <MudTooltip Text="@Provenance.LastSet.ChangeTime.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                        <span class="mud-text-secondary">@Provenance.LastSet.ChangeTime.ToLocalTime().ToRelativeTime()</span>
                    </MudTooltip>
                    @if (ActivityHref != null)
                    {
                        <span>by</span>
                        <MudLink Href="@ActivityHref">@(Provenance.LastSet.ActivityDescription ?? "the Activity")</MudLink>
                    }
                }
            }
        </div>
    </div>

    @* ─── Every source, in priority order ─── *@
    @if (Provenance.Sources.Count > 0)
    {
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle1">Every source for this attribute</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">in priority order</MudText>

        @foreach (var source in Provenance.Sources)
        {
            <div class="jim-inspector-source-row d-flex align-center flex-wrap py-1">
                <span class="mud-text-secondary jim-inspector-source-rank">#@source.Rank</span>
                <ObjectChip Kind="ObjectChipKind.ConnectedSystem" Name="@source.ConnectedSystemName"
                            Href="@($"/admin/connected-systems/{source.ConnectedSystemId}")" Class="ma-0" />
                <span class="mud-text-secondary">·</span>
                <MudLink Href="@($"/admin/sync-rules/{source.SyncRuleId}")">@source.SyncRuleName</MudLink>
                @if (source.CandidateValues.Count > 0)
                {
                    <span class="jim-text-code jim-one-line" style="max-width: 12rem;">@string.Join(", ", source.CandidateValues)</span>
                }
                <MudSpacer />
                <MudTooltip Text="@(source.Note ?? StateLabel(source.State))" Arrow="true" Placement="Placement.Top">
                    <MudChip T="string" Variant="Variant.Text" Color="@StateColour(source.State)">@StateLabel(source.State)</MudChip>
                </MudTooltip>
            </div>
        }

        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            Priority is set on the @Provenance.AttributeName attribute.
            <MudLink Href="@($"/admin/schema/object-types/{Provenance.MetaverseObjectTypeId}")">Change priority</MudLink>
        </MudText>
    }

    @* ─── History ─── *@
    <MudDivider Class="my-4" />
    <MudText Typo="Typo.subtitle1">History of this attribute</MudText>

    @if (Provenance.History.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">No changes recorded for this attribute.</MudText>
    }
    else
    {
        <div class="jim-inspector-history mt-2">
            @foreach (var entry in Provenance.History)
            {
                <div class="jim-inspector-history-entry">
                    <MudChip T="string" Variant="Variant.Text" Color="@HistoryKindColour(entry.Kind)" Class="ma-0">@entry.Kind</MudChip>
                    <span class="jim-text-code">
                        @if (string.IsNullOrEmpty(entry.Value)) { <EmptyValue /> } else { @entry.Value }
                        @if (entry.Kind == AttributeHistoryChangeKind.Set && !string.IsNullOrEmpty(entry.PreviousValue))
                        {
                            <span class="mud-text-secondary" style="text-decoration: line-through; margin-left: 6px;">@entry.PreviousValue</span>
                        }
                    </span>
                    <div class="jim-one-line mud-text-secondary">
                        <MudTooltip Text="@entry.Change.ChangeTime.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                            <span>@entry.Change.ChangeTime.ToLocalTime().ToRelativeTime()</span>
                        </MudTooltip>
                        @{ var activityHref = ActivityHrefFor(entry.Change); }
                        @if (activityHref != null)
                        {
                            <span>·</span>
                            <MudLink Href="@activityHref">@(entry.Change.ActivityDescription ?? "Activity")</MudLink>
                        }
                        @if (!string.IsNullOrEmpty(entry.SyncRuleName))
                        {
                            <span>· @entry.SyncRuleName</span>
                        }
                    </div>
                </div>
            }
        </div>

        @if (Provenance.HistoryTruncated)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1">Showing the most recent changes only.</MudText>
        }
    }

    <MudLink Class="mt-2 d-inline-block" OnClick="@(() => OnOpenInTimeline.InvokeAsync())">Open in Timeline</MudLink>
</MudPaper>

@code {
    /// <summary>Everything the inspector shows for one attribute on one Metaverse Object.</summary>
    [Parameter, EditorRequired]
    public MetaverseAttributeProvenance Provenance { get; set; } = null!;

    /// <summary>Raised when the panel's close button is pressed.</summary>
    [Parameter, EditorRequired]
    public EventCallback OnClose { get; set; }

    /// <summary>Raised by "Open in Timeline": the host switches the page to the Changes tab.</summary>
    [Parameter]
    public EventCallback OnOpenInTimeline { get; set; }

    private ProvenanceConnectedSystemObject? ContributingConnectedSystemObject => Provenance.ContributingConnectedSystemObject;

    private string? CsoHref => ContributingConnectedSystemObject == null
        ? null
        : $"/admin/connected-systems/{ContributingConnectedSystemObject.ConnectedSystemId}/connector-space/{ContributingConnectedSystemObject.Id}";

    private string? ActivityHref => ActivityHrefFor(Provenance.LastSet);

    /// <summary>
    /// The execution item detail when one is recorded (the granular, per-object view every other causality
    /// surface links to), falling back to the Activity itself when only that is known.
    /// </summary>
    private static string? ActivityHrefFor(ProvenanceChange? change)
    {
        if (change == null)
            return null;
        if (change.ActivityRunProfileExecutionItemId.HasValue)
            return $"/activity/item/{change.ActivityRunProfileExecutionItemId.Value}";
        if (change.ActivityId.HasValue)
            return $"/activity/{change.ActivityId.Value}";
        return null;
    }

    private static string StateLabel(AttributeSourceState state) => state switch
    {
        AttributeSourceState.InUse => "In use",
        AttributeSourceState.Outranked => "Outranked",
        AttributeSourceState.NoValue => "No value",
        AttributeSourceState.NotJoined => "Not joined",
        AttributeSourceState.Disabled => "Disabled",
        _ => "Not evaluated"
    };

    private static Color StateColour(AttributeSourceState state) => state switch
    {
        AttributeSourceState.InUse => Color.Success,
        AttributeSourceState.NotEvaluated => Color.Warning,
        _ => Color.Default
    };

    private static Color HistoryKindColour(AttributeHistoryChangeKind kind) => kind switch
    {
        AttributeHistoryChangeKind.Added => Color.Success,
        AttributeHistoryChangeKind.Removed => Color.Error,
        _ => Color.Info
    };
}
