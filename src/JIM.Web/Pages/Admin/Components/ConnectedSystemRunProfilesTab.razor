@code {
    [Parameter, EditorRequired]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private VirtualisedDataGrid<ConnectedSystemRunProfile>? _grid;

    private bool IsNewRunProfileFormValid { get; set; }
    private ConnectedSystemRunProfile _newRunProfile = new() { RunType = ConnectedSystemRunType.NotSet };
    private readonly DialogOptions _newRunProfileDialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };
    private bool _newRunProfileDialogVisible;

    private bool _isEditRunProfileFormValid;
    private ConnectedSystemRunProfile _editRunProfile = new();
    private ConnectedSystemRunProfile? _editRunProfileOriginal;
    private bool _editRunProfileDialogVisible;

    /// <summary>
    /// Slices one window of Run Profiles from the collection held on the Connected System the page already loaded,
    /// applying the grid's search (name, run type and file path) and sort. A Connected System has a handful of Run
    /// Profiles, so this stays in memory rather than growing a database range read.
    /// </summary>
    private Task<VirtualisedWindow<ConnectedSystemRunProfile>> LoadRunProfileWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        IEnumerable<ConnectedSystemRunProfile> runProfiles = ConnectedSystem.RunProfiles ?? new List<ConnectedSystemRunProfile>();

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            runProfiles = runProfiles.Where(rp =>
                rp.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                rp.RunType.ToString().SplitOnCapitalLetters().Contains(search, StringComparison.OrdinalIgnoreCase) ||
                (rp.FilePath != null && rp.FilePath.Contains(search, StringComparison.OrdinalIgnoreCase)));
        }

        IOrderedEnumerable<ConnectedSystemRunProfile> Order<TKey>(Func<ConnectedSystemRunProfile, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? runProfiles.OrderByDescending(key, comparer) : runProfiles.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "runtype" => Order(rp => rp.RunType),
            "partition" => Order(rp => rp.Partition?.Name ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            "pagesize" => Order(rp => rp.PageSize),
            "filepath" => Order(rp => rp.FilePath ?? string.Empty, StringComparer.OrdinalIgnoreCase),
            _ => Order(rp => rp.Name, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    /// <summary>
    /// Refreshes the grid over the Run Profile collection after it has been added to, edited or removed from. The
    /// totals are invalidated because the change may have altered how many Run Profiles exist or match the search.
    /// </summary>
    private async Task RefreshGridAsync()
    {
        if (_grid != null)
            await _grid.RefreshAsync(invalidateTotals: true);
    }

    private static bool IsImportRunType(ConnectedSystemRunType runType) =>
        runType is ConnectedSystemRunType.FullImport or ConnectedSystemRunType.DeltaImport;

    private static bool IsImportOrExportRunType(ConnectedSystemRunType runType) =>
        runType is ConnectedSystemRunType.FullImport or ConnectedSystemRunType.DeltaImport or ConnectedSystemRunType.Export;

    private string? ValidateRunType(ConnectedSystemRunType runType)
    {
        if (runType == ConnectedSystemRunType.NotSet)
            return "Please select a run type";

        return null;
    }

    private Task HandleShowNewRunProfileDialogAsync()
    {
        _newRunProfile = new ConnectedSystemRunProfile { RunType = ConnectedSystemRunType.NotSet };
        _newRunProfileDialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task HandleNewRunProfileFormSubmitAsync()
    {
        if (ConnectedSystem.RunProfiles == null)
            return;

        // Keep a reference to the partition for UI display after save
        // (the repository nulls the navigation property to avoid EF identity conflicts)
        var selectedPartition = _newRunProfile.Partition;

        var runProfile = new ConnectedSystemRunProfile
        {
            ConnectedSystemId = ConnectedSystem.Id,
            Name = _newRunProfile.Name,
            RunType = _newRunProfile.RunType,
            Partition = selectedPartition,
            PageSize = _newRunProfile.PageSize,
            FilePath = _newRunProfile.FilePath,
            VerifyImportContentHashes = _newRunProfile.RunType == ConnectedSystemRunType.FullImport && _newRunProfile.VerifyImportContentHashes,
            MaxCreates = _newRunProfile.RunType == ConnectedSystemRunType.Export ? _newRunProfile.MaxCreates : null,
            MaxUpdates = _newRunProfile.RunType == ConnectedSystemRunType.Export ? _newRunProfile.MaxUpdates : null,
            MaxDeletes = _newRunProfile.RunType == ConnectedSystemRunType.Export ? _newRunProfile.MaxDeletes : null,
            MaxDetectedDeletions = _newRunProfile.RunType == ConnectedSystemRunType.FullImport ? _newRunProfile.MaxDetectedDeletions : null,
            MaxDetectedDeletionsPercent = _newRunProfile.RunType == ConnectedSystemRunType.FullImport ? _newRunProfile.MaxDetectedDeletionsPercent : null
        };

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.ConnectedSystems.CreateConnectedSystemRunProfileAsync(runProfile, user);

            // Restore partition reference for UI display, then add to local collection
            runProfile.Partition = selectedPartition;
            ConnectedSystem.RunProfiles.Add(runProfile);

            Snackbar.Add("New Run Profile added.", Severity.Success);
            _newRunProfileDialogVisible = false;
            _newRunProfile = new ConnectedSystemRunProfile { RunType = ConnectedSystemRunType.NotSet };
            await RefreshGridAsync();
        }
        catch
        {
            Snackbar.Add("Failed to create Run Profile. Please try again.", Severity.Error);
        }
    }

    private Task HandleShowEditRunProfileDialogAsync(ConnectedSystemRunProfile runProfile)
    {
        _editRunProfileOriginal = runProfile;
        _editRunProfile = new ConnectedSystemRunProfile
        {
            Id = runProfile.Id,
            ConnectedSystemId = runProfile.ConnectedSystemId,
            Name = runProfile.Name,
            RunType = runProfile.RunType,
            PageSize = runProfile.PageSize,
            FilePath = runProfile.FilePath,
            Partition = runProfile.Partition,
            VerifyImportContentHashes = runProfile.VerifyImportContentHashes,
            MaxCreates = runProfile.MaxCreates,
            MaxUpdates = runProfile.MaxUpdates,
            MaxDeletes = runProfile.MaxDeletes,
            MaxDetectedDeletions = runProfile.MaxDetectedDeletions,
            MaxDetectedDeletionsPercent = runProfile.MaxDetectedDeletionsPercent
        };
        _editRunProfileDialogVisible = true;
        return Task.CompletedTask;
    }

    private async Task HandleEditRunProfileFormSubmitAsync()
    {
        if (_editRunProfileOriginal == null)
            return;

        var selectedPartition = _editRunProfile.Partition;

        _editRunProfileOriginal.Name = _editRunProfile.Name;
        _editRunProfileOriginal.PageSize = _editRunProfile.PageSize;
        _editRunProfileOriginal.FilePath = _editRunProfile.FilePath;
        _editRunProfileOriginal.Partition = selectedPartition;
        _editRunProfileOriginal.VerifyImportContentHashes = _editRunProfileOriginal.RunType == ConnectedSystemRunType.FullImport && _editRunProfile.VerifyImportContentHashes;

        if (_editRunProfileOriginal.RunType == ConnectedSystemRunType.Export)
        {
            _editRunProfileOriginal.MaxCreates = _editRunProfile.MaxCreates;
            _editRunProfileOriginal.MaxUpdates = _editRunProfile.MaxUpdates;
            _editRunProfileOriginal.MaxDeletes = _editRunProfile.MaxDeletes;
        }

        if (_editRunProfileOriginal.RunType == ConnectedSystemRunType.FullImport)
        {
            _editRunProfileOriginal.MaxDetectedDeletions = _editRunProfile.MaxDetectedDeletions;
            _editRunProfileOriginal.MaxDetectedDeletionsPercent = _editRunProfile.MaxDetectedDeletionsPercent;
        }

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.ConnectedSystems.UpdateConnectedSystemRunProfileAsync(_editRunProfileOriginal, user);

            _editRunProfileOriginal.Partition = selectedPartition;

            Snackbar.Add("Run Profile updated.", Severity.Success);
            _editRunProfileDialogVisible = false;
            await RefreshGridAsync();
        }
        catch
        {
            Snackbar.Add("Failed to update Run Profile. Please try again.", Severity.Error);
        }
    }

    private async Task HandleRunProfileDeleteAsync(ConnectedSystemRunProfile connectedSystemRunProfile)
    {
        if (ConnectedSystem.RunProfiles == null)
            return;

        var confirmationResult = await DialogService.ShowMessageBoxAsync(
            "Delete Run Profile",
            $"Are you sure you want to delete the Run Profile '{connectedSystemRunProfile.Name}'? This action cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmationResult != true)
            return;

        ConnectedSystem.RunProfiles.Remove(connectedSystemRunProfile);

        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        await jim.ConnectedSystems.DeleteConnectedSystemRunProfileAsync(connectedSystemRunProfile, user);

        Snackbar.Add("Run Profile removed.", Severity.Success);
        await RefreshGridAsync();
    }
}
