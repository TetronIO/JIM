@page "/causality"
@page "/causality/items/{ItemId:guid}"
@page "/causality/connected-system-objects/{ConnectedSystemObjectId:guid}"
@page "/causality/metaverse-objects/{MetaverseObjectId:guid}"
@attribute [Authorize(Roles = "Administrator")]
@using JIM.Web.Models
@using JIM.Models.Activities.DTOs
@using JIM.Web.Causality
@using JIM.Web.Shared.Causality
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager

@* Copyright (c) Tetron Limited. All rights reserved. *@
