@page "/admin/example-data/datasets/{Id:int}"
@attribute [Authorize(Roles = "Administrator")]
@using System.Globalization
@using JIM.Models.Activities
@using JIM.Models.ExampleData
@using JIM.Web.Pages.Admin.Components
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@string.Format(CultureInfo.CurrentCulture, ExampleDataText.ExampleDataSetPageTitle, _exampleDataSet?.Name)</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Science" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>@ExampleDataText.ExampleDataSetsLabel</span> <span class="mud-primary-text">@_exampleDataSet?.Name</span>
    <PageInfo Title="@ExampleDataText.ExampleDataSet" DocsPage="configuration/example-data.md#example-data-sets">
        @ExampleDataText.DataSetDetailInfo
    </PageInfo>
</MudText>
<div class="d-flex justify-space-between align-center">
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
    @if (_exampleDataSet != null)
    {
        <AuditInfo Entity="@_exampleDataSet" />
    }
</div>

@if (_exampleDataSet != null)
{
    <NavigableMudTabs Class="mt-2" TabPanelsClass="pt-6">

        <MudTabPanel Text="@ExampleDataText.Details">
    <MudText Typo="Typo.h5">@ExampleDataText.Details</MudText>
    <MudPaper Class="pa-4" Outlined="true">
        <MudGrid Spacing="4">
            <MudItem xs="12" sm="6" md="4">
                <MudField Label="@CommonText.ColumnCreated" Variant="Variant.Outlined">@_exampleDataSet.Created</MudField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <MudField Label="@ExampleDataText.BuiltIn" Variant="Variant.Outlined">@(_exampleDataSet.BuiltIn ? CommonText.Yes : CommonText.No)</MudField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                    <MudField Label="@ExampleDataText.CultureColumn" Variant="Variant.Outlined">@_exampleDataSet.Culture</MudField>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                    <MudField Label="@ExampleDataText.Values" Variant="Variant.Outlined">@_exampleDataSet.Values.Count.ToString("N0")</MudField>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudText Typo="Typo.h5" Class="mt-5">@ExampleDataText.Values</MudText>
    <MudPaper Class="pa-4 mt-6 mb-5" Outlined="true">
        @foreach (var val in _exampleDataSet.Values)
        {
            <MudChip T="string" Variant="Variant.Filled" Color="Color.Default">@val.StringValue</MudChip>
        }
    </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="@ExampleDataText.Changes" BadgeData="@(_changeCount > 0 ? _changeCount.ToString("N0") : null)" BadgeColor="Color.Primary">
            <ConfigurationChangesTab TargetType="ActivityTargetType.ExampleDataSet" ObjectId="@_exampleDataSet.Id" ObjectTypeLabel="@ExampleDataText.ExampleDataSet" />
        </MudTabPanel>

    </NavigableMudTabs>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ExampleDataSet? _exampleDataSet;
    private List<BreadcrumbItem> _breadcrumbs = null!;
    private int _changeCount;

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _exampleDataSet = await jim.ExampleData.GetExampleDataSetAsync(Id);
        if (_exampleDataSet == null)
        {
            // template not found, redirect to index page
            NavManager.NavigateTo("../");
            return;
        }

        _breadcrumbs = new List<BreadcrumbItem>
        {
            new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
            new(LayoutText.NavAdministration, href: "/admin"),
            new(ExampleDataText.ExampleData, href: "/admin/example-data/"),
            new(ExampleDataText.DatasetsBreadcrumb, href: "/admin/example-data/datasets/"),
            new(_exampleDataSet.Name, href: null, disabled: true)
        };

        _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.ExampleDataSet, _exampleDataSet.Id, 1, 1)).TotalResults;
    }
}