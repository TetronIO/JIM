# JIM schema extensions for 389 Directory Server (the OpenLDAP lab's cn=jim-extensions)
#
# Applied once by build/configure.sh with ldapmodify against cn=schema, bound as
# cn=Directory Manager; 389 persists user schema to /data/config/schema/99user.ldif.
# Same OIDs, names and syntaxes as the OpenLDAP lab
# (../../openldap/scripts/01-add-second-suffix.sh), so LDIF written for one
# loads on the other:
#
#   jimGroup       (SUP groupOfNames STRUCTURAL)  MAY mail, jimGroupType, jimGroupStatus
#   jimPerson      (SUP inetOrgPerson STRUCTURAL) MAY jimEmployeeEndDate (Generalized Time,
#                  typed DateTime by the LDAP Connector for relative-date scoping),
#                  jimLeaverCohort (Boolean marker read by the harness, never by JIM)
#   jimBadgeHolder (SUP top AUXILIARY)            MUST jimBadgeNumber; MAY jimBadgeColour,
#                  jimBadgeIssued, uid (so a badge holder can carry a uid= RDN)
#
# DELIBERATELY ABSENT: the OpenLDAP lab's dITContentRule jimPersonContent
# (permits jimBadgeHolder on jimPerson entries). 389 Directory Server refuses
# dITContentRules on cn=schema over LDAP ("Only object classes and attribute
# types may be added"; verified on 389-Directory/3.1.2), and does not enforce
# content rules, so auxiliary classes attach freely without one. The schema
# discovery's "suggested by DIT Content Rule" path therefore has nothing to read
# here; the OpenLDAP lab remains the fixture that exercises it.
#
# OIDs use the 1.3.6.1.4.1.99999 test arc (integration tests only).
dn: cn=schema
changetype: modify
add: attributeTypes
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.1 NAME 'jimGroupType' DESC 'Group type classification' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'jim-extensions' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.2 NAME 'jimGroupStatus' DESC 'Group lifecycle status' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'jim-extensions' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.3 NAME 'jimEmployeeEndDate' DESC 'Employment end date' EQUALITY generalizedTimeMatch ORDERING generalizedTimeOrderingMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.24 SINGLE-VALUE X-ORIGIN 'jim-extensions' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.4 NAME 'jimLeaverCohort' DESC 'Scenario 008 leaver-cohort marker' EQUALITY booleanMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.7 SINGLE-VALUE X-ORIGIN 'jim-extensions' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.5 NAME 'jimBadgeNumber' DESC 'Badge number (required by jimBadgeHolder)' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'jim-extensions' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.6 NAME 'jimBadgeColour' DESC 'Badge colour' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE X-ORIGIN 'jim-extensions' )
attributeTypes: ( 1.3.6.1.4.1.99999.1.1.7 NAME 'jimBadgeIssued' DESC 'Badge issue date' EQUALITY generalizedTimeMatch ORDERING generalizedTimeOrderingMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.24 SINGLE-VALUE X-ORIGIN 'jim-extensions' )
-
add: objectClasses
objectClasses: ( 1.3.6.1.4.1.99999.1.2.1 NAME 'jimGroup' DESC 'Extended group with type, status, and mail' SUP groupOfNames STRUCTURAL MAY ( mail $ jimGroupType $ jimGroupStatus ) X-ORIGIN 'jim-extensions' )
objectClasses: ( 1.3.6.1.4.1.99999.1.2.2 NAME 'jimPerson' DESC 'Extended person with employment end date' SUP inetOrgPerson STRUCTURAL MAY ( jimEmployeeEndDate $ jimLeaverCohort ) X-ORIGIN 'jim-extensions' )
objectClasses: ( 1.3.6.1.4.1.99999.1.2.3 NAME 'jimBadgeHolder' DESC 'JIM-owned auxiliary class for badge details' SUP top AUXILIARY MUST jimBadgeNumber MAY ( jimBadgeColour $ jimBadgeIssued $ uid ) X-ORIGIN 'jim-extensions' )
