@* "Start again…" (Unique Value Generation, #242, Phase 3, Work Package D2): the typed confirmation for a saved
   generated Sequence mapping's row action (the approved mockup's screen 02b). Phase 6 restored the line release 1
   left out: how many retired values the restart forgets, with a link through to the retired values list, shown
   only when there are any. A thin surface over the shared ConsequenceConfirmationDialog: this component owns
   loading the current counter state, the wording and performing the restart; that one owns presenting it and the
   typed-confirmation rule. *@

<ConsequenceConfirmationDialog Loading="@(_currentNext == null)"
                               LoadingText="Reading the current counter..."
                               ConfirmationPhrase="@AttributeName"
                               ConfirmButtonText="Start again"
                               ConfirmButtonColour="Color.Warning"
                               BusyText="Starting again..."
                               DisableConfirm="@_isNoOp"
                               OnConfirmAsync="RestartAsync">
    <LeadingContent>
        <MudText Typo="Typo.body1">
            Metaverse Objects that already have a value for @AttributeName keep it; only Metaverse Objects without
            one are given a new value.
        </MudText>
        @if (_isNoOp)
        {
            <MudText Typo="Typo.body1" Class="mt-2">@NoOpMessage</MudText>
        }
        else if (_currentNext is { } currentNext)
        {
            <MudText Typo="Typo.body1" Class="mt-2">
                Counter returns to <code class="jim-code-inline">@ConfiguredStartFormatted</code> from <code class="jim-code-inline">@GeneratedValuePreviewHelpers.FormatSequenceIdentifier(currentNext, FixedWidth)</code>
            </MudText>
        }
        @if (_retiredValueCount > 0)
        {
            <MudText Typo="Typo.body1" Class="mt-2" data-testid="jim-start-again-forgotten">
                @GeneratedValuePreviewHelpers.DescribeRetiredValueCount(_retiredValueCount) will be forgotten and can be issued again.
                <MudLink Typo="Typo.body1" OnClick="ViewRetiredValuesAsync" data-testid="jim-start-again-view-retired">View retired values</MudLink>
            </MudText>
        }
    </LeadingContent>
    <AdditionalContent>
        <MudAlert Severity="Severity.Info" Dense="true">
            Numbers can be issued again once forgotten, but a number still held by a Metaverse Object is skipped
            when the counter reaches it. No existing value changes and nothing is exported.
        </MudAlert>
    </AdditionalContent>
</ConsequenceConfirmationDialog>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter, EditorRequired]
    public int MappingId { get; set; }

    [Parameter, EditorRequired]
    public string AttributeName { get; set; } = null!;

    /// <summary>The flow's configured Start at value: what the counter returns to.</summary>
    [Parameter, EditorRequired]
    public long ConfiguredStart { get; set; }

    /// <summary>The mapping's configured fixed width, if any: these are identifiers, so they show zero-padded
    /// to it rather than with a thousands separator (QA fix, #242 Phase 3 D2).</summary>
    [Parameter]
    public int? FixedWidth { get; set; }

    [Inject]
    private IDialogService DialogService { get; set; } = null!;

    /// <summary>
    /// The Metaverse Attribute an import flow generates, for the link through to its retired values list. Null for
    /// an export flow, which passes <see cref="ConnectedSystemObjectTypeAttributeId"/> instead.
    /// </summary>
    [Parameter]
    public int? MetaverseAttributeId { get; set; }

    /// <summary>The Connected System attribute an export flow generates, for the link through to its retired values list.</summary>
    [Parameter]
    public int? ConnectedSystemObjectTypeAttributeId { get; set; }

    private long? _currentNext;
    private int _retiredValueCount;
    private bool _isNoOp;
    private string? _noOpMessage;

    private string ConfiguredStartFormatted => GeneratedValuePreviewHelpers.FormatSequenceIdentifier(ConfiguredStart, FixedWidth);
    private string NoOpMessage => _noOpMessage ??= GeneratedValuePreviewHelpers.DescribeStartAgainNoOp(ConfiguredStart, FixedWidth);

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        var state = await jim.ConnectedSystems.GetGeneratedValueSequenceStateAsync(MappingId);
        // Unseeded (never issued a number): there is nothing to show a "from", so present the flow's own start
        // value both ways rather than leaving the panel loading forever. GetGeneratedValueSequenceStateAsync's
        // NextNumber is always the higher of the counter's own position and Start at, so it can never read
        // *behind* Start at here; "already at Start at" (the no-op) is the only equality case reachable.
        _currentNext = state is { IsSeeded: true } ? state.NextNumber : ConfiguredStart;
        _retiredValueCount = await jim.ConnectedSystems.GetRetiredGeneratedValueCountAsync(MappingId);
        _isNoOp = GeneratedValuePreviewHelpers.IsStartAgainNoOp(_currentNext.Value, ConfiguredStart, _retiredValueCount);
    }

    private Task ViewRetiredValuesAsync() =>
        RetiredGeneratedValuesDialog.ShowAsync(
            DialogService, AttributeName, MetaverseAttributeId, ConnectedSystemObjectTypeAttributeId, _retiredValueCount);

    private async Task<bool> RestartAsync()
    {
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var result = await jim.ConnectedSystems.RestartGeneratedValuesAsync(MappingId, user);
            Snackbar.Add(GeneratedValuePreviewHelpers.DescribeRestartResult(AttributeName, result, FixedWidth), Severity.Success);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            return false;
        }

        return true;
    }

    /// <summary>
    /// Opens the "Start again…" confirmation for a saved generated Sequence mapping. Returns true once the
    /// restart completed successfully.
    /// </summary>
    public static async Task<bool> ShowAsync(
        IDialogService dialogService, int mappingId, string attributeName, long configuredStart, int? fixedWidth,
        int? metaverseAttributeId = null, int? connectedSystemObjectTypeAttributeId = null)
    {
        var parameters = new DialogParameters<GeneratedValueStartAgainDialog>
        {
            { x => x.MappingId, mappingId },
            { x => x.AttributeName, attributeName },
            { x => x.ConfiguredStart, configuredStart },
            { x => x.FixedWidth, fixedWidth },
            { x => x.MetaverseAttributeId, metaverseAttributeId },
            { x => x.ConnectedSystemObjectTypeAttributeId, connectedSystemObjectTypeAttributeId }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await dialogService.ShowAsync<GeneratedValueStartAgainDialog>($"Start {attributeName} again?", parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: true };
    }
}
