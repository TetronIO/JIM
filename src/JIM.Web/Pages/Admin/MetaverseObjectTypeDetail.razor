    private async Task ReloadObjectTypeAsync()
    {
        using var jim = JimFactory.Create();
        _metaverseObjectType = await jim.Metaverse.GetMetaverseObjectTypeAsync(Id, true);
        _contributorCounts = await jim.ConnectedSystems.GetAttributeContributorCountsAsync(Id);
        StateHasChanged();

        // Binding or unbinding an attribute changes how many there are, so the grid's total and the chip filter
        // counts above it both describe a list that no longer exists until it is re-counted.
        if (_attributeGrid != null)
            await _attributeGrid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Slices one window of the attributes bound to this Object Type, applying the page's three chip filters, the
    /// grid's search (name; the same field the old table filtered) and its sort. The attributes are loaded with
    /// the Object Type, so there is no database range read here.
    /// </summary>
    private Task<VirtualisedWindow<MetaverseAttribute>> LoadAttributeWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<MetaverseAttribute> attributes = _metaverseObjectType?.Attributes ?? new List<MetaverseAttribute>();

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            attributes = attributes.Where(a => a.Name.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        if (_selectedTypes.Count > 0)
            attributes = attributes.Where(a => _selectedTypes.Contains(a.Type));

        if (_selectedPluralities.Count > 0)
            attributes = attributes.Where(a => _selectedPluralities.Contains(a.AttributePlurality));

        if (_selectedBuiltIn.Count > 0)
            attributes = attributes.Where(a => _selectedBuiltIn.Contains(a.BuiltIn));

        IOrderedEnumerable<MetaverseAttribute> Order<TKey>(Func<MetaverseAttribute, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? attributes.OrderByDescending(key, comparer) : attributes.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "type" => Order(a => a.Type),
            "plurality" => Order(a => a.AttributePlurality),
            "builtin" => Order(a => a.BuiltIn),
            "created" => Order(a => a.Created),
            "contributors" => Order(a => _contributorCounts.GetValueOrDefault(a.Id, 0)),
            _ => Order(a => a.Name, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    /// <summary>
    /// Slices one window of the export Synchronisation Rules targeting this Object Type, applying the grid's
    /// search (rule name and Connected System name) and sort.
    /// </summary>
    private Task<VirtualisedWindow<SyncRuleHeader>> LoadExportRuleWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<SyncRuleHeader> headers = _exportRuleHeaders ?? new List<SyncRuleHeader>();

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            headers = headers.Where(h =>
                h.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                h.ConnectedSystemName.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        IOrderedEnumerable<SyncRuleHeader> Order<TKey>(Func<SyncRuleHeader, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? headers.OrderByDescending(key, comparer) : headers.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "name" => Order(h => h.Name, StringComparer.OrdinalIgnoreCase),
            "status" => Order(h => h.Enabled),
            "deprovisioningaction" => Order(h => h.OutboundDeprovisionAction),
            _ => Order(h => h.ConnectedSystemName, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    /// <summary>Whether any of the three chip filters is narrowing the attribute list.</summary>
    private bool HasAttributeChipFilters =>
        _selectedTypes.Count > 0 || _selectedPluralities.Count > 0 || _selectedBuiltIn.Count > 0;

    private async Task OnTypeFilterChanged(IReadOnlyCollection<AttributeDataType> selectedTypes)
    {
        _selectedTypes = selectedTypes;
        await RefreshAttributeGridAsync();
    }

    private async Task OnPluralityFilterChanged(IReadOnlyCollection<AttributePlurality> selectedPluralities)
    {
        _selectedPluralities = selectedPluralities;
        await RefreshAttributeGridAsync();
    }

    private async Task OnBuiltInFilterChanged(IReadOnlyCollection<bool> selectedBuiltIn)
    {
        _selectedBuiltIn = selectedBuiltIn;
        await RefreshAttributeGridAsync();
    }

    private async Task ClearAttributeFiltersAsync()
    {
        _selectedTypes = new List<AttributeDataType>();
        _selectedPluralities = new List<AttributePlurality>();
        _selectedBuiltIn = new List<bool>();
        await RefreshAttributeGridAsync();
    }

    /// <summary>
    /// Re-runs the attribute window under the page's chip filters. The match set is different, so the total (and
    /// the unfiltered baseline the toolbar count compares against) has to be counted again, and the scroll
    /// position describes rows that are no longer there.
    /// </summary>
    private async Task RefreshAttributeGridAsync()
    {
        if (_attributeGrid == null)
            return;

        await _attributeGrid.ResetScrollAsync();
        await _attributeGrid.RefreshAsync(invalidateTotals: true);
    }

    private IEnumerable<KeyValuePair<AttributeDataType, int>> GetAvailableTypes()
    {
        if (_metaverseObjectType == null)
            return Enumerable.Empty<KeyValuePair<AttributeDataType, int>>();

        return _metaverseObjectType.Attributes
            .GroupBy(a => a.Type)
            .Select(g => new KeyValuePair<AttributeDataType, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key.ToString());
    }

    private IEnumerable<KeyValuePair<AttributePlurality, int>> GetAvailablePluralities()
    {
        if (_metaverseObjectType == null)
            return Enumerable.Empty<KeyValuePair<AttributePlurality, int>>();

        return _metaverseObjectType.Attributes
            .GroupBy(a => a.AttributePlurality)
            .Select(g => new KeyValuePair<AttributePlurality, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key);
    }

    private IEnumerable<KeyValuePair<bool, int>> GetAvailableBuiltIn()
    {
        if (_metaverseObjectType == null)
            return Enumerable.Empty<KeyValuePair<bool, int>>();

        return _metaverseObjectType.Attributes
            .GroupBy(a => a.BuiltIn)
            .Select(g => new KeyValuePair<bool, int>(g.Key, g.Count()))
            .OrderByDescending(x => x.Key); // Yes first, then No
    }
}
