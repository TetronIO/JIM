<MudSimpleTable Dense="true" Hover="true" Bordered="true" Elevation="0" Class="mt-2 jim-schema-change-table">
    <thead>
        <tr>
            <th>Change Type</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @if (Result.AddedObjectTypes.Count > 0)
        {
            <tr>
                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Success" Class="me-1" /><span>Object Types Added</span></div></td>
                <td class="jim-text-code">@string.Join(", ", Result.AddedObjectTypes)</td>
            </tr>
        }
        @if (Result.RemovedObjectTypes.Count > 0)
        {
            <tr>
                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Error" Class="me-1" /><span>Object Types No Longer Reported</span></div></td>
                <td class="jim-text-code">@string.Join(", ", Result.RemovedObjectTypes)</td>
            </tr>
        }
        @if (Result.UpdatedObjectTypes.Count > 0)
        {
            <tr>
                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Update" Color="Color.Info" Class="me-1" /><span>Object Types Updated</span></div></td>
                <td class="jim-text-code">@string.Join(", ", Result.UpdatedObjectTypes)</td>
            </tr>
        }
        @foreach (var kvp in Result.AddedAttributes)
        {
            <tr>
                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Add" Color="Color.Success" Class="me-1" /><span>Attributes Added (@kvp.Key)</span></div></td>
                <td class="jim-text-code">@string.Join(", ", kvp.Value)</td>
            </tr>
        }
        @foreach (var kvp in Result.RemovedAttributes)
        {
            <tr>
                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.Remove" Color="Color.Warning" Class="me-1" /><span>Attributes No Longer Reported (@kvp.Key)</span></div></td>
                <td class="jim-text-code">@string.Join(", ", kvp.Value)</td>
            </tr>
        }
        @foreach (var kvp in Result.ChangedAttributes)
        {
            <tr>
                <td><div class="d-flex align-center"><MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Warning" Class="me-1" /><span>Attribute Definitions Changed (@kvp.Key)</span></div></td>
                <td class="jim-text-code">@string.Join(", ", kvp.Value.Select(Describe))</td>
            </tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    /// <summary>
    /// The schema refresh whose changes this table lists. Shared by the refresh preview panel and the applied
    /// refresh summary so the two can never describe the same refresh differently.
    /// </summary>
    [Parameter, EditorRequired]
    public SchemaRefreshResult Result { get; set; } = null!;

    private static string Describe(SchemaAttributeDefinitionChange change)
    {
        var aspect = change.Aspect == SchemaAttributeChangeAspect.DataType ? "data type" : "plurality";
        return $"{change.AttributeName}: {aspect} {change.OldValue} → {change.NewValue}";
    }
}
