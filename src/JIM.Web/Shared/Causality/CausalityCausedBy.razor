@* The upward causal chain for a Run Profile Execution Item: why the changes on screen happened, and why
   those happened, as far back as retention and the depth bound allow (#1223). Renders nothing at all when
   nothing caused the item, which is the ordinary case; an empty "Caused by" heading would imply the chain
   had been looked for and lost, when in truth the item simply has a local explanation. *@

@if (Chain is { Cohorts.Count: > 0 })
{
    <div class="caused-by">
        <div class="cb-head">
            <span class="cb-title">Caused by</span>
            @if (Chain.IsTruncatedByDepth)
            {
                <span class="cb-truncated">Some branches go further back than shown</span>
            }
        </div>
        <ol class="cb-list">
            @foreach (var cohort in Chain.Cohorts)
            {
                <CausalityCausedByHop Cohort="cohort" EffectName="@EffectName" EffectItemId="EffectItemId" />
            }
        </ol>
    </div>
}

@code {
    /// <summary>
    /// The walk to render. Null (the page has not resolved one) and empty (nothing caused this item) both
    /// render nothing; the component never draws a heading it cannot fill.
    /// </summary>
    [Parameter]
    public CausalChain? Chain { get; set; }

    /// <summary>
    /// The name of the record this page is about, which the first level of causes acted on: the possessive
    /// in "removed from Project Diamond's Static Members". Null degrades the sentence rather than blanking it.
    /// </summary>
    [Parameter]
    public string? EffectName { get; set; }

    /// <summary>
    /// The Run Profile Execution Item being viewed. A cause recorded on this same item is not linked, since
    /// the link would land back on the page the reader is already on.
    /// </summary>
    [Parameter]
    public Guid? EffectItemId { get; set; }
}
