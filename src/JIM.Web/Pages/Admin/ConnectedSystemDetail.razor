<PageTitle>Connected System: @_connectedSystem?.Name</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>Connected System:</span> <span class="mud-primary-text">@_connectedSystem?.Name</span></MudText>
<div class="d-flex justify-space-between align-center">
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
    @if (_connectedSystem != null)
    {
        <AuditInfo Entity="@_connectedSystem" />
    }
</div>

@* ─── Data views (the Connected System's data, as distinct from the configuration tabs below) ─── *@
@if (_connectedSystem != null)
{
    @* mt-2 combines with the breadcrumbs' own 16px padding for the 24px section gap; mb-6 because the
       following block's mt-2 alone collapses to 8px, same reasoning as the drift notice below. *@
    <MudStack Row Spacing="3" Class="mt-2 mb-6">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Storage"
                   DropShadow="false"
                   Href="@($"/admin/connected-systems/{_connectedSystem.Id}/connector-space")">
            Connector Space
            <span class="jim-nav-count">@_connectedSystemObjectCount.ToString("N0")</span>
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Outbox"
                   DropShadow="false"
                   Href="@($"/admin/connected-systems/{_connectedSystem.Id}/pending-exports")">
            Pending Exports
            <span class="@(_pendingExportCount > 0 ? "jim-nav-count jim-nav-count-warning" : "jim-nav-count")">@_pendingExportCount.ToString("N0")</span>
        </MudButton>
    </MudStack>
}

@* ─── Run Profile Safeguards withheld-changes notice (#1618) ───
   Derived from the most recent completed Export Activity, so a backlog of deliberately unprocessed
   changes cannot sit unnoticed behind a warning-status Activity on a busy Operations page. *@
@if (_connectedSystem != null && _latestExportActivity is { } exportActivity &&
     (exportActivity.ExportCreatesWithheld ?? 0) + (exportActivity.ExportUpdatesWithheld ?? 0) + (exportActivity.ExportDeletesWithheld ?? 0) is var totalWithheld and > 0)
{
    var exportRunProfile = _connectedSystem.RunProfiles?.FirstOrDefault(rp => rp.Id == exportActivity.ConnectedSystemRunProfileId);
    var limitsReached = new List<string>();
    if ((exportActivity.ExportCreatesWithheld ?? 0) > 0 && exportRunProfile?.MaxCreates is { } maxCreates)
        limitsReached.Add($"Max creates of {maxCreates:N0}");
    if ((exportActivity.ExportUpdatesWithheld ?? 0) > 0 && exportRunProfile?.MaxUpdates is { } maxUpdates)
        limitsReached.Add($"Max updates of {maxUpdates:N0}");
    if ((exportActivity.ExportDeletesWithheld ?? 0) > 0 && exportRunProfile?.MaxDeletes is { } maxDeletes)
        limitsReached.Add($"Max deletes of {maxDeletes:N0}");
    var limitsText = limitsReached.Count > 0 ? string.Join(" and ", limitsReached) : "its limit";
    var changeNoun = totalWithheld == 1 ? "change" : "changes";

    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2 mb-6">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.SpaceBetween" Class="flex-grow-1">
            <span>
                The last export withheld @totalWithheld.ToString("N0") @changeNoun:
                <strong>@exportActivity.TargetName</strong> reached its @limitsText.
                They remain pending and will be attempted on the next export run.
            </span>
            <MudStack Row Spacing="2">
                <MudButton Variant="Variant.Text" Color="Color.Inherit" DropShadow="false"
                           Href="@($"/activity/{exportActivity.Id}")">
                    View Activity
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" DropShadow="false"
                           Href="@($"/admin/connected-systems/{_connectedSystem.Id}?t=run-profiles")">
                    Edit Run Profile
                </MudButton>
            </MudStack>
        </MudStack>
    </MudAlert>
}

@* ─── Deletion fence notice (#809) ───
   A system with Status = Deleting is fenced: excluded from scheduled runs, its deletion either underway on
   the worker or stopped partway. The banner is the page's authority on that state; the Danger Zone's delete
   button stays live so the administrator can take the retry or finish-immediately exit from there. *@
@if (_connectedSystem is { Status: ConnectedSystemStatus.Deleting })
{
    @if (_deletionTask != null)
    {
        var deletionActivity = _deletionTask.Activity;
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2 mb-6">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.SpaceBetween" Class="flex-grow-1">
                <span>
                    @if (_deletionTask.SynchronisedDeprovisioning)
                    {
                        <strong>Deprovisioning in progress.</strong>
                        <text> This system is being deleted through synchronisation and is excluded from scheduled runs;
                        configuration is read-only until the run completes.</text>
                        @if (deletionActivity is { ObjectsToProcess: > 0 } progressActivity)
                        {
                            var objectsProcessed = progressActivity.ObjectsProcessed;
                            var objectsToProcess = progressActivity.ObjectsToProcess;
                            <text> @objectsProcessed.ToString("N0") of @objectsToProcess.ToString("N0") objects processed.</text>
                        }
                    }
                    else
                    {
                        <strong>Deletion in progress.</strong>
                        <text> This system is being deleted and is excluded from scheduled runs; configuration is
                        read-only until the deletion completes.</text>
                    }
                </span>
                @if (deletionActivity is { } linkActivity)
                {
                    var deletionActivityId = linkActivity.Id;
                    <MudButton Variant="Variant.Text"
                               Color="Color.Inherit"
                               DropShadow="false"
                               Href="@($"/activity/{deletionActivityId}")">
                        View Activity
                    </MudButton>
                }
            </MudStack>
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-2 mb-6">
            <strong>Deprovisioning stopped before completing.</strong> A Synchronised Deprovisioning run did not finish,
            so this system remains fenced and excluded from scheduled runs; the work already done stands. Deleting the
            system again with Deprovision through synchronisation resumes from where the run stopped; Delete immediately
            and keep contributed data finishes the deletion at once.
        </MudAlert>
    }
}

@* ─── Objects awaiting deprovisioning ───
   Obsolescence is a transient state on a healthy system, lasting from the import that found an object
   gone until the synchronisation that deletes it, so this is Info rather than a warning. It earns a place
   beside the drift notice because it answers the same shape of question ("what is waiting on a run?") and
   because the status was otherwise visible only on individual objects, which is nowhere anybody looks: a
   system that is imported and never synchronised accumulates them in silence (#1527). *@
@if (_connectedSystem != null && _obsoleteConnectedSystemObjectCount > 0)
{
    var obsoleteLead = _obsoleteConnectedSystemObjectCount == 1
        ? "1 Connected System Object is obsolete."
        : $"{_obsoleteConnectedSystemObjectCount:N0} Connected System Objects are obsolete.";
    var obsoleteSubject = _obsoleteConnectedSystemObjectCount == 1 ? "It was" : "They were";
    var obsoletePronoun = _obsoleteConnectedSystemObjectCount == 1 ? "it" : "them";
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2 mb-6">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.SpaceBetween" Class="flex-grow-1">
            <span>
                @obsoleteLead @obsoleteSubject not returned by the last Full Import, so the next Synchronisation
                Run Profile on this system will disconnect @obsoletePronoun from their Metaverse Objects and
                delete @obsoletePronoun.
            </span>
            <MudButton Variant="Variant.Text"
                       Color="Color.Info"
                       DropShadow="false"
                       Href="@($"/admin/connected-systems/{_connectedSystem.Id}/connector-space?status=Obsolete")">
                Review
            </MudButton>
        </MudStack>
    </MudAlert>
}

@* ─── Stranded-value sweep armed notice ───
   Armed by every Connector Space clear (#1549) and gated on a genuine Full Import since (#1605): says which
   of the two waiting states the system is in, so an administrator does not have to read the Activity
   history to know whether the next Full Synchronisation will do anything. *@
@if (_connectedSystem != null && _connectedSystem.StrandedValueSweepArmedAt is { } armedAt)
{
    var lastImport = _connectedSystem.LastSuccessfulFullImportCompletedAt;
    var sweepReady = lastImport.HasValue && lastImport.Value > armedAt;
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2 mb-6">
        @if (sweepReady)
        {
            var lastImportAt = lastImport!.Value;
            <span>
                A stranded-value sweep is armed: the Connector Space was cleared on @armedAt.ToFriendlyDate() UTC
                and a Full Import completed on @lastImportAt.ToFriendlyDate() UTC. The next Full Synchronisation
                of this Connected System will recall values contributed by objects that did not return.
            </span>
        }
        else
        {
            <span>
                A stranded-value sweep is armed: the Connector Space was cleared on @armedAt.ToFriendlyDate() UTC.
                It will run at the first Full Synchronisation after a Full Import of this Connected System
                completes successfully; a Full Synchronisation run before then does nothing beyond ordinary
                synchronisation.
            </span>
        }
    </MudAlert>
}

@* ─── Configuration drift notice ─── *@
@if (_drift is { HasPendingChanges: true })
{
    @* Composed in C# rather than assembled from markup fragments, so the punctuation sits tight against the
       timestamp and the singular and plural readings are both correct. *@
    var driftClass = _drift.HighestChangeClass;
    var driftCount = _drift.ChangeCount;
    var lastSync = _drift.LastFullSynchronisation;
    var driftWhen = lastSync.HasValue ? $" ({lastSync.Value.ToLocalTime().ToFriendlyDate()})" : string.Empty;
    var driftLead = driftCount == 1
        ? $"1 configuration change has been made since the last Full Synchronisation{driftWhen}."
        : $"{driftCount:N0} configuration changes have been made since the last Full Synchronisation{driftWhen}.";
    var driftGuidance = driftClass == ConfigurationChangeClass.Destructive
        ? driftCount == 1
            ? "It is destructive and can cascade deletions or mass deprovisioning the moment it is applied. Review it before running a Full Synchronisation."
            : "At least one of them is destructive and can cascade deletions or mass deprovisioning the moment it is applied. Review them before running a Full Synchronisation."
        : driftCount == 1
            ? "Run a Full Synchronisation for it to take effect."
            : "Run a Full Synchronisation for them to take effect.";
    <MudAlert Severity="@(driftClass == ConfigurationChangeClass.Destructive ? Severity.Error : Severity.Warning)"
              Variant="Variant.Outlined" Class="mt-2 mb-6">
        @driftLead @driftGuidance
    </MudAlert>
}
else if (_drift is { NeverFullySynchronised: true })
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2 mb-6">
        This Connected System has never completed a Full Synchronisation, so its configuration has never been applied
        in full.
    </MudAlert>
}
else if (_drift is { TrackingDisabled: true })
{
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-2 mb-6">
        Configuration change tracking is switched off, so JIM cannot tell whether this Connected System has
        configuration changes waiting for a Full Synchronisation.
    </MudAlert>
}

@if (_connectedSystem != null)
{
    <NavigableMudTabs TabPanelsClass="pt-5" Class="mt-2">

        <MudTabPanel Text="Details">
            <ConnectedSystemDetailsTab ConnectedSystem="_connectedSystem" />
        </MudTabPanel>

        <MudTabPanel Text="Settings">
            <ConnectedSystemSettingsTab ConnectedSystem="_connectedSystem"
                                        SettingCategories="_settingCategories!"
                                        OnConnectedSystemChanged="ReloadConnectedSystemAsync" />
        </MudTabPanel>

        <MudTabPanel Text="Schema" Disabled="@AreSettingDependentTabsDisabled()">
            <ConnectedSystemSchemaTab ConnectedSystem="_connectedSystem"
                                      LatestAuxiliaryClassDiscoveryRun="_latestAuxiliaryClassDiscoveryRun"
                                      OnConnectedSystemChanged="ReloadConnectedSystemAsync" />
        </MudTabPanel>

        @if (_connectedSystem.ConnectorDefinition.SupportsPartitions)
        {
            <MudTabPanel Text="Partitions & Containers" Disabled="@AreSettingDependentTabsDisabled()">
                <ConnectedSystemPartitionsTab ConnectedSystem="_connectedSystem"
                                              PartitionsAndHierarchiesText="@_partitionsAndHierarchiesText"
                                              PartitionAndHierarchyText="@_partitionAndHierarchyText"
                                              OnConnectedSystemChanged="ReloadConnectedSystemAsync" />
            </MudTabPanel>
        }

        <MudTabPanel Text="Matching" Disabled="@IsObjectMatchingTabDisabled()">
            <ConnectedSystemObjectMatchingTab ConnectedSystem="_connectedSystem"
                                              MetaverseAttributes="_metaverseAttributes!"
                                              MetaverseObjectTypes="_metaverseObjectTypes!" />
        </MudTabPanel>

        <MudTabPanel Text="Run Profiles" Disabled="@IsRunProfilesTabDisabled()">
            <ConnectedSystemRunProfilesTab ConnectedSystem="_connectedSystem" />
        </MudTabPanel>

        @* Hidden rather than disabled where the Connector has no password channel: there is nothing here to
            configure at all, and a disabled tab reads as something that could be switched on. *@
        @if (_connectedSystem.ConnectorDefinition.SupportsPasswordSet)
        {
            <MudTabPanel Text="Passwords" Disabled="@AreSettingDependentTabsDisabled()">
                <ConnectedSystemPasswordSynchronisationTab ConnectedSystem="_connectedSystem"
                                                           OnConnectedSystemChanged="ReloadConnectedSystemAsync" />
            </MudTabPanel>
        }

        <MudTabPanel Text="Changes" BadgeData="@(_changeCount > 0 ? _changeCount.ToString("N0") : null)" BadgeColor="Color.Primary">
            <ConfigurationChangesTab TargetType="ActivityTargetType.ConnectedSystem" ObjectId="_connectedSystem.Id" ObjectTypeLabel="Connected System" />
        </MudTabPanel>

        <MudTabPanel Text="Danger Zone" Icon="@Icons.Material.Filled.Warning" BadgeColor="Color.Error" ID="@("danger-zone")">
            <ConnectedSystemDangerZoneTab ConnectedSystem="_connectedSystem" />
        </MudTabPanel>

    </NavigableMudTabs>

}

@code {
    [Parameter]
    public int Id { get; set; }
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private ConnectedSystem? _connectedSystem;
    private List<ConnectedSystemSettingCategory>? _settingCategories;
    private string? _partitionsAndHierarchiesText;
    private string? _partitionAndHierarchyText;
    private int _pendingExportCount;
    private int _connectedSystemObjectCount;
    private int _obsoleteConnectedSystemObjectCount;

    // Run Profile Safeguards (#1618): the most recent completed Export Activity, so a backlog of
    // deliberately unprocessed changes cannot sit unnoticed behind a warning-status Activity.
    private Activity? _latestExportActivity;
    private int _changeCount;
    private ConfigurationDriftStatus? _drift;
    private List<BreadcrumbItem> _breadcrumbs = null!;

    // The live deletion task for a fenced system (#809). A surviving task means the deletion is queued or
    // executing (its Activity is where progress lives); a fenced system with no task is a failed run,
    // retryable from the Danger Zone.
    private DeleteConnectedSystemWorkerTask? _deletionTask;

    private IList<MetaverseAttribute>? _metaverseAttributes;

    private AuxiliaryClassDiscoveryRun? _latestAuxiliaryClassDiscoveryRun;

    // A Simple mode Object Matching Rule has to name the Metaverse Object Type it searches, so the Matching tab
    // needs the list to offer (#1458).
    private IList<MetaverseObjectType>? _metaverseObjectTypes;


    protected override async Task OnInitializedAsync()
    {
        await LoadConnectedSystemAsync();
    }

    private async Task LoadConnectedSystemAsync()
    {
        using var jim = JimFactory.Create();
        _connectedSystem = await jim.ConnectedSystems.GetConnectedSystemAsync(Id, withChangeTracking: true);
        if (_connectedSystem == null)
        {
            NavManager.NavigateTo("../");
            return;
        }

        _breadcrumbs =
        [
            new BreadcrumbItem("Home", href: "/", icon: Icons.Material.Filled.Home),
            new BreadcrumbItem("Administration", href: "/admin"),
            new BreadcrumbItem("Connected Systems", href: "/admin/connected-systems/"),
            new BreadcrumbItem(_connectedSystem.Name, href: null, disabled: true)
        ];

        _settingCategories = _connectedSystem.SettingValues
            .Select(q => q.Setting.Category)
            .Distinct()
            .Where(category => ShouldShowCategory(category))
            .OrderBy(category => GetCategoryDisplayOrder(category))
            .ToList();

        if (_connectedSystem.ConnectorDefinition is { SupportsPartitions: true, SupportsPartitionContainers: true })
        {
            _partitionsAndHierarchiesText = "partitions and containers";
            _partitionAndHierarchyText = "partition and container";
        }
        else if (_connectedSystem.ConnectorDefinition.SupportsPartitions)
        {
            _partitionsAndHierarchiesText = "partitions";
            _partitionAndHierarchyText = "partition";
        }

        // Resolve the live deletion task for a fenced system, so the fence notice can link its Activity
        // and show progress; one lookup, only when fenced (#809).
        _deletionTask = _connectedSystem.Status == ConnectedSystemStatus.Deleting
            ? await jim.Tasking.GetDeleteConnectedSystemWorkerTaskAsync(Id)
            : null;

        _pendingExportCount = await jim.ConnectedSystems.GetPendingExportsCountAsync(Id);
        _connectedSystemObjectCount = await jim.ConnectedSystems.GetConnectedSystemObjectCountAsync(Id);
        _latestExportActivity = await jim.Activities.GetLatestCompletedExportActivityAsync(Id);
        _obsoleteConnectedSystemObjectCount = await jim.ConnectedSystems.GetConnectedSystemObjectObsoleteCountAsync(Id);
        _drift = await jim.ConfigurationDrift.GetConnectedSystemDriftAsync(Id);
        _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.ConnectedSystem, Id, 1, 1)).TotalResults;
        _metaverseAttributes ??= await jim.Metaverse.GetMetaverseAttributesAsync();
        _metaverseObjectTypes ??= await jim.Metaverse.GetMetaverseObjectTypesAsync(false);

        // Loaded here rather than by the Schema tab's Auxiliary Classes panel, which is rendered once per Object
        // Type: the run belongs to the whole Connected System, and a panel that fetched it for itself would query
        // once per type on every render. The tab reaches the application layer only in response to an action.
        _latestAuxiliaryClassDiscoveryRun = await jim.ConnectedSystems.GetLatestAuxiliaryClassDiscoveryRunAsync(Id);
    }

    private async Task ReloadConnectedSystemAsync()
    {
        await LoadConnectedSystemAsync();
        StateHasChanged();
    }

    private bool AreSettingDependentTabsDisabled()
    {
        if (_connectedSystem == null)
            return true;

        return !_connectedSystem.SettingValuesValid;
    }

    /// <summary>
    /// Determines whether a setting category should be displayed based on connector capabilities.
    /// </summary>
    private bool ShouldShowCategory(ConnectedSystemSettingCategory category)
    {
        if (_connectedSystem?.ConnectorDefinition == null)
            return true;

        return category switch
        {
            // Only show Import category if the connector supports full or delta import
            ConnectedSystemSettingCategory.Import =>
                _connectedSystem.ConnectorDefinition.SupportsFullImport ||
                _connectedSystem.ConnectorDefinition.SupportsDeltaImport,

            // Only show Export category if the connector supports export
            ConnectedSystemSettingCategory.Export =>
                _connectedSystem.ConnectorDefinition.SupportsExport,

            // Always show other categories
            _ => true
        };
    }

    /// <summary>
    /// Returns the display order for setting categories.
    /// Order: Import, Export, General, Schema, Connectivity, Capabilities
    /// </summary>
    private static int GetCategoryDisplayOrder(ConnectedSystemSettingCategory category)
    {
        return category switch
        {
            ConnectedSystemSettingCategory.Import => 0,
            ConnectedSystemSettingCategory.Export => 1,
            ConnectedSystemSettingCategory.General => 2,
            ConnectedSystemSettingCategory.Schema => 3,
            ConnectedSystemSettingCategory.Connectivity => 4,
            ConnectedSystemSettingCategory.Capabilities => 5,
            _ => 99
        };
    }

    private bool IsRunProfilesTabDisabled()
    {
        if (_connectedSystem == null)
            return true;

        // Disable if settings are invalid
        if (!_connectedSystem.SettingValuesValid)
            return true;

        // Disable if the connector supports partitions but none are selected (with containers if applicable)
        if (_connectedSystem.ConnectorDefinition.SupportsPartitions)
            return !_connectedSystem.HasPartitionsOrContainersSelected();

        return false;
    }

    private bool IsObjectMatchingTabDisabled()
    {
        if (_connectedSystem == null)
            return true;

        // Disable if settings are invalid
        if (!_connectedSystem.SettingValuesValid)
            return true;

        // Disable if the connector supports partitions but none are selected (with containers if applicable)
        if (_connectedSystem.ConnectorDefinition.SupportsPartitions)
            return !_connectedSystem.HasPartitionsOrContainersSelected();

        return false;
    }
}
