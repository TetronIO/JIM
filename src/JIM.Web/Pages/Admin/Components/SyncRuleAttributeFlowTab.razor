@using JIM.Models.Core
@using JIM.Models.Expressions
@using JIM.Models.Interfaces
@using JIM.Models.Logic
@using JIM.Models.Logic.DTOs
@using JIM.Models.Staging
@using JIM.Models.Utility
@using JIM.Utilities
@using JIM.Application
@using JIM.Web.Models
@inject IDialogService DialogService
@inject IJimApplicationFactory JimFactory
@inject IExpressionEvaluator ExpressionEvaluator
@implements IDisposable

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

@{
    // Recomputed on every render from the rule's own flows, so it can never disagree with the grid below it.
    var exchangeRecipientFlows = ExchangeRecipientFlows.For(SyncRule);
}
@if (exchangeRecipientFlows != null)
{
    <SyncRuleExchangeRecipientsPanel Flows="exchangeRecipientFlows" SyncRuleName="@SyncRule.Name"
                                     OnSet="HandleExchangeRecipientSetAsync"
                                     OnEdit="HandleEditAttributeFlowRuleAsync"
                                     OnRemove="HandleAttributeFlowRuleDeleteClickAsync"
                                     OnStop="HandleStopExchangeRecipientsAsync" />
}

<MudPaper Class="@(exchangeRecipientFlows != null ? "pa-4 mt-6" : "pa-4")" Outlined="true">
    <div class="d-flex align-center">
        <MudText Typo="Typo.h6">@SyncRuleText.AttributeFlowTitle</MudText>
        <TermHint Term="Term.AttributeFlow" />
    </div>
    <div class="d-flex align-center mt-3">
        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled"
            OnClick="HandleOpenAddAttributeFlowRuleDialogAsync"
            Disabled="DisableAddAttributeFlowButton()" DropShadow="false">@SyncRuleText.AddAttributeFlowButton</MudButton>
    </div>

    @if (SyncRule.AttributeFlowRules.Count > 0)
    {
        <MudStack Row="true" Spacing="6" Class="mt-3 mb-1 flex-wrap" AlignItems="AlignItems.Start">
            <div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@SyncRuleText.MappingTypeLabel</MudText>
                <MudChipSet T="AttributeFlowMappingType"
                            SelectionMode="SelectionMode.MultiSelection"
                            SelectedValues="_selectedMappingTypes"
                            SelectedValuesChanged="OnMappingTypeFilterChangedAsync">
                    @foreach (var type in GetAvailableMappingTypes())
                    {
                        <MudChip Value="@type.Key"
                                 Color="@(_selectedMappingTypes.Contains(type.Key) ? Color.Default : Helpers.GetMappingTypeChipColour(type.Key))"
                                 Variant="@(_selectedMappingTypes.Contains(type.Key) ? Variant.Filled : Variant.Outlined)"
                                 SelectedColor="@Helpers.GetMappingTypeChipColour(type.Key)">
                            @AttributeFlowSectionSummaries.MappingTypeName(type.Key)
                            <MudText Typo="Typo.caption" Class="ml-1">(@type.Value)</MudText>
                        </MudChip>
                    }
                </MudChipSet>
            </div>

            <div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@SyncRuleText.DataTypeLabel</MudText>
                <MudChipSet T="AttributeDataType"
                            SelectionMode="SelectionMode.MultiSelection"
                            SelectedValues="_selectedDataTypes"
                            SelectedValuesChanged="OnFlowDataTypeFilterChangedAsync">
                    @foreach (var type in GetAvailableFlowDataTypes())
                    {
                        <MudChip Value="@type.Key"
                                 Color="@(_selectedDataTypes.Contains(type.Key) ? Color.Default : Helpers.GetAttributeTypeChipColour(type.Key))"
                                 Variant="@(_selectedDataTypes.Contains(type.Key) ? Variant.Filled : Variant.Outlined)"
                                 SelectedColor="@Helpers.GetAttributeTypeChipColour(type.Key)">
                            @AttributeFlowSectionSummaries.DataTypeName(type.Key)
                            <MudText Typo="Typo.caption" Class="ml-1">(@type.Value)</MudText>
                        </MudChip>
                    }
                </MudChipSet>
            </div>

            <div>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">@SyncRuleText.PluralityLabel</MudText>
                <MudChipSet T="AttributePlurality"
                            SelectionMode="SelectionMode.MultiSelection"
                            SelectedValues="_selectedPluralities"
                            SelectedValuesChanged="OnFlowPluralityFilterChangedAsync">
                    @foreach (var plurality in GetAvailableFlowPluralities())
                    {
                        <MudChip Value="@plurality.Key"
                                 Color="@(_selectedPluralities.Contains(plurality.Key) ? Color.Default : Helpers.GetAttributePluralityChipColour(plurality.Key))"
                                 Variant="@(_selectedPluralities.Contains(plurality.Key) ? Variant.Filled : Variant.Outlined)"
                                 SelectedColor="@Helpers.GetAttributePluralityChipColour(plurality.Key)">
                            @AttributeFlowSectionSummaries.PluralityName(plurality.Key)
                            <MudText Typo="Typo.caption" Class="ml-1">(@plurality.Value)</MudText>
                        </MudChip>
                    }
                </MudChipSet>
            </div>
        </MudStack>
    }

    @* A Synchronisation Rule's Attribute Flows are held on the rule the page already loaded, so the grid's
       windows are sliced from that collection; the chip filters above it are the page's own, so changing one
       re-counts the match set (see RefreshFlowGridAsync). *@
    <VirtualisedDataGrid @ref="_flowGrid" T="SyncRuleMapping"
                         ContainerId="sync-rule-attribute-flow-list"
                         UrlParameterPrefix="af-"
                         DefaultSortBy="target"
                         LoadWindow="LoadAttributeFlowWindowAsync"
                         SingularName="@SyncRuleText.SingularAttributeFlow"
                         PluralName="@SyncRuleText.PluralAttributeFlows"
                         SearchPlaceholder="@SyncRuleText.SearchAttributeFlowsPlaceholder">
        <Columns>
            <TemplateColumn Title="@CommonText.ColumnType" Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@CommonText.ColumnType" Name="type" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudChip T="string" Variant="Variant.Text" Color="@Helpers.GetMappingTypeChipColour(context.Item.GetSourceType())">
                        @(context.Item.Generation != null ? SyncRuleText.TypeGenerated : AttributeFlowSectionSummaries.MappingTypeName(context.Item.GetSourceType()))
                    </MudChip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@SyncRuleText.ColumnSource" Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@SyncRuleText.ColumnSource" Name="source" />
                </HeaderTemplate>
                <CellTemplate>
                    @* Unique Value Generation (#242, Phase 3): a generated mapping carries at most one source
                       (its base expression), so it never needs OverflowList's overflow handling; the base
                       expression pill (if any) is followed by a token pill naming the uniqueness token, so
                       there is never a bare "-" (Sequence/Random with no base expression show the token pill
                       alone) or a dangling arrow. *@
                    @if (context.Item.Generation is { } rowGeneration)
                    {
                        var rowExpression = context.Item.Sources.FirstOrDefault(s => !string.IsNullOrWhiteSpace(s.Expression))?.Expression;
                        <div class="jim-one-line-list">
                            @if (rowExpression != null)
                            {
                                <span class="jim-one-line-list-value">
                                    <AttributeChip Kind="AttributeChipKind.Expression" Expression="@rowExpression" />
                                </span>
                            }
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">
                                @GeneratedValueFormHelpers.GetTokenPillText(rowGeneration, rowExpression != null)
                            </MudChip>
                        </div>
                    }
                    else
                    {
                        @* A row in a virtualised grid is one line, and a flow can join several sources, so the
                           first is shown and the rest open in a dialog drawn with the same chips. *@
                        <OverflowList TItem="SyncRuleMappingSource" Items="@context.Item.Sources.OrderBy(q => q.Order).ToList()" Title="@SyncRuleText.SourcesTitle">
                            <ItemTemplate Context="source">
                                @if (SyncRule.Direction == SyncRuleDirection.Import && source.ConnectedSystemAttribute != null)
                                {
                                    var connectedSystemSource = source.ConnectedSystemAttribute;
                                    <AttributeChip Kind="AttributeChipKind.ConnectedSystem"
                                                   Name="@connectedSystemSource.Name"
                                                   Tooltip="@Helpers.DescribeAttribute(AttributeChipKind.ConnectedSystem, connectedSystemSource.Type, connectedSystemSource.AttributePlurality)" />
                                }
                                else if (SyncRule.Direction == SyncRuleDirection.Export && source.MetaverseAttribute != null)
                                {
                                    var metaverseSource = source.MetaverseAttribute;
                                    <AttributeChip Kind="AttributeChipKind.Metaverse"
                                                   Name="@metaverseSource.Name"
                                                   Tooltip="@Helpers.DescribeAttribute(AttributeChipKind.Metaverse, metaverseSource.Type, metaverseSource.AttributePlurality)" />
                                }
                                else if (!string.IsNullOrWhiteSpace(source.Expression))
                                {
                                    <AttributeChip Kind="AttributeChipKind.Expression" Expression="@source.Expression" />
                                }
                            </ItemTemplate>
                        </OverflowList>
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate></HeaderTemplate>
                <CellTemplate>
                    <MudText Class="mud-text-secondary">→</MudText>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@SyncRuleText.ColumnTarget" Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@SyncRuleText.ColumnTarget" Name="target" />
                </HeaderTemplate>
                <CellTemplate>
                    @* One line, and the attribute name is the part that gives way: the modifier chips beside
                       it qualify what the flow does, so they must never be what a long name pushes out. *@
                    <div class="jim-one-line-list">
                        @if (SyncRule.Direction == SyncRuleDirection.Import && context.Item.TargetMetaverseAttribute is { } metaverseTarget)
                        {
                            <span class="jim-one-line-list-value">
                                <AttributeChip Kind="AttributeChipKind.Metaverse"
                                               Name="@metaverseTarget.Name"
                                               Tooltip="@Helpers.DescribeAttribute(AttributeChipKind.Metaverse, metaverseTarget.Type, metaverseTarget.AttributePlurality)" />
                            </span>
                            @if (DerivedStepInfoFor(context.Item) is { } rowStepInfo)
                            {
                                <DerivedFlowChip StepInfo="rowStepInfo" />
                            }
                        }
                        else if (SyncRule.Direction == SyncRuleDirection.Export && context.Item.TargetConnectedSystemAttribute is { } connectedSystemTarget)
                        {
                            <span class="jim-one-line-list-value">
                                <AttributeChip Kind="AttributeChipKind.ConnectedSystem"
                                               Name="@connectedSystemTarget.Name"
                                               Tooltip="@Helpers.DescribeAttribute(AttributeChipKind.ConnectedSystem, connectedSystemTarget.Type, connectedSystemTarget.AttributePlurality)" />
                            </span>
                            <ConnectorDefinedChip Attribute="@connectedSystemTarget" ConnectorName="@ConnectorName" />
                            @if (!context.Item.Enabled)
                            {
                                <MudTooltip Arrow="true" Placement="Placement.Top">
                                    <TooltipContent><TooltipText Text="@DescribeDisabledMapping(context.Item)" /></TooltipContent>
                                    <ChildContent><MudChip T="string" Variant="Variant.Text" Color="Color.Warning">@SyncRuleText.ChipDisabled</MudChip></ChildContent>
                                </MudTooltip>
                            }
                            @if (context.Item.InitialExportOnly)
                            {
                                <MudTooltip Text="@SyncRuleText.InitialExportOnlyTooltip" Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Variant="Variant.Text" Color="Color.Info">@SyncRuleText.InitialExportOnlyChip</MudChip>
                                </MudTooltip>
                            }
                            @if (connectedSystemTarget.Writability == AttributeWritability.WritableOnCreate)
                            {
                                <MudTooltip Text="@Helpers.GetAttributeWritabilityDescription(AttributeWritability.WritableOnCreate)" Arrow="true" Placement="Placement.Top">
                                    <MudChip T="string" Variant="Variant.Text" Color="Color.Info">@SyncRuleText.SetOnCreationOnlyChip</MudChip>
                                </MudTooltip>
                            }
                            @* A row is one line in a virtualised grid, so the note is an icon. *@
                            @if (AccountControlFlowNotes.ShowsPasswordDeliveryNote(SyncRule, context.Item, _passwordSynchronisationConfigured))
                            {
                                <MudTooltip Arrow="true" Placement="Placement.Top">
                                    <TooltipContent><TooltipText Text="@PasswordDeliveryNote" /></TooltipContent>
                                    <ChildContent>
                                        <MudIcon Icon="@Icons.Material.Outlined.Info" Color="Color.Info" Size="Size.Small" Class="ml-2"
                                                 aria-label="@PasswordDeliveryNote" data-testid="jim-password-delivery-note" />
                                    </ChildContent>
                                </MudTooltip>
                            }
                        }
                        @* Unique Value Generation (#242, Phase 6): the retired values register's size, only
                           when there is something in it. *@
                        @if (RetiredValueCountFor(context.Item) is var rowRetiredCount && rowRetiredCount > 0)
                        {
                            <MudTooltip Text="@RetiredChipTooltip(rowRetiredCount, TargetName(context.Item))" Arrow="true" Placement="Placement.Top">
                                <MudChip T="string" Variant="Variant.Text" Color="Color.Default" data-testid="jim-retired-count"
                                         OnClick="@(() => HandleViewRetiredValuesClickAsync(context.Item))">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.RetiredCount, rowRetiredCount)</MudChip>
                            </MudTooltip>
                        }
                        @if (MappingIsMvaToSva(context.Item))
                        {
                            <MudTooltip Text="@MvaToSvaIndicatorTooltip" Arrow="true" Placement="Placement.Top">
                                <MudIcon Icon="@Icons.Material.Outlined.WarningAmber" Color="Color.Inherit" Size="Size.Small" Class="ml-2 jim-mva-sva-indicator" />
                            </MudTooltip>
                        }
                    </div>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@CommonText.ColumnCreated" Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@CommonText.ColumnCreated" Name="created" />
                </HeaderTemplate>
                <CellTemplate>
                    <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                        <MudText Typo="Typo.body2">@context.Item.Created.ToLocalTime().ToRelativeTime()</MudText>
                    </MudTooltip>
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Title="@SyncRuleText.ColumnUpdated" Sortable="false">
                <HeaderTemplate>
                    <VirtualisedSortHeader Title="@SyncRuleText.ColumnUpdated" Name="updated" />
                </HeaderTemplate>
                <CellTemplate>
                    @if (context.Item.LastUpdated.HasValue)
                    {
                        var lastUpdated = context.Item.LastUpdated.Value;
                        <MudTooltip Text="@lastUpdated.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                            <MudText Typo="Typo.body2">@lastUpdated.ToLocalTime().ToRelativeTime()</MudText>
                        </MudTooltip>
                    }
                    else
                    {
                        <EmptyValue />
                    }
                </CellTemplate>
            </TemplateColumn>
            <TemplateColumn Sortable="false">
                <HeaderTemplate></HeaderTemplate>
                <CellTemplate>
                    <div class="d-flex justify-end gap-2">
                        @* Unique Value Generation (#242, Phase 3, Work Package D2): "Start again…" is offered
                           only for a saved generated Sequence mapping, next to the existing row actions. *@
                        @if (ShowViewRetiredValuesAction(context.Item))
                        {
                            <MudTooltip Text="@ViewRetiredValuesTooltip(RetiredValueCountFor(context.Item))" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.Archive" Variant="Variant.Filled" Color="Color.Default"
                                    Size="Size.Small" aria-label="@SyncRuleText.ViewRetiredValuesAria"
                                    OnClick="@(() => HandleViewRetiredValuesClickAsync(context.Item))" />
                            </MudTooltip>
                        }
                        @if (GeneratedValuePreviewHelpers.ShowStartAgainAction(context.Item))
                        {
                            <MudTooltip Text="@SyncRuleText.StartAgain" Arrow="true" Placement="Placement.Top">
                                <MudIconButton Icon="@Icons.Material.Outlined.RestartAlt" Variant="Variant.Filled" Color="Color.Default"
                                    Size="Size.Small" aria-label="@SyncRuleText.StartAgainAria"
                                    OnClick="@(() => HandleStartAgainClickAsync(context.Item))" />
                            </MudTooltip>
                        }
                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Variant="Variant.Filled" Color="Color.Primary"
                            Size="Size.Small" aria-label="@SyncRuleText.EditAria"
                            OnClick="@(() => HandleEditAttributeFlowRuleAsync(context.Item))" />
                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Variant="Variant.Filled" Color="Color.Error"
                            Size="Size.Small" aria-label="@SyncRuleText.DeleteAria"
                            OnClick="@(() => HandleAttributeFlowRuleDeleteClickAsync(context.Item))" />
                    </div>
                </CellTemplate>
            </TemplateColumn>
        </Columns>
        <EmptyContent Context="grid">
            @if (!string.IsNullOrWhiteSpace(grid.SearchText))
            {
                <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                                 PrimaryText="@(string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.NoAttributeFlowsMatchSearch, grid.SearchText))"
                                 SecondaryText="@SyncRuleText.NoAttributeFlowsMatchSearchHint"
                                 ActionText="@CommonText.ClearSearch"
                                 OnAction="@(() => grid.ClearSearchAsync())" />
            }
            else if (AnyAttributeFlowFilterIsActive)
            {
                <TableEmptyState Icon="@Icons.Material.Filled.FilterAltOff"
                                 PrimaryText="@SyncRuleText.NoAttributeFlowsMatchFilters"
                                 SecondaryText="@SyncRuleText.NoAttributeFlowsMatchFiltersHint" />
            }
            else
            {
                <TableEmptyState Icon="@Icons.Material.Filled.Map"
                                 PrimaryText="@SyncRuleText.NoAttributeFlowsYet"
                                 SecondaryText="@SyncRuleText.NoAttributeFlowsYetHint" />
            }
        </EmptyContent>
    </VirtualisedDataGrid>
</MudPaper>

<MudDialog @bind-Visible="_addAttributeFlowRuleDialogVisible" Options="DialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Map" Class="mr-3" /> @(_isEditingAttributeFlow ? SyncRuleText.EditAttributeFlowTitle : SyncRuleText.AddAttributeFlowButton)
        </MudText>
    </TitleContent>
    <DialogContent>
        @* The dialog widens once the Source Type has something to try; this applies that while it is open. *@
        <DialogOptionsSync Options="DialogOptions" />
        @* A Generated Value lays out both panes itself, since its tester's values live in its own tree (#2471). *@
        @if (_attributeFlowMappingSourceType == "Generated" && _attributeFlowMapping != null && _attributeFlowMappingSource != null
             && SyncRule.MetaverseObjectType != null && GeneratedTargetType.HasValue)
        {
            <GeneratedValueOptionsEditor Mapping="_attributeFlowMapping" BaseSource="_attributeFlowMappingSource"
                TargetType="GeneratedTargetType" TargetName="@GeneratedTargetName"
                Direction="SyncRule.Direction" SyncRuleId="SyncRule.Id" ConnectedSystemId="SyncRule.ConnectedSystemId"
                MetaverseObjectTypeId="SyncRule.MetaverseObjectTypeId"
                TargetMetaverseAttributeId="_attributeFlowMapping.TargetMetaverseAttribute?.Id"
                StagedSyncRule="SyncRule" BaseExpressionCheck="AttributeFlowExpressionCheck"
                MetaverseAttributeNames="SuggestedMetaverseAttributeNames"
                ConnectedSystemAttributeNames="SuggestedConnectedSystemAttributeNames"
                OnChanged="ScheduleFlowAnalysisAsync" SettingsHeader="@DialogHeader" SettingsFooter="@GeneratedSettingsFooter">
                <BaseExpressionTools Context="insertIntoBaseExpression">
                    @* A generated mapping's base expression can read mv["..."] too (#1750, #242). *@
                    <div class="mt-1">
                        <InsertFunctionMenu OnInsert="insertIntoBaseExpression" />
                        <InsertAttributeMenu MetaverseAttributes="InsertableMetaverseAttributes"
                                             ConnectedSystemAttributes="InsertableConnectedSystemAttributes"
                                             ConnectedSystemName="@SyncRule.ConnectedSystem?.Name"
                                             TargetMetaverseAttributeId="_attributeFlowMapping.ResolveTargetMetaverseAttributeId()"
                                             Direction="SyncRule.Direction"
                                             OnInsert="insertIntoBaseExpression" />
                    </div>
                    <DerivedFlowPanel Analysis="_derivedFlowAnalysis" ConnectedSystemName="@SyncRule.ConnectedSystem?.Name" />
                </BaseExpressionTools>
            </GeneratedValueOptionsEditor>
        }
        else
        {
        <AttributeFlowEditorLayout ShowTryIt="DialogHasTryIt">
            <Settings>
                @DialogHeader


                @if (_attributeFlowMapping != null && _attributeFlowMappingSource != null && SyncRule.MetaverseObjectType != null)
                {
                    @switch (_attributeFlowMappingSourceType)
                    {
                        case "Attribute":
                        {
                            if (SyncRule.Direction == SyncRuleDirection.Import)
                            {
                                <MudSelect T="ConnectedSystemObjectTypeAttribute"
                                    @bind-Value="_attributeFlowMappingSource.ConnectedSystemAttribute" Label="@SyncRuleText.ConnectedSystemAttributeLabel"
                                    Placeholder="@SyncRuleText.SelectSourceConnectedSystemAttribute" Required="true" Class="mt-5"
                                    Variant="Variant.Outlined" ToStringFunc="@ConnectedSystemAttributeLabel">
                                    @* Credential attributes are excluded entirely: they are handled by JIM's password channel, never by Attribute Flow *@
                                    @foreach (var connectedSystemAttribute in SyncRule.ConnectedSystemObjectType!.Attributes.Where(q =>
                                                !CredentialAttributes.IsCredentialAttribute(q.Name)))
                                    {
                                        <MudSelectItem Value="@connectedSystemAttribute">@connectedSystemAttribute.Name <span
                                                style="@($"color:{Colors.Gray.Darken1};")">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.AttributeTypeAndPlurality, AttributeFlowSectionSummaries.DataTypeName(connectedSystemAttribute.Type), AttributeFlowSectionSummaries.PluralityWords(connectedSystemAttribute.AttributePlurality))</span>
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            else if (SyncRule.Direction == SyncRuleDirection.Export)
                            {
                                <MudSelect T="MetaverseAttribute" @bind-Value="_attributeFlowMappingSource.MetaverseAttribute"
                                    Label="@SyncRuleText.MetaverseAttributeLabel" Placeholder="@SyncRuleText.SelectSourceMetaverseAttribute" Required="true"
                                    Class="mt-5" Variant="Variant.Outlined" ToStringFunc="@MetaverseAttributeLabel">
                                    @foreach (var metaverseAttribute in SyncRule.MetaverseObjectType.Attributes)
                                    {
                                        <MudSelectItem Value="@metaverseAttribute">
                                            <div class="jim-flow-option">
                                                <span>@metaverseAttribute.Name <span
                                                    style="@($"color:{Colors.Gray.Darken1};")">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.AttributeTypeAndPlurality, AttributeFlowSectionSummaries.DataTypeName(metaverseAttribute.Type), AttributeFlowSectionSummaries.PluralityWords(metaverseAttribute.AttributePlurality))</span></span>
                                                <span class="jim-flow-option-spacer"></span>
                                                <StandardMappingHintLabel Hints="_standardMappingHints.ForAttribute(metaverseAttribute.Id)"
                                                                          ShowStandard="_standardMappingHints.HasMixedStandards" />
                                            </div>
                                        </MudSelectItem>
                                    }
                                </MudSelect>
                            }
                            break;
                        }
                        case "Expression":
                        <ExpressionEditor @ref="_expressionEditor" @bind-Value="_attributeFlowMappingSource.Expression"
                            @bind-Value:after="ScheduleFlowAnalysisAsync" Id="attribute-flow-expression"
                            Label="@SyncRuleText.ExpressionLabel" Placeholder="@(SyncRule.Direction == SyncRuleDirection.Export
                                ? SyncRuleText.ExpressionPlaceholderExport
                                : SyncRuleText.ExpressionPlaceholderImport)"
                            Required="true" SyntaxCheck="AttributeFlowExpressionCheck"
                            MetaverseAttributeNames="SuggestedMetaverseAttributeNames" ConnectedSystemAttributeNames="SuggestedConnectedSystemAttributeNames"
                            Class="mt-5" />

                        @* ─── Insert attribute (#1750, mockup B) and Insert function (#2053): put an accessor or a call at the caret ─── *@
                        <div class="mt-1">
                            <InsertFunctionMenu OnInsert="InsertIntoExpressionAsync" />
                            <InsertAttributeMenu MetaverseAttributes="InsertableMetaverseAttributes"
                                                 ConnectedSystemAttributes="InsertableConnectedSystemAttributes"
                                                 ConnectedSystemName="@SyncRule.ConnectedSystem?.Name"
                                                 TargetMetaverseAttributeId="_attributeFlowMapping.ResolveTargetMetaverseAttributeId()"
                                                 Direction="SyncRule.Direction"
                                                 OnInsert="InsertIntoExpressionAsync" />
                        </div>
                        @* ─── Derived Attribute Flow (#1750, mockups B and C): the live analysis of this flow ─── *@
                        <DerivedFlowPanel Analysis="_derivedFlowAnalysis" ConnectedSystemName="@SyncRule.ConnectedSystem?.Name" />

                        @* ─── Built from generated value (#2014, mock screen 1): which generated value, and the Keep unique switch ─── *@
                        <BuiltFromGeneratedValueBlock Description="@_builtFromGeneratedValue" Mapping="_attributeFlowMapping" />

                            @* Missing Input Behaviour (#1361): an Expression whose input is absent does not fail, it
                               produces a structurally broken value. Whether that matters is the administrator's call. *@
                            <SettingsSection @ref="_expressionMissingInputSection" Title="@SyncRuleText.MissingInputBehaviourTitle" Class="mt-5"
                                             Summary="@AttributeFlowSectionSummaries.MissingInput(_attributeFlowMappingSource.MissingInputBehaviour, generated: false)"
                                             Attention="@(_attributeFlowMappingSource.MissingInputBehaviour == MissingInputBehaviour.FailObject ? SyncRuleText.AttentionFailsWholeObject : null)">
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                                    @SyncRuleText.MissingInputIntro
                                </MudText>
                                <MudRadioGroup T="MissingInputBehaviour" @bind-Value="_attributeFlowMappingSource.MissingInputBehaviour">
                                    <MudStack Spacing="1">
                                        <MudRadio Value="MissingInputBehaviour.EvaluateAnyway" Color="Color.Primary">
                                            <MudText Typo="Typo.body1">@SyncRuleText.MissingInputEvaluateAnyway</MudText>
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                                @SyncRuleText.MissingInputEvaluateAnywayHint
                                            </MudText>
                                        </MudRadio>
                                        <MudRadio Value="MissingInputBehaviour.ContributeNoValue" Color="Color.Primary">
                                            <MudText Typo="Typo.body1">@SyncRuleText.MissingInputContributeNoValue</MudText>
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                                @SyncRuleText.MissingInputContributeNoValueHint
                                            </MudText>
                                        </MudRadio>
                                        <MudRadio Value="MissingInputBehaviour.FailMapping" Color="Color.Primary">
                                            <MudText Typo="Typo.body1">@SyncRuleText.MissingInputFailMapping</MudText>
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                                @SyncRuleText.MissingInputFailMappingHint
                                            </MudText>
                                        </MudRadio>
                                        <MudRadio Value="MissingInputBehaviour.FailObject" Color="Color.Primary">
                                            <MudText Typo="Typo.body1">@SyncRuleText.MissingInputFailObject</MudText>
                                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                                @SyncRuleText.MissingInputFailObjectHint
                                            </MudText>
                                        </MudRadio>
                                    </MudStack>
                                </MudRadioGroup>
                                @if (_attributeFlowMappingSource.MissingInputBehaviour == MissingInputBehaviour.FailObject)
                                {
                                    <MudAlert Severity="Severity.Warning" Class="mt-3">
                                        @SyncRuleText.MissingInputFailObjectWarning
                                    </MudAlert>
                                }
                            </SettingsSection>
                            break;

                        case "Generated":
                            @* A Generated Value whose target is chosen is laid out by its own editor, below; until then there
                               is nothing more to set here. *@
                            break;
                    }

                    @* User must have chosen the source attribute or entered an expression before being shown how the value is
                       handled; a generated mapping builds its own controls above (its base expression is optional), so it is
                       excluded here. *@
                    @if (_attributeFlowMappingSourceType != "Generated" &&
                        (_attributeFlowMappingSource.ConnectedSystemAttribute != null ||
                        _attributeFlowMappingSource.MetaverseAttribute != null ||
                        !string.IsNullOrWhiteSpace(_attributeFlowMappingSource.Expression)))
                    {
                        @* ─── Standard Mapping hint (#1122) ─── *@
                        var suggestions = GetStandardMappingSuggestions();
                        @if (suggestions.Count > 0)
                        {
                            var selectable = suggestions.Where(s => s.Status == StandardMappingSuggestionStatus.Available).ToList();
                            var unavailable = suggestions.Where(s => s.Status != StandardMappingSuggestionStatus.Available).ToList();

                            <MudAlert Severity="Severity.Info" Class="mt-5">
                                @if (selectable.Count > 0)
                                {
                                    @GetStandardMappingSuggestionText(selectable)
                                }
                                @foreach (var blocked in unavailable)
                                {
                                    <MudText Typo="Typo.body1" Class="@(selectable.Count > 0 ? "mt-2" : null)">
                                        @GetUnavailableCorrespondenceText(blocked, selectable.Count > 0)
                                    </MudText>
                                }
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                                    @SyncRuleText.StandardMappingsGuidance
                                </MudText>
                                @if (selectable.Count > 0)
                                {
                                    <div class="d-flex flex-wrap gap-2 mt-3">
                                        @foreach (var suggestion in selectable)
                                        {
                                            <AlertButton Severity="Severity.Info"
                                                OnClick="@(() => ApplyStandardMappingSuggestion(suggestion))">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.UseSuggestion, suggestion.TargetName)</AlertButton>
                                        }
                                    </div>
                                }
                            </MudAlert>
                        }

                        @if (SyncRule.Direction == SyncRuleDirection.Import)
                        {
                        @* ─── Attribute Priority context (#91, Surface 1: read-only; managed on the Object Type page) ─── *@
                        @* The target is captured by the pattern rather than dereferenced, so the markup never reads *@
                        @* through a nullable the analyser cannot see is guarded by the method above it. *@
                        @if (ShowAttributePriorityContext() && _attributeFlowMapping.TargetMetaverseAttribute is { } targetAttribute)
                        {
                            var alreadyContributes = MappingAlreadyContributesToSelectedAttribute();
                            var targetAccumulates = targetAttribute.ContributionMode == AttributeContributionMode.Accumulate;
                            <MudAlert Severity="Severity.Info" Class="mt-5">
                                @* An Accumulate attribute has no order (#3059); the list below says so itself. *@
                                @if (!targetAccumulates)
                                {
                                <MudText Typo="Typo.body1">
                                    @if (alreadyContributes)
                                    {
                                        @string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.MoreThanOneRuleContributes, targetAttribute.Name)
                                    }
                                    else
                                    {
                                        @string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.AttributeHasContributors, targetAttribute.Name)
                                    }
                                </MudText>
                                }
                                <div class="mt-3">
                                    <AttributePriorityList MetaverseObjectTypeId="SyncRule.MetaverseObjectTypeId"
                                                           MetaverseAttributeId="targetAttribute.Id"
                                                           MetaverseAttributeName="@targetAttribute.Name"
                                                           ReadOnly="true"
                                                           HighlightMappingId="@(alreadyContributes ? _attributeFlowMapping.Id : null)"
                                                           PendingContributorSystemName="@(alreadyContributes ? null : SyncRule.ConnectedSystem?.Name)"
                                                           PendingContributorNullIsValue="_attributeFlowMapping.NullIsValue" />
                                </div>
                                @if (!targetAccumulates)
                                {
                                <MudText Typo="Typo.body2" Class="mt-3">
                                    <MudLink Href="@($"/admin/schema/object-types/{SyncRule.MetaverseObjectTypeId}")" Target="_blank">
                                        @string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.ManagePriorityOnObjectType, SyncRule.MetaverseObjectType?.Name ?? SyncRuleText.MetaverseFallbackName)
                                    </MudLink>
                                </MudText>
                                }
                            </MudAlert>
                        }

                            @* ─── Value handling (#91, #843): what no value means, and how imported text is processed ─── *@
                            <SettingsSection Title="@SyncRuleText.ValueHandlingTitle" Class="mt-5"
                                             Summary="@AttributeFlowSectionSummaries.ValueHandling(_attributeFlowMapping, _attributeFlowMapping.TargetMetaverseAttribute?.Type == AttributeDataType.Text)"
                                             Attention="@(_attributeFlowMapping.NullIsValue ? SyncRuleText.AttentionBlankClears : null)">
                            @* ─── Null is a value (#91); no effect on an Accumulate target (#3059) ─── *@
                            <MudTooltip Arrow="true" Placement="Placement.Top" Inline="false"
                                        Disabled="@(!TargetAccumulates())" Text="@MetaverseAttributeText.NullIsValueAccumulateTooltip">
                                <MudCheckBox T="bool" Dense="true" Class="mt-5"
                                    @bind-Value="_attributeFlowMapping.NullIsValue"
                                    Disabled="@TargetAccumulates()"
                                    Label="@SyncRuleText.NullIsValueLabel" />
                            </MudTooltip>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @SyncRuleText.NullIsValueHelp
                            </MudText>
                            @if (_attributeFlowMapping.NullIsValue && !TargetAccumulates())
                            {
                                <MudAlert Severity="Severity.Warning" Class="mt-3">
                                    @SyncRuleText.NullIsValueWarning
                                </MudAlert>
                            }
                            @* ─── Inbound value processing (#843) ─── *@
                            @if (_attributeFlowMapping.TargetMetaverseAttribute?.Type == AttributeDataType.Text)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-5">@SyncRuleText.ValueProcessingTitle</MudText>
                                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
                                    @SyncRuleText.ValueProcessingHelp
                                </MudText>
                                <MudCheckBox T="bool" Dense="true"
                                    Value="HasProcessingFlag(InboundValueProcessing.TreatWhitespaceAsNoValue)"
                                    ValueChanged="@((bool v) => SetProcessingFlag(InboundValueProcessing.TreatWhitespaceAsNoValue, v))"
                                    Label="@SyncRuleText.TreatWhitespaceAsNoValue" />
                                <MudCheckBox T="bool" Dense="true"
                                    Value="HasProcessingFlag(InboundValueProcessing.TrimWhitespace)"
                                    ValueChanged="@((bool v) => SetProcessingFlag(InboundValueProcessing.TrimWhitespace, v))"
                                    Label="@SyncRuleText.TrimWhitespace" />
                                <MudTooltip Arrow="true" Placement="Placement.Top" Inline="false"
                                    Text="@SyncRuleText.CollapseWhitespaceTooltip">
                                    <MudCheckBox T="bool" Dense="true"
                                        Value="HasProcessingFlag(InboundValueProcessing.CollapseInternalWhitespace)"
                                        ValueChanged="@((bool v) => SetProcessingFlag(InboundValueProcessing.CollapseInternalWhitespace, v))"
                                        Label="@SyncRuleText.CollapseInternalWhitespace" />
                                </MudTooltip>
                                <MudSelect T="InboundCaseNormalisation" @bind-Value="_attributeFlowMapping.CaseNormalisation"
                                    Label="@SyncRuleText.CaseNormalisationLabel" Variant="Variant.Outlined" Class="mt-6">
                                    <MudSelectItem Value="InboundCaseNormalisation.None">@CommonText.None</MudSelectItem>
                                    <MudSelectItem Value="InboundCaseNormalisation.Upper">@SyncRuleText.CaseUpper</MudSelectItem>
                                    <MudSelectItem Value="InboundCaseNormalisation.Lower">@SyncRuleText.CaseLower</MudSelectItem>
                                    <MudSelectItem Value="InboundCaseNormalisation.Title">@SyncRuleText.CaseTitle</MudSelectItem>
                                </MudSelect>
                            }
                            </SettingsSection>
                        }
                        else if (SyncRule.Direction == SyncRuleDirection.Export)
                        {
                        @* ─── Exporting an Accumulate attribute (#3059): every kept value goes out ─── *@
                        @if (SourceAccumulates())
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-5">@MetaverseAttributeText.ExportAccumulateAdvisory</MudAlert>
                        }
                        @* ─── Initial Export Only (#223) ─── *@
                        <MudCheckBox T="bool" Dense="true" Class="mt-5"
                            @bind-Value="_attributeFlowMapping.InitialExportOnly"
                            Label="@SyncRuleText.InitialExportOnlyLabel" />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @SyncRuleText.InitialExportOnlyHelp
                        </MudText>
                        }

                        @* ─── Enabled (#1485): applies to both directions, so it sits outside the import/export branches ─── *@
                        <MudCheckBox T="bool" Dense="true" Class="mt-5"
                            @bind-Value="_attributeFlowMapping.Enabled"
                            @bind-Value:after="ScheduleFlowAnalysisAsync"
                            Label="@CommonText.Enabled" />
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @SyncRuleText.EnabledHelp
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(_attributeFlowMapping.DisabledReason))
                        {
                            var disabledReason = _attributeFlowMapping.DisabledReason;
                            <MudAlert Severity="Severity.Warning" Class="mt-2">
                                @disabledReason
                            </MudAlert>
                        }

                        @* ─── Multi-Valued to Single-Valued warning (#435) ─── *@
                        @if (DialogMappingIsMvaToSva())
                        {
                            <MudAlert Severity="Severity.Warning" Class="mt-5">
                                @GetMvaToSvaWarningText()
                            </MudAlert>
                        }
                    }
                }
            </Settings>
            <TryIt>
                @if (_attributeFlowMappingSourceType == "Expression" && _attributeFlowMapping != null && _attributeFlowMappingSource != null)
                {
                @* Expression tester (#1405): the Expression field is where an administrator finds out whether
                   their Expression does what they meant, and until now the answer only arrived from a
                   Synchronisation. ExpressionEditor raises every keystroke, which is what lets the tester follow
                   the text as it is typed. Given the Attribute Flow, it runs the flow as a Synchronisation would
                   (#2055): typed inputs, Missing Input Behaviour, value processing and conversion to the target. *@
                <ExpressionTester Expression="@_attributeFlowMappingSource.Expression" SyncRule="SyncRule"
                                  Mapping="_attributeFlowMapping" Source="_attributeFlowMappingSource"
                                  MissingInputBehaviourName="@AttributeFlowSectionSummaries.MissingInput(_attributeFlowMappingSource.MissingInputBehaviour, generated: false)"
                                  OnChangeMissingInputBehaviour="RevealExpressionMissingInputAsync" />
                }
                else if (_attributeFlowMappingSourceType == "Generated")
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@SyncRuleText.ChooseAttributeToTry</MudText>
                }
            </TryIt>
        </AttributeFlowEditorLayout>
        }
    </DialogContent>
    <DialogActions>
        <MudButton DropShadow="false"
            OnClick="@(() => _addAttributeFlowRuleDialogVisible = false)" Class="me-2">@CommonText.Cancel</MudButton>
        <MudButton Disabled="DisableAddAttributeFlowMappingButton()" DropShadow="false" Variant="Variant.Filled"
            Color="Color.Primary" OnClick="HandleAddAttributeFlowMappingButtonClick">@(_isEditingAttributeFlow ? SyncRuleText.UpdateAttributeFlowButton : SyncRuleText.AddAttributeFlowButton)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public SyncRule SyncRule { get; set; } = null!;

    /// <summary>
    /// The page-owned accumulator for the recall-or-keep choices of this edit session's staged mapping
    /// removals (#1537). Every removal of a persisted mapping records an entry here (keep false for recall,
    /// including removals where no choice was offered because the mapping contributed nothing), so the save
    /// deletes each named mapping properly rather than leaving it to the legacy orphaning path. The page
    /// passes the collection into the rule save and owns clearing it (after a successful save, or a reload).
    /// </summary>
    [Parameter]
    public IList<SyncRuleMappingRemovalChoice> MappingRemovalChoices { get; set; } = [];

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool _addAttributeFlowRuleDialogVisible;

    // Set when the Exchange recipients panel opened the dialog for one attribute: the target is chosen and stays fixed,
    // since the panel's row is that attribute. The ordinary Add and Edit clear it.
    private bool _targetFixedByExchangePanel;

    private string? ExchangePanelTargetHelperText => _targetFixedByExchangePanel ? SyncRuleText.ChosenByExchangeRecipients : null;
    // Medium rather than the default Small: the dialog carries the attribute priority list (#91 Surface 1), whose
    // Connected System and Synchronisation Rule names wrap onto three lines each at 600px and are unreadable.
    private static readonly DialogOptions NarrowDialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Medium };
    private static readonly DialogOptions WideDialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.ExtraLarge };

    /// <summary>
    /// Whether the source has anything to try (#2471): an Expression or a Generated Value. An Attribute copies its value
    /// as it is, so its dialog keeps one column at the narrower width.
    /// </summary>
    private bool DialogHasTryIt => _attributeFlowMappingSourceType is "Expression" or "Generated";

    private DialogOptions DialogOptions => DialogHasTryIt ? WideDialogOptions : NarrowDialogOptions;

    private SettingsSection? _expressionMissingInputSection;

    /// <summary>A Generated Value's target attribute type, by direction; null until one is chosen.</summary>
    /// <summary>Whether the import mapping being edited targets an Accumulate attribute (#3059).</summary>
    private bool TargetAccumulates() =>
        _attributeFlowMapping?.TargetMetaverseAttribute?.ContributionMode == AttributeContributionMode.Accumulate;

    /// <summary>Whether the export mapping being edited reads an Accumulate attribute (#3059).</summary>
    private bool SourceAccumulates() =>
        _attributeFlowMapping?.Sources.Any(source => source.MetaverseAttribute?.ContributionMode == AttributeContributionMode.Accumulate) == true;

    private AttributeDataType? GeneratedTargetType => SyncRule.Direction == SyncRuleDirection.Import
        ? _attributeFlowMapping?.TargetMetaverseAttribute?.Type
        : _attributeFlowMapping?.TargetConnectedSystemAttribute?.Type;

    private string? GeneratedTargetName => SyncRule.Direction == SyncRuleDirection.Import
        ? _attributeFlowMapping?.TargetMetaverseAttribute?.Name
        : _attributeFlowMapping?.TargetConnectedSystemAttribute?.Name;

    /// <summary>
    /// What flows where (#2471): the source type and the attribute it flows to, side by side, ahead of how the value is
    /// worked out. Choosing the target first lets the Try it pane test the whole Attribute Flow from the start.
    /// </summary>
    private RenderFragment DialogHeader => __builder =>
    {
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6">
            <MudSelect T="string" Label="@SyncRuleText.SourceTypeLabel" Placeholder="@SyncRuleText.SelectSourceType"
                Required="true" Value="_attributeFlowMappingSourceType" ValueChanged="HandleSourceTypeChanged" Variant="Variant.Outlined"
                ToStringFunc="@SourceTypeLabel">
                <MudSelectItem Value="@("Attribute")">
                    <div>@SyncRuleText.SourceTypeAttribute</div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@SyncRuleText.SourceTypeAttributeHelp</MudText>
                </MudSelectItem>
                <MudSelectItem Value="@("Expression")">
                    <div>@SyncRuleText.SourceTypeExpression</div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@SyncRuleText.SourceTypeExpressionHelp</MudText>
                </MudSelectItem>
                <MudSelectItem Value="@("Generated")">
                    <div>@SyncRuleText.SourceTypeGenerated</div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@SyncRuleText.SourceTypeGeneratedHelp</MudText>
                </MudSelectItem>
            </MudSelect>
            </MudItem>
            @if (_attributeFlowMapping != null && _attributeFlowMappingSource != null && SyncRule.MetaverseObjectType != null
                 && !string.IsNullOrEmpty(_attributeFlowMappingSourceType))
            {
                <MudItem xs="12" sm="6">
                    @if (_attributeFlowMappingSourceType == "Generated")
                    {
                        @if (SyncRule.Direction == SyncRuleDirection.Import)
                        {
                            <MudSelect T="MetaverseAttribute" Value="_attributeFlowMapping.TargetMetaverseAttribute" ValueChanged="OnGeneratedMetaverseTargetChanged"
                                Label="@SyncRuleText.AssignValueTo" Placeholder="@SyncRuleText.SelectTargetMetaverseAttribute" Required="true"
                                Variant="Variant.Outlined" ToStringFunc="@MetaverseAttributeLabel">
                                @foreach (var metaverseAttribute in AvailableTargetMetaverseAttributes())
                                {
                                    var disabledReason = GeneratedValueFormHelpers.GetGeneratedTargetDisabledReason(metaverseAttribute.Type, metaverseAttribute.AttributePlurality);
                                    <MudSelectItem Disabled="@(disabledReason != null)" Value="@metaverseAttribute">
                                        <div class="jim-flow-option">
                                            <span>@metaverseAttribute.Name <span style="@($"color:{Colors.Gray.Darken1};")">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.AttributeTypeAndPlurality, AttributeFlowSectionSummaries.DataTypeName(metaverseAttribute.Type), AttributeFlowSectionSummaries.PluralityWords(metaverseAttribute.AttributePlurality))</span></span>
                                            @if (disabledReason != null)
                                            {
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@disabledReason</MudText>
                                            }
                                        </div>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }
                        else if (SyncRule.Direction == SyncRuleDirection.Export)
                        {
                            <MudSelect T="ConnectedSystemObjectTypeAttribute" Value="_attributeFlowMapping.TargetConnectedSystemAttribute" ValueChanged="OnGeneratedConnectedSystemTargetChanged"
                                Label="@SyncRuleText.AssignValueTo" Placeholder="@SyncRuleText.SelectTargetConnectedSystemAttribute" Required="true"
                                Disabled="_targetFixedByExchangePanel" HelperText="@ExchangePanelTargetHelperText"
                                Variant="Variant.Outlined" ToStringFunc="@ConnectedSystemAttributeLabel">
                                @foreach (var connectedSystemAttribute in AvailableTargetConnectedSystemAttributes())
                                {
                                    var disabledReason = connectedSystemAttribute.Writability == AttributeWritability.ReadOnly
                                        ? SyncRuleText.ReadOnlyTargetReason
                                        : GeneratedValueFormHelpers.GetGeneratedTargetDisabledReason(connectedSystemAttribute.Type, connectedSystemAttribute.AttributePlurality);
                                    <MudSelectItem Disabled="@(disabledReason != null)" Value="@connectedSystemAttribute">
                                        <div class="jim-flow-option">
                                            <span>@connectedSystemAttribute.Name <span style="@($"color:{Colors.Gray.Darken1};")">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.AttributeTypeAndPlurality, AttributeFlowSectionSummaries.DataTypeName(connectedSystemAttribute.Type), AttributeFlowSectionSummaries.PluralityWords(connectedSystemAttribute.AttributePlurality))</span></span>
                                            <ConnectorDefinedChip Attribute="@connectedSystemAttribute" ConnectorName="@ConnectorName" />
                                            @if (disabledReason != null)
                                            {
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@disabledReason</MudText>
                                            }
                                        </div>
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        }
                    }
                    else if (SyncRule.Direction == SyncRuleDirection.Import)
                    {
                        var targetSuggestions = GetStandardMappingSuggestions();
                        <MudSelect T="MetaverseAttribute" @bind-Value="_attributeFlowMapping.TargetMetaverseAttribute"
                            @bind-Value:after="ScheduleFlowAnalysisAsync"
                            Label="@SyncRuleText.AssignValueTo" Placeholder="@SyncRuleText.SelectTargetMetaverseAttribute" Required="true"
                            Variant="Variant.Outlined" ToStringFunc="@MetaverseAttributeLabel">
                            @foreach (var metaverseAttribute in AvailableTargetMetaverseAttributes())
                            {
                                <MudSelectItem Disabled="IsAttributeFlowTargetDisabled(metaverseAttribute)" Value="@metaverseAttribute">
                                    <div class="jim-flow-option">
                                        <span>@metaverseAttribute.Name <span style="@($"color:{Colors.Gray.Darken1};")">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.AttributeTypeAndPlurality, AttributeFlowSectionSummaries.DataTypeName(metaverseAttribute.Type), AttributeFlowSectionSummaries.PluralityWords(metaverseAttribute.AttributePlurality))</span></span>
                                        @if (IsSuggested(targetSuggestions, metaverseAttribute))
                                        {
                                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@SyncRuleText.Suggested</MudChip>
                                        }
                                        <span class="jim-flow-option-spacer"></span>
                                        <StandardMappingHintLabel Hints="_standardMappingHints.ForAttribute(metaverseAttribute.Id)"
                                                                 Emphasised="IsSuggested(targetSuggestions, metaverseAttribute)"
                                                                 ShowStandard="_standardMappingHints.HasMixedStandards" />
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else if (SyncRule.Direction == SyncRuleDirection.Export)
                    {
                        var targetSuggestions = GetStandardMappingSuggestions();
                        <MudSelect T="ConnectedSystemObjectTypeAttribute"
                            @bind-Value="_attributeFlowMapping.TargetConnectedSystemAttribute" @bind-Value:after="ScheduleFlowAnalysisAsync" Label="@SyncRuleText.AssignValueTo"
                            Placeholder="@SyncRuleText.SelectTargetConnectedSystemAttribute" Required="true"
                            Disabled="_targetFixedByExchangePanel" HelperText="@ExchangePanelTargetHelperText"
                            Variant="Variant.Outlined" ToStringFunc="@ConnectedSystemAttributeLabel">
                            @foreach (var connectedSystemAttribute in AvailableTargetConnectedSystemAttributes())
                            {
                                <MudSelectItem Disabled="IsAttributeFlowTargetDisabled(connectedSystemAttribute)"
                                    Value="@connectedSystemAttribute">
                                    <div class="jim-flow-option">
                                        <span>@connectedSystemAttribute.Name <span
                                            style="@($"color:{Colors.Gray.Darken1};")">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.AttributeTypeAndPlurality, AttributeFlowSectionSummaries.DataTypeName(connectedSystemAttribute.Type), AttributeFlowSectionSummaries.PluralityWords(connectedSystemAttribute.AttributePlurality))</span></span>
                                        <ConnectorDefinedChip Attribute="@connectedSystemAttribute" ConnectorName="@ConnectorName" />
                                        @if (IsSuggested(targetSuggestions, connectedSystemAttribute))
                                        {
                                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">@SyncRuleText.Suggested</MudChip>
                                        }
                                        <span class="jim-flow-option-spacer"></span>
                                    </div>
                                </MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>
            }
        </MudGrid>
    };

    /// <summary>The foot of a Generated Value's settings: Enabled (#1485), which applies to it as to any other flow.</summary>
    // Rendered only while the Generated Value editor is, which needs a mapping, so the mapping is set here.
    private RenderFragment GeneratedSettingsFooter => __builder =>
    {
        <MudCheckBox T="bool" Dense="true" Class="mt-5" @bind-Value="_attributeFlowMapping!.Enabled"
            @bind-Value:after="ScheduleFlowAnalysisAsync" Label="@CommonText.Enabled" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            @SyncRuleText.EnabledHelpShort
        </MudText>
    };

    private Task RevealExpressionMissingInputAsync() =>
        _expressionMissingInputSection?.OpenAndRevealAsync() ?? Task.CompletedTask;

    // ─── Attribute Priority context (#91 Surface 1) ───

    /// <summary>Import contributor count per Metaverse attribute, so the dialog knows when priority is in play.</summary>
    private Dictionary<int, int> _attributeContributorCounts = new();

    /// <summary>The target this mapping had when the dialog opened; null for a new mapping.</summary>
    private int? _originalTargetMetaverseAttributeId;

    /// <summary>
    /// Loads the per-attribute import contributor counts for this rule's Metaverse Object Type. One aggregate,
    /// refreshed each time the dialog opens so it reflects mappings other rules have gained since the page loaded.
    /// Import rules only; priority is an inbound concern.
    /// </summary>
    private async Task LoadAttributeContributorCountsAsync()
    {
        if (SyncRule.Direction != SyncRuleDirection.Import || SyncRule.MetaverseObjectTypeId <= 0)
        {
            _attributeContributorCounts = new Dictionary<int, int>();
            return;
        }

        using var jim = JimFactory.Create();
        _attributeContributorCounts = await jim.ConnectedSystems.GetAttributeContributorCountsAsync(SyncRule.MetaverseObjectTypeId);
    }

    /// <summary>
    /// Whether the mapping being edited is already a persisted contributor to the attribute currently selected.
    /// False for a new mapping, and false once an existing mapping is retargeted, because it is then arriving at a
    /// list it is not yet part of.
    /// </summary>
    private bool MappingAlreadyContributesToSelectedAttribute()
    {
        var selected = _attributeFlowMapping?.TargetMetaverseAttribute?.Id;
        return _isEditingAttributeFlow && selected.HasValue && _originalTargetMetaverseAttributeId == selected.Value;
    }

    /// <summary>
    /// Whether to show the read-only priority context for the selected target attribute. It earns its space only
    /// when priority actually decides something: another Synchronisation Rule already contributes to the attribute.
    /// A mapping that is itself one of the counted contributors does not count towards that.
    /// </summary>
    private bool ShowAttributePriorityContext()
    {
        if (SyncRule.Direction != SyncRuleDirection.Import)
            return false;

        var selected = _attributeFlowMapping?.TargetMetaverseAttribute?.Id;
        if (!selected.HasValue)
            return false;

        var contributors = _attributeContributorCounts.GetValueOrDefault(selected.Value);
        return MappingAlreadyContributesToSelectedAttribute() ? contributors > 1 : contributors > 0;
    }
    private SyncRuleMapping? _attributeFlowMapping;
    private IReadOnlyCollection<AttributeFlowMappingType> _selectedMappingTypes = new List<AttributeFlowMappingType>();
    private IReadOnlyCollection<AttributeDataType> _selectedDataTypes = new List<AttributeDataType>();
    private IReadOnlyCollection<AttributePlurality> _selectedPluralities = new List<AttributePlurality>();
    private SyncRuleMappingSource? _attributeFlowMappingSource;
    private string? _attributeFlowMappingSourceType;
    private bool _isEditingAttributeFlow;
    private VirtualisedDataGrid<SyncRuleMapping>? _flowGrid;

    /// <summary>
    /// The Source Type picker's label for each value, so the selected value always reads as its label (for example
    /// "Generated Value"), even before the picker's items have rendered.
    /// </summary>
    private static string SourceTypeLabel(string? sourceType) => sourceType switch
    {
        "Attribute" => SyncRuleText.SourceTypeAttribute,
        "Expression" => SyncRuleText.SourceTypeExpression,
        "Generated" => SyncRuleText.SourceTypeGenerated,
        null => string.Empty,
        _ => sourceType
    };

    // Advisory Standard Mapping hints for the dialog's attribute pickers (#1122). Loaded when the dialog opens
    // and cached for as long as the rule keeps pointing at the same Connected System and Metaverse Object Type.
    private StandardMappingHints _standardMappingHints = StandardMappingHints.Empty;
    private (int ConnectedSystemId, int MetaverseObjectTypeId)? _loadedStandardMappingHintsKey;

    // Tooltip for the Multi-Valued to Single-Valued indicator in the Attribute Flow list (#435).
    private static string MvaToSvaIndicatorTooltip => SyncRuleText.MvaToSvaIndicatorTooltip;

    // ─── Metaverse-Derived Attribute Flows (#1750, Phase 6) ───

    /// <summary>
    /// The step facts of the rule's saved derived flows, keyed by mapping id, for the Derived chips. Loaded once with
    /// the rule and refreshed after each change this tab stages and after the page saves, never per row.
    /// </summary>
    private IReadOnlyDictionary<int, DerivedFlowStepInfo> _derivedFlowSteps = new Dictionary<int, DerivedFlowStepInfo>();

    /// <summary>
    /// The latest analysis of the flow open in the dialog; null until one answers, and for anything that is not an
    /// import expression or generated flow with a target.
    /// </summary>
    private DerivedFlowAnalysis? _derivedFlowAnalysis;

    /// <summary>
    /// Debounces the dialog's analysis to one request per pause in typing, and lets only the newest answer.
    /// </summary>
    private readonly LatestRequestGate _derivedFlowAnalysisGate = new(TimeSpan.FromMilliseconds(300));

    /// <summary>
    /// What the flow open in the dialog is built from (Generated Value Forms, #2014); null for a flow built from no
    /// generated value, and until the first answer.
    /// </summary>
    private GeneratedValueBuiltValueDescription? _builtFromGeneratedValue;

    /// <summary>Debounces <see cref="ScheduleBuiltFromGeneratedValueAsync"/> as <see cref="_derivedFlowAnalysisGate"/> does the analysis.</summary>
    private readonly LatestRequestGate _builtFromGeneratedValueGate = new(TimeSpan.FromMilliseconds(300));

    /// <summary>
    /// The flow as the edit dialog opened it (the dialog edits in place), for the dependants check on Update. Null
    /// while adding a flow: adding only ever contributes.
    /// </summary>
    private AttributeFlowEditBaseline? _editBaseline;

    private ExpressionEditor? _expressionEditor;

    // ─── Password delivery and userAccountControl (#2159) ───

    /// <summary>
    /// What the note on a userAccountControl Attribute Flow says, wherever passwords are delivered to this rule's
    /// accounts (<see cref="AccountControlFlowNotes.ShowsPasswordDeliveryNote"/>).
    /// </summary>
    private static string PasswordDeliveryNote => SyncRuleText.PasswordDeliveryNote;

    /// <summary>
    /// Whether this rule's Connected System is configured for Password Synchronisation, so that passwords reach its
    /// accounts other than as an Initial Password. Read once per Connected System, not per row.
    /// </summary>
    private bool _passwordSynchronisationConfigured;
    private int? _passwordSynchronisationReadForConnectedSystemId;

    protected override async Task OnParametersSetAsync()
    {
        if (SyncRule.Direction != SyncRuleDirection.Export || SyncRule.ConnectedSystemId <= 0 ||
            _passwordSynchronisationReadForConnectedSystemId == SyncRule.ConnectedSystemId)
            return;

        _passwordSynchronisationReadForConnectedSystemId = SyncRule.ConnectedSystemId;
        using var jim = JimFactory.Create();
        _passwordSynchronisationConfigured = await jim.ConnectedSystems.GetPasswordSynchronisationAsync(SyncRule.ConnectedSystemId) != null;
        // The Connector's name, for the Connector-defined chip's explanation (#2756). Read from the header here rather
        // than by widening the rule's own query, which does not load the Connector.
        ConnectorName = (await jim.ConnectedSystems.GetConnectedSystemHeaderAsync(SyncRule.ConnectedSystemId))?.ConnectorName;
    }

    /// <summary>
    /// The name of the Connector the rule's Connected System uses, read with the export facts above; null for an import
    /// rule, which offers no Connected System attribute as a target.
    /// </summary>
    private string? ConnectorName { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadDerivedFlowStepsAsync();
        await LoadRetiredValueCountsAsync();
    }

    /// <summary>
    /// Reloads the per-row facts read from the database (the Derived chips' step facts and the retired values
    /// counts), for the page to call after it saves the rule: a flow added in this edit session has no id, and so no
    /// chip, until then, and removing a generated flow retires its values.
    /// </summary>
    public async Task RefreshDerivedFlowStepsAsync()
    {
        await LoadDerivedFlowStepsAsync();
        await LoadRetiredValueCountsAsync();
        await InvokeAsync(StateHasChanged);
    }

    // ─── Retired values register (Unique Value Generation, #242, Phase 6) ───

    /// <summary>
    /// The retired values register's size per generated row's target attribute, keyed by (is Metaverse, attribute
    /// id). Read once for every generated row together, and again after a save or a Start again; never per row.
    /// </summary>
    private Dictionary<(bool IsMetaverse, int AttributeId), int> _retiredValueCounts = new();

    private async Task LoadRetiredValueCountsAsync()
    {
        var generated = SyncRule.AttributeFlowRules.Where(m => m.Generation != null).ToList();
        var metaverseAttributeIds = generated
            .Where(m => m.TargetMetaverseAttributeId.HasValue)
            .Select(m => m.TargetMetaverseAttributeId!.Value)
            .Distinct()
            .ToList();
        var connectedSystemAttributeIds = generated
            .Where(m => m.TargetConnectedSystemAttributeId.HasValue)
            .Select(m => m.TargetConnectedSystemAttributeId!.Value)
            .Distinct()
            .ToList();

        // A rule with no generated flows has nothing to count, so it reads nothing.
        if (metaverseAttributeIds.Count == 0 && connectedSystemAttributeIds.Count == 0)
        {
            _retiredValueCounts = new();
            return;
        }

        using var jim = JimFactory.Create();
        var counts = await jim.UniqueValues.GetRetiredValueCountsAsync(metaverseAttributeIds, connectedSystemAttributeIds);
        _retiredValueCounts = counts.ToDictionary(
            c => (c.MetaverseAttributeId.HasValue, c.MetaverseAttributeId ?? c.ConnectedSystemObjectTypeAttributeId ?? 0),
            c => c.Count);
    }

    /// <summary>How many retired values the register holds for a generated row's target attribute; zero otherwise.</summary>
    private int RetiredValueCountFor(SyncRuleMapping mapping)
    {
        if (mapping.Generation == null)
            return 0;

        if (mapping.TargetMetaverseAttributeId is { } metaverseAttributeId)
            return _retiredValueCounts.GetValueOrDefault((true, metaverseAttributeId));

        return mapping.TargetConnectedSystemAttributeId is { } connectedSystemAttributeId
            ? _retiredValueCounts.GetValueOrDefault((false, connectedSystemAttributeId))
            : 0;
    }

    /// <summary>"View retired values" is on every generated row with a target, whether or not any are retired yet.</summary>
    private static bool ShowViewRetiredValuesAction(SyncRuleMapping mapping) =>
        mapping.Generation != null && (mapping.TargetMetaverseAttributeId.HasValue || mapping.TargetConnectedSystemAttributeId.HasValue);

    private static string ViewRetiredValuesTooltip(int count) =>
        count > 0
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.ViewRetiredValuesWithCount, count)
            : SyncRuleText.ViewRetiredValues;

    private static string RetiredChipTooltip(int count, string attributeName) =>
        string.Format(
            System.Globalization.CultureInfo.CurrentCulture,
            PluralRules.Choose(count, SyncRuleText.RetiredChipTooltipOne, SyncRuleText.RetiredChipTooltipOther),
            count,
            attributeName);

    private static string TargetName(SyncRuleMapping mapping) =>
        mapping.TargetMetaverseAttribute?.Name ?? mapping.TargetConnectedSystemAttribute?.Name ?? string.Empty;

    private async Task HandleViewRetiredValuesClickAsync(SyncRuleMapping mapping)
    {
        await RetiredGeneratedValuesDialog.ShowAsync(
            DialogService, TargetName(mapping), mapping.TargetMetaverseAttributeId,
            mapping.TargetMetaverseAttributeId.HasValue ? null : mapping.TargetConnectedSystemAttributeId,
            RetiredValueCountFor(mapping));
    }

    private async Task LoadDerivedFlowStepsAsync()
    {
        if (SyncRule.Direction != SyncRuleDirection.Import)
        {
            _derivedFlowSteps = new Dictionary<int, DerivedFlowStepInfo>();
            return;
        }

        using var jim = JimFactory.Create();
        _derivedFlowSteps = await jim.ConnectedSystems.GetDerivedFlowStepsAsync(SyncRule);
    }

    /// <summary>
    /// A flow's Derived chip facts; null for an ordinary flow or an unsaved one.
    /// </summary>
    private DerivedFlowStepInfo? DerivedStepInfoFor(SyncRuleMapping mapping) =>
        mapping.Id > 0 && _derivedFlowSteps.TryGetValue(mapping.Id, out var stepInfo) ? stepInfo : null;

    /// <summary>
    /// The Metaverse attributes the Insert attribute menu offers as <c>mv["..."]</c>: always on an export rule, whose
    /// expressions are evaluated against the Metaverse Object (long before derived flows existed), and on an import
    /// rule, where an expression reading the Metaverse is a derived flow.
    /// </summary>
    private IEnumerable<MetaverseAttribute>? InsertableMetaverseAttributes =>
        SyncRule.MetaverseObjectType?.Attributes;

    /// <summary>
    /// The Connected System attributes the Insert attribute menu offers as <c>cs["..."]</c>: on an import rule only. An
    /// export expression is evaluated against the Metaverse Object alone, so <c>cs["..."]</c> resolves to nothing
    /// there. Null leaves the group out.
    /// </summary>
    private IEnumerable<ConnectedSystemObjectTypeAttribute>? InsertableConnectedSystemAttributes =>
        SyncRule.Direction == SyncRuleDirection.Import ? SyncRule.ConnectedSystemObjectType?.Attributes : null;

    /// <summary>
    /// The names the expression editors suggest inside <c>mv["</c> (#2053): the attributes Insert attribute offers.
    /// </summary>
    private IReadOnlyCollection<string> SuggestedMetaverseAttributeNames =>
        InsertableMetaverseAttributes?.Select(candidate => candidate.Name).Order(StringComparer.OrdinalIgnoreCase).ToList() ?? [];

    /// <summary>
    /// The names the expression editors suggest inside <c>cs["</c> (#2053): as Insert attribute, never a credential
    /// attribute, since those travel through JIM's password channel rather than Attribute Flow.
    /// </summary>
    private IReadOnlyCollection<string> SuggestedConnectedSystemAttributeNames =>
        InsertableConnectedSystemAttributes?.Where(candidate => !CredentialAttributes.IsCredentialAttribute(candidate.Name))
            .Select(candidate => candidate.Name).Order(StringComparer.OrdinalIgnoreCase).ToList() ?? [];

    private Task InsertIntoExpressionAsync(string accessor) =>
        _expressionEditor?.InsertAtCursorAsync(accessor) ?? Task.CompletedTask;

    /// <summary>
    /// Whether the flow open in the dialog is one the derived flow analysis answers for: an import Expression or
    /// Generated flow with a target.
    /// </summary>
    private bool CanAnalyseDerivedFlow() =>
        _addAttributeFlowRuleDialogVisible &&
        SyncRule.Direction == SyncRuleDirection.Import &&
        _attributeFlowMappingSourceType is "Expression" or "Generated" &&
        _attributeFlowMapping?.ResolveTargetMetaverseAttributeId() != null;

    /// <summary>
    /// Re-analyses the flow open in the dialog against every import rule of the Metaverse Object Type (#1750): whether
    /// it is derived, its step, the loop or other error the save would refuse with, and its warnings. Read only, and
    /// debounced, so typing sends one request per pause; only the newest answer is shown. The mapping is sent as a
    /// detached snapshot, because the analysis reads it after awaiting the database.
    /// </summary>
    private async Task ScheduleDerivedFlowAnalysisAsync()
    {
        if (!CanAnalyseDerivedFlow())
        {
            _derivedFlowAnalysis = null;
            return;
        }

        var proposal = AttributeFlowEditBaseline.Snapshot(_attributeFlowMapping!);
        await _derivedFlowAnalysisGate.RunAsync(async _ =>
        {
            using var jim = JimFactory.Create();
            return await jim.ConnectedSystems.AnalyseDerivedFlowAsync(SyncRule, proposal);
        }, analysis => _derivedFlowAnalysis = analysis);
    }

    /// <summary>
    /// Re-analyses the flow open in the dialog after anything it depends on changes: the derived flow analysis (#1750)
    /// and what the flow is built from (Generated Value Forms, #2014).
    /// </summary>
    private Task ScheduleFlowAnalysisAsync() =>
        Task.WhenAll(ScheduleDerivedFlowAnalysisAsync(), ScheduleBuiltFromGeneratedValueAsync());

    /// <summary>
    /// Whether the flow open in the dialog can be built from a generated value: an Expression flow, import or export,
    /// with an expression and a target.
    /// </summary>
    private bool CanDescribeBuiltFromGeneratedValue() =>
        _addAttributeFlowRuleDialogVisible &&
        _attributeFlowMappingSourceType == "Expression" &&
        !string.IsNullOrWhiteSpace(_attributeFlowMappingSource?.Expression) &&
        (_attributeFlowMapping?.ResolveTargetMetaverseAttributeId() != null || _attributeFlowMapping?.ResolveTargetConnectedSystemAttributeId() != null);

    /// <summary>
    /// Works out which generated value, if any, the flow open in the dialog builds its value from (#2014), against the
    /// Synchronisation Rule as it is being edited and every other rule as saved, for the "Built from generated value"
    /// block. Debounced like the derived flow analysis, and sent a detached snapshot for the same reason.
    /// </summary>
    private async Task ScheduleBuiltFromGeneratedValueAsync()
    {
        if (!CanDescribeBuiltFromGeneratedValue())
        {
            _builtFromGeneratedValue = null;
            return;
        }

        var proposal = AttributeFlowEditBaseline.Snapshot(_attributeFlowMapping!);
        await _builtFromGeneratedValueGate.RunAsync(async _ =>
        {
            using var jim = JimFactory.Create();
            return await jim.ConnectedSystems.DescribeBuiltFromGeneratedValueAsync(SyncRule, proposal);
        }, described => _builtFromGeneratedValue = described);
    }

    public void Dispose()
    {
        _derivedFlowAnalysisGate.Dispose();
        _builtFromGeneratedValueGate.Dispose();
    }

    private bool DisableAddAttributeFlowButton()
    {
        if (SyncRule.MetaverseObjectType == null)
            return true;

        if (SyncRule.ConnectedSystemObjectType == null)
            return true;

        return false;
    }

    private async Task HandleOpenAddAttributeFlowRuleDialogAsync()
    {
        _targetFixedByExchangePanel = false;
        _attributeFlowMapping = new SyncRuleMapping();
        _attributeFlowMappingSource = new SyncRuleMappingSource();
        _attributeFlowMapping.Sources.Add(_attributeFlowMappingSource);
        _attributeFlowMappingSourceType = null;
        _isEditingAttributeFlow = false;
        _originalTargetMetaverseAttributeId = null;
        _editBaseline = null;
        _derivedFlowAnalysis = null;
        _builtFromGeneratedValue = null;
        await LoadStandardMappingHintsAsync();
        await LoadAttributeContributorCountsAsync();
        _addAttributeFlowRuleDialogVisible = true;
    }

    private async Task HandleEditAttributeFlowRuleAsync(SyncRuleMapping mapping)
    {
        await LoadStandardMappingHintsAsync();
        await LoadAttributeContributorCountsAsync();
        _editBaseline = AttributeFlowEditBaseline.Capture(mapping);
        _derivedFlowAnalysis = null;
        _builtFromGeneratedValue = null;
        HandleEditAttributeFlowRule(mapping);
        await ScheduleFlowAnalysisAsync();
    }

    private void HandleEditAttributeFlowRule(SyncRuleMapping mapping)
    {
        _targetFixedByExchangePanel = false;
        _attributeFlowMapping = mapping;

        // Remember what this mapping targeted when the dialog opened. The priority context has to distinguish a
        // mapping that already sits in the attribute's list from one arriving at it, and the picker below mutates
        // the mapping in place, so the persisted target is unrecoverable from the mapping itself once it changes.
        _originalTargetMetaverseAttributeId = mapping.TargetMetaverseAttribute?.Id ?? mapping.TargetMetaverseAttributeId;

        // A generated mapping's base expression is optional (Sequence and Random tokens need none), so a
        // persisted generated mapping with no base expression has an empty Sources list; a transient source is
        // created here to hold the (empty) expression text and Missing Input Behaviour, and GeneratedValueOptionsEditor
        // adds it to Sources once the administrator types one.
        _attributeFlowMappingSource = mapping.Sources.FirstOrDefault() ?? new SyncRuleMappingSource();

        var sourceType = mapping.GetSourceType();
        _attributeFlowMappingSourceType = sourceType switch
        {
            SyncRuleMappingSourcesType.ExpressionMapping => "Expression",
            SyncRuleMappingSourcesType.AttributeMapping => "Attribute",
            SyncRuleMappingSourcesType.AdvancedMapping => "Advanced",
            // Unique Value Generation (#242): the label a Generated mapping's source type resolves to.
            // The dialog itself gains no "Generated" form until Phase 3; this only stops an existing
            // Generated mapping's edit from silently losing its source type selection.
            SyncRuleMappingSourcesType.GeneratedMapping => "Generated",
            _ => null
        };

        _isEditingAttributeFlow = true;
        _addAttributeFlowRuleDialogVisible = true;
    }

    private async Task HandleSourceTypeChanged(string newSourceType)
    {
        _attributeFlowMappingSourceType = newSourceType;
        if (_attributeFlowMapping == null || _attributeFlowMappingSource == null) return;

        // Clear previous source data when switching types
        _attributeFlowMappingSource.ConnectedSystemAttribute = null;
        _attributeFlowMappingSource.MetaverseAttribute = null;
        _attributeFlowMappingSource.Expression = null;
        _attributeFlowMapping.Sources.Remove(_attributeFlowMappingSource);

        // ─── Unique Value Generation (#242, Phase 3) ───
        // Selecting "Generated Value" creates the settings row with model defaults; switching away removes it.
        // The source is left out of Sources here (a generated mapping's base expression is optional, and an
        // empty source in the list would otherwise be misread by SyncRuleMappingGenerationValidator as an
        // attribute source with no value); GeneratedValueOptionsEditor adds it once the expression holds text.
        if (newSourceType == "Generated")
        {
            _attributeFlowMapping.Generation = new SyncRuleMappingGeneration();
            // "Wait until every input has a value" is the generated-value default; a plain Expression mapping
            // keeps its own default of "Evaluate anyway".
            _attributeFlowMappingSource.MissingInputBehaviour = GeneratedValueFormHelpers.DefaultMissingInputBehaviourForGeneratedMapping;
        }
        else
        {
            _attributeFlowMapping.Generation = null;
            _attributeFlowMappingSource.MissingInputBehaviour = MissingInputBehaviour.EvaluateAnyway;
            _attributeFlowMapping.Sources.Add(_attributeFlowMappingSource);
        }

        await ScheduleFlowAnalysisAsync();
    }

    /// <summary>
    /// The generated mapping's Metaverse target picker (import direction). Explicit rather than
    /// <c>@bind-Value</c> so a target that rules out the currently-chosen uniqueness token (a Number target
    /// while "Only if taken" is selected) can correct it, rather than leaving the dialog open on a radio that
    /// is now disabled and a Save button the administrator cannot see a way to enable.
    /// </summary>
    private async Task OnGeneratedMetaverseTargetChanged(MetaverseAttribute? target)
    {
        if (_attributeFlowMapping == null)
            return;

        _attributeFlowMapping.TargetMetaverseAttribute = target;
        CorrectTokenKindForTargetType(target?.Type);
        await ScheduleFlowAnalysisAsync();
    }

    /// <summary>The Connected System sibling of <see cref="OnGeneratedMetaverseTargetChanged"/> (export direction).</summary>
    private void OnGeneratedConnectedSystemTargetChanged(ConnectedSystemObjectTypeAttribute? target)
    {
        if (_attributeFlowMapping == null)
            return;

        _attributeFlowMapping.TargetConnectedSystemAttribute = target;
        CorrectTokenKindForTargetType(target?.Type);
    }

    /// <summary>
    /// "Only if taken" needs a base expression and is never valid for a Number target
    /// (<see cref="SyncRuleMappingGenerationValidator"/> rule 4); switching to a Number target while it is
    /// selected would otherwise leave the dialog showing a disabled radio still selected, and Save blocked with
    /// no visible way to fix it. Moving to Sequence matches the approved mockup's Number-target frame, which
    /// shows a sequence number pre-selected rather than an unusable "only if taken".
    /// </summary>
    private void CorrectTokenKindForTargetType(AttributeDataType? targetType)
    {
        if (_attributeFlowMapping?.Generation is not { TokenKind: GeneratedValueTokenKind.OnlyIfTaken } generation)
            return;

        if (GeneratedValueFormHelpers.IsNumberTarget(targetType))
            generation.TokenKind = GeneratedValueTokenKind.Sequence;
    }

    /// <summary>
    /// Loads the advisory Standard Mapping hints for the Connected System and Metaverse Object Type this
    /// Synchronisation Rule targets (#1122), on its own short-lived context: these are read-only display data
    /// and must stay clear of the tracked rule graph the editor saves. Cached until the rule is re-pointed,
    /// and a rule without both ends chosen yet simply has no hints.
    /// </summary>
    private async Task LoadStandardMappingHintsAsync()
    {
        // The FK scalar is only populated once the rule has been saved; while a new rule is being created the
        // chosen Connected System is on the navigation property alone, and hints should work there too.
        var connectedSystemId = SyncRule.ConnectedSystemId != 0 ? SyncRule.ConnectedSystemId : SyncRule.ConnectedSystem?.Id ?? 0;
        if (SyncRule.MetaverseObjectType == null || connectedSystemId == 0)
        {
            _standardMappingHints = StandardMappingHints.Empty;
            _loadedStandardMappingHintsKey = null;
            return;
        }

        var key = (connectedSystemId, SyncRule.MetaverseObjectType.Id);
        if (_loadedStandardMappingHintsKey == key)
            return;

        using var jim = JimFactory.Create();
        var connectedSystemStandard = await jim.ConnectedSystems.GetConnectedSystemSchemaStandardAsync(connectedSystemId);
        var mappings = await jim.Metaverse.GetStandardMappingsForObjectTypeAsync(SyncRule.MetaverseObjectType.Id);
        _standardMappingHints = StandardMappingHints.Build(mappings, connectedSystemStandard);
        _loadedStandardMappingHintsKey = key;
    }

    /// <summary>
    /// The Metaverse Attributes the target picker offers on an import rule: the Object Type's attributes, less
    /// those already targeted by another Attribute Flow. Shared with the suggestion logic so the editor cannot
    /// suggest something the picker does not list.
    /// </summary>
    private IEnumerable<MetaverseAttribute> AvailableTargetMetaverseAttributes() =>
        SyncRule.MetaverseObjectType!.Attributes.Where(q =>
            !SyncRule.AttributeFlowRules.Any(afr => afr != _attributeFlowMapping &&
                                                    afr.TargetMetaverseAttribute != null &&
                                                    afr.TargetMetaverseAttribute.Id == q.Id));

    /// <summary>
    /// The Connected System attributes the target picker offers on an export rule; the export-side sibling of
    /// <see cref="AvailableTargetMetaverseAttributes"/>.
    /// </summary>
    /// <summary>
    /// The Connected System attributes an Attribute Flow may target: everything not already taken by another
    /// flow on this rule, less anything holding credential material. Credential attributes are excluded
    /// entirely because they are written by JIM's password channel and must never travel through Attribute
    /// Flow; naming one through the REST API or PowerShell is rejected for the same reason.
    /// </summary>
    private IEnumerable<ConnectedSystemObjectTypeAttribute> AvailableTargetConnectedSystemAttributes() =>
        SyncRule.ConnectedSystemObjectType!.Attributes.Where(q =>
            !CredentialAttributes.IsCredentialAttribute(q.Name) &&
            !SyncRule.AttributeFlowRules.Any(afr => afr != _attributeFlowMapping &&
                                                    afr.TargetConnectedSystemAttribute != null &&
                                                    afr.TargetConnectedSystemAttribute.Id == q.Id));

    /// <summary>
    /// The targets the Standard Mappings say the chosen source attribute corresponds to (#1122). Empty for an
    /// Expression source (there is no attribute name to match on) and for a source attribute the standard says
    /// nothing about. More than one target can correspond to a name, in which case all of them are offered and
    /// none is chosen. A correspondence the editor cannot act on is returned too, carrying the reason: a
    /// standard that describes a correspondence JIM then says nothing about is worse than no hint at all,
    /// because the administrator is left looking for an attribute that is not in the list.
    /// </summary>
    private List<StandardMappingSuggestion> GetStandardMappingSuggestions()
    {
        // A target the Exchange recipients panel chose is not open to suggestion.
        if (_targetFixedByExchangePanel || _attributeFlowMappingSourceType != "Attribute" || !_standardMappingHints.HasHints)
            return [];

        if (SyncRule.Direction == SyncRuleDirection.Import)
        {
            var matches = _standardMappingHints.MatchesForAttributeName(_attributeFlowMappingSource?.ConnectedSystemAttribute?.Name);
            if (matches.Count == 0)
                return [];

            // Resolved against every attribute on the Object Type, not just the selectable ones, so a target
            // that is missing from the picker can be explained rather than quietly disappearing.
            return matches
                .Select(match => new { Match = match, Attribute = SyncRule.MetaverseObjectType!.Attributes.FirstOrDefault(a => a.Id == match.MetaverseAttributeId) })
                .Where(x => x.Attribute != null)
                .Select(x => new StandardMappingSuggestion
                {
                    Status = ClassifyTarget(x.Attribute!),
                    MetaverseAttribute = x.Attribute,
                    TargetName = x.Attribute!.Name,
                    StandardLabel = x.Match.StandardLabel,
                    CounterpartName = x.Match.CounterpartName,
                    Notes = x.Match.Notes
                })
                .ToList();
        }

        var sourceMetaverseAttribute = _attributeFlowMappingSource?.MetaverseAttribute;
        if (sourceMetaverseAttribute == null)
            return [];

        // On export the correspondence runs the other way: the chosen Metaverse Attribute's counterpart names
        // are the Connected System attribute names the standard says should receive it, so a correspondence
        // only stands where the system's schema actually has an attribute of that name.
        return _standardMappingHints.ForAttribute(sourceMetaverseAttribute.Id)
            .SelectMany(hint => SyncRule.ConnectedSystemObjectType!.Attributes
                .Where(candidate => string.Equals(candidate.Name, hint.CounterpartName, StringComparison.OrdinalIgnoreCase))
                .Select(candidate => new StandardMappingSuggestion
                {
                    Status = ClassifyTarget(candidate),
                    ConnectedSystemAttribute = candidate,
                    TargetName = candidate.Name,
                    StandardLabel = hint.StandardLabel,
                    CounterpartName = hint.CounterpartName,
                    Notes = hint.Notes
                }))
            .ToList();
    }

    /// <summary>
    /// Why a corresponding Metaverse Attribute is or is not selectable as this mapping's target. Defers to
    /// <see cref="IsAttributeFlowTargetDisabled(MetaverseAttribute)"/> for the type rule rather than restating
    /// it, so the explanation cannot drift from what the picker actually allows.
    /// </summary>
    private StandardMappingSuggestionStatus ClassifyTarget(MetaverseAttribute attribute)
    {
        if (SyncRule.AttributeFlowRules.Any(afr => afr != _attributeFlowMapping && afr.TargetMetaverseAttribute?.Id == attribute.Id))
            return StandardMappingSuggestionStatus.AlreadyTargeted;

        return IsAttributeFlowTargetDisabled(attribute) ? StandardMappingSuggestionStatus.TypeMismatch : StandardMappingSuggestionStatus.Available;
    }

    /// <summary>
    /// The export-side sibling of <see cref="ClassifyTarget(MetaverseAttribute)"/>. Read-only is tested first:
    /// it also disables the target, but "the system will not accept writes to this attribute" is a more useful
    /// thing to be told than "the types differ".
    /// </summary>
    private StandardMappingSuggestionStatus ClassifyTarget(ConnectedSystemObjectTypeAttribute attribute)
    {
        if (attribute.Writability == AttributeWritability.ReadOnly)
            return StandardMappingSuggestionStatus.ReadOnlyTarget;

        if (SyncRule.AttributeFlowRules.Any(afr => afr != _attributeFlowMapping && afr.TargetConnectedSystemAttribute?.Id == attribute.Id))
            return StandardMappingSuggestionStatus.AlreadyTargeted;

        return IsAttributeFlowTargetDisabled(attribute) ? StandardMappingSuggestionStatus.TypeMismatch : StandardMappingSuggestionStatus.Available;
    }

    private static bool IsSuggested(List<StandardMappingSuggestion> suggestions, MetaverseAttribute attribute) =>
        suggestions.Any(s => s.MetaverseAttribute != null && s.MetaverseAttribute.Id == attribute.Id);

    private static bool IsSuggested(List<StandardMappingSuggestion> suggestions, ConnectedSystemObjectTypeAttribute attribute) =>
        suggestions.Any(s => s.ConnectedSystemAttribute != null && s.ConnectedSystemAttribute.Id == attribute.Id);

    /// <summary>
    /// The sentence stating the correspondence the Standard Mappings describe (#1122). Attribute and counterpart
    /// names are rendered as inline code, so the result is raw markup; each name is HTML-encoded because it is
    /// Connected System or Metaverse schema data.
    /// </summary>
    private MarkupString GetStandardMappingSuggestionText(List<StandardMappingSuggestion> suggestions)
    {
        static string Code(string? name) => $"<code class=\"jim-code-inline\">{System.Net.WebUtility.HtmlEncode(name)}</code>";

        var first = suggestions[0];
        // The picker's compact "SCIM 2.0 · LDAP/AD" label does not read as prose; spell the conjunction out.
        var standard = System.Net.WebUtility.HtmlEncode(first.StandardLabel.Replace(" · ", SyncRuleText.ListAnd, StringComparison.Ordinal));
        var targets = string.Join(SyncRuleText.ListAnd, suggestions.Select(s => Code(s.TargetName)));
        var notes = string.Join(" ", suggestions
            .Select(s => s.Notes)
            .Where(n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.Ordinal)
            .Select(System.Net.WebUtility.HtmlEncode));

        var sentence = SyncRule.Direction == SyncRuleDirection.Import
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture,
                PluralRules.Choose(suggestions.Count, SyncRuleText.StandardMappingImportOne, SyncRuleText.StandardMappingImportOther),
                standard, Code(first.CounterpartName), targets)
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.StandardMappingExport,
                standard, Code(_attributeFlowMappingSource?.MetaverseAttribute?.Name), targets);

        return (MarkupString)(string.IsNullOrEmpty(notes)
            ? sentence
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.SentenceAndSentence, sentence, notes));
    }

    /// <summary>
    /// The sentence for a correspondence the editor cannot act on: what the standard says, then why this
    /// mapping cannot express it, then the mapping's own note where it has one (which is usually where the
    /// conversion an Expression source would need is described). Raw markup, encoded as above.
    /// </summary>
    private MarkupString GetUnavailableCorrespondenceText(StandardMappingSuggestion suggestion, bool continuesFromSuggestion)
    {
        static string Code(string? name) => $"<code class=\"jim-code-inline\">{System.Net.WebUtility.HtmlEncode(name)}</code>";

        var standard = System.Net.WebUtility.HtmlEncode(suggestion.StandardLabel.Replace(" · ", SyncRuleText.ListAnd, StringComparison.Ordinal));
        var sourceName = SyncRule.Direction == SyncRuleDirection.Import
            ? _attributeFlowMappingSource?.ConnectedSystemAttribute?.Name
            : _attributeFlowMappingSource?.MetaverseAttribute?.Name;

        // Following a sentence that has already named the standard and the source, repeating both reads as boilerplate.
        var sentence = continuesFromSuggestion
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture,
                UnavailableAlsoTemplate(suggestion.Status), Code(suggestion.TargetName))
            : string.Format(System.Globalization.CultureInfo.CurrentCulture,
                UnavailableFirstTemplate(suggestion.Status), standard, Code(sourceName), Code(suggestion.TargetName));

        var notes = string.IsNullOrWhiteSpace(suggestion.Notes) ? null : System.Net.WebUtility.HtmlEncode(suggestion.Notes.Trim());
        return (MarkupString)(notes == null
            ? sentence
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.SentenceAndSentence, sentence, notes));
    }

    private static string UnavailableAlsoTemplate(StandardMappingSuggestionStatus status) => status switch
    {
        StandardMappingSuggestionStatus.TypeMismatch => SyncRuleText.UnavailableAlsoTypeMismatch,
        StandardMappingSuggestionStatus.AlreadyTargeted => SyncRuleText.UnavailableAlsoAlreadyTargeted,
        StandardMappingSuggestionStatus.ReadOnlyTarget => SyncRuleText.UnavailableAlsoReadOnly,
        _ => SyncRuleText.UnavailableAlsoOther
    };

    private static string UnavailableFirstTemplate(StandardMappingSuggestionStatus status) => status switch
    {
        StandardMappingSuggestionStatus.TypeMismatch => SyncRuleText.UnavailableFirstTypeMismatch,
        StandardMappingSuggestionStatus.AlreadyTargeted => SyncRuleText.UnavailableFirstAlreadyTargeted,
        StandardMappingSuggestionStatus.ReadOnlyTarget => SyncRuleText.UnavailableFirstReadOnly,
        _ => SyncRuleText.UnavailableFirstOther
    };

    /// <summary>
    /// Accepts a suggestion by setting it as the mapping's target; a convenience for a picker that can run to
    /// dozens of attributes, not an endorsement. The administrator can change the target afterwards as normal.
    /// </summary>
    private async Task ApplyStandardMappingSuggestion(StandardMappingSuggestion suggestion)
    {
        if (_attributeFlowMapping == null)
            return;

        if (SyncRule.Direction == SyncRuleDirection.Import)
            _attributeFlowMapping.TargetMetaverseAttribute = suggestion.MetaverseAttribute;
        else
            _attributeFlowMapping.TargetConnectedSystemAttribute = suggestion.ConnectedSystemAttribute;

        await ScheduleFlowAnalysisAsync();
    }

    /// <summary>
    /// Whether the inbound value-processing flag is set on the mapping being edited (#843).
    /// </summary>
    private bool HasProcessingFlag(InboundValueProcessing flag)
    {
        return _attributeFlowMapping != null && _attributeFlowMapping.InboundValueProcessing.HasFlag(flag);
    }

    /// <summary>
    /// Sets or clears an inbound value-processing flag on the mapping being edited (#843).
    /// </summary>
    private void SetProcessingFlag(InboundValueProcessing flag, bool enabled)
    {
        if (_attributeFlowMapping == null)
            return;

        if (enabled)
            _attributeFlowMapping.InboundValueProcessing |= flag;
        else
            _attributeFlowMapping.InboundValueProcessing &= ~flag;
    }

    /// <summary>
    /// Label for a Metaverse Attribute in the source/target selects, including its data type and plurality
    /// (for example "Account Name (Text : Single Valued)"), so the plurality is visible once selected. Matches
    /// the format shown for Connected System attributes.
    /// </summary>
    private static string MetaverseAttributeLabel(MetaverseAttribute? attribute)
        => attribute == null
            ? string.Empty
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.AttributeLabelWithType,
                attribute.Name, AttributeFlowSectionSummaries.DataTypeName(attribute.Type), AttributeFlowSectionSummaries.PluralityWords(attribute.AttributePlurality));

    /// <summary>
    /// The Connected System sibling of <see cref="MetaverseAttributeLabel"/>, and it is load-bearing rather than
    /// cosmetic: without a text label MudSelect paints the chosen option itself inside the input, and the export
    /// target's options carry a "Suggested" chip, which put a 32px chip on the bottom border of a 56px field.
    /// </summary>
    private static string ConnectedSystemAttributeLabel(ConnectedSystemObjectTypeAttribute? attribute)
        => attribute == null
            ? string.Empty
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.AttributeLabelWithType,
                attribute.Name, AttributeFlowSectionSummaries.DataTypeName(attribute.Type), AttributeFlowSectionSummaries.PluralityWords(attribute.AttributePlurality));

    /// <summary>
    /// Whether the mapping currently being added or edited in the dialog flows a Multi-Valued source attribute
    /// to a Single-Valued target attribute (#435). Add and edit share this dialog, so this covers both. Only
    /// Attribute mappings are considered (an Expression's plurality is unknown at design time). On import,
    /// Reference sources are excluded because the runtime guard does not apply to them; on export, every data
    /// type is in scope.
    /// </summary>
    /// <summary>
    /// The Disabled chip's tooltip: what disabled means, plus the recorded reason where something disabled the
    /// mapping on the administrator's behalf. Written as sentences so <c>TooltipText</c> renders one per line.
    /// </summary>
    private static string DescribeDisabledMapping(SyncRuleMapping mapping)
    {
        var baseText = SyncRuleText.DisabledMappingDescription;
        return string.IsNullOrWhiteSpace(mapping.DisabledReason)
            ? baseText
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.SentenceAndSentence, baseText, mapping.DisabledReason);
    }

    private bool DialogMappingIsMvaToSva()
    {
        if (_attributeFlowMappingSourceType != "Attribute" || _attributeFlowMapping == null || _attributeFlowMappingSource == null)
            return false;

        if (SyncRule.Direction == SyncRuleDirection.Import)
        {
            var source = _attributeFlowMappingSource.ConnectedSystemAttribute;
            var target = _attributeFlowMapping.TargetMetaverseAttribute;
            return source is { AttributePlurality: AttributePlurality.MultiValued } &&
                   source.Type != AttributeDataType.Reference &&
                   target is { AttributePlurality: AttributePlurality.SingleValued };
        }

        var exportSource = _attributeFlowMappingSource.MetaverseAttribute;
        var exportTarget = _attributeFlowMapping.TargetConnectedSystemAttribute;
        return exportSource is { AttributePlurality: AttributePlurality.MultiValued } &&
               exportTarget is { AttributePlurality: AttributePlurality.SingleValued };
    }

    /// <summary>
    /// The direction-specific warning shown when the mapping being added or edited is Multi-Valued to
    /// Single-Valued (#435). The attribute names are rendered as inline code, so the result is raw markup;
    /// each name is HTML-encoded because it is Connected System / Metaverse schema data.
    /// </summary>
    private MarkupString GetMvaToSvaWarningText()
    {
        static string Code(string? name) => $"<code class=\"jim-code-inline\">{System.Net.WebUtility.HtmlEncode(name)}</code>";

        if (SyncRule.Direction == SyncRuleDirection.Import)
        {
            var source = Code(_attributeFlowMappingSource?.ConnectedSystemAttribute?.Name);
            var target = Code(_attributeFlowMapping?.TargetMetaverseAttribute?.Name);
            return (MarkupString)string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.MvaToSvaWarningImport, source, target);
        }

        var mvSource = Code(_attributeFlowMappingSource?.MetaverseAttribute?.Name);
        var csTarget = Code(_attributeFlowMapping?.TargetConnectedSystemAttribute?.Name);
        return (MarkupString)string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.MvaToSvaWarningExport, mvSource, csTarget);
    }

    /// <summary>
    /// Whether an existing Attribute mapping flows a Multi-Valued source to a Single-Valued target (#435),
    /// used to flag the row in the Attribute Flow list.
    /// </summary>
    private bool MappingIsMvaToSva(SyncRuleMapping mapping)
    {
        if (mapping.GetSourceType() != SyncRuleMappingSourcesType.AttributeMapping)
            return false;

        var source = mapping.Sources.FirstOrDefault();
        if (source == null)
            return false;

        if (SyncRule.Direction == SyncRuleDirection.Import)
        {
            return source.ConnectedSystemAttribute is { AttributePlurality: AttributePlurality.MultiValued } csSource &&
                   csSource.Type != AttributeDataType.Reference &&
                   mapping.TargetMetaverseAttribute is { AttributePlurality: AttributePlurality.SingleValued };
        }

        return source.MetaverseAttribute is { AttributePlurality: AttributePlurality.MultiValued } &&
               mapping.TargetConnectedSystemAttribute is { AttributePlurality: AttributePlurality.SingleValued };
    }

    /// <summary>
    /// Why the expression as typed cannot be saved on this Attribute Flow, or null (#2055 Phase 3); the same check the
    /// save runs for a new or changed mapping.
    /// </summary>
    private string? AttributeFlowExpressionCheck(string? expression) => _attributeFlowMapping == null
        ? ExpressionSyntaxCheck.ErrorFor(ExpressionEvaluator, expression)
        : ExpressionSyntaxCheck.ErrorForAttributeFlow(ExpressionEvaluator, expression, _attributeFlowMapping, SyncRule);

    private bool DisableAddAttributeFlowMappingButton()
    {
        if (_attributeFlowMapping == null || _attributeFlowMappingSource == null || _attributeFlowMappingSourceType == null)
            return true;

        // Validate source is configured
        if (_attributeFlowMappingSourceType == "Attribute" &&
            _attributeFlowMappingSource.ConnectedSystemAttribute == null &&
            _attributeFlowMappingSource.MetaverseAttribute == null)
            return true;

        if (_attributeFlowMappingSourceType == "Expression" &&
            string.IsNullOrWhiteSpace(_attributeFlowMappingSource.Expression))
            return true;

        // An expression the save would refuse (it does not parse, reads the wrong side or an attribute the type does not
        // have, or returns a type the target can never hold) is refused here, as the save refuses it (#2053, #2055 Phase
        // 3); the editor shows why beneath the field, from the same check. A Generated Value's base is held to the same.
        if (_attributeFlowMappingSourceType is "Expression" or "Generated" &&
            AttributeFlowExpressionCheck(_attributeFlowMappingSource.Expression) != null)
            return true;

        // Validate target is configured
        if (SyncRule.Direction == SyncRuleDirection.Import && _attributeFlowMapping.TargetMetaverseAttribute == null)
            return true;
        if (SyncRule.Direction == SyncRuleDirection.Export && _attributeFlowMapping.TargetConnectedSystemAttribute == null)
            return true;

        // Unique Value Generation (#242, Phase 3): Save is blocked while SyncRuleMappingGenerationValidator
        // reports any problem with the generated mapping's settings (target/token combination, separator,
        // attempt limit, ...); GeneratedValueOptionsEditor shows the same messages inline.
        if (_attributeFlowMappingSourceType == "Generated" &&
            SyncRuleMappingGenerationValidator.Validate(_attributeFlowMapping).Count > 0)
            return true;

        // Metaverse-Derived Attribute Flows (#1750): the live analysis runs the save's own validator, so while it says
        // the save would be refused (a loop, an unknown or Reference mv["..."] input), Update is not offered. The panel
        // above shows why.
        if (_derivedFlowAnalysis?.BlockingError != null)
            return true;

        return false;
    }

    // import rules: the user can choose an invalid target attribute, depending on the makeup of the source attribute
    private bool IsAttributeFlowTargetDisabled(MetaverseAttribute targetMetaverseAttribute)
    {
        // Expression mappings can target any attribute (type compatibility is the user's responsibility)
        if (_attributeFlowMappingSourceType == "Expression")
            return false;

        if (_attributeFlowMappingSource?.ConnectedSystemAttribute == null)
            return true;

        if (targetMetaverseAttribute.Type != _attributeFlowMappingSource.ConnectedSystemAttribute.Type)
            return true;

        // Multi-valued to single-valued is permitted (#435) — the runtime selects the first value
        // and generates a warning RPEI so the administrator can verify correctness.

        return false;
    }

    // export rules: the user can choose an invalid target attribute, depending on the makeup of the source attribute
    private bool IsAttributeFlowTargetDisabled(ConnectedSystemObjectTypeAttribute targetConnectedSystemObjectTypeAttribute)
    {
        // read-only attributes cannot be targeted by export Attribute Flows
        if (targetConnectedSystemObjectTypeAttribute.Writability == AttributeWritability.ReadOnly)
            return true;

        // Expression mappings can target any writable attribute (type compatibility is the user's responsibility)
        if (_attributeFlowMappingSourceType == "Expression")
            return false;

        if (_attributeFlowMappingSource?.MetaverseAttribute == null)
            return true;

        if (targetConnectedSystemObjectTypeAttribute.Type != _attributeFlowMappingSource.MetaverseAttribute.Type)
            return true;

        // Multi-valued to single-valued is permitted (#435) — the runtime selects the first value
        // and generates a warning RPEI so the administrator can verify correctness.

        return false;
    }

    private async Task HandleAddAttributeFlowMappingButtonClick()
    {
        if (_attributeFlowMapping == null)
            return;

        // Unique Value Generation (#242, Phase 3, Work Package D2): confirm before saving a raised Start at on a
        // saved Sequence mapping (mockup screen 02's "Skip ahead to N?" save frame). Only meaningful for a mapping
        // that already exists (a new mapping has no counter yet to skip ahead from) and only worth a server round
        // trip when the mapping is a Sequence token in the first place.
        if (_isEditingAttributeFlow && _attributeFlowMapping.Id > 0 &&
            _attributeFlowMapping.Generation is { TokenKind: GeneratedValueTokenKind.Sequence } generation)
        {
            using var jim = JimFactory.Create();
            var currentState = await jim.ConnectedSystems.GetGeneratedValueSequenceStateAsync(_attributeFlowMapping.Id);
            if (GeneratedValuePreviewHelpers.ShouldConfirmSkipAhead(currentState, generation.SequenceStart))
            {
                var attributeName = _attributeFlowMapping.TargetMetaverseAttribute?.Name
                    ?? _attributeFlowMapping.TargetConnectedSystemAttribute?.Name ?? SyncRuleText.ThisAttribute;
                var confirmed = await GeneratedValueSkipAheadDialog.ShowAsync(
                    DialogService, attributeName, currentState!.NextNumber, generation.SequenceStart, generation.FixedWidth);
                if (!confirmed)
                    return;
            }
        }

        // FR 3 (#1750): disabling the flow, or changing what it reads or writes, can take away the last contributor of an
        // attribute Metaverse-Derived Attribute Flows read. Ask first, naming them; with none, nothing changes here.
        if (_isEditingAttributeFlow && !await ConfirmEditDependantsAsync(_attributeFlowMapping))
            return;

        // Only add to the list if this is a new mapping (not editing an existing one)
        if (!_isEditingAttributeFlow)
            SyncRule.AttributeFlowRules.Add(_attributeFlowMapping);

        // close the dialog and reset state
        _addAttributeFlowRuleDialogVisible = false;
        _attributeFlowMapping = null;
        _attributeFlowMappingSource = null;
        _isEditingAttributeFlow = false;
        _editBaseline = null;
        _derivedFlowAnalysis = null;
        _builtFromGeneratedValue = null;
        await LoadDerivedFlowStepsAsync();
        await RefreshFlowGridAsync();
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Asks before an edit that leaves Metaverse-Derived Attribute Flows without an input (#1750, FR 3); true to go
    /// ahead. Asks nothing, and reads nothing, for an edit that cannot take a contribution away, or on an export rule.
    /// </summary>
    private async Task<bool> ConfirmEditDependantsAsync(SyncRuleMapping edited)
    {
        if (SyncRule.Direction != SyncRuleDirection.Import ||
            _editBaseline == null || !_editBaseline.MayTakeAContributionAway(edited))
            return true;

        List<DependentDerivedFlow> dependants;
        using (var jim = JimFactory.Create())
            dependants = await jim.ConnectedSystems.GetDependentDerivedFlowsOfMappingEditAsync(SyncRule, _editBaseline.AsOpened, edited);
        if (dependants.Count == 0)
            return true;

        var disabling = _editBaseline.AsOpened.Enabled && !edited.Enabled;
        var targetName = _editBaseline.AsOpened.TargetMetaverseAttribute?.Name ?? SyncRuleText.ThisAttribute;
        return await DependentDerivedFlowsDialog.ConfirmAsync(DialogService,
            disabling ? SyncRuleText.DisableAttributeFlowQuestion : SyncRuleText.SaveAttributeFlowQuestion,
            string.Format(System.Globalization.CultureInfo.CurrentCulture, disabling ? SyncRuleText.DisableFlowTo : SyncRuleText.ChangeFlowTo, targetName),
            dependants,
            disabling ? SyncRuleText.DisableButton : CommonText.Save);
    }

    /// <summary>
    /// "Start again…" (plan Phase 3 point 5, mockup screen 02b): only ever offered for a saved generated
    /// Sequence mapping (<see cref="GeneratedValuePreviewHelpers.ShowStartAgainAction"/>), so
    /// <see cref="SyncRuleMapping.Generation"/> and its target are guaranteed non-null here.
    /// </summary>
    private async Task HandleStartAgainClickAsync(SyncRuleMapping attributeFlowRule)
    {
        var attributeName = attributeFlowRule.TargetMetaverseAttribute?.Name
            ?? attributeFlowRule.TargetConnectedSystemAttribute?.Name ?? SyncRuleText.ThisAttribute;
        var configuredStart = attributeFlowRule.Generation!.SequenceStart;
        var restarted = await GeneratedValueStartAgainDialog.ShowAsync(
            DialogService, attributeFlowRule.Id, attributeName, configuredStart, attributeFlowRule.Generation.FixedWidth,
            attributeFlowRule.TargetMetaverseAttributeId,
            attributeFlowRule.TargetMetaverseAttributeId.HasValue ? null : attributeFlowRule.TargetConnectedSystemAttributeId);

        // Starting again forgets the attribute's retired values, so the row's chip has to go with them.
        if (restarted)
            await LoadRetiredValueCountsAsync();
    }

    private async Task HandleAttributeFlowRuleDeleteClickAsync(SyncRuleMapping attributeFlowRule)
    {
        // FR 3 (#1750): when Metaverse-Derived Attribute Flows read an attribute this flow is the last enabled
        // contributor of, say which before anything else; that confirmation stands in for the plain one below.
        var dependants = await GetDependantsOfRemovalAsync(attributeFlowRule);
        if (dependants.Count > 0 && !await DependentDerivedFlowsDialog.ConfirmAsync(DialogService, SyncRuleText.RemoveAttributeFlowQuestion,
                string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.RemoveFlowTo, attributeFlowRule.TargetMetaverseAttribute?.Name ?? SyncRuleText.ThisAttribute), dependants, SyncRuleText.RemoveButton))
            return;

        // a persisted import mapping with a target may hold the current values of its Metaverse attribute; if
        // it does, the removal needs the recall-or-keep choice rather than a plain confirmation (#1537).
        // Everything else (never persisted, export, no target, nothing contributed) keeps today's flow.
        var keepContributedValues = false;
        var choiceOffered = false;
        if (attributeFlowRule.Id > 0 && GetMappingTargetMetaverseAttributeId(attributeFlowRule) is { } targetMetaverseAttributeId)
        {
            using var jim = JimFactory.Create();
            var summary = await jim.ConnectedSystems.GetSyncRuleContributedValuesSummaryAsync(SyncRule.Id, targetMetaverseAttributeId);
            if (summary.TotalValues > 0)
            {
                choiceOffered = true;
                var attributeName = attributeFlowRule.TargetMetaverseAttribute?.Name
                    ?? summary.Attributes.FirstOrDefault()?.AttributeName
                    ?? SyncRuleText.TheAttribute;
                var (cancelled, keep) = await ContributedValuesChoiceDialog.ShowForMappingRemovalAsync(DialogService, attributeName, summary.TotalObjects);
                if (cancelled)
                    return;
                keepContributedValues = keep;
            }
        }

        if (!choiceOffered && dependants.Count == 0)
        {
            var confirmationResult = await DialogService.ShowMessageBoxAsync(SyncRuleText.WarningTitle, SyncRuleText.ConfirmRemoveMapping, yesText: SyncRuleText.RemoveConfirmButton, cancelText: CommonText.Cancel);
            if (!confirmationResult.HasValue || !confirmationResult.Value)
                return;
        }

        StageAttributeFlowRemoval(attributeFlowRule, keepContributedValues);

        await LoadDerivedFlowStepsAsync();
        await RefreshFlowGridAsync();
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// Takes <paramref name="attributeFlowRule"/> off the rule and records how its removal is saved. The removal takes
    /// effect when the page saves the rule, as every change on this tab does.
    /// </summary>
    private void StageAttributeFlowRemoval(SyncRuleMapping attributeFlowRule, bool keepContributedValues)
    {
        SyncRule.AttributeFlowRules.Remove(attributeFlowRule);

        // record the choice for EVERY staged removal of a persisted mapping, not just the keeps: a removal
        // named in the save's carrier is deleted properly, one not named falls back to the legacy orphaning
        // path (#1550). Replace-not-add keeps the carrier valid should the same id ever be recorded twice.
        if (attributeFlowRule.Id > 0)
        {
            var existingChoice = MappingRemovalChoices.FirstOrDefault(c => c.MappingId == attributeFlowRule.Id);
            if (existingChoice != null)
                MappingRemovalChoices.Remove(existingChoice);
            MappingRemovalChoices.Add(new SyncRuleMappingRemovalChoice
            {
                MappingId = attributeFlowRule.Id,
                KeepContributedValues = keepContributedValues,
                // recorded for the Attribute Flow preview, which can no longer read the target from the staged
                // rule once the mapping is removed; the save resolves the authoritative target itself.
                TargetMetaverseAttributeId = attributeFlowRule.TargetMetaverseAttributeId ?? attributeFlowRule.TargetMetaverseAttribute?.Id
            });
        }
    }

    /// <summary>
    /// The Exchange recipients panel's Set (#2021, PRD requirement 4): the ordinary Add Attribute Flow dialog, with the
    /// target already chosen and fixed, since the panel's row is that attribute.
    /// </summary>
    private async Task HandleExchangeRecipientSetAsync(ConnectedSystemObjectTypeAttribute attribute)
    {
        await HandleOpenAddAttributeFlowRuleDialogAsync();
        _attributeFlowMapping!.TargetConnectedSystemAttribute = attribute;
        _targetFixedByExchangePanel = true;
        await ScheduleFlowAnalysisAsync();
    }

    /// <summary>
    /// The Exchange recipients panel's Stop, once the administrator has confirmed: every Attribute Flow to an Exchange
    /// attribute comes off the rule, saved with it. Export flows put no values on Metaverse Objects and nothing derives
    /// from them, so none needs the recall-or-keep choice or the derived-flow check that a single removal can.
    /// </summary>
    private async Task HandleStopExchangeRecipientsAsync()
    {
        if (ExchangeRecipientFlows.For(SyncRule) is not { } exchangeFlows)
            return;

        foreach (var flow in exchangeFlows.Flows)
            StageAttributeFlowRemoval(flow, keepContributedValues: false);

        await LoadDerivedFlowStepsAsync();
        await RefreshFlowGridAsync();
        await OnChanged.InvokeAsync();
    }

    /// <summary>
    /// The Metaverse-Derived Attribute Flows removing <paramref name="mapping"/> from the rule as staged would leave
    /// without an input; empty, with nothing read, on an export rule.
    /// </summary>
    private async Task<List<DependentDerivedFlow>> GetDependantsOfRemovalAsync(SyncRuleMapping mapping)
    {
        if (SyncRule.Direction != SyncRuleDirection.Import)
            return [];

        using var jim = JimFactory.Create();
        return await jim.ConnectedSystems.GetDependentDerivedFlowsOfMappingRemovalAsync(SyncRule, mapping);
    }

    /// <summary>
    /// The Metaverse attribute an import mapping's contributed values sit on: the PERSISTED target, so the FK scalar
    /// is preferred and the navigation is only the fallback for a mapping whose scalar is unset. This deliberately
    /// differs from <see cref="SyncRuleMapping.ResolveTargetMetaverseAttributeId"/> (navigation first), which answers
    /// "what does this flow target now": a mapping retargeted in this edit session still holds its values on the
    /// attribute it was saved with, and that is what the recall-or-keep choice is about.
    /// Null for export mappings and for import mappings with no target yet.
    /// </summary>
    private static int? GetMappingTargetMetaverseAttributeId(SyncRuleMapping mapping) =>
        mapping.TargetMetaverseAttributeId ?? mapping.TargetMetaverseAttribute?.Id;

    /// <summary>
    /// Whether any of the page's own chip filters is narrowing the list. It tells the empty state apart from the
    /// "nothing configured yet" case, which has a different way out.
    /// </summary>
    private bool AnyAttributeFlowFilterIsActive =>
        _selectedMappingTypes.Count > 0 || _selectedDataTypes.Count > 0 || _selectedPluralities.Count > 0;

    /// <summary>
    /// Slices one window of the Synchronisation Rule's Attribute Flows, applying the page's chip filters, the
    /// grid's search (attribute names on either side, and expression text) and its sort. The flows are held on the
    /// rule the page already loaded, so there is no database range read.
    /// </summary>
    private Task<VirtualisedWindow<SyncRuleMapping>> LoadAttributeFlowWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        var flows = SyncRule.AttributeFlowRules.Where(FilterAttributeFlowRules);

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            flows = flows.Where(m =>
                GetSortableSourceName(m).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                GetSortableTargetName(m).Contains(search, StringComparison.OrdinalIgnoreCase) ||
                m.Sources.Any(s => s.Expression != null && s.Expression.Contains(search, StringComparison.OrdinalIgnoreCase)));
        }

        IOrderedEnumerable<SyncRuleMapping> Order<TKey>(Func<SyncRuleMapping, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? flows.OrderByDescending(key, comparer) : flows.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "type" => Order(m => m.GetSourceType().ToString(), StringComparer.OrdinalIgnoreCase),
            "source" => Order(GetSortableSourceName, StringComparer.OrdinalIgnoreCase),
            "created" => Order(m => m.Created),
            "updated" => Order(m => m.LastUpdated ?? DateTime.MinValue),
            _ => Order(GetSortableTargetName, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    /// <summary>
    /// Reloads the grid after the set of Attribute Flows, or the filters over it, has changed. The totals are
    /// invalidated because the match set is a different one, and the reader is returned to the top because the
    /// position they held described rows that are no longer there.
    /// </summary>
    private async Task RefreshFlowGridAsync()
    {
        if (_flowGrid == null)
            return;

        await _flowGrid.ResetScrollAsync();
        await _flowGrid.RefreshAsync(invalidateTotals: true);
    }

    private bool FilterAttributeFlowRules(SyncRuleMapping mapping)
    {
        if (_selectedMappingTypes.Count > 0 && !_selectedMappingTypes.Contains(AttributeFlowMappingTypes.Of(mapping, SyncRule.Direction)))
            return false;

        AttributeDataType? dataType = SyncRule.Direction == SyncRuleDirection.Import
            ? mapping.TargetMetaverseAttribute?.Type
            : mapping.TargetConnectedSystemAttribute?.Type;

        AttributePlurality? plurality = SyncRule.Direction == SyncRuleDirection.Import
            ? mapping.TargetMetaverseAttribute?.AttributePlurality
            : mapping.TargetConnectedSystemAttribute?.AttributePlurality;

        if (_selectedDataTypes.Count > 0 && (dataType == null || !_selectedDataTypes.Contains(dataType.Value)))
            return false;

        if (_selectedPluralities.Count > 0 && (plurality == null || !_selectedPluralities.Contains(plurality.Value)))
            return false;

        return true;
    }

    private string GetSortableSourceName(SyncRuleMapping mapping)
    {
        var firstSource = mapping.Sources.OrderBy(s => s.Order).FirstOrDefault();
        if (firstSource == null) return string.Empty;

        if (SyncRule.Direction == SyncRuleDirection.Import && firstSource.ConnectedSystemAttribute != null)
            return firstSource.ConnectedSystemAttribute.Name;
        if (SyncRule.Direction == SyncRuleDirection.Export && firstSource.MetaverseAttribute != null)
            return firstSource.MetaverseAttribute.Name;
        if (!string.IsNullOrWhiteSpace(firstSource.Expression))
            return firstSource.Expression;

        return string.Empty;
    }

    private string GetSortableTargetName(SyncRuleMapping mapping)
    {
        if (SyncRule.Direction == SyncRuleDirection.Import)
            return mapping.TargetMetaverseAttribute?.Name ?? string.Empty;

        return mapping.TargetConnectedSystemAttribute?.Name ?? string.Empty;
    }

    /// <summary>
    /// The Mapping Type filter's chips: each category the rule's flows fall into, with its count, Derived Attribute Flows
    /// counted apart from ordinary Expressions (#2014), in <see cref="AttributeFlowMappingType"/>'s declared order.
    /// </summary>
    private IEnumerable<KeyValuePair<AttributeFlowMappingType, int>> GetAvailableMappingTypes()
    {
        return SyncRule.AttributeFlowRules
            .GroupBy(m => AttributeFlowMappingTypes.Of(m, SyncRule.Direction))
            .Select(g => new KeyValuePair<AttributeFlowMappingType, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key);
    }

    private IEnumerable<KeyValuePair<AttributeDataType, int>> GetAvailableFlowDataTypes()
    {
        return SyncRule.AttributeFlowRules
            .Select(m => SyncRule.Direction == SyncRuleDirection.Import
                ? m.TargetMetaverseAttribute?.Type
                : m.TargetConnectedSystemAttribute?.Type)
            .Where(t => t.HasValue)
            .GroupBy(t => t!.Value)
            .Select(g => new KeyValuePair<AttributeDataType, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key.ToString());
    }

    private IEnumerable<KeyValuePair<AttributePlurality, int>> GetAvailableFlowPluralities()
    {
        return SyncRule.AttributeFlowRules
            .Select(m => SyncRule.Direction == SyncRuleDirection.Import
                ? m.TargetMetaverseAttribute?.AttributePlurality
                : m.TargetConnectedSystemAttribute?.AttributePlurality)
            .Where(p => p.HasValue)
            .GroupBy(p => p!.Value)
            .Select(g => new KeyValuePair<AttributePlurality, int>(g.Key, g.Count()))
            .OrderBy(x => x.Key);
    }

    private async Task OnMappingTypeFilterChangedAsync(IReadOnlyCollection<AttributeFlowMappingType> selected)
    {
        _selectedMappingTypes = selected;
        await RefreshFlowGridAsync();
    }

    private async Task OnFlowDataTypeFilterChangedAsync(IReadOnlyCollection<AttributeDataType> selected)
    {
        _selectedDataTypes = selected;
        await RefreshFlowGridAsync();
    }

    private async Task OnFlowPluralityFilterChangedAsync(IReadOnlyCollection<AttributePlurality> selected)
    {
        _selectedPluralities = selected;
        await RefreshFlowGridAsync();
    }
}
