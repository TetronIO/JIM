<PageTitle>@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailPageTitle, _connectedSystem?.Name)</PageTitle>
@* The title row carries the page's data views (the Connected System's data, as distinct from the configuration tabs
   below) as page actions on its right. A row of their own left a gap under the audit chips; the tab bar has no room
   to take them without scrolling further. They wrap under the title on a narrow screen. *@
<div class="d-flex justify-space-between align-center flex-wrap gap-3">
    <MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" /><span>@ConnectedSystemText.DetailTitleLabel</span> <span class="mud-primary-text">@_connectedSystem?.Name</span>
        <PageInfo Title="@ConnectedSystemText.ConnectedSystemTerm" DocsPage="configuration/connected-systems.md">
            @ConnectedSystemText.DetailInfoBody
        </PageInfo>
    </MudText>
    @if (_connectedSystem != null)
    {
        <MudStack Row Spacing="3">
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Storage"
                       DropShadow="false"
                       Size="Size.Small"
                       Href="@($"/admin/connected-systems/{_connectedSystem.Id}/connector-space")">
                @ConnectedSystemText.DetailConnectorSpace
                <span class="jim-nav-count">@_connectedSystemObjectCount.ToString("N0")</span>
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Outbox"
                       DropShadow="false"
                       Size="Size.Small"
                       Href="@($"/admin/connected-systems/{_connectedSystem.Id}/pending-exports")">
                @ConnectedSystemText.DetailPendingExports
                <span class="@(_pendingExportCount > 0 ? "jim-nav-count jim-nav-count-warning" : "jim-nav-count")">@_pendingExportCount.ToString("N0")</span>
            </MudButton>
            @* Failing Pending Exports (#2119), shown only while there are some. JIM never gives up on a Pending Export: each
               is attempted again at every export run, so a failing one is reported on every run until its cause is
               fixed, and this says how many there are and how long the longest has been failing. Red, because the
               cause is nearly always something to fix in the Connected System: a permission, a schema rule. *@
            @if (_pendingExportFailures is { FailingCount: > 0 } failures)
            {
                var failingLead = failures.FailingCount == 1
                    ? ConnectedSystemText.DetailFailingLeadOne
                    : string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailFailingLeadOther, failures.FailingCount.ToString("N0", System.Globalization.CultureInfo.CurrentCulture));
                var failingTooltip = failures.OldestFailingSince is { } oldest
                    ? string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailFailingTooltipOldest, failingLead, oldest.ToLocalTime().ToRelativeTime())
                    : string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailFailingTooltip, failingLead);
                <MudTooltip Arrow="true" Placement="Placement.Top"
                            Text="@failingTooltip">
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.ErrorOutline"
                               DropShadow="false"
                               Size="Size.Small"
                               Href="@($"/admin/connected-systems/{_connectedSystem.Id}/pending-exports?failing=true")">
                        @ConnectedSystemText.DetailFailingExports
                        <span class="jim-nav-count jim-nav-count-error">@failures.FailingCount.ToString("N0")</span>
                    </MudButton>
                </MudTooltip>
            }
            @* The Connector Space's unresolved references (#959), shown only while there are some. A button among the
               data views rather than a notice: unresolved references are chronic rather than urgent, and an
               always-on notice would become wallpaper and override an administrator who chose Ignore. Amber where
               Unresolved Reference Handling asks for them to be reported, as Pending Exports is when exports wait. *@
            @if (_unresolvedReferenceTotals is { ReferenceCount: > 0 } unresolvedReferences)
            {
                var amber = UnresolvedReferenceDisplay.SignpostTone(_connectedSystem.UnresolvedReferenceHandling) == UnresolvedReferenceTone.Warning;
                <MudTooltip Arrow="true" Placement="Placement.Top">
                    <ChildContent>
                        <MudButton Variant="Variant.Filled"
                                   StartIcon="@Icons.Material.Filled.LinkOff"
                                   DropShadow="false"
                                   Size="Size.Small"
                                   Href="@UnresolvedReferenceDisplay.ConnectorSpaceHref(_connectedSystem.Id)">
                            @ConnectedSystemText.DetailUnresolvedReferences
                            <span class="@(amber ? "jim-nav-count jim-nav-count-warning" : "jim-nav-count")">@unresolvedReferences.ReferenceCount.ToString("N0")</span>
                        </MudButton>
                    </ChildContent>
                    <TooltipContent>
                        <TooltipText Text="@UnresolvedReferenceDisplay.SignpostTooltip(unresolvedReferences, _connectedSystem.UnresolvedReferenceHandling)" />
                    </TooltipContent>
                </MudTooltip>
            }
        </MudStack>
    }
</div>
<div class="d-flex justify-space-between align-center">
    <MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>
    @if (_connectedSystem != null)
    {
        <AuditInfo Entity="@_connectedSystem" />
    }
</div>

@* ─── Run Profile Safeguards withheld-changes notice (#1618) ───
   Derived from the most recent completed Export Activity, so a backlog of deliberately unprocessed
   changes cannot sit unnoticed behind a warning-status Activity on a busy Operations page. *@
@if (_connectedSystem != null && _latestExportActivity is { } exportActivity &&
     (exportActivity.ExportCreatesWithheld ?? 0) + (exportActivity.ExportUpdatesWithheld ?? 0) + (exportActivity.ExportDeletesWithheld ?? 0) is var totalWithheld and > 0)
{
    var exportRunProfile = _connectedSystem.RunProfiles?.FirstOrDefault(rp => rp.Id == exportActivity.ConnectedSystemRunProfileId);

    // Run Profile Safeguards (#1618): a run attempts none of a change type it would exceed the
    // limit for, so every withheld type here was withheld in full, not partially.
    var withheldByType = new List<(string Noun, int Count, int? Limit)>();
    if ((exportActivity.ExportCreatesWithheld ?? 0) > 0)
        withheldByType.Add(("creates", exportActivity.ExportCreatesWithheld!.Value, exportRunProfile?.MaxCreates));
    if ((exportActivity.ExportUpdatesWithheld ?? 0) > 0)
        withheldByType.Add(("updates", exportActivity.ExportUpdatesWithheld!.Value, exportRunProfile?.MaxUpdates));
    if ((exportActivity.ExportDeletesWithheld ?? 0) > 0)
        withheldByType.Add(("deletes", exportActivity.ExportDeletesWithheld!.Value, exportRunProfile?.MaxDeletes));

    var changeNoun = withheldByType.Count == 1 ? NounFor(withheldByType[0].Noun, totalWithheld) : ConnectedSystemText.DetailNounChangeOther;
    // The limit may have been raised or cleared since that run, in which case the Run Profile no longer
    // carries one to name; say so rather than rendering an empty clause. The notice clears itself on the
    // next completed export either way.
    var limitsText = string.Join(", ", withheldByType
        .Where(w => w.Limit.HasValue)
        .Select(w => string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailMaxLimit, NounFor(w.Noun, 2), w.Limit!.Value.ToString("N0", System.Globalization.CultureInfo.CurrentCulture))));
    var reasonText = limitsText.Length > 0
        ? string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailLimitReason, exportActivity.TargetName, limitsText)
        : string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailLimitChanged, exportActivity.TargetName);
    var withheldQuantity = totalWithheld == 1
        ? string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailWithheldSingle, changeNoun)
        : string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailWithheldMany, totalWithheld.ToString("N0", System.Globalization.CultureInfo.CurrentCulture), changeNoun);

    <MudAlert Severity="Severity.Warning" Class="mt-2 mb-6">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.SpaceBetween" Class="flex-grow-1">
            <span>
                @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailWithheldLead, withheldQuantity) <strong>@reasonText</strong>@ConnectedSystemText.DetailWithheldRest
            </span>
            <MudStack Row Spacing="2">
                <AlertButton Severity="Severity.Warning" Secondary="true"
                             Href="@($"/activity/{exportActivity.Id}")">
                    @ConnectedSystemText.DetailViewActivity
                </AlertButton>
                <AlertButton Severity="Severity.Warning"
                             Href="@($"/admin/connected-systems/{_connectedSystem.Id}?t=run-profiles")">
                    @ConnectedSystemText.DetailEditRunProfile
                </AlertButton>
            </MudStack>
        </MudStack>
    </MudAlert>
}

@* ─── Deletion fence notice (#809) ───
   A system with Status = Deleting is fenced: excluded from scheduled runs, its deletion either underway on
   the worker or stopped partway. The banner is the page's authority on that state; the Danger Zone's delete
   button stays live so the administrator can take the retry or finish-immediately exit from there. *@
@if (_connectedSystem is { Status: ConnectedSystemStatus.Deleting })
{
    @if (_deletionTask != null)
    {
        var deletionActivity = _deletionTask.Activity;
        <MudAlert Severity="Severity.Info" Class="mt-2 mb-6">
            <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.SpaceBetween" Class="flex-grow-1">
                <span>
                    @if (_deletionTask.SynchronisedDeprovisioning)
                    {
                        <strong>@ConnectedSystemText.DetailDeprovisioningInProgress</strong>
                        <text> @ConnectedSystemText.DetailDeprovisioningDetail</text>
                        @if (deletionActivity is { ObjectsToProcess: > 0 } progressActivity)
                        {
                            var objectsProcessed = progressActivity.ObjectsProcessed;
                            var objectsToProcess = progressActivity.ObjectsToProcess;
                            <text> @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailObjectsProcessed, objectsProcessed.ToString("N0", System.Globalization.CultureInfo.CurrentCulture), objectsToProcess.ToString("N0", System.Globalization.CultureInfo.CurrentCulture))</text>
                        }
                    }
                    else
                    {
                        <strong>@ConnectedSystemText.DetailDeletionInProgress</strong>
                        <text> @ConnectedSystemText.DetailDeletionDetail</text>
                    }
                </span>
                @if (deletionActivity is { } linkActivity)
                {
                    var deletionActivityId = linkActivity.Id;
                    <AlertButton Severity="Severity.Info"
                                 Href="@($"/activity/{deletionActivityId}")">
                        @ConnectedSystemText.DetailViewActivity
                    </AlertButton>
                }
            </MudStack>
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Class="mt-2 mb-6">
            <strong>@ConnectedSystemText.DetailDeprovisioningStopped</strong> @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailDeprovisioningStoppedDetail, ConnectedSystemText.ConnectedSystemDeprovisionThroughSynchronisation, ConnectedSystemText.ConnectedSystemDeleteImmediatelyKeepData)
        </MudAlert>
    }
}

@* ─── Import incomplete notice ───
   An import stopped part-way through saving what it read (#2521), so Full and Delta Synchronisation of this system are
   refused until a Full Import completes. A warning rather than info: scheduled synchronisations fail until it is acted on. *@
@if (_connectedSystem != null && _connectedSystem.ImportIncompleteSince is { } importIncompleteSince)
{
    <MudAlert Severity="Severity.Warning" Class="mt-2 mb-6" data-testid="jim-import-incomplete-notice">
        <strong>@ConnectedSystemText.DetailImportIncompleteLead</strong> @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailImportIncompleteDetail, importIncompleteSince.ToFriendlyDate())
        @ImportCompleteness.DescribeRemedy(_connectedSystem)
    </MudAlert>
}

@* ─── Objects awaiting deprovisioning ───
   Obsolescence is a transient state on a healthy system, lasting from the import that found an object
   gone until the synchronisation that deletes it, so this is Info rather than a warning. It earns a place
   beside the drift notice because it answers the same shape of question ("what is waiting on a run?") and
   because the status was otherwise visible only on individual objects, which is nowhere anybody looks: a
   system that is imported and never synchronised accumulates them in silence (#1527). *@
@if (_connectedSystem != null && _obsoleteConnectedSystemObjectCount > 0)
{
    var obsoleteText = _obsoleteConnectedSystemObjectCount == 1
        ? ConnectedSystemText.DetailObsoleteSingle
        : string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailObsoleteMany, _obsoleteConnectedSystemObjectCount.ToString("N0", System.Globalization.CultureInfo.CurrentCulture));
    <MudAlert Severity="Severity.Info" Class="mt-2 mb-6">
        <MudStack Row AlignItems="AlignItems.Center" Spacing="2" Justify="Justify.SpaceBetween" Class="flex-grow-1">
            <span>@obsoleteText</span>
            <AlertButton Severity="Severity.Info"
                         Href="@($"/admin/connected-systems/{_connectedSystem.Id}/connector-space?status=Obsolete")">
                @ConnectedSystemText.DetailReview
            </AlertButton>
        </MudStack>
    </MudAlert>
}

@* ─── Stranded-value sweep armed notice ───
   Armed by every Connector Space clear (#1549) and gated on a genuine Full Import since (#1605): says which
   of the two waiting states the system is in, so an administrator does not have to read the Activity
   history to know whether the next Full Synchronisation will do anything. *@
@if (_connectedSystem != null && _connectedSystem.StrandedValueSweepArmedAt is { } armedAt)
{
    var lastImport = _connectedSystem.LastSuccessfulFullImportCompletedAt;
    var sweepReady = lastImport.HasValue && lastImport.Value > armedAt;
    <MudAlert Severity="Severity.Info" Class="mt-2 mb-6">
        @if (sweepReady)
        {
            var lastImportAt = lastImport!.Value;
            <span>
                @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailSweepArmedReady, armedAt.ToFriendlyDate(), lastImportAt.ToFriendlyDate())
            </span>
        }
        else
        {
            <span>
                @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailSweepArmedWaiting, armedAt.ToFriendlyDate())
            </span>
        }
    </MudAlert>
}

@* ─── Configuration drift notice ─── *@
@if (_drift is { HasPendingChanges: true })
{
    @* Composed in C# rather than assembled from markup fragments, so the punctuation sits tight against the
       timestamp and the singular and plural readings are both correct. *@
    var driftClass = _drift.HighestChangeClass;
    var driftCount = _drift.ChangeCount;
    var lastSync = _drift.LastFullSynchronisation;
    var driftWhen = lastSync.HasValue ? lastSync.Value.ToLocalTime().ToFriendlyDate() : null;
    var driftCountText = driftCount.ToString("N0", System.Globalization.CultureInfo.CurrentCulture);
    var driftLead = (driftCount == 1, driftWhen) switch
    {
        (true, not null) => string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailDriftOneDated, driftWhen),
        (true, null) => ConnectedSystemText.DetailDriftOneUndated,
        (false, not null) => string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailDriftManyDated, driftCountText, driftWhen),
        (false, null) => string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DetailDriftManyUndated, driftCountText),
    };
    var driftGuidance = driftClass == ConfigurationChangeClass.Destructive
        ? (driftCount == 1 ? ConnectedSystemText.DetailDriftGuidanceDestructiveSingle : ConnectedSystemText.DetailDriftGuidanceDestructiveMany)
        : (driftCount == 1 ? ConnectedSystemText.DetailDriftGuidanceSingle : ConnectedSystemText.DetailDriftGuidanceMany);
    var driftSeverity = driftClass == ConfigurationChangeClass.Destructive ? Severity.Error : Severity.Warning;
    <MudAlert Severity="@driftSeverity"
              Class="mt-2 mb-6" data-testid="jim-configuration-drift-notice">
        <span>@driftLead @driftGuidance</span>
        @* Reviewing the changes reads what was configured; previewing reads what the run would then do (#1530). *@
        <div class="d-flex align-center flex-wrap gap-2 mt-2">
            @if (HasFullSynchronisationRunProfile)
            {
                <AlertButton Severity="@driftSeverity"
                             StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => RequestFullSynchronisationPreview())"
                           data-testid="jim-drift-preview-full-synchronisation">
                    @ConnectedSystemText.DetailPreviewFullSync
                </AlertButton>
            }
            <AlertButton Severity="@driftSeverity" Secondary="true" Href="@($"/admin/connected-systems/{Id}?t=changes")">
                @ConnectedSystemText.DetailReviewChanges
            </AlertButton>
        </div>
    </MudAlert>
}
else if (_drift is { NeverFullySynchronised: true })
{
    <MudAlert Severity="Severity.Info" Class="mt-2 mb-6">
        <span>
            @ConnectedSystemText.DetailNeverSynchronised
        </span>
        @if (HasFullSynchronisationRunProfile)
        {
            <div class="mt-2">
                <AlertButton Severity="Severity.Info"
                             StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => RequestFullSynchronisationPreview())">
                    @ConnectedSystemText.DetailPreviewFullSync
                </AlertButton>
            </div>
        }
    </MudAlert>
}
else if (_drift is { TrackingDisabled: true })
{
    <MudAlert Severity="Severity.Info" Class="mt-2 mb-6">
        @ConnectedSystemText.DetailTrackingOff
    </MudAlert>
}

@* ─── Changes awaiting synchronisation (#2615) ─── *@
@* One notice per Object Type the next synchronisation will process in full. Reported whether or not drift can be
   determined (the changes are real either way), and separate from the drift notice above, which never counts them: an
   ordinary Delta or Full Synchronisation applies them, so no Full Synchronisation is called for. *@
@if (_drift is { HasChangesAwaitingSynchronisation: true })
{
    var awaitingRunProfile = AwaitingSynchronisationRunProfile.Preferred(_connectedSystem?.RunProfiles);
    foreach (var awaiting in _drift.AwaitingSynchronisation)
    {
        <AwaitingSynchronisationNotice @key="awaiting.ConnectedSystemObjectTypeId" Entry="awaiting" RunProfile="awaitingRunProfile"
                                       OnRunNow="RunAwaitingSynchronisationNowAsync" Class="mt-2 mb-6" />
    }
}

@if (_connectedSystem != null)
{
    <NavigableMudTabs TabPanelsClass="pt-6" Class="mt-2">

        <MudTabPanel Text="@ConnectedSystemText.DetailTabDetails">
            @* The Full Synchronisation preview (#1530): started from the notice above or a Run Profile, and found again here. *@
            <ConnectedSystemFullSynchronisationPreview ConnectedSystem="_connectedSystem"
                                                       StartRequest="_fullSynchronisationPreviewRequest"
                                                       StartRequestHandled="OnFullSynchronisationPreviewRequestHandled" />
            <ConnectedSystemDetailsTab ConnectedSystem="_connectedSystem" />
        </MudTabPanel>

        @* The SCIM endpoint's own tab, beside Details: only a Connected System using the SCIM 2.0 Service Provider
           Connector has one. *@
        @if (_hasScimEndpoint)
        {
            <MudTabPanel Text="@ConnectedSystemText.DetailTabScim">
                <ConnectedSystemScimTab ConnectedSystem="_connectedSystem" />
            </MudTabPanel>
        }

        <MudTabPanel Text="@ConnectedSystemText.DetailTabSettings">
            <ConnectedSystemSettingsTab ConnectedSystem="_connectedSystem"
                                        SettingCategories="_settingCategories!"
                                        OnConnectedSystemChanged="ReloadConnectedSystemAsync" />
        </MudTabPanel>

        <MudTabPanel Text="@ConnectedSystemText.DetailTabSchema" Disabled="@AreSettingDependentTabsDisabled()">
            <ConnectedSystemSchemaTab ConnectedSystem="_connectedSystem"
                                      LatestAuxiliaryClassDiscoveryRun="_latestAuxiliaryClassDiscoveryRun"
                                      OnConnectedSystemChanged="ReloadConnectedSystemAsync" />
        </MudTabPanel>

        @if (_connectedSystem.ConnectorDefinition.SupportsPartitions)
        {
            @* "Scope" rather than "Partitions & Containers": the tab is where an administrator chooses what JIM manages
               in this system, and the name holds whether the Connector offers partitions alone or partitions with
               containers, where "hierarchy" or "containers" would each be wrong for one of them. *@
            <MudTabPanel Text="@ConnectedSystemText.DetailTabScope" Disabled="@AreSettingDependentTabsDisabled()">
                <ConnectedSystemPartitionsTab ConnectedSystem="_connectedSystem"
                                              PartitionsAndHierarchiesText="@_partitionsAndHierarchiesText"
                                              PartitionAndHierarchyText="@_partitionAndHierarchyText"
                                              OnConnectedSystemChanged="ReloadConnectedSystemAsync"
                                              PartitionWatermarks="@_partitionWatermarks" />
            </MudTabPanel>
        }

        <MudTabPanel Text="@ConnectedSystemText.DetailTabMatching" Disabled="@IsObjectMatchingTabDisabled()">
            <ConnectedSystemObjectMatchingTab ConnectedSystem="_connectedSystem"
                                              MetaverseAttributes="_metaverseAttributes!"
                                              MetaverseObjectTypes="_metaverseObjectTypes!" />
        </MudTabPanel>

        <MudTabPanel Text="@ConnectedSystemText.DetailTabRunProfiles" Disabled="@IsRunProfilesTabDisabled()">
            <ConnectedSystemRunProfilesTab ConnectedSystem="_connectedSystem"
                                           OnPreviewRequested="@(runProfile => RequestFullSynchronisationPreview(runProfile.Id))" />
        </MudTabPanel>

        @* Hidden rather than disabled where the Connector has no password channel: there is nothing here to
            configure at all, and a disabled tab reads as something that could be switched on. *@
        @if (_connectedSystem.ConnectorDefinition.SupportsPasswordSet)
        {
            <MudTabPanel Text="@ConnectedSystemText.DetailTabPasswords" Disabled="@AreSettingDependentTabsDisabled()">
                <ConnectedSystemPasswordSynchronisationTab ConnectedSystem="_connectedSystem"
                                                           OnConnectedSystemChanged="ReloadConnectedSystemAsync" />
            </MudTabPanel>
        }

        <MudTabPanel Text="@ConnectedSystemText.DetailTabChanges" BadgeData="@(_changeCount > 0 ? _changeCount.ToString("N0") : null)" BadgeColor="Color.Primary">
            <ConfigurationChangesTab TargetType="ActivityTargetType.ConnectedSystem" ObjectId="_connectedSystem.Id" ObjectTypeLabel="@ConnectedSystemText.ConnectedSystemTerm" />
        </MudTabPanel>

        <MudTabPanel Text="@ConnectedSystemText.DetailTabDangerZone" Icon="@Icons.Material.Filled.Warning" BadgeColor="Color.Error" ID="@("danger-zone")">
            <ConnectedSystemDangerZoneTab ConnectedSystem="_connectedSystem" />
        </MudTabPanel>

    </NavigableMudTabs>

}

@code {
    [Parameter]
    public int Id { get; set; }
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }
    private ConnectedSystem? _connectedSystem;
    private List<ConnectedSystemSettingCategory>? _settingCategories;
    private string? _partitionsAndHierarchiesText;
    private string? _partitionAndHierarchyText;
    private int _pendingExportCount;
    private PendingExportFailureSummary? _pendingExportFailures;
    private int _connectedSystemObjectCount;
    private ConnectedSystemUnresolvedReferenceTotals? _unresolvedReferenceTotals;
    private int _obsoleteConnectedSystemObjectCount;

    // Run Profile Safeguards (#1618): the most recent completed Export Activity, so a backlog of
    // deliberately unprocessed changes cannot sit unnoticed behind a warning-status Activity.
    private Activity? _latestExportActivity;
    private int _changeCount;
    private ConfigurationDriftStatus? _drift;
    private List<BreadcrumbItem> _breadcrumbs = null!;

    // The live deletion task for a fenced system (#809). A surviving task means the deletion is queued or
    // executing (its Activity is where progress lives); a fenced system with no task is a failed run,
    // retryable from the Danger Zone.
    private DeleteConnectedSystemWorkerTask? _deletionTask;

    // A request to preview a Full Synchronisation (#1530), from the drift notice or a Run Profile, until the preview's
    // host on the Details tab has handled it.
    private FullSynchronisationPreviewRequest? _fullSynchronisationPreviewRequest;

    private bool HasFullSynchronisationRunProfile =>
        _connectedSystem?.RunProfiles?.Any(rp => rp.RunType == ConnectedSystemRunType.FullSynchronisation) == true;

    /// <summary>
    /// Asks the preview host on the Details tab to start a Full Synchronisation preview, and shows that tab: the Details
    /// tab is the page's own URL, so navigating to it selects it wherever the request came from.
    /// </summary>
    private void RequestFullSynchronisationPreview(int? runProfileId = null)
    {
        _fullSynchronisationPreviewRequest = new FullSynchronisationPreviewRequest(Guid.NewGuid(), runProfileId);
        NavManager.NavigateTo($"/admin/connected-systems/{Id}");
    }

    /// <summary>
    /// "Run now" on a notice of changes awaiting synchronisation (#2615): opens the queue dialog on this Connected System with
    /// the Run Profile that applies them chosen. The dialog queues the run and says so; the notices stay until the run has
    /// applied the changes, so the page is reloaded to follow it when a run was queued.
    /// </summary>
    private async Task RunAwaitingSynchronisationNowAsync()
    {
        if (await QueueRunProfileDialog.ShowAsync(DialogService, Id))
            await ReloadConnectedSystemAsync();
    }

    private void OnFullSynchronisationPreviewRequestHandled(Guid requestId)
    {
        if (_fullSynchronisationPreviewRequest?.Id == requestId)
            _fullSynchronisationPreviewRequest = null;
    }

    private IList<MetaverseAttribute>? _metaverseAttributes;

    private IReadOnlyDictionary<int, DescribedPartitionWatermark>? _partitionWatermarks;

    private AuxiliaryClassDiscoveryRun? _latestAuxiliaryClassDiscoveryRun;

    // A Simple mode Object Matching Rule has to name the Metaverse Object Type it searches, so the Matching tab
    // needs the list to offer (#1458).
    private IList<MetaverseObjectType>? _metaverseObjectTypes;

    /// <summary>
    /// Whether this Connected System has a SCIM endpoint to manage: it uses the SCIM 2.0 Service Provider Connector
    /// and the feature is on.
    /// </summary>
    private bool _hasScimEndpoint;


    protected override async Task OnInitializedAsync()
    {
        await LoadConnectedSystemAsync();
    }

    private async Task LoadConnectedSystemAsync()
    {
        using var jim = JimFactory.Create();
        _connectedSystem = await jim.ConnectedSystems.GetConnectedSystemAsync(Id, withChangeTracking: true);
        if (_connectedSystem == null)
        {
            NavManager.NavigateTo("../");
            return;
        }

        _hasScimEndpoint = _connectedSystem.ConnectorDefinition.Name == JIM.Connectors.ConnectorConstants.ScimServiceProviderConnectorName;

        // Where each partition's next Delta Import starts (#2715), for the Scope tab. Read by id, on a Core load of its own:
        // describing a watermark creates the Connector, which must never touch the instance this page edits.
        _partitionWatermarks = _connectedSystem.ConnectorDefinition.SupportsPartitions
            ? (await jim.ConnectedSystems.GetDescribedPartitionWatermarksAsync(Id))?.ToDictionary(watermark => watermark.PartitionId)
            : null;

        _breadcrumbs =
        [
            new BreadcrumbItem(ConnectedSystemText.DetailBreadcrumbHome, href: "/", icon: Icons.Material.Filled.Home),
            new BreadcrumbItem(ConnectedSystemText.DetailBreadcrumbAdministration, href: "/admin"),
            new BreadcrumbItem(ConnectedSystemText.DetailBreadcrumbConnectedSystems, href: "/admin/connected-systems/"),
            new BreadcrumbItem(_connectedSystem.Name, href: null, disabled: true)
        ];

        _settingCategories = _connectedSystem.SettingValues
            .Select(q => q.Setting.Category)
            .Distinct()
            .Where(category => ShouldShowCategory(category))
            .OrderBy(category => GetCategoryDisplayOrder(category))
            .ToList();

        if (_connectedSystem.ConnectorDefinition is { SupportsPartitions: true, SupportsPartitionContainers: true })
        {
            _partitionsAndHierarchiesText = ConnectedSystemText.DetailPartitionsAndContainers;
            _partitionAndHierarchyText = ConnectedSystemText.DetailPartitionAndContainer;
        }
        else if (_connectedSystem.ConnectorDefinition.SupportsPartitions)
        {
            _partitionsAndHierarchiesText = ConnectedSystemText.DetailPartitions;
            _partitionAndHierarchyText = ConnectedSystemText.DetailPartition;
        }

        // Resolve the live deletion task for a fenced system, so the fence notice can link its Activity
        // and show progress; one lookup, only when fenced (#809).
        _deletionTask = _connectedSystem.Status == ConnectedSystemStatus.Deleting
            ? await jim.Tasking.GetDeleteConnectedSystemWorkerTaskAsync(Id)
            : null;

        _pendingExportCount = await jim.ConnectedSystems.GetPendingExportsCountAsync(Id);
        _pendingExportFailures = _pendingExportCount > 0 ? await jim.ConnectedSystems.GetPendingExportFailureSummaryAsync(Id) : null;
        _connectedSystemObjectCount = await jim.ConnectedSystems.GetConnectedSystemObjectCountAsync(Id);
        _unresolvedReferenceTotals = await jim.ConnectedSystems.GetUnresolvedReferenceTotalsAsync(Id);
        _latestExportActivity = await jim.Activities.GetLatestCompletedExportActivityAsync(Id);
        _obsoleteConnectedSystemObjectCount = await jim.ConnectedSystems.GetConnectedSystemObjectObsoleteCountAsync(Id);
        _drift = await jim.ConfigurationDrift.GetConnectedSystemDriftAsync(Id);
        _changeCount = (await jim.ChangeHistory.GetConfigurationChangeHistoryAsync(ActivityTargetType.ConnectedSystem, Id, 1, 1)).TotalResults;
        _metaverseAttributes ??= await jim.Metaverse.GetMetaverseAttributesAsync();
        _metaverseObjectTypes ??= await jim.Metaverse.GetMetaverseObjectTypesAsync(false);

        // Loaded here rather than by the Schema tab's Auxiliary Classes panel, which is rendered once per Object
        // Type: the run belongs to the whole Connected System, and a panel that fetched it for itself would query
        // once per type on every render. The tab reaches the application layer only in response to an action.
        _latestAuxiliaryClassDiscoveryRun = await jim.ConnectedSystems.GetLatestAuxiliaryClassDiscoveryRunAsync(Id);
    }

    private async Task ReloadConnectedSystemAsync()
    {
        await LoadConnectedSystemAsync();
        StateHasChanged();
    }

    private bool AreSettingDependentTabsDisabled()
    {
        if (_connectedSystem == null)
            return true;

        return !_connectedSystem.SettingValuesValid;
    }

    /// <summary>
    /// Determines whether a setting category should be displayed based on connector capabilities.
    /// </summary>
    private bool ShouldShowCategory(ConnectedSystemSettingCategory category)
    {
        if (_connectedSystem?.ConnectorDefinition == null)
            return true;

        return category switch
        {
            // Only show Import category if the connector supports full or delta import
            ConnectedSystemSettingCategory.Import =>
                _connectedSystem.ConnectorDefinition.SupportsFullImport ||
                _connectedSystem.ConnectorDefinition.SupportsDeltaImport,

            // Only show Export category if the connector supports export
            ConnectedSystemSettingCategory.Export =>
                _connectedSystem.ConnectorDefinition.SupportsExport,

            // Always show other categories
            _ => true
        };
    }

    /// <summary>
    /// Returns the display order for setting categories.
    /// Order: Import, Export, General, Schema, Connectivity, Capabilities
    /// </summary>
    private static int GetCategoryDisplayOrder(ConnectedSystemSettingCategory category)
    {
        return category switch
        {
            ConnectedSystemSettingCategory.Import => 0,
            ConnectedSystemSettingCategory.Export => 1,
            ConnectedSystemSettingCategory.General => 2,
            ConnectedSystemSettingCategory.Schema => 3,
            ConnectedSystemSettingCategory.Connectivity => 4,
            ConnectedSystemSettingCategory.Capabilities => 5,
            _ => 99
        };
    }

    /// <summary>
    /// The noun for a kind of withheld change ("creates", "updates", "deletes") in the count's grammatical number.
    /// </summary>
    private static string NounFor(string kind, int count) => (kind, count == 1) switch
    {
        ("creates", true) => ConnectedSystemText.DetailNounCreateOne,
        ("creates", false) => ConnectedSystemText.DetailNounCreateOther,
        ("updates", true) => ConnectedSystemText.DetailNounUpdateOne,
        ("updates", false) => ConnectedSystemText.DetailNounUpdateOther,
        (_, true) => ConnectedSystemText.DetailNounDeleteOne,
        _ => ConnectedSystemText.DetailNounDeleteOther
    };

    private bool IsRunProfilesTabDisabled()
    {
        if (_connectedSystem == null)
            return true;

        // Disable if settings are invalid
        if (!_connectedSystem.SettingValuesValid)
            return true;

        // Disable if the connector supports partitions but none are selected (with containers if applicable)
        if (_connectedSystem.ConnectorDefinition.SupportsPartitions)
            return !_connectedSystem.HasPartitionsOrContainersSelected();

        return false;
    }

    private bool IsObjectMatchingTabDisabled()
    {
        if (_connectedSystem == null)
            return true;

        // Disable if settings are invalid
        if (!_connectedSystem.SettingValuesValid)
            return true;

        // Disable if the connector supports partitions but none are selected (with containers if applicable)
        if (_connectedSystem.ConnectorDefinition.SupportsPartitions)
            return !_connectedSystem.HasPartitionsOrContainersSelected();

        return false;
    }
}
