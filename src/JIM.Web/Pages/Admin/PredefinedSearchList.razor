@page "/admin/predefined-searches"
@attribute [Authorize(Roles = "Administrator")]
@using System.Globalization
@using JIM.Models.Search.DTOs
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<PageTitle>@SearchText.PredefinedSearches</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.SavedSearch" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />@SearchText.PredefinedSearches
    <PageInfo Title="@SearchText.PredefinedSearches" DocsPage="configuration/predefined-searches.md">
        @SearchText.ListPageInfo
    </PageInfo>
</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the density toggle, the search box
   and the toolbar count) lives in the shared grid; this page loads the whole list once (it is a small
   configuration list) and windows it in memory. The page header already names the list, so there is no toolbar
   title and the count carries the nouns. *@
<VirtualisedDataGrid GridClass="mt-2" T="PredefinedSearchHeader"
                     ContainerId="predefined-search-list"
                     DefaultSortBy="created"
                     DefaultSortDescending="true"
                     LoadWindow="LoadWindowAsync"
                     SingularName="@SearchText.PredefinedSearch"
                     PluralName="@SearchText.PredefinedSearches"
                     SearchPlaceholder="@SearchText.SearchPlaceholder"
                     RowClicked="HandleRowClicked"
                     RowClassFunc="@((search, _) => search.IsEnabled ? null : "jim-readonly-row")">
    <Columns>
        <TemplateColumn Title="@CommonText.ColumnName" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@CommonText.ColumnName" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                <MudLink Href="@("/admin/predefined-searches/" + context.Item.Uri)">@context.Item.Name</MudLink>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@SearchText.ColumnUri" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@SearchText.ColumnUri" Name="uri" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.Uri
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@SearchText.ColumnObjectType" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@SearchText.ColumnObjectType" Name="objecttype" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.MetaverseObjectTypeName
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@SearchText.ColumnDefault" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@SearchText.ColumnDefault" Name="default" />
            </HeaderTemplate>
            <CellTemplate>
                @(context.Item.IsDefaultForMetaverseObjectType ? SearchText.Yes : SearchText.No)
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@SearchText.ColumnBuiltIn" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@SearchText.ColumnBuiltIn" Name="builtin" />
            </HeaderTemplate>
            <CellTemplate>
                @(context.Item.BuiltIn ? SearchText.Yes : SearchText.No)
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@CommonText.Enabled" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@CommonText.Enabled" Name="enabled" />
            </HeaderTemplate>
            <CellTemplate>
                @* Stop the click reaching the row, which would navigate to the detail page mid-toggle. *@
                <div @onclick:stopPropagation="true">
                    <MudSwitch T="bool" Value="context.Item.IsEnabled" Color="Color.Success" Size="Size.Small"
                               ValueChanged="async (bool val) => await ToggleEnabledAsync(context.Item, val)" />
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@SearchText.ColumnAttributes" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@SearchText.ColumnAttributes" Name="attributes" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.MetaverseAttributeCount
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@SearchText.ColumnCreated" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@SearchText.ColumnCreated" Name="created" />
            </HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="@context.Item.Created.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                    @context.Item.Created.ToLocalTime().ToRelativeTime()
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@string.Format(CultureInfo.CurrentCulture, SearchText.NoSearchesMatch, grid.SearchText)"
                             SecondaryText="@CommonText.TrySearchAgain"
                             ActionText="@CommonText.ClearSearch"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SavedSearch"
                             PrimaryText="@SearchText.NoSearchesYet"
                             SecondaryText="@SearchText.NoSearchesYetHint" />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private IList<PredefinedSearchHeader>? _predefinedSearchHeaders;
    private readonly List<BreadcrumbItem> _breadcrumbs = new List<BreadcrumbItem>
    {
        new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
        new(LayoutText.NavAdministration, href: "/admin"),
        new(SearchText.PredefinedSearches, href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _predefinedSearchHeaders = await jim.Search.GetPredefinedSearchHeadersAsync();
    }

    /// <summary>
    /// Windows the in-memory list for the grid: Predefined Searches are a small configuration list, loaded whole
    /// once, so search and sort are applied here rather than each becoming a database range read.
    /// </summary>
    private Task<VirtualisedWindow<PredefinedSearchHeader>> LoadWindowAsync(VirtualisedWindowRequest request, CancellationToken token)
    {
        var headers = _predefinedSearchHeaders ?? new List<PredefinedSearchHeader>();

        var filtered = headers.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            filtered = filtered.Where(x =>
                x.Name.Contains(request.SearchText, StringComparison.OrdinalIgnoreCase) ||
                x.Uri.Contains(request.SearchText, StringComparison.OrdinalIgnoreCase));
        }

        Func<PredefinedSearchHeader, object> sortKey = request.SortBy switch
        {
            "uri" => x => x.Uri,
            "objecttype" => x => x.MetaverseObjectTypeName,
            "default" => x => x.IsDefaultForMetaverseObjectType,
            "builtin" => x => x.BuiltIn,
            "enabled" => x => x.IsEnabled,
            "attributes" => x => x.MetaverseAttributeCount,
            "created" => x => x.Created,
            _ => x => x.Name
        };

        var sorted = request.SortDescending
            ? filtered.OrderByDescending(sortKey)
            : filtered.OrderBy(sortKey);

        return Task.FromResult(sorted.ToWindow(request));
    }

    private void HandleRowClicked(PredefinedSearchHeader header)
    {
        NavManager.NavigateTo($"/admin/predefined-searches/{header.Uri}");
    }

    private async Task ToggleEnabledAsync(PredefinedSearchHeader header, bool isEnabled)
    {
        // offer an optional reason for the configuration change history; cancelling aborts the save
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
        if (cancelled)
            return;

        try
        {
            using var jim = JimFactory.Create();
            var core = await jim.Search.GetPredefinedSearchCoreAsync(header.Id);
            if (core == null)
            {
                Snackbar.Add(SearchText.SearchNoLongerExists, Severity.Error);
                return;
            }

            core.IsEnabled = isEnabled;
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Search.UpdatePredefinedSearchAsync(core, user, changeReason);
            header.IsEnabled = isEnabled;
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, isEnabled ? SearchText.SearchEnabledSnackbar : SearchText.SearchDisabledSnackbar, header.Name), Severity.Success);
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, SearchText.UpdateFailed, ex.Message), Severity.Error);
        }
    }
}
