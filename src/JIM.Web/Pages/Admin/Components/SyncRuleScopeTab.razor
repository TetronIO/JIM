@if (SyncRule.MetaverseObjectType == null || SyncRule.ConnectedSystemObjectType == null)
{
    <MudAlert Severity="Severity.Info">
        @((MarkupString)SyncRuleText.ScopeChooseFirst)
    </MudAlert>
}
else
{
    <MudPaper Class="pa-4" Outlined="true">
        <div class="d-flex align-center">
            <MudText Typo="Typo.h6">@SyncRuleText.ScopingHeading</MudText>
            <TermHint Term="Term.Scoping" />
        </div>
        @if (SyncRule.Direction == SyncRuleDirection.Export)
        {
            <MudText Class="mt-2">
                @((MarkupString)string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.ScopeDefaultExport, CodeSpan(SyncRule.MetaverseObjectType.Name)))
            </MudText>
        }
        else
        {
            <MudText Class="mt-2">
                @((MarkupString)string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.ScopeDefaultImport, CodeSpan(SyncRule.ConnectedSystemObjectType.Name)))
            </MudText>
        }

        <MudRadioGroup @bind-Value="_syncRuleScopingFiltered" Class="mt-5">
            <MudRadio Value="false">@SyncRuleText.ScopeAllObjects</MudRadio>
            <MudRadio Value="true">@SyncRuleText.ScopeFiltered</MudRadio>
        </MudRadioGroup>

        @if (_syncRuleScopingFiltered)
        {
            @if (SyncRule.Direction == SyncRuleDirection.Import)
            {
                <MudSelect T="InboundOutOfScopeAction" @bind-Value="SyncRule.InboundOutOfScopeAction" @bind-Value:after="NotifyChangedAsync"
                           Label="@SyncRuleText.ScopeFallOutLabel" Variant="Variant.Outlined" Class="mt-5">
                    <MudSelectItem Value="InboundOutOfScopeAction.Disconnect">
                        @SyncRuleText.ScopeDisconnectOption
                    </MudSelectItem>
                    <MudSelectItem Value="InboundOutOfScopeAction.RemainJoined">
                        @SyncRuleText.ScopeRemainJoined
                    </MudSelectItem>
                </MudSelect>
                <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                    @if (SyncRule.InboundOutOfScopeAction == InboundOutOfScopeAction.Disconnect)
                    {
                        <text>@SyncRuleText.ScopeDisconnectExplanation</text>
                    }
                    else
                    {
                        <text>@SyncRuleText.ScopeRemainJoinedExplanation</text>
                    }
                </MudAlert>
            }

            @if (SyncRule.ObjectScopingCriteriaGroups.Count == 0)
            {
                <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled"
                    OnClick="HandleOpenAddScopingCriteriaGroupDialog" Class="mt-5" DropShadow="false">@SyncRuleText.ScopeAddCriteriaGroup</MudButton>
            }

            <MudDialog @bind-Visible="_addScopingCriteriaGroupDialogVisible" Options="_dialogOptions">
                <TitleContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-3" /> @SyncRuleText.ScopeAddCriteriaGroup
                    </MudText>
                </TitleContent>
                <DialogContent>
                    <MudSelect T="string" Label="@SyncRuleText.ScopeChooseGroupType" Required="true" Variant="Variant.Outlined"
                        @bind-Value="_criteriaGroupTypeText">
                        @foreach (var type in Enum.GetValues(typeof(SearchGroupType)))
                        {
                            <MudSelectItem Value="@type.ToString()" />
                        }
                    </MudSelect>
                </DialogContent>
                <DialogActions>
                    <MudButton DropShadow="false"
                        OnClick="@(() => _addScopingCriteriaGroupDialogVisible = false)" Class="me-2">@CommonText.Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleAddCriteriaGroupButtonClick"
                        Disabled="DisableAddScopingCriteriaGroupFormButton()" DropShadow="false">@SyncRuleText.ScopeAddGroup
                    </MudButton>
                </DialogActions>
            </MudDialog>
        }
    </MudPaper>

    @foreach (var rootCriteriaGroup in SyncRule.ObjectScopingCriteriaGroups)
    {
        <SyncRuleDetailScopingCriteriaGroup SyncRule="SyncRule" SyncRuleScopingCriteriaGroup="rootCriteriaGroup"
            SyncRuleChanged="NotifyChangedAsync" SyncRuleScopingCriteriaGroupChanged="NotifyChangedAsync" />
    }

    @if (SyncRule.ObjectScopingCriteriaGroups.Count > 0)
    {
        <ScopeTestPanel SyncRule="SyncRule" />
    }
}

@code {
    [Parameter]
    public SyncRule SyncRule { get; set; } = null!;

    [Parameter]
    public EventCallback OnChanged { get; set; }

    private bool _syncRuleScopingFiltered;
    private bool _addScopingCriteriaGroupDialogVisible;
    private string? _criteriaGroupTypeText;
    private SyncRuleScopingCriteriaGroup? _syncRuleScopingCriteriaGroup;
    private readonly DialogOptions _dialogOptions = new() { FullWidth = true };

    protected override void OnInitialized()
    {
        // initialise scoping filter state based on existing criteria
        _syncRuleScopingFiltered = SyncRule.ObjectScopingCriteriaGroups.Count > 0;
    }

    /// <summary>A name shown in code formatting inside a sentence, HTML-encoded because it is schema data.</summary>
    private static string CodeSpan(string name) =>
        $"<code class=\"jim-code-inline\">{System.Net.WebUtility.HtmlEncode(name)}</code>";

    private async Task NotifyChangedAsync()
    {
        await OnChanged.InvokeAsync();
    }

    private void HandleOpenAddScopingCriteriaGroupDialog()
    {
        _syncRuleScopingCriteriaGroup = new SyncRuleScopingCriteriaGroup();
        _addScopingCriteriaGroupDialogVisible = true;
    }

    private bool DisableAddScopingCriteriaGroupFormButton()
    {
        return string.IsNullOrEmpty(_criteriaGroupTypeText);
    }

    private async Task HandleAddCriteriaGroupButtonClick()
    {
        if (_syncRuleScopingCriteriaGroup == null || _criteriaGroupTypeText == null)
            return;

        _syncRuleScopingCriteriaGroup.Type = (SearchGroupType)Enum.Parse(typeof(SearchGroupType), _criteriaGroupTypeText);

        if (_syncRuleScopingCriteriaGroup.ParentGroup == null)
        {
            // root-level criteria group
            SyncRule.ObjectScopingCriteriaGroups.Add(_syncRuleScopingCriteriaGroup);
        }
        else
        {
            // add the criteria group to the parent's children, i.e. make sure the relationship is established on both the parent
            // and the new criteria group
            _syncRuleScopingCriteriaGroup.ParentGroup.ChildGroups.Add(_syncRuleScopingCriteriaGroup);
        }

        // all done, reset
        _addScopingCriteriaGroupDialogVisible = false;
        _syncRuleScopingCriteriaGroup = null;
        await OnChanged.InvokeAsync();
    }
}
