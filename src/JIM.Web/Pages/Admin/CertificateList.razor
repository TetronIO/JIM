<PageTitle>@AdminText.CertificatePageTitle</PageTitle>
<MudText Typo="Typo.h3"><MudIcon Icon="@Icons.Material.Filled.EnhancedEncryption" Size="Size.Large" Class="mr-2 mb-1" Style="vertical-align: middle;" />@AdminText.CertificatePageTitle
    <PageInfo Title="@AdminText.CertificatePageTitle" DocsPage="configuration/certificates.md">
        @AdminText.CertificatePageInfo
    </PageInfo>
</MudText>
<MudBreadcrumbs Items="_breadcrumbs" Class="ps-0"></MudBreadcrumbs>

@* The infinite-scroll machinery (URL state, scroll restore, window loading, the density toggle, the search box
   and the toolbar count) lives in the shared grid; this page loads the full list once (Trusted Certificates are
   a small configuration list) and slices windows from it in memory. *@
<VirtualisedDataGrid GridClass="mt-2" @ref="_grid" T="TrustedCertificate"
                     ContainerId="certificate-list"
                     DefaultSortBy="name"
                     LoadWindow="LoadCertificateWindowAsync"
                     SingularName="@AdminText.CertificateNounSingular"
                     PluralName="@AdminText.CertificateNounPlural">
    <ToolBarExtras>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowUploadDialog" StartIcon="@Icons.Material.Filled.Upload"
                   DropShadow="false" Class="me-2">@AdminText.CertificateUploadButton</MudButton>
        <MudButton Variant="Variant.Filled" OnClick="ShowFilePathDialog" StartIcon="@Icons.Material.Filled.Folder"
                   DropShadow="false">@AdminText.CertificateReferenceFileButton</MudButton>
    </ToolBarExtras>
    <Columns>
        <TemplateColumn Title="@CommonText.ColumnActions" Sortable="false">
            <HeaderTemplate>
                <MudText Typo="Typo.button">@CommonText.ColumnActions</MudText>
            </HeaderTemplate>
            <CellTemplate>
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
                    <MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="_ => ShowDetailsDialog(context.Item)">@AdminText.CertificateMenuViewDetails</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="_ => ShowEditDialog(context.Item)">@CommonText.Edit
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Outlined.History" OnClick="_ => ShowHistoryDialogAsync(context.Item)">@AdminText.CertificateMenuChangeHistory
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="_ => HandleDeleteAsync(context.Item)">@CommonText.Delete
                    </MudMenuItem>
                </MudMenu>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@CommonText.ColumnName" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@CommonText.ColumnName" Name="name" />
            </HeaderTemplate>
            <CellTemplate>
                @context.Item.Name
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AdminText.CertificateTrustedFor" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@AdminText.CertificateTrustedFor" Name="trustedFor" />
            </HeaderTemplate>
            <CellTemplate>
                <div class="jim-one-line-list">
                    @if (context.Item.TrustedFor.HasFlag(CertificateTrustPurpose.SignIn))
                    {
                        <MudChip T="string" Color="Color.Primary">@AdminText.CertificatePurposeSignIn</MudChip>
                    }
                    @if (context.Item.TrustedFor.HasFlag(CertificateTrustPurpose.Connectors))
                    {
                        <MudChip T="string" Color="Color.Default">@AdminText.CertificatePurposeConnectors</MudChip>
                    }
                </div>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AdminText.CertificateSubject" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@AdminText.CertificateSubject" Name="subject" />
            </HeaderTemplate>
            <CellTemplate>
                <MudTooltip Text="@context.Item.Subject" Arrow="true" Placement="Placement.Top">
                    @TruncateSubject(context.Item.Subject)
                </MudTooltip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AdminText.CertificateSource" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@AdminText.CertificateSource" Name="source" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.SourceType == CertificateSourceType.Uploaded)
                {
                    <MudChip T="string" Color="Color.Info">@AdminText.CertificateUploaded</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default">@AdminText.CertificateFilePath</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@AdminText.CertificateExpires" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@AdminText.CertificateExpires" Name="expires" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.IsExpired)
                {
                    <MudChip T="string" Color="Color.Error">@AdminText.CertificateExpired</MudChip>
                }
                else if (context.Item.IsExpiringSoon)
                {
                    <MudChip T="string" Color="Color.Warning">@DescribeDaysUntilExpiry(context.Item.DaysUntilExpiry)</MudChip>
                }
                else
                {
                    @context.Item.ValidTo.ToFriendlyDate()
                }
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Title="@CommonText.ColumnStatus" Sortable="false">
            <HeaderTemplate>
                <VirtualisedSortHeader Title="@CommonText.ColumnStatus" Name="status" />
            </HeaderTemplate>
            <CellTemplate>
                @if (context.Item.IsEnabled && _signInStatus.IsUsedBySignIn(context.Item.Id))
                {
                    <MudTooltip Arrow="true" Placement="Placement.Top">
                        <TooltipContent>
                            <TooltipText Text="@string.Format(CultureInfo.CurrentCulture, AdminText.CertificateInUseBySignInTooltip, _signInStatus.CheckedUtc.ToLocalTime().ToRelativeTime())" />
                        </TooltipContent>
                        <ChildContent>
                            <MudChip T="string" Color="Color.Success">@AdminText.CertificateInUseBySignIn</MudChip>
                        </ChildContent>
                    </MudTooltip>
                }
                else if (context.Item.IsEnabled)
                {
                    <MudChip T="string" Color="Color.Success">@CommonText.Enabled</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default">@CommonText.Disabled</MudChip>
                }
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <EmptyContent Context="grid">
        @if (!string.IsNullOrWhiteSpace(grid.SearchText))
        {
            <TableEmptyState Icon="@Icons.Material.Filled.SearchOff"
                             PrimaryText="@string.Format(CultureInfo.CurrentCulture, AdminText.CertificateEmptySearch, grid.SearchText)"
                             SecondaryText="@CommonText.TrySearchAgain"
                             ActionText="@CommonText.ClearSearch"
                             OnAction="@(() => grid.ClearSearchAsync())" />
        }
        else
        {
            <TableEmptyState Icon="@Icons.Material.Filled.EnhancedEncryption"
                             PrimaryText="@AdminText.CertificateEmptyNone"
                             SecondaryText="@AdminText.CertificateEmptyNoneHint" />
        }
    </EmptyContent>
</VirtualisedDataGrid>

@* Upload Certificate Dialog *@
<MudDialog @bind-Visible="_uploadDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Upload" Class="mr-3" /> @AdminText.CertificateUploadButton
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_uploadName" Label="@CommonText.FieldName" Required="true"
            RequiredError="@AdminText.CertificateNameRequired" Immediate="true" Variant="Variant.Outlined" Class="mt-3"
            HelperText="@AdminText.CertificateNameHelper" />
        <MudFileUpload T="IBrowserFile" FilesChanged="HandleFileSelected" Accept=".pem,.crt,.cer,.der">
            <CustomContent>
                <MudButton Variant="Variant.Filled"
                    StartIcon="@Icons.Material.Filled.AttachFile" Class="mt-5"
                    OnClick="@context.OpenFilePickerAsync">
                    @(_uploadFile != null ? _uploadFile.Name : AdminText.CertificateSelectFile)
                </MudButton>
            </CustomContent>
        </MudFileUpload>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
            @AdminText.CertificateFormats
        </MudText>
        <TrustedForField @bind-SignIn="_uploadForSignIn" @bind-Connectors="_uploadForConnectors" Class="mt-5" />
        <MudTextField T="string" @bind-Value="_uploadNotes" Label="@AdminText.CertificateNotes" Lines="3" MaxLines="8" Sizing="InputSizing.Auto" Variant="Variant.Outlined"
            Class="mt-5" HelperText="@AdminText.CertificateNotesHelper" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _uploadDialogVisible = false" DropShadow="false">@CommonText.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            Disabled="@(string.IsNullOrWhiteSpace(_uploadName) || _uploadFile == null || !(_uploadForSignIn || _uploadForConnectors) || _uploading)"
            OnClick="HandleUploadAsync">
            @if (_uploading)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">@AdminText.CertificateUploading</span>
            }
            else
            {
                <text>@AdminText.CertificateUploadVerb</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* File Path Dialog *@
<MudDialog @bind-Visible="_filePathDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Folder" Class="mr-3" /> @AdminText.CertificateReferenceDialogTitle
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_filePathName" Label="@CommonText.FieldName" Required="true"
            RequiredError="@AdminText.CertificateNameRequired" Immediate="true" Variant="Variant.Outlined" Class="mt-3"
            HelperText="@AdminText.CertificateReferenceNameHelper" />
        <MudTextField T="string" @bind-Value="_filePath" Label="@AdminText.CertificateFilePath" Required="true"
            RequiredError="@AdminText.CertificateFilePathRequired" Immediate="true" Variant="Variant.Outlined" Class="mt-5"
            HelperText="@AdminText.CertificateFilePathHelper" />
        <TrustedForField @bind-SignIn="_filePathForSignIn" @bind-Connectors="_filePathForConnectors" Class="mt-5" />
        <MudTextField T="string" @bind-Value="_filePathNotes" Label="@AdminText.CertificateNotes" Lines="3" MaxLines="8" Sizing="InputSizing.Auto" Variant="Variant.Outlined"
            Class="mt-5" HelperText="@AdminText.CertificateNotesHelper" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _filePathDialogVisible = false" DropShadow="false">@CommonText.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            Disabled="@(string.IsNullOrWhiteSpace(_filePathName) || string.IsNullOrWhiteSpace(_filePath) || !(_filePathForSignIn || _filePathForConnectors) || _addingFromPath)"
            OnClick="HandleAddFromPathAsync">
            @if (_addingFromPath)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">@AdminText.CertificateAdding</span>
            }
            else
            {
                <text>@AdminText.CertificateAddButton</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@* Details Dialog *@
<MudDialog @bind-Visible="_detailsDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <div class="d-flex justify-space-between align-center">
            <MudText Typo="Typo.h6">
                <MudIcon Icon="@Icons.Material.Filled.Security" Class="mr-3" /> @AdminText.CertificateDetailsTitle
            </MudText>
            @if (_selectedCertificate != null)
            {
                <AuditInfo Entity="@_selectedCertificate" />
            }
        </div>
    </TitleContent>
    <DialogContent>
        @if (_selectedCertificate != null)
        {
            <MudGrid>
                <MudItem xs="12">
                    <MudField Label="@CommonText.FieldName" Variant="Variant.Outlined">@_selectedCertificate.Name</MudField>
                </MudItem>
                <MudItem xs="12">
                    <MudField Label="@AdminText.CertificateSubject" Variant="Variant.Outlined">@_selectedCertificate.Subject</MudField>
                </MudItem>
                <MudItem xs="12">
                    <MudField Label="@AdminText.CertificateIssuer" Variant="Variant.Outlined">@_selectedCertificate.Issuer</MudField>
                </MudItem>
                <MudItem xs="6">
                    <MudField Label="@AdminText.CertificateValidFrom" Variant="Variant.Outlined">@_selectedCertificate.ValidFrom.ToFriendlyDate()
                    </MudField>
                </MudItem>
                <MudItem xs="6">
                    <MudField Label="@AdminText.CertificateValidTo" Variant="Variant.Outlined">@_selectedCertificate.ValidTo.ToFriendlyDate()
                    </MudField>
                </MudItem>
                <MudItem xs="12">
                    <MudField Label="@AdminText.CertificateThumbprint" Variant="Variant.Outlined">@_selectedCertificate.Thumbprint</MudField>
                </MudItem>
                <MudItem xs="6">
                    <MudField Label="@AdminText.CertificateSerialNumber" Variant="Variant.Outlined">@_selectedCertificate.SerialNumber</MudField>
                </MudItem>
                <MudItem xs="6">
                    <MudField Label="@AdminText.CertificateSourceType" Variant="Variant.Outlined">@_selectedCertificate.SourceType</MudField>
                </MudItem>
                <MudItem xs="12">
                    <MudField Label="@AdminText.CertificateTrustedFor" Variant="Variant.Outlined">@DescribePurpose(_selectedCertificate.TrustedFor)</MudField>
                </MudItem>
                @if (_selectedCertificate.SourceType == CertificateSourceType.FilePath)
                {
                    <MudItem xs="12">
                        <MudField Label="@AdminText.CertificateFilePath" Variant="Variant.Outlined">@_selectedCertificate.FilePath</MudField>
                    </MudItem>
                }
                @if (!string.IsNullOrEmpty(_selectedCertificate.Notes))
                {
                    <MudItem xs="12">
                        <MudField Label="@AdminText.CertificateNotes" Variant="Variant.Outlined">@_selectedCertificate.Notes</MudField>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _detailsDialogVisible = false" DropShadow="false">@CommonText.Close</MudButton>
    </DialogActions>
</MudDialog>

@* Edit Dialog *@
<MudDialog @bind-Visible="_editDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-3" /> @AdminText.CertificateEditTitle
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_editName" Label="@CommonText.FieldName" Required="true" RequiredError="@AdminText.CertificateNameRequired"
            Immediate="true" Variant="Variant.Outlined" Class="mt-3" />
        <MudTextField T="string" @bind-Value="_editNotes" Label="@AdminText.CertificateNotes" Lines="3" MaxLines="8" Sizing="InputSizing.Auto" Variant="Variant.Outlined"
            Class="mt-5" />
        <TrustedForField @bind-SignIn="_editForSignIn" @bind-Connectors="_editForConnectors" Class="mt-5" />
        <MudSwitch @bind-Value="_editEnabled" Color="Color.Primary" Label="@CommonText.Enabled" Class="mt-5" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _editDialogVisible = false" DropShadow="false">@CommonText.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
            Disabled="@(string.IsNullOrWhiteSpace(_editName) || !(_editForSignIn || _editForConnectors) || _saving)" OnClick="HandleSaveEditAsync">
            @if (_saving)
            {
                <MudProgressCircular Class="ms-n1" Indeterminate="true" />
                <span class="ms-2">@AdminText.CertificateSaving</span>
            }
            else
            {
                <text>@CommonText.SaveChanges</text>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private List<TrustedCertificate>? _certificates;
    private VirtualisedDataGrid<TrustedCertificate>? _grid;

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new(LayoutText.NavHome, href: "/", icon: Icons.Material.Filled.Home),
        new(LayoutText.NavAdministration, href: "/admin"),
        new(AdminText.CertificateBreadcrumb, href: null, disabled: true)
    };

    private readonly DialogOptions _dialogOptions = new() { FullWidth = true, MaxWidth = MaxWidth.Small };

    // Upload dialog
    private bool _uploadDialogVisible;
    private string _uploadName = "";
    private IBrowserFile? _uploadFile;
    private string _uploadNotes = "";
    private bool _uploadForSignIn;
    private bool _uploadForConnectors = true;
    private bool _uploading;

    // File path dialog
    private bool _filePathDialogVisible;
    private string _filePathName = "";
    private string _filePath = "";
    private string _filePathNotes = "";
    private bool _filePathForSignIn;
    private bool _filePathForConnectors = true;
    private bool _addingFromPath;

    // Details dialog
    private bool _detailsDialogVisible;
    private TrustedCertificate? _selectedCertificate;

    // Edit dialog
    private bool _editDialogVisible;
    private TrustedCertificate? _editingCertificate;
    private string _editName = "";
    private string _editNotes = "";
    private bool _editEnabled;
    private bool _editForSignIn;
    private bool _editForConnectors;
    private bool _saving;

    // The identity provider's status as last checked: which certificate sign-in relies on.
    private IdentityProviderTrustStatus _signInStatus = new();

    protected override async Task OnInitializedAsync()
    {
        CertificateChanges.Changed += OnCertificatesChangedElsewhereAsync;
        await LoadCertificatesAsync();
    }

    /// <summary>
    /// A certificate was trusted from the identity provider banner above this page; show it.
    /// </summary>
    private Task OnCertificatesChangedElsewhereAsync() => InvokeAsync(async () =>
    {
        await ReloadListAsync();
        StateHasChanged();
    });

    public void Dispose() => CertificateChanges.Changed -= OnCertificatesChangedElsewhereAsync;

    private async Task LoadCertificatesAsync()
    {
        using var jim = JimFactory.Create();
        _certificates = await jim.Certificates.GetAllAsync();
        _signInStatus = IdentityProviderTrust.Current;
    }

    /// <summary>
    /// Reloads the list from the database and refreshes the grid after any action that changes it (upload, add,
    /// edit, delete), so the rows and the toolbar count stay honest.
    /// </summary>
    private async Task ReloadListAsync()
    {
        await LoadCertificatesAsync();
        if (_grid != null)
            await _grid.RefreshAsync(invalidateTotals: true);
    }

    /// <summary>
    /// Slices one window of Trusted Certificates from the in-memory list, applying the grid's search (name,
    /// subject, thumbprint; the same fields the old table filtered) and sort. Trusted Certificates are a small
    /// configuration list, so there is no repository range read; the full list is loaded once and windowed here.
    /// </summary>
    private Task<VirtualisedWindow<TrustedCertificate>> LoadCertificateWindowAsync(VirtualisedWindowRequest request, CancellationToken _)
    {
        IEnumerable<TrustedCertificate> certificates = _certificates ?? Enumerable.Empty<TrustedCertificate>();

        if (!string.IsNullOrWhiteSpace(request.SearchText))
        {
            var search = request.SearchText;
            certificates = certificates.Where(c =>
                c.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                c.Subject.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                c.Thumbprint.Contains(search, StringComparison.OrdinalIgnoreCase));
        }

        IOrderedEnumerable<TrustedCertificate> Order<TKey>(Func<TrustedCertificate, TKey> key, IComparer<TKey>? comparer = null) =>
            request.SortDescending ? certificates.OrderByDescending(key, comparer) : certificates.OrderBy(key, comparer);

        var sorted = request.SortBy switch
        {
            "subject" => Order(c => c.Subject, StringComparer.OrdinalIgnoreCase),
            "source" => Order(c => c.SourceType),
            "expires" => Order(c => c.ValidTo),
            "status" => Order(c => c.IsEnabled),
            "trustedFor" => Order(c => c.TrustedFor),
            _ => Order(c => c.Name, StringComparer.OrdinalIgnoreCase)
        };

        return Task.FromResult(sorted.ToWindow(request));
    }

    private static string TruncateSubject(string subject)
    {
        if (string.IsNullOrEmpty(subject))
            return subject;

        // Try to extract CN
        var cnIndex = subject.IndexOf("CN=", StringComparison.OrdinalIgnoreCase);
        if (cnIndex >= 0)
        {
            var cnEnd = subject.IndexOf(',', cnIndex);
            if (cnEnd < 0) cnEnd = subject.Length;
            var cn = subject.Substring(cnIndex + 3, cnEnd - cnIndex - 3);
            return cn.Length > 40 ? cn[..37] + "..." : cn;
        }

        return subject.Length > 40 ? subject[..37] + "..." : subject;
    }

    private void ShowUploadDialog()
    {
        _uploadName = "";
        _uploadFile = null;
        _uploadNotes = "";
        _uploadForSignIn = false;
        _uploadForConnectors = true;
        _uploadDialogVisible = true;
    }

    private void ShowFilePathDialog()
    {
        _filePathName = "";
        _filePath = "";
        _filePathNotes = "";
        _filePathForSignIn = false;
        _filePathForConnectors = true;
        _filePathDialogVisible = true;
    }

    private void ShowDetailsDialog(TrustedCertificate certificate)
    {
        _selectedCertificate = certificate;
        _detailsDialogVisible = true;
    }

    private void ShowEditDialog(TrustedCertificate certificate)
    {
        _editingCertificate = certificate;
        _editName = certificate.Name;
        _editNotes = certificate.Notes ?? "";
        _editEnabled = certificate.IsEnabled;
        _editForSignIn = certificate.TrustedFor.HasFlag(CertificateTrustPurpose.SignIn);
        _editForConnectors = certificate.TrustedFor.HasFlag(CertificateTrustPurpose.Connectors);
        _editDialogVisible = true;
    }

    private void HandleFileSelected(IBrowserFile file)
    {
        _uploadFile = file;
    }

    private async Task HandleUploadAsync()
    {
        if (_uploadFile == null || string.IsNullOrWhiteSpace(_uploadName))
            return;

        _uploading = true;
        StateHasChanged();

        try
        {
            // offer an optional reason for the configuration change history; cancelling aborts the upload
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, AdminText.CertificateUploadVerb);
            if (cancelled)
                return;

            using var jim = JimFactory.Create();

            // Read file content
            using var stream = _uploadFile.OpenReadStream(maxAllowedSize: 1024 * 1024); // 1MB max
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var certificateData = ms.ToArray();

            // Get current user
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

            // Add certificate
            await jim.Certificates.AddFromDataAsync(_uploadName, certificateData, user, _uploadNotes, changeReason, Purpose(_uploadForSignIn, _uploadForConnectors));

            Snackbar.Add(AdminText.CertificateUploadedSuccess, Severity.Success);
            _uploadDialogVisible = false;
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.CertificateUploadFailed, ex.Message), Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task HandleAddFromPathAsync()
    {
        if (string.IsNullOrWhiteSpace(_filePathName) || string.IsNullOrWhiteSpace(_filePath))
            return;

        _addingFromPath = true;
        StateHasChanged();

        try
        {
            // offer an optional reason for the configuration change history; cancelling aborts the add
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, CommonText.Add);
            if (cancelled)
                return;

            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Certificates.AddFromFilePathAsync(_filePathName, _filePath, user, _filePathNotes, changeReason, Purpose(_filePathForSignIn, _filePathForConnectors));

            Snackbar.Add(AdminText.CertificateAddedSuccess, Severity.Success);
            _filePathDialogVisible = false;
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.CertificateAddFailed, ex.Message), Severity.Error);
        }
        finally
        {
            _addingFromPath = false;
        }
    }

    private async Task HandleSaveEditAsync()
    {
        if (_editingCertificate == null || string.IsNullOrWhiteSpace(_editName))
            return;

        _saving = true;
        StateHasChanged();

        try
        {
            var trustedFor = Purpose(_editForSignIn, _editForConnectors);
            if (SignInLockoutGuard.WouldStopSignIn(_signInStatus, _editingCertificate.Id, enabledAfter: _editEnabled, trustedForAfter: trustedFor)
                && !await ConfirmSignInLockoutAsync(_editingCertificate, CommonText.SaveChanges))
                return;

            // offer an optional reason for the configuration change history; cancelling aborts the save
            var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService);
            if (cancelled)
                return;

            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Certificates.UpdateAsync(
            _editingCertificate.Id,
            user,
            _editName,
            _editNotes,
            _editEnabled,
            changeReason,
            trustedFor);

            Snackbar.Add(AdminText.CertificateUpdatedSuccess, Severity.Success);
            _editDialogVisible = false;
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.CertificateUpdateFailed, ex.Message), Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ShowHistoryDialogAsync(TrustedCertificate certificate)
    {
        await ConfigurationChangeHistoryDialog.ShowAsync(DialogService, ActivityTargetType.TrustedCertificate,
            certificate.Id, AdminText.CertificateNounSingular, certificate.Name);
    }

    private async Task HandleDeleteAsync(TrustedCertificate certificate)
    {
        if (SignInLockoutGuard.WouldStopSignIn(_signInStatus, certificate.Id, deleting: true))
        {
            if (!await ConfirmSignInLockoutAsync(certificate, CommonText.Delete))
                return;
        }
        else
        {
            var result = await DialogService.ShowMessageBoxAsync(
            AdminText.CertificateDeleteTitle,
            string.Format(CultureInfo.CurrentCulture, AdminText.CertificateDeleteMessage, certificate.Name),
            yesText: CommonText.Delete,
            cancelText: CommonText.Cancel);

            if (result != true)
                return;
        }

        // offer an optional reason for the configuration change history; cancelling aborts the delete
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, CommonText.Delete);
        if (cancelled)
            return;

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Certificates.DeleteAsync(certificate.Id, user, changeReason);

            Snackbar.Add(AdminText.CertificateDeletedSuccess, Severity.Success);
            await ReloadListAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, AdminText.CertificateDeleteFailed, ex.Message), Severity.Error);
        }
    }

    private static CertificateTrustPurpose Purpose(bool signIn, bool connectors) =>
        (signIn ? CertificateTrustPurpose.SignIn : CertificateTrustPurpose.None) | (connectors ? CertificateTrustPurpose.Connectors : CertificateTrustPurpose.None);

    private static string DescribeDaysUntilExpiry(int days) =>
        string.Format(CultureInfo.CurrentCulture, PluralRules.Choose(days, AdminText.CertificateDaysUntilExpiryOne, AdminText.CertificateDaysUntilExpiryOther), days);

    private static string DescribePurpose(CertificateTrustPurpose trustedFor) => trustedFor switch
    {
        CertificateTrustPurpose.SignIn => AdminText.CertificatePurposeSignIn,
        CertificateTrustPurpose.Connectors => AdminText.CertificatePurposeConnectors,
        _ => AdminText.CertificatePurposeBoth
    };

    /// <summary>
    /// Warns that the change would stop everyone signing in, and asks for the certificate's name to go ahead (#2363).
    /// </summary>
    private async Task<bool> ConfirmSignInLockoutAsync(TrustedCertificate certificate, string confirmText)
    {
        var parameters = new DialogParameters<ConsequenceConfirmationDialog>
        {
            { x => x.IrreversibleWarning, SignInLockoutGuard.Warning(certificate.Name, _signInStatus.Host) },
            { x => x.ConfirmationPhrase, certificate.Name },
            { x => x.ConfirmButtonText, confirmText },
            { x => x.ConfirmButtonColour, Color.Error }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

        var dialog = await DialogService.ShowAsync<ConsequenceConfirmationDialog>(string.Format(CultureInfo.CurrentCulture, AdminText.CertificateStopSignInTitle, certificate.Name), parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false };
    }
}
