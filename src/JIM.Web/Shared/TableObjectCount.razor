@* The object count in a table toolbar's title slot: density toggle first, then the title if the table has one, *@
@* then this. When a title is present, pass no nouns and the count renders as a bare low-lighted number beside it; *@
@* when there is no title (the page header already names the list), the nouns make the count self-describing. *@
@* While a filter narrows the list, pass the unfiltered baseline as Total and the text becomes "x of y". *@
@* See JIM.Web/CLAUDE.md "Object counts in table toolbars". *@

@if (Count.HasValue)
{
    var count = Count.Value;
    @if (ShowSeparator)
    {
        <MudText Class="mx-2 mud-text-disabled">|</MudText>
    }
    <MudText Typo="Typo.body2" Class="@($"mud-text-secondary {Class}".TrimEnd())">@DisplayText(count)</MudText>
}

@code {
    /// <summary>
    /// The number of objects currently in the list, after any active filter. Null renders nothing at all,
    /// deliberately: it is the not-yet-counted state, and a zero shown in its place would read as an empty list.
    /// </summary>
    [Parameter]
    public int? Count { get; set; }

    /// <summary>
    /// The unfiltered total, when the caller holds one. When it differs from <see cref="Count"/> the text becomes
    /// "x of y", telling the reader how much of the list their filter is hiding; when equal (or unknown) the count
    /// stands alone, because "3,868 of 3,868" restates itself.
    /// </summary>
    [Parameter]
    public int? Total { get; set; }

    /// <summary>The singular noun, used when the count is exactly one (e.g. "Service Principal"). Optional.</summary>
    [Parameter]
    public string? SingularName { get; set; }

    /// <summary>
    /// The plural noun (e.g. "Service Principals"). Omit both nouns when the count sits beside a toolbar title
    /// that already names the objects; the count then renders as a bare number.
    /// </summary>
    [Parameter]
    public string? PluralName { get; set; }

    /// <summary>
    /// Renders the standard low-lighted "|" toolbar separator before the count. The separator is owned here rather
    /// than by the call site so it cannot dangle while the count is still unknown.
    /// </summary>
    [Parameter]
    public bool ShowSeparator { get; set; }

    /// <summary>Additional CSS classes for the count text, e.g. a margin to sit off a preceding title.</summary>
    [Parameter]
    public string? Class { get; set; }

    private string DisplayText(int count)
    {
        // Invariant culture keeps the group separator deterministic (the portal's text is en-GB everywhere),
        // rather than varying with the server host's locale.
        var formatted = count.ToString("N0", CultureInfo.InvariantCulture);

        if (Total.HasValue && Total.Value != count)
        {
            var total = Total.Value.ToString("N0", CultureInfo.InvariantCulture);
            return string.IsNullOrEmpty(PluralName) ? $"{formatted} of {total}" : $"{formatted} of {total} {PluralName}";
        }

        if (string.IsNullOrEmpty(PluralName))
            return formatted;

        var noun = count == 1 && !string.IsNullOrEmpty(SingularName) ? SingularName : PluralName;
        return $"{formatted} {noun}";
    }
}
