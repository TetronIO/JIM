@* One tab for everything about this Connected System's SCIM endpoint: where it is, the keys identity providers
   call it with, what it holds, and what it serves. Shown only for the SCIM 2.0 Service Provider Connector. *@

@* ─── Endpoint ─── *@
<MudPaper Outlined="true" Class="pa-4">
    <div class="d-flex align-center">
        <MudText Typo="Typo.h6">@ConnectedSystemText.ScimEndpointHeading</MudText>
        <InfoPopover Title="@ConnectedSystemText.ScimEndpointHeading">
            @ConnectedSystemText.ScimEndpointInfo
        </InfoPopover>
    </div>
    <div class="d-flex align-center gap-3 mt-3">
        <MudTextField T="string" Value="@BaseUrl" Label="@ConnectedSystemText.ScimBaseUrl" ReadOnly="true" Variant="Variant.Outlined"
                      Margin="Margin.Dense" Class="jim-text-code" />
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.ContentCopy" DropShadow="false"
                   OnClick="@(() => CopyAsync(BaseUrl, ConnectedSystemText.ScimBaseUrl))">@ConnectedSystemText.ScimCopy</MudButton>
    </div>
</MudPaper>

@* ─── Keys ─── *@
<MudTable T="ApiKey" Items="@_keys" Dense="@_dense" Hover="true" Outlined="true" Elevation="0" Class="mt-6"
          Loading="@(_keys == null)">
    <ToolBarContent>
        <TableDensityToggle @bind-Dense="_dense" />
        <MudText Class="mx-2 mud-text-disabled">|</MudText>
        <MudText Typo="Typo.h6">@ConnectedSystemText.ScimKeysHeading</MudText>
        @if (_keys != null)
        {
            <MudText Class="ml-2 mud-text-secondary">@string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimUsableKeyCount, UsableKeyCount, SecurityServer.MaximumActiveScopedApiKeys)</MudText>
        }
        <MudSpacer />
        <MudTooltip Text="@(CanCreateKey ? "" : ConnectedSystemText.ScimKeyLimitTooltip)"
                    Arrow="true" Placement="Placement.Top" Disabled="@CanCreateKey">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" DropShadow="false"
                       Disabled="@(!CanCreateKey)" OnClick="ShowCreateDialog">@ConnectedSystemText.ScimCreateKey</MudButton>
        </MudTooltip>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>@CommonText.ColumnName</MudTh>
        <MudTh>@ConnectedSystemText.ScimColumnKeyPrefix</MudTh>
        <MudTh>@CommonText.ColumnStatus</MudTh>
        <MudTh>@ConnectedSystemText.ScimColumnExpires</MudTh>
        <MudTh>@ConnectedSystemText.ScimColumnLastUsed</MudTh>
        <MudTh />
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@CommonText.ColumnName">
            @context.Name
            @if (!string.IsNullOrEmpty(context.Description))
            {
                <span class="mud-text-secondary ml-2">@context.Description</span>
            }
        </MudTd>
        <MudTd DataLabel="@ConnectedSystemText.ScimColumnKeyPrefix"><span class="jim-text-code">@context.KeyPrefix...</span></MudTd>
        <MudTd DataLabel="@CommonText.ColumnStatus">
            @if (!context.IsEnabled)
            {
                <MudChip T="string" Variant="Variant.Text" Color="Color.Default">@CommonText.Disabled</MudChip>
            }
            else if (!context.IsUsableAt(DateTime.UtcNow))
            {
                <MudChip T="string" Variant="Variant.Text" Color="Color.Error">@ConnectedSystemText.ScimStatusExpired</MudChip>
            }
            else
            {
                <MudChip T="string" Variant="Variant.Text" Color="Color.Success">@CommonText.Enabled</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="@ConnectedSystemText.ScimColumnExpires">
            @if (context.ExpiresAt.HasValue)
            {
                var expiresAt = context.ExpiresAt.Value;
                var expiringSoon = expiresAt > DateTime.UtcNow && expiresAt < DateTime.UtcNow.AddDays(30);
                <MudTooltip Text="@expiresAt.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                    <span class="@(expiringSoon ? "mud-warning-text" : "")">@expiresAt.ToRelativeTime()</span>
                </MudTooltip>
            }
            else
            {
                <EmptyValue />
            }
        </MudTd>
        <MudTd DataLabel="@ConnectedSystemText.ScimColumnLastUsed">
            @if (context.LastUsedAt.HasValue)
            {
                var lastUsed = context.LastUsedAt.Value.ToLocalTime();
                <MudTooltip Text="@lastUsed.ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                    @lastUsed.ToRelativeTime()
                </MudTooltip>
                @if (!string.IsNullOrEmpty(context.LastUsedFromIp))
                {
                    <span class="mud-text-secondary ml-1">@string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimLastUsedFrom, context.LastUsedFromIp)</span>
                }
            }
            else
            {
                <span class="mud-text-secondary">@CommonText.Never</span>
            }
        </MudTd>
        <MudTd Style="text-align: right; white-space: nowrap;">
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@_busy"
                       OnClick="@(() => SetEnabledAsync(context, !context.IsEnabled))">@(context.IsEnabled ? ConnectedSystemText.ScimActionDisable : ConnectedSystemText.ScimActionEnable)</MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@_busy"
                       OnClick="@(() => DeleteAsync(context))">@CommonText.Delete</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <TableEmptyState Icon="@Icons.Material.Filled.Key"
                         PrimaryText="@ConnectedSystemText.ScimNoKeysYet"
                         SecondaryText="@ConnectedSystemText.ScimNoKeysHint" />
    </NoRecordsContent>
    <FooterContent>
        <MudTd colspan="6" Class="mud-text-secondary">
            @ConnectedSystemText.ScimRotateKeyHint
        </MudTd>
    </FooterContent>
</MudTable>

@* ─── Store ─── *@
@* Tiles filled rather than outlined, inside the panel, so the panel's border stays the only line. Awaiting Import and
   Rejected are the figures that ask for action, so they alone take the accent, and only while above zero. *@
<MudPaper Outlined="true" Class="pa-4 mt-6">
    <MudText Typo="Typo.h6" Class="mb-3">@ConnectedSystemText.ScimStoreHeading</MudText>
    @if (_summary == null)
    {
        <MudSkeleton Height="96px" />
    }
    else
    {
        <div class="jim-stat-tiles">
            @foreach (var count in _summary.ResourceCounts)
            {
                <div class="jim-stat-tile">
                    <div class="jim-stat-tile-label">
                        <MudIcon Icon="@ResourceTypeIcon(count.ResourceTypeName)" Color="Color.Primary" />
                        <MudText Typo="Typo.button" Class="mud-text-secondary">@count.ResourceTypeName.Pluralize()</MudText>
                    </div>
                    <MudText Typo="Typo.h4" Class="jim-stat-tile-value">@count.Count.ToString("N0", CultureInfo.CurrentCulture)</MudText>
                </div>
            }
            <div class="@(_summary.ChangesAwaitingImport > 0 ? "jim-stat-tile jim-stat-tile--attention" : "jim-stat-tile")">
                <div class="jim-stat-tile-label">
                    <MudIcon Icon="@Icons.Material.Filled.Sync" Color="Color.Primary" />
                    <MudText Typo="Typo.button" Class="mud-text-secondary">@ConnectedSystemText.ScimAwaitingImport</MudText>
                </div>
                <MudText Typo="Typo.h4" Class="jim-stat-tile-value">@_summary.ChangesAwaitingImport.ToString("N0", CultureInfo.CurrentCulture)</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @(_summary.ImportedUpTo.HasValue ? ConnectedSystemText.ScimChangesSinceImport : ConnectedSystemText.ScimNeverImported)
                </MudText>
            </div>
            <div class="jim-stat-tile">
                <div class="jim-stat-tile-label">
                    <MudIcon Icon="@Icons.Material.Filled.DeleteSweep" Color="Color.Primary" />
                    <MudText Typo="Typo.button" Class="mud-text-secondary">@ConnectedSystemText.ScimDeletionsHeld</MudText>
                </div>
                <MudText Typo="Typo.h4" Class="jim-stat-tile-value">@_summary.Tombstones.ToString("N0", CultureInfo.CurrentCulture)</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@ConnectedSystemText.ScimDeletionsHeldHint</MudText>
            </div>
            <div class="@(_summary.RejectedLast24Hours > 0 ? "jim-stat-tile jim-stat-tile--attention" : "jim-stat-tile")">
                <div class="jim-stat-tile-label">
                    <MudIcon Icon="@Icons.Material.Filled.Block" Color="Color.Primary" />
                    <MudText Typo="Typo.button" Class="mud-text-secondary">@ConnectedSystemText.ScimRejected</MudText>
                </div>
                <MudText Typo="Typo.h4" Class="jim-stat-tile-value">@_summary.RejectedLast24Hours.ToString("N0", CultureInfo.CurrentCulture)</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@ConnectedSystemText.ScimRejectedHint</MudText>
            </div>
            <div class="jim-stat-tile">
                <div class="jim-stat-tile-label">
                    <MudIcon Icon="@Icons.Material.Filled.Schedule" Color="Color.Primary" />
                    <MudText Typo="Typo.button" Class="mud-text-secondary">@ConnectedSystemText.ScimLastWrite</MudText>
                </div>
                @if (_summary.LastWrite.HasValue)
                {
                    var lastWrite = _summary.LastWrite.Value.ToLocalTime();
                    <div>
                        <MudTooltip Text="@lastWrite.ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                            <MudText Typo="Typo.h5" Class="pt-1">@lastWrite.ToRelativeTime()</MudText>
                        </MudTooltip>
                    </div>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@ConnectedSystemText.ScimLastWriteBy</MudText>
                }
                else
                {
                    <MudText Typo="Typo.h5" Class="pt-1 mud-text-secondary">@CommonText.Never</MudText>
                }
            </div>
        </div>
    }
</MudPaper>

@* ─── Resource types ─── *@
<MudTable T="ScimResourceType" Items="@_resourceTypes" Dense="@_dense" Outlined="true" Elevation="0" Class="mt-6"
          Loading="@(_resourceTypes == null)">
    <ToolBarContent>
        <TableDensityToggle @bind-Dense="_dense" />
        <MudText Class="mx-2 mud-text-disabled">|</MudText>
        <MudText Typo="Typo.h6">@ConnectedSystemText.ScimResourceTypesHeading</MudText>
        <MudText Class="ml-2 mud-text-secondary">@ConnectedSystemText.ScimReadOnly</MudText>
    </ToolBarContent>
    <HeaderContent>
        <MudTh>@CommonText.ColumnName</MudTh>
        <MudTh>@ConnectedSystemText.ScimColumnEndpoint</MudTh>
        <MudTh>@ConnectedSystemText.ScimColumnSchema</MudTh>
        <MudTh>@ConnectedSystemText.ScimColumnExtensions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@CommonText.ColumnName">@context.Name</MudTd>
        <MudTd DataLabel="@ConnectedSystemText.ScimColumnEndpoint"><span class="jim-text-code">@context.Endpoint</span></MudTd>
        <MudTd DataLabel="@ConnectedSystemText.ScimColumnSchema"><span class="jim-text-code">@context.Schema</span></MudTd>
        <MudTd DataLabel="@ConnectedSystemText.ScimColumnExtensions">
            @if (context.SchemaExtensions.Count == 0)
            {
                <EmptyValue />
            }
            else
            {
                @string.Join(", ", context.SchemaExtensions.Select(e => SchemaName(e.Schema)))
            }
        </MudTd>
    </RowTemplate>
</MudTable>

@* ─── Create key ─── *@
<MudDialog @bind-Visible="_createDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.Key" Class="mr-3" /> @ConnectedSystemText.ScimCreateKey</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField T="string" @bind-Value="_createName" Label="@CommonText.FieldName" Required="true" RequiredError="@ConnectedSystemText.ScimKeyNameRequired"
                      Immediate="true" Variant="Variant.Outlined" Class="mt-3"
                      HelperText="@ConnectedSystemText.ScimKeyNameHelp" />
        <MudTextField T="string" @bind-Value="_createDescription" Label="@CommonText.FieldDescription" Lines="2" MaxLines="6" Sizing="InputSizing.Auto"
                      Variant="Variant.Outlined" Class="mt-4" HelperText="@ConnectedSystemText.ScimOptional" />
        <MudDatePicker @bind-Date="_createExpiresAt" Label="@ConnectedSystemText.ScimColumnExpires" Variant="Variant.Outlined" Class="mt-4" Required="true"
                       MinDate="@DateTime.Today.AddDays(1)" MaxDate="@DateTime.Today.AddDays(MaximumLifetimeDays)"
                       HelperText="@string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimExpiryHelp, MaximumLifetimeDays / 365)" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _createDialogVisible = false">@CommonText.Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false"
                   Disabled="@(string.IsNullOrWhiteSpace(_createName) || _createExpiresAt == null || _busy)" OnClick="CreateAsync">@CommonText.Create</MudButton>
    </DialogActions>
</MudDialog>

@* ─── Key created: the secret, shown once ─── *@
<MudDialog @bind-Visible="_createdDialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6"><MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Class="mr-3" /> @ConnectedSystemText.ScimKeyCreatedTitle</MudText>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            @ConnectedSystemText.ScimKeyShownOnceWarning
        </MudAlert>
        <MudTextField T="string" Value="@_createdSecret" Label="@string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimCreatedKeyLabel, _createdName)" ReadOnly="true" Variant="Variant.Outlined"
                      Class="jim-text-code" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                      AdornmentAriaLabel="@ConnectedSystemText.ScimCopyKeyAria" OnAdornmentClick="@(() => CopyAsync(_createdSecret, ConnectedSystemText.ScimKeyNoun))" />
        <MudSimpleTable Dense="true" Elevation="0" Class="mt-4">
            <tbody>
                <tr><td class="mud-text-secondary">@ConnectedSystemText.ScimBaseUrl</td><td class="jim-text-code">@BaseUrl</td></tr>
                <tr><td class="mud-text-secondary">@ConnectedSystemText.ScimColumnExpires</td><td>@_createdExpiresAt?.ToLocalTime().ToFriendlyDate()</td></tr>
            </tbody>
        </MudSimpleTable>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" DropShadow="false" OnClick="CloseCreatedDialog">@ConnectedSystemText.ScimDone</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private static readonly int MaximumLifetimeDays = (int)SecurityServer.ScopedApiKeyMaximumLifetime.TotalDays;
    private static readonly int DefaultLifetimeDays = (int)SecurityServer.ScopedApiKeyDefaultLifetime.TotalDays;

    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

    private List<ApiKey>? _keys;
    private ScimStoreSummary? _summary;
    private List<ScimResourceType>? _resourceTypes;
    private Dictionary<string, string> _schemaNames = new(StringComparer.Ordinal);
    private int? _loadedFor;
    private bool _dense;
    private bool _busy;

    private bool _createDialogVisible;
    private string _createName = "";
    private string _createDescription = "";
    private DateTime? _createExpiresAt;

    private bool _createdDialogVisible;
    private string _createdSecret = "";
    private string _createdName = "";
    private DateTime? _createdExpiresAt;

    private string BaseUrl => $"{NavigationManager.BaseUri}scim/v2/{ConnectedSystem.Id.ToString(CultureInfo.InvariantCulture)}";

    private int UsableKeyCount => _keys?.Count(k => k.IsUsableAt(DateTime.UtcNow)) ?? 0;

    private bool CanCreateKey => _keys != null && UsableKeyCount < SecurityServer.MaximumActiveScopedApiKeys && !_busy;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFor == ConnectedSystem.Id)
            return;
        _loadedFor = ConnectedSystem.Id;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dense = await PreferenceService.GetTableDenseAsync() == true;
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        using var jim = JimFactory.Create();
        _keys = await jim.Security.GetScimServiceProviderKeysAsync(ConnectedSystem.Id);
        _summary = await jim.Scim.GetStoreSummaryAsync(ConnectedSystem.Id);
        var (resourceTypes, schemas) = await jim.Scim.GetDiscoveryDocumentsAsync(ConnectedSystem.Id);
        _resourceTypes = resourceTypes;
        _schemaNames = schemas.Where(s => s.Id != null).ToDictionary(s => s.Id!, s => s.Name ?? s.Id!, StringComparer.Ordinal);
    }

    private string SchemaName(string? urn) =>
        urn != null && _schemaNames.TryGetValue(urn, out var name) ? name.Humanize(LetterCasing.Title) : urn ?? "";

    private static string ResourceTypeIcon(string resourceTypeName) => resourceTypeName switch
    {
        "User" => Icons.Material.Filled.Person,
        "Group" => Icons.Material.Filled.Groups,
        _ => Icons.Material.Filled.Inventory2
    };

    private void ShowCreateDialog()
    {
        _createName = "";
        _createDescription = "";
        _createExpiresAt = DateTime.Today.AddDays(DefaultLifetimeDays);
        _createDialogVisible = true;
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(_createName) || _createExpiresAt == null)
            return;

        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, CommonText.Create);
        if (cancelled)
            return;

        _busy = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var description = string.IsNullOrWhiteSpace(_createDescription) ? null : _createDescription.Trim();
            var created = await jim.Security.CreateScimServiceProviderKeyAsync(ConnectedSystem.Id, _createName.Trim(), description,
                _createExpiresAt.Value.ToUniversalTime(), user, changeReason);

            _createDialogVisible = false;
            _createdSecret = created.Secret;
            _createdName = created.Key.Name;
            _createdExpiresAt = created.Key.ExpiresAt;
            _createdDialogVisible = true;
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimKeyCreateFailed, ex.Message), Severity.Error);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimKeyCreateFailed, ex.Message), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private void CloseCreatedDialog()
    {
        // Forget the secret as soon as the dialog closes; it is never shown again.
        _createdSecret = "";
        _createdDialogVisible = false;
    }

    private async Task SetEnabledAsync(ApiKey key, bool enabled)
    {
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, enabled ? ConnectedSystemText.ScimActionEnable : ConnectedSystemText.ScimActionDisable);
        if (cancelled)
            return;

        _busy = true;
        try
        {
            using var jim = JimFactory.Create();
            var stored = await jim.Security.GetApiKeyAsync(key.Id);
            if (stored == null || stored.ScopeConnectedSystemId != ConnectedSystem.Id)
            {
                Snackbar.Add(ConnectedSystemText.ScimKeyNoLongerExists, Severity.Warning);
            }
            else
            {
                stored.IsEnabled = enabled;
                var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
                await jim.Security.UpdateApiKeyAsync(stored, user, changeReason);
                Snackbar.Add(string.Format(CultureInfo.CurrentCulture, enabled ? ConnectedSystemText.ScimKeyEnabled : ConnectedSystemText.ScimKeyDisabled, stored.Name), Severity.Success);
            }
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimKeyNotChanged, ex.Message), Severity.Error);
        }
        catch (ArgumentException ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimKeyNotChanged, ex.Message), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(ApiKey key)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(ConnectedSystemText.ScimDeleteKeyTitle,
            string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimDeleteKeyConfirm, key.Name),
            yesText: CommonText.Delete, cancelText: CommonText.Cancel);
        if (confirmed != true)
            return;

        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, CommonText.Delete);
        if (cancelled)
            return;

        _busy = true;
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            await jim.Security.DeleteApiKeyAsync(key.Id, user, changeReason);
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimKeyDeleted, key.Name), Severity.Success);
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimKeyNotDeleted, ex.Message), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CopyAsync(string text, string what)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Snackbar.Add(string.Format(CultureInfo.CurrentCulture, ConnectedSystemText.ScimCopiedSnackbar, what), Severity.Info);
        }
        catch (JSException)
        {
            Snackbar.Add(ConnectedSystemText.ScimCopyFailed, Severity.Warning);
        }
    }
}
