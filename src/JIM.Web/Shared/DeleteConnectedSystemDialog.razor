@* Thin surface over the shared ConsequenceConfirmationDialog: this component owns evaluating the *@
@* deletion counts, the #809 deletion-mode choice, the #134 deletion impact preview slot and       *@
@* performing the delete; the shared dialog owns presenting it and the consent rules.             *@
@* See engineering/plans/done/CONFIGURATION_CHANGE_PREVIEW.md (Phase 2),                           *@
@* engineering/plans/done/CONNECTED_SYSTEM_SYNCHRONISED_DEPROVISIONING.md (Phase 4) and            *@
@* engineering/plans/done/CONNECTED_SYSTEM_DELETION_IMPACT_PREVIEW.md (Phase 3).                   *@

<ConsequenceConfirmationDialog Loading="@(_preview == null)"
                               LoadingText="@ConnectedSystemText.DeleteSystemLoadingText"
                               IrreversibleWarning="@ConnectedSystemText.DeleteSystemIrreversible"
                               Counts="@BuildCounts()"
                               Warnings="@(_preview?.Warnings ?? [])"
                               ConfirmationPhrase="@ConnectedSystem.Name"
                               ConfirmButtonText="@ConnectedSystemText.DeleteSystemConfirmButton"
                               BusyText="@ConnectedSystemText.DeleteSystemBusy"
                               OnConfirmAsync="DeleteAsync">
    <LeadingContent>
        @* ─── Fenced-system exits (#809) ─── *@
        @if (_fenced)
        {
            @if (_fencedTask != null)
            {
                <MudAlert Severity="Severity.Info" data-testid="jim-delete-cs-fenced-notice">
                    @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DeleteSystemFencedAttached, ConnectedSystemText.ConnectedSystemDeprovisionThroughSynchronisation, ConnectedSystemText.ConnectedSystemDeleteImmediatelyKeepData)
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" data-testid="jim-delete-cs-fenced-notice">
                    @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DeleteSystemFencedWarning, ConnectedSystemText.ConnectedSystemDeprovisionThroughSynchronisation, ConnectedSystemText.ConnectedSystemDeleteImmediatelyKeepData)
                </MudAlert>
            }
        }

        @* ─── Deletion mode (#809): deprovision is the default; immediate is the warned opt-out ─── *@
        <MudRadioGroup T="bool" @bind-Value="_deleteImmediately">
            <div class="mt-1">
                <MudRadio T="bool" Value="false" Color="Color.Primary">@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DeleteSystemDeprovisionRecommended, ConnectedSystemText.ConnectedSystemDeprovisionThroughSynchronisation)</MudRadio>
                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">
                    @ConnectedSystemText.DeleteSystemDeprovisionDetail
                </MudText>
            </div>
            <div class="mt-2">
                <MudRadio T="bool" Value="true" Color="Color.Primary">@ConnectedSystemText.ConnectedSystemDeleteImmediatelyKeepData</MudRadio>
                <MudText Typo="Typo.body2" Class="mud-text-secondary ms-12">
                    @ConnectedSystemText.DeleteSystemImmediateDetail
                </MudText>
                @if (_deleteImmediately)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-2 ms-12"
                              data-testid="jim-delete-cs-immediate-warning">
                        @ConnectedSystemText.DeleteSystemImmediateWarning
                    </MudAlert>
                }
            </div>
        </MudRadioGroup>

        @* ─── Deletion impact preview (#134) ─── *@
        @* A fenced system is mid-deletion, so a preview of deleting it can no longer be run or trusted. *@
        @if (!_fenced)
        {
            <MudPaper Outlined="true" Class="pa-4" data-testid="jim-delete-cs-preview-slot">
                <div class="d-flex align-center flex-wrap gap-2">
                    <MudChip T="string" Variant="Variant.Text" Color="@PreviewChipColour" Class="ma-0">@PreviewChipLabel</MudChip>
                    <MudText Typo="Typo.body1"><b>@ConnectedSystemText.DeleteSystemPreviewHeading</b></MudText>
                    @if (_previewState.Started is { } previewStarted)
                    {
                        <MudTooltip Text="@previewStarted.ToLocalTime().ToFriendlyDate()" Arrow="true" Placement="Placement.Top">
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@previewStarted.ToLocalTime().ToRelativeTime()</MudText>
                        </MudTooltip>
                    }
                </div>

                @switch (_previewState.Status)
                {
                    case ConnectedSystemPreviewStatus.Running:
                        @if (_previewState.PercentComplete is { } percentComplete)
                        {
                            <MudProgressLinear Color="Color.Primary" Value="@percentComplete" Class="mt-3" />
                        }
                        else
                        {
                            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-3" />
                        }
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
                            @ConnectedSystemText.DeleteSystemRunningPreview
                        </MudText>
                        <MudButton Variant="Variant.Text" Class="mt-2"
                                   OnClick="() => CloseWith(DeleteConnectedSystemDialogOutcome.ShowPreview)">
                            @ConnectedSystemText.DeleteSystemWaitForPreview
                        </MudButton>
                        break;

                    case ConnectedSystemPreviewStatus.Current:
                        @if (_deleteImmediately)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                @ConnectedSystemText.DeleteSystemImmediatePreviewNote
                            </MudAlert>
                        }
                        else if (_previewState.Lines is not { Count: > 0 } previewLines)
                        {
                            <MudText Typo="Typo.body2" Class="mt-3">@ConnectedSystemText.DeleteSystemNoChange</MudText>
                        }
                        else
                        {
                            <MudAlert Severity="@previewLines[0].Severity" Dense="true" Class="mt-3">
                                @foreach (var line in previewLines.Take(PreviewLinesShown))
                                {
                                    <MudText Typo="Typo.body2">@line.Sentence</MudText>
                                }
                                @if (previewLines.Count > PreviewLinesShown)
                                {
                                    <MudText Typo="Typo.body2">@string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DeleteSystemMoreLines, previewLines.Count - PreviewLinesShown)</MudText>
                                }
                            </MudAlert>
                        }
                        <div class="d-flex align-center flex-wrap gap-2 mt-2">
                            <MudButton Variant="Variant.Text"
                                       OnClick="() => CloseWith(DeleteConnectedSystemDialogOutcome.ShowPreview)">
                                @ConnectedSystemText.DeleteSystemOpenFullPreview
                            </MudButton>
                            <MudSpacer />
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@ConnectedSystemText.DeleteSystemRecordedOnActivity</MudText>
                        </div>
                        break;

                    case ConnectedSystemPreviewStatus.Stale:
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
                            @_previewState.StaleReason @ConnectedSystemText.DeleteSystemSinceThisPreviewRan <PreviewOvertakenBy Staleness="@_previewState.Staleness" />.
                            @ConnectedSystemText.DeleteSystemStaleBody
                        </MudText>
                        <MudButton Variant="Variant.Filled" DropShadow="false" Class="mt-3"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="() => CloseWith(DeleteConnectedSystemDialogOutcome.PreviewRequested)">
                            @ConnectedSystemText.DeleteSystemRunAgain
                        </MudButton>
                        break;

                    case ConnectedSystemPreviewStatus.DidNotFinish:
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
                            @ConnectedSystemText.DeleteSystemDidNotFinishBody
                        </MudText>
                        <MudButton Variant="Variant.Filled" DropShadow="false" Class="mt-3"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="() => CloseWith(DeleteConnectedSystemDialogOutcome.PreviewRequested)">
                            @ConnectedSystemText.DeleteSystemPreviewAgain
                        </MudButton>
                        break;

                    default:
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-3">
                            @ConnectedSystemText.DeleteSystemDefaultBody
                        </MudText>
                        <MudButton Variant="Variant.Filled" DropShadow="false" Class="mt-3"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="() => CloseWith(DeleteConnectedSystemDialogOutcome.PreviewRequested)">
                            @ConnectedSystemText.DeleteSystemPreviewFirst
                        </MudButton>
                        break;
                }
            </MudPaper>
        }
    </LeadingContent>
    <AdditionalContent>
        @* The estimate describes the immediate bulk delete; deprovisioning always queues and its helper text
           above already says so, so showing a bulk-delete estimate there would mislead. *@
        @if (_deleteImmediately && _preview is { WillRunAsBackgroundJob: true })
        {
            <MudAlert Severity="Severity.Info">
                @ConnectedSystemText.DeleteSystemBackgroundJob
                @string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DeleteSystemEstimatedTime, _preview.EstimatedDeletionTime.ToString(@"hh\:mm\:ss"))
            </MudAlert>
        }

        <MudCheckBox @bind-Value="_deleteChangeHistory" Color="Color.Primary">
            <MudText>@ConnectedSystemText.DeleteSystemChangeHistory</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                @ConnectedSystemText.DeleteSystemChangeHistoryHelp
            </MudText>
        </MudCheckBox>

        <MudTextField T="string"
                      @bind-Value="_changeReason"
                      Label="@ConnectedSystemText.DeleteSystemReason"
                      Variant="Variant.Outlined"
                      FullWidth="true"
                      Lines="2"
                      MaxLines="6" />
    </AdditionalContent>
</ConsequenceConfirmationDialog>

@code {
    private static string GroupRemoved => ConnectedSystemText.DeleteSystemGroupRemoved;
    private static string GroupAffected => ConnectedSystemText.DeleteSystemGroupAffected;
    private static string SubgroupMetaverseObjects => ConnectedSystemText.DeleteSystemSubgroupMetaverseObjects;

    /// <summary>
    /// How many verdict sentences the slot states before pointing at the full preview: enough for the worst
    /// consequences, few enough that the dialog stays a confirmation rather than a second preview panel.
    /// </summary>
    private const int PreviewLinesShown = 3;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>
    /// The Connected System to delete.
    /// </summary>
    [Parameter]
    public ConnectedSystem ConnectedSystem { get; set; } = null!;

    private ConnectedSystemDeletionPreview? _preview;
    private string? _changeReason;
    private bool _deleteChangeHistory;

    // Deprovision through synchronisation is the default (#809); immediate deletion is the deliberate,
    // warned opt-out, mirroring the recall-or-keep default in ContributedValuesChoiceDialog (#1537).
    private bool _deleteImmediately;

    // Fenced (#809): the system is already Status = Deleting, so the two modes become the failed-run exits:
    // deprovisioning retries/attaches, immediate finishes. A surviving task means the run is queued or
    // executing; no task means a failed run whose retry resumes from the checkpointed data state.
    private bool _fenced;
    private DeleteConnectedSystemWorkerTask? _fencedTask;

    // The system's latest deletion impact preview (#134), and so which preview, if any, the deletion records.
    private ConnectedSystemPreviewState _previewState = new(ConnectedSystemPreviewStatus.NotPreviewed);

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _fenced = ConnectedSystem.Status == ConnectedSystemStatus.Deleting;
        if (_fenced)
            _fencedTask = await jim.Tasking.GetDeleteConnectedSystemWorkerTaskAsync(ConnectedSystem.Id);
        if (!_fenced)
            _previewState = await LoadPreviewStateAsync(jim);
        _preview = await jim.ConnectedSystems.GetDeletionPreviewAsync(ConnectedSystem.Id);
    }

    /// <summary>
    /// Reads the system's latest deletion impact preview and, for a finished one, whether anything has overtaken it.
    /// </summary>
    private async Task<ConnectedSystemPreviewState> LoadPreviewStateAsync(JimApplication jim)
    {
        var preview = await jim.ConfigurationChangePreviews.GetLatestConnectedSystemPreviewAsync(
            ConfigurationChangePreviewSurface.ConnectedSystemDeletion, ConnectedSystem.Id);
        var staleness = preview is { IsComplete: true }
            ? await jim.ConfigurationChangePreviews.GetPreviewStalenessAsync(preview.ActivityId)
            : null;
        return ConnectedSystemPreviewState.From(preview, staleness);
    }

    private Color PreviewChipColour => _previewState.Status switch
    {
        ConnectedSystemPreviewStatus.Running => Color.Info,
        ConnectedSystemPreviewStatus.Current => Color.Success,
        ConnectedSystemPreviewStatus.Stale => Color.Warning,
        _ => Color.Default
    };

    private string PreviewChipLabel => _previewState.Status switch
    {
        ConnectedSystemPreviewStatus.Running => ConnectedSystemText.DeleteSystemPreviewChipRunning,
        ConnectedSystemPreviewStatus.Current => ConnectedSystemText.DeleteSystemPreviewChipComplete,
        ConnectedSystemPreviewStatus.Stale => ConnectedSystemText.DeleteSystemPreviewChipStale,
        ConnectedSystemPreviewStatus.DidNotFinish => ConnectedSystemText.DeleteSystemPreviewChipDidNotFinish,
        _ => ConnectedSystemText.DeleteSystemPreviewChipNotPreviewed
    };

    private void CloseWith(DeleteConnectedSystemDialogOutcome outcome) => MudDialog.Close(DialogResult.Ok(outcome));

    private IReadOnlyList<ImpactCount> BuildCounts()
    {
        if (_preview == null)
            return [];

        // Grouped by fate (#809): what the deletion removes outright, then what it affects but leaves in
        // place, with the Metaverse Object impact broken down so the administrator can weigh the mode
        // choice above against what it governs.
        return
        [
            new ImpactCount { Group = GroupRemoved, Label = ConnectedSystemText.DeleteSystemImpactConnectedSystemObjects, Count = _preview.ConnectedSystemObjectCount },
            new ImpactCount { Group = GroupRemoved, Label = ConnectedSystemText.DeleteSystemImpactSyncRules, Count = _preview.SyncRuleCount },
            new ImpactCount { Group = GroupRemoved, Label = ConnectedSystemText.DeleteSystemImpactRunProfiles, Count = _preview.RunProfileCount },
            new ImpactCount { Group = GroupRemoved, Label = ConnectedSystemText.DeleteSystemImpactPartitions, Count = _preview.PartitionCount },
            new ImpactCount { Group = GroupRemoved, Label = ConnectedSystemText.DeleteSystemImpactContainers, Count = _preview.ContainerCount },
            new ImpactCount { Group = GroupRemoved, Label = ConnectedSystemText.DeleteSystemImpactPendingExports, Count = _preview.PendingExportCount },
            new ImpactCount { Group = GroupAffected, Subgroup = SubgroupMetaverseObjects, Label = ConnectedSystemText.DeleteSystemImpactJoined, Count = _preview.JoinedMvoCount, Note = ConnectedSystemText.DeleteSystemImpactJoinedNote },
            new ImpactCount { Group = GroupAffected, Subgroup = SubgroupMetaverseObjects, Label = ConnectedSystemText.DeleteSystemImpactContributed, Count = _preview.ContributedValueCount, Note = ConnectedSystemText.DeleteSystemImpactContributedNote },
            new ImpactCount { Group = GroupAffected, Subgroup = SubgroupMetaverseObjects, Label = ConnectedSystemText.DeleteSystemImpactEligible, Count = _preview.MvosWithDeletionRuleCount, Note = ConnectedSystemText.DeleteSystemImpactEligibleNote },
            new ImpactCount { Group = GroupAffected, Label = ConnectedSystemText.DeleteSystemImpactActivities, Count = _preview.ActivityCount, Note = ConnectedSystemText.DeleteSystemImpactActivitiesNote }
        ];
    }

    private async Task<bool> DeleteAsync()
    {
        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);

            // A preview still running would go on describing a system that no longer exists (#134).
            if (_previewState is { Status: ConnectedSystemPreviewStatus.Running, ActivityId: { } runningPreviewId })
                await jim.ConfigurationChangePreviews.CancelPreviewAsync(runningPreviewId);

            var result = await jim.ConnectedSystems.DeleteAsync(ConnectedSystem.Id, user, _deleteChangeHistory, _changeReason,
                synchronisedDeprovisioning: !_deleteImmediately, previewActivityId: _previewState.InformingPreviewActivityId);

            if (!result.Success)
            {
                Snackbar.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DeleteSystemFailed, result.ErrorMessage), Severity.Error);
                return false;
            }

            switch (result.Outcome)
            {
                case DeletionOutcome.CompletedImmediately:
                    Snackbar.Add(ConnectedSystemText.DeleteSystemDeleted, Severity.Success);
                    break;

                case DeletionOutcome.QueuedAsBackgroundJob:
                    if (!_deleteImmediately && result.ActivityId is { } activityId)
                    {
                        // Deprovisioning queued: say what will happen and offer the Activity, which is where
                        // progress lives (SyncRuleDetail's recall snackbar precedent, #1537). The snackbar is
                        // enqueued before the caller navigates; ISnackbar is circuit-scoped, so it survives
                        // the soft navigation.
                        var objectCount = _preview?.ConnectedSystemObjectCount ?? 0;
                        Snackbar.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DeleteSystemDeprovisioningQueued, objectCount.ToString("N0", System.Globalization.CultureInfo.CurrentCulture), ConnectedSystem.Name),
                            Severity.Success, config =>
                            {
                                config.Action = ConnectedSystemText.DetailViewActivity;
                                config.OnClick = _ =>
                                {
                                    NavManager.NavigateTo($"/activity/{activityId}");
                                    return Task.CompletedTask;
                                };
                            });
                    }
                    else
                    {
                        Snackbar.Add(ConnectedSystemText.DeleteSystemQueuedBackground, Severity.Info);
                    }
                    break;

                case DeletionOutcome.QueuedAfterSync:
                    Snackbar.Add(ConnectedSystemText.DeleteSystemQueuedAfterSync, Severity.Info);
                    break;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Log.Error(ex, "Error deleting Connected System {Id}", ConnectedSystem.Id);
            Snackbar.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DeleteSystemError, ex.Message), Severity.Error);
            return false;
        }

        return true;
    }

    /// <summary>
    /// Opens the delete dialog for a Connected System and says how it was left: deleted (completed or queued; the
    /// caller should navigate away), a request to preview or read the deletion's impact first (#134), or cancelled.
    /// </summary>
    public static async Task<DeleteConnectedSystemDialogOutcome> ShowAsync(IDialogService dialogService, ConnectedSystem connectedSystem)
    {
        var parameters = new DialogParameters<DeleteConnectedSystemDialog>
        {
            { x => x.ConnectedSystem, connectedSystem }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await dialogService.ShowAsync<DeleteConnectedSystemDialog>(string.Format(System.Globalization.CultureInfo.CurrentCulture, ConnectedSystemText.DeleteSystemDialogTitle, connectedSystem.Name), parameters, options);
        var result = await dialog.Result;
        return result switch
        {
            { Canceled: false, Data: true } => DeleteConnectedSystemDialogOutcome.Deleted,
            { Canceled: false, Data: DeleteConnectedSystemDialogOutcome outcome } => outcome,
            _ => DeleteConnectedSystemDialogOutcome.Cancelled
        };
    }
}
