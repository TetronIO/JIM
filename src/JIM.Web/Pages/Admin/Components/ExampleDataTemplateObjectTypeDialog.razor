@using JIM.Models.Core
@using JIM.Models.ExampleData
@using JIM.Web.Models
@inject IJimApplicationFactory JimFactory
@inject IDialogService DialogService
@inject ISnackbar Snackbar

@* Copyright (c) Tetron Limited. All rights reserved. *@
@* Licensed under the Tetron Commercial License. See LICENSE file in the project root. *@

<MudDialog>
    <DialogContent>
        <MudStack Spacing="4">
            @if (ExistingObjectType == null)
            {
                <MudSelect T="MetaverseObjectType" Label="Metaverse Object Type" Variant="Variant.Outlined"
                           @bind-Value="_metaverseObjectType" ToStringFunc="@(t => t?.Name ?? string.Empty)"
                           HelperText="@(_choices.Count == 0 && _loaded ? "Every Metaverse Object Type is already in this template." : null)">
                    @foreach (var choice in _choices)
                    {
                        <MudSelectItem T="MetaverseObjectType" Value="@choice">@choice.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudNumericField T="int" Label="Objects to create" Variant="Variant.Outlined" Immediate="true" @bind-Value="_objectsToCreate" Min="1" />
            @if (_saveError != null)
            {
                <MudAlert Severity="Severity.Error">@_saveError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!CanSave())" OnClick="SaveAsync">
            @(ExistingObjectType == null ? "Add Object Type" : "Save")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter, EditorRequired]
    public ExampleDataTemplate Template { get; set; } = null!;

    /// <summary>The Object Type whose count is being changed; null adds a new Object Type.</summary>
    [Parameter]
    public ExampleDataObjectType? ExistingObjectType { get; set; }

    private bool _loaded;
    private bool _saving;
    private string? _saveError;
    private int _objectsToCreate = 100;
    private MetaverseObjectType? _metaverseObjectType;
    private List<MetaverseObjectType> _choices = [];

    protected override async Task OnInitializedAsync()
    {
        if (ExistingObjectType != null)
        {
            _objectsToCreate = ExistingObjectType.ObjectsToCreate;
        }
        else
        {
            using var jim = JimFactory.Create();
            var inUse = Template.ObjectTypes.Select(ot => ot.MetaverseObjectType.Id).ToHashSet();
            _choices = (await jim.Metaverse.GetMetaverseObjectTypesAsync(includeChildObjects: false))
                .Where(t => !inUse.Contains(t.Id))
                .OrderBy(t => t.Name)
                .ToList();
        }

        _loaded = true;
    }

    private bool CanSave() => _loaded && !_saving && _objectsToCreate >= 1 && (ExistingObjectType != null || _metaverseObjectType != null);

    private async Task SaveAsync()
    {
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, ExistingObjectType == null ? "Add" : "Save");
        if (cancelled)
            return;

        _saving = true;
        _saveError = null;
        using var jim = JimFactory.Create();
        var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
        var existing = ExistingObjectType;
        var added = _metaverseObjectType;
        var count = _objectsToCreate;
        var result = await ExampleDataTemplateEditorSave.ApplyAsync(jim, Template.Id, template =>
        {
            if (existing != null)
                ExampleDataTemplateGraphEdits.SetObjectsToCreate(template, existing.Id, count);
            else
                ExampleDataTemplateGraphEdits.AddObjectType(template, added!, count);
        }, user, changeReason);
        _saving = false;

        if (!result.Succeeded)
        {
            _saveError = result.Error;
            return;
        }

        foreach (var warning in result.Warnings)
            Snackbar.Add(warning, Severity.Warning);

        MudDialog.Close(DialogResult.Ok(true));
    }

    /// <summary>Opens the dialog; true when the change was saved.</summary>
    public static async Task<bool> ShowAsync(IDialogService dialogService, ExampleDataTemplate template, ExampleDataObjectType? existingObjectType)
    {
        var parameters = new DialogParameters<ExampleDataTemplateObjectTypeDialog>
        {
            { x => x.Template, template },
            { x => x.ExistingObjectType, existingObjectType }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
        var title = existingObjectType == null ? "Add Metaverse Object Type" : $"Objects to Create: {existingObjectType.MetaverseObjectType.Name}";
        var dialog = await dialogService.ShowAsync<ExampleDataTemplateObjectTypeDialog>(title, parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: true };
    }
}
