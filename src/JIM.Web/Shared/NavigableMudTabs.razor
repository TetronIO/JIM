<MudTabs @ref="_mudTabs"
         ActivePanelIndex="_activePanelIndex"
         ActivePanelIndexChanged="OnTabChangedAsync"
         Elevation="Elevation"
         Rounded="Rounded"
         ApplyEffectsToContainer="ApplyEffectsToContainer"
         Outlined="Outlined"
         TabPanelsClass="@TabPanelsClass"
         Class="@RootClass"
         KeepPanelsAlive="KeepPanelsAlive"
         Centered="Centered"
         Border="Border"
         Color="Color"
         SliderColor="SliderColor"
         IconColor="IconColor"
         Header="Header"
         Ripple="Ripple">
    @ChildContent
</MudTabs>

@code {
    private MudTabs _mudTabs = null!;
    private int _activePanelIndex;
    private bool _isNavigating;
    private bool _disposed;
    private int _renderedPanelCount;
    private bool _barHiddenForSinglePanel;

    /// <summary>
    /// The caller's class plus the marker that hides a one-tab bar. The hiding is CSS rather than markup
    /// because MudTabs owns the toolbar element; the class also zeroes the panels' top padding, so the
    /// content lands exactly where it would have without tabs.
    /// </summary>
    private string? RootClass => _barHiddenForSinglePanel
        ? $"{Class} jim-tabs-single".TrimStart()
        : Class;

    // Pass-through parameters matching MudTabs
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment<MudTabs>? Header { get; set; }

    // Presentation defaults are JIM's tab look, not MudTabs': flat, rounded and outlined, with the
    // effects on the bar rather than the container. Every page in the app passes exactly these values,
    // so they are the default here rather than something each new page has to remember; MudTabs' own
    // defaults render an unbordered white band that reads as a broken tab bar, which is what a page
    // that omitted them got. Existing call sites still spell them out and are unaffected.
    // Pinned by NavigableMudTabsTests so a future edit cannot silently restyle every tab bar.
    [Parameter] public int Elevation { get; set; }
    [Parameter] public bool Rounded { get; set; } = true;
    [Parameter] public bool ApplyEffectsToContainer { get; set; }
    [Parameter] public bool Outlined { get; set; } = true;
    [Parameter] public string? TabPanelsClass { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool KeepPanelsAlive { get; set; }
    [Parameter] public bool Centered { get; set; }
    [Parameter] public bool Border { get; set; }
    [Parameter] public Color Color { get; set; } = Color.Default;
    [Parameter] public Color SliderColor { get; set; } = Color.Inherit;
    [Parameter] public Color IconColor { get; set; } = Color.Inherit;
    [Parameter] public bool Ripple { get; set; } = true;

    /// <summary>
    /// Hides the tab bar while only one panel is rendered, leaving its content where it would have sat with
    /// no tabs at all. On by default: a bar with one tab offers nothing to click and spends a band of vertical
    /// space repeating what the page heading already said.
    /// </summary>
    /// <remarks>
    /// Applies to pages whose tabs are conditional (a Pending Export tab that appears only where there is one),
    /// and is inert on pages with a fixed set of two or more. Set false where the bar is wanted regardless,
    /// for instance so a page's height does not jump as a tab appears.
    /// </remarks>
    [Parameter] public bool HideBarWhenSingleTab { get; set; } = true;

    /// <summary>
    /// The query string parameter name used for URL-based tab navigation.
    /// Defaults to "t". Change this when nesting multiple NavigableMudTabs
    /// on the same page to avoid conflicts (e.g. "cat" for category tabs).
    /// </summary>
    [Parameter] public string QueryParameterName { get; set; } = "t";

    /// <summary>
    /// Optional two-way binding for the active tab index, allowing parent pages
    /// to read or set the active tab programmatically.
    /// </summary>
    [Parameter] public int ActivePanelIndex { get; set; }
    [Parameter] public EventCallback<int> ActivePanelIndexChanged { get; set; }

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;

        // Read ?t= from the current URL on first load
        var slug = GetTabSlugFromUrl();
        if (!string.IsNullOrEmpty(slug))
        {
            // Defer panel lookup to OnAfterRender since panels aren't registered yet
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            var slug = GetTabSlugFromUrl();
            if (!string.IsNullOrEmpty(slug))
            {
                var index = FindPanelIndexBySlug(slug);
                if (index >= 0 && index != _activePanelIndex)
                {
                    _activePanelIndex = index;
                    ActivePanelIndex = index;
                    ActivePanelIndexChanged.InvokeAsync(index);
                    StateHasChanged();
                }
            }
        }

        // Record the registered panel count while the component is live; OnTabChangedAsync uses a
        // shrinking count to recognise panel-removal events raised during disposal.
        _renderedPanelCount = _mudTabs?.Panels.Count ?? 0;

        // Panels register themselves with MudTabs during their own render, so the count is only knowable
        // after one has happened; hiding the bar therefore costs a second render pass. It settles there,
        // because the extra pass changes only a class and leaves the count alone.
        var hideBar = HideBarWhenSingleTab && _renderedPanelCount == 1;
        if (hideBar != _barHiddenForSinglePanel && !_disposed)
        {
            _barHiddenForSinglePanel = hideBar;
            StateHasChanged();
        }
    }

    private async Task OnTabChangedAsync(int newIndex)
    {
        if (_isNavigating || _disposed)
            return;

        _activePanelIndex = newIndex;
        ActivePanelIndex = newIndex;
        await ActivePanelIndexChanged.InvokeAsync(newIndex);

        // MudTabs also raises this callback when panels are removed, which happens while the page (or
        // the whole circuit) is being torn down, not just when the user switches tab. Navigating then
        // would issue JS interop against a disposing circuit (JSDisconnectedException), so only update
        // the URL while the full panel set from the last render is still registered.
        if (PanelsHaveBeenRemoved())
            return;

        // Push URL with ?t=slug for browser history
        var slug = GetSlugForPanelIndex(newIndex);
        if (slug != null)
        {
            _isNavigating = true;
            try
            {
                var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
                var baseUri = uri.GetLeftPart(UriPartial.Path);

                // First tab (index 0) = no query string for clean URLs
                // Preserve other query parameters when updating the tab slug
                var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
                if (newIndex == 0)
                    query.Remove(QueryParameterName);
                else
                    query[QueryParameterName] = slug;
                var qs = query.ToString();
                var newUrl = string.IsNullOrEmpty(qs) ? baseUri : $"{baseUri}?{qs}";
                NavManager.NavigateTo(newUrl, new NavigationOptions { ReplaceHistoryEntry = false });
            }
            finally
            {
                _isNavigating = false;
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_isNavigating)
            return;

        // Browser back/forward button pressed
        var slug = GetTabSlugFromUrl();
        var targetIndex = string.IsNullOrEmpty(slug) ? 0 : FindPanelIndexBySlug(slug);

        if (targetIndex >= 0 && targetIndex != _activePanelIndex)
        {
            _isNavigating = true;
            try
            {
                _activePanelIndex = targetIndex;
                ActivePanelIndex = targetIndex;
                ActivePanelIndexChanged.InvokeAsync(targetIndex);
                InvokeAsync(StateHasChanged);
            }
            finally
            {
                _isNavigating = false;
            }
        }
    }

    private string? GetTabSlugFromUrl()
    {
        var uri = NavManager.ToAbsoluteUri(NavManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return query[QueryParameterName];
    }

    private int FindPanelIndexBySlug(string slug)
    {
        if (_mudTabs?.Panels == null)
            return -1;

        var panels = _mudTabs.Panels.ToList();
        for (var i = 0; i < panels.Count; i++)
        {
            if (Slugify(panels[i].Text) == slug && !panels[i].Disabled)
                return i;
        }

        // If the tab is disabled or not found, stay on first tab
        return 0;
    }

    private string? GetSlugForPanelIndex(int index)
    {
        if (_mudTabs?.Panels == null)
            return null;

        var panels = _mudTabs.Panels.ToList();
        if (index < 0 || index >= panels.Count)
            return null;

        return Slugify(panels[index].Text);
    }

    /// <summary>
    /// Converts tab text to a URL-friendly slug.
    /// e.g. "Partitions &amp; Containers" becomes "partitions-containers"
    /// </summary>
    internal static string Slugify(string? text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return string.Empty;

        var slug = text.ToLowerInvariant()
            .Replace("&", "")
            .Replace("  ", " ")
            .Trim()
            .Replace(" ", "-");

        return slug;
    }

    private bool PanelsHaveBeenRemoved()
    {
        return _mudTabs?.Panels == null || _mudTabs.Panels.Count < _renderedPanelCount;
    }

    public void Dispose()
    {
        _disposed = true;
        NavManager.LocationChanged -= OnLocationChanged;
    }
}
