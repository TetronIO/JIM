<MudDialog>
    <DialogContent>
        @if (_impact == null)
        {
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        }
        else
        {
            <MudStack Spacing="4">
                @if (_impact.BlockedByValues)
                {
                    <MudAlert Severity="Severity.Error">
                        <MudText Typo="Typo.subtitle2">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.RemoveBindingHasValue, _impact.ObjectsWithValues, _impact.MetaverseObjectTypeName)</MudText>
                        @if (!string.IsNullOrEmpty(_impact.MetaverseObjectTypePluralName))
                        {
                            <MudLink Href="@Utilities.GetMetaverseObjectHasAttributeSearchHref(_impact.MetaverseObjectTypePluralName, _impact.AttributeName)" Class="mt-1 d-inline-flex align-center">
                                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="mr-1" />@SyncRuleText.RemoveBindingViewObjects
                            </MudLink>
                        }
                    </MudAlert>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @SyncRuleText.RemoveBindingClearFirst
                    </MudText>
                }
                @if (_impact.BlockedByReaders)
                {
                    <MudAlert Severity="Severity.Error">
                        <MudText Typo="Typo.subtitle2">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.RemoveBindingReadBy, _impact.Readers.Count, _impact.MetaverseObjectTypeName)</MudText>
                        <MudList T="string" Dense="true" Class="mt-1">
                            @foreach (var reader in _impact.Readers)
                            {
                                <MudListItem T="string" Icon="@Icons.Material.Filled.Link" Href="@Helpers.AttributeReaderHref(reader)">
                                    @reader.ShowDescription()
                                </MudListItem>
                            }
                        </MudList>
                    </MudAlert>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        @SyncRuleText.RemoveBindingChangeFirst
                    </MudText>
                }
                @if (!_impact.BlockedByValues && !_impact.BlockedByReaders)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">
                        @string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.RemoveBindingSafe, _impact.MetaverseObjectTypeName)
                    </MudAlert>

                    @if (_cascadeReferences.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning">
                            <MudText Typo="Typo.subtitle2">@string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.RemoveBindingCascadeTitle, _cascadeReferences.Count)</MudText>
                            <MudList T="string" Dense="true" Class="mt-1">
                                @foreach (var reference in _cascadeReferences)
                                {
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.Link">
                                        @MessageDisplay.Show(reference.DescriptionDetail, reference.Description)
                                    </MudListItem>
                                }
                            </MudList>
                        </MudAlert>

                        <div>
                            <MudText Typo="Typo.body2" Class="mb-1">@((MarkupString)string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.RemoveBindingTypeToConfirm, "<b>" + System.Net.WebUtility.HtmlEncode(_impact.AttributeName) + "</b>"))</MudText>
                            <MudTextField @bind-Value="_confirmText" Variant="Variant.Outlined" Immediate="true"
                                          Placeholder="@_impact.AttributeName" AutoFocus="true"
                                          Adornment="Adornment.End"
                                          AdornmentIcon="@(ConfirmMatches() ? Icons.Material.Filled.CheckCircle : null)" />
                        </div>
                    }
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@CommonText.Cancel</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled"
                   Disabled="@(!CanRemove())" OnClick="RemoveAsync">
            @RemoveButtonText()
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    [Parameter]
    public int AttributeId { get; set; }

    [Parameter]
    public int MetaverseObjectTypeId { get; set; }

    private AttributeUnassignImpact? _impact;
    private List<AttributeReference> _cascadeReferences = new();
    private string _confirmText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        using var jim = JimFactory.Create();
        _impact = await jim.Metaverse.EvaluateAttributeUnassignAsync(AttributeId, MetaverseObjectTypeId);
        // The impact's References include the binding row itself; the cascade list is everything beyond it.
        _cascadeReferences = _impact.References.Where(r => r.Kind != AttributeReferenceKind.Binding).ToList();
    }

    private bool ConfirmMatches() =>
        _impact != null && string.Equals(_confirmText, _impact.AttributeName, StringComparison.Ordinal);

    private bool CanRemove()
    {
        if (_impact == null || _impact.BlockedByValues || _impact.BlockedByReaders || _impact.BuiltIn || !_impact.WasBound)
            return false;

        return _cascadeReferences.Count == 0 || ConfirmMatches();
    }

    private string RemoveButtonText() =>
        _cascadeReferences.Count > 0 && _impact is { BlockedByValues: false, BlockedByReaders: false }
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.RemoveBindingWithReferences, _cascadeReferences.Count)
            : SyncRuleText.RemoveBindingButton;

    private async Task RemoveAsync()
    {
        var (cancelled, changeReason) = await ChangeReasonDialog.ShowAsync(DialogService, SyncRuleText.RemoveButton);
        if (cancelled)
            return;

        try
        {
            using var jim = JimFactory.Create();
            var user = await Helpers.GetUserAsync(jim, AuthenticationStateTask);
            var impact = await jim.Metaverse.UnassignAttributeFromObjectTypeAsync(AttributeId, MetaverseObjectTypeId, user, changeReason);
            if (!impact.Unassigned)
            {
                Snackbar.Add(SyncRuleText.RemoveBindingFailed, Severity.Warning);
                return;
            }
            Snackbar.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.RemoveBindingRemoved,
                impact.AttributeName, impact.MetaverseObjectTypeName), Severity.Success);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Snackbar.Add(string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.RemoveBindingError, ex.Message), Severity.Error);
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>
    /// Opens the remove-binding (unassign) dialog. Returns true when the binding was removed.
    /// </summary>
    public static async Task<bool> ShowAsync(IDialogService dialogService, int attributeId, string attributeName,
        int metaverseObjectTypeId, string metaverseObjectTypeName)
    {
        var parameters = new DialogParameters<RemoveAttributeBindingDialog>
        {
            { x => x.AttributeId, attributeId },
            { x => x.MetaverseObjectTypeId, metaverseObjectTypeId }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await dialogService.ShowAsync<RemoveAttributeBindingDialog>(
            string.Format(System.Globalization.CultureInfo.CurrentCulture, SyncRuleText.RemoveBindingTitle, attributeName, metaverseObjectTypeName),
            parameters, options);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: true };
    }
}
