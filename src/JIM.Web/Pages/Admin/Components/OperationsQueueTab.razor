    /// <summary>
    /// The demo queue's Schedule Executions, assembled the way the real ones are. The finished and
    /// failed steps are supplied here as Activity outcomes because that is where they come from in
    /// earnest: a task is deleted the moment it ends, so a demo built only from queued tasks could
    /// not show a completed step, and could not show the case the divided marker exists for, a
    /// parallel step where one task has failed while its sibling is still running.
    /// </summary>
    private static Dictionary<Guid, ScheduleExecutionProgress?> GenerateDemoScheduleProgress(List<WorkerTaskHeader> headers)
    {
        var demoOutcomes = new Dictionary<string, List<ScheduleStepObservation>>
        {
            ["Nightly Full Sync"] =
            [
                new ScheduleStepObservation
                {
                    StepIndex = 0, Name = "HR System - Full Import", ActivityId = Guid.NewGuid(),
                    ActivityStatus = JIM.Models.Activities.ActivityStatus.Complete
                },
                new ScheduleStepObservation
                {
                    StepIndex = 1, Name = "Legacy CRM - Full Import", ActivityId = Guid.NewGuid(),
                    ActivityStatus = JIM.Models.Activities.ActivityStatus.FailedWithError
                }
            ]
        };

        return headers
            .Where(t => t.ScheduleExecutionId.HasValue)
            .GroupBy(t => t.ScheduleExecutionId!.Value)
            .ToDictionary(g => g.Key, g => ScheduleStepReading.FromQueue(
                g.ToList(),
                demoOutcomes.GetValueOrDefault(g.First().ScheduleExecutionName ?? string.Empty, [])));
    }

    /// <summary>
    /// A Full Import's steps as the demo queue shows them, with <paramref name="activeKey"/> running,
    /// everything before it done, and the connection step skipped so the rail's skipped state is
    /// visible without having to contrive a run that skips something more obscure.
    /// </summary>
    private static RunPhaseSummary DemoImportSteps(string activeKey)
    {
        var declared = RunProfilePhaseCatalogue.GetPhases(ConnectedSystemRunType.FullImport);
        var activeIndex = declared.ToList().FindIndex(p => p.Key == activeKey);

        var phases = declared.Select((phase, index) => new ActivityPhase
        {
            Id = Guid.NewGuid(),
            Key = phase.Key,
            Name = phase.Name,
            ParentKey = phase.ParentKey,
            Order = index,
            Status = phase.Key == RunPhaseKeys.ImportConnect
                ? ActivityPhaseStatus.Skipped
                : index < activeIndex
                    ? ActivityPhaseStatus.Completed
                    : index == activeIndex
                        ? ActivityPhaseStatus.Active
                        : ActivityPhaseStatus.Pending
        }).ToList();

        return RunPhaseSummary.From(phases)!;
    }

    private static bool HasWorkerTaskHeaderChanged(WorkerTaskHeader existing, WorkerTaskHeader updated)
    {
        return existing.Status != updated.Status ||
               existing.ActivityId != updated.ActivityId ||
               existing.ObjectsProcessed != updated.ObjectsProcessed ||
               existing.ObjectsToProcess != updated.ObjectsToProcess ||
               existing.ProgressMessage != updated.ProgressMessage;
    }
